@page
@model FineUI.Core.Examples.Pages.Grid.ExcelSelectColumnsModel
@{
    ViewBag.SourceFiles = "~/Grid/ExcelSelectColumnsIFrame";
    ViewBag.Title = "Grid/ExcelSelectColumns";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataSource="@DataSourceUtil.GetDataTable()">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选择需要导出的列" ClickHandler="onOpenWindow1Click">
    </f:Button>

    <f:Window ID="Window1" Title="选择需要导出的列" Hidden="true" EnableIFrame="true" IFrameUrl="~/Grid/ExcelSelectColumnsIFrame"
              EnableMaximize="true" Target="Top" EnableResize="true" IsModal="true" Width="450" Height="250">
    </f:Window>

    <!-- 隐藏表单，用于自定义POST请求 -->
    <form id="myform" asp-page-handler="ExportToExcel" method="post">
        <input type="hidden" id="columns" name="columns" />
    </form>
}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function exportToExcel(columns) {
            @*var actionUrl = '@Url.Handler("ExportToExcel")';
            window.location.href = F.formatString('{0}?columns={1}', actionUrl, F.urlEncode(F.toJSON(columns)));*@

            // 自定义POST请求
            $('#columns').val(F.toJSON(columns));
            $('#myform')[0].submit();
        }

        function onOpenWindow1Click(event) {
            F.ui.Window1.show();
        }

    </script>
}