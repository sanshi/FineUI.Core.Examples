@page
@model FineUI.Core.Examples.Pages.Grid.SortingPagingDatabaseMultiModel
@{
    ViewBag.Title = "Grid/SortingPagingDatabaseMulti";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" EnableCheckBoxSelect="true" DataIDField="Id" DataTextField="Name"
        AllowPaging="true" PageSize="5" IsDatabasePaging="true" OnPageIndexChanged="Grid1_PageIndexChanged" AllowSorting="true" SortingToolTip="true"
        SortingCancel="true" SortingMulti="true" _SortFieldArray="Gender,ASC" OnSort="Grid1_Sort" SortingCancel="true" SortingToolTip="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" SortField="Name" Width="150" />
            <f:RenderField HeaderText="性别" DataField="Gender" SortField="Gender" FieldType="Int" RendererFunction="renderGender" Width="150" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" SortField="EntranceYear" FieldType="Int" Width="150" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" SortField="AtSchool" RenderAsStaticField="true" Width="150" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
        <Toolbars>
            <f:Toolbar Position="Top">
                <Items>
                    <f:Label ID="labSortOrderTip"></f:Label>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>保留多个列的排序条件，按它们的优先级组合排列记录。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>组合多个排序条件</h3>
        <ol>
            <li>依次点击<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>的<strong>姓名</strong>和<strong>入学年份</strong>列标题。<br />结果：列头操作回发后，后台读取排序字段与方向，重新绑定排序结果；多个列保留排序标记，同一优先字段值相等时再比较后续字段。</li>
            <li>从已排序列的表头菜单选择<strong>取消排序</strong>。<br />结果：只移除当前列的排序条件，其他列继续参与排序；全部取消后恢复未排序顺序。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>在排序结果中换页</h3>
        <ul>
            <li>完成排序后点击下一页，再回到第一页。<br />结果：换页保留当前排序条件，数据按排序后的整体顺序分页，不只在当前页比较。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>SortingMulti</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>true</code>，保留多列排序条件，按字段的先后次序确定排序优先级。
            </li>
            <li><code>SortFieldArray</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>Gender,ASC</code>，保存排序字段与方向的组合；移除一个字段时，其余条件仍生效。
            </li>
            <li><code>SortingCancel</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>true</code>，允许移除排序条件；后台对空条件返回未排序的数据。
            </li>
        </ul>
    </section>
}
