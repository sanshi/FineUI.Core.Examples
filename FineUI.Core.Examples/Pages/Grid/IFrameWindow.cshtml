@page
@model FineUI.Core.Examples.Pages.Grid.IFrameWindowModel
@{
    ViewBag.Title = "Grid/IFrameWindow";
    var F = Html.F();
}

@section body {

    <f:Form ID="SimpleForm1" ShowBorder="false" ShowHeader="false" AutoScroll="true" CssClass="f-widget-content" BodyPadding="10" IsViewPort="true">
        <Toolbars>
            <f:Toolbar ID="Toolbar1">
                <Items>
                    <f:Button ID="btnClose" Text="关闭" Icon="SystemClose" ClickHandler="onCloseActiveWindowClick"></f:Button>
                    <f:Button ID="btnSaveClose" Text="回发弹出窗体" Icon="SystemSave" OnClick="btnSaveClose_Click"></f:Button>
                    <f:Button ID="btnSaveHideRefresh" Text="刷新父页面" Icon="SystemSaveNew" OnClick="btnSaveHideRefresh_Click"></f:Button>
                    <f:Button ID="btnSaveCloseTab" Text="关闭当前选项卡" Icon="SystemSaveClose" OnClick="btnSaveCloseTab_Click"></f:Button>
                    <f:ToolbarFill></f:ToolbarFill>
                    <f:ToolbarText Text="提示一"></f:ToolbarText>
                    <f:ToolbarSeparator></f:ToolbarSeparator>
                    <f:ToolbarText Text="提示二"></f:ToolbarText>
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Rows>
            <f:FormRow>
                <Items>
                    <f:Label ID="labUserName" Label="申请人" Text="三生石上" CssClass="highlight" />
                    <f:Label ID="Label3" Label="电话" Text="0551-1234567" />
                </Items>
            </f:FormRow>
            <f:FormRow>
                <Items>
                    <f:NumberBox ID="NumberBox1" NoDecimal="true" NoNegative="true" Label="数量" Required="true" ShowRedStar="true" />
                    <f:DatePicker ID="DatePicker1" Required="true" ShowRedStar="true" Label="申请日期" Text="2008-05-09">
                    </f:DatePicker>
                </Items>
            </f:FormRow>
            <f:FormRow>
                <Items>
                    <f:TextArea ID="TextArea2" Height="80" Label="描述" Required="true" ShowRedStar="true" />
                </Items>
            </f:FormRow>
            <f:FormRow>
                <Items>
                    <f:HtmlEditor ID="HtmlEditor1" Editor="UMEditor" BasePath="@Url.Content("~/res/third-party/umeditor/")" Label="详细描述" Height="200">
                    </f:HtmlEditor>
                </Items>
            </f:FormRow>
        </Rows>
    </f:Form>


}

@section script {

    <script type="text/javascript">

        function onCloseActiveWindowClick(event) {
            F.activeWindow.hide();
        }

    </script>
}
