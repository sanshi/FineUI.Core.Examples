@page
@model FineUI.Core.Examples.Pages.Grid.SortingClientSorterModel
@{
    ViewBag.Title = "Grid/SortingClientSorter";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" EnableCheckBoxSelect="true" DataIDField="Id" DataTextField="Name" 
            AllowSorting="true" DataSource="@DataSourceUtil.GetDataTable()">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" SortField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" SortField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" SortField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" SortField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" SortField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" SorterFunction="majorSorter" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" />
        </Columns>
        <Toolbars>
            <f:Toolbar ToolbarAlign="Right">
                <Items>
                    <f:DropDownList ID="DropDownList1" Label="[所学专业]列的排序方式" LabelWidth="200" LabelAlign="LabelAlign.Right">
                        <f:ListItem Text="按字母顺序" Value="sort_letter"></f:ListItem>
                        <f:ListItem Text="按字符个数" Value="sort_length"></f:ListItem>
                    </f:DropDownList>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function majorSorter(x, y) {
            if (F.ui.DropDownList1.getValue() === 'sort_letter') {
                return x.localeCompare(y, 'zh');
            } else {
                return x.length - y.length;
            }
        }

    </script>
}