@page
@model FineUI.Core.Examples.Pages.Grid.SortingModel
@{
    ViewBag.SourceFiles = "~/Code/GridSelectionMessage.cs";
    ViewBag.Title = "Grid/Sorting";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" EnableCheckBoxSelect="true" DataIDField="Id" DataTextField="Name"
        AllowSorting="true" SortField="Gender" SortDirection="ASC" OnSort="Grid1_Sort" _DataKeyNames="Id,Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" SortField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" SortField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" SortField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" SortField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" CssClass="marginr" ClickHandler="onNotifySelectedRowsClick"></f:Button>
    <f:Button Text="选中了哪些行（服务端）" CssClass="marginr" ID="Button1" OnClick="Button1_Click"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>点击列标题切换后台排序，表头方向与实际记录顺序保持一致。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>切换排序方向</h3>
        <ol>
            <li>点击<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>的<strong>入学年份</strong>列标题，再次点击同一列。<br />结果：列头操作回发后，后台读取排序字段与方向，重新绑定排序结果；先后采用升序与降序，列标题方向随之变化。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>SortField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>Gender</code>，指定排序使用的数据字段；未设置时初次加载不主动排序。
            </li>
            <li><code>SortDirection</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>ASC</code>，指定排序方向 ASC 或 DESC，并与重新绑定后的记录保持一致。
            </li>
        </ul>
    </section>
}
