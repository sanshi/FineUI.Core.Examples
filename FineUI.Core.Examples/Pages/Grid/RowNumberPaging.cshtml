@page
@model FineUI.Core.Examples.Pages.Grid.RowNumberPagingModel
@{
    ViewBag.Title = "Grid/RowNumberPaging";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（内存分页，切换分页时序号连续）" DataIDField="Id" DataTextField="Name"
        EnableCheckBoxSelect="true" AllowPaging="true" PageSize="5">
        <Columns>
            <f:RowNumberField EnablePagingNumber="true" />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>跨页连续显示行序号，采用浏览器对完整记录分页。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>翻页核对序号连续性</h3>
        <ol>
            <li>点击<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（内存分页，切换分页时序号连续）">表格（内存分页，切换分页时序号连续）</strong>下一页，再返回第一页。<br />结果：第二页的序号接在第一页末尾之后，不重新从 1 开始；行号由页索引与页大小计算，不作为业务主键。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnablePagingNumber</code>（<strong>序号列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（内存分页，切换分页时序号连续）">表格（内存分页，切换分页时序号连续）</strong>）：初始为 <code>true</code>，把页偏移量计入显示序号。</li>
        </ul>
    </section>
}
