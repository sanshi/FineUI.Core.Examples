@page
@model FineUI.Core.Examples.Pages.Grid.CheckFieldDisableSomeModel
@{
    ViewBag.Title = "Grid/CheckFieldDisableSome";
    var F = Html.F();
}


@section head {

    <style>

    </style>

}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool2" RenderAsStaticField="false" DataField="AtSchool" RendererFunction="renderAtSchool2" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br />
    <br />

    <br />
    <br />

    <f:Button Text="选中了哪些行" MarginRight="5" ClickHandler="onNotifySelectedRowsClick"></f:Button>
    <f:Button Text="选中行复选框的状态" ClickHandler="onNotifyCheckFieldStatusClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderAtSchool2(value, params) {
            var entranceYear = params.rowData.values['EntranceYear'];
            if (entranceYear <= 2004) {
                params.cellCls = 'f-state-disabled';
            }

            return value;
        }


        function onNotifyCheckFieldStatusClick(event) {
            var grid1 = F.ui.Grid1;

            var rowEls = grid1.getSelectedRowEls();
            if (!rowEls.length) {
                F.alert('没有选中项！');
                return;
            }

            var result = ['<table class="result">'];
            result.push('<tr>');
            result.push('<th>ID</th>');
            result.push('<th>姓名</th>');
            result.push('<th>是否在校</th>');
            result.push('</tr>');
            rowEls.each(function () {
                var cnode = $(this);
                var rowData = grid1.getRowData(cnode);
                var isChecked = rowData.values['AtSchool2'];

                result.push('<tr>');
                result.push('<td>' + rowData.id + '</td>');
                result.push('<td>' + rowData.text + '</td>');
                result.push('<td>' + (isChecked ? '在校' : '不在校') + '</td>');
                result.push('</tr>');
            });
            result.push('</table>');

            F.notify({
                message: F.rawHtml(result.join('')),
                target: '_top',
                header: false,
                messageIcon: '',
                positionX: 'center',
                positionY: 'top'
            });
        }


    </script>
}
@section exampleDescription {
<section aria-label="页面描述">
    <p>按入学年份禁用部分行的可编辑复选框，保留其他记录的切换能力。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>对照受限行与普通行</h3>
    <ul>
        <li>对照<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>中入学年份不大于 2004 的记录与其他记录，尝试点击第二个是否在校列的复选框。<br />结果：命中条件的复选框呈现禁用外观且不能切换，其他行仍可正常修改。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <p>注：本示例禁用 EntranceYear&lt;=2004 的复选框，通过CSS样式来禁用（f-state-disabled）。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>RendererFunction</code>（<strong>可修改的复选框列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：渲染时读取 EntranceYear；本页只对不大于 2004 的记录附加隐藏或禁用样式。</li>
        <li><code>CSS</code>（<strong>页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：给命中条件的单元格附加禁用类，不对整张表格禁用。</li>
    </ul>
</section>
}
