@page
@model FineUI.Core.Examples.Pages.Grid.HeaderColumnAttributesModel
@{
    ViewBag.SourceFiles = "~/wwwroot/res/js/grid.js";
    ViewBag.Title = "Grid/HeaderColumnAttributes";
    var F = Html.F();
}

@section head {

    <style>

        .f-grid-colheader[data-header-color=color1] .f-grid-colheader-title {
            font-weight: bold;
        }

    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name">
                <Attributes>
                    <f:Attribute Key="data-header-color" Value="color1" />
                </Attributes>
            </f:RenderField>
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender">
                <Attributes>
                    <f:Attribute Key="data-header-color" Value="color1" />
                </Attributes>
            </f:RenderField>
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>给指定列标题增加自定义属性，再通过 CSS 单独设置表头样式。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>比较表头与数据单元格</h3>
        <ul>
            <li>对照<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>的<strong>姓名</strong>、<strong>性别</strong>标题和其下数据。<br />结果：指定表头带有本页配置的颜色样式，普通数据单元格不自动套用同一表头样式。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Attributes / CSS</code>（<strong>姓名与性别列标题</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：列标题设置 <code>data-header-color</code>，本页 CSS 按属性选择表头元素。</li>
        </ul>
    </section>
}
