@page
@model FineUI.Core.Examples.Pages.Grid.IFrameClientModel
@{
    ViewBag.SourceFiles = "~/Grid/IFrameWindow";
    ViewBag.Title = "Grid/IFrameClient";
    var F = Html.F();
}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataSource="@DataSourceUtil.GetDataTable()">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="窗口列">
                <Commands>
                    <f:Command CommandName="Action1" Text="编辑" CssClass="mywindowfield" />
                </Commands>
            </f:RenderField>
        </Columns>
        <Listeners>
            <f:Listener Event="rowdblclick" Handler="onGrid1RowDblClick"></f:Listener>
            <f:Listener Event="rowcommand" Handler="onGrid1RowCommand"></f:Listener>
        </Listeners>
    </f:Grid>

    <br>
    <br>
    注：本示例需要客户端 JavaScript，实现稍微复杂。推荐方案：表格/行命令/弹出窗体列。

    <f:Window ID="Window1" Title="编辑" Hidden="true" EnableIFrame="true" CloseAction="HidePostBack" EnableMaximize="true" EnableResize="true"
              OnClose="Window1_Close" Target="Top" IsModal="true" Width="850" Height="500">
    </f:Window>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        // 打开窗体
        function openWindow(rowId) {
            var rowData = F.ui.Grid1.getRowData(rowId);

            // /Grid/IFrameWindow?id=104&name=刘国
            var iframeWindowUrl = '@Url.Content("~/Grid/IFrameWindow")';
            var iframeUrl = iframeWindowUrl + '?id=' + rowData.id + '&name=' + encodeURIComponent(rowData.text);

            // 显示窗体
            F.ui.Window1.show(iframeUrl, '详细信息 - ' + rowData.text);
        }

        // 双击行
        function onGrid1RowDblClick(event, rowId) {
            openWindow(rowId);
        }

        // 行命令
        function onGrid1RowCommand(event, rowId, rowIndex, columnId, commandName) {
            if (commandName === 'Action1') {
                openWindow(rowId);
            }
        }

    </script>
}
