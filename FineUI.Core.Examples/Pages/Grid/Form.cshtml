@page
@model FineUI.Core.Examples.Pages.Grid.FormModel
@{
    ViewBag.Title = "Grid/Form";
    var F = Html.F();
}


@section head {

    <style>
        /* 表格与表单左右分栏，给表格右侧留一条分隔线 */
        .maingrid {
            border-width: 0 1px 0 0;
        }
    </style>

}


@section body {

    <f:Panel ID="Panel1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格与表单" Layout="HBox" Height="500">
        <Items>
            <f:Grid ID="Grid1" ShowBorder="true" ShowHeader="false" EnableCollapse="false" BoxFlex="1" CssClass="maingrid" DataIDField="Id" DataTextField="Name"
                AllowCellEditing="true" ClicksToEdit="2">
                <Columns>
                    <f:RowNumberField Width="60" />
                    <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name" />
                    <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender" Hidden="true" />
                    <f:RenderField HeaderText="入学年份" ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int" />
                    <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date"
                        RendererArgument="yyyy-MM-dd" Width="150" Hidden="true" />
                    <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool" DataField="AtSchool" EnableColumnEdit="false" />
                    <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" ExpandUnusedSpace="true" MinWidth="150" />
                </Columns>
                <Listeners>
                    <f:Listener Event="rowselect" Handler="onGridRowSelect"></f:Listener>
                </Listeners>
            </f:Grid>
            <f:SimpleForm ID="SimpleForm1" ShowBorder="false" ShowHeader="false" BodyPadding="10" Width="300">
                <Items>
                    <f:HiddenField ID="hfFormID"></f:HiddenField>
                    <f:TextBox ID="tbxFormUserName" Label="姓名" ShowRedStar="true" Required="true"></f:TextBox>
                    <f:RadioButtonList ID="rblFormGender" Label="性别" ShowRedStar="true" Required="true">
                        <f:RadioItem Text="男" Value="1" />
                        <f:RadioItem Text="女" Value="0" />
                    </f:RadioButtonList>
                    <f:NumberBox ID="nbFormEntranceYear" Label="入学年份" NoDecimal="true" NoNegative="true" MinValue="2000" MaxValue="2025" ShowRedStar="true"
                        Required="true"></f:NumberBox>
                    <f:DatePicker ID="dpFormEntranceDate" Label="入学日期" ShowRedStar="true" Required="true"></f:DatePicker>
                    <f:CheckBox ID="cbFormAtSchool" Label="是否在校"></f:CheckBox>
                    <f:DropDownList ID="ddlFormMajor" Label="所学专业" ShowRedStar="true" Required="true" AutoSelectFirstItem="false">
                        <f:ListItem Text="材料科学与工程系" Value="材料科学与工程系" />
                        <f:ListItem Text="化学系" Value="化学系" />
                        <f:ListItem Text="数学系" Value="数学系" />
                        <f:ListItem Text="物理系" Value="物理系" />
                        <f:ListItem Text="自动化系" Value="自动化系" />
                        <f:ListItem Text="计算机科学与工程系" Value="计算机科学与工程系" />
                    </f:DropDownList>
                </Items>
                <Toolbars>
                    <f:Toolbar Position="Bottom">
                        <Items>
                            <f:Button ID="btnNew" Icon="Add" ClickHandler="onNewButtonClick"></f:Button>
                            <f:Button ID="btnDelete" Enabled="false" Icon="Delete" ConfirmText="确定删除当前数据？" OnClick="btnDelete_Click"></f:Button>
                            <f:ToolbarFill></f:ToolbarFill>
                            <f:Button ID="btnSave" Icon="SystemSave" Text="保存数据（新增）" _ValidateForms="SimpleForm1" OnClick="btnSave_Click"></f:Button>
                        </Items>
                    </f:Toolbar>
                </Toolbars>
            </f:SimpleForm>
        </Items>
    </f:Panel>

}


@section script {

    <script>

        function renderGender(value) {
            return value == 1 ? '男' : '女';
        }


        // 表格选中行变化：把当前行数据灌进右侧表单，并切成「编辑」状态
        function onGridRowSelect(event, rowId) {
            var grid1 = F.ui.Grid1;

            // 有选中行才允许删除
            F.ui.btnDelete.enable();

            // 当前行数据
            var rowValue = grid1.getRowValue(rowId);

            // 使用当前行数据填充表单字段
            F.ui.hfFormID.setValue(rowId);
            F.ui.tbxFormUserName.setValue(rowValue['Name']);
            F.ui.rblFormGender.setValue(rowValue['Gender']);
            F.ui.nbFormEntranceYear.setValue(rowValue['EntranceYear']);
            F.ui.dpFormEntranceDate.setValue(rowValue['EntranceDate']);
            F.ui.cbFormAtSchool.setValue(rowValue['AtSchool']);
            F.ui.ddlFormMajor.setValue(rowValue['Major']);

            // 更新保存按钮文本
            F.ui.btnSave.setText('保存数据（编辑）');
        }


        // 新增：清空表单与表格选中行，回到「新增」状态
        function onNewButtonClick(event) {
            // 重置表单字段
            F.ui.SimpleForm1.reset();
            // 清空表格选中行
            F.ui.Grid1.clearSelection();
            // 禁用删除按钮
            F.ui.btnDelete.disable();

            // 更新保存按钮文本
            F.ui.btnSave.setText('保存数据（新增）');
        }

    </script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>选择表格行填充旁边表单，在同一表单中完成新增、编辑与删除。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>选择记录后编辑并保存</h3>
        <ol>
            <li>选择<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>一行。<br />结果：表单填入所选记录的<strong>姓名</strong>、<strong>性别</strong>、年份等资料，保存行为切换到编辑该条记录。</li>
            <li>将<strong class="example-control-reference" data-example-control="tbxFormUserName"
                    title="第 1 个文本框（姓名）">表单的姓名</strong>改为<code>改过的名字</code>，点击<strong class="example-control-reference" data-example-control="btnSave"
                    title="保存数据（新增）">保存数据（新增）</strong>。<br />结果：表单验证通过后回发，后台按记录标识更新示例数据并重新绑定，原行显示新<strong>姓名</strong>。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>用同一表单新增记录</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="btnNew"
                    title="新增（加号图标）">新增（加号图标）</strong>，填写<strong>姓名</strong>等必填资料并保存。<br />结果：清空原记录标识，表单进入新增状态；验证通过后后台创建新记录并绑定到表格，不覆盖刚才的原记录。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>确认删除所选记录</h3>
        <ul>
            <li>选择一条已有记录，点击<strong class="example-control-reference" data-example-control="btnDelete"
                    title="删除（删除图标）">删除（删除图标）</strong>并确认。<br />结果：后台删除对应示例记录并重新绑定；未选择已有记录时不会以新增表单的空标识删除数据。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>rowselect / setValue</code>（<strong>表格选择与表单回填脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：选择当前行后把行数据填入表单，同时记录本次编辑的业务主键。</li>
            <li><code>ValidateForms</code>（<strong class="example-control-reference" data-example-control="btnSave" title="保存数据（新增）">保存数据（新增）</strong>）：初始为
                <code>SimpleForm1</code>，提交前检查本页编辑表单，失败时保留用户输入并阻止保存。
            </li>
        </ul>
    </section>
}
