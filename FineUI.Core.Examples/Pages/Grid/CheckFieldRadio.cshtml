@page
@model FineUI.Core.Examples.Pages.Grid.CheckFieldRadioModel
@{
    ViewBag.Title = "Grid/CheckFieldRadio";
    var F = Html.F();
}

@section head {

    <style>
        .f-field-body-checkboxlabel {
            white-space: nowrap;
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataSource="@DataSourceUtil.GetDataTable()">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderCheckField HeaderText="是否在校2" ColumnID="AtSchool2" RenderAsStaticField="false" DisplayType="Default" />
            <f:RenderCheckField HeaderText="是否在校3" ColumnID="AtSchool3" RenderAsStaticField="false" DisplayType="Switch" />
            <f:RenderCheckField HeaderText="是否在校4" ColumnID="AtSchool4" RenderAsStaticField="false" DisplayType="Radio" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中行复选框的状态" ClickHandler="onNotifyCheckFieldStatusClick"></f:Button>

}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>



        function onNotifyCheckFieldStatusClick(event) {
            var grid1 = F.ui.Grid1;

            var rowEls = grid1.getSelectedRowEls();
            if (!rowEls.length) {
                F.alert('没有选中项！');
                return;
            }

            var result = ['<table class="result">'];
            result.push('<tr>');
            result.push('<th>ID</th>');
            result.push('<th>姓名</th>');
            result.push('<th>是否在校2</th>');
            result.push('<th>是否在校3</th>');
            result.push('<th>是否在校4</th>');
            result.push('</tr>');
            rowEls.each(function () {
                var cnode = $(this);
                var rowData = grid1.getRowData(cnode);
                var isChecked2 = rowData.values['AtSchool2'];
                var isChecked3 = rowData.values['AtSchool3'];
                var isChecked4 = rowData.values['AtSchool4'];

                result.push('<tr>');
                result.push('<td>' + rowData.id + '</td>');
                result.push('<td>' + rowData.text + '</td>');
                result.push('<td>' + (isChecked2 ? '在校' : '不在校') + '</td>');
                result.push('<td>' + (isChecked3 ? '在校' : '不在校') + '</td>');
                result.push('<td>' + (isChecked4 ? '在校' : '不在校') + '</td>');
                result.push('</tr>');
            });
            result.push('</table>');

            F.notify({
                message: F.rawHtml(result.join('')),
                target: '_top',
                header: false,
                messageIcon: '',
                positionX: 'center',
                positionY: 'top'
            });
        }

        F.ready(function () {

            var grid1 = F.ui.Grid1;
            var checkboxSelector = '.f-grid-cell .f-grid-checkbox';

            // 同一列只保留一个选中项；数据更新不会再次触发点击，避免互斥处理循环。
            grid1.el.on('click', checkboxSelector, function (event) {
                var cellEl = $(this).closest('.f-grid-cell');
                var rowEl = cellEl.closest('.f-grid-row');
                var columnId = cellEl.attr('data-columnid');
                var rowData = grid1.getRowData(rowEl);

                // 框架已同步本次点击的当前值，取消选中时无需修改其它行。
                if (!rowData.values[columnId]) {
                    return;
                }

                rowEl.siblings('.f-grid-row').each(function () {
                    // 列名在运行时确定，用实际 ColumnID 作为对象的键更新对应单元格。
                    // https://fineui.com/js/api/FineUI.Grid.html#updateCellValue
                    grid1.updateCellValue($(this), { [columnId]: false }, true);
                });
            });
        });

    </script>
}