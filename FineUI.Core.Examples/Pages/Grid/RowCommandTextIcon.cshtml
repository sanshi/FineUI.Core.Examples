@page
@model FineUI.Core.Examples.Pages.Grid.RowCommandTextIconModel
@{
    ViewBag.Title = "Grid/RowCommandTextIcon";
    var F = Html.F();
}


@section head {

    <style>
        .mybtn3 .f-icon.f-icon-remove {
            color: red;
        }
    </style>

}

@section body {

    @{
        var COMMAND_TEXT = "<i class=\"f-icon f-grid-cell-iconfont f-icon-remove\"></i>&nbsp;删除";
    }

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
            OnRowCommand="Grid1_RowCommand" _DataKeyNames="Id,Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="">
                <Commands>
                    <f:Command CommandName="Action3" ToolTip="删除此项记录" _TextRawHtml="@COMMAND_TEXT" CssClass="mybtn3" ConfirmText="你确定要这么做吗？" ConfirmTarget="Top" />
                </Commands>
            </f:RenderField>
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>使用自定义命令正文或图标显示行操作，点击后仍按命令名处理。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>对照命令外观与对应结果</h3>
    <ul>
        <li>分别点击<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>同一行中的文字或图标命令，出现确认框时先确认。<br />结果：命令回发后，提示显示所点记录和命令信息；改变显示外观或同列排列，不会把多个入口合并为同一命令。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>TextRawHtml</code>（<strong>行命令</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：控制命令显示的正文或图标；业务动作仍由命令标识或对应点击处理器决定。</li>
    </ul>
</section>
}
