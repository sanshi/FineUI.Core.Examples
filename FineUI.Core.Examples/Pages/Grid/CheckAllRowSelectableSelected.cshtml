@page
@model FineUI.Core.Examples.Pages.Grid.CheckAllRowSelectableSelectedModel
@{
    ViewBag.Title = "Grid/CheckAllRowSelectableSelected";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" EnableCheckBoxSelect="true" DataIDField="Id" DataTextField="Name"
        RowDataBoundFunction="onGrid1RowDataBound" DisableUnselectableRows="true" _SelectedRowIDArray="103,105">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br>

    <f:Button Text="选中了哪些行（客户端）" CssClass="marginr" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <br />
    <br />


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onGrid1RowDataBound(rowData) {
            if (rowData.values.EntranceYear >= 2008) {
                rowData.unselectable = true;
            }
        }

        // 覆盖 grid.js 中定义的 renderMajor 函数
        function renderMajor(value, params) {
            var text = F.htmlEncode(value);
            // 如果本行禁用，则不显示[所学专业]的超链接
            if (params.rowData.unselectable) {
                return text;
            } else {
                var url = 'http://gsa.ustc.edu.cn/search?q=' + F.urlEncode(value);
                return F.formatString('<a href="{0}" data-qtip="{1}" target="_blank">{1}</a>', url, text);
            }
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在客户端行绑定时禁止指定记录被选择，并把不可选行显示为禁用外观。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>对照预选记录与不可选限制</h3>
        <ol>
            <li>点击<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>中入学年份大于等于 2008
                的行复选框，再选择一条允许选择的记录。<br />结果：受限制的记录不会因点击新增选择，允许选择的记录正常勾选；不可选行同时呈现灰色禁用外观。</li>
            <li>从初始状态点击表头全选框。<br />结果：全选只新增允许选择的行；初始已选中的不可选行仍保留，不把其他不可选行加入选择。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>RowDataBoundFunction / unselectable</code>（<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：行绑定函数按入学年份设置不可选标记，不影响其他记录。</li>
            <li><code>DisableUnselectableRows</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>true</code>，给不可选记录增加禁用外观，选择限制由逐行可选状态决定。
            </li>
            <li><code>SelectedRowIDArray</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>103,105</code>，指定初次加载已选的业务主键；预选状态与之后是否允许用户改变选择分别处理。
            </li>
        </ul>
    </section>
}
