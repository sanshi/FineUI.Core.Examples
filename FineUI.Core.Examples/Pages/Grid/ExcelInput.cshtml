@page
@model FineUI.Core.Examples.Pages.Grid.ExcelInputModel
@{
    ViewBag.SourceFiles = "~/Pages/Grid/ExcelInputExport.cshtml;~/Pages/Grid/ExcelInputExport.cshtml.cs;~/Code/UrlUtil.cs";
    ViewBag.Title = "Grid/ExcelInput";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="语文成绩" DataField="ChineseScore" RendererFunction="renderChineseScore" Width="150" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button ID="btnExportExcelGet" MarginRight="5" Text="导出为Excel文件（GET请求）" ClickHandler="onButton1Click"></f:Button>
    <f:Button ID="btnExportExcelPost" MarginRight="5" Text="导出为Excel文件（POST请求）" ClickHandler="onButton2Click"></f:Button>


    <!-- 隐藏表单，用于自定义POST请求 -->
    <form id="myform" asp-page="/Grid/ExcelInputExport" method="post">
        <input type="hidden" id="content" name="content" />
    </form>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderChineseScore(value, params) {
            return F.formatString('<input value="{0}" class="chinese-score" style="width:100px;" type="text">', value);
        }

        // 获取用户输入值与行ID的对应关系
        function getUserInputs() {
            var result = {};

            var grid1 = F.ui.Grid1;
            grid1.getRowEls().each(function () {
                var rowEl = $(this);
                var rowData = grid1.getRowData(rowEl);
                var rowChineseScore = parseInt(rowEl.find('input.chinese-score').val(), 10);

                result[rowData.id] = rowChineseScore;
            });

            return result;
        }

        // HTTP - Get （HTTP Get有长度限制，不适合传递大量数据！！！）
        function onButton1Click(event) {
            window.location.href = '@Url.Content("~/Grid/ExcelInput/ExportToExcel")' + '?content=' + F.urlEncode(F.toJSON(getUserInputs()));
        }


        // HTTP - Post
        function onButton2Click(event) {
            // 自定义POST请求
            $('#content').val(F.toJSON(getUserInputs()));
            $('#myform')[0].submit();
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>把行内尚未保存的成绩输入带入导出，对照 GET 与自定义 POST 两种请求。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>让导出包含当前输入</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>首行<strong>语文成绩</strong>输入框填写<code>9999</code>，点击<strong class="example-control-reference" data-example-control="btnExportExcelGet" title="导出为Excel文件（GET请求）">导出为Excel文件（GET请求）</strong>。<br />结果：脚本按行标识收集当前输入，GET 请求把 JSON 放入查询参数；下载文件中首行<strong>语文成绩</strong>为 9999。</li>
        <li>再修改输入，并点击<strong class="example-control-reference" data-example-control="btnExportExcelPost" title="导出为Excel文件（POST请求）">导出为Excel文件（POST请求）</strong>。<br />结果：相同输入集合改由隐藏表单 POST 提交，导出反映最新值；无需先把输入保存到数据源。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>getUserInputs</code>（<strong>页面导出处理</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：读取实际输入框的当前值，以行标识区分记录，不只使用首次绑定的成绩。</li>
        <li><code>GET / POST</code>（<strong>页面导出处理</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：GET 查询参数有长度限制，不适合大量输入；POST 把 JSON 放入表单字段后提交，二者都让浏览器接收附件。</li>
    </ul>
</section>
}
