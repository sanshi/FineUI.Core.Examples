@page "{handler?}"
@model FineUI.Core.Examples.Pages.Grid.ExcelInputModel
@{
    ViewBag.Title = "Grid/ExcelInput";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataSource="@DataSourceUtil.GetDataTable()">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="语文成绩" DataField="ChineseScore" RendererFunction="renderChineseScore" Width="150" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button MarginRight="5" Text="导出为Excel文件（GET请求）" ClickHandler="onButton1Click"></f:Button>
    <f:Button MarginRight="5" Text="导出为Excel文件（POST请求）" ClickHandler="onButton2Click"></f:Button>


    <!-- 隐藏表单，用于自定义POST请求 -->
    <form id="myform" asp-page-handler="ExportToExcel" method="post">
        <input type="hidden" id="content" name="content" />
    </form>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderChineseScore(value, params) {
            return F.formatString('<input value="{0}" class="chinese-score" style="width:100px;" type="text">', value);
        }

        // 获取用户输入值与行ID的对应关系
        function getUserInputs() {
            var result = {};

            var grid1 = F.ui.Grid1;
            grid1.getRowEls().each(function () {
                var rowEl = $(this);
                var rowData = grid1.getRowData(rowEl);
                var rowChineseScore = parseInt(rowEl.find('input.chinese-score').val(), 10);

                result[rowData.id] = rowChineseScore;
            });

            return result;
        }

        // HTTP - Get （HTTP Get有长度限制，不适合传递大量数据！！！）
        function onButton1Click(event) {
            window.location.href = '@Url.Content("~/Grid/ExcelInput/ExportToExcel")' + '?content=' + F.urlEncode(F.toJSON(getUserInputs()));
        }


        // HTTP - Post
        function onButton2Click(event) {
            // 自定义POST请求
            $('#content').val(F.toJSON(getUserInputs()));
            $('#myform')[0].submit();
        }

    </script>
}