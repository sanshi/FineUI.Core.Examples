@page
@model FineUI.Core.Examples.Pages.Grid.FormWindowModel
@{
    ViewBag.Title = "Grid/FormWindow";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" EnableCollapse="false" Title="表格与表单" DataIDField="Id" DataTextField="Name"
        AllowCellEditing="true" ClicksToEdit="2" OnRowCommand="Grid1_RowCommand" _DataKeyNames="Id,Name">
        <Toolbars>
            <f:Toolbar ID="Toolbar2" Position="Top">
                <Items>
                    <f:Button ID="btnNew" Text="新增" Icon="Add" ClickHandler="onNewButtonClick"></f:Button>
                    <f:Button ID="btnEdit" Text="编辑" Icon="Pencil" ClickHandler="onEditButtonClick"></f:Button>
                    <f:Button ID="btnDelete" Text="删除" Icon="Delete" ClickHandler="onDeleteButtonClick"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Columns>
            <f:RowNumberField Width="60" />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name" />
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender" Hidden="true" />
            <f:RenderField HeaderText="入学年份" ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int" />
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd"
                Width="150" Hidden="true" />
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool" DataField="AtSchool" EnableColumnEdit="false" />
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField ColumnID="Edit" Width="50" TextAlign="Center" EnableHeaderMenu="false">
                <Commands>
                    <f:Command CommandName="Edit" Icon="Pencil" />
                </Commands>
            </f:RenderField>
            <f:RenderField ColumnID="Delete" Width="50" TextAlign="Center" EnableHeaderMenu="false">
                <Commands>
                    <f:Command CommandName="Delete" Icon="Delete" ConfirmText="删除选中行？" ConfirmTarget="Top" />
                </Commands>
            </f:RenderField>
        </Columns>
        <Listeners>
            <f:Listener Event="rowcommand" Handler="onGrid1RowCommand"></f:Listener>
        </Listeners>
    </f:Grid>

    <f:Window ID="Window1" Title="弹出窗体" Hidden="true" EnableIFrame="false" EnableMaximize="true" EnableResize="true" IsModal="true" Width="600">
        <Items>
            <f:SimpleForm ID="SimpleForm1" ShowBorder="false" ShowHeader="false" BodyPadding="10">
                <Items>
                    <f:HiddenField ID="hfFormID"></f:HiddenField>
                    <f:TextBox ID="tbxFormUserName" Label="姓名" ShowRedStar="true" Required="true"></f:TextBox>
                    <f:RadioButtonList ID="rblFormGender" Label="性别" ShowRedStar="true" Required="true">
                        <f:RadioItem Text="男" Value="1" />
                        <f:RadioItem Text="女" Value="0" />
                    </f:RadioButtonList>
                    <f:NumberBox ID="nbFormEntranceYear" Label="入学年份" NoDecimal="true" NoNegative="true" MinValue="2000" MaxValue="2025" ShowRedStar="true"
                        Required="true"></f:NumberBox>
                    <f:DatePicker ID="dpFormEntranceDate" Label="入学日期" ShowRedStar="true" Required="true" EnableEdit="false"></f:DatePicker>
                    <f:CheckBox ID="cbFormAtSchool" Label="是否在校"></f:CheckBox>
                    <f:DropDownList ID="ddlFormMajor" Label="所学专业" ShowRedStar="true" Required="true" AutoSelectFirstItem="false">
                        <f:ListItem Text="材料科学与工程系" Value="材料科学与工程系" />
                        <f:ListItem Text="化学系" Value="化学系" />
                        <f:ListItem Text="数学系" Value="数学系" />
                        <f:ListItem Text="物理系" Value="物理系" />
                        <f:ListItem Text="自动化系" Value="自动化系" />
                        <f:ListItem Text="计算机科学与工程系" Value="计算机科学与工程系" />
                    </f:DropDownList>
                </Items>
                <Toolbars>
                    <f:Toolbar ID="Toolbar1" Position="Bottom" ToolbarAlign="Right">
                        <Items>
                            <f:Button ID="btnSave" Icon="SystemSave" Text="保存数据" _ValidateForms="SimpleForm1" OnClick="btnSave_Click"></f:Button>
                        </Items>
                    </f:Toolbar>
                </Toolbars>
            </f:SimpleForm>
        </Items>
    </f:Window>

}

@section script {

    <script>

        function renderGender(value) {
            return value == 1 ? '男' : '女';
        }


        // 新增：清空表单字段后弹出窗体
        function onNewButtonClick(event) {
            // 重置表单字段
            F.ui.SimpleForm1.reset();

            // 弹出窗体
            F.ui.Window1.show();
            F.ui.Window1.setTitle('新增数据');
        }


        // 编辑：作用于表格当前选中的那一行
        function onEditButtonClick(event) {
            showEditWindow();
        }


        // 删除：行数只有浏览器知道，所以在客户端拼提示文案，确认后用自定义回发把行标识送到服务端
        function onDeleteButtonClick(event) {
            var grid1 = F.ui.Grid1;
            if (!grid1.hasSelection()) {
                F.alert('请至少选择一项！');
                return false;
            }

            var selectedRows = grid1.getSelectedRows();
            F.confirm({
                message: F.rawHtml('你确定要删除选中的&nbsp;<b>' + selectedRows.length + '</b>&nbsp;行数据吗？'),
                messageIcon: 'warning',
                ok: function () {
                    F.customEvent('Grid1_DeleteRows', {
                        selectedRows: selectedRows
                    });
                }
            });

            // 确认框是异步的，没法在这里等用户点完，所以先取消本次点击的后续动作
            return false;
        }


        // 行命令：编辑走客户端（返回 false 阻止服务端事件），删除交给服务端的 Grid1_RowCommand
        function onGrid1RowCommand(event, rowId, rowIndex, columnId, commandName) {
            if (commandName === 'Edit') {
                showEditWindow(rowId);

                // 阻止服务端事件的执行
                return false;
            }
        }


        // 弹出编辑窗体，并把当前行数据灌进表单字段
        function showEditWindow(rowId) {
            var grid1 = F.ui.Grid1;

            // 如果传入参数为空，则获取当前选中行
            if (!rowId) {
                var selectedRowIds = grid1.getSelectedRows();
                if (!selectedRowIds.length) {
                    F.alert('请至少选择一项！');
                    return;
                }

                rowId = selectedRowIds[0];
            }

            F.ui.Window1.setTitle('编辑数据');

            // 当前行数据
            var rowValue = grid1.getRowValue(rowId);

            // 使用当前行数据填充表单字段
            F.ui.hfFormID.setValue(rowId);
            F.ui.tbxFormUserName.setValue(rowValue['Name']);
            F.ui.rblFormGender.setValue(rowValue['Gender']);
            F.ui.nbFormEntranceYear.setValue(rowValue['EntranceYear']);
            F.ui.dpFormEntranceDate.setValue(rowValue['EntranceDate']);
            F.ui.cbFormAtSchool.setValue(rowValue['AtSchool']);
            F.ui.ddlFormMajor.setValue(rowValue['Major']);

            // 弹出窗体
            F.ui.Window1.show();
        }

    </script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在独立窗体中新增或编辑学生，表单保存后立即更新后台示例数据与表格。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>选择记录后编辑并保存</h3>
        <ol>
            <li>选择<strong class="example-control-reference" data-example-control="Grid1" title="表格与表单">表格与表单</strong>一行，点击<strong
                    class="example-control-reference" data-example-control="btnEdit"
                    title="编辑">编辑</strong>。<br />结果：表单填入所选记录的<strong>姓名</strong>、<strong>性别</strong>、年份等资料，保存行为切换到编辑该条记录。</li>
            <li>将<strong class="example-control-reference" data-example-control="tbxFormUserName" title="表单的姓名">表单的姓名</strong>改为<code>改过的名字</code>，点击<strong
                    class="example-control-reference" data-example-control="btnSave"
                    title="保存数据">保存数据</strong>。<br />结果：表单验证通过后回发，后台按记录标识更新示例数据并重新绑定，原行显示新<strong>姓名</strong>。编辑窗体关闭。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>用同一表单新增记录</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="btnNew"
                    title="新增">新增</strong>，填写<strong>姓名</strong>等必填资料并保存。<br />结果：清空原记录标识，表单进入新增状态；验证通过后后台创建新记录并绑定到表格，不覆盖刚才的原记录。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>确认删除所选记录</h3>
        <ul>
            <li>选择一条已有记录，点击<strong class="example-control-reference" data-example-control="btnDelete"
                    title="删除">删除</strong>并确认。<br />结果：后台删除对应示例记录并重新绑定；未选择已有记录时不会以新增表单的空标识删除数据。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>rowselect / setValue</code>（<strong>表格选择与表单回填脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格与表单">表格与表单</strong>）：选择当前行后把行数据填入表单，同时记录本次编辑的业务主键。</li>
            <li><code>ValidateForms</code>（<strong class="example-control-reference" data-example-control="btnSave" title="保存数据">保存数据</strong>）：初始为
                <code>SimpleForm1</code>，提交前检查本页编辑表单，失败时保留用户输入并阻止保存。
            </li>
        </ul>
    </section>
}
