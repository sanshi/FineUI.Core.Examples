@page
@model FineUI.Core.Examples.Pages.Grid.SortingMultiServerModel
@{
    ViewBag.Title = "Grid/SortingMultiServer";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" EnableCheckBoxSelect="true" DataIDField="Id" DataTextField="Name"
            AllowSorting="true" SortingToolTip="true" SortingCancel="true" SortingMulti="true" _SortFieldArray="Gender,ASC" OnSort="Grid1_Sort">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" SortField="Name" Width="150" />
            <f:RenderField HeaderText="性别" DataField="Gender" SortField="Gender" FieldType="Int" RendererFunction="renderGender" Width="150" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" SortField="EntranceYear" FieldType="Int" Width="150" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" SortField="AtSchool" RenderAsStaticField="true" Width="150" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
        <Toolbars>
            <f:Toolbar Position="Top">
                <Items>
                    <f:Label ID="labSortOrderTip"></f:Label>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick" MarginRight="5"></f:Button>

    <f:Button ID="btnChangeOnServer" Text="[入学年份]正序，[姓名]倒序" OnClick="btnChangeOnServer_Click"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>由后台一次设置多列排序条件，同时更新数据顺序和各列表头的方向标记。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>后台指定组合排序</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="btnChangeOnServer" title="[入学年份]正序，[姓名]倒序">[入学年份]正序，[姓名]倒序</strong>。<br />结果：后台先按入学年份升序排列，同一年份再按姓名降序排列；重新绑定后的记录和两个列标题标记一致。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>SortFieldArray</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>Gender,ASC</code>，保存有先后顺序的字段与方向组合；本页按钮把<strong>入学年份</strong> ASC、姓名 DESC 依次写入并重新绑定数据。</li>
    </ul>
</section>
}
