@page
@model FineUI.Core.Examples.Pages.Grid.ExcelGroupFieldModel
@{
    ViewBag.SourceFiles = "~/Pages/Grid/ExcelGroupFieldExport.cshtml;~/Pages/Grid/ExcelGroupFieldExport.cshtml.cs";
    ViewBag.Title = "Grid/ExcelGroupField";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:GroupField HeaderText="分组一" TextAlign="Center">
                <Columns>
                    <f:RenderField HeaderText="姓名" DataField="Name" />
                    <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
                    <f:GroupField HeaderText="考试成绩" TextAlign="Center">
                        <Columns>
                            <f:RenderField HeaderText="语文成绩" DataField="ChineseScore" TextAlign="Center" />
                            <f:RenderField HeaderText="数学成绩" DataField="MathScore" TextAlign="Center" />
                            <f:RenderField HeaderText="总成绩" DataField="TotalScore" TextAlign="Center" />
                        </Columns>
                    </f:GroupField>
                </Columns>
            </f:GroupField>
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button ID="btnExportExcel" Text="导出为Excel文件" ClickHandler="onButton1Click"></f:Button>


    <!-- 隐藏表单，用于自定义POST请求 -->
    <form id="myform" asp-page="/Grid/ExcelGroupFieldExport" method="post">
        <input type="hidden" id="content" name="content" />
    </form>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function getResolvedColumns(columns) {
            var result = [];
            for (var i = 0, count = columns.length; i < count; i++) {
                var column = columns[i];

                var columnResult = {
                    text: column.text
                    //columnType: column.columnType,
                    //columnId: column.columnId
                };

                if (column.columns) {
                    columnResult.columns = getResolvedColumns(column.columns);
                }

                result.push(columnResult);
            }
            return result;
        }

        function getColumns() {
            return getResolvedColumns(F.ui.Grid1.columns);
        }


        function onButton1Click(event) {
            // 自定义POST请求
            $('#content').val(F.toJSON(getColumns()));
            $('#myform')[0].submit();
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>将多层分组表头与学生数据一起导出，保留表头的层级关系。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>导出分组表头与行数据</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="btnExportExcel" title="导出为Excel文件">导出为Excel文件</strong>。<br />结果：后台读取表格列和数据，以附件返回 myexcel.xls；多层标题按分组生成对应合并单元格，数据仍对应叶子列。本页生成的是 HTML 表格文件，不是原生 XLSX 工作簿。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Content-Type / Content-Disposition</code>（<strong>页面导出处理</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：设置 Excel 响应类型与附件文件名，让浏览器按下载处理，不在示例 iframe 中显示文件内容。</li>
        <li><code>GroupField / colspan / rowspan</code>（<strong>页面导出处理</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：遍历表头层级，用行列合并保留分组标题与叶子列的对应关系。</li>
    </ul>
</section>
}
