@page
@model FineUI.Core.Examples.Pages.Grid.WidthForcefitModel
@{
    ViewBag.Title = "Grid/WidthForcefit";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（ForceFit=true，各列宽度自适应）(改变页面大小来观察每列宽度的变化)" DataIDField="Id" DataTextField="Name" DataSource="@DataSourceUtil.GetDataTable()" IsViewPort="true" Margin="24" ForceFit="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" Width="200" />
            <f:RenderField HeaderText="个人简介" DataField="Desc" Width="600" />
        </Columns>
    </f:Grid>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}