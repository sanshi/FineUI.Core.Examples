@page
@model FineUI.Core.Examples.Pages.Grid.HeaderMenuSortModel
@{
    ViewBag.Title = "Grid/HeaderMenuSort";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableHeaderMenu="true"
        EnableHeaderMenuSort="false">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
        </Columns>
    </f:Grid>

    <br>
    <br>
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>
}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>保留表头菜单，但移除其中的升序与降序操作。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>查看精简后的表头菜单</h3>
        <ul>
            <li>打开<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>任一可用列标题的下拉菜单。<br />结果：列显示等菜单项仍可使用，菜单中没有升序或降序项；本页只限制菜单里的排序入口。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableHeaderMenu</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>true</code>，保留表头菜单。
            </li>
            <li><code>EnableHeaderMenuSort</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>false</code>，初始为 <code>false</code>，不生成菜单排序项。
            </li>
        </ul>
    </section>
}
