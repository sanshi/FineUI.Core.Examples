@page
@model FineUI.Core.Examples.Pages.Grid.RowCommandCRCModel
@{
    ViewBag.Title = "Grid/RowCommandCRC";
    var F = Html.F();
}


@section head {

    <style>
        .mybtn3 .f-icon.f-icon-remove {
            color: red;
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true" DataSource="@DataSourceUtil.GetDataTable()">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="" RendererFunction="renderAction1" />
            <f:RenderField HeaderText="" RendererFunction="renderAction2" />
            <f:RenderField HeaderText="" RendererFunction="renderAction3" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>
    <br />
    <br />
    注：本示例手工实现了行内按钮事件，实现复杂。推荐使用更加方便的Command标签：表格/行命令/行命令（客户端事件）。

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderAction1(value, params) {
            return '<a class="action-btn mybtn1" href="#">按钮</a>';
        }

        function renderAction2(value, params) {
            var deleteImageUrl = '@Url.Content("~/res/icon/delete.png")';
            return '<a class="action-btn mybtn2" href="#"><img class="f-grid-cell-icon" src="' + deleteImageUrl + '"></a>';
        }

        function renderAction3(value, params) {
            return '<a class="action-btn mybtn3" href="#"><i class="f-icon f-grid-cell-iconfont f-icon-remove"></i></a>';
        }

        function doAction(cnode) {
            var grid1 = F.ui.Grid1;
            var rowEl = cnode.closest('.f-grid-row');
            var rowData = grid1.getRowData(rowEl);
            var column = grid1.getColumn(cnode.parents('.f-grid-cell'));

            var message = '你点击了第 ' + (rowEl.index() + 1) + ' 行，第 ' + (column.index + 1) + ' 列，行ID：' + rowData.id + '，姓名：' + rowData.text;

            F.notify({
                message: message,
                target: '_top',
                header: false,
                positionX: 'center',
                positionY: 'top'
            });
        }

        F.ready(function () {

            var grid1 = F.ui.Grid1;
            grid1.el.on('click', 'a.action-btn', function (event) {
                event.preventDefault();
                var cnode = $(this);

                if (cnode.hasClass('mybtn2') || cnode.hasClass('mybtn3')) {
                    F.confirm({
                        message: '你确定要这么做吗？',
                        target: '_top',
                        ok: function () {
                            doAction(cnode);
                        }
                    });
                } else {
                    doAction(cnode);
                }
            });

        });


    </script>
}