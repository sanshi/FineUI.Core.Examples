@page
@model FineUI.Core.Examples.Pages.Grid.WidthModel
@{
    ViewBag.Title = "Grid/Width";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（各列宽度固定）(改变页面大小来观察每列宽度的变化)" DataIDField="Id" DataTextField="Name" IsViewPort="true" Margin="24">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" Width="200" />
            <f:RenderField HeaderText="个人简介" DataField="Desc" Width="600" />
        </Columns>
    </f:Grid>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>为各列设置固定宽度，容器较窄时通过横向滚动查看右侧内容。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>调整可用宽度核对列宽</h3>
    <ol>
        <li>缩窄再放宽<strong class="example-control-reference" data-example-control="Grid1" title="表格（各列宽度固定）(改变页面大小来观察每列宽度的变化)">表格（各列宽度固定）(改变页面大小来观察每列宽度的变化)</strong>所在区域，并向右滚动。<br />结果：固定列宽保持原配置，总列宽超过容器时出现横向滚动条，可滚到<strong>个人简介</strong>列。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Width</code>（<strong>本页固定宽度列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格（各列宽度固定）(改变页面大小来观察每列宽度的变化)">表格（各列宽度固定）(改变页面大小来观察每列宽度的变化)</strong>）：各列使用显式宽度，专业与简介等较宽列可能使内容区需要横向滚动。</li>
    </ul>
</section>
}
