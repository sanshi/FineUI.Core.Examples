@page
@model FineUI.Core.Examples.Pages.Grid.ExcelRowCommandDownloadCRCModel
@{
    ViewBag.SourceFiles = "~/Pages/Grid/ExcelRowCommandDownloadCRCExport.cshtml;~/Pages/Grid/ExcelRowCommandDownloadCRCExport.cshtml.cs";
    ViewBag.Title = "Grid/ExcelRowCommandDownloadCRC";
    var F = Html.F();
}



@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="" RendererFunction="renderDownLoadLink" />
        </Columns>
        <Listeners>
            <f:Listener Event="rowdblclick" Handler="onGrid1RowDblclick"></f:Listener>
        </Listeners>
    </f:Grid>
    <br>
    <br>



    <!-- 隐藏表单，用于自定义POST请求 -->
    <form id="myform" asp-page="/Grid/ExcelRowCommandDownloadCRCExport" method="post">
        <input type="hidden" id="content" name="content" />
    </form>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderDownLoadLink(value, params) {
            return '<a class="action-btn mybtn3" href="#"><i class="f-icon f-grid-cell-iconfont f-icon-download"></i></a>';
        }


        function doCustomPost(rowData) {
            // 自定义POST请求
            $('#content').val(F.toJSON(rowData));
            $('#myform')[0].submit();
        }

        function onGrid1RowDblclick(event, rowId) {
            doCustomPost(F.ui.Grid1.getRowData(rowId));
        }


        F.ready(function () {

            var grid1 = F.ui.Grid1;
            grid1.el.on('click', 'a.action-btn', function (event) {
                event.preventDefault();
                var cnode = $(this);

                var rowData = grid1.getRowData(cnode.closest('.f-grid-row'));

                doCustomPost(rowData);

            });

        });


    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>从行内下载入口取得这一行的资料，点击事件由页面脚本手工绑定。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>下载指定行资料</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>第一行的下载图标或下载链接。<br />结果：请求携带当前行标识，后台读取这条记录并返回文本附件；首行对应标识 101，下载内容应与该行<strong>姓名</strong>、<strong>性别</strong>等资料一致。</li>
        <li>对另一行执行相同操作。<br />结果：下载改用新行标识与资料；不把整行选择中的其他记录一起导出。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <p>注：双击行时，同样可以下载文件。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>自定义 POST 请求</code>（<strong>页面导出处理</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：行标识通过普通表单 POST 提交，后台以下载响应返回文件，避免 AJAX 把附件当成页面更新解析。</li>
        <li><code>RendererFunction / click</code>（<strong>页面导出处理</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：渲染函数输出下载入口，页面用事件委托取得所属行标识并提交；不是框架声明式行命令回调。</li>
    </ul>
</section>
}
