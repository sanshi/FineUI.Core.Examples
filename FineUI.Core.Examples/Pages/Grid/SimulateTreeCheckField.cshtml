@page
@model FineUI.Core.Examples.Pages.Grid.SimulateTreeCheckFieldModel
@{
    ViewBag.Title = "Grid/SimulateTreeCheckField";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true" EnableSimulateTree="true" RowDataBoundFunction="onGrid1RowDataBound">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="地区" DataField="Name" DataSimulateTreeLevelField="TreeLevel" ExpandUnusedSpace="true" MinWidth="150" />
            <f:GroupField HeaderTextAlign="Center" HeaderText="这是多表头">
                <Columns>
                    <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup"></f:RenderField>
                    <f:RenderCheckField HeaderText="复选框列" DataField="IsChecked" RenderAsStaticField="false"></f:RenderCheckField>
                </Columns>
            </f:GroupField>
        </Columns>
    </f:Grid>
    <br />
    <br />


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onGrid1RowDataBound(rowData) {
            var rowId = rowData.id;

            // 默认展开的节点
            if (rowId === '105' || rowId === '106' || rowId === '107') {
                rowData.values.IsChecked = true;
            }
        }


        var checkboxSelector = '.f-grid-cell-IsChecked .f-grid-checkbox';

        F.ready(function () {

            var grid = F.ui.Grid1;

            function getRowLevel(rowEl) {
                var rowData = grid.getRowData(rowEl);
                // 当前行的层级
                return $(rowData.values.Name).filter('.f-smtree-icon').length;
            }

            grid.el.on('click', checkboxSelector, function (event) {
                var rowEl = $(this).closest('.f-grid-row');
                var rowLevel = getRowLevel(rowEl);
                var rowChecked = grid.getRowData(rowEl).values['IsChecked'];

                var nextRowEl = rowEl;
                while ((nextRowEl = nextRowEl.next()).length) {
                    if (getRowLevel(nextRowEl) > rowLevel) {
                        // 包括折叠后隐藏的子行，保持原有父子级联范围。
                        // 用 ColumnID 到新值的对象更新单元格，单列和多列采用同一种写法。
                        // https://fineui.com/js/api/FineUI.Grid.html#updateCellValue
                        grid.updateCellValue(nextRowEl, { IsChecked: rowChecked }, true);
                    } else {
                        break;
                    }
                }
            });

        });


    </script>
}
@section exampleDescription {
<section aria-label="页面描述">
    <p>在模拟树形行中切换父行勾选，统一选择或取消其下级记录。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>让父行勾选覆盖下级</h3>
    <ol>
        <li>切换<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>一个父行的正文复选框。<br />结果：该父行下属连续层级记录一起勾选或取消，范围到下一个同级或更高层级截止；其他分支保留自己的勾选。</li>
        <li>折叠此分支后再切换父行并重新展开。<br />结果：隐藏在折叠区域的下级也采用本次状态；正文布尔值与表格整行选择分别处理。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <ul>
        <li>初始选中 安徽省 合肥市 黄山市 的<strong>复选框列</strong>；</li>
        <li>选中（或取消）父级的复选框，会同时选中（或取消）所有的子级复选框。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>updateCellValue</code>（<strong>正文复选框与父子级联处理</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：按层级确定当前父行的后代范围，再更新实际复选框值；不只改变可见图标。</li>
        <li><code>DataSimulateTreeLevelField</code>（<strong>地区列</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：<strong>地区</strong>列从层级字段读取深度，数据必须按父行在前、后代连续的顺序提供，不能仅靠缩进推断未提供的数据。</li>
    </ul>
</section>
}
