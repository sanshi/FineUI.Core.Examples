@page
@model FineUI.Core.Examples.Pages.Grid.HeaderCustomMenuModel
@{
    ViewBag.Title = "Grid/HeaderCustomMenu";
    var F = Html.F();
}

@section head {
    <style>
        .f-grid-allcolumns-hidden-message {
            display: none !important;
        }
    </style>
}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataSource="@DataSourceUtil.GetDataTable()" EnableHeaderMenu="false"
            _DataKeyNames="Id,Name,Gender,Major">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
        </Columns>
        <Tools>
            <f:Tool ID="toolColumns" IconFont="_ColumnsAlt" Text="管理列" ToolTip="显示隐藏列" TabIndex="0" ClickHandler="onToolColumnsClick"></f:Tool>
        </Tools>
    </f:Grid>

    <br>
    <br>
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <br>
    <br>
    <f:Button Text="选中了哪些行（服务器端）" CssClass="marginr" ID="Button1" OnClick="Button1_Click"></f:Button>
}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onToolColumnsClick(event) {
            var toolEl = this.el; // 当前工具图标元素

            F.ui.Grid1.showColumnsMenu(toolEl);
