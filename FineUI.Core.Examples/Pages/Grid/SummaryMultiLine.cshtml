@page
@model FineUI.Core.Examples.Pages.Grid.SummaryMultiLineModel
@{
    ViewBag.Title = "Grid/SummaryMultiLine";
    var F = Html.F();
}


@section head {

    <style>
        .f-grid-row-summary .f-grid-cell-Major .f-grid-cell-text {
            text-align: right;
        }

        .f-grid-row-summary .f-grid-cell-text {
            font-weight: bold;
        }

        .f-grid-row-summary:first-child .f-grid-cell-text {
            font-weight: normal;
            font-style: italic;
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" Height="500" AllowPaging="true"
        PageSize="15" IsDatabasePaging="true" OnPageIndexChanged="Grid1_PageIndexChanged" EnableSummary="true" SummaryPosition="Bottom" SummaryRowCount="2">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" ColumnID="Major" RendererFunction="renderMajor" MinWidth="150" ExpandUnusedSpace="true" />
            <f:RenderField HeaderText="学费" DataField="Fee" />
            <f:RenderField HeaderText="学杂费" DataField="ExtraFee" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>用两行合计同时对照当前页费用与全部记录费用。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>对照多行统计范围</h3>
        <ul>
            <li>查看<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>底部各行合计，再切换下一页。<br />结果：当前页合计随页记录变化，全部合计保留完整示例记录的总数值，两种统计不混为一行。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>SummaryRowCount</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>2</code>，指定显示的合计行数量，并与各行的统计数据或统计配置对应。
            </li>
            <li><code>SummaryDataArray</code>（<strong>合计数据及费用列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：依次提供当前页与完整数据集的费用合计。</li>
        </ul>
    </section>
}
