@page
@model FineUI.Core.Examples.Pages.Grid.CheckFieldPostBackModel
@{
    ViewBag.Title = "Grid/CheckFieldPostBack";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool2" DataField="AtSchool" RenderAsStaticField="false" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中了哪些行" MarginRight="5" ClickHandler="onNotifySelectedRowsClick"></f:Button>


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        var checkboxSelector = '.f-grid-cell-AtSchool2 .f-grid-checkbox';

        F.ready(function () {

            var grid1 = F.ui.Grid1;

            grid1.el.on('click', checkboxSelector, function (event) {
                var cnode = $(this);
                var rowData = grid1.getRowData(cnode.closest('.f-grid-row'));
                var isChecked = rowData.values['AtSchool2'];

                // 触发后台事件（演示 F.doPostBack 的完整形式：eventName 即事件名，
                // eventArgument 给对象即可，框架自动序列化为 JSON 并编码）
                F.doPostBack({
                    eventName: 'Grid1_CheckFieldChanged',
                    eventArgument: {
                        rowId: rowData.id,
                        rowText: rowData.text,
                        isChecked: isChecked
                    }
                });

            });

        });

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在可编辑复选框改变后主动回发，把当前行及新的勾选状态交给后台处理。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>切换复选框并读取新状态</h3>
        <ul>
            <li>先选中<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>的一行，再点击该行可编辑的是否在校复选框。<br />结果：复选框先在浏览器切换，本页脚本再提交行标识及新状态；后台提示对应行的信息和当前勾选状态。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>F.doPostBack</code>（<strong>页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：本页在复选框改变后主动提交当前行的数据；后台按本轮参数处理，不依靠首次绑定值。</li>
        </ul>
    </section>
}
