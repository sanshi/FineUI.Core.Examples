@page
@model FineUI.Core.Examples.Pages.Grid.WidthBoxFlexModel
@{
    ViewBag.Title = "Grid/WidthBoxFlex";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（[所学专业]占据空余空间1/3；[个人简介]占据空余空间2/3；）(改变页面大小来观察每列宽度的变化)" DataIDField="Id"
        DataTextField="Name" IsViewPort="true" Margin="24">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" BoxFlex="1" />
            <f:RenderField HeaderText="个人简介" DataField="Desc" BoxFlex="2" />
        </Columns>
    </f:Grid>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>把剩余宽度按比例分给两列，而不是平均分配给所有列。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>调整可用宽度核对列宽</h3>
        <ol>
            <li>缩窄再放宽<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（[所学专业]占据空余空间1/3；[个人简介]占据空余空间2/3；）(改变页面大小来观察每列宽度的变化)">表格（[所学专业]占据空余空间1/3；[个人简介]占据空余空间2/3；）(改变页面大小来观察每列宽度的变化)</strong>所在区域。<br />结果：专业与<strong>个人简介</strong>按
                1:2 分配剩余空间，其他固定列先保留自己的宽度。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>BoxFlex</code>（<strong>专业与个人简介列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（[所学专业]占据空余空间1/3；[个人简介]占据空余空间2/3；）(改变页面大小来观察每列宽度的变化)">表格（[所学专业]占据空余空间1/3；[个人简介]占据空余空间2/3；）(改变页面大小来观察每列宽度的变化)</strong>）：专业初始为
                <code>1</code>，<strong>个人简介</strong>初始为 <code>2</code>，分配扣除固定列后的剩余宽度。
            </li>
        </ul>
    </section>
}
