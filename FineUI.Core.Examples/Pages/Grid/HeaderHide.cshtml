@page
@model FineUI.Core.Examples.Pages.Grid.HeaderHideModel
@{
    ViewBag.Title = "Grid/HeaderHide";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataSource="@DataSourceUtil.GetDataTable()" ShowGridHeader="false" EnableRowLines="false" EnableAlternateRowColor="false" Height="200">
        <Columns>
            <f:RenderField HeaderText="姓名" DataField="Name" ExpandUnusedSpace="true" MinWidth="150" />
        </Columns>
    </f:Grid>
    <br>
    <br>
    注：本表格隐藏了表头、行分隔线、间隔行背景色。

    <br>
    <br>
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}