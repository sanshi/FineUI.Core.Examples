@page
@model FineUI.Core.Examples.Pages.Grid.ExcelModel
@{
    ViewBag.SourceFiles = "~/Pages/Grid/ExcelExport.cshtml;~/Pages/Grid/ExcelExport.cshtml.cs;~/Code/UrlUtil.cs";
    ViewBag.Title = "Grid/Excel";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button ID="btnExportExcel" Text="导出为Excel文件" ClickHandler="onButton1Click"></f:Button>

    <!-- 隐藏表单，用于自定义POST请求 -->
    <form id="myform" asp-page="/Grid/ExcelExport" method="post"></form>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onButton1Click(event) {
            //window.location.href = '@Url.Content("~/Grid/ExportToExcel")';

            // 自定义POST请求
            $('#myform')[0].submit();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>把表格列头与学生数据导出为供 Excel 打开的文件。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>下载完整表格</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="btnExportExcel"
                    title="导出为Excel文件">导出为Excel文件</strong>。<br />结果：后台读取表格列和数据，以附件返回 myexcel.xls；导出内容包含列标题及相应学生记录。本页生成的是 HTML 表格文件，不是原生 XLSX 工作簿。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Content-Type / Content-Disposition</code>（<strong>页面导出处理</strong>，作用于<strong class="example-control-reference"
                    data-example-control="Grid1" title="表格">表格</strong>）：设置 Excel 响应类型与附件文件名，让浏览器按下载处理，不在示例 iframe 中显示文件内容。</li>
        </ul>
    </section>
}
