@page
@model FineUI.Core.Examples.Pages.Grid.RowNumberAlignModel
@{
    ViewBag.Title = "Grid/RowNumberAlign";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（数据库分页，切换分页时序号连续）" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
            AllowPaging="true" PageSize="10" IsDatabasePaging="true" OnPageIndexChanged="Grid1_PageIndexChanged">
        <Columns>
            <f:RowNumberField EnablePagingNumber="true" Width="60" TextAlign="Right" />
            <f:RenderField HeaderText="ID" DataField="Id" Width="150" />
            <f:RenderField HeaderText="时间" DataField="EntranceTime" ExpandUnusedSpace="true" MinWidth="150" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd HH:mm:ss" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>把序号列的文字明确设为靠右对齐。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>查看序号列的独立设置</h3>
    <ul>
        <li>查看<strong class="example-control-reference" data-example-control="Grid1" title="表格（数据库分页，切换分页时序号连续）">表格（数据库分页，切换分页时序号连续）</strong>最左侧的序号列。<br />结果：序号文字靠右侧排列，数据列仍采用各自的对齐配置。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>TextAlign</code>（<strong>序号列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格（数据库分页，切换分页时序号连续）">表格（数据库分页，切换分页时序号连续）</strong>）：初始为 <code>Right</code>，只决定序号文字对齐方向。</li>
    </ul>
</section>
}
