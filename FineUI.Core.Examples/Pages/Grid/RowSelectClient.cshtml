@page
@model FineUI.Core.Examples.Pages.Grid.RowSelectClientModel
@{
    ViewBag.Title = "Grid/RowSelectClient";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
        <Listeners>
            <f:Listener Event="rowselect" Handler="onGrid1RowSelect"></f:Listener>
            <f:Listener Event="rowdeselect" Handler="onGrid1RowDeselect"></f:Listener>
            <f:Listener Event="selectionchange" Handler="onGrid1SelectionChange"></f:Listener>
        </Listeners>
    </f:Grid>
    <br />
    事件列表（<a id="clearResult" href="#">clear</a>）：
    <ul id="result"></ul>
    <br />


    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onClearResultClick(event) {
            event.preventDefault();
            $('#result').empty();
        }

        function onGrid1RowSelect(event, rowId) {
            var date = new Date();
            $('#result').append(F.formatString('<li>[{0}:{1}] rowselect：{2}</li>',
                date.getMinutes(),
                date.getSeconds(),
                rowId));
        }

        function onGrid1RowDeselect(event, rowId) {
            var date = new Date();
            $('#result').append(F.formatString('<li>[{0}:{1}] rowdeselect：{2}</li>',
                date.getMinutes(),
                date.getSeconds(),
                rowId));
        }

        function onGrid1SelectionChange(event) {
            var date = new Date();
            $('#result').append(F.formatString('<li>[{0}:{1}] selectionchange</li>',
                date.getMinutes(),
                date.getSeconds()));
        }

        F.ready(function () {
            $('#clearResult').on('click', onClearResultClick);
        });

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在行选中和取消选中时直接在浏览器显示对应记录的信息。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>对照选择事件</h3>
        <ol>
            <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>选中一行，再选择另一行。<br />结果：<strong
                    class="example-control-reference" data-example-control="result" title="事件日志">事件日志</strong>依次记录已登记的选择事件及行标识，可对照逐行事件和集合改变的顺序。</li>
            <li>取消已选记录或切换到另一条记录。<br />结果：触发取消选中处理，对应行信息出现在提示或日志中；没有改变选择时不凭普通单元格点击重复生成取消事件。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <ul>
            <li>通过键盘SHIFT，表头复选框多选时，会触发多次 rowselect 事件。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>rowselect / rowdeselect / selectionchange</code>（<strong>页面脚本</strong>，作用于<strong class="example-control-reference"
                    data-example-control="Grid1" title="表格">表格</strong>）：按本页登记的客户端选择事件记录变化；逐行事件只在相应记录的状态改变时执行。</li>
        </ul>
    </section>
}
