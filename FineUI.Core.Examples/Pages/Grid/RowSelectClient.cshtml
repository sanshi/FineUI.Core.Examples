@page
@model FineUI.Core.Examples.Pages.Grid.RowSelectClientModel
@{
    ViewBag.Title = "Grid/RowSelectClient";
    var F = Html.F();
}


@section body {
    
    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true" DataSource="@DataSourceUtil.GetDataTable()">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" />
        </Columns>
        <Listeners>
            <f:Listener Event="rowselect" Handler="onGrid1RowSelect"></f:Listener>
            <f:Listener Event="rowdeselect" Handler="onGrid1RowDeselect"></f:Listener>
            <f:Listener Event="selectionchange" Handler="onGrid1SelectionChange"></f:Listener>
        </Listeners>
    </f:Grid>
    <br />
    事件列表（<a id="clearResult" href="javascript:;">clear</a>）：
    <ul id="result"></ul>
    <br />
    注：
    <ul>
        <li>通过键盘SHIFT，表头复选框多选时，会触发多次 rowselect 事件。</li>
    </ul>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onClearResultClick(event) {
            event.preventDefault();
            $('#result').empty();
        }

        function onGrid1RowSelect(event, rowId) {
            var date = new Date();
            $('#result').append(F.formatString('<li>[{0}:{1}] rowselect：{2}</li>',
                date.getMinutes(),
                date.getSeconds(),
                rowId));
        }

        function onGrid1RowDeselect(event, rowId) {
            var date = new Date();
            $('#result').append(F.formatString('<li>[{0}:{1}] rowdeselect：{2}</li>',
                date.getMinutes(),
                date.getSeconds(),
                rowId));
        }

        function onGrid1SelectionChange(event) {
            var date = new Date();
            $('#result').append(F.formatString('<li>[{0}:{1}] selectionchange</li>',
                date.getMinutes(),
                date.getSeconds()));
        }

        F.ready(function () {
            $('#clearResult').on('click', onClearResultClick);
        });

    </script>
}
