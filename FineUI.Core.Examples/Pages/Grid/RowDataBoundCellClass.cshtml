@page
@model FineUI.Core.Examples.Pages.Grid.RowDataBoundCellClassModel
@{
    ViewBag.Title = "Grid/RowDataBoundCellClass";
    var F = Html.F();
}


@section head {

    <style>
        .colorred {
            font-weight: bold;
            color: red;
        }

        .colorgreen {
            font-weight: bold;
            color: green;
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
        RowDataBoundFunction="onGrid1RowDataBound">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onGrid1RowDataBound(rowData) {
            var rowValues = rowData.values;
            var entranceYear = rowValues['EntranceYear'];
            if (entranceYear >= 2004) {
                rowValues['EntranceYear.cls'] = 'colorgreen';
            } else {
                rowValues['EntranceYear.cls'] = 'colorred';
            }
        }

    </script>
}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>在客户端行绑定函数中按入学年份设置单个单元格的样式。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>对照本页样式规则</h3>
        <ul>
            <li>比较<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong><strong>入学年份</strong>小于 2004 与不小于 2004
                的记录。<br />结果：年份单元格使用不同样式，同行其他列不一起套用该单元格样式。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>rowData.values['EntranceYear.cls']</code>（<strong>本页列与样式</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：行绑定函数写入字段对应的样式键；不小于 2004 使用 <code>colorgreen</code>，其余使用 <code>colorred</code>。</li>
        </ul>
    </section>
}
