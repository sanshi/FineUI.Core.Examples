@page
@model FineUI.Core.Examples.Pages.Grid.RowDataBoundCellClassModel
@{
    ViewBag.Title = "Grid/RowDataBoundCellClass";
    var F = Html.F();
}


@section head {

    <style>
        .colorred {
            font-weight: bold;
            color: red;
        }

        .colorgreen {
            font-weight: bold;
            color: green;
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true" DataSource="@DataSourceUtil.GetDataTable()" RowDataBoundFunction="onGrid1RowDataBound">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onGrid1RowDataBound(rowData) {
            var rowValues = rowData.values;
            var entranceYear = rowValues['EntranceYear'];
            if (entranceYear >= 2004) {
                rowValues['EntranceYear.cls'] = 'colorgreen';
            } else {
                rowValues['EntranceYear.cls'] = 'colorred';
            }
        }

    </script>
}