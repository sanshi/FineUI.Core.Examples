@page
@model FineUI.Core.Examples.Pages.Grid.HeaderWrapLineClampModel
@{
    ViewBag.Title = "Grid/HeaderWrapLineClamp";
    var F = Html.F();
}


@section head {

    <style>
        /* 最多显示 3 行文字，超出则显示省略号 */
        .f-grid-colheader-Major .f-grid-colheader-text {
            white-space: normal;
            word-break: break-all;
            overflow: hidden;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            display: -webkit-box;
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业（这是很长很长很长很长很长很长很长很长很长的标题文本，可以自动换行）" DataField="Major" RendererFunction="renderMajor" Width="150" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>让过长的列标题自动换行，并把可见文字限制为三行。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>查看长标题的换行方式</h3>
        <ol>
            <li>缩窄<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>的专业列或所在区域。<br />结果：专业列长标题最多显示三行，超出部分省略，不让表头无限增高。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>CSS</code>（<strong>专业列标题文字</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：标题文字启用换行并使用 <code>-webkit-line-clamp: 3</code>。</li>
        </ul>
    </section>
}
