@page
@model FineUI.Core.Examples.Pages.Grid.SummaryCurrentPageRendererModel
@{
    ViewBag.Title = "Grid/SummaryCurrentPageRenderer";
    var F = Html.F();
}


@section head {

    <style>
        .f-grid-row-summary .f-grid-cell.color1 .f-grid-cell-text {
            font-weight: bold;
            color: red;
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" Height="350"
            AllowPaging="true" PageSize="5" IsDatabasePaging="true" OnPageIndexChanged="Grid1_PageIndexChanged"
            EnableSummary="true" SummaryPosition="Flow">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="学费" DataField="Fee" />
            <f:RenderField HeaderText="学杂费" DataField="ExtraFee" SummaryRendererFunction="extraFeeSummaryRenderer" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function extraFeeSummaryRenderer(summaryRowIndex, cellValue, params) {

            if (parseInt(cellValue, 10) >= 1500) {
                params.cellCls = 'color1';
            }

            return cellValue;
        }

    </script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>为当前页合计单元格设置专用样式，区分统计结果与普通行的显示。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>样式跟随当前页合计</h3>
    <ul>
        <li>对照<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>当前页费用单元格与合计行，再切换下一页。<br />结果：合计行采用本页渲染样式，统计按当前页记录重新计算；普通正文不因合计样式改变含义。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>SummaryRendererFunction</code>（<strong>费用列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：仅为合计单元格生成专用显示或样式，不代替后台提供当前页统计。</li>
    </ul>
</section>
}
