@page
@model FineUI.Core.Examples.Pages.Grid.RowSelectCustomEventModel
@{
    ViewBag.Title = "Grid/RowSelectCustomEvent";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（单选）" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
        EnableMultiSelect="false">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
        <Listeners>
            <f:Listener Event="rowselect" Handler="onGrid1RowSelect"></f:Listener>
            <f:Listener Event="rowdeselect" Handler="onGrid1RowDeselect"></f:Listener>
        </Listeners>
    </f:Grid>
    <br />




    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function postSelectionChange(rowId, isDeselect) {

            var grid1 = F.ui.Grid1;
            var rowData = grid1.getRowData(rowId);
            var rowEl = grid1.getRowEl(rowId);
            var column = grid1.getColumn(grid1.getSelectedCell()[1]);

            // 触发后台事件
            F.customEvent('Grid1_RowSelect', {
                rowId: rowData.id,
                rowText: rowData.text,
                rowIndex: rowEl.index(),
                columnText: column.text,
                isDeselect: !!isDeselect
            });
        }

        function onGrid1RowSelect(event, rowId) {
            postSelectionChange(rowId);
        }


        function onGrid1RowDeselect(event, rowId) {
            postSelectionChange(rowId, true);
        }

    </script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>在行选中和取消选中时通过自定义回发显示对应记录的信息。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>对照选择事件</h3>
        <ol>
            <li>在<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（单选）">表格（单选）</strong>选中一行，再选择另一行。<br />结果：选择动作回发，后台读取对应行的信息后提示所选记录；单选切换时原行取消、新行选中分别处理。</li>
            <li>取消已选记录或切换到另一条记录。<br />结果：触发取消选中处理，对应行信息出现在提示或日志中；没有改变选择时不凭普通单元格点击重复生成取消事件。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <ul>
            <li>观察行选中事件与行单击事件的区别；</li>
            <li>点击复选框取消选中行时，也会触发相应事件。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>F.customEvent</code>（<strong>页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（单选）">表格（单选）</strong>）：客户端把本次选择或取消及行数据发送到同一自定义处理器。</li>
        </ul>
    </section>
}
