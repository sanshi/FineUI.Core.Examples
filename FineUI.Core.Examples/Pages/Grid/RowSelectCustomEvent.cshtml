@page
@model FineUI.Core.Examples.Pages.Grid.RowSelectCustomEventModel
@{
    ViewBag.Title = "Grid/RowSelectCustomEvent";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（单选）" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true" EnableMultiSelect="false" DataSource="@DataSourceUtil.GetDataTable()">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" />
        </Columns>
        <Listeners>
            <f:Listener Event="rowselect" Handler="onGrid1RowSelect"></f:Listener>
            <f:Listener Event="rowdeselect" Handler="onGrid1RowDeselect"></f:Listener>
        </Listeners>
    </f:Grid>
    <br />


    注：
    <ul>
        <li>观察行选中事件与行单击事件的区别；</li>
        <li>点击复选框取消选中行时，也会触发相应事件。</li>
    </ul>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function postSelectionChange(rowId, isDeselect) {

            var grid1 = F.ui.Grid1;
            var rowData = grid1.getRowData(rowId);
            var rowEl = grid1.getRowEl(rowId);
            var column = grid1.getColumn(grid1.getSelectedCell()[1]);

            // 触发后台事件
            F.customEvent('Grid1_RowSelect', {
                rowId: rowData.id,
                rowText: rowData.text,
                rowIndex: rowEl.index(),
                columnText: column.text,
                isDeselect: !!isDeselect
            });
        }

        function onGrid1RowSelect(event, rowId) {
            postSelectionChange(rowId);
        }


        function onGrid1RowDeselect(event, rowId) {
            postSelectionChange(rowId, true);
        }

    </script>

}