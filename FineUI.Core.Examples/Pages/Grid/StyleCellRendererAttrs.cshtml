@page
@model FineUI.Core.Examples.Pages.Grid.StyleCellRendererAttrsModel
@{
    ViewBag.Title = "Grid/StyleCellRendererAttrs";
    var F = Html.F();
}


@section head {

    <style>

        .f-grid-cell[data-color=color1] {
            color: red;
            font-weight: bold;
        }

        .f-grid-cell[data-color=color3] {
            color: green;
            font-weight: bold;
        }

    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" RendererFunction="renderEntranceYear" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中了哪些行" CssClass="marginr" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <f:Button ID="btnRebindGrid" Text="重新绑定表格" OnClick="Button1_Click"></f:Button>


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        // 文本 - 入学年份
        function renderEntranceYear(value, params) {
            if (value >= 2000 && value <= 2004) {
                params.cellAttrs['data-color'] = 'color3';
            }

            return value;
        }

        // 文本 - 性别
        function renderGender(value, params) {
            if (value == 1) {
                params.cellAttrs['data-color'] = 'color1';
            }

            return value == 1 ? '男' : '女';
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在浏览器渲染函数中按数据设置单元格属性，并由 CSS 决定外观。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>对照本页样式规则</h3>
        <ul>
            <li>比较<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>中不同<strong>入学年份</strong>的记录，同时查看<strong>性别</strong>单元格。<br />结果：2000 至 2004
                的<strong>入学年份</strong>单元格应用一组样式，男性对应的<strong>性别</strong>单元格应用另一组样式；规则只作用于命中的单元格。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>换一组记录后重新应用规则</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="btnRebindGrid"
                    title="重新绑定表格">重新绑定表格</strong>。<br />结果：按钮回发后后台换入另一组记录；列配置或按数据判断的样式规则继续应用，不是仅给最初几行写死颜色。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>params.cellAttrs</code>（<strong>本页列与样式</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：浏览器在当前渲染阶段检查本行数据，再设置属性；不需要为颜色变化单独回发。</li>
        </ul>
    </section>
}
