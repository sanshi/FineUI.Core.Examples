@page
@model FineUI.Core.Examples.Pages.Grid.CheckAllRowSelectableDisabledServerModel
@{
    ViewBag.Title = "Grid/CheckAllRowSelectableDisabledServer";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" EnableCheckBoxSelect="true" DataIDField="Id" DataTextField="Name"
        DisableUnselectableRows="true" OnRowDataBound="Grid1_RowDataBound">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br>

    <f:Button Text="选中了哪些行（客户端）" CssClass="marginr" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <br />
    <br />


}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在后台按行决定是否允许选择，并把不可选行显示为禁用外观。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>限制指定记录的选择</h3>
        <ol>
            <li>点击<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>中入学年份大于等于 2008
                的行复选框，再选择一条允许选择的记录。<br />结果：受限制的记录不会因点击新增选择，允许选择的记录正常勾选；不可选行同时呈现灰色禁用外观。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>RowSelectable</code>（<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：后台按当前行数据给出可选结果；只有命中限制的记录被禁止选择。</li>
            <li><code>DisableUnselectableRows</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>true</code>，给不可选记录增加禁用外观，选择限制由逐行可选状态决定。
            </li>
        </ul>
    </section>
}
