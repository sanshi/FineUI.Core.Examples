@page
@model FineUI.Core.Examples.Pages.Grid.IFrameCRCModel
@{
    ViewBag.SourceFiles = "~/Grid/IFrameWindow";
    ViewBag.Title = "Grid/IFrameCRC";
    var F = Html.F();
}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="窗口列" RendererFunction="renderWindowField1"></f:RenderField>
            @* <f:RenderField HeaderText="窗口列" RendererFunction="renderWindowField2"></f:RenderField>
            <f:RenderField HeaderText="窗口列" RendererFunction="renderWindowField3"></f:RenderField> *@
        </Columns>
        <Listeners>
            <f:Listener Event="rowdblclick" Handler="onGridRowDblClick"></f:Listener>
        </Listeners>
    </f:Grid>

    <br>
    <br>


    <f:Window ID="Window1" Title="编辑" Hidden="true" EnableIFrame="true" CloseAction="HidePostBack" EnableMaximize="true" EnableResize="true"
              OnClose="Window1_Close" Target="Top" IsModal="true" Width="850" Height="500">
    </f:Window>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

    function renderWindowField1(value, params) {
        return '<a href="#" class="mywindowfield">编辑</a>';
    }

    // function renderWindowField2(value, params) {
    //     return '<a href="#" class="mywindowfield"><i class="f-icon f-icon-edit f-grid-cell-iconfont"></i></a>';
    // }

    // function renderWindowField3(value, params) {
    //     return '<a href="#" class="mywindowfield"><img class="f-grid-cell-icon" src="@Url.Content("~/res/icon/pencil.png")"></a>';
    // }

    // 打开窗体
    function openWindow(rowData) {

        // /Grid/IFrameWindow?id=104&name=刘国
        var iframeWindowUrl = '@Url.Content("~/Grid/IFrameWindow")';
        var iframeUrl = iframeWindowUrl + '?id=' + rowData.id + '&name=' + encodeURIComponent(rowData.text);

        // 显示窗体
        F.ui.Window1.show(iframeUrl, '详细信息 - ' + rowData.text);
    }

    // 双击行
    function onGridRowDblClick(event, rowId) {
        openWindow(F.ui.Grid1.getRowData(rowId));
    }



    F.ready(function () {

        var grid = F.ui.Grid1;

        // 点击表格行中的编辑按钮
        grid.el.on('click', 'a.mywindowfield', function (event) {
            event.preventDefault();
            var rowEl = $(this).closest('.f-grid-row');
            var rowData = grid.getRowData(rowEl);

            openWindow(rowData);
        });

    });


    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>手工渲染行内编辑入口，从点击元素找到当前行并打开对应的编辑窗体。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>按当前行打开详情</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>第一行的<strong>编辑图标</strong>，关闭后再打开另一行。<br />结果：浏览器取得本次行主键和姓名，编码到网址并更新窗口标题，窗口内容随当前行改变。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <p>注：本示例需要自行定义列渲染函数并注册行内按钮事件，实现复杂。推荐方案：表格/行命令/弹出窗体列。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>RendererFunction</code>（<strong>页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：生成编辑入口并在容器中委托处理点击，事件时再找到当前行。</li>
        <li><code>EnableIFrame</code>（<strong class="example-control-reference" data-example-control="Window1" title="编辑">编辑</strong>）：初始为 <code>true</code>，在窗口内加载当前记录对应的独立页面。</li>
    </ul>
</section>
}
