@page
@model FineUI.Core.Examples.Pages.Grid.SortingCancelModel
@{
    ViewBag.Title = "Grid/SortingCancel";
    var F = Html.F();
}


@section body {

<f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" EnableCheckBoxSelect="true" DataIDField="Id" DataTextField="Name"
        AllowSorting="true" SortField="Gender" SortDirection="ASC" OnSort="Grid1_Sort" SortingToolTip="true" SortingCancel="true">
    <Columns>
        <f:RowNumberField />
        <f:RenderField HeaderText="姓名" DataField="Name" SortField="Name" />
        <f:RenderField HeaderText="性别" DataField="Gender" SortField="Gender" FieldType="Int" RendererFunction="renderGender" />
        <f:RenderField HeaderText="入学年份" DataField="EntranceYear" SortField="EntranceYear" FieldType="Int" />
        <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" SortField="AtSchool" RenderAsStaticField="true" />
        <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
        <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
        <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
    </Columns>
</f:Grid>
<br />
<f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

<script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>在排序与取消排序之间切换，取消后恢复本页未排序的数据顺序。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>排序并取消排序</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>的<strong>入学年份</strong>列标题，再次点击同一列。<br />结果：列头操作回发后，后台读取排序字段与方向，重新绑定排序结果；先后采用升序与降序，列标题方向随之变化。</li>
        <li>从已排序列的表头菜单选择<strong>取消排序</strong>。<br />结果：该列排序标记清除，记录恢复本页未排序时的顺序。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>SortingCancel</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>true</code>，允许移除排序条件；后台对空条件返回未排序的数据。</li>
    </ul>
</section>
}
