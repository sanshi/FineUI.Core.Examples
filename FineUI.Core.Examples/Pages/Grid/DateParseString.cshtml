@page
@model FineUI.Core.Examples.Pages.Grid.DateParseStringModel
@{
    ViewBag.Title = "Grid/DateParseString";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="入学日期（DateParseString）" DataField="EntranceDate" FieldType="Date" DateParseString="MM/dd/yyyy" Renderer="Date"
                RendererArgument="yyyy-MM-dd" Width="200" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>把指定格式的日期字符串解析成日期，再按另一种格式显示。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>对照日期的输入与显示格式</h3>
        <ul>
            <li>查看<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>中的入学日期。<br />结果：源数据使用月/日/年字符串，首行最终显示为
                2000-09-01；解析格式与显示格式分别设置，不把原字符串直接当成已格式化日期。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DateParseString</code>（<strong>日期列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：初始为 <code>MM/dd/yyyy</code>，说明源字符串的月份、日期与年份顺序。</li>
            <li><code>RendererArgument</code>（<strong>日期列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：初始为 <code>yyyy-MM-dd</code>，决定解析成功后的显示形式。</li>
        </ul>
    </section>
}
