@page
@model FineUI.Core.Examples.Pages.Grid.SortingToolTipModel
@{
    ViewBag.Title = "Grid/SortingToolTip";
    var F = Html.F();
}


@section body {

<f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" EnableCheckBoxSelect="true" DataIDField="Id" DataTextField="Name"
        AllowSorting="true" SortField="Gender" SortDirection="ASC" OnSort="Grid1_Sort" SortingToolTip="true">
    <Columns>
        <f:RowNumberField />
        <f:RenderField HeaderText="姓名" DataField="Name" SortField="Name" />
        <f:RenderField HeaderText="性别" DataField="Gender" SortField="Gender" FieldType="Int" RendererFunction="renderGender" />
        <f:RenderField HeaderText="入学年份" DataField="EntranceYear" SortField="EntranceYear" FieldType="Int" />
        <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" SortField="AtSchool" RenderAsStaticField="true" />
        <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
        <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
        <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
    </Columns>
</f:Grid>
<br />
<f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

<script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>在可排序列标题上显示随当前状态改变的排序提示。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>查看下一次排序提示</h3>
    <ul>
        <li>将鼠标移到<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>的可排序列标题，点击该列后再次悬停。<br />结果：提示随当前排序状态改变，说明再次点击将采用的排序方向；列标题标记与记录顺序一致。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>SortingToolTip</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>true</code>，在可排序列标题上显示与当前状态对应的操作提示。</li>
    </ul>
</section>
}
