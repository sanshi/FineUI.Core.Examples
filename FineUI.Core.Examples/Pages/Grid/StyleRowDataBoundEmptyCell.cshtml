@page
@model FineUI.Core.Examples.Pages.Grid.StyleRowDataBoundEmptyCellModel
@{
    ViewBag.Title = "Grid/StyleRowDataBoundEmptyCell";
    var F = Html.F();
}


@section head {

    <style>

        .f-grid-row.color1 .f-grid-cell-Name,
        .f-grid-row.color1 .f-grid-cell-Gender,
        .f-grid-row.color1 .f-grid-cell-EntranceYear {
            color: red;
            font-weight: bold;
        }

        .f-grid-row.color3 .f-grid-cell-Name,
        .f-grid-row.color3 .f-grid-cell-Gender,
        .f-grid-row.color3 .f-grid-cell-EntranceYear {
            color: green;
            font-weight: bold;
        }

    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" RowDataBoundFunction="grid1RowDataBound">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中了哪些行" CssClass="marginr" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <f:Button ID="btnRebindGrid" Text="重新绑定表格" OnClick="Button1_Click"></f:Button>

    <br />
    <br />

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        // 在客户端的行绑定事件中改变单元格的值
        function grid1RowDataBound(rowData) {
            var entranceYear = rowData.values['EntranceYear'];

            if (entranceYear == 2008) {
                rowData.values['AtSchool'] = '';
                rowData.values['Group'] = '';
            }
        }

    </script>
}
@section exampleDescription {
<section aria-label="页面描述">
    <p>在客户端行绑定时把符合条件的单元格改为空白，保留同一行的其他资料。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>对照本页样式规则</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>查找<strong>入学年份</strong>为 2008 的记录。<br />结果：这些行的<strong>是否在校</strong>与<strong>分组</strong>单元格为空，其余行继续正常显示；修改发生在浏览器显示数据中，没有因此写入业务数据库。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>换一组记录后重新应用规则</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="btnRebindGrid" title="重新绑定表格">重新绑定表格</strong>。<br />结果：按钮回发后后台换入另一组记录；列配置或按数据判断的样式规则继续应用，不是仅给最初几行写死颜色。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <p>注：当[入学年份]为2008年时，清空[是否在校]和[分组]两列的单元格。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>RowDataBoundFunction</code>（<strong>本页列与样式</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：行绑定函数检查<strong>入学年份</strong>，把对应记录的 <code>AtSchool</code> 与 <code>Group</code> 显示值改为空字符串。</li>
    </ul>
</section>
}
