@page
@model FineUI.Core.Examples.Pages.Grid.RowCommandPostBackCRCModel
@{
    ViewBag.Title = "Grid/RowCommandPostBackCRC";
    var F = Html.F();
}


@section head {

    <style>
        .mybtn3 .f-icon.f-icon-remove {
            color: red;
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="" RendererFunction="renderAction3" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>
    <br />
    <br />



}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderAction3(value, params) {
            return '<a class="action-btn mybtn3" href="#"><i class="f-icon f-grid-cell-iconfont f-icon-remove"></i></a>';
        }


        F.ready(function () {

            var grid1 = F.ui.Grid1;
            grid1.el.on('click', 'a.action-btn', function (event) {
                event.preventDefault();
                var cnode = $(this);

                F.confirm({
                    message: '你确定要这么做吗？',
                    target: '_top',
                    ok: function () {
                        var rowEl = cnode.closest('.f-grid-row');
                        var rowData = grid1.getRowData(rowEl);
                        var column = grid1.getColumn(cnode.parents('.f-grid-cell'));

                        // 触发后台事件
                        F.customEvent('Grid1_RowCommand', {
                            rowId: rowData.id,
                            rowText: rowData.text,
                            rowIndex: rowEl.index(),
                            columnIndex: column.index
                        });

                    }
                });
            });

        });


    </script>
}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>手工绘制行内按钮并委托处理点击，按点击元素找到本次操作的记录。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>从行内入口找到所属记录</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>某行中的文字按钮或图标命令；出现确认框时选择确认。<br />结果：命令回发到后台，提示显示当前记录和命令信息；本页用结果提示演示处理，不代表已执行真实删除。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：本示例手工实现了行内按钮事件，实现复杂。推荐使用更加方便的Command标签：表格/行命令/行命令（服务端事件）。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>RendererFunction</code>（<strong>操作列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：渲染出行内入口，再在表格容器中按入口类型处理点击。</li>
            <li><code>F.customEvent</code>（<strong>页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：手工点击处理主动提交本次行信息，由自定义事件读取参数并显示。</li>
        </ul>
    </section>
}
