@page
@model FineUI.Core.Examples.Pages.Grid.SortingQuickSortFieldModel
@{
    ViewBag.Title = "Grid/SortingQuickSortField";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" EnableCheckBoxSelect="true" DataIDField="Id" DataTextField="Name" 
            AllowSorting="true" SortField="Gender" SortDirection="ASC" OnSort="Grid1_Sort">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" QuickSortField="true" />
            <f:RenderField HeaderText="性别" DataField="Gender" QuickSortField="true" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" QuickSortField="true" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" QuickSortField="true" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>用列的快速排序字段同时指定取值字段与后台排序字段，未配置排序的列不提供排序入口。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>对照可排序与不可排序列</h3>
    <ol>
        <li>连续两次点击<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>的<strong>姓名</strong>列标题。<br />结果：后台按姓名先升序再降序绑定数据，姓名列显示对应排序方向。</li>
        <li>点击<strong>所学专业</strong>列标题。<br />结果：该列未配置排序，不改变当前排序。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>QuickSortField</code>（<strong>姓名</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>true</code>，让该列按同名字段显示和排序；未配置排序字段的列保持不可排序。</li>
    </ul>
</section>
}
