@page
@model FineUI.Core.Examples.Pages.Grid.SortingQuickSortFieldModel
@{
    ViewBag.Title = "Grid/SortingQuickSortField";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" EnableCheckBoxSelect="true" DataIDField="Id" DataTextField="Name" 
            AllowSorting="true" SortField="Gender" SortDirection="ASC" OnSort="Grid1_Sort">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" QuickSortField="true" />
            <f:RenderField HeaderText="性别" DataField="Gender" QuickSortField="true" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" QuickSortField="true" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" QuickSortField="true" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}