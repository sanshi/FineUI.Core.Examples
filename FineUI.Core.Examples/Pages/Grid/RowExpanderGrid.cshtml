@page
@model FineUI.Core.Examples.Pages.Grid.RowExpanderGridModel
@{
    ViewBag.SourceFiles = "~/Grid/RowExpanderGridData";
    ViewBag.Title = "Grid/RowExpanderGrid";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsViewPort="true" ShowBorder="true" ShowHeader="true" Title="表格（嵌套表格仅用于数据展示，不适合复杂的逻辑处理）" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
            <f:RenderField ColumnID="Desc" RenderAsRowExpander="true"></f:RenderField>
        </Columns>
        <Listeners>
            <f:Listener Event="rowexpanderexpand" Handler="onRowExpanderExpand"></f:Listener>
            <f:Listener Event="rowexpandercollapse" Handler="onRowExpanderCollapse"></f:Listener>
        </Listeners>
    </f:Grid>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onRowExpanderExpand(event, rowId) {
            var grid = this, rowEl = grid.getRowEl(rowId), rowData = grid.getRowData(rowId);

            // v12.0 - 行扩展列重构，.f-grid-rowexpander-details位于.f-grid-row.f-grid-rowexpander节点的下面
            // var tplEl = rowEl.find('.f-grid-rowexpander-details .f-grid-cell-text');
            var tplEl = rowEl.next().find('.f-grid-cell-text');
            if (!tplEl.find('.gridinrowexpander').length) {

                var url = '@Url.Content("~/Grid/RowExpanderGridData")';
                url += '?rowId=' + rowId + '&name=' + encodeURIComponent(rowData.values['Name']); // 这里可传递行中任意数据（rowData）

                F.create({
                    type: 'Grid',
                    renderTo: tplEl,
                    header: false,
                    columnMenu: false,
                    columnResizing: false,
                    cls: 'gridinrowexpander',
                    fields: ['type', 'yuwen', 'shuxue', 'yingwen', 'wuli', 'huaxue'],
                    columns: [{
                        text: '', field: 'type', width: 80
                    }, {
                        text: '语文', field: 'yuwen', width: 80
                    }, {
                        text: '数学', field: 'shuxue', width: 80
                    }, {
                        text: '英文', field: 'yingwen', width: 80
                    }, {
                        text: '物理', field: 'wuli', width: 80
                    }, {
                        text: '化学', field: 'huaxue', width: 80
                    }, {
                        text: '平均成绩', columnId: 'avg', flex: 1,
                        renderer: function (value, params) {
                            var total = 0;

                            var kemuList = ['yuwen', 'shuxue', 'yingwen', 'wuli', 'huaxue'];
                            $.each(kemuList, function (index, item) {
                                total += params.rowData.values[item];
                            });

                            return Math.round(total / kemuList.length);
                        }
                    }],
                    dataUrl: url,
                    listeners: {
                        dataload: function () {
                            rowExpandersDoLayout();
                        }
                    }
                });
            }
        }

        function onRowExpanderCollapse(event, rowId) {
            rowExpandersDoLayout();
        }

        // 重新布局表格和行扩展列中的表格（解决出现纵向滚动条时的布局问题）
        function rowExpandersDoLayout() {

            // 先布局外部表格
            F.ui.Grid1.doLayout();

            // 再布局已展开行扩展列的内部表格
            $('.f-grid-rowexpander-details:not(.f-hidden) .gridinrowexpander').each(function () {
                var gridInside = F($(this).attr('id'));
                gridInside.doLayout();
            });
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>首次展开一行时按行参数加载成绩，使用内嵌 FineUI 表格显示明细。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>按当前行加载明细</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（嵌套表格仅用于数据展示，不适合复杂的逻辑处理）">表格（嵌套表格仅用于数据展示，不适合复杂的逻辑处理）</strong>首行左侧的展开图标。<br />结果：首次展开时把当前行标识与<strong>姓名</strong>交给数据地址，显示入学、期中、期末成绩及平均成绩；已创建的明细不会因再次展开而重复添加。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>rowexpanderexpand / dataUrl</code>（<strong>明细加载脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（嵌套表格仅用于数据展示，不适合复杂的逻辑处理）">表格（嵌套表格仅用于数据展示，不适合复杂的逻辑处理）</strong>）：只在尚未创建明细时按行参数加载数据；明细用于展示，不适合复杂嵌套业务编辑。</li>
            <li><code>doLayout</code>（<strong>父表及展开明细</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（嵌套表格仅用于数据展示，不适合复杂的逻辑处理）">表格（嵌套表格仅用于数据展示，不适合复杂的逻辑处理）</strong>）：明细加载或收起后重新计算外层及已展开内容的布局，避免新增滚动条时错位。</li>
        </ul>
    </section>
}
