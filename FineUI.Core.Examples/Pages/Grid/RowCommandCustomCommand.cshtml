@page
@model FineUI.Core.Examples.Pages.Grid.RowCommandCustomCommandModel
@{
    ViewBag.Title = "Grid/RowCommandCustomCommand";
    var F = Html.F();
}


@section head {

    <style>
        .mybtn3 .f-icon.f-icon-remove {
            color: red;
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
        OnRowCommand="Grid1_RowCommand" _DataKeyNames="Id,Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="">
                <Commands>
                    <f:Command CommandName="Action0" IconFont="Info" ToolTip="弹出客户端提示信息" />
                    <f:Command CommandName="Action1" IconFont="Pencil" ToolTip="编辑" />
                    <f:Command CommandName="Action3" IconFont="Remove" ToolTip="删除" CssClass="mybtn3" ConfirmText="你确定要这么做吗？" ConfirmTarget="Top" />
                </Commands>
            </f:RenderField>
        </Columns>
        <Listeners>
            <f:Listener Event="rowcommand" Handler="onGrid1RowCommand"></f:Listener>
        </Listeners>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onGrid1RowCommand(event, rowId, rowIndex, columnId, commandName) {
            if (commandName === 'Action0') {

                F.alert('这是客户端提示信息（已阻止后台事件执行）！');

                // 阻止服务器端事件的执行
                return false;
            }
        }

    </script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>在客户端行命令回调中拦截指定动作，其他命令继续交给后台处理。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>对照客户端拦截与后台处理</h3>
        <ol>
            <li>点击<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>中的<strong>客户端命令</strong>，再点击普通服务器命令。<br />结果：指定命令只显示浏览器提示，回调返回 false 后不执行后台事件；普通命令仍回发并显示本次行信息。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>rowcommand</code>（<strong>页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：浏览器回调根据命令名判断是否拦截，返回 false 只取消当前命令的后台处理。</li>
        </ul>
    </section>
}
