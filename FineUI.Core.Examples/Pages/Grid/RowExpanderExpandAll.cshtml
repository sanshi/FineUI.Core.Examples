@page
@model FineUI.Core.Examples.Pages.Grid.RowExpanderExpandAllModel
@{
    ViewBag.Title = "Grid/RowExpanderExpandAll";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" ExpandAllRowExpanders="true"
        Height="500">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
            <f:RenderField DataField="Desc" RenderAsRowExpander="true" RendererFunction="renderExpander"></f:RenderField>
        </Columns>
    </f:Grid>
    <br />
    <f:Button ID="btnToggleRowExpanders" Text="显示/隐藏行扩展列" ClickHandler="onToggleRowExpanderClick"></f:Button>
    <br>
    <br>

    <f:Button ID="Button1" Text="重新绑定表格" CssClass="marginr" OnClick="Button1_Click"></f:Button>
    <f:Button ID="btnExpandRowExpanders" CssClass="marginr" Text="展开全部的行扩展列" ClickHandler="onExpandAllClick"></f:Button>
    <f:Button ID="btnCollapseRowExpanders" Text="折叠全部的行扩展列" ClickHandler="onCollapseAllClick"></f:Button>


    <br>
    <br>


}


@section script {

    <script src="~/res/js/grid.js"></script>
    <script type="text/javascript">

        function onToggleRowExpanderClick(event) {
            F.ui.Grid1.rowExpander.toggleVisible();
        }

        function onExpandAllClick(event) {
            F.ui.Grid1.expandRowExpanders();
        }

        function onCollapseAllClick(event) {
            F.ui.Grid1.collapseRowExpanders();
        }
    </script>


}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>初始展开每条记录的行详情，并允许统一展开、折叠或重新绑定数据。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>初始展开与后续切换</h3>
        <ul>
            <li>从初始状态查看<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>各行下方的详情区域。<br />结果：各行详情已显示；可以单独折叠其中一行，其余仍保持展开。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>统一控制全部行</h3>
        <ol>
            <li>点击<strong class="example-control-reference" data-example-control="btnCollapseRowExpanders" title="折叠全部的行扩展列">折叠全部的行扩展列</strong>，再点击<strong
                    class="example-control-reference" data-example-control="btnExpandRowExpanders"
                    title="展开全部的行扩展列">展开全部的行扩展列</strong>。<br />结果：现有详情先全部收起，再统一展开；数据行本身保留。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>切换扩展入口是否显示</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="btnToggleRowExpanders"
                    title="显示/隐藏行扩展列">显示/隐藏行扩展列</strong>两次。<br />结果：行扩展列先隐藏、再恢复；只调整详情入口显示，不删除主行数据。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：通过一个简单的属性，来控制是否展开所有行扩展列（即使在重新绑定数据后，依然能够保持所有扩展列的展开状态）。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>RowExpanderField</code>（<strong>行扩展列</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：在记录下方容纳额外展示内容，不改变原数据字段或行标识。</li>
            <li><code>ExpandAllRowExpanders</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>true</code>，初次绑定时展开所有行的扩展内容，后续仍可单行或统一折叠。
            </li>
        </ul>
    </section>
}
