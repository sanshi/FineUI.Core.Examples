@page
@model FineUI.Core.Examples.Pages.Grid.GridModel
@{
    ViewBag.SourceFiles = "~/wwwroot/res/js/grid.js";
    ViewBag.Title = "Grid/Grid";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button ID="btnShowSelectedRows" Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>绑定学生数据并显示不同类型的列，读取当前选中行的业务标识和文字。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>读取各列数据</h3>
    <ul>
        <li>查看<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>中的姓名、性别、入学年份和专业。<br />结果：首次加载时后台绑定示例数据，各列按字段名称显示对应的学生信息。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>读取所选行</h3>
    <ul>
        <li>选择<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>中的一行，再点击<strong class="example-control-reference" data-example-control="btnShowSelectedRows" title="选中了哪些行">选中了哪些行</strong>。<br />结果：提示显示当前选中的行；未选中记录时提示没有选中项。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>DataIDField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>Id</code>，从每行数据读取稳定的业务主键，用于识别选中记录。</li>
        <li><code>DataTextField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>Name</code>，指定选中结果使用的显示文字字段。</li>
        <li><code>DataSource / DataBind</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：后台提供数据集合并完成绑定；列按 DataField 读取当前行字段。</li>
    </ul>
</section>
}
