@page
@model FineUI.Core.Examples.Pages.Grid.IFrameModel
@{
    ViewBag.SourceFiles = "~/Grid/IFrameWindow";
    ViewBag.Title = "Grid/IFrame";
    var F = Html.F();
}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name"
        _DataKeyNames="Id,Name" OnRowDoubleClick="Grid1_RowDoubleClick">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="窗口列">
                <Commands>
                    <f:Command CommandName="Action1" Text="编辑" CssClass="mywindowfield"
                               WindowID="Window1" 
                               WindowIFrameUrlFormatString="@Url.Content("~/Grid/IFrameWindow?id={0}&name={1}")" _WindowIFrameUrlFields="Id,Name"
                               WindowTitleFormatString="编辑 - {0}" _WindowTitleFields="Name" />
                </Commands>
            </f:RenderField>
        </Columns>
    </f:Grid>

    <br>
    <br>


    <f:Window ID="Window1" Title="编辑" Hidden="true" EnableIFrame="true" CloseAction="HidePostBack" EnableMaximize="true" EnableResize="true"
              OnClose="Window1_Close" Target="Top" IsModal="true" Width="850" Height="500">
    </f:Window>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>
        // 弹窗关闭后先回到打开它的本页，再通知外层首页移除当前选项卡。
        function closeOwnerTab() {
            parent.removeActiveTab();
        }
    </script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>由行命令按当前记录的不同字段分别生成详情网址与窗体标题。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>按当前行打开详情</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>第一行的<strong>编辑图标</strong>，关闭后再打开另一行。<br />结果：每次打开都读取本次行数据，网址参数取自 <code>Id、Name</code>，标题文字取自 <code>Name</code>；切换记录后不会沿用前一行参数。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>双击记录打开与关闭</h3>
    <ol>
        <li>双击<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>中的姓名单元格，再关闭编辑窗体。<br />结果：双击事件由后台读取本次行数据并打开窗口；窗口关闭事件回发后显示关闭提示。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <p>注：双击行同样可以弹出编辑窗体。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>WindowIFrameUrlFields / WindowIFrameUrlFormatString</code>（<strong>行命令</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：从当前行的指定字段取值，填入详情网址中的参数位置。</li>
        <li><code>WindowTitleFields / WindowTitleFormatString</code>（<strong>行命令</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：标题独立从指定字段取值，可以与网址字段不同。</li>
    </ul>
</section>
}
