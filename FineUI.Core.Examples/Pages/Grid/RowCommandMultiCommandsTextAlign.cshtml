@page
@model FineUI.Core.Examples.Pages.Grid.RowCommandMultiCommandsTextAlignModel
@{
    ViewBag.Title = "Grid/RowCommandMultiCommandsTextAlign";
    var F = Html.F();
}


@section head {

    <style>
        .mybtn3 .f-icon.f-icon-remove {
            color: red;
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
            OnRowCommand="Grid1_RowCommand" _DataKeyNames="Id,Name" EnableColumnLines="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:GroupField HeaderText="操作分组">
                <Columns>
                    <f:RenderField HeaderText="居中显示" TextAlign="Center" Width="200">
                        <Commands>
                            <f:Command CommandName="Action1" IconFont="Pencil" ToolTip="编辑" />
                            <f:Command CommandName="Action3" IconFont="Remove" ToolTip="删除" CssClass="mybtn3" ConfirmText="你确定要这么做吗？" ConfirmTarget="Top" />
                        </Commands>
                    </f:RenderField>
                </Columns>
            </f:GroupField>
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>在同一列内居中排列多个命令，分别保留它们的命令标识与点击处理。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>对照命令外观与对应结果</h3>
    <ul>
        <li>分别点击<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>同一行中的文字或图标命令，出现确认框时先确认。<br />结果：命令回发后，提示显示所点记录和命令信息；改变显示外观或同列排列，不会把多个入口合并为同一命令。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>TextAlign</code>（<strong>操作列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：所属操作列配置居中对齐，使一组命令在列宽中居中显示。</li>
    </ul>
</section>
}
