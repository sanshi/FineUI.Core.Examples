@page
@model FineUI.Core.Examples.Pages.Grid.CheckAllModel
@{
    ViewBag.SourceFiles = "~/Code/GridSelectionMessage.cs";
    ViewBag.Title = "Grid/CheckAll";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" EnableCheckBoxSelect="true" DataIDField="Id" DataTextField="Name"
        _DataKeyNames="Id,Name,Gender,Major">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br>

    <f:Button ID="btnShowSelectedRowsClient" Text="选中了哪些行（客户端）" CssClass="marginr" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <f:Button ID="btnSelectRows" Text="选中第 2, 6, 8 行（客户端）" CssClass="marginr" ClickHandler="onSelectRowsClick"></f:Button>
    <br>
    <br>
    <f:Button Text="选中了哪些行" CssClass="marginr" ID="Button1" OnClick="Button1_Click"></f:Button>

    <f:Button Text="选中第 2, 6, 8 行" CssClass="marginr" ID="Button2" OnClick="Button2_Click"></f:Button>
    <br>
    <br>
    <f:Button Text="选中了哪些行（自定义回发）" CssClass="marginr" ID="Button3" ClickHandler="onCheckSelectionClick" OnClick="Button1_Click">
    </f:Button>
    <br>
    <br>注：表格默认选中了第 5， 10 行。
    <br>

}


@section script {

    <script src="~/res/js/grid.js"></script>
    <script type="text/javascript">

        function onSelectRowsClick(event) {
            F.ui.Grid1.selectRows([1,5,7]);
        }
        function onCheckSelectionClick(event) {
            if (!F.ui.Grid1.hasSelection()) {
                F.alert({ message: '没有选中项！', target: '_top' });
                return false;
            }
        }

    </script>


}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>通过复选框、客户端方法与后台赋值选择多行，并读取选中行的业务主键和文字。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>手工勾选并读取结果</h3>
        <ol>
            <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>勾选两条记录，再点击<strong
                    class="example-control-reference" data-example-control="btnShowSelectedRowsClient"
                    title="选中了哪些行（客户端）">选中了哪些行（客户端）</strong>。<br />结果：提示显示当前选中行的标识与文字，结果与当前勾选记录一致。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>通过方法与后台赋值选择</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="btnSelectRows" title="选中第 2, 6, 8 行（客户端）">选中第 2, 6, 8
                    行（客户端）</strong>。<br />结果：浏览器按脚本中的业务主键直接选中目标记录，不发出后台选择请求。</li>
            <li>点击<strong class="example-control-reference" data-example-control="Button2" title="选中第 2, 6, 8 行">选中第 2, 6, 8
                    行</strong>。<br />结果：按钮回发后后台设置选中主键，浏览器同步显示这些记录的选择状态。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>回发前检查选择</h3>
        <ol>
            <li>清空选择后点击<strong class="example-control-reference" data-example-control="Button3"
                    title="选中了哪些行（自定义回发）">选中了哪些行（自定义回发）</strong>，再选中一行重试。<br />结果：未选择时由浏览器提示并取消回发；已有选择时才继续由后台读取并显示结果。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableCheckBoxSelect</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>true</code>，显示选择列和表头全选入口。
            </li>
            <li><code>DataIDField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>Id</code>，按稳定的业务主键识别选择，不按当前行序号识别。
            </li>
            <li><code>SelectedRowIDArray</code>（<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：按业务主键设置或读取选中行，客户端与后台使用相同标识。</li>
        </ul>
    </section>
}
