@page
@model FineUI.Core.Examples.Pages.Grid.RowCommandHideSomeModel
@{
    ViewBag.Title = "Grid/RowCommandHideSome";
    var F = Html.F();
}


@section head {

    <style>
        .mybtn3 .f-icon.f-icon-remove {
            color: red;
        }

        .f-grid-command.hidethis {
            visibility: hidden;
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
        OnRowCommand="Grid1_RowCommand" _DataKeyNames="Id,Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="">
                <Commands>
                    <f:Command CommandName="Action1" Icon="Pencil" RendererFunction="renderAction1" />
                    <f:Command CommandName="Action3" IconFont="Remove" ToolTip="删除" CssClass="mybtn3" ConfirmText="你确定要这么做吗？" ConfirmTarget="Top" />
                </Commands>
            </f:RenderField>
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>
    <br />
    <br />

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        // 行命令渲染函数
        // value: 渲染后的HTML片段
        // params: 当前行数据（和列渲染函数类似，F12查看有哪些数据）
        // command: 当前行命令参数
        function renderAction1(value, params, command) {
            var entranceYear = params.rowData.values['EntranceYear'];

            if (entranceYear == 2008) {
                return $(value).addClass('hidethis');
            }
        }

    </script>
}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>按行数据隐藏特定命令，其他行及同一行的其他命令仍可用。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>对照受限命令与可用命令</h3>
        <ul>
            <li>对照<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>中入学年份等于 2008
                的行与其他记录的第一个命令。<br />结果：符合条件的首个命令不显示；其他记录的该命令和同一行的其他入口保持原样。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：本示例隐藏入学年份等于 2008 行中 CommandName==Action1 的行命令。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>RendererFunction</code>（<strong>行命令</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：命令渲染函数读取当前行入学年份，只对 2008 对应命令附加隐藏或禁用样式。</li>
        </ul>
    </section>
}
