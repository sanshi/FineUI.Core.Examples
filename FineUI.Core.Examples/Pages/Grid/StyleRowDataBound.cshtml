@page
@model FineUI.Core.Examples.Pages.Grid.StyleRowDataBoundModel
@{
    ViewBag.Title = "Grid/StyleRowDataBound";
    var F = Html.F();
}


@section head {

    <style>
        
        .f-grid-row.color1 .f-grid-cell-Name,
        .f-grid-row.color1 .f-grid-cell-Gender,
        .f-grid-row.color1 .f-grid-cell-EntranceYear {
            color: red;
            font-weight: bold;
        }

        .f-grid-row.color3 .f-grid-cell-Name,
        .f-grid-row.color3 .f-grid-cell-Gender,
        .f-grid-row.color3 .f-grid-cell-EntranceYear {
            color: green;
            font-weight: bold;
        }

    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name"
        RowDataBoundFunction="grid1RowDataBound">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中了哪些行" CssClass="marginr" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <f:Button ID="btnRebindGrid" Text="重新绑定表格" OnClick="Button1_Click"></f:Button>


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        // 在 RowDataBound 中改变行CSS类
        function grid1RowDataBound(rowData) {
            var entranceYear = rowData.values['EntranceYear'];

            if (entranceYear >= 2000 && entranceYear <= 2004) {
                rowData.cls = "color1";
            } else if (entranceYear == 2008) {
                rowData.cls = "color3";
            }
        }

    </script>
}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>在浏览器行绑定函数中按数据设置行样式。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>对照本页样式规则</h3>
        <ul>
            <li>比较<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>中不同<strong>入学年份</strong>的记录。<br />结果：2000 至 2004
                与 2008 年的记录分别带上不同标记，本页 CSS 再据此设置指定单元格外观；没有命中的行不套用这些条件样式。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>换一组记录后重新应用规则</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="btnRebindGrid"
                    title="重新绑定表格">重新绑定表格</strong>。<br />结果：按钮回发后后台换入另一组记录；列配置或按数据判断的样式规则继续应用，不是仅给最初几行写死颜色。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>rowData.cls</code>（<strong>本页列与样式</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：浏览器在当前行绑定阶段检查本行数据，再设置样式类；不需要为颜色变化单独回发。</li>
        </ul>
    </section>
}
