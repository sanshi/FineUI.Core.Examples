@page
@model FineUI.Core.Examples.Pages.Grid.RowCommandPostBackModel
@{
    ViewBag.Title = "Grid/RowCommandPostBack";
    var F = Html.F();
}


@section head {

    <style>
        .mybtn3 .f-icon.f-icon-remove {
            color: red;
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
            OnRowCommand="Grid1_RowCommand" _DataKeyNames="Id,Name" EnableColumnMove="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="">
                <Commands>
                    <f:Command CommandName="Action3" IconFont="Remove" CssClass="mybtn3" ConfirmText="你确定要这么做吗？" ConfirmTarget="Top" />
                </Commands>
            </f:RenderField>
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>通过服务器行命令事件接收本次行标识、列和命令，并显示处理结果。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>处理当前行命令</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>某行中的文字按钮或图标命令；出现确认框时选择确认。<br />结果：命令回发到后台，提示显示当前记录和命令信息；本页用结果提示演示处理，不代表已执行真实删除。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>CommandName</code>（<strong>行命令</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：为各个命令提供独立的业务标识，回调按本次名称区分动作。</li>
        <li><code>OnRowCommand</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：无需为了回发另写客户端 Listener，服务器直接接收本次命令事件。</li>
    </ul>
</section>
}
