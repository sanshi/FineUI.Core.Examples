@page
@model FineUI.Core.Examples.Pages.Grid.RowExpanderModel
@{
    ViewBag.Title = "Grid/RowExpander";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
            <f:RenderField DataField="Desc" RenderAsRowExpander="true" RendererFunction="renderExpander"></f:RenderField>
        </Columns>
    </f:Grid>
    <br />
    <f:Button ID="btnToggleRowExpanders" Text="显示/隐藏行扩展列" ClickHandler="onToggleRowExpanderClick"></f:Button>
    <br>
    <br>


}


@section script {

    <script src="~/res/js/grid.js"></script>
    <script type="text/javascript">

        function onToggleRowExpanderClick(event) {
            F.ui.Grid1.rowExpander.toggleVisible();
        }
    </script>


}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>在主行下方展开额外资料，可单独折叠或隐藏整列展开入口。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>展开或收起单行详情</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>首行左侧的展开图标。<br />结果：该行下方出现<strong>姓名</strong>、个人信息等扩展内容；再次点击只收起这一行，不删除记录。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>切换扩展入口是否显示</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="btnToggleRowExpanders"
                    title="显示/隐藏行扩展列">显示/隐藏行扩展列</strong>两次。<br />结果：行扩展列先隐藏、再恢复；只调整详情入口显示，不删除主行数据。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：隐藏后仍然可以通过ENTER键展开折叠行扩展列的内容区域。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>RowExpanderField</code>（<strong>行扩展列</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：在记录下方容纳额外展示内容，不改变原数据字段或行标识。</li>
        </ul>
    </section>
}
