@page
@model FineUI.Core.Examples.Pages.Grid.CheckFieldColumnCheckAllModel
@{
    ViewBag.Title = "Grid/CheckFieldColumnCheckAll";
    var F = Html.F();
}

@section head {

    <style>
        .f-field-body-checkboxlabel {
            white-space: nowrap;
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataSource="@DataSourceUtil.GetDataTable()">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderCheckField HeaderText="是否在校2" ColumnID="AtSchool2" DataField="AtSchool" RenderAsStaticField="false" />
            <f:RenderCheckField HeaderText="是否在校3" ColumnID="AtSchool3" DataField="AtSchool" RenderAsStaticField="false" />
            <f:RenderCheckField HeaderText="是否在校4" ColumnID="AtSchool4" DataField="AtSchool" RenderAsStaticField="false" />
        </Columns>
        <Toolbars>
            <f:Toolbar ID="Toolbar1">
                <Items>
                    <f:Label Text="快速设定："></f:Label>
                    <f:CheckBox Text="是否在校2" MarginRight="10" AttributeDataTag="AtSchool2">
                        <Listeners>
                            <f:Listener Event="change" Handler="onQuickSetCheckChange" />
                        </Listeners>
                    </f:CheckBox>
                    <f:CheckBox Text="是否在校3" MarginRight="10" AttributeDataTag="AtSchool3">
                        <Listeners>
                            <f:Listener Event="change" Handler="onQuickSetCheckChange" />
                        </Listeners>
                    </f:CheckBox>
                    <f:CheckBox Text="是否在校4" MarginRight="10" AttributeDataTag="AtSchool4">
                        <Listeners>
                            <f:Listener Event="change" Handler="onQuickSetCheckChange" />
                        </Listeners>
                    </f:CheckBox>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中行复选框的状态" ClickHandler="onNotifyCheckFieldStatusClick"></f:Button>

}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onQuickSetCheckChange(event) {
            var grid1 = F.ui.Grid1;
            var checkboxFieldID = this.getAttr('data-tag'), checked = this.getValue();

            var checkboxEls = grid1.el.find('.f-grid-cell-' + checkboxFieldID + ' .f-grid-checkbox');
            checkboxEls.toggleClass('f-checked', checked);
        }

        function onNotifyCheckFieldStatusClick(event) {
            var grid1 = F.ui.Grid1;

            var rowEls = grid1.getSelectedRowEls();
            if (!rowEls.length) {
                F.alert('没有选中项！');
                return;
            }

            var result = ['<table class="result">'];
            result.push('<tr>');
            result.push('<th>ID</th>');
            result.push('<th>姓名</th>');
            result.push('<th>是否在校2</th>');
            result.push('<th>是否在校3</th>');
            result.push('<th>是否在校4</th>');
            result.push('</tr>');
            rowEls.each(function () {
                var cnode = $(this);
                var rowData = grid1.getRowData(cnode);
                var isChecked2 = cnode.find('.f-grid-cell-AtSchool2 .f-grid-checkbox').hasClass('f-checked');
                var isChecked3 = cnode.find('.f-grid-cell-AtSchool3 .f-grid-checkbox').hasClass('f-checked');
                var isChecked4 = cnode.find('.f-grid-cell-AtSchool4 .f-grid-checkbox').hasClass('f-checked');

                result.push('<tr>');
                result.push('<td>' + rowData.id + '</td>');
                result.push('<td>' + rowData.text + '</td>');
                result.push('<td>' + (isChecked2 ? '在校' : '不在校') + '</td>');
                result.push('<td>' + (isChecked3 ? '在校' : '不在校') + '</td>');
                result.push('<td>' + (isChecked4 ? '在校' : '不在校') + '</td>');
                result.push('</tr>');
            });
            result.push('</table>');

            F.notify({
                message: F.rawHtml(result.join('')),
                target: '_top',
                header: false,
                messageIcon: '',
                positionX: 'center',
                positionY: 'top'
            });
        }

    </script>
}