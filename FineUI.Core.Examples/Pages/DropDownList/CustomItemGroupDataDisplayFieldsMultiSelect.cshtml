@page
@model FineUI.Core.Examples.Pages.DropDownList.CustomItemGroupDataDisplayFieldsMultiSelectModel
@{
    ViewBag.Title = "DropDownList/CustomItemGroupDataDisplayFieldsMultiSelect";
    var F = Html.F();
}

@section head {

    <style>
        .item-text {
            margin-bottom: 5px;
            font-weight: bold;
            display: inline-block;
        }

        .item-desc {
            font-size: 0.9em;
            word-break: break-all;
        }

        .f-field-dropdownlist-pop-groupitem {
            padding-left: 20px !important;
            display: flex;
            justify-content: flex-start;
        }
    </style>

}

@section body {

    @{
        var DDL_DISPLAY_TEMPLATE = "<div class=\"item-text\">{0}</div><div class=\"item-desc\">{1}</div>";
    }

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="分组+自定义列表项+多选+复选框" ShowHeader="true">
        <Items>
            <f:DropDownList ID="DropDownList1" EnableMultiSelect="true" EnableCheckBoxSelect="true"
                            EnableGroup="true" DataTextField="Name" DataValueField="Id" DataGroupField="Major"
                            _DataDisplayFields="Name,Desc" DataDisplayFormatString="@DDL_DISPLAY_TEMPLATE"
                            DataSource="@DataSourceUtil.GetDataTable()">
            </f:DropDownList>
            <f:Button ID="btnGetSelection" Text="获取此下拉列表的选中项" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>

}

