@page
@model FineUI.Core.Examples.Pages.DropDownList.CustomItemGroupDataDisplayFieldsMultiSelectModel
@{
    ViewBag.Title = "DropDownList/CustomItemGroupDataDisplayFieldsMultiSelect";
    var F = Html.F();
}

@section head {

    <style>
        .item-text {
            margin-bottom: 5px;
            font-weight: bold;
            display: inline-block;
        }

        .item-desc {
            font-size: 0.9em;
            word-break: break-all;
        }

        .f-field-dropdownlist-pop-groupitem {
            padding-left: 20px !important;
            display: flex;
            justify-content: flex-start;
        }
    </style>

}

@section body {

    @{
        var DDL_DISPLAY_TEMPLATE = "<div class=\"item-text\">{0}</div><div class=\"item-desc\">{1}</div>";
    }

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="分组+自定义列表项+多选+复选框" ShowHeader="true">
        <Items>
            <f:DropDownList ID="DropDownList1" EnableMultiSelect="true" EnableCheckBoxSelect="true"
                            EnableGroup="true" DataTextField="Name" DataValueField="Id" DataGroupField="Major"
                            _DataDisplayFields="Name,Desc" DataDisplayFormatString="@DDL_DISPLAY_TEMPLATE"
                           >
            </f:DropDownList>
            <f:Button ID="btnGetSelection" Text="获取此下拉列表的选中项" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>将人员按专业分组，使用模板显示姓名与描述，并支持复选框多选。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>按分组查找选项</h3>
        <ol>
            <li>
                展开列表，对照分组标题与标题下的人员选项。<br />
                结果：分组标题用于区分专业等类别；实际选中的仍是人员项，输入区显示人员名称。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>区分选项模板和选中文字</h3>
        <ol>
            <li>
                展开面板选择<code>张萍萍</code>这一项。<br />
                结果：面板可同时显示姓名、描述等模板内容；选中后输入区使用姓名，业务值为 <code>101</code>。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableGroup</code>（<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>）：按数据分组显示列表项。 本页声明值为 <code>true</code>。</li>
            <li><code>DataGroupField</code>（<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>）：从指定数据字段取得分组标题。 本页声明值为 <code>Major</code>。</li>
            <li><code>_DataDisplayFields</code>（<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>）：把额外数据字段提供给选项显示模板。 本页声明值为 <code>Name</code>,<code>Desc</code>。</li>
            <li><code>DataDisplayFormatString</code>（<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>）：自定义下拉面板内选项的显示内容。</li>
            <li><code>DataTextField</code>（<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>）：从指定字段取得选中后显示的文字。 本页声明值为 <code>Name</code>。</li>
        </ul>
    </section>
}
