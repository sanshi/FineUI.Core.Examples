@page
@model FineUI.Core.Examples.Pages.DropDownList.MultiSelectTagsEnableEditEmptyTextModel
@{
    ViewBag.Title = "DropDownList/MultiSelectTagsEnableEditEmptyText";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="下拉列表（多选，可编辑，强制选择）" ShowHeader="true">
        <Items>
            <f:DropDownList ID="DropDownList1" EnableMultiSelect="true" EnableEdit="true" MultiSelectMode="Tags" AutoSelectFirstItem="false">
                <f:ListItem Text="可选项1" Value="Value1" />
                <f:ListItem Text="可选项2（不可选择）" Value="Value2" EnableSelect="false" />
                <f:ListItem Text="可选项3（不可选择）" Value="Value3" EnableSelect="false" />
                <f:ListItem Text="可选项4" Value="Value4" />
                <f:ListItem Text="可选项5" Value="Value5" />
                <f:ListItem Text="可选项6" Value="Value6" />
                <f:ListItem Text="可选择项7" Value="Value7" />
                <f:ListItem Text="可选择项8" Value="Value8" />
                <f:ListItem Text="可选择项9" Value="Value9" />
                <f:ListItem Text="普通型1 < L > 1.5" Value="普通型1 < L > 1.5" />
            </f:DropDownList>

            <f:Button ID="btnSelectItem6" Text="选中[可选项6]" CssClass="marginr" OnClick="btnSelectItem6_Click"></f:Button>
            <f:Button ID="btnGetSelection" Text="获取此下拉列表的选中项" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>




}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>用可移除标签展示多项选择，键入文字筛选并匹配已有项，初始保持未选择。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>保持初始空选择</h3>
        <ol>
            <li>
                初次打开页面，先不选择任何项。<br />
                结果：输入区没有选中值；之后可从列表选择有效项。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>AutoSelectFirstItem</code>（<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>）：为
                <code>false</code> 时，不自动把第一项设为初始选择。 本页声明值为 <code>false</code>。
            </li>
        </ul>
    </section>
}
