@page
@model FineUI.Core.Examples.Pages.DropDownList.MultiSelectTagsNoForceSelectionInitValueModel
@{
    ViewBag.Title = "DropDownList/MultiSelectTagsNoForceSelectionInitValue";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="下拉列表（多选，可编辑，用户输入值）" ShowHeader="true">
        <Items>
            <f:DropDownList ID="DropDownList1" EnableMultiSelect="true" EnableEdit="true" ForceSelection="false" MultiSelectMode="Tags">
                <f:ListItem Text="可选项1" Value="Value1" Selected="true" />
                <f:ListItem Text="可选项2（不可选择）" Value="Value2" EnableSelect="false" />
                <f:ListItem Text="可选项3（不可选择）" Value="Value3" EnableSelect="false" />
                <f:ListItem Text="可选项4" Value="Value4" Selected="true" />
                <f:ListItem Text="可选项5" Value="Value5" />
                <f:ListItem Text="可选项6" Value="Value6" />
                <f:ListItem Text="可选择项7" Value="Value7" />
                <f:ListItem Text="可选择项8" Value="Value8" />
                <f:ListItem Text="可选择项9" Value="Value9" />
                <f:ListItem Text="普通型1 < L > 1.5" Value="普通型1 < L > 1.5" />
            </f:DropDownList>

            <f:Button ID="btnSelectItem6" Text="选中[可选项6]" CssClass="marginr" OnClick="btnSelectItem6_Click"></f:Button>
            <f:Button ID="btnGetSelection" Text="获取此下拉列表的选中项" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>



}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示在初次加载时显示列表之外的自定义文字，以及真实选项与自定义初值的组合。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>查看后台提供的初始文字</h3>
        <ol>
            <li>
                初次打开页面。<br />
                结果：输入区显示“可选项1, 可选项4, 初始自定义值1”，即使尚未选择列表项也保留这段初始文字。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>SelectedValueArray</code>：后台设置选中值；获取按钮读取本次提交的当前选择。</li>
            <li><code>ForceSelection</code>：为 false 时允许保存列表之外的用户输入；为 true 时需要匹配现有选项。 本页声明值为 false。</li>
            <li><code>Text</code>：提供本页的初始显示文字。</li>
        </ul>
    </section>
}
