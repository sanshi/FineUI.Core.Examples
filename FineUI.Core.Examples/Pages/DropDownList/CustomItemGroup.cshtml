@page
@model FineUI.Core.Examples.Pages.DropDownList.CustomItemGroupModel
@{
    ViewBag.Title = "DropDownList/CustomItemGroup";
    var F = Html.F();
}


@section head {

    <style>
        .item-text {
            margin-bottom: 5px;
            font-weight: bold;
        }

        .item-desc {
            font-size: 0.9em;
            word-break: break-all;
        }

        .f-field-dropdownlist-pop-groupitem {
            padding-left: 20px !important;
        }
    </style>

}

@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="列表项分组" ShowHeader="true">
        <Items>
            <f:DropDownList ID="DropDownList1" EnableGroup="true" DataTextField="Name" DataValueField="Id" DataGroupField="Major">
            </f:DropDownList>
            <f:Button ID="btnGetSelection" Text="获取此下拉列表的选中项" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>将人员按专业分组显示，分组标题与可选择的人员项各有用途。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>按分组查找选项</h3>
        <ol>
            <li>
                展开列表，对照分组标题与标题下的人员选项。<br />
                结果：分组标题用于区分专业等类别；实际选中的仍是人员项，输入区显示人员名称。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableGroup</code>（<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>）：按数据分组显示列表项。 本页声明值为 <code>true</code>。</li>
            <li><code>DataGroupField</code>（<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>）：从指定数据字段取得分组标题。 本页声明值为 <code>Major</code>。</li>
        </ul>
    </section>
}
