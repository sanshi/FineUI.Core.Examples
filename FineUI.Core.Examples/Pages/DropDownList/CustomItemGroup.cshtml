@page
@model FineUI.Core.Examples.Pages.DropDownList.CustomItemGroupModel
@{
    ViewBag.Title = "DropDownList/CustomItemGroup";
    var F = Html.F();
}


@section head {

    <style>
        .item-text {
            margin-bottom: 5px;
            font-weight: bold;
        }

        .item-desc {
            font-size: 0.9em;
            word-break: break-all;
        }

        .f-field-dropdownlist-pop-groupitem {
            padding-left: 20px !important;
        }
    </style>

}

@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="列表项分组" ShowHeader="true">
        <Items>
            <f:DropDownList ID="DropDownList1" EnableGroup="true" DataTextField="Name" DataValueField="Id" DataGroupField="Major" DataSource="@DataSourceUtil.GetDataTable()">
            </f:DropDownList>
            <f:Button ID="btnGetSelection" Text="获取此下拉列表的选中项" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>

}

