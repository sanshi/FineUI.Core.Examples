@page
@model FineUI.Core.Examples.Pages.DropDownList.EnableEditModel
@{
    ViewBag.Title = "DropDownList/EnableEdit";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="下拉列表（可编辑，强制选择）" ShowHeader="true">
        <Items>
            <f:DropDownList ID="DropDownList1" EnableEdit="true">
                <f:ListItem Text="可选项1" Value="Value1" Selected="true" />
                <f:ListItem Text="可选项2（不可选择）" Value="Value2" EnableSelect="false" />
                <f:ListItem Text="可选项3（不可选择）" Value="Value3" EnableSelect="false" />
                <f:ListItem Text="可选项4" Value="Value4" />
                <f:ListItem Text="可选项5" Value="Value5" />
                <f:ListItem Text="可选项6" Value="Value6" />
                <f:ListItem Text="可选择项7" Value="Value7" />
                <f:ListItem Text="可选择项8" Value="Value8" />
                <f:ListItem Text="可选择项9" Value="Value9" />
                <f:ListItem Text="普通型1 < L > 1.5" Value="普通型1 < L > 1.5" />
            </f:DropDownList>
            <f:Button ID="btnSelectItem6" Text="选中[可选项6]" CssClass="marginr" OnClick="btnSelectItem6_Click"></f:Button>
            <f:Button ID="btnGetSelection" Text="获取此下拉列表的选中项" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>




}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>在下拉面板中单项选择，键入文字筛选并匹配已有项。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>输入筛选并匹配</h3>
        <ol>
            <li>
                在输入区清除原文字，输入<code>可选项5</code>，再确认匹配项。<br />
                结果：可匹配的第五项成为选择；列表外文字不能成为有效选项。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>的属性设置为<code>EnableEdit</code>=<code>true</code>（<code>ForceSelection</code>默认为<code>true</code>），可以在输入文本以过滤下拉项。 <br /> <br /> 测试用例（初始文本："可选项<code>1</code>"）：</p>
        <ul>
            <li> 依次删除："<code>1</code>项"；然后在页面上点击一下，使得文本框失去焦点；点击获取选中项按钮："选中项：可选项<code>1</code>（值：<code>Value1</code>）" </li>
            <li> 依次删除全部文本；然后在页面上点击一下，使得文本框失去焦点；点击获取选中项按钮："无选中项" </li>
            <li> 依次删除："<code>1</code>项"；然后再依次输入："项<code>5</code>"；按回车键；点击获取选中项按钮："选中项：可选项<code>5</code>（值：<code>Value5</code>）" </li>
            <li> 依次删除："<code>1</code>项"；然后再依次输入："项<code>5</code>"；然后在页面上点击一下，使得文本框失去焦点；点击获取选中项按钮："选中项：可选项<code>5</code>（值：<code>Value5</code>）" </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableEdit</code>（<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>）：允许直接在输入区键入筛选文本。 本页声明值为 <code>true</code>。</li>
        </ul>
    </section>
}
