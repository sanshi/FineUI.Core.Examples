@page
@model FineUI.Core.Examples.Pages.DropDownList.BeforeSelectEnableEditModel
@{
    ViewBag.Title = "DropDownList/BeforeSelectEnableEdit";
    var F = Html.F();
}



@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="下拉列表（确认对话框，可编辑，window.confirm）" ShowHeader="true">
        <Items>
            <f:DropDownList ID="DropDownList1" EnableEdit="true">
                <Items>
                    <f:ListItem Text="可选项1" Value="Value1" Selected="true" />
                    <f:ListItem Text="可选项2（不可选择）" Value="Value2" EnableSelect="false" />
                    <f:ListItem Text="可选项3（不可选择）" Value="Value3" EnableSelect="false" />
                    <f:ListItem Text="可选项4" Value="Value4" />
                    <f:ListItem Text="可选项5" Value="Value5" />
                    <f:ListItem Text="可选项6" Value="Value6" />
                    <f:ListItem Text="可选择项7" Value="Value7" />
                    <f:ListItem Text="可选择项8" Value="Value8" />
                    <f:ListItem Text="可选择项9" Value="Value9" />
                    <f:ListItem Text="普通型1 < L > 1.5" Value="普通型1 < L > 1.5" />
                </Items>
                <Listeners>
                    <f:Listener Event="beforeselect" Handler="onDropDownListBeforeSelect" />
                </Listeners>
            </f:DropDownList>

            <f:Button ID="btnSelectItem6" Text="选中[可选项6]" CssClass="marginr" OnClick="btnSelectItem6_Click"></f:Button>
            <f:Button ID="btnGetSelection" Text="获取此下拉列表的选中项" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>
    <br>
    <br>
    注：下拉列表的属性设置为EnableEdit=true（ForceSelection默认为true）。

}


@section script {

    <script>

        function onDropDownListBeforeSelect(event) {
            var ddl = this;

            if (!window.confirm('确定改变选中项？')) {

                // 如果用户手工输入值，则可能输入框中的值已经改变，需要还原
                ddl.hidePopEl();
                ddl.setValue(ddl.getValue());

                // 需要显式的返回 false，来阻止执行返回的脚本
                return false;
            }
        }

    </script>
}

