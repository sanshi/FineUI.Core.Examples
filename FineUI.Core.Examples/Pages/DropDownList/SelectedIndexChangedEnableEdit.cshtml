@page
@model FineUI.Core.Examples.Pages.DropDownList.SelectedIndexChangedEnableEditModel
@{
    ViewBag.Title = "DropDownList/SelectedIndexChangedEnableEdit";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="简单下拉列表（选中项改变事件，可编辑，强制选择）" ShowHeader="true">
        <Items>
            <f:DropDownList ID="DropDownList1" EnableEdit="true" OnSelectedIndexChanged="DropDownList1_SelectedIndexChanged">
                <f:ListItem Text="可选项1" Value="Value1" />
                <f:ListItem Text="可选项2（不可选择）" Value="Value2" EnableSelect="false" />
                <f:ListItem Text="可选项3（不可选择）" Value="Value3" EnableSelect="false" />
                <f:ListItem Text="可选项4" Value="Value4" />
                <f:ListItem Text="可选项5" Value="Value5" />
                <f:ListItem Text="可选项6" Value="Value6" />
                <f:ListItem Text="可选择项7" Value="Value7" />
                <f:ListItem Text="可选择项8" Value="Value8" />
                <f:ListItem Text="可选择项9" Value="Value9" />
                <f:ListItem Text="普通型1 < L > 1.5" Value="普通型1 < L > 1.5" />
            </f:DropDownList>

            <f:Button ID="btnSelectItem6" Text="选中[可选项6]" CssClass="marginr" OnClick="btnSelectItem6_Click"></f:Button>
            <f:Button ID="btnGetSelection" Text="获取此下拉列表的选中项" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>
    <br />
    <br />
    测试用例：
    <ul>
        <li>
            初始文本：可选项1；在文本输入框依次删除：1，项；<strong class="highlight">不会</strong>触发回发事件
        </li>
        <li>
            初始文本：可选项1；在文本输入框依次删除：1，项；然后在页面上点击一下，使得文本框失去焦点；显示文本：可选项1；<strong class="highlight">不会</strong>触发回发事件
        </li>
        <li>
            初始文本：可选项1；在文本输入框依次删除：1，项；然后再依次输入：项，5；按回车键；显示文本：可选项5；触发回发事件
        </li>
        <li>
            初始文本：可选项1；在文本输入框依次删除：1，项；然后再依次输入：项，5；然后在页面上点击一下，使得文本框失去焦点；显示文本：可选项5；触发回发事件
        </li>
        <li>
            初始文本：可选项1；点击触发图标，显示下拉列表；点击：可选项5；显示文本：可选项5；触发回发事件
        </li>
        <li>
            初始文本：可选项1；点击按钮：选中[可选项6]；显示文本：可选项6；<strong class="highlight">不会</strong>触发回发事件
        </li>
    </ul>



}

