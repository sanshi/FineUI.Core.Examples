@page
@model FineUI.Core.Examples.Pages.DropDownList.SelectedIndexChangedEnableEditNoForceSelectionModel
@{
    ViewBag.Title = "DropDownList/SelectedIndexChangedEnableEditNoForceSelection";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="简单下拉列表（选中项改变事件，可编辑，用户输入值）" ShowHeader="true">
        <Items>
            <f:DropDownList ID="DropDownList1" EnableEdit="true" ForceSelection="false" OnSelectedIndexChanged="DropDownList1_SelectedIndexChanged">
                <f:ListItem Text="可选项1" Value="Value1" />
                <f:ListItem Text="可选项2（不可选择）" Value="Value2" EnableSelect="false" />
                <f:ListItem Text="可选项3（不可选择）" Value="Value3" EnableSelect="false" />
                <f:ListItem Text="可选项4" Value="Value4" />
                <f:ListItem Text="可选项5" Value="Value5" />
                <f:ListItem Text="可选项6" Value="Value6" />
                <f:ListItem Text="可选择项7" Value="Value7" />
                <f:ListItem Text="可选择项8" Value="Value8" />
                <f:ListItem Text="可选择项9" Value="Value9" />
                <f:ListItem Text="普通型1 < L > 1.5" Value="普通型1 < L > 1.5" />
            </f:DropDownList>

            <f:Button ID="btnSelectItem6" Text="选中[可选项6]" CssClass="marginr" OnClick="btnSelectItem6_Click"></f:Button>
            <f:Button ID="btnGetSelection" Text="获取此下拉列表的选中项" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>







}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示自由输入确认或失焦时的选择变化回发。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-send" aria-hidden="true"></i>响应选择变化</h3>
        <ol>
            <li>
                在下拉面板改选另一项。<br />
                结果：选择变化后自动回发，后台用本次选择更新结果；无需再点获取按钮。
            </li>
            <li>
                从初始状态在输入区输入“自己的选项”，按 Enter 确认。<br />
                结果：后台变化事件显示本次提交的自定义文字，无需再点击获取按钮。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>测试用例：</p>
        <ul>
            <li> 初始文本：可选项1；在文本输入框依次删除：1，项；<strong>不会</strong>触发回发事件 </li>
            <li> 初始文本：可选项1；在文本输入框依次删除：1，项；然后在页面上点击一下，使得文本框失去焦点；显示文本：可选；触发回发事件（<strong>用户输入值：可选</strong>） </li>
            <li> 初始文本：可选项1；在文本输入框依次删除：1，项；然后再依次输入：项，5；按回车键；显示文本：可选项5；触发回发事件（<strong>选中项：可选项5（值：Value5）</strong>） </li>
            <li> 初始文本：可选项1；在文本输入框依次删除：1，项；然后再依次输入：项，5；然后在页面上点击一下，使得文本框失去焦点；显示文本：可选项5；触发回发事件（<strong>选中项：可选项5（值：Value5）</strong>） </li>
            <li> 初始文本：可选项1；点击触发图标，显示下拉列表；点击：可选项5；显示文本：可选项5；触发回发事件 </li>
            <li> 初始文本：可选项1；点击按钮：选中[可选项6]；显示文本：可选项6；<strong>不会</strong>触发回发事件 </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableEdit</code>：允许直接在输入区键入筛选文本。 本页声明值为 true。</li>
            <li><code>ForceSelection</code>：为 false 时允许保存列表之外的用户输入；为 true 时需要匹配现有选项。 本页声明值为 false。</li>
            <li><code>OnSelectedIndexChanged</code>：选择变化时处理当前值。 本页声明值为 DropDownList1_SelectedIndexChanged。</li>
        </ul>
    </section>
}
