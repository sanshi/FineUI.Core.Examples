@page
@model FineUI.Core.Examples.Pages.DropDownList.SelectedIndexChangedModel
@{
    ViewBag.Title = "DropDownList/SelectedIndexChanged";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="简单下拉列表（选中项改变事件）" ShowHeader="true">
        <Items>
            <f:DropDownList ID="DropDownList1" OnSelectedIndexChanged="DropDownList1_SelectedIndexChanged">
                <f:ListItem Text="可选项1" Value="Value1" />
                <f:ListItem Text="可选项2（不可选择）" Value="Value2" EnableSelect="false" />
                <f:ListItem Text="可选项3（不可选择）" Value="Value3" EnableSelect="false" />
                <f:ListItem Text="可选项4" Value="Value4" />
                <f:ListItem Text="可选项5" Value="Value5" />
                <f:ListItem Text="可选项6" Value="Value6" />
                <f:ListItem Text="可选择项7" Value="Value7" />
                <f:ListItem Text="可选择项8" Value="Value8" />
                <f:ListItem Text="可选择项9" Value="Value9" />
                <f:ListItem Text="普通型1 < L > 1.5" Value="普通型1 < L > 1.5" />
            </f:DropDownList>

            <f:Button ID="btnSelectItem6" Text="选中[可选项6]" CssClass="marginr" OnClick="btnSelectItem6_Click"></f:Button>
            <f:Button ID="btnGetSelection" Text="获取此下拉列表的选中项" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>




}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示通过回发处理选中项变化。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-send" aria-hidden="true"></i>响应选择变化</h3>
        <ol>
            <li>
                在下拉面板改选另一项。<br />
                结果：选择变化后自动回发，后台用本次选择更新结果；无需再点获取按钮。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>测试用例：</p>
        <ul>
            <li> 初始文本：可选项<code>1</code>；点击触发图标，显示<strong class="example-control-reference" data-example-control="DropDownList1"
                    title="下拉列表">下拉列表</strong>；点击：可选项<code>5</code>；显示文本：可选项<code>5</code>；触发回发事件 </li>
            <li> 初始文本：可选项<code>1</code>；点击按钮：<strong class="example-control-reference" data-example-control="btnSelectItem6"
                    title="选中[可选项6]">选中[可选项6]</strong>；显示文本：可选项<code>6</code>；<strong>不会</strong>触发回发事件 </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>OnSelectedIndexChanged</code>（<strong class="example-control-reference" data-example-control="DropDownList1"
                    title="下拉列表">下拉列表</strong>）：选择变化时处理当前值。 本页声明值为 <code>DropDownList1</code><code>_SelectedIndexChanged</code>。</li>
        </ul>
    </section>
}
