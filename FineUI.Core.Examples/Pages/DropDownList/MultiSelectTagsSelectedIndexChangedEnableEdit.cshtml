@page
@model FineUI.Core.Examples.Pages.DropDownList.MultiSelectTagsSelectedIndexChangedEnableEditModel
@{
    ViewBag.Title = "DropDownList/MultiSelectTagsSelectedIndexChangedEnableEdit";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="下拉列表（多选）" ShowHeader="true">
        <Items>
            <f:DropDownList ID="DropDownList1" EnableMultiSelect="true" EnableEdit="true" OnSelectedIndexChanged="DropDownList1_SelectedIndexChanged"
                MultiSelectMode="Tags">
                <f:ListItem Text="可选项1" Value="Value1" Selected="true" />
                <f:ListItem Text="可选项2（不可选择）" Value="Value2" EnableSelect="false" />
                <f:ListItem Text="可选项3（不可选择）" Value="Value3" EnableSelect="false" />
                <f:ListItem Text="可选项4" Value="Value4" Selected="true" />
                <f:ListItem Text="可选项5" Value="Value5" />
                <f:ListItem Text="可选项6" Value="Value6" />
                <f:ListItem Text="可选择项7" Value="Value7" />
                <f:ListItem Text="可选择项8" Value="Value8" />
                <f:ListItem Text="可选择项9" Value="Value9" />
                <f:ListItem Text="普通型1 < L > 1.5" Value="普通型1 < L > 1.5" />
            </f:DropDownList>

            <f:Button ID="btnSelectItem6" Text="选中[可选项6]" CssClass="marginr" OnClick="btnSelectItem6_Click"></f:Button>
            <f:Button ID="btnGetSelection" Text="获取此下拉列表的选中项" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>




}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示输入匹配并确认列表项时的选择变化回发。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-send" aria-hidden="true"></i>响应选择变化</h3>
        <ol>
            <li>
                在下拉面板增加或取消一项。<br />
                结果：选择变化后自动回发，后台用本次选择更新结果；无需再点获取按钮。
            </li>
            <li>
                从初始状态输入<code>可选项5</code>，等待筛选项出现后按 <code>Enter</code> 确认。<br />
                结果：后台变化事件显示新选中的可选项<code>5</code>，无需再点击获取按钮。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableEdit</code>（<strong class="example-control-reference" data-example-control="DropDownList1"
                    title="下拉列表">下拉列表</strong>）：允许直接在输入区键入筛选文本。 本页声明值为 <code>true</code>。</li>
            <li><code>OnSelectedIndexChanged</code>（<strong class="example-control-reference" data-example-control="DropDownList1"
                    title="下拉列表">下拉列表</strong>）：选择变化时处理当前值。 本页声明值为 <code>DropDownList1</code><code>_SelectedIndexChanged</code>。</li>
        </ul>
    </section>
}
