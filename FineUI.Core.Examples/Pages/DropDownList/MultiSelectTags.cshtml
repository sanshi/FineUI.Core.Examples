@page
@model FineUI.Core.Examples.Pages.DropDownList.MultiSelectTagsModel
@{
    ViewBag.Title = "DropDownList/MultiSelectTags";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="下拉列表（多选，初始为空）" ShowHeader="true">
        <Items>
            <f:DropDownList ID="DropDownList1" EnableMultiSelect="true" AutoSelectFirstItem="false" MultiSelectMode="Tags">
                <f:ListItem Text="可选项1" Value="Value1" />
                <f:ListItem Text="可选项2（不可选择）" Value="Value2" EnableSelect="false" />
                <f:ListItem Text="可选项3（不可选择）" Value="Value3" EnableSelect="false" />
                <f:ListItem Text="可选项4" Value="Value4" />
                <f:ListItem Text="可选项5" Value="Value5" />
                <f:ListItem Text="可选项6" Value="Value6" />
                <f:ListItem Text="可选择项7" Value="Value7" />
                <f:ListItem Text="可选择项8" Value="Value8" />
                <f:ListItem Text="可选择项9" Value="Value9" />
                <f:ListItem Text="普通型1 < L > 1.5" Value="普通型1 < L > 1.5" />
            </f:DropDownList>

            <f:Button ID="btnSelectItem6" Text="选中[可选项6]" CssClass="marginr" OnClick="btnSelectItem6_Click"></f:Button>
            <f:Button ID="btnGetSelection" Text="获取此下拉列表的选中项" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示把多个选中项显示为独立标签，并逐个移除。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>移除单个标签</h3>
        <ol>
            <li>
                先在下拉面板选择两个可用项，再点击其中一个标签右侧的关闭图标。<br />
                结果：仅移除这一项，对应下拉项取消选中；其它已选标签保留。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>MultiSelectMode</code>（<strong class="example-control-reference" data-example-control="DropDownList1"
                    title="下拉列表">下拉列表</strong>）：<code>Tags</code>/<code>tags</code> 将每个选中项显示为可移除标签。 本页声明值为 <code>Tags</code>。</li>
        </ul>
    </section>
}
