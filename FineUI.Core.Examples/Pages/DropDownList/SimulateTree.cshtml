@page
@model FineUI.Core.Examples.Pages.DropDownList.SimulateTreeModel
@{
    ViewBag.Title = "DropDownList/SimulateTree";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="模拟树的下拉列表" ShowHeader="true">
        <Items>
            <f:DropDownList Required="true" EnableSimulateTree="true" ShowRedStar="true" ID="DropDownList1">
            </f:DropDownList>

            <f:Button ID="btnGetSelection" Text="获取选中项" CssClass="marginr" OnClick="btnGetSelection_Click"></f:Button>
            <f:Button ID="btnDataBind" Text="重新绑定数据" CssClass="marginr" OnClick="btnDataBind_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>


}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>用缩进和前缀在普通下拉选项中表达层级，并读取所选节点的业务值。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>在缩进层级中选择</h3>
        <ol>
            <li>
                展开面板，对照各项前面的层级缩进，再选择<code>事件处理 - 2</code>。<br />
                结果：缩进用于表达层级，选中后显示该选项文字，值为 <code>11</code>。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableSimulateTree</code>（<strong class="example-control-reference" data-example-control="DropDownList1"
                    title="下拉列表">下拉列表</strong>）：用前缀缩进显示层级，数据仍是<strong class="example-control-reference" data-example-control="DropDownList1"
                    title="下拉列表">下拉列表</strong>选项。 本页声明值为 <code>true</code>。</li>
        </ul>
    </section>
}
