@page
@model FineUI.Core.Examples.Pages.DropDownList.NoForceSelectionInitValueModel
@{
    ViewBag.Title = "DropDownList/NoForceSelectionInitValue";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="下拉列表（用户输入值，初始值）" ShowHeader="true">
        <Items>
            <f:DropDownList ID="DropDownList1" EnableEdit="true" AutoSelectFirstItem="false" ForceSelection="false" Text="初始自定义值">
                <f:ListItem Text="可选项1" Value="Value1" />
                <f:ListItem Text="可选项2（不可选择）" Value="Value2" EnableSelect="false" />
                <f:ListItem Text="可选项3（不可选择）" Value="Value3" EnableSelect="false" />
                <f:ListItem Text="可选项4" Value="Value4" />
                <f:ListItem Text="可选项5" Value="Value5" />
                <f:ListItem Text="可选项6" Value="Value6" />
                <f:ListItem Text="可选择项7" Value="Value7" />
                <f:ListItem Text="可选择项8" Value="Value8" />
                <f:ListItem Text="可选择项9" Value="Value9" />
                <f:ListItem Text="普通型1 < L > 1.5" Value="普通型1 < L > 1.5" />
            </f:DropDownList>

            <f:Button ID="btnSelectItem6" Text="选中[可选项6]" CssClass="marginr" OnClick="btnSelectItem6_Click"></f:Button>
            <f:Button ID="btnSetText" Text="更新为[用户输入值]" CssClass="marginr" OnClick="btnSetText_Click"></f:Button>
            <f:Button ID="btnGetSelection" Text="获取此下拉列表的选中项" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>




}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示在初次加载时显示列表之外的自定义文字，以及真实选项与自定义初值的组合。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>核对自定义初始文字</h3>
        <ol>
            <li>
                打开页面后查看输入区。<br />
                结果：初始显示“初始自定义值”，可保留不在现有列表中的文字。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>设置自由输入文字</h3>
        <ol>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnSetText" title="更新为[用户输入值]">更新为[用户输入值]</strong>。<br />
                结果：回发后由后台把字段文字更新为“用户输入值”，后续获取可按自由输入读取。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p><strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>的属性设置为：</p>
        <ul>
            <li><code>AutoSelectFirstItem</code>="<code>false</code>"：初始不强制选中第一项</li>
            <li><code>EnableEdit</code>="<code>true</code>"：可以手工编辑</li>
            <li><code>ForceSelection</code>="<code>false</code>"：用户输入值</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ForceSelection</code>（<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>）：为
                <code>false</code> 时允许保存列表之外的用户输入；为 <code>true</code> 时需要匹配现有选项。 本页声明值为 <code>false</code>。
            </li>
            <li><code>Text</code>（<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>）：提供本页的初始显示文字。</li>
        </ul>
    </section>
}
