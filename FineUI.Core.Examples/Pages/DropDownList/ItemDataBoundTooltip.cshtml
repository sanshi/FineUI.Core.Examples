@page
@model FineUI.Core.Examples.Pages.DropDownList.ItemDataBoundTooltipModel
@{
    ViewBag.Title = "DropDownList/ItemDataBoundTooltip";
    var F = Html.F();
}

@section head {

    <style>
        .item-text {
            margin-bottom: 5px;
            font-weight: bold;
        }

        .item-desc {
            font-size: 0.9em;
            word-break: break-all;
        }
    </style>

}

@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="自定义列表项（列表项绑定事件）" ShowHeader="true">
        <Items>
            <f:DropDownList ID="DropDownList1" OnItemDataBound="DropDownList1_ItemDataBound">
            </f:DropDownList>
            <f:Button ID="btnGetSelection" Text="获取此下拉列表的选中项" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>为人员下拉项设置悬停提示，保持选中文字和业务值独立。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>查看数据项提示</h3>
        <ol>
            <li>
                展开面板，将鼠标移到“张萍萍”的选项上。<br />
                结果：显示包含该人员信息的悬停提示，选择值仍为 <code>101</code>。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：通过列表项绑定事件，可以动态设置每一项的属性（本例为每个列表项增加提示信息）。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>OnItemDataBound</code>（<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>）：数据项绑定时补充该选项的显示内容或悬停提示。 本页声明值为 <code>DropDownList1</code><code>_ItemDataBound</code>。</li>
        </ul>
    </section>
}
