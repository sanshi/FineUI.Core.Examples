@page
@model FineUI.Core.Examples.Pages.DropDownList.BeforeSelectConfirmModel
@{
    ViewBag.Title = "DropDownList/BeforeSelectConfirm";
    var F = Html.F();
}



@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="下拉列表（确认对话框，F.confirm）" ShowHeader="true">
        <Items>
            <f:DropDownList ID="DropDownList1">
                <Items>
                    <f:ListItem Text="可选项1" Value="Value1" Selected="true" />
                    <f:ListItem Text="可选项2（不可选择）" Value="Value2" EnableSelect="false" />
                    <f:ListItem Text="可选项3（不可选择）" Value="Value3" EnableSelect="false" />
                    <f:ListItem Text="可选项4" Value="Value4" />
                    <f:ListItem Text="可选项5" Value="Value5" />
                    <f:ListItem Text="可选项6" Value="Value6" />
                    <f:ListItem Text="可选择项7" Value="Value7" />
                    <f:ListItem Text="可选择项8" Value="Value8" />
                    <f:ListItem Text="可选择项9" Value="Value9" />
                    <f:ListItem Text="普通型1 < L > 1.5" Value="普通型1 < L > 1.5" />
                </Items>
                <Listeners>
                    <f:Listener Event="beforeselect" Handler="onDropDownListBeforeSelect" />
                </Listeners>
            </f:DropDownList>

            <f:Button ID="btnSelectItem6" Text="选中[可选项6]" CssClass="marginr" OnClick="btnSelectItem6_Click"></f:Button>
            <f:Button ID="btnGetSelection" Text="获取此下拉列表的选中项" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>

}


@section script {

    <script>

        function onDropDownListBeforeSelect(event, selectedValue) {
            // this代表当前下拉列表对象
            var ddl = this;

            // F.confirm是异步函数，直接返回
            F.confirm({
                message: '确定改变选中项？',
                ok: function () {
                    // 重新设置选中项
                    ddl.hidePopEl();
                    ddl.setValue(selectedValue);
                },
                cancel: function () {
                    // 啥也不做
                }
            });


            // 需要显式的返回 false，来阻止执行返回的脚本
            return false;
        }


    </script>
}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>通过异步 F.confirm确认后才改变选择，取消时保留原项。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>确认后才改变选择</h3>
        <ol>
            <li>
                展开下拉列表，点击“可选择项8”，在确认对话框中选择“取消”。<br />
                结果：此次选择被撤销，输入区继续显示原来的选择。
            </li>
            <li>
                再次选择“可选择项8”，在确认对话框中选择“确定”。<br />
                结果：确认后选中该项，值为 Value8；本页异步确认完成后才继续选中操作。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>beforeselect</code>：改变选择前执行；取消时返回 false。异步 F.confirm 的回调中再完成确认后的选择。</li>
        </ul>
    </section>
}
