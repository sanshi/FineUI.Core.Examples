@page
@model FineUI.Core.Examples.Pages.DropDownList.CustomItemDataDisplayFieldsModel
@{
    ViewBag.Title = "DropDownList/CustomItemDataDisplayFields";
    var F = Html.F();
}

@section head {

    <style>
        .item-text {
            margin-bottom: 5px;
            font-weight: bold;
        }

        .item-desc {
            font-size: 0.9em;
            word-break: break-all;
        }
    </style>

}

@section body {

    @{
        var DDL_DISPLAY_TEMPLATE = "<div class=\"item-text\">{0}</div><div class=\"item-desc\">{1}</div>";
    }

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="自定义列表项（DataDisplayFields）" ShowHeader="true">
        <Items>
            <f:DropDownList ID="DropDownList1" DataTextField="Name" DataValueField="Id" _DataDisplayFields="Name,Desc" DataDisplayFormatString="@DDL_DISPLAY_TEMPLATE" DataSource="@DataSourceUtil.GetDataTable()">
            </f:DropDownList>
            <f:Button ID="btnGetSelection" Text="获取此下拉列表的选中项" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>

}
