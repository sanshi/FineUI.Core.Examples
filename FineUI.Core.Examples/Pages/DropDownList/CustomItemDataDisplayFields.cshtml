@page
@model FineUI.Core.Examples.Pages.DropDownList.CustomItemDataDisplayFieldsModel
@{
    ViewBag.Title = "DropDownList/CustomItemDataDisplayFields";
    var F = Html.F();
}

@section head {

    <style>
        .item-text {
            margin-bottom: 5px;
            font-weight: bold;
        }

        .item-desc {
            font-size: 0.9em;
            word-break: break-all;
        }
    </style>

}

@section body {

    @{
        var DDL_DISPLAY_TEMPLATE = "<div class=\"item-text\">{0}</div><div class=\"item-desc\">{1}</div>";
    }

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="自定义列表项（DataDisplayFields）" ShowHeader="true">
        <Items>
            <f:DropDownList ID="DropDownList1" DataTextField="Name" DataValueField="Id" _DataDisplayFields="Name,Desc" DataDisplayFormatString="@DDL_DISPLAY_TEMPLATE">
            </f:DropDownList>
            <f:Button ID="btnGetSelection" Text="获取此下拉列表的选中项" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>用模板或逐项处理自定义人员选项外观，选中后只显示姓名并提交人员标识。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>区分选项模板和选中文字</h3>
        <ol>
            <li>
                展开面板选择“张萍萍”这一项。<br />
                结果：面板可同时显示姓名、描述等模板内容；选中后输入区使用姓名，业务值为 101。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>_DataDisplayFields</code>：把额外数据字段提供给选项显示模板。 本页声明值为 Name,Desc。</li>
            <li><code>DataDisplayFormatString</code>：自定义下拉面板内选项的显示内容。</li>
            <li><code>DataTextField</code>：从指定字段取得选中后显示的文字。 本页声明值为 Name。</li>
        </ul>
    </section>
}
