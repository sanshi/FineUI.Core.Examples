@page
@model FineUI.Core.Examples.Pages.DropDownList.NoForceSelectionEmptyModel
@{
    ViewBag.Title = "DropDownList/NoForceSelectionEmpty";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="下拉列表（用户输入值，初始值，下拉选项为空）" ShowHeader="true">
        <Items>
            <f:DropDownList ID="DropDownList1" EnableEdit="true" AutoSelectFirstItem="false" ForceSelection="false" Text="初始自定义值">
            </f:DropDownList>

            <f:Button ID="btnRebindData" Text="重新绑定数据" CssClass="marginr" OnClick="btnRebindData_Click"></f:Button>
            <f:Button ID="btnSetText" Text="更新为[用户输入值]" CssClass="marginr" OnClick="btnSetText_Click"></f:Button>
            <f:Button ID="btnGetSelection" Text="获取此下拉列表的选中项" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>




}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示列表没有选项时仍可显示自定义初始文字，并在填充或清空选项后核对状态。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>核对自定义初始文字</h3>
        <ol>
            <li>
                打开页面后查看输入区。<br />
                结果：初始显示“初始自定义值”，可保留不在现有列表中的文字。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>填充选项后选择并读取</h3>
        <ol>
            <li>
                从刚打开、下拉选项为空的状态开始，点击<strong class="example-control-reference" data-example-control="btnRebindData" title="重新绑定数据">重新绑定数据</strong>，再展开列表。<br />
                结果：后台绑定可选项<code>1</code>至可选择项<code>9</code>，原本为空的列表可以选择。
            </li>
            <li>
                选择<code>可选项6</code>。<br />
                结果：输入区显示“可选项<code>6</code>”，当前值来自列表选项。
            </li>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnGetSelection" title="获取此下拉列表的选中项">获取此下拉列表的选中项</strong>。<br />
                结果：回发后由后台显示当前文字和选中值；后台读取本次选择。
            </li>
            <li>
                再次点击<strong class="example-control-reference" data-example-control="btnRebindData" title="重新绑定数据">重新绑定数据</strong>，再展开列表。<br />
                结果：后台清空全部选项；再次点击同一按钮可重新填充。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p><strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>的属性设置为：</p>
        <ul>
            <li><code>AutoSelectFirstItem</code>="<code>false</code>"：初始不强制选中第一项</li>
            <li><code>EnableEdit</code>="<code>true</code>"：可以手工编辑</li>
            <li><code>ForceSelection</code>="<code>false</code>"：用户输入值</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Text</code>（<strong class="example-control-reference" data-example-control="DropDownList1"
                    title="下拉列表">下拉列表</strong>）：初始没有绑定列表项，仍可直接提供显示文字；文字不要求来自当前列表。</li>
        </ul>
    </section>
}
