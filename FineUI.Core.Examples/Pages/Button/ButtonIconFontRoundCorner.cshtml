@page
@model FineUI.Core.Examples.Pages.Button.ButtonIconFontRoundCornerModel

@{
    ViewBag.Title = "Button/ButtonIconFontRoundCorner";
}

@section body {

    <f:Button ID="btnIcon1" EnableRoundCorner="true" Text="图标在左侧" IconFont="_Home" CssClass="marginr" />
    <f:Button ID="btnIcon2" EnableRoundCorner="true" Text="图标在右侧" IconAlign="Right" IconFont="_Car" />
    <br />
    <br />
    <f:Button ID="btnIcon3" EnableRoundCorner="true" Text="图标在上面" IconAlign="Top" IconFont="_Camera" CssClass="marginr" />
    <f:Button ID="btnIcon4" EnableRoundCorner="true" Text="图标在下面" IconAlign="Bottom" IconFont="_Phone" />
    <br />
    <br />
    <f:Button ID="btnCustomIconFont" EnableRoundCorner="true" Text="点击修改图标（在三个图标之前切换）" IconFont="_VolumeUp" OnClick="btnCustomIconFont_Click" />
    <br />
    <br />
        只有图片的按钮：
    <br />
    <br />
    <f:Button ID="Button1" Size="Small" EnableRoundCorner="true" IconFont="_Android" CssClass="marginr" />
    <f:Button ID="Button2" Size="Normal" EnableRoundCorner="true" IconFont="_Apple" CssClass="marginr" />
    <f:Button ID="Button7" Size="Medium" EnableRoundCorner="true" IconFont="_Car" CssClass="marginr" />
    <f:Button ID="Button8" Size="Large" EnableRoundCorner="true" IconFont="_Card" CssClass="marginr" />
    <br />
    <br />

}
