@page
@model FineUI.Core.Examples.Pages.Button.ButtonMenuModel
@{
    ViewBag.Title = "Button/ButtonMenu";
    var F = Html.F();
}

@section body {


    <f:Button ID="btnMenu" Text="中国科学技术大学" IconFont="_Bicycle">
        <Menu>
            <f:MenuHyperLink ID="MenuHyperLink3" Icon="TagGreen" Target="_blank" NavigateUrl="http://scms.ustc.edu.cn/" Text="化学与材料科学学院">
            </f:MenuHyperLink>
            <f:MenuButton ID="MenuButton1" Icon="TagBlue" Text="管理学院">
                <Menu>
                    <f:MenuHyperLink ID="MenuHyperLink1" Icon="TagPink" Target="_blank" NavigateUrl="http://is.ustc.edu.cn/" Text="工商管理系">
                    </f:MenuHyperLink>
                    <f:MenuHyperLink ID="MenuHyperLink2" Icon="TagPurple" Target="_blank" NavigateUrl="http://stat.ustc.edu.cn/" Text="统计与金融系">
                    </f:MenuHyperLink>
                </Menu>
            </f:MenuButton>
        </Menu>
    </f:Button>


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示按钮展开多级菜单。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>展开和浏览子菜单</h3>
        <ol>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnMenu" title="中国科学技术大学">中国科学技术大学</strong>按钮。<br />
                结果：显示“化学与材料科学学院”和<strong class="example-control-reference" data-example-control="MenuButton1" title="管理学院">管理学院</strong>等菜单项。
            </li>
            <li>
                将鼠标移到<strong class="example-control-reference" data-example-control="MenuButton1" title="管理学院">管理学院</strong>。<br />
                结果：显示“工商管理系”“统计与金融系”子菜单；这些链接配置为在新标签页打开各自地址。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Menu</code>（<strong class="example-control-reference" data-example-control="btnMenu" title="中国科学技术大学">中国科学技术大学</strong>）：按钮中的 <code>Menu</code> 声明一级及多级子菜单。</li>
            <li><code>NavigateUrl</code>（<strong class="example-control-reference" data-example-control="MenuHyperLink3" title="第 1 个MenuHyperLink">第 1 个MenuHyperLink</strong>、<strong class="example-control-reference" data-example-control="MenuHyperLink1" title="第 2 个MenuHyperLink">第 2 个MenuHyperLink</strong>、<strong class="example-control-reference" data-example-control="MenuHyperLink2" title="第 3 个MenuHyperLink">第 3 个MenuHyperLink</strong>）：链接菜单项指向实际页面地址。</li>
            <li><code>Target</code>（<strong class="example-control-reference" data-example-control="MenuHyperLink3" title="第 1 个MenuHyperLink">第 1 个MenuHyperLink</strong>、<strong class="example-control-reference" data-example-control="MenuHyperLink1" title="第 2 个MenuHyperLink">第 2 个MenuHyperLink</strong>、<strong class="example-control-reference" data-example-control="MenuHyperLink2" title="第 3 个MenuHyperLink">第 3 个MenuHyperLink</strong>）：本页链接设置为 <code>_blank</code>，使用新的浏览器标签页。</li>
        </ul>
    </section>
}
