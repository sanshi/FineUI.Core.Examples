@page
@model FineUI.Core.Examples.Pages.Button.ButtonModel
@{
    ViewBag.Title = "Button/Button";
    var F = Html.F();
}

@section body {

    <f:Button Text="缺省按钮" CssClass="marginr" />
    <f:Button ID="btnPrimary" Text="主按钮" ButtonColor="Primary" CssClass="marginr" />
    <f:Button ID="btnSuccess" Text="成功按钮" ButtonColor="Success" CssClass="marginr" />
    <f:Button ID="btnDanger" Text="危险按钮" ButtonColor="Danger" CssClass="marginr" />
    <f:Button ID="btnWarning" Text="警告按钮" ButtonColor="Warning" CssClass="marginr" />
    <f:Button ID="btnInfo" Text="信息按钮" ButtonColor="Info" />
    <br />
    <br />
    <f:Button ID="btnChangeEnable" Text="启用后面的按钮" OnClick="btnChangeEnable_Click" CssClass="marginr" />
    <f:Button ID="btnEnable" Text="禁用的按钮" OnClick="btnEnable_Click" Enabled="false" />
    <br />
    <br />
    <f:Button ID="btnChangePressed" Text="改变后面按钮的按下状态" OnClick="btnChangePressed_Click" CssClass="marginr" />
    <f:Button ID="btnPressed" Text="按下的按钮" EnablePress="true" Pressed="true" />
    <br />
    <br />
    <f:Button ID="btnTooltip" Text="这个按钮有提示信息（点击改变提示信息）" ToolTip="这是按钮的提示信息" OnClick="btnTooltip_Click" />
    <br />
    <br />
    <br />
    <f:Button ID="Button4" Text="小按钮" Size="Small" CssClass="marginr" />
    <f:Button ID="Button1" Text="普通按钮" CssClass="marginr" />
    <f:Button ID="Button2" Text="中等按钮" Size="Medium" CssClass="marginr" />
    <f:Button ID="Button3" Text="大按钮" Size="Large" />

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示按钮的颜色、大小、可用状态、按下状态和悬停提示。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>启用后再点击</h3>
        <ol>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnChangeEnable" title="启用后面的按钮">启用后面的按钮</strong>。<br />
                结果：回发后，后台启用原先<strong class="example-control-reference" data-example-control="btnEnable" title="禁用的按钮">禁用的按钮</strong>，并修改其文字。
            </li>
            <li>
                点击刚启用的按钮。<br />
                结果：回发后，后台显示“你点击了刚刚启用的按钮”的提示。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>切换按下状态和提示</h3>
        <ul>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnChangePressed" title="改变后面按钮的按下状态">改变后面按钮的按下状态</strong>。<br />
                结果：回发后，后台反转后一个按钮的按下外观，再次点击可恢复。
            </li>
            <li>
                将鼠标停在<strong class="example-control-reference" data-example-control="btnTooltip" title="这个按钮有提示信息（点击改变提示信息）">这个按钮有提示信息（点击改变提示信息）</strong>上，点击后再悬停。<br />
                结果：先显示初始提示，再显示修改后的提示内容；页面还可对照不同颜色和尺寸按钮。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ButtonColor</code>（<strong class="example-control-reference" data-example-control="btnPrimary" title="主按钮">主按钮</strong>、<strong class="example-control-reference" data-example-control="btnSuccess" title="成功按钮">成功按钮</strong>、<strong class="example-control-reference" data-example-control="btnDanger" title="危险按钮">危险按钮</strong>、<strong class="example-control-reference" data-example-control="btnWarning" title="警告按钮">警告按钮</strong>、<strong class="example-control-reference" data-example-control="btnInfo" title="信息按钮">信息按钮</strong>）：选择主、成功、危险、警告、信息等主题颜色。</li>
            <li><code>Size</code>（<strong class="example-control-reference" data-example-control="Button4" title="小按钮">小按钮</strong>、<strong class="example-control-reference" data-example-control="Button2" title="中等按钮">中等按钮</strong>、<strong class="example-control-reference" data-example-control="Button3" title="大按钮">大按钮</strong>）：控制按钮尺寸，同页对照多种大小。</li>
            <li><code>Enabled</code>（<strong class="example-control-reference" data-example-control="btnEnable" title="禁用的按钮">禁用的按钮</strong>）：初始为 <code>false</code> 的按钮不能点击，后台可改为 <code>true</code>。</li>
            <li><code>Pressed</code>（<strong class="example-control-reference" data-example-control="btnPressed" title="按下的按钮">按下的按钮</strong>）：表示持续按下的外观，切换后按钮文字保持不变。</li>
            <li><code>ToolTip</code>（<strong class="example-control-reference" data-example-control="btnTooltip" title="这个按钮有提示信息（点击改变提示信息）">这个按钮有提示信息（点击改变提示信息）</strong>）：鼠标悬停显示的提示文字，可在点击后更新。</li>
        </ul>
    </section>
}
