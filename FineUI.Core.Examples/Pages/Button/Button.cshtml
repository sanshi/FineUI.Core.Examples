@page
@model FineUI.Core.Examples.Pages.Button.ButtonModel
@{
    ViewBag.Title = "Button/Button";
    var F = Html.F();
}

@section body {

    <f:Button Text="缺省按钮" CssClass="marginr" />
    <f:Button ID="btnPrimary" Text="主按钮" ButtonColor="Primary" CssClass="marginr" />
    <f:Button ID="btnSuccess" Text="成功按钮" ButtonColor="Success" CssClass="marginr" />
    <f:Button ID="btnDanger" Text="危险按钮" ButtonColor="Danger" CssClass="marginr" />
    <f:Button ID="btnWarning" Text="警告按钮" ButtonColor="Warning" CssClass="marginr" />
    <f:Button ID="btnInfo" Text="信息按钮" ButtonColor="Info" />
    <br />
    <br />
    <f:Button ID="btnChangeEnable" Text="启用后面的按钮" OnClick="btnChangeEnable_Click" CssClass="marginr" />
    <f:Button ID="btnEnable" Text="禁用的按钮" OnClick="btnEnable_Click" Enabled="false" />
    <br />
    <br />
    <f:Button ID="btnChangePressed" Text="改变后面按钮的按下状态" OnClick="btnChangePressed_Click" CssClass="marginr" />
    <f:Button ID="btnPressed" Text="按下的按钮" EnablePress="true" Pressed="true" />
    <br />
    <br />
    <f:Button ID="btnTooltip" Text="这个按钮有提示信息（点击改变提示信息）" ToolTip="这是按钮的提示信息" OnClick="btnTooltip_Click" />
    <br />
    <br />
    <br />
    <f:Button ID="Button4" Text="小按钮" Size="Small" CssClass="marginr" />
    <f:Button ID="Button1" Text="普通按钮" CssClass="marginr" />
    <f:Button ID="Button2" Text="中等按钮" Size="Medium" CssClass="marginr" />
    <f:Button ID="Button3" Text="大按钮" Size="Large" />

}
