@page
@model FineUI.Core.Examples.Pages.Button.ButtonGroupModel
@{
    ViewBag.Title = "Button/ButtonGroup";
    var F = Html.F();
}

@section body {

    <f:ButtonGroup>
        <f:Button ID="btnIcon1" Text="图标在左侧" Icon="Email" />
        <f:Button ID="btnIcon2" Text="图标在右侧" IconAlign="Right" Icon="Star" />
        <f:Button ID="Button7" Text="图标在左侧" IconFont="_Home" />
        <f:Button ID="Button8" Text="图标在右侧" IconAlign="Right" IconFont="_Car" />
    </f:ButtonGroup>
    <br />
    <f:ButtonGroup ID="ButtonGroup1">
        <f:Button ID="btnIcon3" Text="图标在上面" IconAlign="Top" Icon="Email" />
        <f:Button ID="btnIcon4" Text="图标在下面" IconAlign="Bottom" Icon="Star" />
        <f:Button ID="Button9" Text="图标在上面" IconAlign="Top" IconFont="_Camera" />
        <f:Button ID="Button10" Text="图标在下面" IconAlign="Bottom" IconFont="_Phone" />
    </f:ButtonGroup>
    <br />
    <f:Label Text="只有图片的按钮："></f:Label>
    <f:ButtonGroup ID="ButtonGroup2">
        <f:Button ID="Button1" IconUrl="~/res/images/16/1.png" />
        <f:Button ID="Button2" IconUrl="~/res/images/16/8.png" />
        <f:Button ID="Button11" IconFont="_Android" />
        <f:Button ID="Button12" IconFont="_Apple" />
        <f:Button ID="Button13" IconFont="_Car" />
        <f:Button ID="Button14" IconFont="_Card" />
    </f:ButtonGroup>
    <br />
    <f:Label Text="Size（Large）："></f:Label>
    <f:ButtonGroup ID="ButtonGroup3">
        <f:Button ID="Button3" Text="图标在上面" Size="Large" IconAlign="Top" Icon="Email" />
        <f:Button ID="Button4" Text="图标在下面" Size="Large" IconAlign="Bottom" Icon="Star" />
        <f:Button ID="Button5" Text="图标在上面" Size="Large" IconAlign="Top" IconFont="_Camera" />
        <f:Button ID="Button6" Text="图标在下面" Size="Large" IconAlign="Bottom" IconFont="_Phone" />
    </f:ButtonGroup>

}

