@page
@model FineUI.Core.Examples.Pages.Button.ButtonGroupLayoutModel
@{
    ViewBag.Title = "Button/ButtonGroupLayout";
    var F = Html.F();
}

@section body {

    <f:Panel ID="Panel1" Margin="24" ShowBorder="false" ShowHeader="false" CssClass="f-widget-content" AutoScroll="true" Layout="VBox" BoxConfigAlign="Start"
        BoxConfigSpace="10" BodyPadding="10" IsViewPort="true">
        <Items>
            <f:ButtonGroup ID="ButtonGroupExample1" Layout="HBox" Width="600">
                <f:Button ID="btnIcon1" Text="图标在左侧" BoxFlex="1" Icon="Email" />
                <f:Button ID="btnIcon2" Text="图标在右侧" BoxFlex="1" IconAlign="Right" Icon="Star" />
                <f:Button ID="Button7" Text="图标在左侧" BoxFlex="1" IconFont="_Home" />
                <f:Button ID="Button8" Text="图标在右侧" BoxFlex="1" IconAlign="Right" IconFont="_Car" />
            </f:ButtonGroup>
            <f:ButtonGroup Layout="HBox" Width="600">
                <f:Button ID="btnIcon3" Text="图标在上面" BoxFlex="1" IconAlign="Top" Icon="Email" />
                <f:Button ID="btnIcon4" Text="图标在下面" BoxFlex="1" IconAlign="Bottom" Icon="Star" />
                <f:Button ID="Button9" Text="图标在上面" BoxFlex="1" IconAlign="Top" IconFont="_Camera" />
                <f:Button ID="Button10" Text="图标在下面" BoxFlex="1" IconAlign="Bottom" IconFont="_Phone" />
            </f:ButtonGroup>
            <f:ButtonGroup Layout="VBox" Vertical="true" Width="200" MarginTop="50">
                <f:Button ID="Button1" Text="图标在左侧" Icon="Email" />
                <f:Button ID="Button2" Text="图标在右侧" IconAlign="Right" Icon="Star" />
                <f:Button ID="Button3" Text="图标在左侧" IconFont="_Home" />
                <f:Button ID="Button4" Text="图标在右侧" IconAlign="Right" IconFont="_Car" />
            </f:ButtonGroup>
            <f:ButtonGroup Layout="VBox" Vertical="true" Width="200">
                <f:Button ID="Button5" Text="图标在上面" IconAlign="Top" Icon="Email" />
                <f:Button ID="Button6" Text="图标在下面" IconAlign="Bottom" Icon="Star" />
                <f:Button ID="Button11" Text="图标在上面" IconAlign="Top" IconFont="_Camera" />
                <f:Button ID="Button12" Text="图标在下面" IconAlign="Bottom" IconFont="_Phone" />
            </f:ButtonGroup>
        </Items>
    </f:Panel>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示按 <code>HBox</code> 和 <code>VBox</code> 布局排列的按钮分组，组合图片、字体图标和不同尺寸按钮。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对比分组排列</h3>
        <ul>
            <li>
                对照各组的文字图标按钮、只有图标的按钮和大按钮。<br />
                结果：上方按钮按横向布局等分组宽，下方按钮按纵向布局逐行排列；组内仍可使用不同图标方向。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Layout</code>（本页全部按钮组，如<strong class="example-control-reference" data-example-control="ButtonGroupExample1" title="第 1 个按钮组">第 1
                    个按钮组</strong>）：横向组使用 <code>HBox</code>，纵向组使用 <code>VBox</code>。</li>
            <li><code>BoxFlex</code>（<strong class="example-control-reference" data-example-control="btnIcon1" title="第 1 个按钮（图标在左侧）">第 1
                    个按钮（图标在左侧）</strong>、<strong class="example-control-reference" data-example-control="btnIcon2" title="第 2 个按钮（图标在右侧）">第 2
                    个按钮（图标在右侧）</strong>、<strong class="example-control-reference" data-example-control="Button7" title="第 3 个按钮（图标在左侧）">第 3
                    个按钮（图标在左侧）</strong>、<strong class="example-control-reference" data-example-control="Button8" title="第 4 个按钮（图标在右侧）">第 4
                    个按钮（图标在右侧）</strong>、<strong class="example-control-reference" data-example-control="btnIcon3" title="第 5 个按钮（图标在上面）">第 5
                    个按钮（图标在上面）</strong>、<strong class="example-control-reference" data-example-control="btnIcon4" title="第 6 个按钮（图标在下面）">第 6
                    个按钮（图标在下面）</strong>、<strong class="example-control-reference" data-example-control="Button9" title="第 7 个按钮（图标在上面）">第 7
                    个按钮（图标在上面）</strong>、<strong class="example-control-reference" data-example-control="Button10" title="第 8 个按钮（图标在下面）">第 8
                    个按钮（图标在下面）</strong>）：横向组的按钮设为 <code>1</code>，等分组内可用宽度。</li>
        </ul>
    </section>
}
