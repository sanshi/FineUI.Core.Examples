@page
@model FineUI.Core.Examples.Pages.Button.LinkButtonModel
@{
    ViewBag.Title = "Button/LinkButton";
    var F = Html.F();
}

@section body {
    <f:LinkButton ID="LinkButton2" Text="客户端事件" ClickHandler="onClientEventClick">
    </f:LinkButton>
    <br />
    <f:LinkButton ID="LinkButton3" Text="服务器端事件" OnClick="LinkButton3_Click">
    </f:LinkButton>
    <br />
    <br />
    <f:LinkButton ID="LinkButton1" Enabled="false" Text="客户端事件（初始禁用）" ClickHandler="onLinkButtonClick">
    </f:LinkButton>
    <br />
    <f:Button ID="btnChangeEnable" Text="启用/禁用最后一个链接按钮" OnClick="btnChangeEnable_Click" />

}

@section script {
    <script>
        function onLinkButtonClick(event) {
            top.F.alert("这是初始禁用的链接按钮的客户端事件！");
        }

        function onClientEventClick(event) {
            F.alert({ message: '这是客户端事件', messageIcon: 'information', target: '_top' });
        }
    </script>
}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示链接外观的按钮如何触发客户端或后台动作，以及禁用后阻止点击。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-link" aria-hidden="true"></i>客户端与后台点击</h3>
        <ul>
            <li>
                点击<strong class="example-control-reference" data-example-control="LinkButton2" title="客户端事件">客户端事件</strong>。<br />
                结果：浏览器弹出客户端提示，无需回发。
            </li>
            <li>
                关闭提示后点击<strong class="example-control-reference" data-example-control="LinkButton3" title="服务器端事件">服务器端事件</strong>。<br />
                结果：请求交给后台处理，页面显示<strong class="example-control-reference" data-example-control="LinkButton3" title="服务器端事件">服务器端事件</strong>提示。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>启用原先禁用的链接</h3>
        <ol>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnChangeEnable" title="启用/禁用最后一个链接按钮">启用/禁用最后一个链接按钮</strong>。<br />
                结果：后台反转最后一个链接按钮的可用状态。
            </li>
            <li>
                启用后点击<strong class="example-control-reference" data-example-control="LinkButton1" title="客户端事件（初始禁用）">客户端事件（初始禁用）</strong>。<br />
                结果：浏览器执行它的客户端提示；再次禁用后不能触发。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ClickHandler</code>（<strong class="example-control-reference" data-example-control="LinkButton2" title="客户端事件">客户端事件</strong>、<strong
                    class="example-control-reference" data-example-control="LinkButton1" title="客户端事件（初始禁用）">客户端事件（初始禁用）</strong>）：绑定客户端动作函数。</li>
            <li><code>OnClick</code>（<strong class="example-control-reference" data-example-control="LinkButton3" title="服务器端事件">服务器端事件</strong>）：绑定后台处理方法。</li>
            <li><code>Enabled</code>（<strong class="example-control-reference" data-example-control="LinkButton1" title="客户端事件（初始禁用）">客户端事件（初始禁用）</strong>）：为
                <code>false</code> 时不可点击，后台更新后恢复。
            </li>
        </ul>
    </section>
}
