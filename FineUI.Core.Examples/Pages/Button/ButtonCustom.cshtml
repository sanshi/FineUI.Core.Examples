@page
@model FineUI.Core.Examples.Pages.Button.ButtonCustomModel
@{
    ViewBag.Title = "Button/ButtonCustom";
    var F = Html.F();
}

@section head {

    <style>
        .bgbtn {
            background-image: url(@Url.Content("~/res/images/login.png")) !important;
            width: 320px;
            height: 50px;
            border-width: 0 !important;
            background-color: transparent !important;
        }
    </style>

}

@section body {

    <f:Button ID="Button1" Text="普通按钮" Size="Large" OnClick="Button1_Click" />
    <br />
    <br />

    <f:Button ID="Button2" Text="" CssClass="bgbtn" OnClick="Button2_Click" />

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示用自定义 CSS 和背景图片改变按钮外观，同时保留点击处理。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>点击两种外观的按钮</h3>
        <ul>
            <li>
                点击<strong class="example-control-reference" data-example-control="Button1" title="普通按钮">普通按钮</strong>。<br />
                结果：回发后，后台显示“点击了普通按钮”。
            </li>
            <li>
                关闭提示后点击旁边的图片按钮。<br />
                结果：回发后，后台显示“点击了自定义按钮”，说明自定义外观仍使用按钮事件。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>CssClass</code>（<strong class="example-control-reference" data-example-control="Button2" title="第 2 个按钮">第 2
                    个按钮</strong>）：<code>bgbtn</code> 样式类提供自定义按钮背景和尺寸。</li>
        </ul>
    </section>
}
