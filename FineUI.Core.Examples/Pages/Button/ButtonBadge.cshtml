@page
@model FineUI.Core.Examples.Pages.Button.ButtonBadgeModel

@{
    ViewBag.Title = "Button/ButtonBadge";
    var F = Html.F();
}

@section head {

    <style>
        .marginr {
            margin-right: 20px;
        }

        .custom-badge-color .f-badge {
            background-color: #2d8cf0;
        }
    </style>
}


@section body {

    <f:Button ID="btnIcon1" Text="图标在左侧" Icon="Email"
              CssClass="marginr" Badge="true" />
    <f:Button ID="btnIcon2" Text="图标在右侧" IconAlign="Right" Icon="Star"
              CssClass="marginr" Badge="true" BadgeType="Error" BadgeAnimationType="Processing" />
    <br />
    <br />
    <f:Button ID="btnIcon3" Text="图标在上面" IconAlign="Top" Icon="Email"
              CssClass="marginr" Badge="true" BadgeType="Warning" />
    <f:Button ID="btnIcon4" Text="图标在下面" IconAlign="Bottom" Icon="Star"
              CssClass="marginr" Badge="true" BadgeType="Success" BadgeAnimationType="Fade" />
    <br />
    <br />
    <f:Button ID="btnCustomIcon" Text="自定义图标（点击修改图标）" IconUrl="~/res/images/16/1.png" CssClass="marginr" Badge="true" OnClick="btnCustomIcon_Click" />
    <br />
    <br />
        只有图片的按钮：
    <br />
    <br />
    <f:Button ID="Button1" IconUrl="~/res/images/16/1.png"
              CssClass="marginr" Badge="true" BadgeText="3" />
    <f:Button ID="btnBadgeNumber" IconUrl="~/res/images/16/8.png"
              CssClass="marginr" Badge="true" BadgeText="10" BadgeType="Success" />
    <br />
    <br />
    <f:Button ID="btnChangeBadge" Text="徽标数字加一" OnClick="btnChangeBadge_Click" />

    <br />
    <br />
        大按钮：
    <br />
    <br />
    <f:Button ID="Button3" Size="Large" Text="图标在左侧" Icon="Email"
              CssClass="marginr custom-badge-color" Badge="true" BadgeText="new" />
    <f:Button ID="Button4" Size="Large" Text="图标在右侧" IconAlign="Right" Icon="Star"
              CssClass="marginr" Badge="true" BadgeText="hot" BadgeType="Error" BadgeAnimationType="Move" />
    <br />
    <br />
    <f:Button ID="Button5" Size="Large" Text="图标在上面" IconAlign="Top" Icon="Email"
              CssClass="marginr" Badge="true" BadgeText="88+" BadgeType="Warning" BadgeAnimationType="Processing" />
    <f:Button ID="Button6" Size="Large" Text="图标在下面" IconAlign="Bottom" Icon="Email"
              CssClass="marginr" Badge="true" BadgeText="999+" BadgeType="Success" BadgeAnimationType="Shake" />
    <br />
    <br />
}





