@page
@model FineUI.Core.Examples.Pages.Button.ButtonWidthHeightModel
@{
    ViewBag.Title = "Button/ButtonWidthHeight";
    var F = Html.F();
}


@section body {

    <f:Button ID="btnIcon1" Text="图标在左侧" Width="150" Height="60" Icon="Email" CssClass="marginr" />
    <f:Button ID="btnIcon2" Text="图标在右侧" Width="150" Height="60" IconAlign="Right" Icon="Star" />
    <br />
    <br />
    <f:Button ID="btnIcon3" Text="图标在上面" Width="150" Height="60" IconAlign="Top" Icon="Email" CssClass="marginr" />
    <f:Button ID="btnIcon4" Text="图标在下面" Width="150" Height="60" IconAlign="Bottom" Icon="Star" />
    <br />
    <br />
    只有图片的按钮：
    <br />
    <br />
    <f:Button ID="Button1" IconUrl="~/res/images/16/1.png" Width="50" Height="40" CssClass="marginr" />
    <f:Button ID="Button2" IconUrl="~/res/images/16/8.png" Width="50" Height="40" />
    <br />
    <br />
    大按钮：
    <br />
    <br />
    <f:Button ID="Button3" Size="Large" Text="图标在左侧" Width="150" Height="80" Icon="Email" CssClass="marginr" />
    <f:Button ID="Button4" Size="Large" Text="图标在右侧" Width="150" Height="80" IconAlign="Right" Icon="Star" />
    <br />
    <br />
    <f:Button ID="Button5" Size="Large" Text="图标在上面" Width="150" Height="80" IconAlign="Top" Icon="Email" CssClass="marginr" />
    <f:Button ID="Button6" Size="Large" Text="图标在下面" Width="150" Height="80" IconAlign="Bottom" Icon="Star" />
    <br />
    <br />
    <hr />
    <br />
    <br />
    <f:Button ID="Button7" Text="图标在左侧" Width="150" Height="60" IconFont="_Home" CssClass="marginr" />
    <f:Button ID="Button8" Text="图标在右侧" Width="150" Height="60" IconAlign="Right" IconFont="_Car" />
    <br />
    <br />
    <f:Button ID="Button9" Text="图标在上面" Width="150" Height="60" IconAlign="Top" IconFont="_Camera" CssClass="marginr" />
    <f:Button ID="Button10" Text="图标在下面" Width="150" Height="60" IconAlign="Bottom" IconFont="_Phone" />
    <br />
    <br />
    只有图片的按钮：
    <br />
    <br />
    <f:Button ID="Button11" IconFont="_Android" Width="50" Height="40" CssClass="marginr" />
    <f:Button ID="Button12" IconFont="_Apple" Width="50" Height="40" CssClass="marginr" />
    <br />
    <br />
    大按钮：
    <br />
    <br />
    <f:Button ID="Button15" Size="Large" Text="图标在左侧" Width="150" Height="80" IconFont="_Home" CssClass="marginr" />
    <f:Button ID="Button16" Size="Large" Text="图标在右侧" Width="150" Height="80" IconAlign="Right" IconFont="_Car" />
    <br />
    <br />
    <f:Button ID="Button17" Size="Large" Text="图标在上面" Width="150" Height="80" IconAlign="Top" IconFont="_Camera" CssClass="marginr" />
    <f:Button ID="Button18" Size="Large" Text="图标在下面" Width="150" Height="80" IconAlign="Bottom" IconFont="_Phone" />
    <br />
    <br />
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示固定按钮宽高与不同图标位置、字体大小组合后的布局。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照固定尺寸</h3>
        <ul>
            <li>
                对照同排文字图标按钮、只有图标的按钮以及大按钮。<br />
                结果：文字按钮宽 <code>150</code> 像素，普通高度 <code>60</code>、大按钮高度 <code>80</code>；只有图标的按钮使用较窄尺寸，图标仍按设定方向排列。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Width</code>（本页全部按钮，如<strong class="example-control-reference" data-example-control="btnIcon1" title="第 1 个按钮（图标在左侧）">第 1
                    个按钮（图标在左侧）</strong>）：固定按钮宽度，本页主要使用 <code>150</code> 像素。</li>
            <li><code>Height</code>（本页全部按钮，如<strong class="example-control-reference" data-example-control="btnIcon1" title="第 1 个按钮（图标在左侧）">第 1
                    个按钮（图标在左侧）</strong>）：固定按钮高度，对比 <code>60</code> 与 <code>80</code> 像素。</li>
        </ul>
    </section>
}
