@page
@model FineUI.Core.Examples.Pages.Button.ButtonGroupChangeTextModel
@{
    ViewBag.Title = "Button/ButtonGroupChangeText";
    var F = Html.F();
}

@section body {

    <f:Panel ID="Panel1" IsFluid="true" ShowBorder="true" BodyPadding="10" Height="300" Title="面板">
        <Toolbars>
            <f:Toolbar>
                <Items>
                    <f:ButtonGroup ID="ButtonGroup1">
                        <f:Button ID="Button1" Text="按钮一" IconAlign="Top" Icon="Email"  />
                        <f:Button ID="Button2" Text="按钮二" IconAlign="Bottom" Icon="Star"  />
                        <f:Button ID="Button3" Text="按钮三" IconAlign="Top" IconFont="_Camera"  />
                        <f:Button ID="Button4" Text="按钮四" IconAlign="Bottom" IconFont="_Phone"  />
                    </f:ButtonGroup>
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:Button CssClass="marginr" ID="btnChangeButtonText" Text="修改[按钮四]的文本" OnClick="btnChangeButtonText_Click"></f:Button>
            <f:Button ID="btnShowHideButton" Text="显示隐藏[按钮四]" OnClick="btnShowHideButton_Click"></f:Button>
        </Items>
    </f:Panel>
    <br />
    <f:ButtonGroup ID="ButtonGroup2">
        <f:Button ID="Button5" Text="按钮五" IconAlign="Top" Icon="Email"  />
        <f:Button ID="Button6" Text="按钮六" IconAlign="Bottom" Icon="Star"  />
        <f:Button ID="Button7" Text="按钮七" IconAlign="Top" IconFont="_Camera"  />
        <f:Button ID="Button8" Text="按钮八" IconAlign="Bottom" IconFont="_Phone"  />
    </f:ButtonGroup>
    <br />
    <f:Button CssClass="marginr" ID="btnChangeButtonText2" Text="修改[按钮八]的文本" OnClick="btnChangeButtonText2_Click"></f:Button>
    <f:Button ID="btnShowHideButton2" Text="显示隐藏[按钮八]" OnClick="btnShowHideButton2_Click"></f:Button>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示按钮分组内文字变长、按钮隐藏与恢复后，分组重新计算布局。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>修改文字与显示状态</h3>
        <ul>
            <li>
                点击“修改[按钮四]的文本”。<br />
                结果：后台给按钮四追加当前时间，再次点击恢复原文字，分组随文字宽度调整。
            </li>
            <li>
                点击“显示隐藏[按钮四]”。<br />
                结果：后台隐藏或恢复按钮四，分组边框及其它按钮重新衔接。
            </li>
            <li>
                在下一组对“按钮八”执行相同操作。<br />
                结果：同样可以更新文字和显示状态，不需重新创建分组。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Text</code>：后台在原按钮上更新文字。</li>
            <li><code>Hidden</code>：隐藏组内按钮并释放其布局空间。</li>
        </ul>
    </section>
}
