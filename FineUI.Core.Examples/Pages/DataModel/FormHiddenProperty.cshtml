@page
@model FineUI.Core.Examples.Pages.DataModel.FormHiddenPropertyModel
@{
    ViewBag.SourceFiles = "~/Pages/DataModel/Models/Student.cs;~/Pages/DataModel/Models/Score.cs";
    ViewBag.Title = "DataModel/FormHiddenProperty";
    var F = Html.F();
}

@section body {

    <f:SimpleForm IsFluid="true" ID="SimpleForm1" BodyPadding="10" ShowBorder="true" ShowHeader="true" Title="简单表单">
        <Items>
            <f:HiddenField For="Student.Id"></f:HiddenField>
            <f:TextBox For="Student.Name"></f:TextBox>
            <f:RadioButtonList For="Student.Gender" ColumnNumber="3">
                <f:RadioItem Text="男" Value="1"></f:RadioItem>
                <f:RadioItem Text="女" Value="0"></f:RadioItem>
            </f:RadioButtonList>
            <f:CheckBox For="Student.AtSchool"></f:CheckBox>
            <f:TextBox For="Student.Major"></f:TextBox>
            <f:DatePicker For="Student.EntranceDate"></f:DatePicker>
        </Items>
        <Toolbars>
            <f:Toolbar Position="Bottom">
                <Items>
                    <f:Button ID="btnSubmit" CssClass="marginr" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click" OnClickFields="SimpleForm1"></f:Button>
                    <f:Button ID="btnModifyHiddenProperty" CssClass="marginr" Text="修改隐藏属性" OnClick="btnModifyHiddenProperty_Click"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:SimpleForm>



    }

