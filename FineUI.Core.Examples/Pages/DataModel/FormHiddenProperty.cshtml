@page
@model FineUI.Core.Examples.Pages.DataModel.FormHiddenPropertyModel
@{
    ViewBag.SourceFiles = "~/Pages/DataModel/Models/Student.cs;~/Pages/DataModel/Models/Score.cs";
    ViewBag.Title = "DataModel/FormHiddenProperty";
    var F = Html.F();
}

@section body {

    <f:SimpleForm IsFluid="true" ID="SimpleForm1" BodyPadding="10" ShowBorder="true" ShowHeader="true" Title="简单表单">
        <Items>
            <f:HiddenField For="Student.Id"></f:HiddenField>
            <f:TextBox For="Student.Name"></f:TextBox>
            <f:RadioButtonList For="Student.Gender" ColumnNumber="3">
                <f:RadioItem Text="男" Value="1"></f:RadioItem>
                <f:RadioItem Text="女" Value="0"></f:RadioItem>
            </f:RadioButtonList>
            <f:CheckBox For="Student.AtSchool"></f:CheckBox>
            <f:TextBox For="Student.Major"></f:TextBox>
            <f:DatePicker For="Student.EntranceDate"></f:DatePicker>
        </Items>
        <Toolbars>
            <f:Toolbar Position="Bottom">
                <Items>
                    <f:Button ID="btnSubmit" CssClass="marginr" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click" OnClickFields="SimpleForm1">
                    </f:Button>
                    <f:Button ID="btnModifyHiddenProperty" CssClass="marginr" Text="修改隐藏属性" OnClick="btnModifyHiddenProperty_Click"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:SimpleForm>



}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>把不在表单中显示的业务属性随回发恢复，并允许后台更新。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>读取并提交隐藏属性</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="SimpleForm1" title="简单表单">简单表单</strong>中，先点击提交，再点击<strong
                    class="example-control-reference" data-example-control="btnModifyHiddenProperty"
                    title="修改隐藏属性">修改隐藏属性</strong>，然后再次提交。<br />结果：初次提交显示原角色；修改后再次提交显示新角色，表单可见输入不被清空。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>For</code>（<strong class="example-control-reference" data-example-control="Student_Name" title="姓名">姓名</strong>、<strong
                    class="example-control-reference" data-example-control="Student_Gender" title="性别">性别</strong>、<strong class="example-control-reference"
                    data-example-control="Student_AtSchool" title="是否在校">是否在校</strong>）：初始为
                <code>Student.Name</code>、<code>Student.Gender</code>、<code>Student.AtSchool</code>、<code>Student.Major</code>、<code>Student.EntranceDate</code>，绑定模型属性路径，读取初始值、字段名称及验证注解，并在提交时接收字段值。
            </li>
            <li><code>OnClickFields</code>（<strong class="example-control-reference" data-example-control="btnSubmit" title="提交表单">提交表单</strong>）：初始为
                <code>SimpleForm1</code>，提交指定表单或字段，供后台模型绑定读取。
            </li>
            <li><code>[HiddenProperty]</code>（<strong class="example-control-reference" data-example-control="SimpleForm1"
                    title="简单表单">简单表单</strong>）：保存本页隐藏的角色标识和角色名称，后台修改后在后续回发中恢复。</li>
        </ul>
    </section>
}
