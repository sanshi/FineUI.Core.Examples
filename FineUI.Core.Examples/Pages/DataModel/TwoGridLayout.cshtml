@page
@model FineUI.Core.Examples.Pages.DataModel.TwoGridLayoutModel
@{
    ViewBag.SourceFiles = "~/Pages/DataModel/Models/Student.cs;~/Pages/DataModel/Models/StudentHelper.cs;~/Pages/DataModel/TwoGridPartial.cshtml";
    ViewBag.Title = "DataModel/TwoGrid";
    var F = Html.F();

    // NoRazorForms
}


@section body {

    <f:Panel ID="Panel1" BodyPadding="10" Title="面板" ShowBorder="true" ShowHeader="false" Layout="VBox" IsViewPort="true">
        <Items>
            <f:PartialConnector Content="@(await Html.PartialAsync("TwoGridPartial", Model.Students1, new ViewDataDictionary(ViewData) { { "__GridId", "Grid1" }, { "__Title", "表格一（在校生）" }, { "__MarginBottom", 8 }, { "__BoxFlex", 2 } }))"></f:PartialConnector>
            <f:PartialConnector Content="@(await Html.PartialAsync("TwoGridPartial", Model.Students2, new ViewDataDictionary(ViewData) { { "__GridId", "Grid2" }, { "__Title", "表格二（毕业生）" }, { "__MarginBottom", 0 }, { "__BoxFlex", 1 } }))"></f:PartialConnector>
        </Items>
    </f:Panel>


}


@section script
{

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>把同一分部视图生成的两个模型表格放入纵向布局，按容器分配高度。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>对照模型与表格显示</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Panel1" title="面板">面板</strong>中，调整浏览器高度，对照两张表格的可用区域。<br />结果：两张表格在纵向布局中重新分配空间，各自标题、数据和选择互相独立。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="Panel1" title="面板">面板</strong>）：初始为 <code>VBox</code>，规定容器内子控件的排列和空间分配方式。</li>
        <li><code>Partial / 控件 ID</code>（<strong class="example-control-reference" data-example-control="Panel1" title="面板">面板</strong>）：同一模板由调用方传入不同的数据、标题和稳定 ID，避免重复控件互相覆盖。</li>
    </ul>
</section>
}
