@page
@model FineUI.Core.Examples.Pages.DataModel.TwoGridLayoutModel
@{
    ViewBag.SourceFiles = "~/Pages/DataModel/Models/Student.cs;~/Pages/DataModel/Models/StudentHelper.cs;~/Pages/DataModel/TwoGridPartial.cshtml";
    ViewBag.Title = "DataModel/TwoGrid";
    var F = Html.F();

    // NoRazorForms
    F.PageManager.EnableRazorForms(false);
}


@section body {

    <f:Panel ID="Panel1" BodyPadding="10" Title="面板" ShowBorder="true" ShowHeader="false" Layout="VBox" IsViewPort="true">
        <Items>
            <f:PartialConnector Content="@(await Html.PartialAsync("TwoGridPartial", Model.Students1, new ViewDataDictionary(ViewData) { { "__GridId", "Grid1" }, { "__Title", "表格一（在校生）" }, { "__MarginBottom", 8 }, { "__BoxFlex", 2 } }))"></f:PartialConnector>
            <f:PartialConnector Content="@(await Html.PartialAsync("TwoGridPartial", Model.Students2, new ViewDataDictionary(ViewData) { { "__GridId", "Grid2" }, { "__Title", "表格二（毕业生）" }, { "__MarginBottom", 0 }, { "__BoxFlex", 1 } }))"></f:PartialConnector>
        </Items>
    </f:Panel>


}


@section script
{

    <script src="~/res/js/grid.js"></script>

}
