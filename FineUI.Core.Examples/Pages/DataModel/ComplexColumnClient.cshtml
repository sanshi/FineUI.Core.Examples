@page
@model FineUI.Core.Examples.Pages.DataModel.ComplexColumnClientModel
@{
    ViewBag.SourceFiles = "~/Pages/DataModel/Models/Student.cs;~/Pages/DataModel/Models/Family.cs;~/Pages/DataModel/Models/StudentExtended.cs;~/Pages/DataModel/Models/StudentHelper.cs";
    ViewBag.Title = "DataModel/ComplexColumnClient";
    var F = Html.F();
}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField For="Students.First().Name" />
            <f:RenderField For="Students.First().Gender" RendererFunction="renderGender" />
            <f:RenderField For="Students.First().EntranceYear" />
            <f:RenderCheckField For="Students.First().AtSchool" RenderAsStaticField="true" />
            <f:RenderField For="Students.First().Major" RendererFunction="renderMajor" Width="150" />
            <f:RenderField For="Students.First().FamilyObject" RendererFunction="renderFamily" Width="220" />
            <f:RenderField For="Students.First().HobbyArray" RendererFunction="renderHobby" ExpandUnusedSpace="true" MinWidth="150" />
        </Columns>
    </f:Grid>



}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderFamily(value, params) {
            // {
            //    "daddy": "张国栋",
            //    "mommy": "李梅"
            // }
            return "父亲: " + value.daddy + ", 母亲: " + value.mommy;
        }

        function renderHobby(value, params) {
            // ["reading", "basketball", "travel"]
            var result = [];
            $.each(value, function (index, hobby) {
                var hobbyName = "";
                switch (hobby) {
                    case "reading":
                        hobbyName = "读书";
                        break;
                    case "basketball":
                        hobbyName = "篮球";
                        break;
                    case "travel":
                        hobbyName = "旅游";
                        break;
                    case "movie":
                        hobbyName = "电影";
                        break;
                    case "music":
                        hobbyName = "音乐";
                        break;
                }
                result.push(hobbyName);
            });
            return result.join(", ");
        }

    </script>
}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>把对象和数组保留为表格数据，在浏览器渲染函数中组合显示文字。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>对照模型与表格显示</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>中，对照家庭信息与爱好两列，并查看这两列的渲染配置。<br />结果：首行显示父亲、母亲的组合文字和逗号分隔的爱好；原始字段仍是对象和数组。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DataIDField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>Id</code>，从数据行读取稳定的业务标识，供选择或点击事件使用。
            </li>
            <li><code>RendererFunction</code>（<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：家庭对象与爱好数组由各自的客户端函数转换为显示内容。</li>
        </ul>
    </section>
}
