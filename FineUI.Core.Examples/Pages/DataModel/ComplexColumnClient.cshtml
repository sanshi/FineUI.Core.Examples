@page
@model FineUI.Core.Examples.Pages.DataModel.ComplexColumnClientModel
@{
    ViewBag.SourceFiles = "~/Pages/DataModel/Models/Student.cs;~/Pages/DataModel/Models/Family.cs;~/Pages/DataModel/Models/StudentExtended.cs;~/Pages/DataModel/Models/StudentHelper.cs";
    ViewBag.Title = "DataModel/ComplexColumnClient";
    var F = Html.F();
}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField For="Students.First().Name" />
            <f:RenderField For="Students.First().Gender" RendererFunction="renderGender" />
            <f:RenderField For="Students.First().EntranceYear" />
            <f:RenderCheckField For="Students.First().AtSchool" RenderAsStaticField="true" />
            <f:RenderField For="Students.First().Major" RendererFunction="renderMajor" Width="150" />
            <f:RenderField For="Students.First().FamilyObject" RendererFunction="renderFamily" Width="220" />
            <f:RenderField For="Students.First().HobbyArray" RendererFunction="renderHobby" ExpandUnusedSpace="true" MinWidth="150" />
        </Columns>
    </f:Grid>

    

}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderFamily(value, params) {
            // {
            //    "daddy": "张国栋",
            //    "mommy": "李梅"
            // }
            return "父亲: " + value.daddy + ", 母亲: " + value.mommy;
        }

        function renderHobby(value, params) {
            // ["reading", "basketball", "travel"]
            var result = [];
            $.each(value, function (index, hobby) {
                var hobbyName = "";
                switch (hobby) {
                    case "reading":
                        hobbyName = "读书";
                        break;
                    case "basketball":
                        hobbyName = "篮球";
                        break;
                    case "travel":
                        hobbyName = "旅游";
                        break;
                    case "movie":
                        hobbyName = "电影";
                        break;
                    case "music":
                        hobbyName = "音乐";
                        break;
                }
                result.push(hobbyName);
            });
            return result.join(", ");
        }

    </script>
}