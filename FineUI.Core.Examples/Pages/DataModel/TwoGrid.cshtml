@page
@model FineUI.Core.Examples.Pages.DataModel.TwoGridModel
@{
    ViewBag.SourceFiles = "~/Pages/DataModel/Models/Student.cs;~/Pages/DataModel/Models/StudentHelper.cs;~/Pages/DataModel/TwoGridPartial.cshtml";
    ViewBag.Title = "DataModel/TwoGridLayout";
    var F = Html.F();

    // NoRazorForms
}

@section body {

    @(await Html.PartialAsync("TwoGridPartial", Model.Students1, new ViewDataDictionary(ViewData) { { "__GridId", "Grid1" }, { "__Title", "表格一（在校生）" }, { "__IsFluid", true } }))
    <br />
    @(await Html.PartialAsync("TwoGridPartial", Model.Students2, new ViewDataDictionary(ViewData) { { "__GridId", "Grid2" }, { "__Title", "表格二（毕业生）" }, { "__IsFluid", true } }))

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>重复使用同一分部视图，分别显示在校生和毕业生表格。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>对照模型与表格显示</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格一（在校生）">表格一（在校生）</strong>中，对照两张表格的标题和记录。<br />结果：表格一显示在校生，表格二显示毕业生；各自使用独立数据和控件标识。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Partial / 控件 ID</code>（<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格一（在校生）">表格一（在校生）</strong>）：同一模板由调用方传入不同的数据、标题和稳定 ID，避免重复控件互相覆盖。</li>
        </ul>
    </section>
}
