@page
@model FineUI.Core.Examples.Pages.DataModel.StudentEditModel
@{
    ViewBag.SourceFiles = "~/Pages/DataModel/Models/Student.cs;~/Pages/DataModel/Models/StudentHelper.cs;~/Pages/DataModel/Models/StudentStore.cs";
    ViewBag.Title = "DataModel/StudentEdit";
    var F = Html.F();
}

@section body {

    <f:SimpleForm IsFluid="true" ID="SimpleForm1" BodyPadding="10" ShowBorder="true" ShowHeader="true" Title="编辑学生">
        <Items>
            @* 编辑目标的主键：随回发一起提交，供保存时按主键重新读出实体 *@
            @* 只读展示：Label 是展示型控件，不参与回发绑定。首屏由 OnGet 加载的实体填值；
               保存时事件处理器不覆盖分组，故数据源里的原值保持不变 *@
            <f:Label For="Student.Group"></f:Label>
            <f:TextBox For="Student.Name"></f:TextBox>
            <f:RadioButtonList For="Student.Gender" ColumnNumber="3">
                <f:RadioItem Text="男" Value="1"></f:RadioItem>
                <f:RadioItem Text="女" Value="0"></f:RadioItem>
            </f:RadioButtonList>
            <f:NumberBox For="Student.EntranceYear"></f:NumberBox>
            <f:CheckBox For="Student.AtSchool"></f:CheckBox>
            <f:TextBox For="Student.Major"></f:TextBox>
            <f:DatePicker For="Student.EntranceDate"></f:DatePicker>
        </Items>
        <Toolbars>
            <f:Toolbar Position="Bottom">
                <Items>
                    <f:Button ID="btnSave" Text="保存" _ValidateForms="SimpleForm1" OnClick="btnSave_Click" OnClickFields="SimpleForm1"></f:Button>
                    <f:Button ID="btnReset" Type="Reset" Text="重置表单"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:SimpleForm>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>根据地址中的学生编号加载实体，修改后由后台保存并可再次读取。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>读取并提交模型值</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="SimpleForm1" title="编辑学生">编辑学生</strong>中，在姓名字段输入新的姓名，点击保存，再用相同学生编号重新进入本页。<br />结果：保存通知显示学生编号和新姓名，再次进入时回显已修改的姓名；本页使用示例存储，不代表实际数据库实现。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>For</code>（<strong class="example-control-reference" data-example-control="Student_Group" title="分组">分组</strong>、<strong class="example-control-reference" data-example-control="Student_Name" title="姓名">姓名</strong>、<strong class="example-control-reference" data-example-control="Student_Gender" title="性别">性别</strong>）：绑定模型属性路径，读取初始值、字段名称及验证注解，并在提交时接收字段值。</li>
        <li><code>OnClickFields</code>（<strong class="example-control-reference" data-example-control="btnSave" title="保存">保存</strong>）：初始为 <code>SimpleForm1</code>，提交指定表单或字段，供后台模型绑定读取。</li>
    </ul>
</section>
}
