@page
@model FineUI.Core.Examples.Pages.DataModel.LoginModelModel
@{
    ViewBag.SourceFiles = "~/Pages/DataModel/Models/User.cs";
    ViewBag.Title = "DataModel/LoginModel";
    var F = Html.F();
}

@section body {



    <f:Window Width="350" WindowPosition="GoldenSection" EnableClose="false" IsModal="false" Title="登录表单" ID="Window1">
        <Items>
            <f:SimpleForm ShowHeader="false" BodyPadding="10" ShowBorder="false" ID="SimpleForm1">
                <Items>
                    <f:TextBox For="CurrentUser.UserName"></f:TextBox>
                    <f:TextBox For="CurrentUser.Password"></f:TextBox>
                </Items>
            </f:SimpleForm>
        </Items>
        <Toolbars>
            <f:Toolbar Position="Bottom" ToolbarAlign="Right" ID="Toolbar1">
                <Items>
                    <f:Button OnClick="btnLogin_Click" OnClickFields="SimpleForm1" ValidateTarget="Top" _ValidateForms="SimpleForm1" Type="Submit" Text="登录"
                        ID="btnLogin"></f:Button>
                    <f:Button Type="Reset" Text="重置" ID="btnReset"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Window>


    @* <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="CurrentUser.UserName" class="control-label"></label>
            <input asp-for="CurrentUser.UserName" class="form-control" />
            <span asp-validation-for="CurrentUser.UserName" class="text-danger"></span>
        </div>
    </form> *@
}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>由用户模型的注解生成字段名称和验证规则，并把提交值绑定回模型。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>验证模型注解</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="btnLogin" title="登录">登录</strong>。<br />结果：空字段显示必填提示，浏览器阻止提交。</li>
            <li>在<strong class="example-control-reference" data-example-control="CurrentUser_UserName" title="用户名">用户名</strong>输入 <code>admin</code>，在<strong
                    class="example-control-reference" data-example-control="CurrentUser_Password" title="密码">密码</strong>输入
                <code>admin888</code>，点击登录。<br />结果：验证通过后回发，后台读取绑定后的用户模型，显示成功登录提示。
            </li>
            <li>把密码改为 <code>abcdef</code>并再次登录。<br />结果：密码缺少数字，浏览器显示正则验证提示，不执行登录。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <div>
            用户名：admin
            <br />
            密码：admin888
            <br />
            <br />
            <br />
            注意：在任意输入框内按回车键都会触发表单的提交（相当于点击【登录】按钮）。
        </div>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>For</code>（<strong class="example-control-reference" data-example-control="CurrentUser_UserName" title="用户名">用户名</strong>、<strong
                    class="example-control-reference" data-example-control="CurrentUser_Password" title="密码">密码</strong>）：初始为
                <code>CurrentUser.UserName</code>、<code>CurrentUser.Password</code>，绑定模型属性路径，读取初始值、字段名称及验证注解，并在提交时接收字段值。
            </li>
            <li><code>ValidateForms</code>（<strong class="example-control-reference" data-example-control="btnLogin" title="登录">登录</strong>）：初始为
                <code>SimpleForm1</code>，提交前验证指定表单；验证失败时显示提示并阻止回发。
            </li>
            <li><code>OnClickFields</code>（<strong class="example-control-reference" data-example-control="btnLogin" title="登录">登录</strong>）：初始为
                <code>SimpleForm1</code>，提交指定表单或字段，供后台模型绑定读取。
            </li>
        </ul>
    </section>
}
