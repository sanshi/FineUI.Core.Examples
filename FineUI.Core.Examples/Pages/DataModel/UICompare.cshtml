@page
@model FineUI.Core.Examples.Pages.DataModel.UICompareModel
@{
    ViewBag.SourceFiles = "~/Pages/DataModel/Models/UICompareModel.cs";
    ViewBag.Title = "DataModel/UICompare";
    var F = Html.F();
}



@section body {

    <f:SimpleForm IsFluid="true" ID="SimpleForm1" BodyPadding="10" LabelWidth="200" ShowBorder="true" ShowHeader="true" Title="简单表单">
        <Items>
            <f:DatePicker For="TheModel.StartDate"></f:DatePicker>
            <f:DatePicker For="TheModel.EndDate"></f:DatePicker>
            <f:Label></f:Label>
            <f:TextBox For="TheModel.Password"></f:TextBox>
            <f:TextBox For="TheModel.ConfirmPassword"></f:TextBox>
            <f:Label></f:Label>
            <f:NumberBox For="TheModel.Number1"></f:NumberBox>
            <f:NumberBox For="TheModel.Number2"></f:NumberBox>
            <f:Label></f:Label>
            <f:Button ID="btnSubmit" CssClass="marginr" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click" OnClickFields="SimpleForm1">
            </f:Button>
            <f:Button ID="btnReset" Text="重置表单" ClickHandler="onResetClick"></f:Button>
        </Items>
    </f:SimpleForm>


    @* <form id="commentForm" method="post" action="">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="TheModel.Password" class="control-label"></label>
            <input asp-for="TheModel.Password" class="form-control" />
            <span asp-validation-for="TheModel.Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="TheModel.ConfirmPassword" class="control-label"></label>
            <input asp-for="TheModel.ConfirmPassword" class="form-control" />
            <span asp-validation-for="TheModel.ConfirmPassword" class="text-danger"></span>
        </div>

        <input type="submit" value="提交" />
    </form> *@


}

@section script {

    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>通过模型注解验证日期先后、两次密码一致和数字大小，并把通过验证的值绑定回模型。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>比较关联字段</h3>
        <ol>
            <li>把<strong class="example-control-reference" data-example-control="TheModel_EndDate" title="结束日期">结束日期</strong>改为
                <code>2000-01-01</code>，再点击<strong class="example-control-reference" data-example-control="btnSubmit"
                    title="提交表单">提交表单</strong>。<br />结果：初始开始日期为今天，日期比较失败，提示结束日期应大于开始日期，不提交数据。
            </li>
            <li>把<strong class="example-control-reference" data-example-control="TheModel_EndDate" title="结束日期">结束日期</strong>改为 <code>2099-01-01</code>，在<strong
                    class="example-control-reference" data-example-control="TheModel_Password" title="密码">密码</strong>和<strong class="example-control-reference"
                    data-example-control="TheModel_ConfirmPassword" title="确认密码">确认密码</strong>均输入 <code>abc</code>，将<strong class="example-control-reference"
                    data-example-control="TheModel_Number2" title="数字 2">数字 2</strong>设为 <code>50</code>，再次提交。<br />结果：50 大于初始数字一的
                30，日期和密码比较也通过；回发后通知显示绑定后的模型数据。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>UICompare</code>（<strong class="example-control-reference" data-example-control="TheModel_EndDate"
                    title="结束日期">结束日期</strong>）：模型中的结束日期要求大于开始日期，数字二要求大于等于数字一。</li>
            <li><code>Compare</code>（<strong class="example-control-reference" data-example-control="TheModel_ConfirmPassword"
                    title="确认密码">确认密码</strong>）：模型中的确认密码要求与密码相同。</li>
            <li><code>ValidateForms</code>（<strong class="example-control-reference" data-example-control="btnSubmit" title="提交表单">提交表单</strong>）：初始为
                <code>SimpleForm1</code>，提交前验证指定表单；验证失败时显示提示并阻止回发。
            </li>
        </ul>
    </section>
}
