@page
@model FineUI.Core.Examples.Pages.DataModel.CheckBoxListModel
@{
    ViewBag.SourceFiles = "~/Pages/DataModel/Models/TheCheckBoxListModel.cs";
    ViewBag.Title = "DataModel/CheckBoxList";
    var F = Html.F();
}

@section body {
    
    <f:SimpleForm IsFluid="true" ID="SimpleForm1" BodyPadding="10" LabelWidth="150" ShowBorder="true" ShowHeader="true" Title="简单表单">
        <Items>
            <f:CheckBox For="TheModel.IsChecked" Text="复选框"></f:CheckBox>
            <f:CheckBoxList For="TheModel.CheckBoxList1" ColumnNumber="3" Items="@Model.TheModel.CheckBoxList1Items.ToArray()"></f:CheckBoxList>
            <f:RadioButtonList For="TheModel.RadioButtonList1" ColumnNumber="3" Items="@Model.TheModel.RadioButton1Items.ToArray()"></f:RadioButtonList>
            <f:RadioButtonList For="TheModel.Gender" ColumnNumber="3">
                <f:RadioItem Text="男" Value="1"></f:RadioItem>
                <f:RadioItem Text="女" Value="0"></f:RadioItem>
            </f:RadioButtonList>
            <f:RadioButtonList For="TheModel.GenderType" ColumnNumber="3">
                <f:RadioItem Text="男" Value="1"></f:RadioItem>
                <f:RadioItem Text="女" Value="0"></f:RadioItem>
            </f:RadioButtonList>
            <f:DropDownList For="TheModel.GenderType" ID="TheModel_GenderType_2" Name="TheModel_GenderType_2">
                <f:ListItem Text="男" Value="1"></f:ListItem>
                <f:ListItem Text="女" Value="0"></f:ListItem>
            </f:DropDownList>
            <f:Button ID="btnSubmit" CssClass="marginr" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click" OnClickFields="SimpleForm1"></f:Button>
            <f:Button ID="btnReset" Text="重置表单" ClickHandler="onResetClick"></f:Button>
        </Items>
    </f:SimpleForm>

}

@section script {

    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }

    </script>
}
