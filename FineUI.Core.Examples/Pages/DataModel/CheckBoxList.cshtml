@page
@model FineUI.Core.Examples.Pages.DataModel.CheckBoxListModel
@{
    ViewBag.SourceFiles = "~/Pages/DataModel/Models/CheckBoxListModel.cs";
    ViewBag.Title = "DataModel/CheckBoxList";
    var F = Html.F();
}

@section body {

    <f:SimpleForm IsFluid="true" ID="SimpleForm1" BodyPadding="10" LabelWidth="150" ShowBorder="true" ShowHeader="true" Title="简单表单">
        <Items>
            <f:CheckBox For="TheModel.IsChecked" Text="复选框"></f:CheckBox>
            <f:CheckBoxList For="TheModel.CheckBoxList1" ColumnNumber="3" Items="@Model.GetDeclaredCheckItems()"></f:CheckBoxList>
            <f:RadioButtonList For="TheModel.RadioButtonList1" ColumnNumber="3" Items="@Model.GetDeclaredRadioItems()"></f:RadioButtonList>
            <f:RadioButtonList For="TheModel.Gender" ColumnNumber="3">
                <f:RadioItem Text="男" Value="1"></f:RadioItem>
                <f:RadioItem Text="女" Value="0"></f:RadioItem>
            </f:RadioButtonList>
            <f:RadioButtonList For="TheModel.GenderType" ColumnNumber="3">
                <f:RadioItem Text="男" Value="1"></f:RadioItem>
                <f:RadioItem Text="女" Value="0"></f:RadioItem>
            </f:RadioButtonList>
            <f:DropDownList For="TheModel.GenderType" ID="TheModel_GenderType_2" Name="TheModel_GenderType_2">
                <f:ListItem Text="男" Value="1"></f:ListItem>
                <f:ListItem Text="女" Value="0"></f:ListItem>
            </f:DropDownList>
            <f:Button ID="btnSubmit" CssClass="marginr" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click" OnClickFields="SimpleForm1">
            </f:Button>
            <f:Button ID="btnReset" Text="重置表单" ClickHandler="onResetClick"></f:Button>
        </Items>
    </f:SimpleForm>

}

@section script {

    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>把布尔值、值集合和枚举绑定到不同选择控件，提交时分别读取模型值和独立字段值。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>读取并提交模型值</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="SimpleForm1"
                    title="简单表单">简单表单</strong>中，更改复选框、复选列表和性别选项；把独立性别下拉列表设为与模型性别不同，再提交。<br />结果：后台回显模型数据及独立下拉列表的值，两组性别可以不同；连续提交保持各自选择。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>For</code>（<strong class="example-control-reference" data-example-control="TheModel_IsChecked" title="复选框一">复选框一</strong>、<strong
                    class="example-control-reference" data-example-control="TheModel_CheckBoxList1" title="复选框列表一">复选框列表一</strong>、<strong
                    class="example-control-reference" data-example-control="TheModel_RadioButtonList1"
                    title="单选框列表一">单选框列表一</strong>）：绑定模型属性路径，读取初始值、字段名称及验证注解，并在提交时接收字段值。</li>
            <li><code>OnClickFields</code>（<strong class="example-control-reference" data-example-control="btnSubmit" title="提交表单">提交表单</strong>）：初始为
                <code>SimpleForm1</code>，提交指定表单或字段，供后台模型绑定读取。
            </li>
        </ul>
    </section>
}
