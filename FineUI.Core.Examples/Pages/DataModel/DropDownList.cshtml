@page
@model FineUI.Core.Examples.Pages.DataModel.DropDownListModel
@{
    ViewBag.SourceFiles = "~/Pages/DataModel/Models/DropDownListModel.cs";
    ViewBag.Title = "DataModel/DropDownList";
    var F = Html.F();
}

@section body {

    <f:SimpleForm IsFluid="true" ID="SimpleForm1" BodyPadding="10" LabelWidth="120" ShowBorder="true" ShowHeader="true" Title="简单表单">
        <Items>
            <f:DropDownList For="TheModel.DropDownList1" Items="@Model.GetDeclaredItems()"></f:DropDownList>
            <f:DropDownList For="TheModel.DropDownList2" Items="@Model.GetDeclaredItems()" EnableMultiSelect="true"></f:DropDownList>
            <f:Button ID="btnSubmit" CssClass="marginr" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click" OnClickFields="SimpleForm1"></f:Button>
            <f:Button ID="btnReset" Text="重置表单" ClickHandler="onResetClick"></f:Button>
        </Items>
    </f:SimpleForm>


}

@section script {

    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>对照单选值和多个值集合的下拉列表模型绑定。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>读取并提交模型值</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="SimpleForm1" title="简单表单">简单表单</strong>中，在单选下拉列表改选可选项，再在多选下拉列表追加一个选项，点击提交。<br />结果：后台显示单选值和完整多选集合，多选追加不会覆盖已有选择。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>For</code>（<strong class="example-control-reference" data-example-control="TheModel_DropDownList1" title="下拉列表一">下拉列表一</strong>、<strong class="example-control-reference" data-example-control="TheModel_DropDownList2" title="下拉列表二">下拉列表二</strong>）：绑定模型属性路径，读取初始值、字段名称及验证注解，并在提交时接收字段值。</li>
        <li><code>OnClickFields</code>（<strong class="example-control-reference" data-example-control="btnSubmit" title="提交表单">提交表单</strong>）：初始为 <code>SimpleForm1</code>，提交指定表单或字段，供后台模型绑定读取。</li>
        <li><code>EnableMultiSelect</code>（<strong class="example-control-reference" data-example-control="TheModel_DropDownList2" title="下拉列表二">下拉列表二</strong>）：初始为 <code>true</code>，允许同时选择多个选项。</li>
    </ul>
</section>
}
