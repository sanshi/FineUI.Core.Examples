@page
@model FineUI.Core.Examples.Pages.DataModel.DropDownListModel
@{
    ViewBag.SourceFiles = "~/Pages/DataModel/Models/TheDropDownListModel.cs";
    ViewBag.Title = "DataModel/DropDownList";
    var F = Html.F();
}

@section body {

    <f:SimpleForm IsFluid="true" ID="SimpleForm1" BodyPadding="10" LabelWidth="120" ShowBorder="true" ShowHeader="true" Title="简单表单">
        <Items>
            <f:DropDownList For="TheModel.DropDownList1" Items="@Model.TheModel.DropDownList1Items.ToArray()"></f:DropDownList>
            <f:DropDownList For="TheModel.DropDownList2" Items="@Model.TheModel.DropDownList2Items.ToArray()" EnableMultiSelect="true"></f:DropDownList>
            <f:Button ID="btnSubmit" CssClass="marginr" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click" OnClickFields="SimpleForm1"></f:Button>
            <f:Button ID="btnReset" Text="重置表单" ClickHandler="onResetClick"></f:Button>
        </Items>
    </f:SimpleForm>


}

@section script {

    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }

    </script>
}
