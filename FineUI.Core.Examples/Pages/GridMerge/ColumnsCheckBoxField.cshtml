@page
@model FineUI.Core.Examples.Pages.GridMerge.ColumnsCheckBoxFieldModel
@{
    ViewBag.Title = "GridMerge/ColumnsCheckBoxField";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableColumnLines="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="ID" DataField="ID" />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组B" DataField="GroupB" RendererFunction="renderGroup" />
            <f:RenderCheckField ColumnID="CheckBoxField1" RenderAsStaticField="false" HeaderText="是否激活" />
        </Columns>
        <Listeners>
            <f:Listener Event="dataload" Handler="onGridDataLoad"></f:Listener>
        </Listeners>
    </f:Grid>
    <br>
    <br>

    <br>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onGridDataLoad(event) {
            this.mergeColumns(['GroupB']);
        }

        F.ready(function () {

            var grid = F.ui.Grid1;
            var checkboxSelector = '.f-grid-cell-CheckBoxField1 .f-grid-checkbox';

            // 注册复选框的点击事件
            grid.el.on('click', checkboxSelector, function (event) {
                var rowEl = $(this).closest('.f-grid-row');
                var rowData = grid.getRowData(rowEl);

                // 仅在当前行被选中时，取消同一合并组内其它行的选中状态。
                if (rowData.values['CheckBoxField1']) {

                    // 参考行的 GroupB 的值
                    var rowGroupB = rowData.values['GroupB'];

                    // 下一个要检查的行元素
                    var nextRowEl;

                    // 取消选中行中的复选框，返回 false 表明本行和参考行不属于同一个分组
                    function uncheckRow() {
                        var nextRowData = grid.getRowData(nextRowEl);
                        var nextRowGroupB = nextRowData.values['GroupB'];

                        if (nextRowGroupB == rowGroupB) {
                            // 用 ColumnID 到新值的对象更新单元格，单列和多列采用同一种写法。
                            // https://fineui.com/js/api/FineUI.Grid.html#updateCellValue
                            grid.updateCellValue(nextRowData.id, { CheckBoxField1: false }, true);
                            return true;
                        } else {
                            // 不属于同一个分组
                            return false;
                        }
                    }


                    // 向上查找相同 GroupB 的行，并取消选中复选框
                    nextRowEl = rowEl;
                    while ((nextRowEl = nextRowEl.prev()).length) {
                        if (!uncheckRow()) {
                            break;
                        }
                    }

                    // 向下查找相同 GroupB 的行，并取消选中复选框
                    nextRowEl = rowEl;
                    while ((nextRowEl = nextRowEl.next()).length) {
                        if (!uncheckRow()) {
                            break;
                        }
                    }

                }

            });
        });

    </script>


}
@section exampleDescription {
<section aria-label="页面描述">
    <p>在相同分组合并区域内实现复选框互斥，其他分组可以保留各自选择。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>同组合并记录只留一个勾选</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>同一合并分组先勾选一行，再勾选该组另一行。<br />结果：新勾选保留，原先同组记录的复选框取消；另一合并组的选择不受影响。</li>
        <li>取消当前勾选，或再切换其他组的复选框。<br />结果：取消不会强制替同组选择另一行；各组状态分别保存，正文与重新绘制后的勾选一致。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <p>注：同一分组的复选框只能选中一个。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>mergeColumns</code>（<strong>页面合并脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：只合并用于识别互斥范围的 GroupB 列。</li>
        <li><code>updateCellValue</code>（<strong>页面合并脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：沿相邻同组记录清除其他勾选，同时更新实际行值，避免只改图标导致重绘后恢复旧状态。</li>
    </ul>
</section>
}
