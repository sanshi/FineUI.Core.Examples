@page
@model FineUI.Core.Examples.Pages.GridMerge.ColumnsDependsFirstModel
@{
    ViewBag.Title = "GridMerge/ColumnsDependsFirst";
    var F = Html.F();
}


@using System.Data;

@section body {

    @{
        DataTable source = DataSourceUtil.GetDataTable();

        foreach (DataRow row in source.Rows)
        {
            DateTime logTime = (DateTime)row["LogTime"];
            row["LogTime"] = new DateTime(logTime.Year, logTime.Month, logTime.Day);
        }
    }

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataSource="@source" EnableColumnLines="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="ID" DataField="ID" />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" />
        </Columns>
        <Listeners>
            <f:Listener Event="dataload" Handler="onGridDataLoad"></f:Listener>
        </Listeners>
    </f:Grid>
    <br>
    <br>
    注：
    <ul>
        <li>[分组]列的单元格合并，依赖于[所学专业]列的单元格是否处于合并状态；</li>
        <li>[注册日期]列的单元格合并，依赖于[所学专业]列的单元格是否处于合并状态。</li>
    </ul>
    <br>
    <br>


    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>
        function onGridDataLoad(event) {
            this.mergeColumns(['Major', 'Group', 'LogTime'], {
                dependsFirst: true
            });
        }
    </script>

}