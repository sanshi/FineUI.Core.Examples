@page
@model FineUI.Core.Examples.Pages.GridMerge.ColumnsDependsFirstModel
@{
    ViewBag.Title = "GridMerge/ColumnsDependsFirst";
    var F = Html.F();
}


@using System.Data;

@section body {



    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableColumnLines="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="ID" DataField="ID" />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
        <Listeners>
            <f:Listener Event="dataload" Handler="onGridDataLoad"></f:Listener>
        </Listeners>
    </f:Grid>
    <br>
    <br>

    <br>
    <br>


    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>
        function onGridDataLoad(event) {
            this.mergeColumns(['Major', 'Group', 'LogTime'], {
                dependsFirst: true
            });
        }
    </script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>后续列只在第一列已经合并的区域内继续合并相同值。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>沿依赖边界核对合并</h3>
    <ul>
        <li>沿<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong><strong><strong>所学专业</strong></strong>、<strong>分组</strong>和<strong>注册日期</strong>等配置列逐行查看合并边界。<br />结果：后续列各自比较相同值，但都不越过第一列合并块；不要求逐级依赖紧邻前一列。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <ul>
        <li>[<strong>分组</strong>]列的单元格合并，依赖于[<strong>所学专业</strong>]列的单元格是否处于合并状态；</li>
        <li>[<strong>注册日期</strong>]列的单元格合并，依赖于[<strong>所学专业</strong>]列的单元格是否处于合并状态。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>mergeColumns / dependsFirst</code>（<strong>页面合并脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：选项 dependsFirst 为 true，所有后续列依赖第一列边界。</li>
    </ul>
</section>
}
