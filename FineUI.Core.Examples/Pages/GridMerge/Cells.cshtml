@page
@model FineUI.Core.Examples.Pages.GridMerge.CellsModel
@{
    ViewBag.Title = "GridMerge/Cells";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataSource="@DataSourceUtil.GetDataTable()" EnableColumnLines="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="ID" DataField="ID" />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组A" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="分组B" DataField="GroupB" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" />
        </Columns>
        <Listeners>
            <f:Listener Event="dataload" Handler="onGridDataLoad"></f:Listener>
        </Listeners>
    </f:Grid>
    <br>
    <br>
    注：单元格合并和行扩展列不能同时存在（行扩展列时表格的每一行都是table结构）！
    <br>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>
        function onGridDataLoad(event) {
            this.mergeCells([{
                rowId: '101',
                columnId: 'EntranceYear',
                rowspan: 3
            }, {
                rowId: '102',
                columnId: 'Major',
                rowspan: 3
            }, {
                rowId: '109',
                columnId: 'Group',
                rowspan: 4,
                colspan: 2
            }]);
        }
    </script>

}