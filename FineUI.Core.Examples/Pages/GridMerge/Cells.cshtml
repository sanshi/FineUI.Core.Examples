@page
@model FineUI.Core.Examples.Pages.GridMerge.CellsModel
@{
    ViewBag.Title = "GridMerge/Cells";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableColumnLines="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="ID" DataField="ID" />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组A" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="分组B" DataField="GroupB" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
        <Listeners>
            <f:Listener Event="dataload" Handler="onGridDataLoad"></f:Listener>
        </Listeners>
    </f:Grid>
    <br>
    <br>

    <br>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>
        function onGridDataLoad(event) {
            this.mergeCells([{
                rowId: '101',
                columnId: 'EntranceYear',
                rowspan: 3
            }, {
                rowId: '102',
                columnId: 'Major',
                rowspan: 3
            }, {
                rowId: '109',
                columnId: 'Group',
                rowspan: 4,
                colspan: 2
            }]);
        }
    </script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>按起始行、列和跨越范围合并指定单元格，不以字段相同自动推断。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>核对指定的跨行跨列范围</h3>
    <ul>
        <li>查看<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong><strong><strong>入学年份</strong></strong>、<strong>所学专业</strong>和分组附近的单元格边界。<br />结果：本页指定的起始格跨越多行，分组区域还同时跨列；周围未列入配置的单元格保留原布局，合并只改变显示。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <p>注：单元格合并和行扩展列不能同时存在（行扩展列时表格的每一行都是table结构）！</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>mergeCells / rowId / columnId / rowspan / colspan</code>（<strong>页面合并脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：按稳定行标识与列标识指定左上角，rowspan 和 colspan 给出跨度；数据加载后重新应用合并范围。</li>
    </ul>
</section>
}
