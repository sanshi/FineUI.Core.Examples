@page
@model FineUI.Core.Examples.Pages.MultiLang.GridAnnotationModel
@{
    ViewBag.SourceFiles = "~/Pages/MultiLang/Models/Student.cs;~/Pages/MultiLang/Models/StudentHelper.cs";
    ViewBag.Title = "MultiLang/GridAnnotation";
    var F = Html.F();
    var jsonSettings = new Newtonsoft.Json.JsonSerializerSettings
    {
        StringEscapeHandling = Newtonsoft.Json.StringEscapeHandling.EscapeHtml
    };
    var resources = new Newtonsoft.Json.Linq.JObject();
    foreach (var resource in global::FineUI.Core.PageContext.GetLocalizer<SharedJavaScriptResources>().GetAllStrings(includeParentCultures: true))
    {
        resources[resource.Name] = resource.Value;
    }
}

@functions {
    ParamsFunc<string, object, string> _R => Model.GetResource;
}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="@_R("表格")" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField For="Students.First().Name" Width="150" />
            <f:RenderField For="Students.First().Gender" RendererFunction="renderGender" Width="150" />
            <f:RenderField For="Students.First().EntranceYear" Width="150" />
            <f:RenderCheckField For="Students.First().AtSchool" RenderAsStaticField="true" Width="150" />
            <f:RenderField For="Students.First().Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField For="Students.First().Group" RendererFunction="renderGroup" Width="150" />
            <f:RenderField For="Students.First().EntranceDate" Width="150" />
        </Columns>
    </f:Grid>

    <br>
    <br>

    <f:Button Text="@_R("选中了哪些行")" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <!-- 输出多语言资源 -->
    <script id="grid-resources" type="application/json">@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(resources, jsonSettings))</script>
    <script type="text/javascript">
        // 首屏创建表格前先加载资源，让 renderer 和按钮事件都读到当前语言。
        F.setResources(JSON.parse(document.getElementById('grid-resources').textContent));
    </script>

}
