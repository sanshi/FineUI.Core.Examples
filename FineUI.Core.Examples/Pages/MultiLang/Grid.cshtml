@page
@model FineUI.Core.Examples.Pages.MultiLang.GridModel
@{
    ViewBag.Title = "MultiLang/Grid";
    var F = Html.F();
    var jsonSettings = new Newtonsoft.Json.JsonSerializerSettings
    {
        StringEscapeHandling = Newtonsoft.Json.StringEscapeHandling.EscapeHtml
    };
    var resources = new Newtonsoft.Json.Linq.JObject();
    foreach (var resource in global::FineUI.Core.PageContext.GetLocalizer<SharedJavaScriptResources>().GetAllStrings(includeParentCultures: true))
    {
        resources[resource.Name] = resource.Value;
    }
}

@functions {
    ParamsFunc<string, object, string> _R => Model.GetResource;
}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="@_R("表格")" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="@_R("姓名")" DataField="Name" Width="150" />
            <f:RenderField HeaderText="@_R("性别")" DataField="Gender" FieldType="Int" RendererFunction="renderGender" Width="150" />
            <f:RenderField HeaderText="@_R("入学年份")" DataField="EntranceYear" FieldType="Int" Width="150" />
            <f:RenderCheckField HeaderText="@_R("是否在校")" DataField="AtSchool" RenderAsStaticField="true" Width="150" />
            <f:RenderField HeaderText="@_R("所学专业")" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="@_R("分组")" DataField="Group" RendererFunction="renderGroup" Width="150" />
            <f:RenderField HeaderText="@_R("注册日期")" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" Width="150" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="@_R("选中了哪些行")" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <!-- 输出多语言资源 -->
    <script id="grid-resources" type="application/json">@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(resources, jsonSettings))</script>
    <script type="text/javascript">
        // 资源内容只作为 JSON 数据解析，翻译中的引号或 HTML 不会变成可执行脚本。
        F.setResources(JSON.parse(document.getElementById('grid-resources').textContent));
    </script>

}
