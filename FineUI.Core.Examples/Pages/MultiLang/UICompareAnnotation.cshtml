@page
@model FineUI.Core.Examples.Pages.MultiLang.UICompareAnnotationModel
@{
    ViewBag.SourceFiles = "~/Pages/MultiLang/Models/UICompareModel.cs";
    ViewBag.Title = "MultiLang/UICompareAnnotation";
    var F = Html.F();
}

@functions {
    ParamsFunc<string, object, string> _R => Model.GetResource;
}


@section body {

    <f:SimpleForm IsFluid="true" ID="SimpleForm1" BodyPadding="10" LabelWidth="200" ShowBorder="true" ShowHeader="true" Title="@_R("简单表单")">
        <Items>
            <f:DatePicker For="TheModel.StartDate"></f:DatePicker>
            <f:DatePicker For="TheModel.EndDate"></f:DatePicker>
            <f:Label></f:Label>
            <f:TextBox For="TheModel.Password"></f:TextBox>
            <f:TextBox For="TheModel.ConfirmPassword"></f:TextBox>
            <f:Label></f:Label>
            <f:NumberBox For="TheModel.Number1"></f:NumberBox>
            <f:NumberBox For="TheModel.Number2"></f:NumberBox>
            <f:Label></f:Label>
            <f:Button ID="btnSubmit" CssClass="marginr" _ValidateForms="SimpleForm1" Text="@_R("提交表单")" OnClick="btnSubmit_Click" OnClickFields="SimpleForm1"></f:Button>
            <f:Button ID="btnReset" Text="@_R("重置表单")" ClickHandler="onResetClick"></f:Button>
        </Items>
    </f:SimpleForm>


    @* <form id="commentForm" method="post" action="">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="TheModel.Password" class="control-label"></label>
            <input asp-for="TheModel.Password" class="form-control" />
            <span asp-validation-for="TheModel.Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="TheModel.ConfirmPassword" class="control-label"></label>
            <input asp-for="TheModel.ConfirmPassword" class="form-control" />
            <span asp-validation-for="TheModel.ConfirmPassword" class="text-danger"></span>
        </div>

        <input type="submit" value="提交" />
    </form> *@

   
}

@section script {

    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>从本地化资源和模型注解生成多语言界面，验证提示也随语言切换。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>切换界面语言</h3>
    <ul>
        <li>使用页面提供的中文、英文语言链接分别进入本页。<br />结果：<strong class="example-control-reference" data-example-control="SimpleForm1" title="简单表单">简单表单</strong>的标题、字段标签或列头、按钮文字按所选语言重新生成；此操作重新加载页面。</li>
        <li>在英文界面将<strong class="example-control-reference" data-example-control="TheModel_EndDate" title="结束日期">结束日期</strong>设为开始日期之前，再提交。<br />结果：验证提示也使用当前语言；标签翻译和验证消息保持一致。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Display / 验证注解</code>（<strong class="example-control-reference" data-example-control="SimpleForm1" title="简单表单">简单表单</strong>）：字段或列的显示名称与验证消息引用本地化资源，按当前语言解析。</li>
        <li><code>语言参数</code>（<strong class="example-control-reference" data-example-control="SimpleForm1" title="简单表单">简单表单</strong>）：语言链接重新请求当前页面，由本端语言设置选择资源，不是仅替换一段可见文本。</li>
    </ul>
</section>
}
