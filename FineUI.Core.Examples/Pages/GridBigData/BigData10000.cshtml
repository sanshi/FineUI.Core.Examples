@page
@model FineUI.Core.Examples.Pages.GridBigData.BigData10000Model
@{
    ViewBag.Title = "GridBigData/BigData10000";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（10,000行）" DataIDField="Id" DataTextField="Name"
            EnableCheckBoxSelect="true" Height="500" EnableBigData="true" FixedRowHeight="true"
            EnableBigDataRowTip="true" PagingToolbarVisible="false">
        <Columns>
            <f:RowNumberField Width="50" />
            <f:RenderField HeaderText="姓名" DataField="Name" Width="150" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>用虚拟渲染显示 10000 条记录，滚动时只绘制当前视口附近的行。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>滚动到大量记录的中后部</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格（10,000行）">表格（10,000行）</strong>内部持续向下滚动，再返回顶部。<br />结果：视口中的行随滚动位置更新，行数提示反映当前范围与总数；数据规模为 10000 条，不需要同时为每条记录保留完整可见行 DOM。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableBigData</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格（10,000行）">表格（10,000行）</strong>）：初始为 <code>true</code>，启用按可视位置绘制数据行的模式。</li>
        <li><code>FixedRowHeight</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格（10,000行）">表格（10,000行）</strong>）：初始为 <code>true</code>，使用固定行高计算滚动位置及可见范围。</li>
        <li><code>EnableBigDataRowTip</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格（10,000行）">表格（10,000行）</strong>）：初始为 <code>true</code>，滚动时提示当前显示范围和全部行数。</li>
    </ul>
</section>
}
