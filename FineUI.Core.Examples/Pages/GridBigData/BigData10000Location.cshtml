@page
@model FineUI.Core.Examples.Pages.GridBigData.BigData10000LocationModel
@{
    ViewBag.Title = "GridBigData/BigData10000Location";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（10,000行）" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
        Height="500" EnableBigData="true" FixedRowHeight="true" EnableBigDataRowTip="false" PagingToolbarVisible="false">
        <Columns>
            <f:RowNumberField Width="50" />
            <f:RenderField HeaderText="姓名" DataField="Name" Width="150" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
        </Columns>
        <Toolbars>
            <f:Toolbar Position="Bottom">
                <Items>
                    <f:Label Text="转到行："></f:Label>
                    <f:NumberBox ID="nbRowNumber" MinValue="1" MaxValue="10000" Text="1000" Increment="100" EnableCommas="true">
                    </f:NumberBox>
                    <f:Button ID="btnGoToRow" Text="Go" ClickHandler="onGotoRow"></f:Button>
                    <f:ToolbarFill></f:ToolbarFill>
                    <f:Label ID="labCurrentPosition"></f:Label>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        // 转到行
        function onGotoRow(event) {
            // scrollToRow的参数是行索引，而 nbRowNumber 取得的是行序号
            F.ui.Grid1.scrollToRow(F.ui.nbRowNumber.getValue() - 1);
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>输入从 1 开始的行号，把大数据表格滚动到指定记录。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>直接跳到中间记录</h3>
        <ol>
            <li>在<strong class="example-control-reference" data-example-control="nbRowNumber" title="转到行">转到行</strong>输入<code>5000</code>，点击<strong
                    class="example-control-reference" data-example-control="btnGoToRow" title="Go">Go</strong>。<br />结果：浏览器滚动到第 5000 行附近并渲染该位置的记录，不必逐页翻到该行。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>scrollToRow</code>（<strong>定位脚本</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（10,000行）">表格（10,000行）</strong>）：方法接收从 0 开始的行索引，本页把输入行号减 1 后再传入。</li>
            <li><code>EnableBigDataRowTip</code>（<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（10,000行）">表格（10,000行）</strong>）：初始为 <code>false</code>，本页关闭默认悬浮行数提示，定位或自定义标签按本页脚本处理。</li>
        </ul>
    </section>
}
