@page
@model FineUI.Core.Examples.Pages.GridBigData.BigDataUrl10000PagingDatabaseModel
@{
    ViewBag.SourceFiles = "~/GridBigData/BigDataUrlPagingDatabaseData";
    ViewBag.Title = "GridBigData/BigDataUrl10000PagingDatabase";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（网址数据源，10,000行）" DataIDField="Id" DataTextField="Name"
            DataUrl="@Url.Content("~/GridBigData/BigDataUrlPagingDatabaseData?total=10000&type=simple")"
            EnableCheckBoxSelect="true" Height="500" EnableBigData="true" EnableBigDataRowTip="false" FixedRowHeight="true"
            AllowPaging="true" IsDatabasePaging="true" PageSize="120"
            EnableBigDataRowTip="false" PagingToolbarVisible="true">
        <Columns>
            <f:RowNumberField Width="50" EnablePagingNumber="true" />
            <f:RenderField HeaderText="姓名" DataField="Name" Width="150" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <br>
    <br>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>在大数据虚拟渲染基础上使用服务端分页，区分当前页加载范围。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>分页与虚拟渲染共同工作</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="Grid1" title="表格（网址数据源，10,000行）">表格（网址数据源，10,000行）</strong>下一页，再在当前页内滚动。<br />结果：后台或数据接口只提供当前页记录及总数，浏览器在本页内部虚拟渲染，翻页后记录和页码一致更新。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <p>注：启用大数据，启用分页（服务端分页），每页显示 120 条记录。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>IsDatabasePaging</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格（网址数据源，10,000行）">表格（网址数据源，10,000行）</strong>）：初始为 <code>true</code>，仅让本页记录进入本次分页数据，全部条数另行提供。</li>
        <li><code>PageSize</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格（网址数据源，10,000行）">表格（网址数据源，10,000行）</strong>）：初始为 <code>120</code>，确定每页最大记录数，与视口中实际渲染行数是不同概念。</li>
    </ul>
</section>
}
