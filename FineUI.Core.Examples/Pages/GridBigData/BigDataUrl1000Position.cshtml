@page
@model FineUI.Core.Examples.Pages.GridBigData.BigDataUrl1000PositionModel
@{
    ViewBag.SourceFiles = "~/GridBigData/BigDataUrlData";
    ViewBag.Title = "GridBigData/BigDataUrl1000Position";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（网址数据源，1,000行）" DataIDField="Id" DataTextField="Name"
            DataUrl="@Url.Content("~/GridBigData/BigDataUrlData?total=1000&type=simple")"
            EnableCheckBoxSelect="true" Height="500" EnableBigData="true" FixedRowHeight="true"
            EnableBigDataRowTip="true" PagingToolbarVisible="true" BigDataRowTipPosition="PagingToolbar">
        <Columns>
            <f:RowNumberField Width="50" />
            <f:RenderField HeaderText="姓名" DataField="Name" Width="150" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>
    <br />
    <br />

    <br />

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>把大数据可见行范围提示放到分页工具栏，滚动时直接更新栏中文字。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>在底栏查看当前范围</h3>
    <ul>
        <li>滚动<strong class="example-control-reference" data-example-control="Grid1" title="表格（网址数据源，1,000行）">表格（网址数据源，1,000行）</strong>到中间位置。<br />结果：分页工具栏的显示起止行号随视口变化，总数仍为本页全部记录；不再依靠悬浮位置显示该提示。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <p>注：行数提示显式在分页工具栏中（需启用EnableBigDataRowTip和PagingToolbarVisible，并设置BigDataRowTipPosition=PagingToolbar）。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>BigDataRowTipPosition</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格（网址数据源，1,000行）">表格（网址数据源，1,000行）</strong>）：初始为 <code>PagingToolbar</code>，采用 PagingToolbar，把范围信息放在表格底栏。</li>
        <li><code>PagingToolbarVisible</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格（网址数据源，1,000行）">表格（网址数据源，1,000行）</strong>）：初始为 <code>true</code>，显示承载范围文字的工具栏。</li>
    </ul>
</section>
}
