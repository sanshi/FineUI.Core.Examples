@page
@model FineUI.Core.Examples.Pages.GridBigData.BigData10000PagingModel
@{
    ViewBag.Title = "GridBigData/BigData10000Paging";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（10,000行）" DataIDField="Id" DataTextField="Name"
            EnableCheckBoxSelect="true" Height="500" EnableBigData="true" EnableBigDataRowTip="false" FixedRowHeight="true"
            AllowPaging="true" IsDatabasePaging="false" PageSize="120"
            EnableBigDataRowTip="false" PagingToolbarVisible="true">
        <Columns>
            <f:RowNumberField Width="50" EnablePagingNumber="true" />
            <f:RenderField HeaderText="姓名" DataField="Name" Width="150" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <br>
    <br>
    注：启用大数据，启用分页，每页显示 120 条记录。
}


@section script {

    <script src="~/res/js/grid.js"></script>

}
