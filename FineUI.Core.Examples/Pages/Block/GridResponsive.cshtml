@page
@model FineUI.Core.Examples.Pages.Block.GridResponsiveModel
@{
    ViewBag.SourceFiles = "~/wwwroot/res/css/responsive-card.css;~/wwwroot/res/js/grid.js;~/wwwroot/res/js/responsive-card.js";
    ViewBag.Title = "Block/GridResponsive";
    var F = Html.F();
}

@section head {

    <link href="~/res/css/responsive-card.css?v@(GlobalConfig.ProductVersion)" rel="stylesheet" />

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" CssClass="responsive-card-grid" ShowBorder="true" ShowHeader="true" Title="表格"
            EnableCheckBoxSelect="true" EnableAlternateRowColor="true" EnableRowLines="true" KeepCurrentSelection="true"
            DataIDField="Id" DataTextField="Name" _DataAttributeFields="Name,Gender,Avatar,EntranceYear,Status,Desc"
            Height="600" ResponsiveCardSize="MD" CardRendererFunction="renderResponsiveCard"
           >
        <Columns>
            <f:RenderField ColumnID="UserProfile" Width="250" RendererFunction="renderUserProfile" HeaderText="基本信息"></f:RenderField>
            <f:RenderCheckField ColumnID="AtSchool" DataField="AtSchool" RenderAsStaticField="true" HeaderText="是否在校" />
            <f:RenderField Width="150" ColumnID="Rate1" DataField="Rate1" FieldType="Int" HeaderText="评分" RendererFunction="renderRate1" />
            <f:RenderField ColumnID="Major" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" HeaderText="所学专业"></f:RenderField>
            <f:RenderField ColumnID="Status" DataField="Status" RendererFunction="renderStatus" HeaderText="状态" />
        </Columns>
    </f:Grid>
    <br />
    <div style="padding: 0 10px; line-height: 1.8;">

    </div>

}

@section script {

    <script src="~/res/js/grid.js"></script>
    <script src="~/res/js/responsive-card.js"></script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示同一份表格数据在较宽屏幕使用表格，在较窄屏幕改为卡片展示。</p>
    <h3><i class="f-iconfont f-iconfont-layout" aria-hidden="true"></i>切换表格与卡片视图</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>选择一项，再把浏览器从桌面宽度缩到手机宽度。<br />结果：同一数据改为本页定义的卡片内容；选择状态与业务记录标识对应，不因视图切换重复创建业务数据。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <ul>
        <li>缩放浏览器窗口（或在手机/平板上打开）：屏幕宽度小于 <code>992px</code>（中屏以下）时，表格自动切换为卡片模式；否则显示为普通表格。通过 <code>ResponsiveCardSize</code> 实现，由屏幕尺寸主导显示模式。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>ResponsiveCardSize</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：指定切换为卡片视图的响应尺寸。 本页使用<code>MD</code>。</li>
        <li><code>CardRendererFunction</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：使用本页客户端函数渲染卡片中的姓名、状态等内容。 本页使用<code>renderResponsiveCard</code>。</li>
        <li><code>DataIDField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：使用数据中的稳定行标识对应当前选择。 本页使用<code>Id</code>。</li>
    </ul>
</section>
}
