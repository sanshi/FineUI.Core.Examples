@page
@model FineUI.Core.Examples.Pages.Block.XsMdLgModel
@{
    ViewBag.Title = "Block/XsMdLg";

    ViewBag.IsDarkerBG = true;

    var F = Html.F();
}

@section head {

    <style>
        body.f-body {
            overflow-x: hidden;
        }

        .custompanel {
            min-height: 200px;
        }
    </style>

}

@section body {

    <f:Panel ID="PanelExample1" IsFluid="true" Layout="Block" BlockConfigSpace="20" ShowBorder="false" ShowHeader="false">
        <Items>
            <f:Panel ID="PanelExample2" CssClass="custompanel" Block="6" BlockMD="4" BlockLG="3" ShowBorder="true" ShowHeader="true" Title="1">
            </f:Panel>
            <f:Panel CssClass="custompanel" Block="6" BlockMD="8" BlockLG="3" ShowBorder="true" ShowHeader="true" Title="2">
            </f:Panel>
            <f:Panel CssClass="custompanel" Block="12" BlockMD="8" BlockLG="3" ShowBorder="true" ShowHeader="true" Title="3">
            </f:Panel>
            <f:Panel CssClass="custompanel" Block="6" BlockMD="4" BlockLG="3" ShowBorder="true" ShowHeader="true" Title="4">
            </f:Panel>
            <f:Panel CssClass="custompanel" Block="6" BlockMD="12" BlockLG="9" ShowBorder="true" ShowHeader="true" Title="5">
            </f:Panel>
            <f:Panel CssClass="custompanel" Block="12" BlockMD="6" BlockLG="3" ShowBorder="true" ShowHeader="true" Title="6">
            </f:Panel>
            <f:Panel CssClass="custompanel" Block="6" BlockMD="6" BlockLG="6" ShowBorder="true" ShowHeader="true" Title="7">
            </f:Panel>
            <f:Panel CssClass="custompanel" Block="6" BlockMD="12" BlockLG="6" ShowBorder="true" ShowHeader="true" Title="8">
            </f:Panel>
        </Items>
    </f:Panel>


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示分别为手机、桌面和大屏定义列宽。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>调整宽度比较排列</h3>
        <ul>
            <li>对照<strong class="example-control-reference" data-example-control="PanelExample1" title="第 1 个面板">第 1
                    个面板</strong>，依次使用窄屏、桌面和更宽的大屏尺寸。<br />结果：到达对应临界值后使用对应占比；桌面与大屏的首行项目数可以不同。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Block</code>（本页各面板，如<strong class="example-control-reference" data-example-control="PanelExample2"
                    title="1">1</strong>）：各组分别设为<code>6</code>、<code>12</code>，子项在默认宽度区间占用的列数。</li>
            <li><code>BlockMD</code>（本页各面板，如<strong class="example-control-reference" data-example-control="PanelExample2"
                    title="1">1</strong>）：各组分别设为<code>4</code>、<code>8</code>、<code>12</code>、<code>6</code>，指定当前子项在相应宽度区间占用的块数，未达到临界值时使用较小区间的设置。</li>
            <li><code>BlockLG</code>（本页各面板，如<strong class="example-control-reference" data-example-control="PanelExample2"
                    title="1">1</strong>）：各组分别设为<code>3</code>、<code>9</code>、<code>6</code>，指定当前子项在相应宽度区间占用的块数，未达到临界值时使用较小区间的设置。</li>
        </ul>
    </section>
}
