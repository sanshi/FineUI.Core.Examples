@page
@model FineUI.Core.Examples.Pages.Block.FormModel
@{
    ViewBag.Title = "Block/Form";

    ViewBag.IsDarkerBG = true;

    var F = Html.F();
}

@section head {

    <style>
        .myblockform .f-panel-body .f-field {
            margin: 0;
        }
    </style>

}

@section body {

    <f:Panel ID="PanelExample1" IsFluid="true" Layout="Block" BlockConfigSpace="20" ShowBorder="false" ShowHeader="false">
        <Items>
            <f:Panel ID="PanelExample2" BlockMD="6" Layout="Block" BlockConfigSpace="20" ShowBorder="false" ShowHeader="false">
                <Items>
                    <f:Panel ID="Panel1" CssClass="myblockform" BlockMD="12" EnableCollapse="true" Layout="Block" BlockConfigSpace="20" BodyPadding="10" ShowBorder="true" ShowHeader="true" Title="表单 1">
                        <Items>
                            <f:Label ID="Label1" BlockMD="6" Label="标签" Text="标签的值">
                            </f:Label>
                            <f:CheckBox ID="CheckBox1" BlockMD="6" Text="复选框" Label="复选框">
                            </f:CheckBox>
                            <f:DropDownList ID="DropDownList1" BlockMD="6" Required="true" ShowRedStar="true" AutoSelectFirstItem="false" Label="下拉列表">
                                <f:ListItem Text="可选项 1" Value="0"></f:ListItem>
                                <f:ListItem Text="可选项 2" Value="2"></f:ListItem>
                                <f:ListItem Text="可选项 3" Value="3"></f:ListItem>
                                <f:ListItem Text="可选项 4" Value="4"></f:ListItem>
                                <f:ListItem Text="可选项 5" Value="5"></f:ListItem>
                                <f:ListItem Text="可选项 6" Value="6"></f:ListItem>
                                <f:ListItem Text="可选项 7" Value="7"></f:ListItem>
                                <f:ListItem Text="可选项 8" Value="8"></f:ListItem>
                            </f:DropDownList>
                            <f:TextBox ID="TextBox1" BlockMD="6" ShowRedStar="true" Label="文本框" Required="true" Text="">
                            </f:TextBox>
                            <f:Button BlockMD="12" Text="验证此表单并提交" _ValidateForms="Panel1" ID="btnSubmitForm1" OnClick="btnSubmitForm1_Click"></f:Button>
                        </Items>
                    </f:Panel>
                    <f:Panel ID="Panel2" CssClass="myblockform" BlockMD="12" EnableCollapse="true" Layout="Block" BlockConfigSpace="20" BodyPadding="10" ShowBorder="true" ShowHeader="true" Title="表单 2">
                        <Items>
                            <f:DatePicker BlockMD="6" EnableEdit="false" Required="true" Label="日期" EmptyText="请选择日期"
                                          ID="DatePicker1" SelectedDate="@DateTime.Parse("2014-07-10")" ShowRedStar="true">
                            </f:DatePicker>
                            <f:TimePicker ID="TimePicker1" BlockMD="6" EnableEdit="false" ShowRedStar="true" Label="时间" Increment="30"
                                          Required="true" Text="08:30" EmptyText="请选择时间">
                            </f:TimePicker>
                            <f:CheckBox BlockMD="12" ID="cbxAtSchool" Label="是否在读"></f:CheckBox>
                            <f:CheckBoxList ID="CheckBoxList1" BlockMD="12" Label="复选框列表" ColumnNumber="3">
                                <f:CheckItem Text="可选项 1" Value="value1" />
                                <f:CheckItem Text="可选项 2" Value="value2" Selected="true" />
                                <f:CheckItem Text="可选项 3" Value="value3" Selected="true" />
                                <f:CheckItem Text="可选项 4" Value="value4" Selected="true" />
                                <f:CheckItem Text="可选项 5" Value="value5" Selected="true" />
                            </f:CheckBoxList>
                            <f:RadioButtonList ID="RadioButtonList2" BlockMD="12" Label="单选框列表" Required="true" ColumnNumber="3">
                                <f:RadioItem Text="可选项 1" Value="value1" />
                                <f:RadioItem Text="可选项 2" Value="value2" />
                                <f:RadioItem Text="可选项 3" Value="value3" />
                                <f:RadioItem Text="可选项 4" Value="value4" />
                                <f:RadioItem Text="可选项 5" Value="value5" />
                            </f:RadioButtonList>
                        </Items>
                        <Toolbars>
                            <f:Toolbar Position="Bottom" ToolbarAlign="Center">
                                <Items>
                                    <f:Button ID="btnSubmitForm2" Text="验证此表单并提交" OnClick="btnSubmitForm2_Click" _ValidateForms="Panel2"></f:Button>
                                </Items>
                            </f:Toolbar>
                        </Toolbars>
                    </f:Panel>
                </Items>
            </f:Panel>
            <f:Panel ID="Panel3" CssClass="myblockform" BlockMD="6" EnableCollapse="true" Layout="Block" BlockConfigSpace="20" BodyPadding="10" ShowBorder="true" ShowHeader="true" Title="表单 3">
                <Items>
                    <f:Label ID="Label3" BlockMD="6" Label="电话" Text="0551-1234567" />
                    <f:Label ID="Label16" BlockMD="6" Label="申请人" Text="admin">
                    </f:Label>
                    <f:Label ID="Label4" BlockMD="6" Label="编号" Text="200804170006" />
                    <f:TextBox ID="TextBox2" BlockMD="6" Required="true" ShowRedStar="true" Label="电子邮箱" RegexPattern="EMAIL" RegexMessage="请输入有效的邮箱地址">
                    </f:TextBox>
                    <f:DropDownList ID="DropDownList3" BlockMD="12" Label="审批人" Required="true" ShowRedStar="true" EmptyText="请选择审批人" AutoSelectFirstItem="false">
                        <f:ListItem Text="老大甲" Value="0"></f:ListItem>
                        <f:ListItem Text="老大乙" Value="1"></f:ListItem>
                        <f:ListItem Text="老大丙" Value="2"></f:ListItem>
                        <f:ListItem Text="老大丁" Value="3"></f:ListItem>
                        <f:ListItem Text="老大午" Value="4"></f:ListItem>
                        <f:ListItem Text="老大己" Value="5"></f:ListItem>
                    </f:DropDownList>
                    <f:NumberBox ID="NumberBox1" BlockMD="12" Label="申请数量" NoDecimal="true" NoNegative="true" MaxValue="1000" Required="true" ShowRedStar="true" />
                    <f:TextArea ID="TextArea1" BlockMD="12" Label="描述" ShowRedStar="true" Required="true">
                        </f:TextArea>
                    <f:Panel ID="PanelExample6" BlockMD="12" ShowBorder="false" ShowHeader="false">
                        <Items>
                            <f:Button ID="btnSubmitForm3" Text="验证此表单并提交" OnClick="btnSubmitForm3_Click" _ValidateForms="Panel3"></f:Button>
                        </Items>
                    </f:Panel>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>


}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示在 <code>Block</code> 布局中组织响应式表单，让字段按可用宽度分列或层叠。</p>
    <h3><i class="f-iconfont f-iconfont-layout" aria-hidden="true"></i>调整宽度与分别验证</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="PanelExample1" title="第 1 个面板">第 1 个面板</strong>填写一个文本字段，再缩小和放大浏览器。<br />结果：字段随各自的块宽度重新排列，已经填写的值继续保留。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnSubmitForm1" title="第 1 个按钮（验证此表单并提交）">第 1 个按钮（验证此表单并提交）</strong>。<br />结果：只验证按钮对应的表单区域；必填字段不完整时显示错误，验证通过后才执行本页后台处理。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Layout</code>（本页各面板，如<strong class="example-control-reference" data-example-control="PanelExample1" title="第 1 个面板">第 1 个面板</strong>）：表单区域使用 <code>Block</code> 布局。 本页使用<code>Block</code>。</li>
        <li><code>BlockMD</code>（<strong class="example-control-reference" data-example-control="PanelExample2" title="第 2 个面板">第 2 个面板</strong>、<strong class="example-control-reference" data-example-control="Panel1" title="表单 1">表单 1</strong>、<strong class="example-control-reference" data-example-control="Label1" title="标签">标签</strong>、<strong class="example-control-reference" data-example-control="CheckBox1" title="复选框">复选框</strong>、<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>、<strong class="example-control-reference" data-example-control="TextBox1" title="文本框">文本框</strong>、<strong class="example-control-reference" data-example-control="btnSubmitForm1" title="第 1 个按钮（验证此表单并提交）">第 1 个按钮（验证此表单并提交）</strong>、<strong class="example-control-reference" data-example-control="Panel2" title="表单 2">表单 2</strong>、<strong class="example-control-reference" data-example-control="DatePicker1" title="日期">日期</strong>、<strong class="example-control-reference" data-example-control="TimePicker1" title="时间">时间</strong>、<strong class="example-control-reference" data-example-control="cbxAtSchool" title="是否在读">是否在读</strong>、<strong class="example-control-reference" data-example-control="CheckBoxList1" title="复选框列表">复选框列表</strong>、<strong class="example-control-reference" data-example-control="RadioButtonList2" title="单选框列表">单选框列表</strong>、<strong class="example-control-reference" data-example-control="Panel3" title="表单 3">表单 3</strong>、<strong class="example-control-reference" data-example-control="Label3" title="电话">电话</strong>、<strong class="example-control-reference" data-example-control="Label16" title="申请人">申请人</strong>、<strong class="example-control-reference" data-example-control="Label4" title="编号">编号</strong>、<strong class="example-control-reference" data-example-control="TextBox2" title="电子邮箱">电子邮箱</strong>、<strong class="example-control-reference" data-example-control="DropDownList3" title="审批人">审批人</strong>、<strong class="example-control-reference" data-example-control="NumberBox1" title="申请数量">申请数量</strong>、<strong class="example-control-reference" data-example-control="TextArea1" title="描述">描述</strong>、<strong class="example-control-reference" data-example-control="PanelExample6" title="第 6 个面板">第 6 个面板</strong>）：对应字段在桌面宽度下占指定块数，较窄时按小屏规则排列。 本页各组分别使用<code>6</code>、<code>12</code>。</li>
        <li><code>_ValidateForms</code>（<strong class="example-control-reference" data-example-control="btnSubmitForm1" title="第 1 个按钮（验证此表单并提交）">第 1 个按钮（验证此表单并提交）</strong>）：按钮只验证绑定的表单区域。 本页使用<code>Panel1</code>。</li>
    </ul>
</section>
}
