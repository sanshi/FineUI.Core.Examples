@page
@model FineUI.Core.Examples.Pages.Block.NestingLeftRightModel
@{
    ViewBag.Title = "Block/NestingLeftRight";

    ViewBag.IsDarkerBG = true;

    var F = Html.F();
}

@section head {

    <style>
        body.f-body {
            overflow-x: hidden;
        }
    </style>

}

@section body {

    <f:Panel ID="PanelExample1" IsFluid="true" Layout="Block" BlockConfigSpace="20" ShowBorder="false" ShowHeader="false">
        <Items>
            <f:Panel ID="PanelExample2" BlockMD="8"
                     Layout="Block" BlockConfigSpace="20" ShowBorder="false" ShowHeader="false">
                <Items>
                    <f:Panel BlockMD="6" Height="300"
                             ShowBorder="true" ShowHeader="true" Title="1">
                    </f:Panel>
                    <f:Panel BlockMD="6" Height="300"
                             ShowBorder="true" ShowHeader="true" Title="2">
                    </f:Panel>
                    <f:Panel BlockMD="12" Height="400"
                             ShowBorder="true" ShowHeader="true" Title="3">
                    </f:Panel>
                    <f:Panel BlockMD="12" Height="400"
                             ShowBorder="true" ShowHeader="true" Title="4">
                    </f:Panel>
                </Items>
            </f:Panel>
            <f:Panel ID="PanelExample7" BlockMD="4" Layout="Block" BlockConfigSpace="20" ShowBorder="false" ShowHeader="false">
                <Items>
                    <f:Panel BlockMD="12" Height="300"
                             ShowBorder="true" ShowHeader="true" Title="5">
                    </f:Panel>
                    <f:Panel BlockMD="12" Height="200"
                             ShowBorder="true" ShowHeader="true" Title="6">
                    </f:Panel>
                    <f:Panel BlockMD="12" Height="200"
                             ShowBorder="true" ShowHeader="true" Title="7">
                    </f:Panel>
                    <f:Panel BlockMD="12" Height="200"
                             ShowBorder="true" ShowHeader="true" Title="8">
                    </f:Panel>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>


}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示把左右两组各自的 <code>Block</code> 布局嵌入外层布局。</p>
    <h3><i class="f-iconfont f-iconfont-layout" aria-hidden="true"></i>调整宽度比较排列</h3>
    <ul>
        <li>对照<strong class="example-control-reference" data-example-control="PanelExample1" title="第 1 个面板">第 1 个面板</strong>，改变浏览器宽度，对照左、右分组及各自子块。<br />结果：左右组按外层占比排列，各自内部再独立分配列宽；左组保持本页较大的占比。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="PanelExample1" title="第 1 个面板">第 1 个面板</strong>、<strong class="example-control-reference" data-example-control="PanelExample2" title="第 2 个面板">第 2 个面板</strong>、<strong class="example-control-reference" data-example-control="PanelExample7" title="第 7 个面板">第 7 个面板</strong>）：父容器使用 <code>Block</code>，按可用宽度排列内容块。 本页使用<code>Block</code>。</li>
        <li><code>BlockMD</code>（本页各面板，如<strong class="example-control-reference" data-example-control="PanelExample2" title="第 2 个面板">第 2 个面板</strong>）：指定当前子项在相应宽度区间占用的块数，未达到临界值时使用较小区间的设置。 本页各组分别使用<code>8</code>、<code>6</code>、<code>12</code>、<code>4</code>。</li>
    </ul>
</section>
}
