@page
@model FineUI.Core.Examples.Pages.Block.NestingLeftRightModel
@{
    ViewBag.Title = "Block/NestingLeftRight";

    ViewBag.IsDarkerBG = true;

    var F = Html.F();
}

@section head {

    <style>
        body.f-body {
            overflow-x: hidden;
        }
    </style>

}

@section body {

    <f:Panel IsFluid="true" Layout="Block" BlockConfigSpace="20" ShowBorder="false" ShowHeader="false">
        <Items>
            <f:Panel BlockMD="8"
                     Layout="Block" BlockConfigSpace="20" ShowBorder="false" ShowHeader="false">
                <Items>
                    <f:Panel BlockMD="6" Height="300"
                             ShowBorder="true" ShowHeader="true" Title="1">
                    </f:Panel>
                    <f:Panel BlockMD="6" Height="300"
                             ShowBorder="true" ShowHeader="true" Title="2">
                    </f:Panel>
                    <f:Panel BlockMD="12" Height="400"
                             ShowBorder="true" ShowHeader="true" Title="3">
                    </f:Panel>
                    <f:Panel BlockMD="12" Height="400"
                             ShowBorder="true" ShowHeader="true" Title="4">
                    </f:Panel>
                </Items>
            </f:Panel>
            <f:Panel BlockMD="4" Layout="Block" BlockConfigSpace="20" ShowBorder="false" ShowHeader="false">
                <Items>
                    <f:Panel BlockMD="12" Height="300"
                             ShowBorder="true" ShowHeader="true" Title="5">
                    </f:Panel>
                    <f:Panel BlockMD="12" Height="200"
                             ShowBorder="true" ShowHeader="true" Title="6">
                    </f:Panel>
                    <f:Panel BlockMD="12" Height="200"
                             ShowBorder="true" ShowHeader="true" Title="7">
                    </f:Panel>
                    <f:Panel BlockMD="12" Height="200"
                             ShowBorder="true" ShowHeader="true" Title="8">
                    </f:Panel>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>


}
