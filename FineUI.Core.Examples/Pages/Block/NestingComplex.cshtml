@page
@model FineUI.Core.Examples.Pages.Block.NestingComplexModel
@{
    ViewBag.Title = "Block/NestingComplex";

    ViewBag.IsDarkerBG = true;

    var F = Html.F();
}

@section head {

    <style>
        body.f-body {
            overflow-x: hidden;
        }
    </style>

}

@section body {

    <f:Panel ID="PanelExample1" IsFluid="true" Layout="Block" BlockConfigSpace="20" ShowBorder="false" ShowHeader="false">
        <Items>
            <f:Panel ID="PanelExample2" BlockMD="12" BlockLG="4" Layout="Block" BlockConfigSpace="20" ShowBorder="false" ShowHeader="false">
                <Items>
                    <f:Panel BlockMD="6" BlockLG="12" Height="200"
                             ShowBorder="true" ShowHeader="true" Title="1">
                    </f:Panel>
                    <f:Panel BlockMD="6" BlockLG="12" Height="200"
                             ShowBorder="true" ShowHeader="true" Title="2">
                    </f:Panel>
                </Items>
            </f:Panel>
            <f:Panel ID="PanelExample5" BlockMD="12" BlockLG="8" Layout="Block" BlockConfigSpace="20" ShowBorder="false" ShowHeader="false">
                <Items>
                    <f:Panel BlockSM="6" BlockMD="3" Height="150"
                             ShowBorder="true" ShowHeader="true" Title="3">
                    </f:Panel>
                    <f:Panel BlockSM="6" BlockMD="3" Height="150"
                             ShowBorder="true" ShowHeader="true" Title="4">
                    </f:Panel>
                    <f:Panel BlockSM="6" BlockMD="3" Height="150"
                             ShowBorder="true" ShowHeader="true" Title="5">
                    </f:Panel>
                    <f:Panel BlockSM="6" BlockMD="3" Height="150"
                             ShowBorder="true" ShowHeader="true" Title="6">
                    </f:Panel>
                    <f:Panel Block="12" Height="250"
                             ShowBorder="true" ShowHeader="true" Title="7">
                    </f:Panel>
                </Items>
            </f:Panel>
            <f:Panel ID="PanelExample11" BlockMD="12" Layout="Block" BlockConfigSpace="20" ShowBorder="false" ShowHeader="false">
                <Items>
                    <f:Panel BlockMD="4" Height="200"
                             ShowBorder="true" ShowHeader="true" Title="8">
                    </f:Panel>
                    <f:Panel BlockMD="4" Height="200"
                             ShowBorder="true" ShowHeader="true" Title="9">
                    </f:Panel>
                    <f:Panel BlockMD="4" Height="200"
                             ShowBorder="true" ShowHeader="true" Title="10">
                    </f:Panel>
                    <f:Panel Block="12" Height="300"
                             ShowBorder="true" ShowHeader="true" Title="11">
                    </f:Panel>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>


}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示组合多层嵌套的 <code>Block</code> 布局。</p>
    <h3><i class="f-iconfont f-iconfont-layout" aria-hidden="true"></i>调整宽度比较排列</h3>
    <ul>
        <li>对照<strong class="example-control-reference" data-example-control="PanelExample1" title="第 1 个面板">第 1 个面板</strong>，从外到内对照面板编号，并缩小浏览器。<br />结果：每层都以自己的内容宽度分配子块，各组按自身设置换行，编号和内容保留。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="PanelExample1" title="第 1 个面板">第 1 个面板</strong>、<strong class="example-control-reference" data-example-control="PanelExample2" title="第 2 个面板">第 2 个面板</strong>、<strong class="example-control-reference" data-example-control="PanelExample5" title="第 5 个面板">第 5 个面板</strong>、<strong class="example-control-reference" data-example-control="PanelExample11" title="第 11 个面板">第 11 个面板</strong>）：设为<code>Block</code>，父容器使用 <code>Block</code>，按可用宽度排列内容块。</li>
        <li><code>BlockMD</code>（本页各面板，如<strong class="example-control-reference" data-example-control="PanelExample2" title="第 2 个面板">第 2 个面板</strong>）：各组分别设为<code>12</code>、<code>6</code>、<code>3</code>、<code>4</code>，指定当前子项在相应宽度区间占用的块数，未达到临界值时使用较小区间的设置。</li>
        <li><code>BlockConfigSpace</code>（<strong class="example-control-reference" data-example-control="PanelExample1" title="第 1 个面板">第 1 个面板</strong>、<strong class="example-control-reference" data-example-control="PanelExample2" title="第 2 个面板">第 2 个面板</strong>、<strong class="example-control-reference" data-example-control="PanelExample5" title="第 5 个面板">第 5 个面板</strong>、<strong class="example-control-reference" data-example-control="PanelExample11" title="第 11 个面板">第 11 个面板</strong>）：设为<code>20</code>，父容器中相邻块之间的间隔。</li>
    </ul>
</section>
}
