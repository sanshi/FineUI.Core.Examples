@page
@model FineUI.Core.Examples.Pages.DropDownBox.GridModel
@{
    ViewBag.Title = "DropDownBox/Grid";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="下拉表格" ShowHeader="true">
        <Items>
            <f:DropDownBox ID="DropDownBox1" EmptyText="请从下拉表格中选择" MatchFieldWidth="false" Value="105" EnableMultiSelect="false">
                <PopPanel>
                    <f:Grid ID="Grid1" ShowBorder="true" ShowHeader="false" DataIDField="Id" DataTextField="Name"
                            Hidden="true" Width="550" Height="300" EnableMultiSelect="false">
                        <Columns>
                            <f:RenderField HeaderText="姓名" DataField="Name" />
                            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
                            <f:RenderField HeaderText="所学专业" DataField="Major" ExpandUnusedSpace="true" MinWidth="150" />
                        </Columns>
                    </f:Grid>
                </PopPanel>
            </f:DropDownBox>
            <f:Button ID="btnGetSelection" Text="获取下拉框的选中值" CssClass="marginr" OnClick="btnGetSelection_Click"></f:Button>
            <f:Button ID="btnReset" Text="重置表单" ClickHandler="onResetClick"></f:Button>
        </Items>
    </f:SimpleForm>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>

}

@section script {

    <script src="~/res/js/grid.js"></script>
    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }
    </script>


}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>在<strong class="example-control-reference" data-example-control="SimpleForm1" title="下拉表格">下拉表格</strong>中单选人员。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-radio-button-checked" aria-hidden="true"></i>选择并读取人员</h3>
        <ol>
            <li>
                展开<strong class="example-control-reference" data-example-control="SimpleForm1" title="下拉表格">下拉表格</strong>中选择<code>董婷婷</code>。<br />
                结果：该人员成为唯一选择，值为 <code>103</code>。
            </li>
            <li>
                收起可收起的面板后，点击<strong class="example-control-reference" data-example-control="btnGetSelection" title="获取下拉框的选中值">获取下拉框的选中值</strong>。<br />
                结果：回发后由后台显示当前人员名称及业务值。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>恢复初始选择</h3>
        <ol>
            <li>
                修改选择后点击<strong class="example-control-reference" data-example-control="btnReset" title="重置表单">重置表单</strong>。<br />
                结果：客户端恢复页面初始的选择值和显示文字，不再保留刚改选的人员。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableMultiSelect</code>（<strong class="example-control-reference" data-example-control="DropDownBox1" title="请从下拉表格中选择">请从下拉表格中选择</strong>）：决定<strong class="example-control-reference" data-example-control="DropDownBox1" title="请从下拉表格中选择">下拉框</strong>保留单个值还是多个值。 本页声明值为 <code>false</code>。</li>
            <li><code>Value</code>（<strong class="example-control-reference" data-example-control="DropDownBox1" title="请从下拉表格中选择">请从下拉表格中选择</strong>）：指定初始单选值或多选值数组。 本页声明值为 <code>105</code>。</li>
            <li><code>MatchFieldWidth</code>（<strong class="example-control-reference" data-example-control="DropDownBox1" title="请从下拉表格中选择">请从下拉表格中选择</strong>）：控制弹出面板是否强制匹配字段宽度。 本页声明值为 <code>false</code>。</li>
            <li><code>DataIDField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：从数据对象指定字段取得行值。 本页声明值为 <code>Id</code>。</li>
            <li><code>DataTextField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：从指定字段取得选中后显示的人员名称。 本页声明值为 <code>Name</code>。</li>
        </ul>
    </section>
}
