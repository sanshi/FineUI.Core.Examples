@page
@model FineUI.Core.Examples.Pages.DropDownBox.TagsGridMultiSelectModel
@{
    ViewBag.Title = "DropDownBox/TagsGridMultiSelect";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="下拉表格（多选）" ShowHeader="true">
        <Items>
            <f:DropDownBox ID="DropDownBox1" EmptyText="请从下拉表格中选择" MatchFieldWidth="false" EnableMultiSelect="true" _Values="105,108" MultiSelectMode="Tags">
                <PopPanel>
                    <f:Grid ID="Grid1" ShowBorder="true" ShowHeader="false" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true" Hidden="true"
                        Width="550" Height="300" EnableMultiSelect="true" KeepCurrentSelection="true">
                        <Columns>
                            <f:RenderField HeaderText="姓名" DataField="Name" />
                            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
                            <f:RenderField HeaderText="所学专业" DataField="Major" ExpandUnusedSpace="true" MinWidth="150" />
                            <f:RenderField DataField="Desc" RenderAsRowExpander="true" RendererFunction="renderExpander" />
                        </Columns>
                    </f:Grid>
                </PopPanel>
            </f:DropDownBox>
            <f:Button ID="btnGetSelection" Text="获取下拉框的选中值" CssClass="marginr" OnClick="btnGetSelection_Click"></f:Button>
            <f:Button ID="btnReset" Text="重置表单" ClickHandler="onResetClick"></f:Button>
        </Items>
    </f:SimpleForm>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>

}

@section script {

    <script src="~/res/js/grid.js"></script>
    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }
    </script>


}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>在<strong class="example-control-reference" data-example-control="SimpleForm1" title="下拉表格（多选）">下拉表格</strong>中多选人员，以标签显示和移除所选人员。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>移除一个选择标签</h3>
        <ol>
            <li>
                先在下拉面板选择两个可用项，再点击其中一个标签右侧的关闭图标。<br />
                结果：对应业务值与面板中的选择被取消，其它已选项保持不变。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>MultiSelectMode</code>（<strong class="example-control-reference" data-example-control="DropDownBox1"
                    title="请从下拉表格中选择">请从下拉表格中选择</strong>）：<code>Tags</code>/<code>tags</code> 将选中的每项显示为可单独移除的标签。 本页声明值为 <code>Tags</code>。</li>
        </ul>
    </section>
}
