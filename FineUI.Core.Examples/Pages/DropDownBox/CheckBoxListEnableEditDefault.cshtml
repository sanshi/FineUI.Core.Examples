@page
@model FineUI.Core.Examples.Pages.DropDownBox.CheckBoxListEnableEditDefaultModel
@{
    ViewBag.Title = "DropDownBox/CheckBoxListEnableEditDefault";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10px" EnableCollapse="false" ShowBorder="true" Title="下拉复选框列表" ShowHeader="true">
        <Items>
            <f:DropDownBox ID="DropDownBox1" DataControlID="CheckBoxList1" EnableMultiSelect="true" EnableEdit="true">
                <PopPanel>
                    <f:SimpleForm ID="SimpleForm2" BodyPadding="10px" AutoScroll="true" ShowBorder="true" ShowHeader="false" Hidden="true">
                        <Items>
                            <f:Label ID="Label1" Text="请选择编程语言："></f:Label>
                            <f:CheckBoxList ID="CheckBoxList1" ColumnNumber="3">
                                <f:CheckItem Text="C#" Value="csharp" />
                                <f:CheckItem Text="JavaScript" Value="js" />
                                <f:CheckItem Text="JAVA" Value="java" />
                                <f:CheckItem Text="Ruby" Value="ruby" />
                                <f:CheckItem Text="PHP" Value="php" />
                                <f:CheckItem Text="Objective-C" Value="objc" />
                                <f:CheckItem Text="Python" Value="python" />
                                <f:CheckItem Text="Perl" Value="perl" />
                                <f:CheckItem Text="C++" Value="cplusplus" />
                                <f:CheckItem Text="Basic" Value="basic" />
                                <f:CheckItem Text="Go" Value="go" />
                                <f:CheckItem Text="Swift" Value="swift" />
                            </f:CheckBoxList>
                        </Items>
                    </f:SimpleForm>
                </PopPanel>
            </f:DropDownBox>
            <f:Button ID="btnSelectItem6" Text="选中[php,basic]" OnClick="btnSelectItem6_Click" CssClass="marginr"></f:Button>
            <f:Button ID="btnSetText" Text="更新为[用户输入值]" runat="server" OnClick="btnSetText_Click" CssClass="marginr"></f:Button>
            <f:Button ID="btnSetCommaText" Text="输入[研发, 华东]" OnClick="btnSetCommaText_Click" CssClass="marginr"></f:Button>
            <f:Button ID="btnClearSelection" Text="清空选择" OnClick="btnClearSelection_Click" CssClass="marginr"></f:Button>
            <f:Button ID="btnGetSelection" Text="获取下拉框的选中值" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>


}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>在下拉面板内多选编程语言，允许输入列表之外的文字，以自定义文字作为初值。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>核对初始自由输入</h3>
        <ol>
            <li>
                初次打开页面，查看输入区。<br />
                结果：输入区显示“初始自定义值”；点击获取值时按用户输入文字处理。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableEdit</code>：允许输入列表之外的文字，选中项与自由输入按不同方式读取。 本页声明值为 true。</li>
            <li><code>SetUserInput()</code>：直接提供列表之外的输入文字，首次加载即可显示；不用伪造列表项。</li>
            <li><code>SetSelection()</code>：同时提供初始业务值和显示文字，让真实选项与自定义文字按位置对应。</li>
        </ul>
    </section>
}
