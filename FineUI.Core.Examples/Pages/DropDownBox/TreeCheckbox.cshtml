@page
@model FineUI.Core.Examples.Pages.DropDownBox.TreeCheckboxModel
@{
    ViewBag.Title = "DropDownBox/TreeCheckbox";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10px" EnableCollapse="false" ShowBorder="true" Title="下拉树" ShowHeader="true">
        <Items>
            <f:DropDownBox ID="DropDownBox1" EnableMultiSelect="true" _Values="henan,anhui" Text="河南省,安徽省" CustomData="true">
                <PopPanel>
                    <f:Tree ID="Tree1" ShowHeader="false" Hidden="true" EnableCheckBox="true">
                        <Nodes>
                            <f:TreeNode Text="中国" NodeID="china" Expanded="true">
                                <f:TreeNode Text="河南省" NodeID="henan" Expanded="true">
                                    <f:TreeNode Text="驻马店市" NodeID="zhumadian">
                                        <f:TreeNode Text="遂平县" Leaf="false" NodeID="suiping">
                                            <f:TreeNode Text="槐树乡" Leaf="false" NodeID="huaishu">
                                                <f:TreeNode Text="陈庄村" NodeID="chenzhuang">
                                                </f:TreeNode>
                                            </f:TreeNode>
                                        </f:TreeNode>
                                    </f:TreeNode>
                                    <f:TreeNode Text="漯河市" NodeID="luohe" />
                                </f:TreeNode>
                                <f:TreeNode Text="安徽省" Expanded="true" NodeID="anhui">
                                    <f:TreeNode Text="合肥市" Expanded="true" NodeID="hefei">
                                        <f:TreeNode Text="蜀山区" Expanded="false" NodeID="shushanqu">
                                            <f:TreeNode Text="金色池塘小区" NodeID="golden">
                                            </f:TreeNode>
                                            <f:TreeNode Text="梦圆小区" NodeID="mengyuan">
                                            </f:TreeNode>
                                            <f:TreeNode Text="桂花园小区" NodeID="guihuayuan">
                                            </f:TreeNode>
                                        </f:TreeNode>
                                        <f:TreeNode Text="包河区" Expanded="true" NodeID="baohequ">
                                            <f:TreeNode Text="中国科学技术大学" NodeID="ustc">
                                            </f:TreeNode>
                                        </f:TreeNode>
                                    </f:TreeNode>
                                </f:TreeNode>
                            </f:TreeNode>
                        </Nodes>
                    </f:Tree>
                </PopPanel>
                <Listeners>
                    <f:Listener Event="poppanelshow" Handler="onPopPanelShow"></f:Listener>
                </Listeners>
            </f:DropDownBox>
            <f:Button ID="btnGetSelection" Text="获取下拉框的选中值" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>





}



@section script {

    <script>

        function onPopPanelShow(event) {
            var nodes = this.getValue();

            F.noEvent(function () {
                F.ui.Tree1.checkNodes(nodes, {
                    keep: false // 是否保持已选中复选框的状态（false表示在执行本次操作之前，取消已选中的复选框）
                });
            });

        }

        F.ready(function () {

            var tree1 = F.ui.Tree1;
            tree1.on('nodecheck', function (event, nodeId, checked) {

                var values = [], texts = [];
                var checkedNodes = tree1.getCheckedNodes(true);
                $.each(checkedNodes, function (index, node) {
                    values.push(node.id);
                    texts.push(node.text);
                });

                F.ui.DropDownBox1.setValue(values, texts);
            });

        });

    </script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>把树的复选框状态同步到自定义下拉框。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>勾选树节点</h3>
        <ol>
            <li>
                展开下拉树，勾选“河南省”下的“驻马店市”。<br />
                结果：该节点加入现有选择，对应值为 zhumadian；单纯点击节点文字与勾选复选框是不同操作。
            </li>
            <li>
                点击面板外空白处收起，再点击“获取下拉框的选中值”。<br />
                结果：回发后由后台显示当前树节点文字和标识。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：</p>
        <ul>
            <li>自定义数据来源时（CustomData=true），需要同时设置 Value 和 Text 属性来初始化下拉框。</li>
            <li>下拉框的值对应于树控件的复选框，而不是树控件的选中项。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>setValue(value, text)</code>：自定义面板完成选择后同时写入业务值和显示文字；多选时传入一一对应的数组。</li>
            <li><code>CustomData</code>：通过页面脚本同步值和文字，而非直接采用默认数据控件的选中项。 本页声明值为 true。</li>
            <li><code>EnableCheckBox</code>：为树显示复选框，选择集合来自勾选状态。 本页声明值为 true。</li>
        </ul>
    </section>
}
