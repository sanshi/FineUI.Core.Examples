@page
@model FineUI.Core.Examples.Pages.DropDownBox.GridMultiSelectTextChangedModel
@{
    ViewBag.Title = "DropDownBox/GridMultiSelectTextChanged";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="下拉表格（多选）" ShowHeader="true">
        <Items>
            <f:DropDownBox ID="DropDownBox1" EmptyText="请从下拉表格中选择" MatchFieldWidth="false" EnableMultiSelect="true" _Values="105,108"
                           OnTextChanged="DropDownBox1_TextChanged">
                <PopPanel>
                    <f:Grid ID="Grid1" ShowBorder="true" ShowHeader="false" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
                            Hidden="true" Width="550" Height="300" EnableMultiSelect="true" KeepCurrentSelection="true">
                        <Columns>
                            <f:RenderField HeaderText="姓名" DataField="Name" />
                            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
                            <f:RenderField HeaderText="所学专业" DataField="Major" ExpandUnusedSpace="true" MinWidth="150" />
                        </Columns>
                    </f:Grid>
                </PopPanel>
            </f:DropDownBox>
            <f:Button ID="btnGetSelection" Text="获取下拉框的选中值" CssClass="marginr" OnClick="btnGetSelection_Click"></f:Button>
            <f:Button ID="btnReset" Text="重置表单" ClickHandler="onResetClick"></f:Button>
        </Items>
    </f:SimpleForm>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>

}

@section script {

    <script src="~/res/js/grid.js"></script>
    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }
    </script>


}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>在<strong class="example-control-reference" data-example-control="SimpleForm1" title="下拉表格（多选）">下拉表格</strong>中多选人员，收起面板确认变化后回发显示当前值。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-send" aria-hidden="true"></i>收起面板后处理变化</h3>
        <ol>
            <li>
                改变面板中的选择，再点击面板外空白处收起。<br />
                结果：文本变化事件回发后显示当前选择结果；此处核对的是确认并收起后的值。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>OnTextChanged</code>（<strong class="example-control-reference" data-example-control="DropDownBox1" title="请从下拉表格中选择">请从下拉表格中选择</strong>）：下拉选择变化后处理当前文字；需在收起弹出面板、确认本次选择后核对结果。 本页声明值为 <code>DropDownBox1</code><code>_TextChanged</code>。</li>
        </ul>
    </section>
}
