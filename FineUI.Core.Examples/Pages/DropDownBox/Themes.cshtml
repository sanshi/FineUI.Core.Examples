@page
@model FineUI.Core.Examples.Pages.DropDownBox.ThemesModel
@{
    ViewBag.Title = "DropDownBox/Themes";
    var F = Html.F();
}


@section head {

    <style>
        #themecontainer {
            background: none;
            background-color: #000;
            padding: 5px 0;
        }

            #themecontainer ul {
                list-style-type: none;
                margin: 10px 0 0;
                padding: 0;
            }

                #themecontainer ul li {
                    display: inline-block;
                    margin: 0 0 10px 10px;
                    padding: 0;
                }

                    #themecontainer ul li .title {
                        text-align: center;
                        color: #666;
                        font-size: 12px;
                        margin-top: 10px;
                    }

                    #themecontainer ul li.hover,
                    #themecontainer ul li.active {
                        border-bottom-color: #fff;
                    }

                        #themecontainer ul li.hover .title,
                        #themecontainer ul li.active .title {
                            color: #fff;
                            font-weight: bold;
                        }

                    #themecontainer ul li img {
                        width: 100px;
                        border-radius: 5px;
                    }

            #themecontainer .grouptitle {
                color: #ccc;
                font-size: 16px;
                border-bottom: solid 1px #333;
                padding: 5px;
                margin: 10px;
            }
    </style>

}

@section body {



    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10px" EnableCollapse="false" ShowBorder="true" Title="自定义下拉框" ShowHeader="true">
        <Items>
            <f:DropDownBox ID="DropDownBox1" Value="Pure_Black" Text="Pure Black" MatchFieldWidth="false" EnableMultiSelect="false" CustomData="true">
                <PopPanel>
                    <f:ContentPanel ID="ContentPanel1" CssClass="themepanel" Hidden="true" ShowHeader="false" Width="600" AutoScroll="true">
                        <div id="themecontainer">
                            <div class="grouptitle">
                                Pure
                            </div>
                            <ul>
                                <li>
                                    <a href="#">
                                        <img src="../res/images/themes/pure_black.png" alt="Pure Black" data-value="Pure_Black" />
                                    </a>
                                    <div class="title">Pure Black</div>
                                </li>
                                <li>
                                    <a href="#">
                                        <img src="../res/images/themes/pure_green.png" alt="Pure Green" data-value="Pure_Green" />
                                    </a>
                                    <div class="title">Pure Green</div>
                                </li>
                                <li>
                                    <a href="#">
                                        <img src="../res/images/themes/pure_blue.png" alt="Pure Blue" data-value="Pure_Blue" />
                                    </a>
                                    <div class="title">Pure Blue</div>
                                </li>
                                <li>
                                    <a href="#">
                                        <img src="../res/images/themes/pure_purple.png" alt="Pure Purple" data-value="Pure_Purple" />
                                    </a>
                                    <div class="title">Pure Purple</div>
                                </li>
                                <li>
                                    <a href="#">
                                        <img src="../res/images/themes/pure_orange.png" alt="Pure Orange" data-value="Pure_Orange" />
                                    </a>
                                    <div class="title">Pure Orange</div>
                                </li>
                            </ul>
                            <div class="grouptitle">
                                jQuery UI
                            </div>
                            <ul>
                                <li>
                                    <a href="#">
                                        <img src="../res/images/themes/cupertino.png" alt="Cupertino" data-value="Cupertino" /></a>
                                    <div class="title">Cupertino</div>
                                </li>
                                <li>
                                    <a href="#">
                                        <img src="../res/images/themes/start.png" alt="Start" data-value="Start" /></a>
                                    <div class="title">Start</div>
                                </li>
                                <li>
                                    <a href="#">
                                        <img src="../res/images/themes/dark_hive.png" alt="Dark Hive" data-value="Dark_Hive" /></a>
                                    <div class="title">Dark Hive</div>
                                </li>
                                <li>
                                    <a href="#">
                                        <img src="../res/images/themes/flick.png" alt="Flick" data-value="Flick" /></a>
                                    <div class="title">Flick</div>
                                </li>
                                <li>
                                    <a href="#">
                                        <img src="../res/images/themes/south_street.png" alt="South Street" data-value="South_Street" /></a>
                                    <div class="title">South Street</div>
                                </li>
                            </ul>
                        </div>
                    </f:ContentPanel>
                </PopPanel>
                <Listeners>
                    <f:Listener Event="poppanelshow" Handler="onPopPanelShow" />
                </Listeners>
            </f:DropDownBox>
            <f:Button ID="btnGetSelection" Text="获取下拉框的选中值" CssClass="marginr" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>




}


@section script {

    <script>

        function onPopPanelShow(event) {
            var themeName = this.getValue();
            if (!themeName) {
                themeName = 'Pure_Black';
            }
            $('#themecontainer li').each(function () {
                var cnode = $(this);
                if (cnode.find('img').attr('data-value') === themeName) {
                    cnode.addClass('active');
                } else {
                    cnode.removeClass('active');
                }
            });
        }


        F.ready(function () {

            $('#themecontainer li').hover(function () {
                $(this).addClass('hover');
            }, function () {
                $(this).removeClass('hover');
            }).click(function (event) {
                event.preventDefault();
                var imgNode = $(this).find('img');

                var themeName = imgNode.attr('data-value');
                var themeTitle = imgNode.attr('alt');

                // 将其赋值给下拉框
                F.ui.DropDownBox1.setValue(themeName, themeTitle);

                // 隐藏下拉框的弹出面板
                F.ui.DropDownBox1.hidePopEl();

            });

        });
    </script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>用自定义主题缩略图面板为<strong class="example-control-reference" data-example-control="DropDownBox1" title="下拉框">下拉框</strong>提供文字和值。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>从自定义缩略图面板选择</h3>
        <ol>
            <li>
                展开<strong class="example-control-reference" data-example-control="DropDownBox1" title="下拉框">下拉框</strong>，点击<code>Pure Green</code>主题缩略图。<br />
                结果：脚本写入 <code>Pure</code> <code>Green</code> 的文字和对应主题标识，然后收起面板；本例仅改变下拉选择，不把整站主题切换为绿色。
            </li>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnGetSelection" title="获取下拉框的选中值">获取下拉框的选中值</strong>。<br />
                结果：回发后由后台显示所选主题的文字和标识。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：自定义数据来源时（<code>CustomData</code>=<code>true</code>），需要同时设置 <code>Value</code> 和 <code>Text</code> 属性来初始化<strong class="example-control-reference"
                data-example-control="DropDownBox1" title="下拉框">下拉框</strong>。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>setValue()</code>（<strong class="example-control-reference" data-example-control="DropDownBox1"
                    title="下拉框">下拉框</strong>）：自定义面板完成操作后，同时写入业务值和显示文字，并主动收起面板。</li>
            <li><code>setValue(value, text)</code>（<strong class="example-control-reference" data-example-control="DropDownBox1"
                    title="下拉框">下拉框</strong>）：自定义面板完成选择后同时写入业务值和显示文字；多选时传入一一对应的数组。</li>
            <li><code>EnableMultiSelect</code>（<strong class="example-control-reference" data-example-control="DropDownBox1" title="下拉框">下拉框</strong>）：决定<strong
                    class="example-control-reference" data-example-control="DropDownBox1" title="下拉框">下拉框</strong>保留单个值还是多个值。 本页声明值为 <code>false</code>。</li>
            <li><code>Value</code>（<strong class="example-control-reference" data-example-control="DropDownBox1" title="下拉框">下拉框</strong>）：指定初始单选值或多选值数组。 本页声明值为
                <code>Pure_Black</code>。
            </li>
            <li><code>Text</code>（<strong class="example-control-reference" data-example-control="DropDownBox1"
                    title="下拉框">下拉框</strong>）：提供初始显示文字；自定义数据或异步数据需要与值一起设置。 本页声明值为 <code>Pure</code> <code>Black</code>。</li>
            <li><code>MatchFieldWidth</code>（<strong class="example-control-reference" data-example-control="DropDownBox1"
                    title="下拉框">下拉框</strong>）：控制弹出面板是否强制匹配字段宽度。 本页声明值为 <code>false</code>。</li>
            <li><code>CustomData</code>（<strong class="example-control-reference" data-example-control="DropDownBox1"
                    title="下拉框">下拉框</strong>）：通过页面脚本同步值和文字，而非直接采用默认数据控件的选中项。 本页声明值为 <code>true</code>。</li>
        </ul>
    </section>
}
