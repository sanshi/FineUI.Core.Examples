@page
@model FineUI.Core.Examples.Pages.DropDownBox.GridSelectAllClientModel
@{
    ViewBag.Title = "DropDownBox/GridSelectAllClient";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="下拉表格（多选）" ShowHeader="true">
        <Items>
            <f:DropDownBox ID="DropDownBox1" EmptyText="请从下拉表格中选择" MatchFieldWidth="false" EnableMultiSelect="true" DataControlID="Grid1">
                <PopPanel>
                    <f:Panel ID="Panel7" BodyPadding="10px" Width="650" Height="300" Hidden="true" ShowBorder="true" ShowHeader="false" Layout="Fit">
                        <Toolbars>
                            <f:Toolbar Position="Bottom">
                                <Items>
                                    <f:Button Text="全选" ID="btnSelectAll" ClickHandler="onSelectAllClick"></f:Button>
                                    <f:Button Text="全选化学系" ID="btnSelectHuaxue" ClickHandler="onSelectHuaxueClick"></f:Button>
                                    <f:Button Text="全选物理系" ID="btnSelectWuli" ClickHandler="onSelectWuliClick"></f:Button>
                                    <f:Button Text="全选材料系（保持已选中项）" ID="btnSelectCailiao" ClickHandler="onSelectSelectCailiaoClick"></f:Button>
                                </Items>
                            </f:Toolbar>
                        </Toolbars>
                        <Items>
                            <f:Grid ID="Grid1" ShowBorder="true" ShowHeader="false" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
                                    EnableMultiSelect="true" KeepCurrentSelection="true" DataSource="@DataSourceUtil.GetDataTable()">
                                <Columns>
                                    <f:RenderField HeaderText="姓名" DataField="Name" />
                                    <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
                                    <f:RenderField HeaderText="所学专业" DataField="Major" ExpandUnusedSpace="true" MinWidth="150" />
                                </Columns>
                            </f:Grid>
                        </Items>
                    </f:Panel>
                </PopPanel>
            </f:DropDownBox>
            <f:Button ID="btnGetSelection" Text="获取下拉框的选中值" CssClass="marginr" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>

}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function getRowIdsByMajor(majorName) {
            var grid = F.ui.Grid1, rows = [];
            $.each(grid.data, function (index, rowData) {
                if (rowData.values['Major'] == majorName) {
                    rows.push(rowData.id);
                }
            });
            return rows;
        }

        function onSelectAllClick(event) {
            F.ui.Grid1.selectAllRows();
            // 将数据控件中的值同步到输入框
            F.ui.DropDownBox1.syncToBox();
        }

        function onSelectHuaxueClick(event) {
            F.ui.Grid1.selectRows(getRowIdsByMajor('化学系'));
            // 将数据控件中的值同步到输入框
            F.ui.DropDownBox1.syncToBox();
        }

        function onSelectWuliClick(event) {
            F.ui.Grid1.selectRows(getRowIdsByMajor('物理系'));
            // 将数据控件中的值同步到输入框
            F.ui.DropDownBox1.syncToBox();
        }

        function onSelectSelectCailiaoClick(event) {
            F.ui.Grid1.selectRows(getRowIdsByMajor('材料科学与工程系'), { keep: true });
            // 将数据控件中的值同步到输入框
            F.ui.DropDownBox1.syncToBox();
        }

    </script>
}