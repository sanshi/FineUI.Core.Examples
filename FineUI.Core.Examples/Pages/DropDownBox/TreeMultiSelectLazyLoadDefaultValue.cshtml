@page
@model FineUI.Core.Examples.Pages.DropDownBox.TreeMultiSelectLazyLoadDefaultValueModel
@{
    ViewBag.Title = "DropDownBox/TreeMultiSelectLazyLoadDefaultValue";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10px" EnableCollapse="false" ShowBorder="true" Title="下拉树（多选，延迟加载）" ShowHeader="true">
        <Items>
            <f:DropDownBox ID="DropDownBox1" EnableMultiSelect="true" _Values="henan,anhui,xiping" _Texts="河南省,安徽省,西平县">
                <PopPanel>
                    <f:Tree ID="Tree1" ShowHeader="false" Hidden="true" EnableMultiSelect="true" KeepCurrentSelection="true"
                            AutoLeafIdentification="false" OnNodeLazyLoad="Tree1_NodeLazyLoad">
                        <Nodes>
                            <f:TreeNode Text="中国" NodeID="china" Expanded="true">
                                <f:TreeNode Text="河南省" NodeID="henan" Expanded="true">
                                    <f:TreeNode Text="驻马店市（延迟加载）" NodeID="zhumadian">
                                    </f:TreeNode>
                                    <f:TreeNode Text="漯河市" NodeID="luohe" Leaf="true" />
                                </f:TreeNode>
                                <f:TreeNode Text="安徽省" Expanded="true" NodeID="anhui">
                                    <f:TreeNode Text="合肥市" Expanded="true" NodeID="hefei">
                                        <f:TreeNode Text="蜀山区" Expanded="false" NodeID="shushanqu">
                                            <f:TreeNode Text="金色池塘小区" NodeID="golden" Leaf="true">
                                            </f:TreeNode>
                                            <f:TreeNode Text="梦圆小区" NodeID="mengyuan" Leaf="true">
                                            </f:TreeNode>
                                            <f:TreeNode Text="桂花园小区" NodeID="guihuayuan" Leaf="true">
                                            </f:TreeNode>
                                        </f:TreeNode>
                                        <f:TreeNode Text="包河区" Expanded="true" NodeID="baohequ">
                                            <f:TreeNode Text="中国科学技术大学" NodeID="ustc" Leaf="true">
                                            </f:TreeNode>
                                        </f:TreeNode>
                                    </f:TreeNode>
                                </f:TreeNode>
                            </f:TreeNode>
                        </Nodes>
                    </f:Tree>
                </PopPanel>
            </f:DropDownBox>
            <f:Button ID="btnGetSelection" Text="获取下拉框的选中值" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>

    <br />
    注：通过 Values 和 Text 属性来设置下拉框的初始值（由于页面初始化时树控件数据并没有全部载入，所以需要指定 Text 属性）。

}



