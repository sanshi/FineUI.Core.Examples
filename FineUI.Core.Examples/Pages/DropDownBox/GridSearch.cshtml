@page
@model FineUI.Core.Examples.Pages.DropDownBox.GridSearchModel
@{
    ViewBag.Title = "DropDownBox/GridSearch";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10px" EnableCollapse="false" ShowBorder="true" Title="下拉表格（输入框过滤）" ShowHeader="true">
        <Items>
            <f:DropDownBox ID="DropDownBox1" EmptyText="请从下拉表格中选择" EnableMultiSelect="true" MatchFieldWidth="false">
                <PopPanel>
                    <f:Grid ID="Grid1" Width="650" Height="300" ShowBorder="true" ShowHeader="false" DataIDField="Id" DataTextField="Name"
                        EnableCheckBoxSelect="true" AllowPaging="true" IsDatabasePaging="true" PageSize="5" Hidden="true" EnableMultiSelect="true"
                        KeepCurrentSelection="true" OnPageIndexChanged="Grid1_PageIndexChanged">
                        <Columns>
                            <f:RowNumberField />
                            <f:RenderField HeaderText="姓名" DataField="Name" />
                            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
                            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
                            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
                            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
                            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
                        </Columns>
                        <Toolbars>
                            <f:Toolbar Position="Top">
                                <Items>
                                    <f:TwinTriggerBox Width="300" EmptyText="在姓名中查找" ShowLabel="false" ID="ttbSearch" ShowTrigger1="false" Trigger1Icon="Clear"
                                        Trigger2Icon="Search" OnTrigger1Click="ttbSearch_Trigger1Click" OnTrigger2Click="ttbSearch_Trigger2Click">
                                    </f:TwinTriggerBox>
                                </Items>
                            </f:Toolbar>
                        </Toolbars>
                    </f:Grid>
                </PopPanel>
            </f:DropDownBox>
            <f:Button ID="btnGetSelection" Text="获取下拉框的选中值" CssClass="marginr" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>按姓名关键词过滤分页表格，并可清空搜索条件。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>按姓名过滤并恢复</h3>
        <ol>
            <li>
                展开面板，在<strong class="example-control-reference" data-example-control="ttbSearch" title="在姓名中查找">在姓名中查找</strong>中输入<code>金</code>，点击搜索图标。<br />
                结果：后台按姓名筛选，表格只显示姓名含“金”的人员；仍可选择<code>金婷婷</code>。
            </li>
            <li>
                点击搜索框新显示的清空图标。<br />
                结果：搜索文字清除，清空图标隐藏；表格重新加载全部人员。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>OnTrigger2Click</code>（<strong class="example-control-reference" data-example-control="ttbSearch"
                    title="在姓名中查找">在姓名中查找</strong>）：搜索触发器读取当前姓名关键词，重新加载符合条件的表格数据。</li>
            <li><code>OnTrigger1Click</code>（<strong class="example-control-reference" data-example-control="ttbSearch"
                    title="在姓名中查找">在姓名中查找</strong>）：清空触发器移除关键词并恢复未过滤的数据。</li>
        </ul>
    </section>
}
