@page
@model FineUI.Core.Examples.Pages.DropDownBox.GridPagingDatabaseDefaultValueModel
@{
    ViewBag.Title = "DropDownBox/GridPagingDatabaseDefaultValue";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10px" EnableCollapse="false" ShowBorder="true" Title="下拉表格（数据库分页）" ShowHeader="true">
        <Items>
            <f:DropDownBox ID="DropDownBox1" EmptyText="请从下拉表格中选择" EnableMultiSelect="true" MatchFieldWidth="false"
                           _Values="115,105" _Texts="董国,吴颖颖">
                <PopPanel>
                    <f:Grid ID="Grid1" Width="650" Height="300" ShowBorder="true" ShowHeader="false" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
                            AllowPaging="true" IsDatabasePaging="true" PageSize="5" Hidden="true" EnableMultiSelect="true" KeepCurrentSelection="true"
                            OnPageIndexChanged="Grid1_PageIndexChanged">
                        <Columns>
                            <f:RowNumberField />
                            <f:RenderField HeaderText="姓名" DataField="Name" />
                            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
                            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
                            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
                            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
                            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
                            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" />
                        </Columns>
                    </f:Grid>
                </PopPanel>
            </f:DropDownBox>
            <f:Button ID="btnGetSelection" Text="获取下拉框的选中值" CssClass="marginr" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>

    <br />
    注：通过 Values 和 Text 属性来设置下拉框的初始值（由于初始值可能不在第一页，所以需要指定 Text 属性）。

}


@section script {

    <script src="~/res/js/grid.js"></script>

}