@page
@model FineUI.Core.Examples.Pages.DropDownBox.TagsGridMultiSelectUpdateValueModel
@{
    ViewBag.Title = "DropDownBox/TagsGridMultiSelectUpdateValue";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="下拉表格（多选）" ShowHeader="true">
        <Items>
            <f:DropDownBox ID="DropDownBox1" EmptyText="请从下拉表格中选择" MatchFieldWidth="false" EnableMultiSelect="true" _Values="105,108" MultiSelectMode="Tags">
                <PopPanel>
                    <f:Grid ID="Grid1" ShowBorder="true" ShowHeader="false" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
                            Hidden="true" Width="550" Height="300" EnableMultiSelect="true" KeepCurrentSelection="true">
                        <Columns>
                            <f:RenderField HeaderText="姓名" DataField="Name" />
                            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
                            <f:RenderField HeaderText="所学专业" DataField="Major" ExpandUnusedSpace="true" MinWidth="150" />
                            <f:RenderField DataField="Desc" RenderAsRowExpander="true" RendererFunction="renderExpander" />
                        </Columns>
                    </f:Grid>
                </PopPanel>
            </f:DropDownBox>
            <f:Button ID="btnUpdateValue" Text="更新下拉框的值为[陈飞,黄婷婷,张三石]" CssClass="marginr" runat="server" OnClick="btnUpdateValue_Click">
            </f:Button>
            <f:Button ID="btnGetSelection" Text="获取下拉框的选中值" CssClass="marginr" OnClick="btnGetSelection_Click"></f:Button>
            <f:Button ID="btnReset" Text="重置表单" ClickHandler="onResetClick"></f:Button>
        </Items>
    </f:SimpleForm>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>

}

@section script {

    <script src="~/res/js/grid.js"></script>
    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }
    </script>


}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>在<strong class="example-control-reference" data-example-control="SimpleForm1" title="下拉表格（多选）">下拉表格</strong>中多选人员，按钮请求后台替换选中人员，以标签显示和移除所选人员。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>通过按钮更新选择</h3>
        <ol>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnUpdateValue" title="更新下拉框的值为[陈飞,黄婷婷,张三石]">更新下拉框的值为[陈飞,黄婷婷,张三石]</strong>。<br />
                结果：回发后由后台把当前选择替换为按钮指定的人名或语言；输入区和重新展开的选择状态同步更新。
            </li>
            <li>
                再点击<strong class="example-control-reference" data-example-control="btnGetSelection" title="获取下拉框的选中值">获取下拉框的选中值</strong>。<br />
                结果：读取结果反映刚更新的选择。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>_Values</code>（<strong class="example-control-reference" data-example-control="DropDownBox1" title="请从下拉表格中选择">请从下拉表格中选择</strong>）：指定初始多选值。 本页声明值为 <code>105</code>,<code>108</code>。</li>
        </ul>
    </section>
}
