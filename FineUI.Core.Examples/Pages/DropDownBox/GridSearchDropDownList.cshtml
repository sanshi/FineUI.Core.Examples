@page
@model FineUI.Core.Examples.Pages.DropDownBox.GridSearchDropDownListModel
@{
    ViewBag.Title = "DropDownBox/GridSearchDropDownList";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10px" EnableCollapse="false" ShowBorder="true" Title="下拉表格（下拉列表过滤，表头菜单过滤）" ShowHeader="true">
        <Items>
            <f:DropDownBox ID="DropDownBox1" EmptyText="请从下拉表格中选择" EnableMultiSelect="true" MatchFieldWidth="false">
                <PopPanel>
                    <f:Grid ID="Grid1" Width="650" Height="300" ShowBorder="true" ShowHeader="false" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
                            AllowPaging="true" IsDatabasePaging="true" PageSize="5" Hidden="true" EnableMultiSelect="true" KeepCurrentSelection="true"
                            OnPageIndexChanged="Grid1_PageIndexChanged"
                            AllowFilters="true" OnFilterChanged="Grid1_FilterChanged">
                        <Columns>
                            <f:RowNumberField />
                            <f:RenderField HeaderText="姓名" DataField="Name" />
                            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
                            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
                            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
                            <f:RenderField ColumnID="Major" HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" EnableFilter="true">
                                <Filter>
                                    <Operator>
                                        <f:DropDownList>
                                            <f:ListItem Text="等于" Value="equal" />
                                            <f:ListItem Text="包含" Value="contain" Selected="true" />
                                            <f:ListItem Text="开始于" Value="start" />
                                            <f:ListItem Text="结束于" Value="end" />
                                        </f:DropDownList>
                                    </Operator>
                                </Filter>
                            </f:RenderField>
                            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
                        </Columns>
                        <Toolbars>
                            <f:Toolbar Position="Top">
                                <Items>
                                    <f:Label Text="是否在校："></f:Label>
                                    <f:DropDownList ID="ddlAtSchool" OnSelectedIndexChanged="ddlAtSchool_SelectedIndexChanged">
                                        <f:ListItem Text="全部" Value="-1" />
                                        <f:ListItem Text="在校" Value="1" />
                                        <f:ListItem Text="离校" Value="0" />
                                    </f:DropDownList>
                                </Items>
                            </f:Toolbar>
                        </Toolbars>
                    </f:Grid>
                </PopPanel>
            </f:DropDownBox>
            <f:Button ID="btnGetSelection" Text="获取下拉框的选中值" CssClass="marginr" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
