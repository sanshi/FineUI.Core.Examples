@page
@model FineUI.Core.Examples.Pages.DropDownBox.NestingModel
@{
    ViewBag.Title = "DropDownBox/Nesting";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="下拉框嵌套" ShowHeader="true">
        <Items>
            <f:DropDownBox ID="DropDownBox1" EmptyText="请从下拉表格中选择" DataControlID="Grid1" MatchFieldWidth="false">
                <PopPanel>
                    <f:Panel ID="Panel1" Width="550" Height="300" ShowHeader="false" BodyPadding="5" Layout="VBox" Hidden="true">
                        <Items>
                            <f:Form ID="Form1" LabelWidth="50" LabelAlign="Right" ShowBorder="false" ShowHeader="false">
                                <Rows>
                                    <f:FormRow ColumnWidths="150 100%">
                                        <Items>
                                            <f:DropDownList Label="性别" EmptyText="请选择" ID="ddlGender" AutoSelectFirstItem="false" AutoShowClearIcon="true"
                                                            OnSelectedIndexChanged="ddlGender_SelectedIndexChanged">
                                                <f:ListItem Text="男" Value="1" />
                                                <f:ListItem Text="女" Value="0" />
                                            </f:DropDownList>
                                            <f:DropDownBox Label="专业" EmptyText="请选择" ID="ddbMajor" DataControlID="CheckBoxList1" MatchFieldWidth="true" EnableMultiSelect="true" AutoShowClearIcon="true"
                                                           OnTextChanged="ddbMajor_TextChanged">
                                                <PopPanel>
                                                    <f:SimpleForm ID="SimpleForm2" BodyPadding="10" AutoScroll="true" ShowBorder="true" ShowHeader="false" Hidden="true">
                                                        <Items>
                                                            <f:Label ID="Label1" Text="请选择专业："></f:Label>
                                                            <f:CheckBoxList ID="CheckBoxList1" ColumnNumber="2">
                                                                <f:CheckItem Text="化学系" Value="化学系" />
                                                                <f:CheckItem Text="数学系" Value="数学系" />
                                                                <f:CheckItem Text="物理系" Value="物理系" />
                                                                <f:CheckItem Text="自动化系" Value="自动化系" />
                                                                <f:CheckItem Text="材料科学与工程系" Value="材料科学与工程系" />
                                                            </f:CheckBoxList>
                                                        </Items>
                                                    </f:SimpleForm>
                                                </PopPanel>
                                            </f:DropDownBox>
                                        </Items>
                                    </f:FormRow>
                                </Rows>
                            </f:Form>
                            <f:Grid ID="Grid1" BoxFlex="1" ShowBorder="true" ShowHeader="false" DataIDField="Id" DataTextField="Name" EnableMultiSelect="false">
                                <Columns>
                                    <f:RenderField HeaderText="姓名" DataField="Name" />
                                    <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
                                    <f:RenderField HeaderText="所学专业" DataField="Major" ExpandUnusedSpace="true" MinWidth="150" />
                                </Columns>
                            </f:Grid>
                        </Items>
                    </f:Panel>
                </PopPanel>
            </f:DropDownBox>
            <f:Button ID="btnGetSelection" Text="获取下拉框的选中值" CssClass="marginr" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>


}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>在外层选人面板内嵌套性别和专业下拉框，筛选人员后回填外层选择。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>先筛专业，再选人员</h3>
        <ol>
            <li>
                展开外层下拉框，再展开里面的<strong class="example-control-reference" data-example-control="ddbMajor" title="专业">专业</strong>下拉框，勾选<code>化学系</code>。<br />
                结果：内层保留所选专业；收起专业面板后按化学系过滤外层表格。
            </li>
            <li>
                在过滤结果中选择<code>陈飞</code>，再点击面板外空白处收起，点击获取值按钮。<br />
                结果：外层结果显示陈飞，业务值为 <code>102</code>。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>通过性别继续筛选</h3>
        <ol>
            <li>
                重新展开外层面板，在<strong class="example-control-reference" data-example-control="ddlGender" title="性别">性别</strong>中选择<code>女</code>。<br />
                结果：表格只显示满足当前性别与专业条件的人员；内层面板的选择不直接成为外层人员值。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DataControlID</code>（<strong class="example-control-reference" data-example-control="DropDownBox1" title="请从下拉表格中选择">请从下拉表格中选择</strong>、<strong class="example-control-reference" data-example-control="ddbMajor" title="专业">专业</strong>）：指定弹出面板中提供选择数据的控件。 本页声明值为 <code>Grid1</code>。</li>
        </ul>
    </section>
}
