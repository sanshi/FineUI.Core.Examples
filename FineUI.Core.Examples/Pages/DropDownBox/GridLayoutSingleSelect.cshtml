@page
@model FineUI.Core.Examples.Pages.DropDownBox.GridLayoutSingleSelectModel
@{
    ViewBag.Title = "DropDownBox/GridLayoutSingleSelect";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10px" EnableCollapse="false" ShowBorder="true" Title="下拉表格（复杂布局，单选）" ShowHeader="true">
        <Items>
            <f:DropDownBox ID="DropDownBox1" EmptyText="请从下拉表格中选择" DataControlID="Grid1" EnableMultiSelect="false" MatchFieldWidth="false">
                <PopPanel>
                    <f:Panel ID="Panel7" BodyPadding="10px" Width="650" Height="300" Hidden="true" ShowBorder="true" ShowHeader="false" Layout="VBox"
                        BoxConfigSpace="5">
                        <Items>
                            <f:Form ShowBorder="false" ShowHeader="false" RemoveLastFieldsMargin="true">
                                <Rows>
                                    <f:FormRow>
                                        <Items>
                                            <f:TwinTriggerBox Width="300" EmptyText="在姓名中查找" ShowLabel="false" ID="ttbSearch" ShowTrigger1="false"
                                                OnTrigger1Click="ttbSearch_Trigger1Click" OnTrigger2Click="ttbSearch_Trigger2Click" Trigger1Icon="Clear"
                                                Trigger2Icon="Search">
                                            </f:TwinTriggerBox>
                                            <f:RadioButtonList ID="rblAtSchool" Label="是否在校" OnSelectedIndexChanged="rblAtSchool_SelectedIndexChanged">
                                                <f:RadioItem Text="全部" Value="-1" Selected="true" />
                                                <f:RadioItem Text="在校" Value="1" />
                                                <f:RadioItem Text="离校" Value="0" />
                                            </f:RadioButtonList>
                                        </Items>
                                    </f:FormRow>
                                </Rows>
                            </f:Form>
                            <f:Grid ID="Grid1" BoxFlex="1" DataIDField="Id" DataTextField="Name" EnableMultiSelect="false" KeepCurrentSelection="true"
                                PageSize="10" ShowBorder="true" ShowHeader="false" AllowPaging="true" IsDatabasePaging="true"
                                OnPageIndexChanged="Grid1_PageIndexChanged" EnableCheckBoxSelect="true" AllowSorting="true" SortField="Name" SortDirection="ASC"
                                OnSort="Grid1_Sort">
                                <Columns>
                                    <f:RowNumberField />
                                    <f:RenderField HeaderText="姓名" DataField="Name" SortField="Name" />
                                    <f:RenderField HeaderText="性别" DataField="Gender" SortField="Gender" FieldType="Int" RendererFunction="renderGender" />
                                    <f:RenderField HeaderText="入学年份" DataField="EntranceYear" SortField="EntranceYear" FieldType="Int" />
                                    <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
                                    <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
                                    <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
                                </Columns>
                            </f:Grid>
                        </Items>
                    </f:Panel>
                </PopPanel>
            </f:DropDownBox>
            <f:Button ID="btnGetSelection" Text="获取下拉框的选中值" OnClick="btnGetSelection_Click">
            </f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult">
    </f:Label>
}


@section script {

    <script src="~/res/js/grid.js"></script>

}



@section exampleDescription {
    <section aria-label="页面描述">
        <p>在含姓名搜索、在校筛选和分页的面板中单选人员。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-radio-button-checked" aria-hidden="true"></i>在复杂面板中只保留一名人员</h3>
        <ol>
            <li>
                展开面板，先后选择两个不同的可用人员。<br />
                结果：后一次选择替换前一次选择，输入区始终只保留一名人员。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableMultiSelect</code>（<strong class="example-control-reference" data-example-control="DropDownBox1"
                    title="请从下拉表格中选择">请从下拉表格中选择</strong>）：本页<strong class="example-control-reference" data-example-control="DropDownBox1"
                    title="请从下拉表格中选择">下拉框</strong>及内嵌表格使用单选，不累积多个选择。</li>
        </ul>
    </section>
}
