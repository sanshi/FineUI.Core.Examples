@page
@model FineUI.Core.Examples.Pages.DropDownBox.RadioButtonListModel
@{
    ViewBag.Title = "DropDownBox/RadioButtonList";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="下拉单选框列表" ShowHeader="true">
        <Items>
            <f:DropDownBox ID="DropDownBox1" DataControlID="RadioButtonList1" Value="js" EnableMultiSelect="false">
                <PopPanel>
                    <f:SimpleForm ID="SimpleForm2" BodyPadding="10" AutoScroll="true" ShowBorder="true" ShowHeader="false" Hidden="true">
                        <Items>
                            <f:Label ID="Label1" Text="请选择一种编程语言："></f:Label>
                            <f:RadioButtonList ID="RadioButtonList1" ColumnNumber="1">
                                <f:RadioItem Text="C#" Value="csharp" />
                                <f:RadioItem Text="JavaScript" Value="js" />
                                <f:RadioItem Text="JAVA" Value="java" />
                                <f:RadioItem Text="Ruby" Value="ruby" />
                            </f:RadioButtonList>
                        </Items>
                    </f:SimpleForm>
                </PopPanel>
            </f:DropDownBox>
            <f:Button ID="btnGetSelection" Text="获取下拉框的选中值" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>



}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>在下拉面板内单选编程语言。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-radio-button-checked" aria-hidden="true"></i>从面板选择编程语言</h3>
        <ol>
            <li>
                点击下拉箭头展开面板，选择<code>Ruby</code>。<br />
                结果：<code>Ruby</code> 替换原来的单选项，对应值为 <code>ruby</code>。
            </li>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnGetSelection" title="获取下拉框的选中值">获取下拉框的选中值</strong>。<br />
                结果：回发后由后台显示包含 <code>Ruby</code> 和 <code>ruby</code> 的当前选择。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：列表项的值不能为空字符串。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DataControlID</code>（<strong class="example-control-reference" data-example-control="DropDownBox1"
                    title="下拉框">下拉框</strong>）：指定弹出面板中提供选择数据的控件。 本页声明值为 <code>RadioButtonList1</code>。</li>
            <li><code>EnableMultiSelect</code>（<strong class="example-control-reference" data-example-control="DropDownBox1" title="下拉框">下拉框</strong>）：决定<strong
                    class="example-control-reference" data-example-control="DropDownBox1" title="下拉框">下拉框</strong>保留单个值还是多个值。 本页声明值为 <code>false</code>。</li>
            <li><code>Value</code>（<strong class="example-control-reference" data-example-control="DropDownBox1" title="下拉框">下拉框</strong>）：指定初始单选值或多选值数组。 本页声明值为
                <code>js</code>。
            </li>
            <li><code>ColumnNumber</code>（<strong class="example-control-reference" data-example-control="RadioButtonList1"
                    title="单选框列表">单选框列表</strong>）：控制弹出单选或复选列表的列数。 本页声明值为 <code>1</code>。</li>
        </ul>
    </section>
}
