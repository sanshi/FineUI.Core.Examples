@page
@model FineUI.Core.Examples.Pages.DropDownBox.RadioButtonListMatchFieldWidthModel
@{
    ViewBag.Title = "DropDownBox/RadioButtonListMatchFieldWidth";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="下拉单选框列表（MatchFieldWidth）" ShowHeader="true">
        <Items>
            <f:DropDownBox ID="DropDownBox1" DataControlID="RadioButtonList1" Value="js" MatchFieldWidth="false" EnableMultiSelect="false">
                <PopPanel>
                    <f:SimpleForm ID="SimpleForm2" BodyPadding="10" AutoScroll="true" ShowBorder="true" ShowHeader="false" Hidden="true" Width="650">
                        <Items>
                            <f:Label ID="Label1" Text="请选择一种编程语言："></f:Label>
                            <f:RadioButtonList ID="RadioButtonList1" ColumnNumber="3">
                                <f:RadioItem Text="C#" Value="csharp" />
                                <f:RadioItem Text="JavaScript" Value="js" />
                                <f:RadioItem Text="JAVA" Value="java" />
                                <f:RadioItem Text="Ruby" Value="ruby" />
                                <f:RadioItem Text="PHP" Value="php" />
                                <f:RadioItem Text="Objective-C" Value="objc" />
                                <f:RadioItem Text="Python" Value="python" />
                                <f:RadioItem Text="Perl" Value="perl" />
                                <f:RadioItem Text="C++" Value="cplusplus" />
                                <f:RadioItem Text="Basic" Value="basic" />
                                <f:RadioItem Text="Go" Value="go" />
                                <f:RadioItem Text="Swift" Value="swift" />
                            </f:RadioButtonList>
                        </Items>
                    </f:SimpleForm>
                </PopPanel>
            </f:DropDownBox>
            <f:Button ID="btnGetSelection" Text="获取下拉框的选中值" OnClick="btnGetSelection_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>


}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示弹出选择面板与输入框的宽度关系。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照输入框和弹出面板的宽度</h3>
        <ol>
            <li>
                展开下拉面板，对照它与输入框的左右边界。<br />
                结果：面板是否与输入框等宽由本页 <code>MatchFieldWidth</code> 配置决定，选择行为不受宽度设置影响。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>MatchFieldWidth</code>（<strong class="example-control-reference" data-example-control="DropDownBox1"
                    title="下拉框">下拉框</strong>）：控制弹出面板是否强制匹配字段宽度。 本页声明值为 <code>false</code>。</li>
        </ul>
    </section>
}
