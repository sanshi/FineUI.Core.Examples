@page
@model FineUI.Core.Examples.Pages.DropDownBox.GridEnableEditModel
@{
    ViewBag.Title = "DropDownBox/GridEnableEdit";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="下拉表格" ShowHeader="true">
        <Items>
            <f:DropDownBox ID="DropDownBox1" EmptyText="请从下拉表格中选择" MatchFieldWidth="false" Value="105" EnableMultiSelect="false" EnableEdit="true">
                <PopPanel>
                    <f:Grid ID="Grid1" ShowBorder="true" ShowHeader="false" DataIDField="Id" DataTextField="Name"
                            Hidden="true" Width="550" Height="300" EnableMultiSelect="false">
                        <Columns>
                            <f:RenderField HeaderText="姓名" DataField="Name" />
                            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
                            <f:RenderField HeaderText="所学专业" DataField="Major" ExpandUnusedSpace="true" MinWidth="150" />
                        </Columns>
                    </f:Grid>
                </PopPanel>
            </f:DropDownBox>
            <f:Button ID="btnGetSelection" Text="获取下拉框的选中值" CssClass="marginr" OnClick="btnGetSelection_Click"></f:Button>
            <f:Button ID="btnReset" Text="重置表单" ClickHandler="onResetClick"></f:Button>
        </Items>
    </f:SimpleForm>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>

}

@section script {

    <script src="~/res/js/grid.js"></script>
    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }
    </script>


}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>在下拉表格中单选人员，也可保留用户自由输入文字。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>输入列表之外的文字</h3>
        <ol>
            <li>
                先取消现有选择，再在输入区键入“自定义说明”，收起面板或离开字段。<br />
                结果：输入区保留用户输入文字，不把它误认为某个已有的业务值；获取时按用户输入值处理。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableEdit</code>：允许输入列表之外的文字，选中项与自由输入按不同方式读取。 本页声明值为 true。</li>
        </ul>
    </section>
}
