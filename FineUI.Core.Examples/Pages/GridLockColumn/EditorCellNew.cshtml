@page
@model FineUI.Core.Examples.Pages.GridLockColumn.EditorCellNewModel
@{
    ViewBag.Title = "GridLockColumn/EditorCellNew";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（双击编辑）" DataIDField="Id" DataTextField="Name" AllowCellEditing="true"
        ClicksToEdit="2" EnableCheckBoxSelect="true" AllowColumnLocking="true" Width="1000">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name" EnableLock="true" Locked="true">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender" EnableLock="true">
                <Editor>
                    <f:DropDownList ID="ddlGender" Required="true">
                        <f:ListItem Text="男" Value="1"></f:ListItem>
                        <f:ListItem Text="女" Value="0"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学年份" ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int" EnableLock="true">
                <Editor>
                    <f:NumberBox ID="nbxEntranceYear" NoDecimal="true" NoNegative="true" MinValue="2000" MaxValue="2025"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd"
                Width="150" EnableLock="true">
                <Editor>
                    <f:DatePicker ID="dpEntranceDate" Required="true"></f:DatePicker>
                </Editor>
            </f:RenderField>
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool" DataField="AtSchool" EnableLock="true" />
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" Width="800">
                <Editor>
                    <f:TextBox ID="tbxMajor" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
        </Columns>
        <Toolbars>
            <f:Toolbar>
                <Items>
                    <f:Button ID="btnNew" Text="新增数据" Icon="Add" ClickHandler="onNewClick"></f:Button>
                    <f:ToolbarFill></f:ToolbarFill>
                    <f:Button ID="btnReset" Text="重置表格数据" ClickHandler="onResetClick"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Grid>
    <br>

    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>

}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onNewClick(event) {
            F.ui.Grid1.addNewRecord({
                'Name': '新用户',
                'Gender': '1',
                'EntranceYear': '2015',
                'EntranceDate': '2016-11-15',
                'AtSchool': false,
                'Major': '化学系'
            }, true);
        }

        function onResetClick(event) {
            F.confirm({
                message: '确定要重置表格数据？',
                ok: function () {
                    F.ui.Grid1.rejectChanges();
                }
            });
        }

    </script>
}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>在锁定区域编辑与新增记录，编辑器定位到实际锁定单元格。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>编辑锁定单元格与新行</h3>
        <ol>
            <li>双击<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（双击编辑）">表格（双击编辑）</strong>左侧锁定的<strong>姓名</strong>单元格，输入<code>锁定列测试</code>并结束编辑。<br />结果：编辑器在当前锁定格打开，结束后原行显示新<strong>姓名</strong>；普通区域仍与该行对齐。
            </li>
            <li>点击<strong class="example-control-reference" data-example-control="btnNew" title="新增数据">新增数据</strong>，填写新行后点击<strong
                    class="example-control-reference" data-example-control="btnSubmit" title="保存数据">保存数据</strong>。<br />结果：后台按增改状态更新示例数据并重新绑定，锁定列和可编辑列继续保留。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>AllowCellEditing</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格（双击编辑）">表格（双击编辑）</strong>）：初始为
                <code>true</code>，在已启用锁定的表格上接受单元格编辑。
            </li>
            <li><code>Locked</code>（<strong>姓名列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（双击编辑）">表格（双击编辑）</strong>）：列进入锁定区域后仍可使用为其配置的编辑器。</li>
        </ul>
    </section>
}
