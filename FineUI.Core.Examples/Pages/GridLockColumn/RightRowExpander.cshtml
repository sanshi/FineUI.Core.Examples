@page
@model FineUI.Core.Examples.Pages.GridLockColumn.RightRowExpanderModel
@{
    ViewBag.Title = "GridLockColumn/RightRowExpander";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name"
            AllowColumnLocking="true" ColumnLockingRight="true" Height="500" Width="1000">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" EnableLock="true" Locked="true" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" EnableLock="true" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" EnableLock="true" Locked="true" LockedPosition="Right" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" EnableLock="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" Width="400" EnableLock="true" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" EnableLock="true" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" EnableLock="true" />
            <f:RenderField DataField="Desc" RendererFunction="renderExpander" RenderAsRowExpander="true" EnableLock="true" Locked="true" />
            <f:RenderField EnableLock="true" DataField="ShenGao" ColumnID="ShenGao" HeaderText="身高" />
            <f:RenderField EnableLock="true" DataField="TiZhong" ColumnID="TiZhong" HeaderText="体重" />
            <f:RenderField EnableLock="true" DataField="XueYaDi" ColumnID="XueYaDi" HeaderText="血压（低）" />
            <f:RenderField EnableLock="true" DataField="XueYaGao" ColumnID="XueYaGao" HeaderText="血压（高）" />
            <f:RenderField EnableLock="true" DataField="ShiLiZuo" ColumnID="ShiLiZuo" HeaderText="视力（左）" />
            <f:RenderField EnableLock="true" DataField="ShiLiYou" ColumnID="ShiLiYou" HeaderText="视力（右）" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" EnableLock="true" Locked="true" LockedPosition="Right" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" EnableLock="true" />
        </Columns>
    </f:Grid>
    <br>
    <br>
    <f:Button ID="btnExpandRowExpanders" CssClass="marginr" Text="展开全部的行扩展列" ClickHandler="onExpandAllClick"></f:Button>
    <f:Button ID="btnCollapseRowExpanders" Text="折叠全部的行扩展列" ClickHandler="onCollapseAllClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>
    <script type="text/javascript">

        function onExpandAllClick(event) {
            F.ui.Grid1.expandRowExpanders();
        }

        function onCollapseAllClick(event) {
            F.ui.Grid1.collapseRowExpanders();
        }
    </script>


}
@section exampleDescription {
<section aria-label="页面描述">
    <p>在右侧列锁定表格中展开行详情，滚动时保持主行与扩展内容对应。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>展开后滚动查看记录</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>首行的展开图标，再横向滚动。<br />结果：该行下方出现扩展内容，锁定列留在原侧；再次点击图标只收起这一行的扩展内容。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>RowExpanderField / Locked</code>（<strong>列锁定配置</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：行扩展入口与锁定布局共同使用，扩展内容不代替主行的数据列。</li>
    </ul>
</section>
}
