@page
@model FineUI.Core.Examples.Pages.GridLockColumn.RightLockColumnModel
@{
    ViewBag.Title = "GridLockColumn/RightLockColumn";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name"
            AllowColumnLocking="true" ColumnLockingRight="true" EnableCheckBoxSelect="true" Width="1000">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" EnableLock="true" Locked="true" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" EnableLock="true" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" EnableLock="true" Locked="true" LockedPosition="Right" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" EnableLock="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" Width="400" EnableLock="true" />
            <f:RenderField EnableLock="true" DataField="ShenGao" ColumnID="ShenGao" HeaderText="身高" />
            <f:RenderField EnableLock="true" DataField="TiZhong" ColumnID="TiZhong" HeaderText="体重" />
            <f:RenderField EnableLock="true" DataField="XueYaDi" ColumnID="XueYaDi" HeaderText="血压（低）" />
            <f:RenderField EnableLock="true" DataField="XueYaGao" ColumnID="XueYaGao" HeaderText="血压（高）" />
            <f:RenderField EnableLock="true" DataField="ShiLiZuo" ColumnID="ShiLiZuo" HeaderText="视力（左）" />
            <f:RenderField EnableLock="true" DataField="ShiLiYou" ColumnID="ShiLiYou" HeaderText="视力（右）" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" EnableLock="true" Locked="true" LockedPosition="Right" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" EnableLock="true" />
        </Columns>
    </f:Grid>


}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>让指定列固定在右侧，横向滚动时仍能识别当前记录。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>横向滚动对照锁定位置</h3>
    <ul>
        <li>横向滚动<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>。<br />结果：右侧锁定列留在右侧，左侧锁定列仍固定在左侧，普通列随滚动移动；表头与正文保持对应。</li>
        <li>在允许锁定的列表头菜单切换锁定或解锁。<br />结果：目标列按菜单操作进入或退出锁定区域，其他列数据保留。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>AllowColumnLocking</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>true</code>，启用表格的锁定区域与列锁定操作。</li>
        <li><code>EnableLock / Locked / LockedPosition</code>（<strong>列锁定配置</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：EnableLock 决定该列能否通过菜单锁定，Locked 表示初始是否锁定，LockedPosition 指定 right 位置。</li>
    </ul>
</section>
}
