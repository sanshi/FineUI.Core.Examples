@page
@model FineUI.Core.Examples.Pages.GridLockColumn.SaveLockedAndOrderModel
@{
    ViewBag.Title = "GridLockColumn/SaveLockedAndOrder";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" Width="1000"
        AllowColumnLocking="true" Width="1000">
        <Columns>
            <f:RowNumberField ColumnID="RowNumber" />
            <f:RenderField HeaderText="姓名" DataField="Name" EnableLock="true" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" EnableLock="true" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" EnableLock="true" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" EnableLock="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" Width="400" EnableLock="true" />
            <f:RenderField EnableLock="true" DataField="ShenGao" ColumnID="ShenGao" HeaderText="身高" />
            <f:RenderField EnableLock="true" DataField="TiZhong" ColumnID="TiZhong" HeaderText="体重" />
            <f:RenderField EnableLock="true" DataField="XueYaDi" ColumnID="XueYaDi" HeaderText="血压（低）" />
            <f:RenderField EnableLock="true" DataField="XueYaGao" ColumnID="XueYaGao" HeaderText="血压（高）" />
            <f:RenderField EnableLock="true" DataField="ShiLiZuo" ColumnID="ShiLiZuo" HeaderText="视力（左）" />
            <f:RenderField EnableLock="true" DataField="ShiLiYou" ColumnID="ShiLiYou" HeaderText="视力（右）" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" EnableLock="true" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" EnableLock="true" />
        </Columns>
        <Listeners>
            <f:Listener Event="columnlock" Handler="onGridColumnLock"></f:Listener>
            <f:Listener Event="columnunlock" Handler="onGridColumnUnlock"></f:Listener>
        </Listeners>
    </f:Grid>
    <br>
    <br>

    <f:Button ID="btnRefresh" Text="刷新本页面（保持列锁定状态和列顺序）" ClickHandler="onReloadPageClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function saveToDB(grid) {

            // 列锁定和列顺序
            var configedColumns = $.map(grid.columns, function (column, index) {
                return {
                    ColumnID: column.columnId,
                    Locked: column.locked
                };
            });


            // 触发后台事件
            F.customEvent('Grid1_ColumnLockUnlock', {
                configedColumns: configedColumns
            });
        }


        function onGridColumnLock(event, columnId) {
            saveToDB(this);
        }

        function onGridColumnUnlock(event, columnId) {
            saveToDB(this);
        }

        function onReloadPageClick(event) {
            window.location.reload();
        }

    </script>
}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>保存列的锁定状态及当前顺序，当前会话刷新后恢复。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>改变配置后刷新核对</h3>
        <ol>
            <li>在<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>的表头菜单中锁定或解锁一个允许操作的列。<br />结果：客户端列锁定事件把当前列清单、顺序与锁定配置回发，后台保存到当前会话的示例配置。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnRefresh"
                    title="刷新本页面（保持列锁定状态和列顺序）">刷新本页面（保持列锁定状态和列顺序）</strong>，或刷新当前示例。<br />结果：后台按已保存配置重建显示，列顺序及锁定状态恢复；本页用会话模拟配置保存，不是已接入业务数据库。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ColumnID / Locked</code>（<strong>列锁定配置</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：保存稳定列标识和锁定状态；恢复时按列标识对应，不按当前显示索引猜测。</li>
            <li><code>columnlock / columnunlock</code>（<strong>页面脚本</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：这些客户端事件触发本页保存处理，列顺序以当前完整列清单保存。</li>
        </ul>
    </section>
}
