@page
@model FineUI.Core.Examples.Pages.Accordion.TreeModel
@{
    ViewBag.SourceFiles = "~/Accordion/TreeDefaultPage";
    ViewBag.Title = "Accordion/Tree";
    var F = Html.F();
}

@section body {

    <f:RegionPanel ID="RegionPanel1" IsViewPort="true" ShowBorder="false" Margin="24">
        <Regions>
            <f:Region ID="Region2" RegionSplit="true" RegionSplitHeaderClass="false" RegionPosition="Left" Width="200" ShowHeader="false" Title="目录" EnableCollapse="false" Layout="Fit">
                <Items>
                    <f:Accordion ShowBorder="false" ShowHeader="false" ShowCollapseTool="true">
                        <Panes>
                            <f:AccordionPane Title="面板一" IconUrl="@Url.Content("~/res/images/16/1.png")" BodyPadding="2px 5px" Layout="Fit">
                                <Items>
                                    <f:Tree ShowBorder="false" ShowHeader="false" ID="treeMenu">
                                    </f:Tree>
                                </Items>
                            </f:AccordionPane>
                            <f:AccordionPane Title="面板二" IconUrl="@Url.Content("~/res/images/16/4.png")" BodyPadding="2px 5px">
                                <Items>
                                    <f:Label Text="面板二中的文本">
                                    </f:Label>
                                </Items>
                            </f:AccordionPane>
                        </Panes>
                    </f:Accordion>
                </Items>
            </f:Region>
            <f:Region ID="Region3" ShowHeader="false" EnableIFrame="true" IFrameUrl="@Url.Content("~/Accordion/TreeDefaultPage")" IFrameName="accordionmainframe" Position="Center">
            </f:Region>
        </Regions>
    </f:RegionPanel>

}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示用左侧目录树导航右侧 <code>iframe</code>，并由区域布局分配两侧空间。</p>
    <h3><i class="f-iconfont f-iconfont-link" aria-hidden="true"></i>从目录打开示例</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="treeMenu" title="树">树</strong>展开<code>基本用法</code>，点击<code>你好 FineUI</code>。<br />结果：浏览器在右侧 <code>iframe</code> 打开对应示例，左侧目录和其它已展开节点继续保留。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="RegionPanel1" title="区域面板">区域面板</strong>）：外层使用 <code>Region</code> 布局，目录区域与内容区域分别分配空间。</li>
        <li><code>NavigateUrl</code>（<strong>树节点</strong>，位于<strong class="example-control-reference" data-example-control="treeMenu" title="树">树</strong>）：给叶子节点配置示例地址。</li>
        <li><code>IFrameName</code>（<strong class="example-control-reference" data-example-control="Region3" title="第 2 个Region">第 2 个Region</strong>）：设为<code>accordionmainframe</code>，作为节点链接的目标，确保导航发生在右侧内容区。</li>
    </ul>
</section>
}
