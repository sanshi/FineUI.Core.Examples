@page
@model FineUI.Core.Examples.Pages.Accordion.ToolModel
@{
    ViewBag.Title = "Accordion/Tool";
    var F = Html.F();
}


@section body {

    <f:Accordion ID="Accordion1" IsFluid="true" Title="手风琴控件" ShowHeader="false" Height="500" ShowBorder="true" ActivePaneIndex="1" EnableCollapse="false">
        <Panes>
            <f:AccordionPane ID="AccordionPane1" Title="面板一" IconUrl="@Url.Content("~/res/images/16/1.png")" BodyPadding="2px 5px">
                <Items>
                    <f:Label ID="Label1" Text="面板一中的文本">
                    </f:Label>
                </Items>
                <Tools>
                    <f:Tool IconFont="_Gear" ToolTip="设置" ClickHandler="onToolIconClick"></f:Tool>
                    <f:Tool IconFont="_Download" ToolTip="下载" ClickHandler="onToolIconClick"></f:Tool>
                </Tools>
            </f:AccordionPane>
            <f:AccordionPane ID="AccordionPane2" Title="面板二" IconUrl="@Url.Content("~/res/images/16/4.png")" BodyPadding="2px 5px">
                <Items>
                    <f:Label ID="Label2" Text="面板二中的文本">
                    </f:Label>
                </Items>
            </f:AccordionPane>
            <f:AccordionPane ID="AccordionPane3" Title="面板三" IconUrl="@Url.Content("~/res/images/16/7.png")" BodyPadding="2px 5px">
                <Items>
                    <f:Label ID="Label3" Text="面板三中的文本">
                    </f:Label>
                </Items>
            </f:AccordionPane>
        </Panes>
    </f:Accordion>
    <br>


    <f:Button ID="Button1" Text="获取当前展开的面板" OnClick="Button1_Click"></f:Button>
    <br>
    <br>

    <f:Button ID="Button2" Text="展开下一个面板" OnClick="Button2_Click"></f:Button>
    <br>


}


@section script {

    <script>

        function onToolIconClick(event) {

            // 当前点击的图标字体
            var iconFont = this.iconFont;

            F.notify({
                message: '你点击了标题栏工具图标：' + iconFont,
                messageIconFont: iconFont,
                displayMilliseconds: 3000,
                positionX: 'center',
                positionY: 'center'
            });


            // 阻止事件向上传播（点击工具图标时不会折叠展开面板）
            event.stopPropagation();
        }

    </script>

}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示在手风琴面板标题中加入自定义工具图标，并独立处理点击。</p>
    <h3><i class="f-iconfont f-iconfont-edit" aria-hidden="true"></i>点击标题工具</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Accordion1" title="手风琴控件">手风琴控件</strong>面板标题中点击齿轮工具图标。<br />结果：执行本页配置的工具动作并显示提示，不会把点击误作普通的面板标题切换。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Tools</code>（<strong class="example-control-reference" data-example-control="AccordionPane1" title="面板一">面板一</strong>、<strong class="example-control-reference" data-example-control="AccordionPane2" title="面板二">面板二</strong>、<strong class="example-control-reference" data-example-control="AccordionPane3" title="面板三">面板三</strong>）：为对应面板标题追加自定义工具。</li>
        <li><code>handler</code>（<strong>标题工具图标</strong>）：工具点击时执行本页提示逻辑，与面板展开动作分开。</li>
    </ul>
</section>
}
