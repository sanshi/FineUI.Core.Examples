@page
@model FineUI.Core.Examples.Pages.Accordion.FillModel
@{
    ViewBag.Title = "Accordion/Fill";
    var F = Html.F();
}


@section body {

    <f:Accordion ID="Accordion1" IsFluid="true" Title="手风琴控件" ShowHeader="false" Height="500" ShowBorder="true" ActivePaneIndex="1" EnableCollapse="false" EnableFill="false">
        <Panes>
            <f:AccordionPane ID="AccordionPane1" Title="面板一" IconUrl="@Url.Content("~/res/images/16/1.png")" BodyPadding="2px 5px">
                <Items>
                    <f:Label ID="Label1" Text="面板一中的文本">
                    </f:Label>
                </Items>
            </f:AccordionPane>
            <f:AccordionPane ID="AccordionPane2" Title="面板二" IconUrl="@Url.Content("~/res/images/16/4.png")" BodyPadding="2px 5px">
                <Items>
                    <f:Label ID="Label2" Text="面板二中的文本<br/>balabala<br/>balabala<br/>balabala<br/>balabala" EncodeText="false">
                    </f:Label>
                </Items>
            </f:AccordionPane>
            <f:AccordionPane ID="AccordionPane3" Title="面板三" IconUrl="@Url.Content("~/res/images/16/7.png")" BodyPadding="2px 5px">
                <Items>
                    <f:Label ID="Label3" Text="面板三中的文本">
                    </f:Label>
                </Items>
            </f:AccordionPane>
        </Panes>
    </f:Accordion>
    <br>

    <f:Button ID="Button1" Text="获取当前展开的面板" OnClick="Button1_Click"></f:Button>
    <br>
    <br>

    <f:Button ID="Button2" Text="展开下一个面板" OnClick="Button2_Click"></f:Button>
    <br>


}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示手风琴面板按内容自然高度展开，并允许把所有面板都收起。</p>
    <h3><i class="f-iconfont f-iconfont-layout" aria-hidden="true"></i>比较自然高度与全部折叠</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="Accordion1" title="手风琴控件">手风琴控件</strong>先展开面板二，再点击它的标题。<br />结果：面板按内容高度显示；再次点击可收起当前面板，不强制保留一个展开项。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button1" title="获取当前展开的面板">获取当前展开的面板</strong>。<br />结果：全部折叠时显示没有面板处于展开状态的提示。</li>
    </ol>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableFill</code>（<strong class="example-control-reference" data-example-control="Accordion1" title="手风琴控件">手风琴控件</strong>）：设为 <code>false</code>，展开面板不再填满容器剩余高度。 本页使用<code>false</code>。</li>
        <li><code>ActivePaneIndex</code>（<strong class="example-control-reference" data-example-control="Accordion1" title="手风琴控件">手风琴控件</strong>）：全部折叠时表示没有当前面板，不能按正常位置直接取内容。 本页使用<code>1</code>。</li>
    </ul>
</section>
}
