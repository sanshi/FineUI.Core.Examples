@page
@model FineUI.Core.Examples.Pages.Other.ServerErrorCustomModel
@{
    ViewBag.Title = "Other/ServerErrorCustom";
    var F = Html.F();
}


@section body {

    <f:Button ID="Button5" OnClick="Button5_Click" Text="服务器异常（500）"></f:Button>


}


@section script {

    <script>

        F.beforeAjaxError(function (data, textStatus, xhr) {
            // 错误正文格式由服务端决定，这里只展示稳定的状态信息。
            var errorStatus = xhr.status ? 'HTTP ' + xhr.status : textStatus;
            F.alert({
                message: '这是自定义错误处理！服务器返回的状态：' + errorStatus,
                messageIcon: 'error'
            });

            // 需要显式的返回 false，来阻止默认的错误处理
            return false;
        });

    </script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>拦截后台 HTTP 500 错误，用自定义提示替代默认错误处理。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>触发并识别请求错误</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="Button5" title="服务器异常（500）">服务器异常（500）</strong>。<br />结果：后台返回 HTTP 500，客户端拦截后显示自定义错误提示。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>F.beforeAjaxError()</code>（<strong class="example-control-reference" data-example-control="Button5" title="服务器异常（500）">服务器异常（500）</strong>）：错误回调接管失败请求的提示；后台仍返回真实错误状态。</li>
    </ul>
</section>
}
