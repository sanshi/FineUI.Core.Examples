@page
@model FineUI.Core.Examples.Pages.Other.ServerErrorCustomModel
@{
    ViewBag.Title = "Other/ServerErrorCustom";
    var F = Html.F();
}


@section body {

    <f:Button ID="Button5" OnClick="Button5_Click" Text="服务器异常（500）"></f:Button>


}


@section script {

    <script>

        F.beforeAjaxError(function (data, textStatus, xhr) {
            // 错误正文格式由服务端决定，这里只展示稳定的状态信息。
            var errorStatus = xhr.status ? 'HTTP ' + xhr.status : textStatus;
            F.alert({
                message: '这是自定义错误处理！服务器返回的状态：' + errorStatus,
                messageIcon: 'error'
            });

            // 需要显式的返回 false，来阻止默认的错误处理
            return false;
        });

    </script>

}
