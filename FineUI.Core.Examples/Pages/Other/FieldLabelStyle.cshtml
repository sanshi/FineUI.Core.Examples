@page
@model FineUI.Core.Examples.Pages.Other.FieldLabelStyleModel
@{
    ViewBag.Title = "Other/FieldLabelStyle";
    var F = Html.F();
}


@section head {

    <style>
        .red .f-field-fieldlabel {
            color: Red;
            font-weight: bold;
        }

        .blue .f-field-fieldlabel {
            color: Blue;
            font-weight: normal;
        }
    </style>

}

@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" LabelAlign="Right" Title="简单表单">
        <Items>
            <f:TextBox Label="用户名" EmptyText="输入用户名" Text="张三" ID="tbxUserName" CssClass="red">
            </f:TextBox>
            <f:TextBox Label="密码" TextMode="Password" ID="tbxPassword" CssClass="red">
            </f:TextBox>
        </Items>
        <Toolbars>
            <f:Toolbar ToolbarAlign="Right" Position="Bottom">
                <Items>
                    <f:Button ID="btnSwitchClass" Text="改变 Label 的样式" OnClick="btnSwitchClass_Click"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:SimpleForm>



}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示通过 CSS 类切换字段标签颜色，并保留输入框当前内容。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-skin" aria-hidden="true"></i>切换标签样式</h3>
        <ol>
            <li>
                在<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>或密码中输入内容，点击<strong class="example-control-reference" data-example-control="btnSwitchClass" title="改变 Label 的样式">改变 Label 的样式</strong>。<br />
                结果：回发后，后台把标签样式从红色切换为蓝色，输入值保留。
            </li>
            <li>
                再次点击同一按钮。<br />
                结果：标签回到红色样式，不重新创建字段。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>CssClass</code>（<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>、<strong class="example-control-reference" data-example-control="tbxPassword" title="密码">密码</strong>）：<code>red</code>、<code>blue</code> 样式类选择字段标签的颜色。</li>
            <li><code>.f-field-fieldlabel</code>（<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>、<strong class="example-control-reference" data-example-control="tbxPassword" title="密码">密码</strong>）：本页 CSS 针对标签文字设置样式。</li>
        </ul>
    </section>
}
