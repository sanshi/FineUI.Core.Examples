@page
@model FineUI.Core.Examples.Pages.Other.AuthenticationTimeoutAsyncModel
@{
    ViewBag.Title = "Other/AuthenticationTimeoutAsync";
    var F = Html.F();
}


@section body {

    <f:Button ID="btnRegisterHook" Text="1. 注册跳转拦截函数" ClickHandler="onRegisterHookClick"></f:Button>
    <br />
    <br />
    <f:Button ID="Button2" Text="2. 点击回发（模拟 Forms Authentication 超时）" OnClick="Button2_Click"></f:Button>
    <br>
    <br>
    请尝试如下两种不同操作步骤：
    <br>
    <br>
    <div>操作一：</div>
    <ol>
        <li>刷新页面</li>
        <li>点击按钮2 -&gt; 直接跳转到首页</li>
    </ol>
    <br>
    <div>操作二：</div>
    <ol>
        <li>刷新页面</li>
        <li>点击按钮1</li>
        <li>点击按钮2 -&gt; 首先弹出确认框，点击确认后才跳转到首页；如果点击取消，则留在本页</li>
    </ol>



}


@section script {

    <script>


        function onRegisterHookClick(event) {
            F.beforeAjaxSuccess(function (data, textStatus, xhr) {

                // 回发原文是 JSON；只读取跳转命令的网址，不执行响应正文。
                var commands = JSON.parse(data).commands || [];
                var redirect = commands.find(function (command) {
                    return command.type === 'page.redirect';
                });
                if (redirect) {
                    var url = redirect.url;

                    // F.confirm是异步函数，直接返回
                    F.confirm({
                        message: '登录超时，是否跳转到首页？',
                        ok: function () {
                            // 用户确认后直接导航到服务端下发的网址。
                            window.location.assign(url);
                        },
                        cancel: function () {
                            // 继续留在当前页面，啥也不做
                        }
                    });


                    // 确认框是异步的，先阻止整份响应应用，等待用户选择。
                    return false;
                }

            });

            F.alert('拦截函数注册成功！');
        }

    </script>

}
