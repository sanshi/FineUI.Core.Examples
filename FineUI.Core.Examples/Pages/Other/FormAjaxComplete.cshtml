@page
@model FineUI.Core.Examples.Pages.Other.FormAjaxCompleteModel
@{
    ViewBag.Title = "Other/FormAjaxComplete";
    var F = Html.F();
}

@section body {

    <f:Form LabelWidth="100" BodyPadding="10" EnableCollapse="false" ID="Form1" IsFluid="true" Title="表单">
        <Rows>
            <f:FormRow>
                <Items>
                    <f:Label ID="Label3" Label="电话" Text="0551-1234567" />
                    <f:Label ID="Label16" Label="申请人" Text="admin">
                    </f:Label>
                </Items>
            </f:FormRow>
            <f:FormRow>
                <Items>
                    <f:Label ID="Label4" Label="编号" Text="200804170006" />
                    <f:TextBox ID="TextBox2" Required="true" ShowRedStar="true" Label="电子邮箱" RegexPattern="EMAIL" RegexMessage="请输入有效的邮箱地址">
                    </f:TextBox>
                </Items>
            </f:FormRow>
            <f:FormRow>
                <Items>
                    <f:DropDownList ID="DropDownList3" Label="审批人" Required="true" ShowRedStar="true" EmptyText="请选择审批人" AutoSelectFirstItem="false">
                        <f:ListItem Text="老大甲" Value="0"></f:ListItem>
                        <f:ListItem Text="老大乙" Value="1"></f:ListItem>
                        <f:ListItem Text="老大丙" Value="2"></f:ListItem>
                        <f:ListItem Text="老大丁" Value="3"></f:ListItem>
                        <f:ListItem Text="老大午" Value="4"></f:ListItem>
                        <f:ListItem Text="老大己" Value="5"></f:ListItem>
                    </f:DropDownList>
                </Items>
            </f:FormRow>
            <f:FormRow>
                <Items>
                    <f:NumberBox ID="NumberBox1" Label="申请数量" NoDecimal="true" NoNegative="true" MaxValue="1000" Required="true" ShowRedStar="true" />
                </Items>
            </f:FormRow>
            <f:FormRow>
                <Items>
                    <f:TextArea ID="TextArea1" Label="描述" ShowRedStar="true" Required="true">
                    </f:TextArea>
                </Items>
            </f:FormRow>
        </Rows>
        <Toolbars>
            <f:Toolbar Position="Bottom" ToolbarAlign="Right">
                <Items>
                    <f:Button ID="btnSubmit" Text="验证此表单并提交" CssClass="marginr" ClickHandler="onSubmitClick"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Form>

}


@section script {

    <script>

        function onSubmitClick(event) {
            var form1 = F.ui.Form1;

            // AJAX回发之前，先对表单进行验证
            if (!F.validateForm('Form1', { target: '_top' })) {
                return;
            }

            // AJAX回发之前显示面板加载动画
            form1.showLoading();

            // 自定义回发，设置完成时回调complete
            F.doPostBack({
                eventName: 'Form1_Submit',
                // 不显示页面加载动画
                enableAjaxLoading: false,
                complete: function (data, textStatus, xhr) {
                    // 传输结束后、响应脚本执行前隐藏表单加载动画；错误和超时也会执行。
                    form1.hideLoading();
                }
            });

        }
    </script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>表单验证通过后禁用提交按钮并显示自定义加载状态，请求完成时恢复。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>提交期间反馈处理状态</h3>
    <ol>
        <li>填写<strong class="example-control-reference" data-example-control="TextBox2" title="电子邮箱">电子邮箱</strong>、<strong class="example-control-reference" data-example-control="DropDownList3" title="审批人">审批人</strong>、申请数量和描述，再点击<strong class="example-control-reference" data-example-control="btnSubmit" title="验证此表单并提交">验证此表单并提交</strong>。<br />结果：验证不通过时显示字段错误；全部通过后才回发，并显示本页自定义提交状态。</li>
        <li>等待本次请求完成。<br />结果：后台读取字段并显示通知，完成回调恢复提交按钮，不需要刷新页面。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>F.doPostBack.complete</code>（<strong class="example-control-reference" data-example-control="btnSubmit" title="验证此表单并提交">验证此表单并提交</strong>）：在请求结束后恢复按钮状态；开始请求前先验证表单，避免验证失败后仍进入加载状态。</li>
    </ul>
</section>
}
