@page
@model FineUI.Core.Examples.Pages.Other.Compatibility.TabIndexChangedModel
@{
    ViewBag.Title = "选项卡切换与附加参数";
}
@section body {
    <f:TabStrip ID="Tabs" IsFluid="true" Height="220" ActiveTabIndex="0"
        OnTabIndexChanged="@Url.Handler("Changed")"
        OnTabIndexChangedParameter1="@(Parameter.FromFunction("activeIndex", "getCompatibilityTabIndex"))">
        <Tabs>
            <f:Tab Title="基本资料" BodyPadding="10"><Items><f:Label Text="基本资料内容" /></Items></f:Tab>
            <f:Tab Title="联系方式" BodyPadding="10"><Items><f:Label Text="联系方式内容" /></Items></f:Tab>
            <f:Tab Title="操作记录" BodyPadding="10"><Items><f:Label Text="操作记录内容" /></Items></f:Tab>
        </Tabs>
    </f:TabStrip>
    <br />
    <f:Button ID="Next" Text="下一个标签" OnClick="@Url.Handler("Next")"
        OnClickParameter1="@(Parameter.FromFunction("activeIndex", "getCompatibilityTabIndex"))" />
    <br />
    <f:Label ID="Result" Text="当前标签：0" />
    <ul class="compatibility-notes">
        <li>保留旧 TabIndexChanged 和按钮 OnPost 写法，Parameter 每轮读取活动索引。</li>
        <li>后台也可以通过 UIHelper 切换标签。</li>
    </ul>
}
@section script {
    <script>
        function getCompatibilityTabIndex() {
            return F('Tabs').getActiveTabIndex();
        }
    </script>
}
