@page
@model FineUI.Core.Examples.Pages.Other.Compatibility.TreeSelectionModel
@{
    ViewBag.Title = "树节点与对象参数";
}
@section body {
    <f:Tree ID="Tree1" Title="地区" ShowHeader="true" IsFluid="true" Height="210">
        <Nodes>
            <f:TreeNode Text="安徽省" NodeID="anhui" Expanded="true">
                <f:TreeNode Text="合肥市" NodeID="hefei" />
                <f:TreeNode Text="黄山市" NodeID="huangshan" />
            </f:TreeNode>
        </Nodes>
    </f:Tree>
    <br />
    <f:Button ID="btnSubmit" Text="读取节点" CssClass="marginr" OnClick="@Url.Handler("ReadNode")" OnClickParameter1="@(Parameter.FromFunction("selectedNode", "getCompatibilityNode"))" />
    <f:Button ID="btnSelectHefei" Text="选中合肥" OnClick="@Url.Handler("SelectHefei")" />
    <div style="margin-top: 10px">
        <f:Label ID="labResult" Text="等待操作" />
    </div>

}
@section script {
    <script>
        function getCompatibilityNode() {
            var node = F('Tree1').getSelectedNode(true);
            return node ? F.toJSON({ id: node.id, text: node.text }) : '{}';
        }
    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>对照客户端提交树选中节点和后台指定选中节点。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>对照兼容入口的实际结果</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Tree1" title="地区">地区</strong>中，先选择一个地区并读取节点，再点击<strong
                    class="example-control-reference" data-example-control="btnSelectHefei" title="选中合肥">选中合肥</strong>后重新读取。<br />结果：后台指定后树选中合肥，读取结果也变为合肥对应的标识。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <ul class="compatibility-notes">
            <li>选中节点的 ID 和文本以 JSON 对象传给 OnPostReadNode。</li>
            <li>另一个按钮用 UIHelper 即时选择合肥，再次读取时可以获得新的当前选择。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Parameter.FromFunction / SelectedNodeID</code>（<strong class="example-control-reference" data-example-control="Tree1"
                    title="地区">地区</strong>）：本页保留对应的旧处理入口，参数仍从本次提交值读取，响应更新当前页面控件。</li>
        </ul>
    </section>
}
