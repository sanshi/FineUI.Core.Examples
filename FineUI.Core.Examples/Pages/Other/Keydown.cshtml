@page
@model FineUI.Core.Examples.Pages.Other.KeydownModel
@{
    ViewBag.Title = "Other/Keydown";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" Title="简单表单">
        <Items>
            <f:TextBox ID="TextBox1" ShowLabel="false" EmptyText="输入一些文字，下面的文本框会随之改变">
                <Listeners>
                    <f:Listener Event="change" Handler="onTextBoxChange" />
                </Listeners>
            </f:TextBox>
            <f:TextBox ID="TextBox2" ShowLabel="false">
            </f:TextBox>
        </Items>
    </f:SimpleForm>


}


@section script {

    <script>

        function onTextBoxChange(event) {
            F.ui.TextBox2.setValue(this.getValue());
        }

    </script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示文本变化后在浏览器同步更新另一个输入框，无需后台请求。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>同步输入文字</h3>
        <ul>
            <li>
                在<strong class="example-control-reference" data-example-control="TextBox1" title="输入一些文字，下面的文本框会随之改变">第一个文本框</strong>中输入<code>client-side-sync</code>。<br />
                结果：<strong class="example-control-reference" data-example-control="TextBox2" title="第 2 个文本框">第二个文本框</strong>随变化显示相同文字。
            </li>
            <li>
                修改或清空<strong class="example-control-reference" data-example-control="TextBox1" title="输入一些文字，下面的文本框会随之改变">第一个文本框</strong>。<br />
                结果：<strong class="example-control-reference" data-example-control="TextBox2" title="第 2 个文本框">第二个文本框</strong>同步为新的内容或空值，整个过程在浏览器完成。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Event</code>（<strong class="example-control-reference" data-example-control="TextBox1" title="输入一些文字，下面的文本框会随之改变">输入一些文字，下面的文本框会随之改变</strong>）：监听文本框的 <code>change</code> 事件。</li>
            <li><code>getValue()</code>（<strong class="example-control-reference" data-example-control="TextBox1" title="输入一些文字，下面的文本框会随之改变">输入一些文字，下面的文本框会随之改变</strong>）：客户端处理函数读取<strong class="example-control-reference" data-example-control="TextBox1" title="输入一些文字，下面的文本框会随之改变">第一个文本框</strong>当前值。</li>
            <li><code>setValue()</code>（<strong class="example-control-reference" data-example-control="TextBox2" title="第 2 个文本框">第 2 个文本框</strong>）：把读取到的文字写入<strong class="example-control-reference" data-example-control="TextBox2" title="第 2 个文本框">第二个文本框</strong>。</li>
        </ul>
    </section>
}
