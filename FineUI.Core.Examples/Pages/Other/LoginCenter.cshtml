@page
@model FineUI.Core.Examples.Pages.Other.LoginCenterModel
@{
    ViewBag.Title = "Other/LoginCenter";
    var F = Html.F();
}


@section head {

    <style>
        /* margin 属性不能设置到 #SimpleForm1，因为 SimpleForm1 的宽度设置包含了 margin */
        #SimpleForm1_wrapper {
            margin: 100px auto 0 auto;
            width: 350px;
        }
    </style>

}

@section body {





    <f:SimpleForm ID="SimpleForm1" ShowBorder="true" BodyPadding="10" IsFluid="true" CssClass="f-shadow"
                  ShowHeader="true" Title="登录表单" Width="350">
        <Items>
            <f:TextBox ID="tbxUserName" Label="用户名" Required="true" ShowRedStar="true">
            </f:TextBox>
            <f:TextBox ID="tbxPassword" Label="密码" TextMode="Password" Required="true" ShowRedStar="true">
            </f:TextBox>
        </Items>
        <Toolbars>
            <f:Toolbar ID="Toolbar1" ToolbarAlign="Center" Position="Bottom">
                <Items>
                    <f:Button ID="btnLogin" Text="登录" Type="Submit" _ValidateForms="SimpleForm1" ValidateTarget="Top" OnClick="btnLogin_Click"></f:Button>
                    <f:Button ID="btnReset" Text="重置" Type="Reset"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:SimpleForm>


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示通过页面 CSS 将固定宽度的登录表单居中。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>调整页面后观察表单位置</h3>
        <ol>
            <li>
                调整浏览器的宽度和高度。<br />
                结果：登录表单按页面的居中样式重新定位，表单仍使用本页指定的宽度。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>用户名：admin <br> 密码：admin <br> <br> <br> 注：</p>
        <ul>
            <li> 通过CSS设置登录表单居中显示（CSS属性不能直接设置到 SimpleForm1，因为其 Width 已经包含了 margin ）。 </li>
            <li> 设置表单属性 CssClass="f-shadow"，增加其边框阴影。 </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Width</code>：登录表单宽度为 350 像素。</li>
            <li><code>CssClass</code>：f-shadow 为表单增加阴影，页面样式负责居中。</li>
        </ul>
    </section>
}
