@page
@model FineUI.Core.Examples.Pages.Other.TemplateDeclarationsModel
@{
    ViewBag.Title = "Other/TemplateDeclarations";
}

@section body {


    <f:SimpleForm ID="SimpleForm1" IsFluid="true" Title="模板声明的控件" BodyPadding="10" LabelWidth="90">
        <Items>
            <f:TextBox ID="tbxUserName" Label="用户名" EmptyText="请输入用户名" MaxLength="20"></f:TextBox>
        </Items>
    </f:SimpleForm>
    <br />

    <f:Button ID="btnRead" Text="回发读取属性" OnClick="btnRead_Click" CssClass="marginr"></f:Button>
    <f:Button ID="btnChange" Text="后台修改标签和提示" OnClick="btnChange_Click"></f:Button>
    <br />
    <br />

    <f:GroupPanel ID="PanelResult" Title="后台读取结果" IsFluid="true" BodyPadding="10">
        <Items>
            <f:Label ID="labResult" ShowLabel="false" Text="请输入用户名，再点击“回发读取属性”。" CssStyle="white-space: pre-wrap;"></f:Label>
        </Items>
    </f:GroupPanel>


}

@section exampleDescription {
<section aria-label="页面描述">
    <p>在回发后台读取模板声明的字段属性，并验证后台修改在后续回发中保留。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>读取声明并修改后再读取</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>输入 <code>张三</code>，点击<strong class="example-control-reference" data-example-control="btnRead" title="回发读取属性">回发读取属性</strong>。<br />结果：结果显示当前用户名、标签、提示文字和 20 字符长度限制。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnChange" title="后台修改标签和提示">后台修改标签和提示</strong>。<br />结果：后台更新标签、提示和长度限制，最大长度改为 30，输入内容保留。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnRead" title="回发读取属性">回发读取属性</strong>。<br />结果：再次读取到修改后的属性值，区别于初次模板声明值。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <p>在模板中声明字段属性，回发后可直接在后台读取，无需重复赋值。</p>
    <p>点击“后台修改标签和提示”后，长度限制也会从 20 改为 30；再次读取时，这些修改和输入内容都会保留。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Label</code>（<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>）：初始为 <code>用户名</code>，指定字段旁显示的名称。</li>
        <li><code>EmptyText</code>（<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>）：初始为 <code>请输入用户名</code>，为空时显示输入提示；表格无记录时显示对应空结果文字。</li>
        <li><code>MaxLength</code>（<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>）：初始为 <code>20</code>，限制可输入的最大字符数。</li>
    </ul>
</section>
}
