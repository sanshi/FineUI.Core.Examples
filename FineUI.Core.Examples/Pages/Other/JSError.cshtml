@page
@model FineUI.Core.Examples.Pages.Other.JSErrorModel
@{
    ViewBag.Title = "Other/JSError";
    var F = Html.F();
}


@section body {

    <f:Button ID="Button1" ClickHandler="onCallback1Click" Text="客户端的JavaScript错误"></f:Button>
    <br />
    <br />
    <f:Button ID="Button4" OnClick="Button4_Click" Text="服务器返回的JavaScript错误"></f:Button>

}


@section script {

    <script type="text/javascript">

        function onCallback1Click(event) {
            var i = a[0];
        }

        function test() {
            // 服务端只请求调用本页函数；在浏览器事件中抛错，让下方全局错误处理器显示详细信息。
            // 不在回发响应应用过程中抛错，避免异常只变成 Promise 拒绝而绕过 window.onerror。
            window.setTimeout(function () {
                throw new Error('服务器请求的客户端错误示例');
            }, 0);
        }


        // 参考：http://stackoverflow.com/questions/951791/javascript-global-error-handling/10556743#10556743
        window.onerror = function (msg, url, line, col, error) {
            var errors = [];
            errors.push('消息：' + msg);
            errors.push('网址：' + url);
            errors.push('行：' + line);
            errors.push('列：' + col);

            F.alert({
                message: F.rawHtml(errors.join('<br/>')),
                title: 'JavaScript错误！',
                messageIcon: 'error'
            });

            // 返回 true 阻止浏览器弹出错误提示框（比如在IE浏览器中）
            return true;
        };

    </script>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>捕获页面全局 JavaScript 错误，并显示错误信息，区分本地脚本和后台返回脚本。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>分别触发脚本错误</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="Button1"
                    title="客户端的JavaScript错误">客户端的JavaScript错误</strong>。<br />结果：本页错误处理器捕获该来源的脚本错误，在提示框显示消息、位置等信息；这里有意触发异常。</li>
            <li>点击<strong class="example-control-reference" data-example-control="Button4"
                    title="服务器返回的JavaScript错误">服务器返回的JavaScript错误</strong>。<br />结果：本页错误处理器捕获该来源的脚本错误，在提示框显示消息、位置等信息；这里有意触发异常。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>window.onerror</code>（<strong class="example-control-reference" data-example-control="Button1"
                    title="客户端的JavaScript错误">客户端的JavaScript错误</strong>）：捕获未处理的 JavaScript 错误并显示信息，不把异常当作正常业务结果。</li>
        </ul>
    </section>
}
