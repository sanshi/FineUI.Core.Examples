@page
@model FineUI.Core.Examples.Pages.Other.AuthenticationTimeoutModel
@{
    ViewBag.Title = "Other/AuthenticationTimeout";
    var F = Html.F();
}


@section body {

    <f:Button ID="btnRegisterHook" Text="1. 注册跳转拦截函数" ClickHandler="onRegisterHookClick"></f:Button>
    <br />
    <br />
    <f:Button ID="Button2" Text="2. 点击回发（模拟 Forms Authentication 超时）" OnClick="Button2_Click"></f:Button>
    <br>
    <br>
    请尝试如下两种不同操作步骤：
    <br>
    <br>
    <div>操作一：</div>

    <br>
    <div>操作二：</div>



}


@section script {

    <script>

        function onRegisterHookClick(event) {
            F.beforeAjaxSuccess(function (data, textStatus, xhr) {

                // 回发原文是 JSON；例如 commands 中的 page.redirect 表示服务端要求跳转。
                var commands = JSON.parse(data).commands || [];
                var redirect = commands.find(function (command) {
                    return command.type === 'page.redirect';
                });
                if (redirect) {
                    if (!window.confirm('登录超时，是否跳转到首页？')) {
                        // 继续留在当前页面
                        // 显式返回 false 会阻止本次响应的全部更新和命令。
                        return false;
                    }
                }

            });

            F.alert('拦截函数注册成功！');
        }

    </script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>拦截后台返回的跳转指令，让用户确认是否离开当前页。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>先注册拦截再触发跳转</h3>
        <ol>
            <li>点击<strong class="example-control-reference" data-example-control="btnRegisterHook" title="1. 注册跳转拦截函数">1. 注册跳转拦截函数</strong>。<br />结果：提示拦截函数注册成功。
            </li>
            <li>点击<strong class="example-control-reference" data-example-control="Button2" title="2. 点击回发（模拟 Forms Authentication 超时）">2. 点击回发（模拟 Forms
                    Authentication 超时）</strong>。<br />结果：后台模拟登录超时并返回跳转，拦截函数先询问是否继续。</li>
            <li>先取消，再重新触发并确认。<br />结果：取消时留在原页，确认后才跳转到本页指定的登录地址。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <ol>
            <li>刷新页面</li>
            <li>点击按钮2 -&gt; 直接跳转到首页</li>
        </ol>
        <ol>
            <li>刷新页面</li>
            <li>点击按钮1</li>
            <li>点击按钮2 -&gt; 首先弹出确认框，点击确认后才跳转到首页；如果点击取消，则留在本页</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>F.beforeAjaxSuccess()</code>（<strong class="example-control-reference" data-example-control="btnRegisterHook" title="1. 注册跳转拦截函数">1.
                    注册跳转拦截函数</strong>）：拦截响应中的跳转动作，通过同步确认结果决定是否继续。</li>
        </ul>
    </section>
}
