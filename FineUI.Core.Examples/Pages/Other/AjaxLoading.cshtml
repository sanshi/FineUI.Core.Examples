@page
@model FineUI.Core.Examples.Pages.Other.AjaxLoadingModel
@{
    ViewBag.Title = "Other/AjaxLoading";
    var F = Html.F();
}


@section body {


    <f:Button Text="不显示提示信息" ID="Button1" OnClick="Button1_Click" EnableAjaxLoading="false"></f:Button>
    <br />
    <br />
    <f:Button Text="使用PageManager定义的提示信息" ID="Button2" OnClick="Button1_Click"></f:Button>
    <br />
    <br />
    <f:Button Text="默认风格提示信息" ID="Button3" OnClick="Button1_Click" AjaxLoadingType="Default"></f:Button>
    <br />
    <br />
    <f:Button Text="Mask风格提示信息" ID="Button4" OnClick="Button1_Click" AjaxLoadingType="Mask"></f:Button>
    <br />
    <br />
    <f:Button Text="Mask风格提示信息（显示提示文本）" ID="Button5" OnClick="Button1_Click"
              AjaxLoadingType="Mask" ShowAjaxLoadingMaskText="true"></f:Button>
    <br />
    <br />
    <f:Button Text="Mask风格提示信息（自定义提示文本）" ID="Button6" OnClick="Button1_Click"
              AjaxLoadingType="Mask" ShowAjaxLoadingMaskText="true" AjaxLoadingMaskText="这是自定义提示文本"></f:Button>
    <br />
    <br />
    <f:Button Text="回发时保持按钮可用" ID="Button7" OnClick="Button1_Click"
              DisableControlBeforePostBack="false"></f:Button>



    <br>
    <br>
    注：
    <ul>
        <li>为了观察Ajax提示信息，所有按钮动作在后台都会睡眠1秒钟。</li>
        <li>本示例仅作演示，实际应用中请在Web.config中增加这些配置项，以便在整个项目中保持统一。</li>
    </ul>


}

