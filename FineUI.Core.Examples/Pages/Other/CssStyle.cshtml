@page
@model FineUI.Core.Examples.Pages.Other.CssStyleModel
@{
    ViewBag.Title = "Other/CssStyle";
    var F = Html.F();
}


@section head {

    <style>
        .red {
            font-weight: bold;
            color: Red;
        }

        .green {
            font-weight: bold;
            font-style: italic;
            font-size: 1.5em;
            color: Green;
        }
    </style>

}

@section body {

    <f:Label ID="Label1" Text="文本一，注意观察文本的样式">
    </f:Label>
    <br />
    <f:Button CssClass="marginr" ID="Button1" OnClick="Button1_Click" Text="通过 CssStyle 修改文本的样式"></f:Button>
    <f:Button ID="Button3" OnClick="Button3_Click" Text="清空 CssStyle 设置的样式"></f:Button>

    <br />
    <br />

    <f:Label ID="Label2" Text="文本二，注意观察文本的样式">
    </f:Label>
    <br />
    <f:Button CssClass="marginr" ID="Button2" OnClick="Button2_Click" Text="通过 CssClass 修改文本的样式"></f:Button>
    <f:Button ID="Button4" OnClick="Button4_Click" Text="清空 CssClass 设置的样式"></f:Button>



}

@section script {

    <script>
        function clearLabelStyle() {
            F.ui.Label1.el.attr('style', '');
        }
    </script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>分别用行内样式和 CSS 类改变两段文字，并清除各自设置。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-pic" aria-hidden="true"></i>设置与清除两种样式</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="Button1" title="通过 CssStyle 修改文本的样式">通过 CssStyle 修改文本的样式</strong>。<br />结果：后台按本页配置修改对应文字的字体或颜色，可与另一组对照。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button3" title="清空 CssStyle 设置的样式">清空 CssStyle 设置的样式</strong>。<br />结果：移除对应文字通过该方式添加的样式，其它方式设置的样式不一起清除。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button2" title="通过 CssClass 修改文本的样式">通过 CssClass 修改文本的样式</strong>。<br />结果：后台按本页配置修改对应文字的字体或颜色，可与另一组对照。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button4" title="清空 CssClass 设置的样式">清空 CssClass 设置的样式</strong>。<br />结果：移除对应文字通过该方式添加的样式，其它方式设置的样式不一起清除。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>CssClass</code>（<strong class="example-control-reference" data-example-control="Button1" title="通过 CssStyle 修改文本的样式">通过 CssStyle 修改文本的样式</strong>、<strong class="example-control-reference" data-example-control="Button2" title="通过 CssClass 修改文本的样式">通过 CssClass 修改文本的样式</strong>）：初始为 <code>marginr</code>，使用本页定义的 CSS 类设置外观。</li>
        <li><code>CssClass / CssStyle</code>（<strong class="example-control-reference" data-example-control="Label1" title="文本一，注意观察文本的样式">文本一，注意观察文本的样式</strong>）：类名引用页面样式定义，行内样式直接给出 CSS 声明；设置和清除分别演示。</li>
    </ul>
</section>
}
