@page
@model FineUI.Core.Examples.Pages.Other.CustomPostbackJsonModel
@{
    ViewBag.SourceFiles = "~/Pages/Other/CustomPostbackJsonData.cshtml;~/Pages/Other/CustomPostbackJsonData.cshtml.cs";
    ViewBag.Title = "Other/CustomPostbackJson";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" Title="简单表单">
        <Items>
            <f:TextBox ID="TextBox1" ShowLabel="false" EmptyText="输入一些文字并按 ENTER 键">
                <Listeners>
                    <f:Listener Event="enter" Handler="onTextBoxEnter" />
                </Listeners>
            </f:TextBox>
            <f:TextBox ID="TextBox2" ShowLabel="false">
            </f:TextBox>
        </Items>
    </f:SimpleForm>

    <br />
    <br />
    注：需要后台返回 JSON 的时候，请直接调用 jQuery.ajax 函数（不推荐使用 F.doPostBack 函数)！
}

@section script {

    <script>

        function onTextBoxEnter(event) {
            var me = this;

            // 显式指定 handler，使 RazorForms 将它识别为独立页面地址。
            F.doPostBack({
                url: '@Url.Page("/Other/CustomPostbackJsonData", "Process")',
                params: {
                    text1: me.getValue()
                },
                complete: function (data, textStatus, xhr) {
                    // 失败响应仍交给 FineUI 的默认错误处理，不尝试解析为业务 JSON。
                    if (textStatus !== 'success') {
                        return;
                    }

                    var json = JSON.parse(data);

                    F.ui.TextBox2.setValue(json.text);
                    F.ui.TextBox2.focus();

                    // 已自行处理原始 JSON；阻止 FineUI 将它当作响应脚本执行。
                    return false;
                }
            });

        }

    </script>

}
