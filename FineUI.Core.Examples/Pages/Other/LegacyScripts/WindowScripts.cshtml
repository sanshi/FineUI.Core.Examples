@page
@model FineUI.Core.Examples.Pages.Other.LegacyScripts.WindowScriptsModel
@{
    ViewBag.Title = "窗口显示、隐藏与最大化脚本";
    ViewBag.SourceFiles = "~/Code/LegacyScriptPageBase.cs";
}

@section body {

    <f:Button ID="btnShow" Text="显示窗口" CssClass="marginr" OnClick="btnShow_Click" />
    <f:Button ID="btnHide" Text="隐藏窗口" OnClick="btnHide_Click" />
    <f:Window ID="Window1" Title="旧窗口脚本" Hidden="true" IsModal="false" Width="380" Height="220" BodyPadding="10">
        <Items>
            <f:Button ID="btnMaximize" Text="最大化" CssClass="marginr" OnClick="btnMaximize_Click" />
            <f:Button ID="btnRestore" Text="还原" OnClick="btnRestore_Click" />
        </Items>
    </f:Window>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>用后台生成的旧脚本引用显示、最大化、还原和隐藏窗体。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>对照当前旧写法</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Window1" title="旧窗口脚本">旧窗口脚本</strong>中，依次点击<strong
                    class="example-control-reference" data-example-control="btnShow" title="显示窗口">显示窗口</strong>、<strong class="example-control-reference"
                    data-example-control="btnMaximize" title="最大化">最大化</strong>、还原和<strong class="example-control-reference" data-example-control="btnHide"
                    title="隐藏窗口">隐藏窗口</strong>。<br />结果：各次回发后窗体按顺序显示、<strong class="example-control-reference" data-example-control="btnMaximize"
                    title="最大化">最大化</strong>、恢复普通大小和隐藏。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <ul class="compatibility-notes">
            <li>旧 GetShowReference、GetHideReference、GetMaximizeReference 和 GetRestoreReference 仍可交给启动脚本执行。</li>
            <li>本页已禁用 CSP 脚本限制，用于演示和验证旧脚本写法；启用严格 CSP 的页面应使用结构化动作或具名函数。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>GetShowReference / GetHideReference</code>（<strong class="example-control-reference" data-example-control="Window1"
                    title="旧窗口脚本">旧窗口脚本</strong>）：本页用于对照仍需兼容的旧写法；已明确关闭脚本 CSP 限制。严格 CSP 页面应使用结构化动作或具名函数。</li>
        </ul>
    </section>
}
