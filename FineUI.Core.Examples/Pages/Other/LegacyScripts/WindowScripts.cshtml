@page
@model FineUI.Core.Examples.Pages.Other.LegacyScripts.WindowScriptsModel
@{
    ViewBag.Title = "窗口显示、隐藏与最大化脚本";
    ViewBag.SourceFiles = "~/Code/LegacyScriptPageBase.cs";
}

@section body {

    <f:Button ID="btnShow" Text="显示窗口" CssClass="marginr" OnClick="btnShow_Click" />
    <f:Button ID="btnHide" Text="隐藏窗口" OnClick="btnHide_Click" />
    <f:Window ID="Window1" Title="旧窗口脚本" Hidden="true" IsModal="false" Width="380" Height="220" BodyPadding="10">
        <Items>
            <f:Button ID="btnMaximize" Text="最大化" CssClass="marginr" OnClick="btnMaximize_Click" />
            <f:Button ID="btnRestore" Text="还原" OnClick="btnRestore_Click" />
        </Items>
    </f:Window>
    <ul class="compatibility-notes">
        <li>旧 GetShowReference、GetHideReference、GetMaximizeReference 和 GetRestoreReference 仍可交给启动脚本执行。</li>
        <li>本页已禁用 CSP 脚本限制，用于演示和验证旧脚本写法；启用严格 CSP 的页面应使用结构化动作或具名函数。</li>
    </ul>
}
