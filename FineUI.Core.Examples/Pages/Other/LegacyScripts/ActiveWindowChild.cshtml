@page
@model FineUI.Core.Examples.Pages.Other.LegacyScripts.ActiveWindowChildModel
@{
    ViewBag.Title = "保存并关闭子窗口";
    ViewBag.SourceFiles = "~/Code/LegacyScriptPageBase.cs";
}

@section body {

    <f:Button ID="btnSave" Text="保存并关闭" OnClick="btnSave_Click" CssClass="marginr" />
    <f:Button ID="btnCallback" Text="关闭后执行父页脚本" OnClick="btnCallback_Click" />
    <ul class="compatibility-notes">
        <li>该页由父页面的窗口打开，演示旧保存关窗和父页刷新脚本的组合。</li>
        <li>本页已禁用 CSP 脚本限制，用于演示和验证旧脚本写法；启用严格 CSP 的页面应使用结构化动作或具名函数。</li>
    </ul>
}
