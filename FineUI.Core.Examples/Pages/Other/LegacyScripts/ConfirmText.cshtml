@page
@model FineUI.Core.Examples.Pages.Other.LegacyScripts.ConfirmTextModel
@{
    ViewBag.Title = "确认文字中的旧 script 表达式";
    ViewBag.SourceFiles = "~/Code/LegacyScriptPageBase.cs";
}

@section body {

    <f:SimpleForm ID="SimpleForm1" Title="动态确认文字" ShowHeader="true" IsFluid="true" BodyPadding="10" LabelWidth="120">
        <Items>
            <f:TextBox ID="tbxName" Label="客户名称" Text="客户甲" />
            <f:Button ID="btnConfirm" Text="显示动态确认文字" OnClick="btnConfirm_Click" />
            <f:Label ID="labResult" Text="尚未确认" />
        </Items>
    </f:SimpleForm>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在点击时计算旧确认文字表达式，使用当前客户名称。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>对照当前旧写法</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="SimpleForm1"
                    title="动态确认文字">动态确认文字</strong>中，保留客户甲并打开确认后取消；改为客户乙后再次打开并确认。<br />结果：第一次取消不执行后台；第二次确认文字包含客户乙，后台结果也显示客户乙。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <ul class="compatibility-notes">
            <li>此页明确开启 AllowDangerousScriptTag，保留确认文字中的旧表达式；取消确认不会执行后台事件。</li>
            <li>本页已禁用 CSP 脚本限制，用于演示和验证旧脚本写法；启用严格 CSP 的页面应使用结构化动作或具名函数。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ConfirmText</code>（<strong class="example-control-reference" data-example-control="SimpleForm1"
                    title="动态确认文字">动态确认文字</strong>）：本页用于对照仍需兼容的旧写法；已明确关闭脚本 CSP 限制。严格 CSP 页面应使用结构化动作或具名函数。</li>
        </ul>
    </section>
}
