@page
@model FineUI.Core.Examples.Pages.Other.LegacyScripts.ConfirmTextModel
@{
    ViewBag.Title = "确认文字中的旧 script 表达式";
    ViewBag.SourceFiles = "~/Code/LegacyScriptPageBase.cs";
}

@section body {

    <f:SimpleForm ID="SimpleForm1" Title="动态确认文字" ShowHeader="true" IsFluid="true" BodyPadding="10" LabelWidth="120">
        <Items>
            <f:TextBox ID="tbxName" Label="客户名称" Text="客户甲" />
            <f:Button ID="btnConfirm" Text="显示动态确认文字" OnClick="btnConfirm_Click" />
            <f:Label ID="labResult" Text="尚未确认" />
        </Items>
    </f:SimpleForm>
    <ul class="compatibility-notes">
        <li>此页明确开启 AllowDangerousScriptTag，保留确认文字中的旧表达式；取消确认不会执行后台事件。</li>
        <li>本页已禁用 CSP 脚本限制，用于演示和验证旧脚本写法；启用严格 CSP 的页面应使用结构化动作或具名函数。</li>
    </ul>
}
