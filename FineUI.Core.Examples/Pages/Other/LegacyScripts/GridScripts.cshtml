@page
@model FineUI.Core.Examples.Pages.Other.LegacyScripts.GridScriptsModel
@{
    ViewBag.Title = "表格追加与改单元格的旧脚本引用";
    ViewBag.SourceFiles = "~/Code/LegacyScriptPageBase.cs";
}

@section body {
    <f:Grid ID="Grid1" Title="旧表格脚本" ShowHeader="true" Height="220" DataIDField="Id">
        <Columns>
            <f:RenderField ColumnID="Name" DataField="Name" HeaderText="客户" ExpandUnusedSpace="true" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button ID="btnAppend" Text="追加一行" OnClick="btnAppend_Click" CssClass="marginr" />
    <f:Button ID="btnUpdate" Text="修改第一行" OnClick="btnUpdate_Click" CssClass="marginr" />
    <f:Button ID="btnReset" Text="重新加载" OnClick="btnReset_Click" />
    <ul class="compatibility-notes">
        <li>旧 GetAppendDataReference 和 GetUpdateCellValueReference 返回脚本，再交给 RegisterStartupScript 执行；新代码可直接调用后台控件的方法。</li>
        <li>本页已禁用 CSP 脚本限制，用于演示和验证旧脚本写法；启用严格 CSP 的页面应使用结构化动作或具名函数。</li>
    </ul>
}
