@page
@model FineUI.Core.Examples.Pages.Other.LegacyScripts.GridScriptsModel
@{
    ViewBag.Title = "表格追加与改单元格的旧脚本引用";
    ViewBag.SourceFiles = "~/Code/LegacyScriptPageBase.cs";
}

@section body {
    <f:Grid ID="Grid1" Title="旧表格脚本" ShowHeader="true" Height="220" DataIDField="Id">
        <Columns>
            <f:RenderField ColumnID="Name" DataField="Name" HeaderText="客户" ExpandUnusedSpace="true" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button ID="btnAppend" Text="追加一行" OnClick="btnAppend_Click" CssClass="marginr" />
    <f:Button ID="btnUpdate" Text="修改第一行" OnClick="btnUpdate_Click" CssClass="marginr" />
    <f:Button ID="btnReset" Text="重新加载" OnClick="btnReset_Click" />

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>使用旧脚本引用追加行、更新单元格和重新加载表格。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>对照当前旧写法</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Grid1" title="旧表格脚本">旧表格脚本</strong>中，依次点击追加一行两次、<strong
                    class="example-control-reference" data-example-control="btnUpdate" title="修改第一行">修改第一行</strong>、<strong class="example-control-reference"
                    data-example-control="btnReset" title="重新加载">重新加载</strong>。<br />结果：先增加两条新增客户，再只修改第一行；<strong class="example-control-reference"
                    data-example-control="btnReset" title="重新加载">重新加载</strong>后恢复原始记录并移除追加行。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <ul class="compatibility-notes">
            <li>旧 GetAppendDataReference 和 GetUpdateCellValueReference 返回脚本，再交给 RegisterStartupScript 执行；新代码可直接调用后台控件的方法。</li>
            <li>本页已禁用 CSP 脚本限制，用于演示和验证旧脚本写法；启用严格 CSP 的页面应使用结构化动作或具名函数。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>GetAppendDataReference / GetUpdateCellValueReference</code>（<strong class="example-control-reference" data-example-control="Grid1"
                    title="旧表格脚本">旧表格脚本</strong>）：本页用于对照仍需兼容的旧写法；已明确关闭脚本 CSP 限制。严格 CSP 页面应使用结构化动作或具名函数。</li>
        </ul>
    </section>
}
