@page
@model FineUI.Core.Examples.Pages.Other.LegacyScripts.ListenersModel
@{
    ViewBag.Title = "Listener：函数名、调用语句与参数";
    ViewBag.SourceFiles = "~/Code/LegacyScriptPageBase.cs";
}

@section body {

    <f:Button ID="btnName" Text="函数名" CssClass="marginr" />
    <f:Button ID="btnCall" Text="无参调用（无分号）" CssClass="marginr" />
    <f:Button ID="btnSemicolon" Text="无参调用（有分号）" CssClass="marginr" />
    <f:Button ID="btnArguments" Text="带参数调用" CssClass="marginr" />
    <f:Button ID="btnStatements" Text="多条语句" />
    <br /><br />
    <f:Label ID="labResult" Text="尚未点击" />

}

@section script {
    <script>

        function onLegacyNameClick(event) {
            showLegacyResult('函数名');
        }

        function showLegacyCallResult() {
            showLegacyResult('无参函数已执行');
        }

        function showLegacyResult(message) {
            F.ui.labResult.setText(message);
        }
    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>对照旧监听器支持的函数名、调用表达式和多条语句。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>对照当前旧写法</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="btnName" title="函数名">函数名</strong>中，分别点击<strong class="example-control-reference" data-example-control="btnName" title="函数名">函数名</strong>、两种无参调用、带参数调用和<strong class="example-control-reference" data-example-control="btnStatements" title="多条语句">多条语句</strong>按钮。<br />结果：结果标签显示对应调用文字，两种无参调用得到相同结果；均在浏览器执行。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <ul class="compatibility-notes">
        <li>两个无参调用只相差末尾分号，效果相同；“带参数调用”单独演示传入文字，函数名写法保留事件参数。</li>
        <li>本页已禁用 CSP 脚本限制，用于演示和验证旧脚本写法；启用严格 CSP 的页面应使用结构化动作或具名函数。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Listener</code>（<strong class="example-control-reference" data-example-control="btnName" title="函数名">函数名</strong>）：本页用于对照仍需兼容的旧写法；已明确关闭脚本 CSP 限制。严格 CSP 页面应使用结构化动作或具名函数。</li>
    </ul>
</section>
}
