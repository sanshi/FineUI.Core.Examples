@page
@model FineUI.Core.Examples.Pages.Other.LegacyScripts.StartupScriptModel
@{
    ViewBag.Title = "启动脚本：首次显示与回发";
    ViewBag.SourceFiles = "~/Code/LegacyScriptPageBase.cs";
}

@section body {

    <f:SimpleForm ID="SimpleForm1" Title="回发后执行脚本" ShowHeader="true" IsFluid="true" BodyPadding="10" LabelWidth="120">
        <Items>
            <f:TextBox ID="tbxValue" Text="客户备注" Label="要显示的文字" />
            <f:Button ID="btnRun" Text="回发后执行脚本" OnClick="btnRun_Click" />
            <f:Label ID="labResult" Text="等待脚本执行" />
        </Items>
    </f:SimpleForm>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>用旧启动脚本在首屏和回发后更新标签，并保留输入文字。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>对照当前旧写法</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="SimpleForm1" title="回发后执行脚本">回发后执行脚本</strong>中，输入备注后点击回发后执行脚本。<br />结果：后台返回启动脚本，标签显示本次输入；连续操作读取每次新值。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <ul class="compatibility-notes">
        <li>首次显示和回发都可以使用 RegisterStartupScript；点击按钮后，浏览器收到回发响应再执行脚本并显示当前输入。</li>
        <li>本页已禁用 CSP 脚本限制，用于演示和验证旧脚本写法；启用严格 CSP 的页面应使用结构化动作或具名函数。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>RegisterStartupScript</code>（<strong class="example-control-reference" data-example-control="SimpleForm1" title="回发后执行脚本">回发后执行脚本</strong>）：本页用于对照仍需兼容的旧写法；已明确关闭脚本 CSP 限制。严格 CSP 页面应使用结构化动作或具名函数。</li>
    </ul>
</section>
}
