@page
@model FineUI.Core.Examples.Pages.Other.LegacyScripts.StartupScriptModel
@{
    ViewBag.Title = "启动脚本：首次显示与回发";
    ViewBag.SourceFiles = "~/Code/LegacyScriptPageBase.cs";
}

@section body {

    <f:SimpleForm ID="SimpleForm1" Title="回发后执行脚本" ShowHeader="true" IsFluid="true" BodyPadding="10" LabelWidth="120">
        <Items>
            <f:TextBox ID="tbxValue" Text="客户备注" Label="要显示的文字" />
            <f:Button ID="btnRun" Text="回发后执行脚本" OnClick="btnRun_Click" />
            <f:Label ID="labResult" Text="等待脚本执行" />
        </Items>
    </f:SimpleForm>
    <ul class="compatibility-notes">
        <li>首次显示和回发都可以使用 RegisterStartupScript；点击按钮后，浏览器收到回发响应再执行脚本并显示当前输入。</li>
        <li>本页已禁用 CSP 脚本限制，用于演示和验证旧脚本写法；启用严格 CSP 的页面应使用结构化动作或具名函数。</li>
    </ul>
}
