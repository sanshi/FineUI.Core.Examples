@page
@model FineUI.Core.Examples.Pages.GridDataUrl.PagingSummaryCurrentPageModel
@{
    ViewBag.SourceFiles = "~/GridDataUrl/PagingSummaryCurrentPageData";
    ViewBag.Title = "GridDataUrl/PagingSummaryCurrentPage";
    var F = Html.F();
}


@section head {

    <style>
        .f-grid-row-summary .f-grid-cell-text {
            font-weight: bold;
            color: red;
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataUrl="@Url.Content("~/GridDataUrl/PagingSummaryData")"
            AllowPaging="true" IsDatabasePaging="false" PageSize="5" EnableSummary="true" SummaryPosition="Bottom" Height="350">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="学费" ColumnID="Fee" DataField="Fee" />
            <f:RenderField HeaderText="学杂费" ColumnID="ExtraFee" DataField="ExtraFee" />
        </Columns>
        <Listeners>
            <f:Listener Event="dataload" Handler="onGrid1DataLoad"></f:Listener>
        </Listeners>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onGrid1DataLoad(event) {
            var grid1 = this;

            var feeTotal = 0, extraFeeTotal = 0;
            var startRowIndex = grid1.getStartRowIndex(), endRowIndex = grid1.getEndRowIndex();
            for (var i = startRowIndex; i <= endRowIndex; i++) {
                var rowData = grid1.data[i];
                feeTotal += rowData.values['Fee'];
                extraFeeTotal += rowData.values['ExtraFee'];
            }
            

            grid1.setSummaryData({
                'Fee': feeTotal,
                'ExtraFee': extraFeeTotal
            });
        }

    </script>
}
