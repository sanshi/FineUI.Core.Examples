@page
@model FineUI.Core.Examples.Pages.GridDataUrl.LockColumnModel
@{
    ViewBag.SourceFiles = "~/GridDataUrl/GridDataUrlData";
    ViewBag.Title = "GridDataUrl/LockColumn";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataUrl="@Url.Content("~/GridDataUrl/GridDataUrlData")"
            EnableCheckBoxSelect="true" AllowColumnLocking="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" Locked="true" EnableLock="true" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" EnableLock="true" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" EnableLock="true" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" EnableLock="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" Width="400" EnableLock="true" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" EnableLock="true" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>


}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>在网址数据加载完成后保持姓名列锁定，横向滚动仍可识别记录。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>数据加载后核对锁定列</h3>
    <ul>
        <li>等待<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>记录出现，再横向滚动。<br />结果：<strong>姓名</strong>保持在锁定区域，其余列随滚动移动，列头、正文与当前行对应。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>DataUrl</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：异步提供正文记录。</li>
        <li><code>AllowColumnLocking</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>true</code>，为异步数据使用锁定区域。</li>
        <li><code>Locked</code>（<strong>姓名列</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：<strong>姓名</strong>列初始锁定，配置不依赖数据先在后台绑定。</li>
    </ul>
</section>
}
