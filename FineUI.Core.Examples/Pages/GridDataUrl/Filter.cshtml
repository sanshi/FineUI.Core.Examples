@page
@model FineUI.Core.Examples.Pages.GridDataUrl.FilterModel
@{
    ViewBag.SourceFiles = "~/Pages/GridDataUrl/FilterData.cshtml;~/Pages/GridDataUrl/FilterData.cshtml.cs";
    ViewBag.Title = "GridDataUrl/Filter";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" EnableCollapse="false" EnableCheckBoxSelect="true"
            DataIDField="Id" DataUrl="@Url.Content("~/GridDataUrl/FilterData")" DataMethod="POST" AllowFilters="true">
        <Columns>
            <f:RowNumberField></f:RowNumberField>
            <f:RenderField ColumnID="Name" DataField="Name" HeaderText="姓名" EnableFilter="true">
                <Filter EnableMultiConditions="true" MatcherDefault="any">
                    <Operator>
                        <f:DropDownList ID="DropDownList1">
                            <f:ListItem Text="等于" Value="equal" />
                            <f:ListItem Text="包含" Value="contain" Selected="true" />
                            <f:ListItem Text="开始于" Value="start" />
                            <f:ListItem Text="结束于" Value="end" />
                        </f:DropDownList>
                    </Operator>
                </Filter>
            </f:RenderField>
            <f:RenderField ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender" HeaderText="性别">
            </f:RenderField>
            <f:RenderField ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int" HeaderText="入学年份" EnableFilter="true">
                <Filter EnableMultiConditions="true">
                    <Operator>
                        <f:DropDownList ID="DropDownList2">
                            <f:ListItem Text="大于" Value="greater" Selected="true" />
                            <f:ListItem Text="小于" Value="less" />
                            <f:ListItem Text="等于" Value="equal" />
                        </f:DropDownList>
                    </Operator>
                    <Field>
                        <f:NumberBox ID="NumberBox1" NoDecimal="true" NoNegative="true" Required="true" MinValue="1995"></f:NumberBox>
                    </Field>
                </Filter>
            </f:RenderField>
            <f:RenderCheckField ColumnID="AtSchool" DataField="AtSchool" RenderAsStaticField="true" HeaderText="是否在校" />
            <f:RenderField ColumnID="Major" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" HeaderText="所学专业" EnableFilter="true">
                <Filter>
                    <Field>
                        <f:CheckBoxList ID="CheckBoxList1" ColumnNumber="1" Required="true">
                            <f:CheckItem Text="材料科学与工程系" Value="材料科学与工程系" />
                            <f:CheckItem Text="化学系" Value="化学系" />
                            <f:CheckItem Text="物理系" Value="物理系" />
                            <f:CheckItem Text="数学系" Value="数学系" />
                            <f:CheckItem Text="自动化系" Value="自动化系" />
                        </f:CheckBoxList>
                    </Field>
                </Filter>
            </f:RenderField>
            <f:RenderField ColumnID="Group" DataField="Group" RendererFunction="renderGroup" HeaderText="分组">
            </f:RenderField>
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>通过表头输入条件，用数据请求把过滤参数交给网址接口，再显示匹配记录。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>用条件重新请求异步数据</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong><strong>姓名</strong>过滤中选择包含，输入<code>张</code>并确定。<br />结果：浏览器通过本页配置的 POST 数据请求提交过滤条件，接口返回匹配记录；清除条件后重新取得完整结果。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>DataMethod</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>POST</code>，使用 POST 向 DataUrl 发送过滤参数，与普通按钮回发分别处理。</li>
        <li><code>AllowFilters</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>true</code>，为启用过滤的列创建条件入口，结果由数据接口筛选返回。</li>
    </ul>
</section>
}
