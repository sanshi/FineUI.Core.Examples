@page
@model FineUI.Core.Examples.Pages.GridDataUrl.TreeGridLazyLoadModel
@{
    ViewBag.SourceFiles = "~/GridDataUrl/TreeGridLazyLoadData";
    ViewBag.Title = "GridDataUrl/TreeGridLazyLoad";
    var F = Html.F();
}



@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="树表格" DataIDField="Id" DataTextField="Name" EnableTree="true" TreeColumn="Name"
        DataParentIDField="ParentId" DataUrl="@Url.Content("~/GridDataUrl/TreeGridLazyLoadData")" RowDataBoundFunction="onGrid1RowDataBound">
        <Columns>
            <f:RowNumberField />
            <f:RenderField ColumnID="Name" HeaderText="名称" DataField="Name" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="类型" DataField="Type" Width="150" />
            <f:RenderField HeaderText="大小" DataField="Size" Width="150" />
            <f:RenderField HeaderText="修改日期" DataField="ModifyDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" Width="150" />
        </Columns>
    </f:Grid>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onGrid1RowDataBound(rowData) {

            // 显式设置类型[文件夹]为非叶子节点（展开时延迟加载）
            // 如果不如此设置，则没有子节点的节点都被默认作为叶子节点
            var rowType = rowData.values.Type;
            if (rowType === '文件夹') {
                rowData.leaf = false;
            }
        }

    </script>
}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>按数据网址逐级加载树分支，首次只取得顶层节点。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>展开目录时请求该分支</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="Grid1"
                    title="树表格">树表格</strong>目录前的展开箭头。<br />结果：请求带上当前父节点标识，接口只返回这个目录的子项并追加到原父行；不是每次展开都重新绑定整棵树。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DataUrl</code>（<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>）：为树节点提供数据接口。</li>
            <li><code>DataParentIDField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>）：初始为
                <code>ParentId</code>，使用父主键关联节点，不只按返回数组位置判断层级。
            </li>
            <li><code>rowData.leaf</code>（<strong>树节点行绑定处理</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="树表格">树表格</strong>）：行绑定把可延迟展开的文件夹指定为 false；没有子项的当前返回节点也不会被误认成永久叶子。</li>
        </ul>
    </section>
}
