@page
@model FineUI.Core.Examples.Pages.GridDataUrl.SelectRowsRowDataModel
@{
    ViewBag.SourceFiles = "~/GridDataUrl/GridDataUrlData";
    ViewBag.Title = "GridDataUrl/SelectRowsRowData";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataUrl="@Url.Content("~/GridDataUrl/GridDataUrlData")"
        _SelectedRowIDArray="105,110">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button ID="btnShowSelectedRows" Text="选中了哪些行" CssClass="marginr" ClickHandler="onButton1Click"></f:Button>

    <f:Button ID="btnSelectNamedRows" Text="选中[陈飞]，[彭博]，[唐超]所在的行" OnClick="btnSelectNamedRows_Click"></f:Button>
    <br>
    <br>

    <br />
    <br />


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onButton1Click(event) {

            var result = '<table class="result"><tr><th>ID</th><th>姓名</th><th>性别</th><th>所学专业</th></tr>';
            $.each(F.ui.Grid1.getSelectedRows(true), function (index, item) {

                var values = item.values;

                result += F.formatString("<tr><td>{0}</td><td>{1}</td><td>{2}</td><td>{3}</td></tr>",
                    item.id,
                    values.Name,
                    values.Gender == 0 ? '女' : '男',
                    values.Major);

            });

            result += '</table>';

            showNotify(F.rawHtml('选中的行：<br/>' + result));
        }

    </script>
}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>在异步加载的表格中取得选中记录的完整行值，直接显示姓名、性别与专业。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>读取实际加载行中的字段</h3>
        <ol>
            <li>点击<strong class="example-control-reference" data-example-control="btnSelectNamedRows"
                    title="选中[陈飞]，[彭博]，[唐超]所在的行">选中[陈飞]，[彭博]，[唐超]所在的行</strong>。<br />结果：选择切换到陈飞、彭博、唐超对应的行，按主键 102、106、108 定位，不把它们解释为当前行序号。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnShowSelectedRows" title="选中了哪些行">选中了哪些行</strong>。<br />结果：浏览器通过
                getSelectedRows(true) 取得行对象，在提示中列出各行<strong>姓名</strong>、<strong>性别</strong>和专业；异步数据不需要先在后台绑定成静态 Rows。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：表格默认选中了[康颖颖]，[徐鹏]所在的行。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>getSelectedRows(true)</code>（<strong>网址数据加载与页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：返回包含 id、text 与 values 的实际已加载行对象。</li>
        </ul>
    </section>
}
