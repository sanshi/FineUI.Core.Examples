@page
@model FineUI.Core.Examples.Pages.GridDataUrl.RowDoubleClickModel
@{
    ViewBag.SourceFiles = "~/GridDataUrl/GridDataUrlData";
    ViewBag.Title = "GridDataUrl/RowDoubleClick";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name"
            _DataKeyNames="Id,Name"
            DataUrl="@Url.Content("~/GridDataUrl/GridDataUrlData")" OnRowDoubleClick="Grid1_RowDblClick">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>


}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>双击通过网址加载的记录，把当前行标识与文字提交到后台事件。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>从当前异步记录读取事件参数</h3>
    <ul>
        <li>双击<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>首行<strong>姓名</strong>。<br />结果：后台提示本次行号、行标识与<strong>姓名</strong>；参数来自当前加载记录，不是把显示序号当作业务主键。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>OnRowDoubleClick / DataKeyNames</code>（<strong>网址数据加载与页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：按当前节点的行对象或提交键值取得主键与<strong>姓名</strong>；本页只显示收到的事件参数。</li>
    </ul>
</section>
}
