@page
@model FineUI.Core.Examples.Pages.GridDataUrl.TreeGridModel
@{
    ViewBag.SourceFiles = "~/GridDataUrl/TreeGridData";
    ViewBag.Title = "GridDataUrl/TreeGrid";
    var F = Html.F();
}



@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="树表格" DataIDField="Id" DataTextField="Name" EnableTree="true" TreeColumn="Name" DataParentIDField="ParentId" DataUrl="@Url.Content("~/GridDataUrl/TreeGridData")">
        <Columns>
            <f:RowNumberField />
            <f:RenderField ColumnID="Name" HeaderText="名称" DataField="Name" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="类型" DataField="Type" Width="150" />
            <f:RenderField HeaderText="大小" DataField="Size" Width="150" />
            <f:RenderField HeaderText="修改日期" DataField="ModifyDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" Width="150" />
        </Columns>
    </f:Grid>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>从数据网址取得带父子关系的记录，在名称列显示树形层级。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>异步数据到达后展开树</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>目录前的展开箭头。<br />结果：按加载数据的主键与父主键显示后代，其他分支保留当前展开状态。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>DataUrl</code>（<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>）：为树节点提供数据接口。</li>
        <li><code>DataParentIDField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>）：初始为 <code>ParentId</code>，使用父主键关联节点，不只按返回数组位置判断层级。</li>
    </ul>
</section>
}
