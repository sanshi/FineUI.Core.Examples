@page
@model FineUI.Core.Examples.Pages.GridDataUrl.PagingDatabaseSummaryModel
@{
    ViewBag.SourceFiles = "~/GridDataUrl/PagingDatabaseSummaryData";
    ViewBag.Title = "GridDataUrl/PagingDatabaseSummary";
    var F = Html.F();
}


@section head {

    <style>
        .f-grid-row-summary .f-grid-cell-text {
            font-weight: bold;
            color: red;
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataUrl="@Url.Content("~/GridDataUrl/PagingDatabaseSummaryData")"
        AllowPaging="true" IsDatabasePaging="true" PageSize="5" EnableSummary="true" SummaryPosition="Bottom" Height="350">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="学费" ColumnID="Fee" DataField="Fee" />
            <f:RenderField HeaderText="学杂费" ColumnID="ExtraFee" DataField="ExtraFee" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>


}


@section script {

    <script src="~/res/js/grid.js"></script>

}



@section exampleDescription {
    <section aria-label="页面描述">
        <p>从网址加载当前页记录，同时显示全部记录费用合计。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>翻页时核对统计范围</h3>
        <ol>
            <li>查看<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>费用合计，再点击下一页。<br />结果：接口按新页索引返回对应记录。合计保留全部记录范围，不缩小为新页数据之和。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>IsDatabasePaging</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>true</code>，数据接口按页返回记录并提供总记录数。
            </li>
            <li><code>summaryData</code>（<strong>合计数据与费用列</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：数据接口提供完整统计，正文分页与合计范围分别处理。</li>
        </ul>
    </section>
}
