@page
@model FineUI.Core.Examples.Pages.GridDataUrl.ChangeDataUrlDatabasePagingModel
@{
    ViewBag.SourceFiles = "~/GridDataUrl/PagingDatabaseData";
    ViewBag.Title = "GridDataUrl/ChangeDataUrlDatabasePaging";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataUrl="@Url.Content("~/GridDataUrl/PagingDatabaseData")"
        AllowPaging="true" IsDatabasePaging="true" PageSize="5">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button ID="btnSwitchDataUrl" Text="切换网址数据源" CssClass="marginr" ClickHandler="onButton1Click"></f:Button>

    <f:Button ID="btnSwitchDataUrlServer" Text="切换网址数据源（服务器端）" CssClass="marginr" OnClick="btnSwitchDataUrlServer_Click"></f:Button>



}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onButton1Click(event) {
            var grid1 = F.ui.Grid1;

            // 重置为第一页
            grid1.setPageIndex(0);

            var sourceKey = grid1.getAttr('data-source-key');
            if (sourceKey && sourceKey === 'source2') {
                grid1.setAttr('data-source-key', 'source1')
                grid1.loadDataUrl('@Url.Content("~/GridDataUrl/PagingDatabaseData")');
            } else {
                grid1.setAttr('data-source-key', 'source2')
                grid1.loadDataUrl('@Url.Content("~/GridDataUrl/PagingDatabaseData?data2=true")');
            }
        }

    </script>
}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>在浏览器或后台切换数据地址，重新加载另一组记录，并回到新数据源第一页。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>切换地址后核对当前数据</h3>
        <ol>
            <li>点击<strong class="example-control-reference" data-example-control="btnSwitchDataUrl"
                    title="切换网址数据源">切换网址数据源</strong>。<br />结果：脚本改用另一数据地址重新加载，原记录被替换，总行数和当前页码按新数据源更新。</li>
            <li>再点击<strong class="example-control-reference" data-example-control="btnSwitchDataUrlServer"
                    title="切换网址数据源（服务器端）">切换网址数据源（服务器端）</strong>。<br />结果：按钮先回发，由后台设置新 DataUrl；浏览器随后请求该地址取得数据。页索引回到 0，不把旧源末页页码带入新源。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DataUrl</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：地址变化后请求新来源，避免只改字段而仍显示旧数据。
            </li>
            <li><code>loadDataUrl</code>（<strong>网址数据加载与页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：客户端入口同时更换地址并加载记录；后台入口设置 DataUrl 后由浏览器执行请求。</li>
        </ul>
    </section>
}
