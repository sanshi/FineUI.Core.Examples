@page
@model FineUI.Core.Examples.Pages.GridDataUrl.PagingDatabaseSortingDatabaseModel
@{
    ViewBag.SourceFiles = "~/GridDataUrl/PagingDatabaseSortingDatabaseData";
    ViewBag.Title = "GridDataUrl/PagingDatabaseSortingDatabase";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataUrl="@Url.Content("~/GridDataUrl/PagingDatabaseSortingDatabaseData")"
            AllowSorting="true" IsDatabaseSorting="true" SortField="EntranceYear" SortDirection="ASC"
            AllowPaging="true" IsDatabasePaging="true" PageSize="5">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" SortField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" SortField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" SortField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" SortField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" SortField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" SortField="Group" RendererFunction="renderGroup" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>


}


@section script {

    <script src="~/res/js/grid.js"></script>

}


@section exampleDescription {
<section aria-label="页面描述">
    <p>使用数据网址分页并排序，区分浏览器处理与接口重新取数。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>分别核对换页与排序动作</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>分页栏下一页，再返回第一页。<br />结果：每次通过 DataUrl 提交页索引与页大小，接口仅返回当前页并提供总记录数，页码与记录同步变化。</li>
        <li>点击<strong>姓名</strong>列表头切换排序。<br />结果：请求向 DataUrl 携带排序字段与方向，接口按新规则提供数据，表头排序标记与结果一致。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>IsDatabasePaging</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>true</code>，只加载一页数据，接口还需提供总记录数。</li>
        <li><code>PageSize</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>5</code>，限制每页显示记录数。</li>
        <li><code>IsDatabaseSorting</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>true</code>，通过数据请求交给接口排序。</li>
    </ul>
</section>
}
