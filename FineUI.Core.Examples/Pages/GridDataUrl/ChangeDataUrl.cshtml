@page
@model FineUI.Core.Examples.Pages.GridDataUrl.ChangeDataUrlModel
@{
    ViewBag.SourceFiles = "~/GridDataUrl/GridDataUrlData";
    ViewBag.Title = "GridDataUrl/ChangeDataUrl";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataUrl="@Url.Content("~/GridDataUrl/GridDataUrlData")">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button ID="Button1" Text="切换网址数据源" CssClass="marginr" ClickHandler="onButton1Click"></f:Button>

    <f:Button ID="Button2" Text="切换网址数据源（服务器端）" CssClass="marginr" OnClick="Button2_Click">
    </f:Button>
    <f:Button ID="btnReload" Text="服务端重载当前地址" OnClick="btnReload_Click"></f:Button>



}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function reloadCurrentDataUrl() {
            F.ui.Grid1.loadDataUrl();
        }

        function onButton1Click(event) {
            var grid1 = F.ui.Grid1;

            var sourceKey = grid1.getAttr('data-source-key');
            if (sourceKey && sourceKey === 'source2') {
                grid1.setAttr('data-source-key', 'source1')
                grid1.loadDataUrl('@Url.Content("~/GridDataUrl/GridDataUrlData")');
            } else {
                grid1.setAttr('data-source-key', 'source2')
                grid1.loadDataUrl('@Url.Content("~/GridDataUrl/GridDataUrlData?data2=true")');
            }
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在浏览器或后台切换数据地址，重新加载另一组记录。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>切换地址后核对当前数据</h3>
        <ol>
            <li>点击<strong class="example-control-reference" data-example-control="Button1"
                    title="切换网址数据源">切换网址数据源</strong>。<br />结果：脚本改用另一数据地址重新加载，原记录被替换，表格记录数在本页两组示例数据之间变化。</li>
            <li>再点击<strong class="example-control-reference" data-example-control="Button2" title="切换网址数据源（服务器端）">切换网址数据源（服务器端）</strong>。<br />结果：按钮先回发，由后台设置新
                DataUrl；浏览器随后请求该地址取得数据。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>重载当前来源</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="btnReload"
                    title="服务端重载当前地址">服务端重载当前地址</strong>。<br />结果：重新请求当前已选择地址，记录继续来自当前来源，不自动退回首次加载的数据源。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DataUrl</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：地址变化后请求新来源，避免只改字段而仍显示旧数据。
            </li>
            <li><code>loadDataUrl</code>（<strong>网址数据加载与页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：客户端入口同时更换地址并加载记录；后台入口设置 DataUrl 后由浏览器执行请求。</li>
        </ul>
    </section>
}
