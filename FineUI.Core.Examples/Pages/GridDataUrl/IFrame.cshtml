@page
@model FineUI.Core.Examples.Pages.GridDataUrl.IFrameModel
@{
    ViewBag.SourceFiles = "~/GridDataUrl/GridDataUrlData";
    ViewBag.Title = "GridDataUrl/IFrame";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataUrl="@Url.Content("~/GridDataUrl/GridDataUrlData")">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField ColumnID="Actions" RendererFunction="renderEditAction" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Window ID="Window1" Title="审批" Hidden="true" EnableIFrame="true"
              EnableMaximize="true" EnableResize="true" Target="Top" OnClose="Window1_Close" IsModal="true" Width="850" Height="500">
    </f:Window>


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>


        function renderEditAction(value, params) {
            return $('<a>').addClass('action editit').attr('href', 'javascript:;')
                .append($('<img>').addClass('f-grid-imagefield').attr('src', '/res/icon/pencil.png'));
        }

        F.ready(function () {

            var grid1 = F.ui.Grid1; if (!grid1) return;
            var window1 = F.ui.Window1;
            var baseUrl = '@Url.Content("~/Grid/IFrameWindow")';

            grid1.el.on('click', '.f-grid-cell-Actions .action.editit', function (event) {
                var targetEl = $(this);
                var rowEl = targetEl.closest('.f-grid-row');
                var rowData = grid1.getRowData(rowEl);
                var rowId = rowData.id;
                var rowText = rowData.text;

                var iframeUrl = baseUrl + '?id=' + rowId + '&name=' + encodeURIComponent(rowText);
                // 显示窗体
                window1.show(iframeUrl, '审批 - ' + rowText);
            });


        });

    </script>
}
