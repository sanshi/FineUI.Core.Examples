@page
@model FineUI.Core.Examples.Pages.GridDataUrl.RowStyleModel
@{
    ViewBag.SourceFiles = "~/GridDataUrl/GridDataUrlData";
    ViewBag.Title = "GridDataUrl/RowStyle";
    var F = Html.F();
}


@section head {

    <style type="text/css">
        .f-grid-row.color1,
        .f-grid-row.color1 .f-icon,
        .f-grid-row.color1 a {
            background-color: #0094ff;
            color: #fff;
        }

        .f-grid-row.color3,
        .f-grid-row.color3 .f-icon,
        .f-grid-row.color3 a {
            background-color: #b200ff;
            color: #fff;
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataUrl="@Url.Content("~/GridDataUrl/GridDataUrlData")"
        RowDataBoundFunction="grid1RowDataBound">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        // 行渲染函数
        function grid1RowDataBound(rowData) {
            var entranceYear = rowData.values['EntranceYear'];

            if (entranceYear >= 2002 && entranceYear <= 2004) {
                rowData.cls = 'color1';
            } else if (entranceYear > 2008) {
                rowData.cls = 'color3';
            }
        }

    </script>
}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>异步数据到达后，按入学年份为指定记录设置整行样式。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>根据当前加载字段设置外观</h3>
        <ul>
            <li>对照<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong><strong>入学年份</strong>大于 2008
                的行与其他行。<br />结果：符合年份条件的记录使用 color3 行样式，整行受影响；其他行保留普通外观。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>RowDataBoundFunction / rowData.cls</code>（<strong>行绑定函数</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：在客户端取得本次实际行值后应用样式，异步请求结果不必先走服务器逐行绑定。</li>
        </ul>
    </section>
}
