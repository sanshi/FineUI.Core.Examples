@page
@model FineUI.Core.Examples.Pages.GridDataUrl.CellStyleModel
@{
    ViewBag.SourceFiles = "~/GridDataUrl/GridDataUrlData";
    ViewBag.Title = "GridDataUrl/CellStyle";
    var F = Html.F();
}


@section head {

    <style type="text/css">
        .color1 {
            background-color: #0094ff;
            color: #fff;
        }

        .color2 {
            background-color: #0026ff;
            color: #fff;
        }

        .color3 {
            background-color: #b200ff;
            color: #fff;
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataUrl="@Url.Content("~/GridDataUrl/GridDataUrlData")">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" RendererFunction="renderEntranceYear" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderGender(value, params) {
            if (value == 1) {
                params.cellCls = 'color1';
            } 

            return value == 1 ? '男' : '女';
        }

        function renderEntranceYear(value, params) {

            var entranceYear = params.rowData.values['EntranceYear'];

            if (entranceYear >= 2002 && entranceYear <= 2004) {
                params.cellCls = 'color3';
            } 

            return value;
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>异步数据到达后，只为符合性别条件的单元格设置样式。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>根据当前加载字段设置外观</h3>
    <ul>
        <li>对照<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>男性与女性的<strong>性别</strong>单元格。<br />结果：男性的<strong>性别</strong>格使用 color1 样式，同一行其他列及女性<strong>性别</strong>格不套用该样式；数据值不改变。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>RendererFunction / params.cellCls</code>（<strong>性别列渲染函数</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：在客户端取得本次实际行值后应用样式，异步请求结果不必先走服务器逐行绑定。</li>
    </ul>
</section>
}
