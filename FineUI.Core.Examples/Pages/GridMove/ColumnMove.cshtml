@page
@model FineUI.Core.Examples.Pages.GridMove.ColumnMoveModel
@{
    ViewBag.Title = "GridMove/ColumnMove";
    var F = Html.F();
}

@using Newtonsoft.Json.Linq;

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableColumnMove="true">
        <Columns>
            <f:RowNumberField ColumnID="RowNumber" />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name" />
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" ColumnID="Group" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" ColumnID="LogTime" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
        <Listeners>
            <f:Listener Event="columnmove" Handler="onGrid1ColumnMove"></f:Listener>
        </Listeners>
    </f:Grid>
    <br>
    <br>

    <f:Button ID="btnRefresh" Text="刷新本页面（保持列顺序）" ClickHandler="onRefreshClick"></f:Button>


    <br />
    <br />
    <f:Button Text="清空数据" ID="btnClearData" OnClick="btnClearData_Click" CssClass="marginr"></f:Button>
    <f:Button Text="重新绑定数据" ID="btnRebind" Icon="Reload" OnClick="btnRebindData_Click"></f:Button>
}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onRefreshClick(event) {
            window.location.reload();
        }


        function onGrid1ColumnMove(event, targetColumnId, sourceColumnId, operation) {
            var grid = this;

            // 列顺序数组
            var columnIds = $.map(grid.columns, function (item, index) {
                return item.columnId;
            });

            // 触发后台事件
            F.customEvent('Grid1_ColumnMove', {
                columnIds: columnIds
            });
        }


    </script>
}
@section exampleDescription {
<section aria-label="页面描述">
    <p>拖动列标题改变显示顺序，并在刷新后恢复已保存顺序。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>移动列后刷新核对</h3>
    <ol>
        <li>将<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>一个允许移动的列标题拖到另一列附近。<br />结果：列头和正文一起采用新顺序，行中的实际字段值仍对应原字段；事件读取最新列清单。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnRefresh" title="刷新本页面（保持列顺序）">刷新本页面（保持列顺序）</strong>。<br />结果：后台按当前会话保存的配置创建列，顺序恢复。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableColumnMove</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>true</code>，允许拖动列标题调整位置。</li>
        <li><code>columnmove</code>（<strong>页面移动脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：移动后读取列顺序与事件参数；需要恢复锁定时同时保存相应锁定状态。</li>
    </ul>
</section>
}
