@page
@model FineUI.Core.Examples.Pages.GridMove.RowSortModel
@{
    ViewBag.Title = "行拖拽排序";
}

@section body {
    <f:Grid ID="Grid1" IsFluid="true" Title="学生信息" DataIDField="Id" DataTextField="Name" EnableRowMove="true">
        <Columns>
            <f:RowNumberField ColumnID="RowNumber" />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name" />
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" ColumnID="Group" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" ColumnID="LogTime" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
        <Listeners>
            <f:Listener Event="rowmove" Handler="onRowOrderChanged" />
            <f:Listener Event="dataload" Handler="onRowOrderChanged" />
        </Listeners>
    </f:Grid>
    <f:Button ID="btnReset" Text="恢复初始顺序" CssClass="marginr" OnClick="btnReset_Click" />
    <f:Button ID="btnSaveToDB" Text="保存数据" CssClass="marginr" ClickHandler="onSaveToDBClick" />
    <f:Button ID="btnRefresh" Text="刷新本页面（请先点击保存按钮）" ClickHandler="onRefreshClick" />
    <br />
    <f:Label ID="labReset" />

    <p id="rowSortResult" aria-live="polite"></p>
}

@section script {
    <script src="~/res/js/grid.js"></script>
    <script>
        function onRowOrderChanged(event) {
            const rowIds = this.data.map(row => row.id);
            document.getElementById('rowSortResult').textContent = '当前顺序：' + rowIds.join('、');
        }

        function onSaveToDBClick(event) {
            // 提交行 ID 的排列，刷新时按这组 ID 重新读取学生数据。
            const rowIds = F.ui.Grid1.data.map(row => row.id);
            F.customEvent('Grid1_RowSort', { rowIds: rowIds });
        }

        function onRefreshClick(event) {
            window.location.reload();
        }
    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>拖动行调整记录顺序，先在浏览器重排，再按本页保存入口确认顺序。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>拖动后保存或恢复顺序</h3>
        <ol>
            <li>拖动<strong class="example-control-reference" data-example-control="Grid1"
                    title="学生信息">学生信息</strong>一行的拖动手柄到另一行之前或之后。<br />结果：记录顺序随落点改变，行标识和这一行的字段值保留，不把单元格内容拆到其他行。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnSaveToDB"
                    title="保存数据">保存数据</strong>后再刷新页面。<br />结果：客户端提交当前行标识顺序，后台在当前会话保存；刷新按该顺序重新绑定。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnReset"
                    title="恢复初始顺序">恢复初始顺序</strong>，再尝试拖动。<br />结果：重新绑定初始记录顺序，行拖动仍可使用；恢复数据不会关闭页面声明的拖动能力。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>拖动表格最左列的六点手柄调整行顺序。点击保存数据后，刷新页面会加载最近一次保存的顺序。恢复初始顺序后也可以再次保存。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableRowMove</code>（<strong class="example-control-reference" data-example-control="Grid1" title="学生信息">学生信息</strong>）：初始为
                <code>true</code>，显示可用于重排行的拖动入口。
            </li>
            <li><code>rowmove / data</code>（<strong>页面移动脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="学生信息">学生信息</strong>）：移动结束后遍历实际行记录的 id 取得顺序，不把显示序号当作稳定业务主键。</li>
        </ul>
    </section>
}
