@page
@model FineUI.Core.Examples.Pages.GridMove.RowMoveBetween2GridModel
@{
    ViewBag.Title = "GridMove/RowMoveBetween2Grid";
    var F = Html.F();
}


@section body {

    <f:Window ID="Window1" Title="选择用户窗体" IsModal="false" EnableClose="false" IconFont="_Group" Width="500" Height="350" Layout="HBox" BodyPadding="10">
        <Items>
            <f:GroupPanel BoxFlex="1" Title="数据源" Layout="Fit" BodyPadding="0">
                <Items>
                    <f:Grid ID="Grid1" ShowBorder="false" ShowHeader="false" EnableCollapse="false" DataIDField="Id" ShowGridHeader="false" EnableRowLines="false" EnableAlternateRowColor="false" DataSource="@DataSourceUtil.GetDataTable()">
                        <Columns>
                            <f:RenderField ColumnID="Name" DataField="Name" HeaderText="姓名" BoxFlex="1" />
                        </Columns>
                    </f:Grid>
                </Items>
            </f:GroupPanel>
            <f:Panel ShowBorder="false" ShowHeader="false" Width="60" Layout="VBox" BoxConfigPosition="Center" BodyPadding="10">
                <Items>
                    <f:Button ID="Button3" IconFont="_DoubleRight" MarginBottom="5" ClickHandler="onMoveRightAllClick"></f:Button>
                    <f:Button ID="Button1" IconFont="_Right" MarginBottom="5" ClickHandler="onMoveRightClick"></f:Button>
                    <f:Button ID="Button2" IconFont="_Left" MarginBottom="5" ClickHandler="onMoveLeftClick"></f:Button>
                    <f:Button ID="Button4" IconFont="_DoubleLeft" MarginBottom="5" ClickHandler="onMoveLeftAllClick"></f:Button>
                </Items>
            </f:Panel>
            <f:GroupPanel ID="GroupPanel1" BoxFlex="1" Title="已选择" Layout="Fit" BodyPadding="0">
                <Items>
                    <f:Grid ID="Grid2" BoxFlex="1" ShowBorder="false" ShowHeader="false" EnableCollapse="false" DataIDField="Id" ShowGridHeader="false" EnableRowLines="false" EnableAlternateRowColor="false">
                        <Columns>
                            <f:RenderField ColumnID="Name" DataField="Name" HeaderText="姓名" BoxFlex="1" />
                        </Columns>
                    </f:Grid>
                </Items>
            </f:GroupPanel>
        </Items>
        <Toolbars>
            <f:Toolbar ToolbarAlign="Right" Position="Bottom">
                <Items>
                    <f:Button ID="btnCheckSelected" Text="选择了那些用户（自定义回发）" Type="Submit" ClickHandler="onCheckSelectedClick"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Window>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>
        function onRefreshClick(event) {
            window.location.reload();
        }

        // 向右移动
        function moveRight(rowIds) {
            if (!rowIds.length) {
                return;
            }

            var gridLeft = F.ui.Grid1;
            var gridRight = F.ui.Grid2;

            // 添加到右侧
            var rowDatas = [];
            $.each(rowIds, function (index, item) {
                rowDatas.push(gridLeft.getRowData(item));
            });
            gridRight.addNewRecords(rowDatas, true);

            // 从左侧删除
            gridLeft.deleteRows(rowIds, true);
        }

        function onMoveRightAllClick(event) {
            var gridLeft = F.ui.Grid1;

            var rowIds = $.map(gridLeft.data, function (item, index) {
                return item.id;
            });

            // 全部行
            moveRight(rowIds);
        }

        function onMoveRightClick(event) {
            var gridLeft = F.ui.Grid1;

            // 选择的行
            moveRight(gridLeft.getSelectedRows());
        }

        // 向左移动
        function moveLeft(rowIds) {
            if (!rowIds.length) {
                return;
            }

            var gridLeft = F.ui.Grid1;
            var gridRight = F.ui.Grid2;

            // 添加到左侧
            var rowDatas = [];
            $.each(rowIds, function (index, item) {
                rowDatas.push(gridRight.getRowData(item));
            });
            gridLeft.addNewRecords(rowDatas, true);

            // 从右侧删除
            gridRight.deleteRows(rowIds, true);
        }

        function onMoveLeftClick(event) {
            var gridRight = F.ui.Grid2;

            // 选择的行
            moveLeft(gridRight.getSelectedRows());
        }

        function onMoveLeftAllClick(event) {
            var gridRight = F.ui.Grid2;

            var rowIds = $.map(gridRight.data, function (item, index) {
                return item.id;
            });

            // 全部行
            moveLeft(rowIds);
        }

        function onCheckSelectedClick(event) {
            var gridRight = F.ui.Grid2;

            // 姓名列表
            var columnNames = $.map(gridRight.data, function (item, index) {
                return {
                    id: item.id,
                    name: item.values['Name']
                };
            });

            // 触发后台事件
            F.customEvent('CheckSelected_Click', {
                columnNames: columnNames,
            });

        }


    </script>
}