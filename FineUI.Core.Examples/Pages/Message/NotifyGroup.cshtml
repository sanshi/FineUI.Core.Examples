@page
@model FineUI.Core.Examples.Pages.Message.NotifyGroupModel
@{
    ViewBag.SourceFiles = "~/res/js/notify-group.js";
    ViewBag.Title = "Message/NotifyGroup";
    var F = Html.F();
}

@section head
    {
    <style>
        .notify-group-item .f-messagebox-message {
            min-width: 260px;
        }
    </style>
}

@section body {

    <f:Button Text="弹出通知对话框（多次点击）" ID="btnOperation1" ClickHandler="onOperation1Click"></f:Button>


}


@section script {

    <script src="~/res/js/notify-group.js"></script>
    <script type="text/javascript">

        var _orderNumber = 0;

        function onOperation1Click(event) {
            // 创建一个消息对话框实例
            var displayTime = 2000 + Math.random() * 10000;

            var allMessageIcons = ['information', 'warning', 'question', 'error', 'success'];
            showNotifyGroup({
                message: F.rawHtml('这是第<strong>' + _orderNumber + '</strong>条提示信息，显示' + Math.floor(displayTime / 1000) + '秒'),
                messageIcon: allMessageIcons[_orderNumber % allMessageIcons.length],
                header: false,
                displayMilliseconds: displayTime
            });

            _orderNumber++;
        }

    </script>
}
@section exampleDescription {
<section aria-label="页面描述">
    <p>把连续创建的同组通知集中排列，避免互相重叠。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>连续创建通知</h3>
    <ul>
        <li>连续点击几次<strong class="example-control-reference" data-example-control="btnOperation1" title="弹出通知对话框（多次点击）">弹出通知对话框（多次点击）</strong>。<br />结果：通知按同组规则依次排列；观察每条消息的序号可区分创建顺序。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>showNotifyGroup(options, newestOnTop)</code>（<strong class="example-control-reference" data-example-control="btnOperation1" title="弹出通知对话框（多次点击）">弹出通知对话框（多次点击）</strong>）：本页共用函数维护当前通知队列，按窗口位置和间距集中排列。</li>
    </ul>
</section>
}
