@page
@model FineUI.Core.Examples.Pages.Message.AlertCustomIconModel
@{
    ViewBag.Title = "Message/AlertCustomIcon";
    var F = Html.F();
}


@section body {

    <f:Button Text="点击弹出对话框（Icon）" ID="btnHello" OnClick="btnHello_Click"></f:Button>
    <br />
    <br />
    <f:Button Text="在顶层窗口弹出对话框（IconUrl）" ID="btnHello2" OnClick="btnHello2_Click"></f:Button>
    <br />
    <br />
    <f:Button Text="在顶层窗口弹出对话框（IconFont）" ID="btnHello3" OnClick="btnHello3_Click"></f:Button>


}


@section exampleDescription {
<section aria-label="页面描述">
    <p>对照内置图片、自定义图片地址和图标字体三种消息图标来源。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-pic" aria-hidden="true"></i>对照图标来源</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="btnHello" title="点击弹出对话框（Icon）">点击弹出对话框（Icon）</strong>。<br />结果：后台回发后弹出提示框，消息旁显示该按钮所对应的图标。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnHello2" title="在顶层窗口弹出对话框（IconUrl）">在顶层窗口弹出对话框（IconUrl）</strong>。<br />结果：后台回发后弹出提示框，消息旁显示该按钮所对应的图标。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnHello3" title="在顶层窗口弹出对话框（IconFont）">在顶层窗口弹出对话框（IconFont）</strong>。<br />结果：后台回发后弹出提示框，消息旁显示该按钮所对应的图标。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Icon / IconUrl / IconFont</code>（<strong class="example-control-reference" data-example-control="btnHello" title="点击弹出对话框（Icon）">点击弹出对话框（Icon）</strong>）：为新对话框分别选择内置图标、图片地址或字体图标；本页按按钮分开演示。</li>
    </ul>
</section>
}
