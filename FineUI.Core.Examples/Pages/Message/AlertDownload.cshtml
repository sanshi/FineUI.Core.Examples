@page
@model FineUI.Core.Examples.Pages.Message.AlertDownloadModel
@{
    ViewBag.SourceFiles = "~/Message/AlertDownloadTextFile";
    ViewBag.Title = "Message/AlertDownload";
    var F = Html.F();
}


@section body {

    <f:Button Text="操作（先弹出提示框，点击确定后下载文件）" ID="btnOperation" OnClick="btnOperation_Click"></f:Button>

}


@section script {

    <script>

        function confirmOKCallback() {
            window.location.href = '@Url.Content("~/Message/AlertDownloadTextFile")';
        }

        function confirmCancelCallback() {
            // 触发后台事件
            F.customEvent('ConfirmCancel');
        }

    </script>

}
