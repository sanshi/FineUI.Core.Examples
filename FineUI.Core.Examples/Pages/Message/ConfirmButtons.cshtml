@page
@model FineUI.Core.Examples.Pages.Message.ConfirmButtonsModel
@{
    ViewBag.Title = "Message/ConfirmButtons";
    var F = Html.F();
}


@section body {

    <f:Button Text="操作一（自定义对话框按钮文本）" ID="btnOperation1" ClickHandler="onOperation1Click"></f:Button>

}


@section script {

    <script>

        function onOperation1Click(event) {

            F.create({
                type: 'MessageBox',
                message: '您即将直接退出，如果您修改了相关信息，请先保存！',
                title: '确认退出',
                buttons: [{
                    buttonId: 'ok',
                    text: '直接退出'
                }, {
                    buttonId: 'cancel',
                    text: '不退出'
                }],
                handler: function (event, buttonId) {
                    if (buttonId === 'ok') {
                        F.customEvent('ConfirmOK');
                    } else {
                        F.customEvent('ConfirmCancel');
                    }
                }
            });

        }

    </script>
}
@section exampleDescription {
<section aria-label="页面描述">
    <p>自定义确认框按钮文案，并按实际点击的按钮分支处理。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>区分自定义按钮</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="btnOperation1" title="操作一（自定义对话框按钮文本）">操作一（自定义对话框按钮文本）</strong>。<br />结果：确认框显示直接退出与不退出两个自定义按钮。</li>
        <li>分别点击直接退出和不退出；每次操作前重新打开确认框。<br />结果：分别执行相应回调并显示所点击按钮的提示；此页演示分支，不会真的退出系统。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>buttons / handler</code>（<strong class="example-control-reference" data-example-control="btnOperation1" title="操作一（自定义对话框按钮文本）">操作一（自定义对话框按钮文本）</strong>）：按钮定义设置文案；处理函数根据按钮标识决定执行哪条回调。</li>
    </ul>
</section>
}
