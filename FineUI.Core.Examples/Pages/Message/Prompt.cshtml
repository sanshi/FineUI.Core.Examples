@page
@model FineUI.Core.Examples.Pages.Message.PromptModel
@{
    ViewBag.Title = "Message/Prompt";
    var F = Html.F();
}


@section body {

    <f:Form ID="SimpleForm1" IsFluid="true" Title="创建输入对话框" LabelWidth="150" BodyPadding="10">
        <Items>
            <f:GroupPanel ID="GroupPanel2" Layout="Anchor" Title="常用属性">
                <Items>
                    <f:TextBox ID="tbxMessage" Required="true" ShowRedStar="true" Label="消息提示" Text="请输入你的住址？">
                    </f:TextBox>
                    <f:TextBox ID="tbxDefaultValue" Label="输入框缺省值" Text="这是缺省地址">
                    </f:TextBox>
                    <f:TextBox ID="tbxTitle" Label="对话框标题" Text="请输入">
                    </f:TextBox>
                    <f:CheckBox ID="cbxEnableClose" Checked="true" Label="是否可关闭"></f:CheckBox>
                    <f:CheckBox ID="cbxRequired" Checked="false" Label="是否必填项"></f:CheckBox>
                    <f:CheckBox ID="cbxIsMultiLine" Checked="true" OnCheckedChanged="cbxIsMultiLine_CheckedChanged" Label="是否多行输入框"></f:CheckBox>
                    <f:NumberBox ID="nbMultiLineHeight" NoDecimal="true" NoNegative="true" Label="多行输入框高度" MinValue="80" MaxValue="300" Text="100"></f:NumberBox>
                    <f:CheckBox ID="cbxIsPassword" Checked="false" Hidden="true" Label="是否密码输入框"></f:CheckBox>
                    <f:RadioButtonList ID="rblMessageBoxIcon" Label="消息图标" ColumnNumber="3">
                        <f:RadioItem Value="None" Text="无图标" Selected="true" />
                        <f:RadioItem Value="Information" Text="消息" />
                        <f:RadioItem Value="Warning" Text="警告" />
                        <f:RadioItem Value="Question" Text="问题" />
                        <f:RadioItem Value="Error" Text="错误" />
                        <f:RadioItem Value="Success" Text="成功" />
                    </f:RadioButtonList>
                </Items>
            </f:GroupPanel>
            <f:GroupPanel ID="GroupPanel1" Layout="Anchor" Title="其它属性">
                <Items>
                    <f:TextBox ID="tbxID" Label="对话框ID"></f:TextBox>
                    <f:NumberBox ID="nbWidth" NoDecimal="true" NoNegative="true" Label="对话框宽度" MinValue="200" MaxValue="900"></f:NumberBox>
                    <f:NumberBox ID="nbMinWidth" NoDecimal="true" NoNegative="true" Label="对话框最小宽度"></f:NumberBox>
                    <f:NumberBox ID="nbMaxWidth" NoDecimal="true" NoNegative="true" Label="对话框最大宽度"></f:NumberBox>
                    <f:RadioButtonList ID="rblTarget" Label="弹出位置" ColumnNumber="3">
                        <f:RadioItem Value="Self" Text="当前页面" Selected="true" />
                        <f:RadioItem Value="Parent" Text="父页面" />
                        <f:RadioItem Value="Top" Text="顶层页面" />
                    </f:RadioButtonList>
                </Items>
            </f:GroupPanel>
        </Items>
        <Toolbars>
            <f:Toolbar Position="Bottom" ToolbarAlign="Right">
                <Items>
                    <f:Button Text="点击弹出输入对话框" ID="btnHello" _ValidateForms="SimpleForm1" OnClick="btnSubmit_Click"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Form>


}


@section script {

    <script>

        function promptOKCallback(message) {
            var encodedMessage = F.htmlEncode(message).replace(/\r\n/ig, '\n').replace(/\r/ig, '\n').replace(/\n/ig, '<br/>');
            F.notify(F.rawHtml("你输入的住址是：" + encodedMessage));
        }


        function onMultiLineChange(event) {
            var checked = this.getValue();

            F.ui.nbMultiLineHeight.setHidden(!checked);
            F.ui.cbxIsPassword.setHidden(!checked);
        }

    </script>

}
