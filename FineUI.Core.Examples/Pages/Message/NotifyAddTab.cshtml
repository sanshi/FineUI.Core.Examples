@page
@model FineUI.Core.Examples.Pages.Message.NotifyAddTabModel
@{
    ViewBag.Title = "Message/NotifyAddTab";
    var F = Html.F();
}


@section head {

    <style>
        .addtabcontainer {
            text-align: center;
            padding-top: 20px;
            padding-bottom: 20px;
            font-size: 14px;
            font-weight: bold;
        }
    </style>

}

@section body {

    <f:Button Text="弹出通知对话框" ID="btnOperation1" OnClick="btnOperation1_Click"></f:Button>


}


@section script {

    <script type="text/javascript">

        F.ready(function () {
            $(document).on('click', '.addtablink[data-notify-id]', onAddExampleTabClick);
        });

        function onAddExampleTabClick(event) {
            event.preventDefault();
            openExampleHello($(this).attr('data-notify-id'));
        }

        function openExampleHello(notifyId) {
            parent.addExampleTab({
                iframeUrl: '@Url.Content("~/Basic/Hello")',
                title: '你好 FineUI.Core',
                icon: '@Url.Content("~/res/images/filetype/vs-aspx.png")',
                refreshWhenExist: true
            });

            // 关闭通知对话框
            F(notifyId).hide();
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>在通知正文中提供链接，把指定示例打开到父框架的主选项卡。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-link" aria-hidden="true"></i>从通知打开示例</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="btnOperation1" title="弹出通知对话框">弹出通知对话框</strong>。<br />结果：通知中显示向父页面添加选项卡的链接。</li>
        <li>点击通知正文中的链接。<br />结果：从框架打开时新增或激活对应示例标签，并隐藏通知；单独打开时按页面提供的打开方式访问示例。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>addExampleTab</code>（<strong class="example-control-reference" data-example-control="btnOperation1" title="弹出通知对话框">弹出通知对话框</strong>）：由通知链接的客户端回调请求父页面打开示例；链接文字不作为脚本执行。</li>
    </ul>
</section>
}
