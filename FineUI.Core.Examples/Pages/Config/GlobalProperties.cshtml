@page
@model FineUI.Core.Examples.Pages.Config.GlobalPropertiesModel
@{
    ViewBag.Title = "全局配置属性";
    ViewBag.IsDarkerBG = true;
    ViewBag.SourceFiles = "~/res/js/global-properties.js";
}

@section head {
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        .config-property-detail {
            box-sizing: border-box;
            max-width: min(76ch, calc(100vw - 6rem));
            white-space: normal;
            overflow-wrap: anywhere;
        }

        .config-property-detail pre {
            white-space: pre-wrap;
        }
    </style>
}

@section body {
    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowBorderShadow="true" ShowHeader="true" Title="全局配置属性" DataIDField="name" DataTextField="name"
        AllowPaging="true" PageSize="100" EnableTextSelection="true" EnableMultiSelect="false" EmptyText="未找到匹配的配置项，可缩短关键词或清除筛选条件。">
        <Toolbars>
            <f:Toolbar ID="ToolbarFilters" Position="Top" Layout="HBox" BoxConfigSpace="10" BodyPadding="5">
                <Items>
                    <f:DropDownList ID="ddlCategory" Label="配置分类" LabelAlign="LabelAlign.Top" BoxFlex="2" EmptyText="全部分类" AutoSelectFirstItem="false"
                        AutoShowClearIcon="true">
                        <Listeners>
                            <f:Listener Event="change" Handler="onConfigQueryChange" />
                        </Listeners>
                    </f:DropDownList>
                    <f:TriggerBox ID="tbxSearch" Label="搜索配置项" LabelAlign="LabelAlign.Top" BoxFlex="3" EmptyText="名称、含义或可选值" TriggerIcon="Clear"
                        AutoShowClearIcon="true">
                        <Listeners>
                            <f:Listener Event="change" Handler="onConfigQueryChange" />
                        </Listeners>
                    </f:TriggerBox>
                </Items>
            </f:Toolbar>
            <f:Toolbar ID="ToolbarOptions" Position="Top">
                <Items>
                    <f:ToolbarFill />
                    <f:Label ID="labResultCount" ShowLabel="false" />
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Columns>
            <f:RenderField DataField="name" RenderAsRowExpander="true" ExpandOnDblClick="false" RendererFunction="ConfigPropertyQuery.renderDetail" />
            <f:RenderField ColumnID="name" HeaderText="配置名称" DataField="name" Width="234" RendererFunction="ConfigPropertyQuery.renderName" />
            <f:RenderField ColumnID="description" HeaderText="含义" DataField="description" ExpandUnusedSpace="true" MinWidth="220" />
            <f:RenderField ColumnID="initialValue" HeaderText="初始值" DataField="initialText" Width="140" />
            <f:RenderField ColumnID="options" HeaderText="可选值或格式" DataField="options" Width="245" />
        </Columns>
        <Listeners>
            <f:Listener Event="rowclick" Handler="onConfigRowClick" />
            <f:Listener Event="rowexpanderexpand" Handler="onConfigRowExpand" />
            <f:Listener Event="rowexpandercollapse" Handler="onConfigRowCollapse" />
        </Listeners>
    </f:Grid>



}

@section script {
    <script type="application/json" id="configPropertyCatalog" data-format="json" data-example-label="FineUI 节内写法"
            data-grid="Grid1" data-category="ddlCategory" data-search="tbxSearch" data-count="labResultCount">@Json.Serialize(Model.Properties)</script>
    <script src="~/res/js/global-properties.js"></script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>按分类和关键词查阅本端全局配置的含义、默认值、可选值及配置文件写法。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>筛选并查看详情</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="tbxSearch" title="搜索配置项">搜索配置项</strong>输入
                <code>Theme</code>。<br />结果：列表仅保留匹配项，结果数量随之更新。
            </li>
            <li>在<strong class="example-control-reference" data-example-control="ddlCategory" title="配置分类">配置分类</strong>选择一个分类或控件，再点击<strong
                    class="example-control-reference" data-example-control="Grid1" title="全局配置属性">全局配置属性</strong>中的属性名。<br />结果：分类与关键词组合过滤，详情展示该项的使用条件和本端代码。
            </li>
            <li>使用输入框的清除图标清除条件。<br />结果：恢复较完整的属性清单；查询操作本身不会更改网站配置。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>初始值取自 FineUI.Core 的空配置。点击配置名称或左侧加号可查看完整取值和使用条件。配置示例写在 <code>appsettings.json</code> 的 <code>FineUI</code> 节内。</p>
        <p>首次接入 FineUI 的服务注册、中间件和配置文件位置，见<a href="/Config/ModifyWebConfig">配置入门</a>。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EmptyText</code>（<strong class="example-control-reference" data-example-control="Grid1" title="全局配置属性">全局配置属性</strong>、<strong
                    class="example-control-reference" data-example-control="ddlCategory" title="配置分类">配置分类</strong>、<strong class="example-control-reference"
                    data-example-control="tbxSearch" title="搜索配置项">搜索配置项</strong>）：初始为
                <code>未找到匹配的配置项，可缩短关键词或清除筛选条件。</code>、<code>全部分类</code>、<code>名称、含义或可选值</code>，为空时显示输入提示；表格无记录时显示对应空结果文字。
            </li>
            <li><code>AutoSelectFirstItem</code>（<strong class="example-control-reference" data-example-control="ddlCategory" title="配置分类">配置分类</strong>）：初始为
                <code>false</code>，控制未显式选择时是否自动选中第一项。
            </li>
            <li><code>AutoShowClearIcon</code>（<strong class="example-control-reference" data-example-control="ddlCategory" title="配置分类">配置分类</strong>、<strong
                    class="example-control-reference" data-example-control="tbxSearch" title="搜索配置项">搜索配置项</strong>）：初始为 <code>true</code>，有值时显示清除图标，便于移除筛选条件。
            </li>
            <li><code>默认值与可选值</code>（<strong class="example-control-reference" data-example-control="Grid1"
                    title="全局配置属性">全局配置属性</strong>）：清单展示产品默认配置，区别于示例站当前覆盖后的设置。</li>
        </ul>
    </section>
}
