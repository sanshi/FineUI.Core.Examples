@page
@model FineUI.Core.Examples.Pages.Config.AjaxPropertiesModel
@{
    ViewBag.Title = "AJAX 属性";
    ViewBag.IsDarkerBG = true;
    ViewBag.SourceFiles = "~/content/config/ajax-properties/query.js";
}

@section head {
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        .ajax-property-detail {
            white-space: normal;
            overflow-wrap: anywhere;
        }

        .ajax-property-detail pre {
            white-space: pre-wrap;
        }
    </style>
}

@section body {
    <div id="ajaxPropertyCatalog" data-catalog-url="@Url.Content("~/content/config/ajax-properties/catalog.json")">
        <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowBorderShadow="true" ShowHeader="true" Title="AJAX 属性"
                DataIDField="id" DataTextField="property" AllowPaging="true" PageSize="100"
                EnableTextSelection="true" EnableMultiSelect="false"
                EmptyText="未找到匹配属性，可缩短关键词或调整筛选条件。">
            <Toolbars>
                <f:Toolbar ID="ToolbarFilters" Position="Top" Layout="HBox" BoxConfigSpace="10" BodyPadding="5">
                    <Items>
                        <f:DropDownList ID="ddlControlType" Label="控件类型" LabelAlign="LabelAlign.Top" BoxFlex="2"
                                EmptyText="全部控件" EnableEdit="true" AutoSelectFirstItem="false" AutoShowClearIcon="true">
                            <Listeners>
                                <f:Listener Event="change" Handler="onAjaxPropertyQueryChange" />
                            </Listeners>
                        </f:DropDownList>
                        <f:TriggerBox ID="tbxPropertySearch" Label="搜索属性" LabelAlign="LabelAlign.Top" BoxFlex="3"
                                EmptyText="属性名或中文含义" TriggerIcon="Clear" AutoShowClearIcon="true">
                            <Listeners>
                                <f:Listener Event="change" Handler="onAjaxPropertyQueryChange" />
                            </Listeners>
                        </f:TriggerBox>
                    </Items>
                </f:Toolbar>
                <f:Toolbar ID="ToolbarOptions" Position="Top">
                    <Items>
                        <f:CheckBox ID="cbxExcludeInherited" Text="排除继承属性" ShowLabel="false">
                            <Listeners>
                                <f:Listener Event="change" Handler="onAjaxPropertyQueryChange" />
                            </Listeners>
                        </f:CheckBox>
                        <f:ToolbarFill />
                        <f:Label ID="labResultCount" Text="正在读取属性清单…" ShowLabel="false" />
                        <f:Button ID="btnRetryCatalog" Text="重新读取" Hidden="true"
                                ClickHandler="onAjaxPropertyQueryRetry" />
                    </Items>
                </f:Toolbar>
            </Toolbars>
            <Columns>
                <f:RenderField DataField="id" RenderAsRowExpander="true"
                        ExpandOnDblClick="false" RendererFunction="AjaxPropertyQuery.renderDetail" />
                <f:RenderField ColumnID="control" HeaderText="控件" DataField="control" Width="150" />
                <f:RenderField ColumnID="property" HeaderText="属性" DataField="property" Width="220" />
                <f:RenderField ColumnID="description" HeaderText="含义" DataField="description"
                        ExpandUnusedSpace="true" MinWidth="220" />
                <f:RenderField ColumnID="effect" HeaderText="生效时机" DataField="effectText" Width="120" />
            </Columns>
            <Listeners>
                <f:Listener Event="rowclick" Handler="onAjaxPropertyQueryRowClick" />
                <f:Listener Event="rowexpanderexpand" Handler="onAjaxPropertyQueryExpand" />
                <f:Listener Event="rowexpandercollapse" Handler="onAjaxPropertyQueryCollapse" />
            </Listeners>
        </f:Grid>
    </div>


}

@section script {
    <script src="~/content/config/ajax-properties/query.js"></script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>按控件类型和关键词查询本端支持后台更新的属性，并查看生效时机、条件及代码写法。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>筛选并查看详情</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="tbxPropertySearch" title="搜索属性">搜索属性</strong>输入 <code>Required</code>。<br />结果：列表仅保留匹配项，结果数量随之更新。</li>
        <li>在<strong class="example-control-reference" data-example-control="ddlControlType" title="控件类型">控件类型</strong>选择一个分类或控件，再点击<strong class="example-control-reference" data-example-control="Grid1" title="AJAX 属性">AJAX 属性</strong>中的属性名。<br />结果：分类与关键词组合过滤，详情展示该项的使用条件和本端代码。</li>
        <li>切换<strong class="example-control-reference" data-example-control="cbxExcludeInherited" title="排除继承属性">排除继承属性</strong>。<br />结果：列表按是否包含继承属性重新筛选，不改变真实控件配置。</li>
        <li>使用输入框的清除图标清除条件。<br />结果：恢复较完整的属性清单；查询操作本身不会更改网站配置。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <p><strong>什么是 AJAX 属性？</strong>在 Core RazorForms 中，可以在后台回发事件里修改这类属性，响应返回后会更新页面上已有的控件。例如设置 Button.Text 可以修改按钮文字，无需刷新整个页面。</p>
    <p>不同属性的生效时机有所区别：按钮文字在本次响应后更新，按钮确认文字在下一次点击时使用，必填规则在后续校验时使用。默认包含继承属性，勾选“排除继承属性”可只看当前类型自身声明的属性；点击表格行或左侧加号，查看使用条件、声明来源和后台赋值方式。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EmptyText</code>（<strong class="example-control-reference" data-example-control="Grid1" title="AJAX 属性">AJAX 属性</strong>、<strong class="example-control-reference" data-example-control="ddlControlType" title="控件类型">控件类型</strong>、<strong class="example-control-reference" data-example-control="tbxPropertySearch" title="搜索属性">搜索属性</strong>）：初始为 <code>未找到匹配属性，可缩短关键词或调整筛选条件。</code>、<code>全部控件</code>、<code>属性名或中文含义</code>，为空时显示输入提示；表格无记录时显示对应空结果文字。</li>
        <li><code>AutoSelectFirstItem</code>（<strong class="example-control-reference" data-example-control="ddlControlType" title="控件类型">控件类型</strong>）：初始为 <code>false</code>，控制未显式选择时是否自动选中第一项。</li>
        <li><code>AutoShowClearIcon</code>（<strong class="example-control-reference" data-example-control="ddlControlType" title="控件类型">控件类型</strong>、<strong class="example-control-reference" data-example-control="tbxPropertySearch" title="搜索属性">搜索属性</strong>）：初始为 <code>true</code>，有值时显示清除图标，便于移除筛选条件。</li>
        <li><code>ajaxProperty</code>（<strong class="example-control-reference" data-example-control="Grid1" title="AJAX 属性">AJAX 属性</strong>）：详情区区分本次响应更新与下次请求生效等条件，不能仅凭属性名称判断后台更新能力。</li>
    </ul>
</section>
}
