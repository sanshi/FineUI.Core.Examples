@page
@model FineUI.Core.Examples.Pages.Editor.TinyMCEConfigModel
@{
    ViewBag.Title = "Editor/TinyMCEConfig";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" LabelAlign="Top" EnableCollapse="false" Title="表单">
        <Items>
            <f:HtmlEditor Label="文本编辑器" ID="HtmlEditor1" Editor="TinyMCE" BasePath="@Url.Content("~/res/third-party/tinymce/")" ToolbarSet="Full" Height="350"
                Text="<p>FineUI.Core<br>.NET 企业级全栈 UI 框架<br><br>支持的浏览器<br>Chrome、Firefox、Safari、Edge<br><br>相关链接<br>首页：http://fineui.com/<br>示例：https://fineui.com/core/demo-mvc/</p>">
                <Options>
                    <f:OptionItem Key="menubar" JsonValue="@Model.MenubarOption" />
                    <f:OptionItem Key="plugins" JsonValue="@Model.PluginsOption" />
                    <f:OptionItem Key="toolbar1"
                        Value="bold italic underline strikethrough | numlist bullist | alignleft aligncenter alignright | link unlink | code"
                        PersistOriginal="false" />
                </Options>
            </f:HtmlEditor>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Button ID="Button2" CssClass="marginr" Text="设置编辑器的值" OnClick="Button2_Click"></f:Button>
    <f:Button ID="Button1" Text="获取编辑器的值" OnClick="Button1_Click"></f:Button>

    <br>
    <br>
    注：本示例通过 Options 属性设置 TinyMCE 的菜单栏（无）和工具栏（自定义）。参考文档：http://www.tinymce.com/wiki.php/Configuration


}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>通过 Options 覆盖 TinyMCE 的默认配置，重点对照自定义工具栏或菜单。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>对照自定义配置</h3>
        <ul>
            <li>查看<strong class="example-control-reference" data-example-control="HtmlEditor1" title="文本编辑器">文本编辑器</strong>的顶部工具栏与菜单区域。<br />结果：菜单栏隐藏，工具栏采用本页配置。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Options</code>（<strong class="example-control-reference" data-example-control="HtmlEditor1" title="文本编辑器">文本编辑器</strong>）：把本页提供的配置对象传给
                TinyMCE；具体键名使用该编辑器自己的 API。</li>
        </ul>
    </section>
}
