@page
@model FineUI.Core.Examples.Pages.Editor.UEditorWindowModel
@{
    ViewBag.Title = "Editor/UEditorWindow";
    var F = Html.F();
}


@section body {

    <f:Window ID="Window1" Width="900" Height="500" Layout="Fit" BodyPadding="10" EnableCollapse="false" Title="简单表单" IsModal="false" EnableResize="true">
        <Items>
            <f:SimpleForm ID="SimpleForm1" Layout="Fit" LabelAlign="Top" ShowBorder="false" ShowHeader="false">
                <Items>
                    <f:HtmlEditor Label="文本编辑器" ID="HtmlEditor1"
                                  Editor="UEditor" BasePath="@Url.Content("~/res/third-party/ueditor/")" ToolbarSet="Full" Text="<p>FineUI.Core<br>.NET 企业级全栈 UI 框架<br><br>支持的浏览器<br>Chrome、Firefox、Safari、Edge<br><br>相关链接<br>首页：http://fineui.com/<br>示例：https://fineui.com/core/demo-mvc/</p>">
                        <Options>
                            <f:OptionItem Key="zIndex" Value="99999" />
                        </Options>
                    </f:HtmlEditor>
                </Items>
            </f:SimpleForm>
        </Items>
        <Toolbars>
            <f:Toolbar Position="Bottom" ToolbarAlign="Right">
                <Items>
                    <f:Button ID="Button2" CssClass="marginr" Text="设置编辑器的值" OnClick="Button2_Click"></f:Button>
                    <f:Button ID="Button1" Text="获取编辑器的值" OnClick="Button1_Click"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Window>
    <br>
    注：本示例不支持文件上传，请根据UEditor官网文档自行配置。



}


@section exampleDescription {
<section aria-label="页面描述">
    <p>让 UEditor 填充可调整大小的窗体，重点查看编辑区随容器变化。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>调整窗体中的编辑区</h3>
    <ul>
        <li>拖动<strong class="example-control-reference" data-example-control="Window1" title="简单表单">简单表单</strong>的边缘，分别放大和缩小。<br />结果：<strong class="example-control-reference" data-example-control="HtmlEditor1" title="文本编辑器">文本编辑器</strong>跟随窗体内容区域重新计算大小，工具栏和编辑内容保留。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="Window1" title="简单表单">简单表单</strong>、<strong class="example-control-reference" data-example-control="SimpleForm1" title="表单">表单</strong>）：初始为 <code>Fit</code>，规定容器内子控件的排列和空间分配方式。</li>
        <li><code>EnableResize</code>（<strong class="example-control-reference" data-example-control="Window1" title="简单表单">简单表单</strong>）：初始为 <code>true</code>，控制是否允许拖动窗体边缘调整大小。</li>
    </ul>
</section>
}
