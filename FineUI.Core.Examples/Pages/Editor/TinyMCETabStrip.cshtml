@page
@model FineUI.Core.Examples.Pages.Editor.TinyMCETabStripModel
@{
    ViewBag.Title = "Editor/TinyMCETabStrip";
    var F = Html.F();
}


@section body {

    <f:TabStrip ID="TabStrip1" IsFluid="true" Height="500" ShowBorder="true" TabPosition="Top" EnableTabCloseMenu="false" ActiveTabIndex="0">
        <Tabs>
            <f:Tab ID="Tab1" Title="选项卡一" BodyPadding="10" Layout="Anchor">
                <Items>
                    <f:HtmlEditor Label="编辑器一" ID="HtmlEditor1"
                                  Editor="TinyMCE" BasePath="@Url.Content("~/res/third-party/tinymce/")" ToolbarSet="Full" Height="300" Text="<p>FineUI.Core<br>.NET 企业级全栈 UI 框架<br><br>支持的浏览器<br>Chrome、Firefox、Safari、Edge<br><br>相关链接<br>首页：http://fineui.com/<br>示例：https://fineui.com/core/demo-mvc/</p>">
                    </f:HtmlEditor>
                </Items>
            </f:Tab>
            <f:Tab ID="Tab2" Title="选项卡二" BodyPadding="10" Layout="Fit">
                <Items>
                    <f:HtmlEditor Label="编辑器二" ID="HtmlEditor2"
                                  Editor="TinyMCE" BasePath="@Url.Content("~/res/third-party/tinymce/")" ToolbarSet="Basic" Text="<p>这是编辑器二的值</p>">
                    </f:HtmlEditor>
                </Items>
            </f:Tab>
        </Tabs>
        <Toolbars>
            <f:Toolbar Position="Bottom">
                <Items>
                    <f:Button Text="获取编辑器的值" ID="Button1" OnClick="Button1_Click"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:TabStrip>


}


@section exampleDescription {
<section aria-label="页面描述">
    <p>把两个 TinyMCE 放在不同选项卡，验证切换、布局和内容相互独立。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>切换后保持各自内容</h3>
    <ol>
        <li>切换到<strong class="example-control-reference" data-example-control="Tab2" title="选项卡二">选项卡二</strong>，在<strong class="example-control-reference" data-example-control="HtmlEditor2" title="编辑器二">编辑器二</strong>追加 <code>第二页内容</code>。<br />结果：<strong class="example-control-reference" data-example-control="HtmlEditor2" title="编辑器二">编辑器二</strong>显示并接受输入；填充布局使用当前标签的可用区域。</li>
        <li>切回选项卡一，再切到<strong class="example-control-reference" data-example-control="Tab2" title="选项卡二">选项卡二</strong>。<br />结果：两个编辑器分别保留自己的内容，切换不重新清空。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="Tab1" title="选项卡一">选项卡一</strong>、<strong class="example-control-reference" data-example-control="Tab2" title="选项卡二">选项卡二</strong>）：初始为 <code>Anchor</code>、<code>Fit</code>，规定容器内子控件的排列和空间分配方式。</li>
        <li><code>ToolbarSet</code>（<strong class="example-control-reference" data-example-control="HtmlEditor1" title="编辑器一">编辑器一</strong>、<strong class="example-control-reference" data-example-control="HtmlEditor2" title="编辑器二">编辑器二</strong>）：初始为 <code>Full</code>、<code>Basic</code>，选择编辑器的工具栏组合。</li>
    </ul>
</section>
}
