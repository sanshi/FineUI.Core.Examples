@page
@model FineUI.Core.Examples.Pages.Editor.CKEditorConfigModel
@{
    ViewBag.Title = "Editor/CKEditorConfig";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" LabelAlign="Top" EnableCollapse="false" Title="表单">
        <Items>
            <f:HtmlEditor Label="文本编辑器" ID="HtmlEditor1"
                          Editor="CKEditor" BasePath="@Url.Content("~/res/third-party/ckeditor/")" ToolbarSet="Full" Height="350" Text="<p>FineUI.Core<br>.NET 企业级全栈 UI 框架<br><br>支持的浏览器<br>Chrome、Firefox、Safari、Edge<br><br>相关链接<br>首页：http://fineui.com/<br>示例：https://fineui.com/core/demo-mvc/</p>">
                <Options>
                    <f:OptionItem Key="uiColor" Value="#aed0ea" />
                    <f:OptionItem Key="language" Value="zh" />
                    <f:OptionItem Key="toolbar"
                                  Value="[['Bold','Italic','Underline','Strike'],['NumberedList','BulletedList'],['JustifyLeft','JustifyCenter','JustifyRight'],['Link','Unlink'],['Source']]"
                                  PersistOriginal="true" />
                </Options>
            </f:HtmlEditor>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Button ID="Button2" CssClass="marginr" Text="设置编辑器的值" OnClick="Button2_Click"></f:Button>
    <f:Button ID="Button1" Text="获取编辑器的值" OnClick="Button1_Click"></f:Button>

    <br>
    <br>
    注：本示例通过 Options 属性设置 CKEditor 的背景色（浅蓝色），语言（繁体中文）和工具栏（自定义）。参考文档：http://docs.ckeditor.com/#!/guide/dev_configuration


}

