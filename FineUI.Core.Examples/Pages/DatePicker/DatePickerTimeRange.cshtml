@page
@model FineUI.Core.Examples.Pages.DatePicker.DatePickerTimeRangeModel
@{
    ViewBag.Title = "DatePicker/DatePickerTimeRange";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" Title="简单表单">
        <Items>
            <f:DatePicker ID="DatePicker1" Required="true" DateFormatString="HH:mm:ss" Label="时间范围" EmptyText="请选择时间范围" ShowRedStar="true"
                DisplayType="TimeRange">
            </f:DatePicker>
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false" ShowLabel="false">
    </f:Label>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示通过输入框弹出的面板只选择<strong class="example-control-reference" data-example-control="DatePicker1" title="时间范围">时间范围</strong>，无需选择日期。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>选择时间范围</h3>
        <ol>
            <li>
                点击<strong class="example-control-reference" data-example-control="DatePicker1" title="时间范围">时间范围</strong>字段右侧的下拉图标。<br />
                结果：显示本页<strong class="example-control-reference" data-example-control="DatePicker1" title="时间范围">时间范围</strong>面板，可同时调整时、分；输入框当前值仍可对照查看。
            </li>
            <li>
                依次将起点和终点选择为<code>09</code>时<code>30</code>分到<code>10</code>时<code>30</code>分。<br />
                结果：所选值回填输入框，范围显示起止两个值。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DateFormatString</code>（<strong class="example-control-reference" data-example-control="DatePicker1"
                    title="时间范围">时间范围</strong>）：初始为<code>HH:mm:ss</code>，控制选中值的文字格式。</li>
            <li><code>DisplayType</code>（<strong class="example-control-reference" data-example-control="DatePicker1" title="时间范围">时间范围</strong>）：本页采用<strong
                    class="example-control-reference" data-example-control="DatePicker1" title="时间范围">时间范围</strong>面板，选择起点和终点。</li>
        </ul>
    </section>
}
