@page
@model FineUI.Core.Examples.Pages.DatePicker.DatePickerDisplayTimeConfirmButtonModel
@{
    ViewBag.Title = "DatePicker/DatePickerDisplayTimeConfirmButton";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" Title="简单表单">
        <Items>
            <f:DatePicker Required="true" DateFormatString="HH:mm:ss" Label="开始时间" EmptyText="请选择开始时间"
                          ID="DatePicker1" ShowRedStar="true" DisplayType="Time" ShowTodayButton="false" SelectedDate="DateTime.Now" ShowConfirmButton="true" ConfirmToSelect="true">
            </f:DatePicker>
            <f:DatePicker ID="DatePicker2" Required="true" Readonly="false" CompareControl="DatePicker1" DateFormatString="HH:mm:ss"
                          CompareOperator="GreaterThan" CompareMessage="结束时间应该大于开始时间" Label="结束时间"
                          ShowRedStar="true" DisplayType="Time" ShowTodayButton="false" ShowConfirmButton="true" ConfirmToSelect="true">
            </f:DatePicker>
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false" ShowLabel="false">
    </f:Label>


}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示时间先暂存选择，点击“确定”后才提交当前值。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>选择时间</h3>
        <ol>
            <li>
                点击“开始时间”字段右侧的下拉图标。<br />
                结果：显示本页时间面板，可同时调整时、分；输入框当前值仍可对照查看。
            </li>
            <li>
                在面板中选择09时30分。<br />
                结果：选择暂存在面板中；还没有执行选中事件，输入框或下方结果保持原值。
            </li>
            <li>
                点击面板中的“确定”。<br />
                结果：提交临时选择，回填输入框并收起弹层。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ShowConfirmButton</code>：显示面板中的“确定”按钮；是否延后提交选择由 ConfirmToSelect 控制。</li>
            <li><code>ConfirmToSelect</code>：将当前选择暂存在面板中，点击“确定”后才提交当前值并触发选中事件。</li>
        </ul>
    </section>
}
