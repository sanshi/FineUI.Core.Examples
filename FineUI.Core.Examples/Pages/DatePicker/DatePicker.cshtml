@page
@model FineUI.Core.Examples.Pages.DatePicker.DatePickerModel
@{
    ViewBag.Title = "DatePicker/DatePicker";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" Title="简单表单">
        <Items>
            <f:DatePicker ID="DatePicker1" Required="true" DateFormatString="yyyy/MM/dd" Label="开始日期" EmptyText="请选择开始日期" ShowRedStar="true" SelectedDate="DateTime.Now.AddDays(2)">
            </f:DatePicker>
            <f:DatePicker ID="DatePicker2" Label="结束日期" Required="true" Readonly="false" CompareControl="DatePicker1" DateFormatString="yyyy/MM/dd" CompareOperator="GreaterThan" CompareMessage="结束日期应该大于开始日期" ShowRedStar="true">
            </f:DatePicker>
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false" ShowLabel="false">
    </f:Label>

}

