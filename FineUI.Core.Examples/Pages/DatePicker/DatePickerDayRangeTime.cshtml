@page
@model FineUI.Core.Examples.Pages.DatePicker.DatePickerDayRangeTimeModel
@{
    ViewBag.Title = "DatePicker/DatePickerDayRangeTime";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" Title="简单表单">
        <Items>
            <f:DatePicker ID="DatePicker1" Required="true" DateFormatString="yyyy-MM-dd HH:mm:ss"
                          Label="日期范围" EmptyText="请选择日期范围" ShowRedStar="true" DisplayType="DayRange" ShowTime="true">
            </f:DatePicker>
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false" ShowLabel="false">
    </f:Label>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示通过输入框弹出的面板选择日期时间范围。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>选择日期时间范围</h3>
        <ol>
            <li>
                点击<strong class="example-control-reference" data-example-control="DatePicker1" title="日期范围">日期范围</strong>字段右侧的下拉图标。<br />
                结果：显示本页日期时间范围面板，可同时调整时、分；输入框当前值仍可对照查看。
            </li>
            <li>
                依次将起点和终点选择为今天之后第<code>5</code>天<code>09</code>时<code>30</code>分到第<code>10</code>天<code>10</code>时<code>30</code>分。<br />
                结果：所选值回填输入框，范围显示起止两个值。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DateFormatString</code>（<strong class="example-control-reference" data-example-control="DatePicker1" title="日期范围">日期范围</strong>）：设为<code>yyyy-MM-dd HH:mm:ss</code>，控制选中值的文字格式。</li>
            <li><code>ShowTime</code>（<strong class="example-control-reference" data-example-control="DatePicker1" title="日期范围">日期范围</strong>）：设为 <code>true</code>，在日期选择中同时提供时间列。</li>
        </ul>
    </section>
}
