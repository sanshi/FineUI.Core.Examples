@page
@model FineUI.Core.Examples.Pages.DatePicker.DatePickerYearRangeConfirmButtonModel
@{
    ViewBag.Title = "DatePicker/DatePickerYearRangeConfirmButton";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" Title="简单表单">
        <Items>
            <f:DatePicker ID="DatePicker1" Required="true" DateFormatString="yyyy"
                          Label="年份范围" EmptyText="请选择年份范围" ShowRedStar="true" DisplayType="YearRange" ShowConfirmButton="true" ConfirmToSelect="true">
            </f:DatePicker>
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false" ShowLabel="false">
    </f:Label>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示年份范围先暂存选择，点击“确定”后才提交当前值。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>选择年份范围</h3>
        <ol>
            <li>
                点击“年份范围”字段右侧的下拉图标。<br />
                结果：显示本页年份范围面板；输入框当前值仍可对照查看。
            </li>
            <li>
                依次将起点和终点选择为今年之后第1年到第2年。<br />
                结果：选择暂存在面板中；还没有执行选中事件，输入框或下方结果保持原值。
            </li>
            <li>
                点击面板中的“确定”。<br />
                结果：提交临时选择，回填输入框并收起弹层。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ShowConfirmButton</code>：显示面板中的“确定”按钮；是否延后提交选择由 ConfirmToSelect 控制。</li>
            <li><code>ConfirmToSelect</code>：将当前选择暂存在面板中，点击“确定”后才提交当前值并触发选中事件。</li>
        </ul>
    </section>
}
