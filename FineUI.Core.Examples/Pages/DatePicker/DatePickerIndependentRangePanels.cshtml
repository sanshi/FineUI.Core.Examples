@page
@model FineUI.Core.Examples.Pages.DatePicker.DatePickerIndependentRangePanelsModel
@{
    ViewBag.Title = "DatePicker/DatePickerIndependentRangePanels";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" Title="简单表单">
        <Items>
            <f:DatePicker ID="DatePicker1" Required="true" DateFormatString="yyyy/MM/dd"
                          Label="日期范围" EmptyText="请选择日期范围" ShowRedStar="true"
                          DisplayType="DayRange" IndependentRangePanels="true">
            </f:DatePicker>
            <f:DatePicker ID="DatePicker2" Required="true" DateFormatString="yyyy/MM"
                          Label="月份范围" EmptyText="请选择月份范围" ShowRedStar="true"
                          DisplayType="MonthRange" IndependentRangePanels="true">
            </f:DatePicker>
            <f:DatePicker ID="DatePicker3" Required="true" DateFormatString="yyyy"
                          Label="年份范围" EmptyText="请选择年份范围" ShowRedStar="true"
                          DisplayType="YearRange" IndependentRangePanels="true">
            </f:DatePicker>
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false" ShowLabel="false">
    </f:Label>
    <br />
    <div style="margin-top:15px;color:#666;line-height:1.8;">
        说明：设置 IndependentRangePanels=true 开启“范围面板独立切换”。范围选择时左右两个面板可各自独立切换年份/月份，互不联动，便于快速定位跨度较大的起止日期区间。
    </div>

}
