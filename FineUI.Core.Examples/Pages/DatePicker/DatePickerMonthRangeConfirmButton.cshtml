@page
@model FineUI.Core.Examples.Pages.DatePicker.DatePickerMonthRangeConfirmButtonModel
@{
    ViewBag.Title = "DatePicker/DatePickerMonthRangeConfirmButton";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" Title="简单表单">
        <Items>
            <f:DatePicker ID="DatePicker1" Required="true" DateFormatString="yyyy/MM"
                          Label="月份范围" EmptyText="请选择月份范围" ShowRedStar="true" DisplayType="MonthRange" ShowConfirmButton="true" ConfirmToSelect="true">
            </f:DatePicker>
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false" ShowLabel="false">
    </f:Label>

}

