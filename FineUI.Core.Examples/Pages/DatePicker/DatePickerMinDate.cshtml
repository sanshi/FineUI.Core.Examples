@page
@model FineUI.Core.Examples.Pages.DatePicker.DatePickerMinDateModel
@{
    ViewBag.Title = "DatePicker/DatePickerMinDate";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" Title="简单表单">
        <Items>
            <f:DatePicker ID="DatePicker1" Required="true" Label="日期" EmptyText="限制范围的日期" ShowRedStar="true"
                          MinDate="DateTime.Now" MaxDate="DateTime.Now.AddDays(10)">
            </f:DatePicker>
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false" ShowLabel="false">
    </f:Label>

}

