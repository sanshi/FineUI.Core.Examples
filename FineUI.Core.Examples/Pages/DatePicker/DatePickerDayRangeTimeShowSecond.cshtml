@page
@model FineUI.Core.Examples.Pages.DatePicker.DatePickerDayRangeTimeShowSecondModel
@{
    ViewBag.Title = "DatePicker/DatePickerDayRangeTimeShowSecond";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" Title="简单表单">
        <Items>
            <f:DatePicker ID="DatePicker1" Required="true" DateFormatString="yyyy-MM-dd HH:mm"
                          Label="日期范围" EmptyText="请选择日期范围" ShowRedStar="true" DisplayType="DayRange" ShowTime="true" ShowSecond="false">
            </f:DatePicker>
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false" ShowLabel="false">
    </f:Label>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示选择日期时间范围时隐藏秒列，只显示和读取到分钟。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-time" aria-hidden="true"></i>只选择小时和分钟</h3>
        <ol>
            <li>
                展开日期选择面板，查看并选择小时和分钟。<br />
                结果：时间区域不显示秒列，所选日期时间的显示文字也不包含秒。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DateFormatString</code>（<strong class="example-control-reference" data-example-control="DatePicker1" title="日期范围">日期范围</strong>）：初始为<code>yyyy-MM-dd HH:mm</code>，控制选中值的文字格式。</li>
            <li><code>ShowSecond</code>（<strong class="example-control-reference" data-example-control="DatePicker1" title="日期范围">日期范围</strong>）：初始为 <code>false</code>，时间面板只显示小时和分钟，不创建秒列；输出格式也不含秒。</li>
        </ul>
    </section>
}
