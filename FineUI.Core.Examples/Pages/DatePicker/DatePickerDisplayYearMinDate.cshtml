@page
@model FineUI.Core.Examples.Pages.DatePicker.DatePickerDisplayYearMinDateModel
@{
    ViewBag.Title = "DatePicker/DatePickerDisplayYearMinDate";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" Title="简单表单">
        <Items>
            <f:DatePicker Required="true" DateFormatString="yyyy" Label="开始年份" EmptyText="请选择开始年份"
                          ID="DatePicker1" ShowRedStar="true" DisplayType="Year" ShowTodayButton="false">
            </f:DatePicker>
            <f:DatePicker ID="DatePicker2" Required="true" Readonly="false" CompareControl="DatePicker1" DateFormatString="yyyy"
                          CompareOperator="GreaterThan" CompareMessage="结束年份应该大于开始年份" Label="结束年份"
                          ShowRedStar="true" DisplayType="Year" ShowTodayButton="false">
            </f:DatePicker>
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false" ShowLabel="false">
    </f:Label>


}

