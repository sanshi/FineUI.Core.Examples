@page
@model FineUI.Core.Examples.Pages.DatePicker.TimePickerClearIconModel
@{
    ViewBag.Title = "DatePicker/TimePickerClearIcon";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" Title="简单表单">
        <Items>
            <f:DatePicker ID="DatePicker1" Required="true" EnableEdit="false" Label="日期" EmptyText="请选择日期" ShowRedStar="true" AutoShowClearIcon="true" SelectedDate="DateTime.Now">
            </f:DatePicker>
            <f:TimePicker ID="TimePicker1" ShowRedStar="true" EnableEdit="false" Label="时间" Increment="30" MinTimeText="8:30" MaxTimeText="20:30"
                          Required="true" EmptyText="请选择时间" AutoShowClearIcon="true" Text="09:30">
            </f:TimePicker>
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false" ShowLabel="false">
    </f:Label>
    <br />
    <br />
    注：本示例通过EnableEdit属性控制日期和时间选择器不可编辑。


}

