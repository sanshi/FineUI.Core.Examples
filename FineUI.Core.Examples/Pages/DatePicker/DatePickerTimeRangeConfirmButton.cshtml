@page
@model FineUI.Core.Examples.Pages.DatePicker.DatePickerTimeRangeConfirmButtonModel
@{
    ViewBag.Title = "DatePicker/DatePickerTimeRangeConfirmButton";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" Title="简单表单">
        <Items>
            <f:DatePicker ID="DatePicker1" Required="true" DateFormatString="HH:mm:ss" Label="时间范围" EmptyText="请选择时间范围" ShowRedStar="true"
                DisplayType="TimeRange" ShowConfirmButton="true" ConfirmToSelect="true">
            </f:DatePicker>
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false" ShowLabel="false">
    </f:Label>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示<strong class="example-control-reference" data-example-control="DatePicker1" title="时间范围">时间范围</strong>先暂存选择，点击<strong>确定</strong>后才提交当前值。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>选择时间范围</h3>
        <ol>
            <li>
                点击<strong class="example-control-reference" data-example-control="DatePicker1" title="时间范围">时间范围</strong>字段右侧的下拉图标。<br />
                结果：显示本页<strong class="example-control-reference" data-example-control="DatePicker1" title="时间范围">时间范围</strong>面板，可同时调整时、分；输入框当前值仍可对照查看。
            </li>
            <li>
                依次将起点和终点选择为<code>09</code>时<code>30</code>分到<code>10</code>时<code>30</code>分。<br />
                结果：选择暂存在面板中；还没有执行选中事件，输入框或下方结果保持原值。
            </li>
            <li>
                点击面板中的<strong>确定</strong>。<br />
                结果：提交临时选择，回填输入框并收起弹层。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ShowConfirmButton</code>（<strong class="example-control-reference" data-example-control="DatePicker1"
                    title="时间范围">时间范围</strong>）：显示面板中的<strong>确定</strong>按钮；是否延后提交选择由 <code>ConfirmToSelect</code> 控制。</li>
            <li><code>ConfirmToSelect</code>（<strong class="example-control-reference" data-example-control="DatePicker1"
                    title="时间范围">时间范围</strong>）：将当前选择暂存在面板中，点击<strong>确定</strong>后才提交当前值并触发选中事件。</li>
        </ul>
    </section>
}
