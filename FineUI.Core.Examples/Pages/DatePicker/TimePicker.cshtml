@page
@model FineUI.Core.Examples.Pages.DatePicker.TimePickerModel
@{
    ViewBag.Title = "DatePicker/TimePicker";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" Title="简单表单">
        <Items>
            <f:DatePicker ID="DatePicker1" Required="true" EnableEdit="false" Label="日期" EmptyText="请选择日期" ShowRedStar="true">
            </f:DatePicker>
            <f:TimePicker ID="TimePicker1" ShowRedStar="true" EnableEdit="false" Label="时间" Increment="30" MinTimeText="8:30" MaxTimeText="20:30"
                          Required="true" EmptyText="请选择时间">
            </f:TimePicker>
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Button ID="btnToggleClickAction" Text="切换输入区点击弹出" OnClick="btnToggleClickAction_Click"></f:Button>
    <f:Label ID="labClickAction" Text="输入区点击弹出：开启" ShowLabel="false"></f:Label>
    <br />
    <f:Label ID="labResult" EncodeText="false" ShowLabel="false">
    </f:Label>
    <br />
    <br />
    注：可在后台切换是否点击输入区打开面板；关闭后仍可点击右侧按钮，当前选中值保持不变。<br />
    注：本示例通过EnableEdit属性控制日期和时间选择器不可编辑。

}

