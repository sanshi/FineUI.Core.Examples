@page
@model FineUI.Core.Examples.Pages.DatePicker.DatePickerTimeModel
@{
    ViewBag.Title = "DatePicker/DatePickerTime";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" Title="简单表单">
        <Items>
            <f:DatePicker ID="DatePicker1" Required="true" DateFormatString="yyyy-MM-dd HH:mm:ss" Label="开始日期" EmptyText="请选择开始日期"
                          ShowRedStar="true" ShowTime="true" SelectedDate="DateTime.Now.AddDays(2)">
            </f:DatePicker>
            <f:DatePicker ID="DatePicker2" Required="true" Readonly="false" CompareControl="DatePicker1" DateFormatString="yyyy-MM-dd HH:mm:ss" ShowRedStar="true"
                          CompareOperator="GreaterThan" CompareMessage="结束日期应该大于开始日期" Label="结束日期" ShowTime="true">
            </f:DatePicker>
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false" ShowLabel="false">
    </f:Label>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示通过输入框弹出的面板选择日期时间。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>选择日期时间</h3>
        <ol>
            <li>
                点击<strong class="example-control-reference" data-example-control="DatePicker1" title="开始日期">开始日期</strong>字段右侧的下拉图标。<br />
                结果：显示本页日期时间面板，可同时调整时、分；输入框当前值仍可对照查看。
            </li>
            <li>
                在面板中选择今天之后第<code>5</code>天<code>09</code>时<code>30</code>分。<br />
                结果：所选值回填输入框。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DateFormatString</code>（<strong class="example-control-reference" data-example-control="DatePicker1" title="开始日期">开始日期</strong>、<strong class="example-control-reference" data-example-control="DatePicker2" title="结束日期">结束日期</strong>）：初始为<code>yyyy-MM-dd HH:mm:ss</code>，控制选中值的文字格式。</li>
            <li><code>ShowTime</code>（<strong class="example-control-reference" data-example-control="DatePicker1" title="开始日期">开始日期</strong>、<strong class="example-control-reference" data-example-control="DatePicker2" title="结束日期">结束日期</strong>）：初始为 <code>true</code>，在日期选择中同时提供时间列。</li>
        </ul>
    </section>
}
