@page
@model FineUI.Core.Examples.Pages.DatePicker.DatePickerDisplayMonthModel
@{
    ViewBag.Title = "DatePicker/DatePickerDisplayMonth";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" Title="简单表单">
        <Items>
            <f:DatePicker Required="true" DateFormatString="yyyy/MM" Label="开始年月" EmptyText="请选择开始年月"
                          ID="DatePicker1" ShowRedStar="true" DisplayType="Month" ShowTodayButton="false" SelectedDate="DateTime.Now">
            </f:DatePicker>
            <f:DatePicker ID="DatePicker2" Required="true" Readonly="false" CompareControl="DatePicker1" DateFormatString="yyyy/MM"
                          CompareOperator="GreaterThan" CompareMessage="结束年月应该大于开始年月" Label="结束年月"
                          ShowRedStar="true" DisplayType="Month" ShowTodayButton="false">
            </f:DatePicker>
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false" ShowLabel="false">
    </f:Label>

}

