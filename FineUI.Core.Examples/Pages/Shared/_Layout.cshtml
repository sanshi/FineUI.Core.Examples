@{
    var F = Html.F();

    bool isDarkerBG = (ViewBag.IsDarkerBG != null ? (bool)ViewBag.IsDarkerBG : false);
}



<!DOCTYPE html>
<html>
<head>
    <title>@Html.Raw(ViewBag.Title)</title>
    @if (ViewBag.SourceFiles != null)
    {
        <meta name="sourcefiles" content="@ViewBag.SourceFiles" />
    }

    @F.RenderCss()

    <link rel="stylesheet" type="text/css" href="~/res/css/common.css?v@(GlobalConfig.ProductVersion)" />
    <link rel="stylesheet" href="~/res/css/source-code-viewer.css?v@(GlobalConfig.ProductVersion)" />


    @if (Context.Request.Path.StartsWithSegments("/Home/Source"))
    {
        <meta name="fineui-source-code-viewer" content="source" />
    }
    else if (Context.Request.Path.StartsWithSegments("/Home/SourceFile"))
    {
        <meta name="fineui-source-code-viewer" content="file" />
    }
    else if (!Context.Request.Path.StartsWithSegments("/Home/Download"))
    {
        <meta name="fineui-example-source" content="@Url.Content("~/Home/Source")" />
    }

    @RenderSection("head", false)
</head>
<body class="@(isDarkerBG ? "f-body-darkerbg" : "")">
    @Html.AntiForgeryToken()

    @F.PageManager

    @RenderSection("body", true)

    <template id="example-description">
        @RenderSection("exampleDescription", false)
    </template>

    @F.RenderScript()

    <script type="text/javascript" src="~/res/js/common.js?v@(GlobalConfig.ProductVersion)"></script>

    @RenderSection("script", false)

    <script src="~/res/js/source-code-viewer.js?v@(GlobalConfig.ProductVersion)"></script>

</body>
</html>
