@page
@model FineUI.Core.Examples.Pages.Calendar.CalendarIndependentRangePanelsModel
@{
    ViewBag.Title = "Calendar/CalendarIndependentRangePanels";
    var F = Html.F();
}


@section body {

    <b>日期范围</b>
    <br />
    <f:Calendar ID="Calendar1" DateFormatString="yyyy-MM-dd"
                DisplayType="DayRange" IndependentRangePanels="true">
    </f:Calendar>
    <br />
    <br />
    <br />
    <b>月份范围</b>
    <br />
    <f:Calendar ID="Calendar2" DateFormatString="yyyy/MM"
                DisplayType="MonthRange" IndependentRangePanels="true">
    </f:Calendar>
    <br />
    <br />
    <br />
    <b>年份范围</b>
    <br />
    <f:Calendar ID="Calendar3" DateFormatString="yyyy"
                DisplayType="YearRange" IndependentRangePanels="true">
    </f:Calendar>
    <br />
    <f:Button ID="Button1" Text="获取选中的值" OnClick="Button1_Click"></f:Button>
    <br />
    <br />
    <f:Label ID="labResult" EncodeText="false" ShowLabel="false">
    </f:Label>



}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示日期、月份和年份三个范围选择器的左右面板独立切换，便于选择跨度较大的区间。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>分别切换左右面板</h3>
        <ol>
            <li>
                分别在本页的范围面板中切换左侧月份或年份，再单独切换右侧。<br />
                结果：只改变所操作面板的位置，另一侧不被强制带到相邻月份；可以定位跨度较大的区间。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <div> 说明：设置 <code>IndependentRangePanels</code>=<code>true</code> 开启“范围面板独立切换”。范围选择时左右两个面板可各自独立切换年份/月份，互不联动，便于快速定位跨度较大的起止日期区间。 </div>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>IndependentRangePanels</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="第 1 个日历">第 1 个日历</strong>、<strong class="example-control-reference" data-example-control="Calendar2" title="第 2 个日历">第 2 个日历</strong>、<strong class="example-control-reference" data-example-control="Calendar3" title="第 3 个日历">第 3 个日历</strong>）：设为 <code>true</code>，左右面板分别切换年月，另一侧不被强制切到相邻月份。</li>
        </ul>
    </section>
}
