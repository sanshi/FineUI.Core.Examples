@page
@model FineUI.Core.Examples.Pages.Calendar.CalendarYearRangeModel
@{
    ViewBag.Title = "Calendar/CalendarYearRange";
    var F = Html.F();
}


@section body {

    <f:Calendar ID="Calendar1" DisplayType="YearRange" OnDateSelect="Calendar1_DateSelect" >
    </f:Calendar>
    <br />
    <br />
    <f:Button ID="Button1" OnClick="Button1_Click"></f:Button>
    <br />
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示在页面内直接只选择年份范围。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>选择年份范围</h3>
        <ul>
            <li>
                依次将起点和终点选择为今年之后第<code>1</code>年到第<code>2</code>年。<br />
                结果：面板高亮当前选择，范围显示起止两个值。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DateFormatString</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：控制选中值的文字格式；本页使用 <code>yyyy</code>。</li>
            <li><code>DisplayType</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：本页采用年份范围面板，选择起点和终点。</li>
        </ul>
    </section>
}
