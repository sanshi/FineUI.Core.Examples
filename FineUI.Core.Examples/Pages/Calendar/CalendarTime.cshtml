@page
@model FineUI.Core.Examples.Pages.Calendar.CalendarTimeModel
@{
    ViewBag.Title = "Calendar/CalendarTime";
    var F = Html.F();
}


@section body {

    <f:Calendar ID="Calendar1" OnDateSelect="Calendar1_DateSelect" ShowTime="true">
    </f:Calendar>
    <br />
    <br />
    <f:Button ID="Button1" OnClick="Button1_Click"></f:Button>
    <br />
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示在页面内直接选择日期时间。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>选择日期时间</h3>
        <ul>
            <li>
                在面板中选择今天之后第<code>5</code>天<code>09</code>时<code>30</code>分。<br />
                结果：面板高亮当前选择。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DateFormatString</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：控制选中值的文字格式；本页使用 <code>yyyy</code>-<code>MM</code>-<code>dd</code> <code>HH</code>:<code>mm</code>:<code>ss</code>。</li>
            <li><code>ShowTime</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：设为 <code>true</code>，在日期选择中同时提供时间列。</li>
        </ul>
    </section>
}
