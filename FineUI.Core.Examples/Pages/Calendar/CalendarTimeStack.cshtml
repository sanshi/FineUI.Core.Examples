@page
@model FineUI.Core.Examples.Pages.Calendar.CalendarTimeStackModel
@{
    ViewBag.Title = "Calendar/CalendarTimeStack";
    var F = Html.F();
}


@section body {

    <f:Calendar ID="Calendar1" OnDateSelect="Calendar1_DateSelect" ShowTime="true" StackDateTime="true">
    </f:Calendar>
    <br />
    <br />
    <f:Button ID="Button1" OnClick="Button1_Click"></f:Button>
    <br />
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示把日期网格与时间列上下排列，在同一面板选择日期和时间。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>在同一面板上下选择日期和时间</h3>
        <ol>
            <li>
                展开日期时间面板，对照日期与时间区域，再分别调整日期、小时和分钟。<br />
                结果：日期和时间上下排列在同一个面板中，无需在两种视图之间来回切换。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>StackDateTime</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：设为 <code>true</code>，日期网格与时间列上下排列，适合较窄的面板。</li>
        </ul>
    </section>
}
