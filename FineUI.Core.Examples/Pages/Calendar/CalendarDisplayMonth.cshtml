@page
@model FineUI.Core.Examples.Pages.Calendar.CalendarDisplayMonthModel
@{
    ViewBag.Title = "Calendar/CalendarDisplayMonth";
    var F = Html.F();
}


@section body {

    <f:Calendar ID="Calendar1" DisplayType="Month" ShowTodayButton="false" OnDateSelect="Calendar1_DateSelect">
    </f:Calendar>
    <br />
    <br />
    <f:Button ID="Button1" OnClick="Button1_Click"></f:Button>
    <br />
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示在页面内直接只选择年月。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>选择年月</h3>
        <ul>
            <li>
                在面板中选择下个月。<br />
                结果：面板高亮当前选择。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DateFormatString</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：控制选中值的文字格式；本页使用 <code>yyyy</code>/<code>MM</code>。</li>
            <li><code>DisplayType</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：本页采用年月面板，一次选择一个值。</li>
        </ul>
    </section>
}
