@page
@model FineUI.Core.Examples.Pages.Calendar.CalendarDayRangeTimeShowSecondModel
@{
    ViewBag.Title = "Calendar/CalendarDayRangeTimeShowSecond";
    var F = Html.F();
}


@section body {

    <f:Calendar ID="Calendar1" OnDateSelect="Calendar1_DateSelect" DisplayType="DayRange" ShowTime="true" ShowSecond="false">
    </f:Calendar>
    <br />
    <br />
    <f:Button ID="Button1" OnClick="Button1_Click"></f:Button>
    <br />
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>
}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示选择日期时间范围时隐藏秒列，只显示和读取到分钟。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-time" aria-hidden="true"></i>只选择小时和分钟</h3>
        <ol>
            <li>
                查看日历的时间区域，分别选择小时和分钟。<br />
                结果：时间区域不显示秒列，所选日期时间的显示文字也不包含秒。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DateFormatString</code>：控制选中值的文字格式；本页使用 yyyy-MM-dd HH:mm。</li>
            <li><code>ShowSecond</code>：设为 false，时间面板只显示小时和分钟，不创建秒列；输出格式也不含秒。</li>
        </ul>
    </section>
}
