@page
@model FineUI.Core.Examples.Pages.Calendar.CalendarDayRangeTimeModel
@{
    ViewBag.Title = "Calendar/CalendarDayRangeTime";
    var F = Html.F();
}


@section body {

    <f:Calendar ID="Calendar1" OnDateSelect="Calendar1_DateSelect" DisplayType="DayRange" ShowTime="true">
    </f:Calendar>
    <br />
    <br />
    <f:Button ID="Button1" OnClick="Button1_Click"></f:Button>
    <br />
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>
}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示在页面内直接选择日期时间范围。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>选择日期时间范围</h3>
        <ul>
            <li>
                依次将起点和终点选择为今天之后第<code>5</code>天<code>09</code>时<code>30</code>分到第<code>10</code>天<code>10</code>时<code>30</code>分。<br />
                结果：面板高亮当前选择，范围显示起止两个值。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DateFormatString</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：设为<code>yyyy-MM-dd HH:mm:ss</code>，控制选中值的文字格式。</li>
            <li><code>ShowTime</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：设为 <code>true</code>，在日期选择中同时提供时间列。</li>
        </ul>
    </section>
}
