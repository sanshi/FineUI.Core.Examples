@page
@model FineUI.Core.Examples.Pages.Calendar.CalendarTimeConfirmButtonModel
@{
    ViewBag.Title = "Calendar/CalendarTimeConfirmButton";
    var F = Html.F();
}


@section body {

    <f:Calendar ID="Calendar1" OnDateSelect="Calendar1_DateSelect" ShowTime="true" ShowConfirmButton="true" ConfirmToSelect="true">
    </f:Calendar>
    <br />
    <br />
    <f:Button ID="Button1" OnClick="Button1_Click"></f:Button>
    <br />
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示日期时间先暂存选择，点击<strong>确定</strong>后才提交当前值。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>选择日期时间</h3>
        <ol>
            <li>
                在面板中选择今天之后第<code>5</code>天<code>09</code>时<code>30</code>分。<br />
                结果：选择暂存在面板中；还没有执行选中事件，输入框或下方结果保持原值。
            </li>
            <li>
                点击面板中的<strong>确定</strong>。<br />
                结果：完成选择并触发选中事件。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ShowConfirmButton</code>（<strong class="example-control-reference" data-example-control="Calendar1"
                    title="日历">日历</strong>）：显示面板中的<strong>确定</strong>按钮；是否延后提交选择由 <code>ConfirmToSelect</code> 控制。</li>
            <li><code>ConfirmToSelect</code>（<strong class="example-control-reference" data-example-control="Calendar1"
                    title="日历">日历</strong>）：将当前选择暂存在面板中，点击<strong>确定</strong>后才提交当前值并触发选中事件。</li>
        </ul>
    </section>
}
