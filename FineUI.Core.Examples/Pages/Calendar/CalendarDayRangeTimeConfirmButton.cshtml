@page
@model FineUI.Core.Examples.Pages.Calendar.CalendarDayRangeTimeConfirmButtonModel
@{
    ViewBag.Title = "Calendar/CalendarDayRangeTimeConfirmButton";
    var F = Html.F();
}


@section body {

    <f:Calendar ID="Calendar1" OnDateSelect="Calendar1_DateSelect" DisplayType="DayRange" ShowTime="true" ShowConfirmButton="true" ConfirmToSelect="true">
    </f:Calendar>
    <br />
    <br />
    <f:Button ID="Button1" OnClick="Button1_Click"></f:Button>
    <br />
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>
}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示日期时间范围先暂存选择，点击“确定”后才提交当前值。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>选择日期时间范围</h3>
        <ol>
            <li>
                依次将起点和终点选择为今天之后第5天09时30分到第10天10时30分。<br />
                结果：选择暂存在面板中；还没有执行选中事件，输入框或下方结果保持原值。
            </li>
            <li>
                点击面板中的“确定”。<br />
                结果：完成选择并触发选中事件。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ShowConfirmButton</code>：显示面板中的“确定”按钮；是否延后提交选择由 ConfirmToSelect 控制。</li>
            <li><code>ConfirmToSelect</code>：将当前选择暂存在面板中，点击“确定”后才提交当前值并触发选中事件。</li>
        </ul>
    </section>
}
