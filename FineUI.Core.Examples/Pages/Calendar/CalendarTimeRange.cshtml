@page
@model FineUI.Core.Examples.Pages.Calendar.CalendarTimeRangeModel
@{
    ViewBag.Title = "Calendar/CalendarTimeRange";
    var F = Html.F();
}


@section body {

    <f:Calendar ID="Calendar1" OnDateSelect="Calendar1_DateSelect" DisplayType="TimeRange">
    </f:Calendar>
    <br />
    <br />
    <f:Button ID="Button1" OnClick="Button1_Click"></f:Button>
    <br />
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>
}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示在页面内直接只选择时间范围，无需选择日期。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>选择时间范围</h3>
        <ul>
            <li>
                依次将起点和终点选择为<code>09</code>时<code>30</code>分到<code>10</code>时<code>30</code>分。<br />
                结果：面板高亮当前选择，范围显示起止两个值。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DateFormatString</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：设为<code>HH:mm:ss</code>，控制选中值的文字格式。</li>
            <li><code>DisplayType</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：本页采用时间范围面板，选择起点和终点。</li>
        </ul>
    </section>
}
