@page
@model FineUI.Core.Examples.Pages.Calendar.CalendarDayRangeMinDateModel
@{
    ViewBag.Title = "Calendar/CalendarDayRangeMinDate";
    var F = Html.F();
}


@section body {

    <f:Calendar ID="Calendar1" OnDateSelect="Calendar1_DateSelect" DisplayType="DayRange">
    </f:Calendar>
    <br />
    <br />
    <f:Button ID="Button1" OnClick="Button1_Click"></f:Button>
    <br />
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>
}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示限制日期范围的可选上下限，超出范围的项目不能选中。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>检查可选范围</h3>
        <ul>
            <li>
                切换到下限之前或上限之后的日期、年份或月份，尝试点击。<br />
                结果：超出本页限制的项目不可选；可选择范围以内的项目。上下限按当前日期计算的页面，每天随日期变化。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>MinDate</code>：限定最早可选的日期、月份或年份；下限之前的项目不能选中。</li>
            <li><code>MaxDate</code>：限定最晚可选的日期、月份或年份；上限之后的项目不能选中。</li>
        </ul>
    </section>
}
