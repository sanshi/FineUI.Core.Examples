@page
@model FineUI.Core.Examples.Pages.Basic.LoginModel
@{
    ViewBag.Title = "Basic/Login";
}

@section body {

    <div>
        用户名：admin
        <br />
        密码：admin
        <br />
        <br />
        <br />
        注意：在任意输入框内按回车键都会触发表单的提交（相当于点击【登录】按钮）。
    </div>

    <f:Window Width="350" WindowPosition="GoldenSection" EnableClose="false" IsModal="false" Title="登录表单" ID="Window1">
        <Items>
            <f:SimpleForm ShowHeader="false" BodyPadding="10" RemoveLastFieldsMargin="true" ShowBorder="false" ID="SimpleForm1">
                <Items>
                    <f:TextBox ShowRedStar="true" Required="true" Label="用户名" ID="tbxUserName"></f:TextBox>
                    <f:TextBox ShowRedStar="true" Required="true" TextMode="Password" Label="密码" ID="tbxPassword"></f:TextBox>
                </Items>
            </f:SimpleForm>
        </Items>
        <Toolbars>
            <f:Toolbar Position="Bottom" ToolbarAlign="Right" ID="Toolbar1">
                <Items>
                    <f:Button Type="Submit" ID="btnLogin" Text="登录" ValidateTarget="Top" _ValidateForms="SimpleForm1" ButtonColor="Primary"
                              OnClick="btnLogin_Click"></f:Button>
                    <f:Button Type="Reset" Text="重置" ID="btnReset"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Window>


}




@section exampleDescription {
<section aria-label="页面描述">
    <p>用一个登录表单演示必填验证、密码输入、提交和重置。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>验证并提交登录</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="btnLogin" title="登录">登录</strong>。<br />结果：必填项为空时显示验证错误，阻止提交。</li>
        <li>在<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>和<strong class="example-control-reference" data-example-control="tbxPassword" title="密码">密码</strong>分别输入 <code>admin</code>，点击<strong class="example-control-reference" data-example-control="btnLogin" title="登录">登录</strong>。<br />结果：验证通过后回发，后台比对用户名和密码，提示成功登录；错误凭据显示错误提示。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnReset" title="重置">重置</strong>。<br />结果：字段恢复初始状态。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Required</code>（<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>、<strong class="example-control-reference" data-example-control="tbxPassword" title="密码">密码</strong>）：初始为 <code>true</code>，要求先填写或选择该字段，未通过时阻止表单提交。</li>
        <li><code>TextMode</code>（<strong class="example-control-reference" data-example-control="tbxPassword" title="密码">密码</strong>）：初始为 <code>Password</code>，以密码模式隐藏实际输入文字。</li>
        <li><code>ValidateForms</code>（<strong class="example-control-reference" data-example-control="btnLogin" title="登录">登录</strong>）：初始为 <code>SimpleForm1</code>，提交前验证指定表单；验证失败时显示提示并阻止回发。</li>
        <li><code>Type</code>（<strong class="example-control-reference" data-example-control="btnLogin" title="登录">登录</strong>、<strong class="example-control-reference" data-example-control="btnReset" title="重置">重置</strong>）：初始为 <code>Submit</code>、<code>Reset</code>，指定按钮行为或图表系列的绘制类型。</li>
    </ul>
</section>
}
