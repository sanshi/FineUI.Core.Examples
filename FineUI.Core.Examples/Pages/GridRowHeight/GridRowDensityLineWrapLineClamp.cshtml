@page
@model FineUI.Core.Examples.Pages.GridRowHeight.GridRowDensityLineWrapLineClampModel
@{
    ViewBag.Title = "GridRowHeight/GridRowDensityLineWrapLineClamp";
    var F = Html.F();
}


@section head {

    <style>
        /* 最多显示 3 行文字，超出则显示省略号 */
        .f-grid-row .f-grid-cell-text {
            white-space: normal;
            word-break: break-all;
            overflow: hidden;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            display: -webkit-box;
        }
    </style>

}



@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField ColumnID="Desc" Width="400" DataField="Desc" HeaderText="个人简介" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
        <Tools>
            <f:Tool ID="toolRowDensity" runat="server" IconFont="_List" Text="行密度">
                <Menu runat="server">
                    <f:MenuCheckBox Text="小间距" AttributeDataTag="small" GroupName="RowDensity" runat="server" ClickHandler="onRowDensityChange"></f:MenuCheckBox>
                    <f:MenuCheckBox Text="标准间距" AttributeDataTag="normal" Checked="true" GroupName="RowDensity" runat="server" ClickHandler="onRowDensityChange"></f:MenuCheckBox>
                    <f:MenuCheckBox Text="大间距" AttributeDataTag="large" GroupName="RowDensity" runat="server" ClickHandler="onRowDensityChange"></f:MenuCheckBox>
                    <f:MenuCheckBox Text="超大间距" AttributeDataTag="xlarge" GroupName="RowDensity" runat="server" ClickHandler="onRowDensityChange"></f:MenuCheckBox>
                </Menu>
            </f:Tool>
        </Tools>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>
    <br />
    <br />
     
}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onRowDensityChange(event) {
            var menuCheckBoxCmp = this;
            var selectedRowDensity = menuCheckBoxCmp.el.attr('data-tag');

            F.ui.Grid1.setRowDensity(selectedRowDensity);
        }

    </script>
}
@section exampleDescription {
<section aria-label="页面描述">
    <p>通过行密度菜单调整行内间距，同时保留长文字换行，超过三行的文字省略。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>切换行密度</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>标题栏的齿轮，选择超大间距，再改回普通。<br />结果：浏览器直接更新行密度，行内上下间距和最终行高相应变化；数据不变，也不为间距调整重新查询。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>setRowDensity</code>（<strong>行密度菜单与表格脚本</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：菜单把 <code>small</code>、<code>normal</code>、<code>large</code>、<code>xlarge</code> 传给表格，初始选择普通。</li>
        <li><code>FixedRowHeight</code>（<strong>表格行高配置</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：本页不启用固定行高，由实际内容与间距决定每行高度。</li>
        <li><code>CSS</code>（<strong>单元格文字</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：单元格允许换行，并把文本最多显示行数限制为 <code>3</code>。</li>
    </ul>
</section>
}
