@page
@model FineUI.Core.Examples.Pages.GridRowHeight.GridFixedRowHeightModel
@{
    ViewBag.Title = "GridRowHeight/GridFixedRowHeight";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
        FixedRowHeight="true" >
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField ColumnID="Desc" Width="400" DataField="Desc" HeaderText="个人简介" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>
    <br />
    <br />

    <br />
    <br />
    <table class="result">
        <tbody>
            <tr>
                <th></th>
                <th>默认行高（px）</th>
            </tr>
            <tr>
                <td>紧凑模式</td>
                <td>16</td>
            </tr>
            <tr>
                <td>小字体模式</td>
                <td>16</td>
            </tr>
            <tr>
                <td>普通模式</td>
                <td>20</td>
            </tr>
            <tr>
                <td>大间距模式</td>
                <td>24</td>
            </tr>
            <tr>
                <td>大字体模式</td>
                <td>24</td>
            </tr>
        </tbody>
    </table>
}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>用固定行高显示记录。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>核对行高一致性</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>比较不同描述长度的记录，再向下滚动。<br />结果：各行使用同一套固定高度，滚动后后续记录也保持等高；长文字不会无限撑大单独一行，超出范围的内容受可用高度限制。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <p>注：如果设置FixedRowHeight=true，但是未设置RowHeight，则使用默认行高（不包含单元格的内边距）。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>FixedRowHeight</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>true</code>，初始为 <code>true</code>，按统一行高显示记录。</li>
    </ul>
</section>
}
