@page
@model FineUI.Core.Examples.Pages.GridRowHeight.GridRowDensityModel
@{
    ViewBag.Title = "GridRowHeight/GridRowDensity";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField ColumnID="Desc" Width="400" DataField="Desc" HeaderText="个人简介" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
        <Tools>
            <f:Tool ID="toolRowDensity" runat="server" IconFont="_List" Text="行密度">
                <Menu runat="server">
                    <f:MenuCheckBox Text="小间距" AttributeDataTag="small" GroupName="RowDensity" runat="server" ClickHandler="onRowDensityChange">
                    </f:MenuCheckBox>
                    <f:MenuCheckBox Text="标准间距" AttributeDataTag="normal" Checked="true" GroupName="RowDensity" runat="server"
                        ClickHandler="onRowDensityChange"></f:MenuCheckBox>
                    <f:MenuCheckBox Text="大间距" AttributeDataTag="large" GroupName="RowDensity" runat="server" ClickHandler="onRowDensityChange">
                    </f:MenuCheckBox>
                    <f:MenuCheckBox Text="超大间距" AttributeDataTag="xlarge" GroupName="RowDensity" runat="server" ClickHandler="onRowDensityChange">
                    </f:MenuCheckBox>
                </Menu>
            </f:Tool>
        </Tools>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>
    <br />
    <br />

    <br />
    <br />
    <table class="result" style="width: 850px;">
        <tbody>
            <tr>
                <th></th>
                <th>行高（px）</th>
                <th>内边距（px）<br />行密度（Small）</th>
                <th>内边距（px）<br />行密度（Normal）</th>
                <th>内边距（px）<br />行密度（Large）</th>
                <th>内边距（px）<br />行密度（XLarge）</th>
            </tr>
            <tr>
                <td>紧凑模式</td>
                <td>16</td>
                <td>2</td>
                <td>6</td>
                <td>10</td>
                <td>14</td>
            </tr>
            <tr>
                <td>小字体模式</td>
                <td>16</td>
                <td>4</td>
                <td>8</td>
                <td>12</td>
                <td>16</td>
            </tr>
            <tr>
                <td>普通模式</td>
                <td>20</td>
                <td>4</td>
                <td>8</td>
                <td>12</td>
                <td>16</td>
            </tr>
            <tr>
                <td>大间距模式</td>
                <td>24</td>
                <td>6</td>
                <td>10</td>
                <td>14</td>
                <td>18</td>
            </tr>
            <tr>
                <td>大字体模式</td>
                <td>24</td>
                <td>8</td>
                <td>12</td>
                <td>16</td>
                <td>20</td>
            </tr>
        </tbody>
    </table>
}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onRowDensityChange(event) {
            var menuCheckBoxCmp = this;
            var selectedRowDensity = menuCheckBoxCmp.el.attr('data-tag');

            F.ui.Grid1.setRowDensity(selectedRowDensity);
        }

    </script>
}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>通过行密度菜单调整行内间距。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>切换行密度</h3>
        <ol>
            <li>点击<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>标题栏的齿轮，选择超大间距，再改回普通。<br />结果：浏览器直接更新行密度，行内上下间距和最终行高相应变化；数据不变，也不为间距调整重新查询。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：不同显示模式下，表格的行间距参数如下所示（行高不包含内边距）。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>setRowDensity</code>（<strong>行密度菜单与表格脚本</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：菜单把 <code>small</code>、<code>normal</code>、<code>large</code>、<code>xlarge</code> 传给表格，初始选择普通。</li>
            <li><code>FixedRowHeight</code>（<strong>表格行高配置</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：本页不启用固定行高，由实际内容与间距决定每行高度。</li>
        </ul>
    </section>
}
