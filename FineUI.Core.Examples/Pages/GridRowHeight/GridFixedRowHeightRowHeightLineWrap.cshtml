@page
@model FineUI.Core.Examples.Pages.GridRowHeight.GridFixedRowHeightRowHeightLineWrapModel
@{
    ViewBag.Title = "GridRowHeight/GridFixedRowHeightRowHeightLineWrap";
    var F = Html.F();
}


@section head {

    <style>
        .f-grid-row .f-grid-cell-text {
            white-space: normal;
            word-break: break-all;
        }
    </style>

}



@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
        FixedRowHeight="true" RowHeight="60" RowHeightCompact="48" RowHeightSmall="48" RowHeightLargeSpace="72" RowHeightLarge="72">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField ColumnID="Desc" Width="400" DataField="Desc" HeaderText="个人简介" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>
    <br />
    <br />
    手工设置行高时：

    <br />
    <br />
    <table class="result" style="width: 850px;">
        <tbody>
            <tr>
                <th></th>
                <th>默认行高（px）</th>
                <th>设置的行高（px）</th>
            </tr>
            <tr>
                <td>紧凑模式</td>
                <td>16</td>
                <td>16 * 3 = 48</td>
            </tr>
            <tr>
                <td>小字体模式</td>
                <td>16</td>
                <td>16 * 3 = 48</td>
            </tr>
            <tr>
                <td>普通模式</td>
                <td>20</td>
                <td>20 * 3 = 60</td>
            </tr>
            <tr>
                <td>大间距模式</td>
                <td>24</td>
                <td>24 * 3 = 72</td>
            </tr>
            <tr>
                <td>大字体模式</td>
                <td>24</td>
                <td>24 * 3 = 72</td>
            </tr>
        </tbody>
    </table>
}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>用固定行高显示记录，长文字在统一高度内换行。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>核对行高一致性</h3>
        <ol>
            <li>在<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>比较不同描述长度的记录，再向下滚动。<br />结果：各行使用同一套固定高度，滚动后后续记录也保持等高；长文字不会无限撑大单独一行，超出范围的内容受可用高度限制。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <ul>
            <li>尽量将行高设置为默认行高的整数倍，防止文字换行时被部分遮挡的问题。</li>
            <li>需要为所有显示模式设置行高（RowHeight、RowHeightCompact、RowHeightSmall、RowHeightLargeSpace、RowHeightLarge）。</li>
            <li>推荐使用 RowHeightLines 属性快速为所有显示模式设置行高。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>FixedRowHeight</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>true</code>，初始为 <code>true</code>，按统一行高显示记录。
            </li>
            <li><code>RowHeight / RowHeightSmall / RowHeightLarge</code>（<strong>表格行高配置</strong>，位于<strong class="example-control-reference"
                    data-example-control="Grid1" title="表格">表格</strong>）：普通、小间距与大间距初始分别为 <code>60</code>、<code>48</code>、<code>72</code>，指定对应密度采用的行高。</li>
            <li><code>CSS</code>（<strong>单元格文字</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：单元格长文字允许按列宽换行；换行样式与固定行高分别配置。</li>
        </ul>
    </section>
}
