@page
@model FineUI.Core.Examples.Pages.GridRowHeight.Grid100Model
@{
    ViewBag.Title = "GridRowHeight/Grid100";
    var F = Html.F();
}


@section head {

    <style>
        .f-grid-row .f-grid-cell-text {
            white-space: normal;
            word-break: break-all;
        }
    </style>

}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="100行（行高不同）" DataIDField="Id" DataTextField="Name" Height="500"
        EnableCheckBoxSelect="true" KeepCurrentSelection="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="标识" DataField="Id" />
            <f:RenderField HeaderText="姓名" DataField="Name" Width="150" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="个人简介" DataField="Desc" Width="500" />
            <f:RenderField HeaderText="GUID" DataField="GUID" Width="300" />
            <f:RenderField HeaderText="爱好" DataField="Hobby" RendererFunction="renderHobby" Width="200" />
            <f:RenderField HeaderText="入学时间" DataField="EntranceDate" />
            <f:RenderField HeaderText="语文成绩" DataField="ChineseScore" />
            <f:RenderField HeaderText="数学成绩" DataField="MathScore" />
            <f:RenderField HeaderText="总成绩" DataField="TotalScore" />
            <f:RenderField HeaderText="身高" DataField="ShenGao" />
            <f:RenderField HeaderText="体重" DataField="TiZhong" />
            <f:RenderField HeaderText="血压（低）" DataField="XueYaDi" />
            <f:RenderField HeaderText="血压（高）" DataField="XueYaGao" />
            <f:RenderField HeaderText="视力（左）" DataField="ShiLiZuo" />
            <f:RenderField HeaderText="视力（右）" DataField="ShiLiYou" />
            <f:RenderField HeaderText="矫正视力（左）" DataField="ShiLiZuoJiaoZhen" Width="150" />
            <f:RenderField HeaderText="矫正视力（右）" DataField="ShiLiYouJiaoZhen" Width="150" />
        </Columns>
        <Listeners>
            <f:Listener Event="render" Handler="onGridRender"></f:Listener>
        </Listeners>
    </f:Grid>

}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        // 等所有JS资源下载完毕后开始
        var __STARTTIME = new Date();

        // 表格渲染完毕后结束
        function onGridRender(event) {
            this.setTitle(this.getTitle() + ' - 渲染时间：' + ((new Date() - __STARTTIME) / 1000).toFixed(2));
        }

        function renderHobby(value, params) {
            var result = [];

            // Hobby：reading,basketball,travel,movie,music
            // 爱好：读书, 篮球, 旅游, 电影, 音乐
            var hobbies = value.split(',');

            $.each(hobbies, function (index, hobby) {
                if (hobby == "reading") {
                    result.push("读书");
                }
                else if (hobby == "basketball") {
                    result.push("篮球");
                }
                else if (hobby == "travel") {
                    result.push("旅游");
                }
                else if (hobby == "movie") {
                    result.push("电影");
                }
                else if (hobby == "music") {
                    result.push("音乐");
                }
            });

            return result.join(',');
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>让每行随长文字内容自动增高，短记录与长记录可以采用不同高度。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>比较长短内容的行高</h3>
        <ol>
            <li>在<strong class="example-control-reference" data-example-control="Grid1"
                    title="100行（行高不同）">100行（行高不同）</strong>比较不同描述长度的记录，再向下滚动。<br />结果：长文字行比短文字行更高，行高按内容计算；文字按列宽完整折行。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>FixedRowHeight</code>（<strong>表格行高配置</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="100行（行高不同）">100行（行高不同）</strong>）：本页不启用固定行高，由实际内容与间距决定每行高度。</li>
            <li><code>CSS</code>（<strong>单元格文字</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="100行（行高不同）">100行（行高不同）</strong>）：单元格长文字允许按列宽换行；换行样式与固定行高分别配置。</li>
        </ul>
    </section>
}
