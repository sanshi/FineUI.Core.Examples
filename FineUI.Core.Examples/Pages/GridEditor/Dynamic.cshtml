@page
@model FineUI.Core.Examples.Pages.GridEditor.DynamicModel
@{
    ViewBag.Title = "GridEditor/Dynamic";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（单击编辑）" DataIDField="Id" DataTextField="Name"
            AllowCellEditing="true" ClicksToEdit="1" RowDataBoundFunction="onGrid1RowDataBound">
        <Listeners>
            <f:Listener Event="afteredit" Handler="onGrid1AfterEdit"></f:Listener>
        </Listeners>
    </f:Grid>

    <br>
    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>
    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>
    <br>
    <br>


}


@section script {

    <script type="application/json" id="yearRange">@Html.Raw(Model.YearRangeJson)</script>

    <script src="~/res/js/grid.js"></script>

    <script>

        // 先读取纯 JSON，保证控件首次渲染时就能使用这些数据。
        var yearRange = JSON.parse(document.getElementById('yearRange').textContent);
        window._MINYEAR = yearRange.minYear;
        window._MAXYEAR = yearRange.maxYear;

        function updateTotalCell(grid, rowId) {
            var me = grid, total = 0;
            for (var i = _MINYEAR; i <= _MAXYEAR; i++) {
                total += me.getCellValue(rowId, 'Year_' + i);
            }

            // 用 ColumnID 到新值的对象更新单元格，单列和多列采用同一种写法。
            // https://fineui.com/js/api/FineUI.Grid.html#updateCellValue
            me.updateCellValue(rowId, { TotalFee: total });
        }

        function onGrid1AfterEdit(event, value, params) {
            var me = this, rowId = params.rowId;
            if (params.columnId === 'Year_' + _MINYEAR) {
                for (var i = _MINYEAR + 1; i <= _MAXYEAR; i++) {
                    me.updateCellValue(rowId, { ['Year_' + i]: value });
                }
            }

            updateTotalCell(me, rowId);
        }


        function onGrid1RowDataBound(rowData) {
            var year2014 = 0, year2015 = 0, year2016 = 0, year2017 = 0;

            var sourceYearData = rowData.values.YearData;
            if (sourceYearData) {
                // 保存后重新绑定数据时，年份数据可能已是对象；两种格式都能继续计算各年费用与合计。
                var yearData = typeof sourceYearData === 'string' ? F.parseJSON(sourceYearData) : sourceYearData;
                year2014 = yearData['2014'] || 0;
                year2015 = yearData['2015'] || 0;
                year2016 = yearData['2016'] || 0;
                year2017 = yearData['2017'] || 0;
            }

            rowData.values['Year_2014'] = year2014;
            rowData.values['Year_2015'] = year2015;
            rowData.values['Year_2016'] = year2016;
            rowData.values['Year_2017'] = year2017;
            rowData.values['TotalFee'] = year2014 + year2015 + year2016 + year2017;
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>按年份动态创建费用编辑列，首年修改可同步后续年份，并计算同一行合计。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>动态年份列联动计算</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>把最早年份费用改为<code>100</code>并结束编辑。<br />结果：后续年份费用同步为 100，合计重新按各年当前费用求和。</li>
        <li>单独修改后面某一年的费用，再点击<strong class="example-control-reference" data-example-control="btnSubmit" title="保存数据">保存数据</strong>。<br />结果：只更新该年及同一行合计；后台把各年费用写回示例数据，重新绑定后动态列继续正确显示。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <ul>
        <li>所有列都是在后台动态创建的。</li>
        <li>修改第一列的值，会同时更新后面几列的值。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Columns / RowDataBoundFunction</code>（<strong>页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>）：创建年份列，再在行绑定时将 YearData 展开为各年份的列值。</li>
        <li><code>afteredit / updateCellValue</code>（<strong>页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>）：修改最早年份时同步后续年份；任一费用变化后重算当前行的 TotalFee。</li>
    </ul>
</section>
}
