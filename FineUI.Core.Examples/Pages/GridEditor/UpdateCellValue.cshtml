@page
@model FineUI.Core.Examples.Pages.GridEditor.UpdateCellValueModel
@{
    ViewBag.Title = "GridEditor/UpdateCellValue";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（双击编辑）" DataIDField="Id" DataTextField="Name" AllowCellEditing="true"
        ClicksToEdit="2" EnableCheckBoxSelect="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name">
                <Editor>
                    <f:TextBox ID="tbxName"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender">
                <Editor>
                    <f:DropDownList ID="ddlGender" Required="true">
                        <f:ListItem Text="男" Value="1"></f:ListItem>
                        <f:ListItem Text="女" Value="0"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" ExpandUnusedSpace="true" MinWidth="150">
                <Editor>
                    <f:TextBox ID="tbxMajor" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="语文成绩" ColumnID="ChineseScore" DataField="ChineseScore" FieldType="Int">
                <Editor>
                    <f:NumberBox ID="nbChineseScore" NoDecimal="true" NoNegative="true" Required="true"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="数学成绩" ColumnID="MathScore" DataField="MathScore" FieldType="Int">
                <Editor>
                    <f:NumberBox ID="nbMathScore" NoDecimal="true" NoNegative="true" Required="true"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="总成绩" ColumnID="TotalScore" DataField="TotalScore" FieldType="Int">
                <Editor>
                    <f:NumberBox ID="nbTotalScore" NoDecimal="true" NoNegative="true" Required="true"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField EnableHeaderMenu="false">
                <Commands>
                    <f:Command CommandName="Delete" Icon="Delete" ConfirmText="删除选中行？" ConfirmTarget="Top" />
                </Commands>
            </f:RenderField>
        </Columns>
        <Listeners>
            <f:Listener Event="afteredit" Handler="onGrid1AfterEdit"></f:Listener>
            <f:Listener Event="rowcommand" Handler="onGrid1RowCommand"></f:Listener>
        </Listeners>
        <Toolbars>
            <f:Toolbar>
                <Items>
                    <f:Button ID="btnNew" Text="新增数据" Icon="Add" ClickHandler="onNewClick"></f:Button>
                    <f:Button ID="btnDelete" Text="删除选中行" Icon="Delete" ClickHandler="onDeleteClick"></f:Button>
                    <f:ToolbarFill></f:ToolbarFill>
                    <f:Button ID="btnReset" Text="重置表格数据" ClickHandler="onResetClick"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Grid>

    <br>
    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>

    <br>


}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onGrid1AfterEdit(event, value, params) {
            var me = this, columnId = params.columnId, rowId = params.rowId;
            if (columnId === 'ChineseScore' || columnId === 'MathScore') {
                var chineseScore = me.getCellValue(rowId, 'ChineseScore');
                var mathScore = me.getCellValue(rowId, 'MathScore');

                // 用 ColumnID 到新值的对象更新单元格，单列和多列采用同一种写法。
                // https://fineui.com/js/api/FineUI.Grid.html#updateCellValue
                me.updateCellValue(rowId, { TotalScore: chineseScore + mathScore });

            }
        }


        function onNewClick(event) {
            var grid1 = F.ui.Grid1;

            // 新增一行（返回新增行的ID）
            var addedRowId = grid1.addNewRecord({
                'Name': '新用户',
                'Gender': '1',
                'Major': '化学系',
                'ChineseScore': 0,
                'MathScore': 0,
                'TotalScore': 0
            }, true);

        }

        function onResetClick(event) {
            F.confirm({
                message: '确定要重置表格数据？',
                ok: function () {
                    F.ui.Grid1.rejectChanges();
                }
            });
        }

        function onDeleteClick(event) {
            var grid1 = F.ui.Grid1;
            if (!grid1.hasSelection()) {
                F.alert('没有选中项！');
                return;
            }

            var selectedRows = grid1.getSelectedRows();
            F.confirm({
                message: F.rawHtml('你确定要删除选中的&nbsp;<b>' + selectedRows.length + '</b>&nbsp;行数据吗？'),
                target: '_top',
                ok: function () {
                    grid1.deleteRows(selectedRows);
                }
            });
        }


        // 行命令
        function onGrid1RowCommand(event, rowId, rowIndex, columnId, commandName) {
            if (commandName === 'Delete') {
                F.ui.Grid1.deleteRow(rowId);
            }
        }

    </script>
}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>修改语文或数学成绩后，立即更新同一行的总成绩。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>用两科成绩重算总成绩</h3>
        <ol>
            <li>双击<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（双击编辑）">表格（双击编辑）</strong>某行<strong>语文成绩</strong>，输入<code>90</code>，再结束编辑。<br />结果：浏览器读取该行当前<strong>数学成绩</strong>，<strong>总成绩</strong>立即显示
                90 加<strong>数学成绩</strong>的结果。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>afteredit / getCellValue / updateCellValue</code>（<strong>页面脚本</strong>，作用于<strong class="example-control-reference"
                    data-example-control="Grid1" title="表格（双击编辑）">表格（双击编辑）</strong>）：在单科结束编辑后读取同一行的两科值，以 TotalScore 列标识更新合计，不需要打开目标编辑器。</li>
        </ul>
    </section>
}
