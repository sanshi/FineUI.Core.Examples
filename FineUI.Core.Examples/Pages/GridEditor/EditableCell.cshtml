@page
@model FineUI.Core.Examples.Pages.GridEditor.EditableCellModel
@{
    ViewBag.Title = "GridEditor/EditableCell";
    var F = Html.F();
}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（单击编辑）" DataIDField="Id" DataTextField="Name" AllowCellEditing="true"
        ClicksToEdit="1">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender">
                <Editor>
                    <f:DropDownList ID="ddlGender" Required="true">
                        <f:ListItem Text="男" Value="1"></f:ListItem>
                        <f:ListItem Text="女" Value="0"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学年份" ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int" RendererFunction="renderEntranceYear">
                <Editor>
                    <f:NumberBox ID="nbxEntranceYear" NoDecimal="true" NoNegative="true" MinValue="2000" MaxValue="2025"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd"
                Width="150" RendererFunction="renderEntranceDate">
                <Editor>
                    <f:DatePicker ID="dpEntranceDate" Required="true"></f:DatePicker>
                </Editor>
            </f:RenderField>
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool" DataField="AtSchool" />
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" ExpandUnusedSpace="true" MinWidth="150">
                <Editor>
                    <f:TextBox ID="tbxMajor" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
        </Columns>
    </f:Grid>

    <br>
    <br>
    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>

    <br>


}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderEntranceYear(value, params) {
            if (value <= 2002) {
                params.cellCls = 'f-grid-cell-uneditable';
            }

            return value;
        }

        function renderEntranceDate(value, params) {
            if (params.rowData.values.EntranceYear <= 2002) {
                params.cellCls = 'f-grid-cell-uneditable';
            }

            return F.formatDate(params.column.fieldFormat, value);
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>按入学年份限制指定单元格编辑，其他列仍可正常修改。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>只限制符合条件的日期与年份</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（单击编辑）">表格（单击编辑）</strong>找到<strong>入学年份</strong>小于或等于<code>2002</code>的行，尝试编辑<strong>入学年份</strong>与<strong><strong>入学日期</strong></strong>，再编辑同一行的<strong>姓名</strong>。<br />结果：年份与日期不能进入编辑，<strong>姓名</strong>等其他可编辑列不受该条件限制。
            </li>
            <li>从初始状态选择<strong>入学年份</strong>大于 2002 的行，编辑其年份或日期。<br />结果：这两列可正常打开编辑器；限制按具体单元格应用，不是禁用整个表格。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <ul>
            <li><strong>入学日期</strong>列删除Renderer=Date属性，增加自定义渲染函数RendererFunction=renderEntranceDate。</li>
            <li>本例子禁止[<strong>入学年份</strong>小于等于2002]行中[<strong>入学年份</strong>]和[<strong>入学日期</strong>]的单元格编辑。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>RendererFunction / f-grid-cell-uneditable</code>（<strong>入学年份与入学日期列</strong>，位于<strong class="example-control-reference"
                    data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>）：渲染函数按该行<strong>入学年份</strong>条件添加不可编辑样式，保留其他列的编辑能力。</li>
        </ul>
    </section>
}
