@page
@model FineUI.Core.Examples.Pages.GridEditor.GridEditorRateModel
@{
    ViewBag.Title = "GridEditor/GridEditorRate";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" AllowCellEditing="true"
        ClicksToEdit="1">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender">
                <Editor>
                    <f:DropDownList ID="ddlGender" Required="true">
                        <f:ListItem Text="男" Value="1"></f:ListItem>
                        <f:ListItem Text="女" Value="0"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField Width="150" ColumnID="Rate1" DataField="Rate1" FieldType="Int" HeaderText="只读评分" RendererFunction="renderRate1" />
            <f:RenderField Width="200" ColumnID="Rate2" DataField="Rate2" FieldType="Int" HeaderText="五星评分" RendererFunction="renderRate2" />
            <f:RenderField Width="200" ColumnID="Rate3" DataField="Rate3" FieldType="Float" HeaderText="自定义评分" RendererFunction="renderRate3" />
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" ExpandUnusedSpace="true" MinWidth="150">
                <Editor>
                    <f:TextBox ID="tbxMajor" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
        </Columns>
    </f:Grid>
    <br />
    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>



}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        var desc = ['terrible', 'bad', 'normal', 'good', 'wonderful'];
        function renderRate2Text(val) {
            var rateText = '-';
            if (val > 0) {
                rateText = desc[val - 1];
            }
            return rateText;
        }


        function renderRate1(value) {
            return F.rateHtml(value, {
                readonly: true
            });
        }

        function renderRate2(value) {
            return F.rateHtml(value, {
                textVisible: true,
                textRenderer: renderRate2Text
            });
        }

        function renderRate3(value) {
            return F.rateHtml(value, {
                allowHalf: true,
                iconFont: 'f-iconfont-trophy',
                textVisible: true
            });
        }


        F.ready(function () {

            var grid1 = F.ui.Grid1;

            // 注册评分事件
            F.rateEvents(grid1.el, function (event, value) {
                var target = $(event.target);
                var cellEl = target.closest('.f-grid-cell');

                var rowId = grid1.getRowId(cellEl);
                var columnId = grid1.getColumnId(cellEl);

                // 更新单元格的值
                // 列名在运行时确定，用实际 ColumnID 作为对象的键更新对应单元格。
                // https://fineui.com/js/api/FineUI.Grid.html#updateCellValue
                grid1.updateCellValue(rowId, { [columnId]: value });
            });

        });

    </script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>在表格正文中显示只读、五星与自定义半分评分，用户操作直接写回评分列数值。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>对照三种评分列</h3>
        <ul>
            <li>尝试点击<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>的<strong>只读评分</strong>，再在<strong>五星评分</strong>或<strong>自定义评分</strong>列点击一个分值。<br />结果：<strong>只读评分</strong>不因点击改变；可修改评分按点击位置更新，五星列显示对应说明文字，自定义列使用奖杯图标并允许半分。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>F.rateHtml</code>（<strong>评分列的渲染函数</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：分别配置只读、评分文字、自定义图标和半分能力，以当前单元格值生成评分显示。</li>
            <li><code>F.rateEvents</code>（<strong>页面脚本</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：通过表格容器接收评分动作，再定位到本次行和列，更新相应单元格值。</li>
        </ul>
    </section>
}
