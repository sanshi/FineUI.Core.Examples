@page
@model FineUI.Core.Examples.Pages.GridEditor.DropDownBoxGridMultiPagingServerHobbyModel
@{
    ViewBag.Title = "GridEditor/DropDownBoxGridMultiPagingServerHobby";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（单击编辑）" DataIDField="Id" DataTextField="Name" AllowCellEditing="true" ClicksToEdit="1">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender">
                <Editor>
                    <f:DropDownList ID="ddlGender" Required="true">
                        <f:ListItem Text="男" Value="1"></f:ListItem>
                        <f:ListItem Text="女" Value="0"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学年份" ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int">
                <Editor>
                    <f:NumberBox ID="nbxEntranceYear" NoDecimal="true" NoNegative="true" MinValue="2000" MaxValue="2025"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" Width="150">
                <Editor>
                    <f:DatePicker ID="dpEntranceDate" Required="true"></f:DatePicker>
                </Editor>
            </f:RenderField>
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool" DataField="AtSchool" />
            <f:RenderField HeaderText="兴趣爱好" ColumnID="Hobby" DataField="Hobby" ExpandUnusedSpace="true" MinWidth="150" RendererFunction="renderHobby" EditSetterFunction="editSetterHobby" EditGetterFunction="editGetterHobby">
                <Editor>
                    <f:DropDownBox ID="DropDownBox1" EmptyText="请选择" EnableMultiSelect="true" AutoShowClearIcon="true">
                        <PopPanel>
                            <f:Grid ID="Grid2" ShowBorder="true" ShowHeader="false" EnableCheckBoxSelect="true" KeepCurrentSelection="true" Hidden="true" DataIDField="Code" DataTextField="Name" EnableMultiSelect="true"
                                    AllowPaging="true" PageSize="3" ShowPagingMessage="false" PagingType="NumberButton">
                                <Columns>
                                    <f:RowNumberField></f:RowNumberField>
                                    <f:RenderField ColumnID="Code" DataField="Code" HeaderText="代码" />
                                    <f:RenderField ColumnID="Name" ExpandUnusedSpace="true" DataField="Name" HeaderText="姓名" />
                                </Columns>
                            </f:Grid>
                        </PopPanel>
                    </f:DropDownBox>
                </Editor>
            </f:RenderField>
            <f:RenderField ColumnID="HobbyText" DataField="HobbyText" Hidden="true"></f:RenderField>
        </Columns>
    </f:Grid>

    <br>
    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>

}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderHobby(value, params) {
            return params.rowValue['HobbyText'];
        }

        // 自定义编辑器获取函数（从Editor返回单元格）
        function editGetterHobby(editor, columnId, rowId) {
            // 将Editor的值返回到表格单元格，随后的renderHobby会用到
            this.updateCellValue(rowId, 'HobbyText', editor.getText());
            return editor.getValue().join(',');
        }

        // 自定义编辑器设置函数（从单元格进入Editor）
        function editSetterHobby(editor, val, columnId, rowId) {
            editor.setValue(val, this.getRowData(rowId).values['HobbyText']);
        }

    </script>
}