@page
@model FineUI.Core.Examples.Pages.GridEditor.EditableRowModel
@{
    ViewBag.Title = "GridEditor/EditableRow";
    var F = Html.F();
}


@section head {

    <style>
        .row-entranceyear-lte-2002 .f-grid-cell-text {
            opacity: .5;
            filter: alpha(opacity=50);
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（单击编辑）" DataIDField="Id" DataTextField="Name" AllowCellEditing="true" ClicksToEdit="1" RowDataBoundFunction="grid1RowDataBound">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender">
                <Editor>
                    <f:DropDownList ID="ddlGender" Required="true">
                        <f:ListItem Text="男" Value="1"></f:ListItem>
                        <f:ListItem Text="女" Value="0"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学年份" ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int">
                <Editor>
                    <f:NumberBox ID="nbxEntranceYear" NoDecimal="true" NoNegative="true" MinValue="2000" MaxValue="2025"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" Width="150">
                <Editor>
                    <f:DatePicker ID="dpEntranceDate" Required="true"></f:DatePicker>
                </Editor>
            </f:RenderField>
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool" DataField="AtSchool" />
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" ExpandUnusedSpace="true" MinWidth="150">
                <Editor>
                    <f:TextBox ID="tbxMajor" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
        </Columns>
        <Listeners>
            <f:Listener Event="beforeedit" Handler="onGrid1BeforeEdit"></f:Listener>
        </Listeners>
    </f:Grid>

    <br>
    <br>
    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>

    <br>


}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        // 在 RowDataBound 中改变行CSS类
        function grid1RowDataBound(rowData) {
            var entranceYear = rowData.values['EntranceYear'];

            if (entranceYear <= 2002) {
                rowData.cls = "row-entranceyear-lte-2002";
            }
        }


        function onGrid1BeforeEdit(event, value, params) {
            // 取消单元格编辑
            if (params.tr.hasClass('row-entranceyear-lte-2002')) {
                return false;
            }
        }

    </script>
}
@section exampleDescription {
<section aria-label="页面描述">
    <p>根据每行的入学年份决定整行是否允许进入编辑，拦截不符合条件的编辑请求。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>按行判断编辑条件</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>选择<strong>入学年份</strong>小于或等于<code>2002</code>的行，点击<strong>姓名</strong>等原本有编辑器的单元格。<br />结果：编辑前回调返回 false，整行不能进入编辑；年份大于 2002 的其他行仍可编辑。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>beforeedit</code>（<strong>页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>）：进入编辑前按当前行条件返回 false；行样式用于识别受限记录，不以行序号判断。</li>
    </ul>
</section>
}
