@page
@model FineUI.Core.Examples.Pages.GridEditor.ShengShiTextValueModel
@{
    ViewBag.Title = "GridEditor/ShengShiTextValue";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（单击编辑）" DataIDField="Id" DataTextField="Name" AllowCellEditing="true"
        ClicksToEdit="1">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name" ExpandUnusedSpace="true" MinWidth="150">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="所在省" ColumnID="Sheng" DataField="Sheng" Width="150" RendererFunction="renderSheng ">
                <Editor>
                    <f:DropDownList ID="ddlSheng" Required="true"></f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="所在市" ColumnID="Shi" DataField="Shi" Width="150" RendererFunction="renderShi">
                <Editor>
                    <f:DropDownList ID="ddlShi" Required="true"></f:DropDownList>
                </Editor>
            </f:RenderField>
        </Columns>
        <Listeners>
            <f:Listener Event="beforeedit" Handler="onGrid1BeforeEdit"></f:Listener>
            <f:Listener Event="afteredit" Handler="onGrid1AfterEdit"></f:Listener>
        </Listeners>
    </f:Grid>

    <br>
    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>
    <br>
    <br>


}

@section script {

    <script type="application/json" id="provinceCityData">@Html.Raw(Model.ProvinceCityDataJson)</script>

    <script src="~/res/js/grid.js"></script>

    <script>

        // 先读取纯 JSON，保证控件首次渲染时就能使用这些数据。
        var provinceCityData = JSON.parse(document.getElementById('provinceCityData').textContent);

        // 渲染性别单元格
        function renderGender(value) {
            return value == 1 ? '男' : '女';
        }

        // 渲染省单元格
        function renderSheng(value) {
            return getShengName(value);
        }

        // 渲染市单元格
        function renderShi(value, params) {
            var shengValue = params.rowValue['Sheng']; // 'Sheng' - ColumnID
            return getShiName(shengValue, value);
        }

        // 根据省代码获取省名称
        function getShengName(shengValue) {
            var shengName = '', sheng;
            if (shengValue) {
                for (var i = 0, count = provinceCityData.provinces.length; i < count; i++) {
                    sheng = provinceCityData.provinces[i];
                    if (shengValue == sheng[0]) {
                        shengName = sheng[1] + '(' + sheng[0] + ')';
                        break;
                    }
                }
            }
            return shengName;
        }

        // 根据省代码和市代码获取市名称
        function getShiName(shengValue, shiValue) {
            var shiData = provinceCityData.cities[shengValue], shi, shiName = '';
            if (shiData) {
                for (var i = 0, count = shiData.length; i < count; i++) {
                    shi = shiData[i];
                    if (shiValue == shi[0]) {
                        shiName = shi[1] + '(' + shi[0] + ')';
                        break;
                    }
                }
            }
            return shiName;
        }

        // 页面加载完毕
        F.ready(function () {
            F.ui.ddlSheng.loadData(provinceCityData.provinces);
        });

        // 单元格编辑前
        function onGrid1BeforeEdit(event, value, params) {
            var grid1 = F.ui.Grid1;

            if (params.columnId === 'Shi') {
                var ddlShi = F.ui.ddlShi;

                var sheng = grid1.getCellValue(params.rowId, 'Sheng');

                var shidata = provinceCityData.cities[sheng];
                if (shidata) {
                    ddlShi.enable();
                    ddlShi.setEmptyText('');
                    ddlShi.loadData(shidata);
                } else {
                    ddlShi.setEmptyText('请先选择省！');
                    ddlShi.disable();
                }
            }
        }

        // 单元格编辑后
        function onGrid1AfterEdit(event, value, params) {
            var grid1 = F.ui.Grid1;

            if (params.columnId === 'Sheng') {
                var shidata = provinceCityData.cities[value];
                if (shidata) {
                    var shi = grid1.getCellValue(params.rowId, 'Shi');
                    // 如果结束编辑时，市 不属于 当前 省，则清空 市
                    if ($.inArray(shi, shidata) < 0) {
                        // 用 ColumnID 到新值的对象更新单元格，单列和多列采用同一种写法。
                        // https://fineui.com/js/api/FineUI.Grid.html#updateCellValue
                        grid1.updateCellValue(params.rowId, { Shi: '' });
                    }
                }
            }
        }

    </script>
}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>省市单元格只保存代码，由浏览器按省市数据查找并显示对应名称。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>对照显示名称与实际代码</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（单击编辑）">表格（单击编辑）</strong>编辑<strong>所在省</strong>与<strong><strong>所在市</strong></strong>，选择有效的省市后结束编辑。<br />结果：单元格显示省市名称，实际值仍为稳定代码；城市名称使用同一行的省代码参与查找，不把不同省的同名代码混用。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <ul>
            <li>
                如果未设置省份，则<strong>所在市</strong>下拉列表禁用，并且显示提示信息 - 请先选择省！
            </li>
            <li>
                选择省份后，<strong>所在市</strong>下拉列表数据动态加载
            </li>
            <li>
                更改省份后，如果所在<strong>所在市</strong>不属于当前省份，则清空<strong>所在市</strong>
            </li>
            <li>
                省市单元格保存的值是代码，而非名称
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>RendererFunction</code>（<strong>所在省、所在市列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（单击编辑）">表格（单击编辑）</strong>）：省从省列表查名称，市按当前行省代码查对应城市列表，再用市代码查名称。</li>
        </ul>
    </section>
}
