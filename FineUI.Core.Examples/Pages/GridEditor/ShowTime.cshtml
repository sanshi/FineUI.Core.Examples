@page
@model FineUI.Core.Examples.Pages.GridEditor.ShowTimeModel
@{
    ViewBag.Title = "GridEditor/ShowTime";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（单击编辑）" DataIDField="Id" DataTextField="Name" AllowCellEditing="true" ClicksToEdit="1">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender">
                <Editor>
                    <f:DropDownList ID="ddlGender" Required="true">
                        <f:ListItem Text="男" Value="1"></f:ListItem>
                        <f:ListItem Text="女" Value="0"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学年份" ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int">
                <Editor>
                    <f:NumberBox ID="nbxEntranceYear" NoDecimal="true" NoNegative="true" MinValue="2000" MaxValue="2025"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd HH:mm:ss" Width="200">
                <Editor>
                    <f:DatePicker ID="dpEntranceDate" Required="true" DateFormatString="yyyy-MM-dd HH:mm:ss" ShowTime="true"></f:DatePicker>
                </Editor>
            </f:RenderField>
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool" DataField="AtSchool" />
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" ExpandUnusedSpace="true" MinWidth="150">
                <Editor>
                    <f:TextBox ID="tbxMajor" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField Width="180" ColumnID="LogTime" DataField="LogTime" FieldType="Date"
                           Renderer="Date" RendererArgument="yyyy-MM-dd HH:mm:ss" HeaderText="注册日期">
            </f:RenderField>
        </Columns>
    </f:Grid>
    <br>

    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>

    <br>
    为了正确的显示和编辑时间，请注意如下属性：


}

@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>在单元格日期编辑器中同时选择日期和时间，显示精度保留到秒。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>修改日期与时间</h3>
    <ul>
        <li>单击<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>的<strong>入学日期</strong>，同时调整日期与时间，再结束编辑。<br />结果：单元格按年月日、时分秒显示结果；重新进入编辑时可继续调整同样精度的时间。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <ul>
        <li><strong>入学日期</strong>列（RenderField）：FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd HH:mm:ss"</li>
        <li><strong><strong>入学日期</strong></strong>的编辑表单字段（DatePicker）：DateFormatString="yyyy-MM-dd HH:mm:ss" ShowTime="true"</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>ShowTime</code>（<strong class="example-control-reference" data-example-control="dpEntranceDate" title="入学日期列的日期选择框">入学日期列的日期选择框</strong>）：初始为 <code>true</code>，在日期弹层中显示时间选择区。</li>
        <li><code>DateFormatString</code>（<strong class="example-control-reference" data-example-control="dpEntranceDate" title="入学日期列的日期选择框">入学日期列的日期选择框</strong>）：初始为 <code>yyyy-MM-dd HH:mm:ss</code>，编辑器按本页格式读取与回显完整日期时间。</li>
        <li><code>RendererArgument</code>（<strong>入学日期</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>）：初始为 <code>yyyy-MM-dd HH:mm:ss</code>，单元格采用与编辑器一致的日期时间显示精度。</li>
    </ul>
</section>
}
