@page
@model FineUI.Core.Examples.Pages.GridEditor.GridEditorProgressModel
@{
    ViewBag.Title = "GridEditor/GridEditorProgress";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" AllowCellEditing="true" ClicksToEdit="1">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender">
                <Editor>
                    <f:DropDownList ID="ddlGender" Required="true">
                        <f:ListItem Text="男" Value="1"></f:ListItem>
                        <f:ListItem Text="女" Value="0"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField Width="200" ColumnID="Progress1" DataField="Progress1" FieldType="Int" HeaderText="进度条1" RendererFunction="renderProgress1" />
            <f:RenderField Width="200" ColumnID="Progress2" DataField="Progress2" FieldType="Int" HeaderText="进度条2" RendererFunction="renderProgress2" />
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" ExpandUnusedSpace="true" MinWidth="150">
                <Editor>
                    <f:TextBox ID="tbxMajor" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
        </Columns>
    </f:Grid>
    <br />
    <f:Button ID="Button1" Text="[进度条1]加5%" MarginRight="5" ClickHandler="onIncreaseProgressClick">
    </f:Button>
    <f:Button ID="Button3" Text="[进度条1]减5%" ClickHandler="onDecreaseProgressClick">
    </f:Button>
    <br />
    <br />
    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>



}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderProgress1(value) {
            return F.progressHtml(value, {
                textVisible: true
            });
        }

        function renderProgress2(value) {
            return F.progressHtml(value, {
                height: 15,
                textVisible: true,
                textInside: true
            });
        }


        function changeProgress1(increment) {
            var grid1 = F.ui.Grid1;
            grid1.getRowEls().each(function () {
                var rowEl = $(this);
                var progressEl = rowEl.find('.f-grid-cell-Progress1 .f-progressbar-outer');
                var progressValue = parseInt(progressEl.attr('data-progressvalue'));

                progressValue += increment;

                if (progressValue > 100) {
                    progressValue = 100;
                } else if (progressValue < 0) {
                    progressValue = 0;
                }

                grid1.updateCellValue(rowEl, 'Progress1', progressValue);
            });
        }

        function onIncreaseProgressClick(event) {
            changeProgress1(5);
        }

        function onDecreaseProgressClick(event) {
            changeProgress1(-5);
        }

    </script>

}