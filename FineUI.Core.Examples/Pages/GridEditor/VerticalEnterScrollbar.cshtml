@page
@model FineUI.Core.Examples.Pages.GridEditor.VerticalEnterScrollbarModel
@{
    ViewBag.Title = "GridEditor/VerticalEnterScrollbar";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" Height="300" ShowBorder="true" ShowHeader="true" Title="表格（单击编辑）" DataIDField="Id" DataTextField="Name" AllowCellEditing="true" ClicksToEdit="1" TabVerticalNavigate="true" EnterSameAsTab="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender">
                <Editor>
                    <f:DropDownList ID="ddlGender" Required="true">
                        <f:ListItem Text="男" Value="1"></f:ListItem>
                        <f:ListItem Text="女" Value="0"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学年份" ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int">
                <Editor>
                    <f:NumberBox ID="nbxEntranceYear" NoDecimal="true" NoNegative="true" MinValue="2000" MaxValue="2025"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" Width="150">
                <Editor>
                    <f:DatePicker ID="dpEntranceDate" Required="true"></f:DatePicker>
                </Editor>
            </f:RenderField>
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool" DataField="AtSchool" />
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" ExpandUnusedSpace="true" MinWidth="150">
                <Editor>
                    <f:TextBox ID="tbxMajor" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
        </Columns>
    </f:Grid>

    <br>
    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>

    <br>
    快捷键说明：


}

@section script {

    <script src="~/res/js/grid.js"></script>

}


@section exampleDescription {
<section aria-label="页面描述">
    <p>在固定高度的表格中持续纵向编辑，目标行超出可见范围时自动滚动到该行。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>连续回车并跟随目标行</h3>
    <ul>
        <li>从<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>靠前记录的<strong>姓名</strong>开始编辑，连续按 Enter，直到目标行原本位于视口下方。<br />结果：编辑位置沿同列向下移动；表格内部自动滚动，使新目标和编辑器保持可见，表头仍留在上方。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <p>非编辑状态可用方向键移动单元格；Enter 进入编辑，ESC 取消当前编辑。Shift 与导航键组合时按相反方向移动。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>TabVerticalNavigate</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>）：初始为 <code>true</code>，按同列上下行选择导航目标。</li>
        <li><code>EnterSameAsTab</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>）：初始为 <code>true</code>，Enter 沿用纵向 Tab 规则。</li>
        <li><code>Height</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>）：初始为 <code>300</code>，限定表格可视高度，使更多记录通过内部滚动查看。</li>
    </ul>
</section>
}
