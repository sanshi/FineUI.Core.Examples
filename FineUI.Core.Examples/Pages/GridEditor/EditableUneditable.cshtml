@page
@model FineUI.Core.Examples.Pages.GridEditor.EditableUneditableModel
@{
    ViewBag.Title = "GridEditor/EditableUneditable";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（单击编辑）" DataIDField="Id" DataTextField="Name" AllowCellEditing="true" ClicksToEdit="1">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender">
                <Editor>
                    <f:DropDownList ID="ddlGender" Required="true">
                        <f:ListItem Text="男" Value="1"></f:ListItem>
                        <f:ListItem Text="女" Value="0"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学年份" ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int">
                <Editor>
                    <f:NumberBox ID="nbxEntranceYear" NoDecimal="true" NoNegative="true" MinValue="2000" MaxValue="2025"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" Width="150">
                <Editor>
                    <f:DatePicker ID="dpEntranceDate" Required="true"></f:DatePicker>
                </Editor>
            </f:RenderField>
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool" DataField="AtSchool" />
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" ExpandUnusedSpace="true" MinWidth="150" EnableColumnEdit="false">
                <Editor>
                    <f:TextBox ID="tbxMajor" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
        </Columns>
        <Listeners>
            <f:Listener Event="dataload" Handler="onGrid1DataLoad"></f:Listener>
        </Listeners>
    </f:Grid>

    <br>
    <f:Button ID="btnChangeEntranceDateEditable" Text="切换[入学日期]列的可编辑状态" CssClass="marginr" ClickHandler="onChangeEntranceDateEditableClick"></f:Button>
    <f:Button ID="btnChangeAtSchoolEditable" Text="切换[是否在校]列的可编辑状态" CssClass="marginr" ClickHandler="onChangeAtSchoolEditableClick"></f:Button>
    <f:Button ID="btnChangeMajorEditable" Text="切换[所学专业]列的可编辑状态" CssClass="marginr" ClickHandler="onChangeMajorEditableClick"></f:Button>

    <br>
    <br>
    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>

    <br>


}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onGrid1DataLoad(event) {
            var grid = this;

            // 对于指定的列，如果不可编辑，则增加 f-grid-cell-uneditable 样式类
            grid.bodyEl.find('.f-grid-cell-EntranceDate, .f-grid-cell-AtSchool, .f-grid-cell-Major').each(function () {
                var cellEl = $(this);

                if (!cellEl.hasClass('f-grid-cell-editable')) {
                    cellEl.addClass('f-grid-cell-uneditable');
                }
            });
        }


        function onChangeEntranceDateEditableClick(event) {
            var column = F.ui.Grid1.getColumn('EntranceDate');
            column.toggleEditable();
        }

        function onChangeAtSchoolEditableClick(event) {
            var column = F.ui.Grid1.getColumn('AtSchool');
            column.toggleEditable();
        }

        function onChangeMajorEditableClick(event) {
            var column = F.ui.Grid1.getColumn('Major');
            column.toggleEditable();
        }

    </script>
}
@section exampleDescription {
<section aria-label="页面描述">
    <p>在浏览器中切换指定列的可编辑状态，用灰色单元格标出当前禁止编辑的列。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>切换入学日期列</h3>
    <ul>
        <li>先尝试编辑<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>的<strong>入学日期</strong>，点击<strong class="example-control-reference" data-example-control="btnChangeEntranceDateEditable" title="切换[入学日期]列的可编辑状态">切换[入学日期]列的可编辑状态</strong>后再次尝试。<br />结果：脚本立即切换列状态，该列在可编辑与禁止编辑之间切换；再点一次恢复先前状态。禁止编辑的位置同时使用灰色外观。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>切换是否在校列</h3>
    <ul>
        <li>先尝试编辑<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>的<strong>是否在校</strong>，点击<strong class="example-control-reference" data-example-control="btnChangeAtSchoolEditable" title="切换[是否在校]列的可编辑状态">切换[是否在校]列的可编辑状态</strong>后再次尝试。<br />结果：脚本立即切换列状态，该列在可编辑与禁止编辑之间切换；再点一次恢复先前状态。禁止编辑的位置同时使用灰色外观。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>切换所学专业列</h3>
    <ul>
        <li>先尝试编辑<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>的<strong>所学专业</strong>，点击<strong class="example-control-reference" data-example-control="btnChangeMajorEditable" title="切换[所学专业]列的可编辑状态">切换[所学专业]列的可编辑状态</strong>后再次尝试。<br />结果：脚本立即切换列状态，该列在可编辑与禁止编辑之间切换；再点一次恢复先前状态。禁止编辑的位置同时使用灰色外观。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableColumnEdit</code>（<strong>所学专业</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>）：初始为 <code>false</code>，控制该列是否接受编辑；本页按钮切换这个状态。</li>
        <li><code>toggleEditable</code>（<strong>页面脚本中的目标列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>）：从表格取得指定列后切换编辑状态，不需要重新绑定所有记录。</li>
    </ul>
</section>
}
