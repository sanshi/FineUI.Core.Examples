@page
@model FineUI.Core.Examples.Pages.GridEditor.EditableCellAfterEditModel
@{
    ViewBag.Title = "GridEditor/EditableCellAfterEdit";
    var F = Html.F();
}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（单击编辑）" DataIDField="Id" DataTextField="Name" AllowCellEditing="true" ClicksToEdit="1">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender">
                <Editor>
                    <f:DropDownList ID="ddlGender" Required="true">
                        <f:ListItem Text="男" Value="1"></f:ListItem>
                        <f:ListItem Text="女" Value="0"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学年份" ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int">
                <Editor>
                    <f:NumberBox ID="nbxEntranceYear" NoDecimal="true" NoNegative="true" MinValue="2000" MaxValue="2025"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" Width="150">
                <Editor>
                    <f:DatePicker ID="dpEntranceDate" Required="true"></f:DatePicker>
                </Editor>
            </f:RenderField>
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool" DataField="AtSchool" />
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" ExpandUnusedSpace="true" MinWidth="150" RendererFunction="renderMajor">
                <Editor>
                    <f:TextBox ID="tbxMajor" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
        </Columns>
        <Tools>
            <f:Tool IconFont="_Refresh" ToolTip="Refresh" ClickHandler="onRefreshToolClick"></f:Tool>
        </Tools>
        <Listeners>
            <f:Listener Event="afteredit" Handler="onGrid1AfterEdit"></f:Listener>
        </Listeners>
    </f:Grid>

    <br>
    <br>
    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>

    <br>
    <br />
    <br />
    注：修改[是否在校]会同时改变[所学专业]单元格的可编辑状态。

}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderMajor(value, params) {
            if (!params.rowData.values.AtSchool) {
                params.cellCls = 'f-grid-cell-uneditable';
            }

            return value;
        }


        function onGrid1AfterEdit(event, value, params) {
            var grid1 = this, rowId = params.rowId, columnId = params.columnId;

            if (columnId === 'AtSchool') {
                if (!value) {
                    grid1.updateCellValue(rowId, 'Major.cls', 'f-grid-cell-uneditable');
                } else {
                    grid1.updateCellValue(rowId, 'Major.cls', '');
                }
            }
        }

        function onRefreshToolClick(event) {
            F.ui.Grid1.loadData();
        }

    </script>
}
