@page
@model FineUI.Core.Examples.Pages.GridEditor.RenderFunctionParamsModel
@{
    ViewBag.Title = "GridEditor/RenderFunctionParams";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（单击编辑）" DataIDField="Id" DataTextField="Name" AllowCellEditing="true" ClicksToEdit="1">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender">
                <Editor>
                    <f:DropDownList ID="ddlGender" Required="true">
                        <f:ListItem Text="男" Value="1"></f:ListItem>
                        <f:ListItem Text="女" Value="0"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学年份" ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int">
                <Editor>
                    <f:NumberBox ID="nbxEntranceYear" NoDecimal="true" NoNegative="true" MinValue="2000" MaxValue="2025"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" Width="150">
                <Editor>
                    <f:DatePicker ID="dpEntranceDate" Required="true"></f:DatePicker>
                </Editor>
            </f:RenderField>
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool" DataField="AtSchool" />
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" ExpandUnusedSpace="true" MinWidth="150">
                <Editor>
                    <f:DropDownList ID="ddlMajor" Required="true">
                        <f:ListItem Text="材料科学与工程系" Value="材料科学与工程系"></f:ListItem>
                        <f:ListItem Text="化学系" Value="化学系"></f:ListItem>
                        <f:ListItem Text="数学系" Value="数学系"></f:ListItem>
                        <f:ListItem Text="物理系" Value="物理系"></f:ListItem>
                        <f:ListItem Text="自动化系" Value="自动化系"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="工资（整数）" ColumnID="SalaryInteger" DataField="Salary" FieldType="Int" RendererFunction="renderSalary(0)" TextAlign="Right" Width="150">
                <Editor>
                    <f:NumberBox EnableCommas="true" NoDecimal="true" Required="true"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="工资（两位小数）" ColumnID="SalaryDecimal" DataField="Salary" FieldType="Float" RendererFunction="renderSalary(2)" TextAlign="Right" Width="150">
                <Editor>
                    <f:NumberBox EnableCommas="true" DecimalPrecision="2" TrimEndZero="false" Required="true"></f:NumberBox>
                </Editor>
            </f:RenderField>
        </Columns>
    </f:Grid>

    <br>
    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>


}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderGender(value) {
            return F.ui.ddlGender.getTextByValue(value);
        }

        function renderMajor(value) {
            return F.ui.ddlMajor.getTextByValue(value);
        }

        function renderSalary(decimalNumber) {
            // 返回函数体，创建一个闭包，在函数体内部可以调用外部变量 - decimalNumber
            return function (value) {
                if (decimalNumber === 0) {
                    value = parseInt(value, 10);
                } else {
                    value = value.toFixed(decimalNumber);
                }
                return F.addCommas(value);
            };
        }

    </script>
}

