@page
@model FineUI.Core.Examples.Pages.GridEditor.DecimalModel
@{
    ViewBag.Title = "GridEditor/Decimal";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（单击编辑）" DataIDField="Id" DataTextField="Name" AllowCellEditing="true" ClicksToEdit="1">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender">
                <Editor>
                    <f:DropDownList ID="ddlGender" Required="true">
                        <f:ListItem Text="男" Value="1"></f:ListItem>
                        <f:ListItem Text="女" Value="0"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" ExpandUnusedSpace="true" MinWidth="150">
                <Editor>
                    <f:TextBox ID="tbxMajor" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="语文成绩" ColumnID="ChineseScore" DataField="ChineseScore" FieldType="Float">
                <Editor>
                    <f:NumberBox ID="nbChineseScore" NoDecimal="false" NoNegative="true"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="数学成绩" ColumnID="MathScore" DataField="MathScore" FieldType="Float">
                <Editor>
                    <f:NumberBox ID="nbMathScore" NoDecimal="false" NoNegative="true"></f:NumberBox>
                </Editor>
            </f:RenderField>
        </Columns>
    </f:Grid>
    <br>

    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>

    <br>
    注：
    <ul>
        <li>成绩可以为小数</li>
        <li>默认[刘国]和[康颖颖]的成绩未定义（DBNull.Value）</li>
    </ul>

}

@section script {

    <script src="~/res/js/grid.js"></script>

}