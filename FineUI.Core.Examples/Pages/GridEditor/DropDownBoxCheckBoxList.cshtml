@page
@model FineUI.Core.Examples.Pages.GridEditor.DropDownBoxCheckBoxListModel
@{
    ViewBag.Title = "GridEditor/DropDownBoxCheckBoxList";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（单击编辑）" DataIDField="Id" DataTextField="Name" AllowCellEditing="true"
        ClicksToEdit="1">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender">
                <Editor>
                    <f:DropDownList ID="ddlGender" Required="true">
                        <f:ListItem Text="男" Value="1"></f:ListItem>
                        <f:ListItem Text="女" Value="0"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学年份" ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int">
                <Editor>
                    <f:NumberBox ID="nbxEntranceYear" NoDecimal="true" NoNegative="true" MinValue="2000" MaxValue="2025"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd"
                Width="150">
                <Editor>
                    <f:DatePicker ID="dpEntranceDate" Required="true"></f:DatePicker>
                </Editor>
            </f:RenderField>
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool" DataField="AtSchool" />
            <f:RenderField HeaderText="兴趣爱好" ColumnID="Hobby" DataField="Hobby" ExpandUnusedSpace="true" MinWidth="150" RendererFunction="renderHobby">
                <Editor>
                    <f:DropDownBox ID="DropDownBoxExample1" DataControlID="cblHobby" EmptyText="请选择" EnableMultiSelect="true" AutoShowClearIcon="true"
                        TopSpaceFirst="true">
                        <PopPanel>
                            <f:SimpleForm BodyPadding="10" AutoScroll="true" ShowBorder="true" ShowHeader="false" Hidden="true">
                                <Items>
                                    <f:CheckBoxList ID="cblHobby" ColumnNumber="3">
                                        <f:CheckItem Text="读书" Value="reading" />
                                        <f:CheckItem Text="篮球" Value="basketball" />
                                        <f:CheckItem Text="旅游" Value="travel" />
                                        <f:CheckItem Text="电影" Value="movie" />
                                        <f:CheckItem Text="音乐" Value="music" />
                                    </f:CheckBoxList>
                                </Items>
                            </f:SimpleForm>
                        </PopPanel>
                    </f:DropDownBox>
                </Editor>
            </f:RenderField>
        </Columns>
    </f:Grid>

    <br>
    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>

    <br />


}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderHobby(value) {
            if (!value) {
                return '';
            }

            // 兴趣爱好下拉列表的实例
            var cblHobby = F.ui.cblHobby;

            var hobbies = value.split(',');

            return $.map(hobbies, function (hobby, index) {
                return cblHobby.getTextByValue(hobby);
            }).join(', ');
        }

    </script>
}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>把下拉复选框列表嵌入单元格编辑器，一次编辑多项兴趣。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>在弹出内容中多选</h3>
        <ol>
            <li>打开<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（单击编辑）">表格（单击编辑）</strong>的<strong>兴趣爱好</strong>编辑器，在弹出的复选框列表中选中两项，再结束编辑。<br />结果：单元格显示所选兴趣名称，实际值保留对应代码集合；不把名称和选项代码混为同一个字段。</li>
            <li>再次进入同一<strong>兴趣爱好</strong>单元格。<br />结果：编辑器恢复刚才的选择，可继续增减选项。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：[兴趣爱好]列的编辑器属性TopSpaceFirst=true，优先在上部空间显示弹出框。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableMultiSelect</code>（<strong class="example-control-reference" data-example-control="DropDownBoxExample1"
                    title="兴趣爱好列的下拉框">兴趣爱好列的下拉框</strong>）：初始为 <code>true</code>，允许下拉编辑器保留多项值。</li>
            <li><code>PopPanel</code>（<strong class="example-control-reference" data-example-control="DropDownBoxExample1"
                    title="兴趣爱好列的下拉框">兴趣爱好列的下拉框</strong>）：弹出内容由本页的复选框列表或表格提供，取其中的值与文字作为单元格编辑结果。</li>
        </ul>
    </section>
}
