@page
@model FineUI.Core.Examples.Pages.GridEditor.RenderFunctionModel
@{
    ViewBag.Title = "GridEditor/RenderFunction";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（单击编辑）" DataIDField="Id" DataTextField="Name" AllowCellEditing="true"
        ClicksToEdit="1">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender">
                <Editor>
                    <f:DropDownList ID="ddlGender" Required="true">
                        <f:ListItem Text="男" Value="1"></f:ListItem>
                        <f:ListItem Text="女" Value="0"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学年份" ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int">
                <Editor>
                    <f:NumberBox ID="nbxEntranceYear" NoDecimal="true" NoNegative="true" MinValue="2000" MaxValue="2025"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd"
                Width="150">
                <Editor>
                    <f:DatePicker ID="dpEntranceDate" Required="true"></f:DatePicker>
                </Editor>
            </f:RenderField>
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool" DataField="AtSchool" />
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" ExpandUnusedSpace="true" MinWidth="150">
                <Editor>
                    <f:DropDownList ID="ddlMajor" Required="true">
                        <f:ListItem Text="材料科学与工程系" Value="材料科学与工程系"></f:ListItem>
                        <f:ListItem Text="化学系" Value="化学系"></f:ListItem>
                        <f:ListItem Text="数学系" Value="数学系"></f:ListItem>
                        <f:ListItem Text="物理系" Value="物理系"></f:ListItem>
                        <f:ListItem Text="自动化系" Value="自动化系"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="工资" ColumnID="Salary" DataField="Salary" FieldType="Float" RendererFunction="renderSalary" Width="150">
                <Editor>
                    <f:NumberBox EnableCommas="true" DecimalPrecision="2" TrimEndZero="false" Required="true"></f:NumberBox>
                </Editor>
            </f:RenderField>
        </Columns>
    </f:Grid>

    <br>
    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>


}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderGender(value) {
            return F.ui.ddlGender.getTextByValue(value);
        }

        function renderMajor(value) {
            return F.ui.ddlMajor.getTextByValue(value);
        }

        function renderSalary(value) {
            return F.addCommas(value.toFixed(2));
        }

    </script>
}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>把编辑后的性别、专业代码转换为名称，并按两位小数和千分位显示工资。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>编辑后按列格式重新显示</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（单击编辑）">表格（单击编辑）</strong>修改<strong>性别</strong>或<strong>所学专业</strong>，再把<strong>工资</strong>输入为<code>12345.6</code>并结束编辑。<br />结果：下拉列显示所选项的文字，<strong>工资</strong>显示为
                12,345.60；渲染后的显示文字与单元格保留的实际值分开。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>RendererFunction</code>（<strong>性别、所学专业及工资列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（单击编辑）">表格（单击编辑）</strong>）：下拉列按值查文字，<strong>工资</strong>列使用固定两位小数再添加千分位，不把格式化字符串直接当作输入数值。</li>
        </ul>
    </section>
}
