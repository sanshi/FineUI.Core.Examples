@page
@model FineUI.Core.Examples.Pages.GridEditor.UpdateCellValueHiddenColumnModel
@{
    ViewBag.Title = "GridEditor/UpdateCellValueHiddenColumn";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（单击编辑）" DataIDField="Id" DataTextField="Name" AllowCellEditing="true"
        ClicksToEdit="1">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender">
                <Editor>
                    <f:DropDownList ID="ddlGender" Required="true">
                        <f:ListItem Text="男" Value="1"></f:ListItem>
                        <f:ListItem Text="女" Value="0"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学年份" ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int" Hidden="true">
                <Editor>
                    <f:NumberBox ID="nbxEntranceYear" NoDecimal="true" NoNegative="true" MinValue="2000" MaxValue="2025"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd"
                Width="150">
                <Editor>
                    <f:DatePicker ID="dpEntranceDate" Required="true"></f:DatePicker>
                </Editor>
            </f:RenderField>
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool" DataField="AtSchool" />
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" ExpandUnusedSpace="true" MinWidth="150">
                <Editor>
                    <f:TextBox ID="tbxMajor" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
        </Columns>
    </f:Grid>

    <br>
    <f:Button ID="Button1" Text="将全部[入学年份]加一" CssClass="marginr" ClickHandler="onButton1Click"></f:Button>

    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>

    <br>


}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onButton1Click(event) {
            var grid1 = F.ui.Grid1;

            var msg = [];
            grid1.getRowEls().each(function () {
                var rowEl = $(this);
                var entranceYear = grid1.getCellValue(rowEl, 'EntranceYear');
                var userName = grid1.getCellValue(rowEl, 'Name');

                // 用 ColumnID 到新值的对象更新单元格，单列和多列采用同一种写法。
                // https://fineui.com/js/api/FineUI.Grid.html#updateCellValue
                grid1.updateCellValue(rowEl, { EntranceYear: entranceYear + 1 });

                msg.push('[' + userName + ']的入学年份：' + entranceYear + ' -> ' + (entranceYear + 1));
            });


            showNotify(msg.join('<br>'));
        }

    </script>
}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>不显示入学年份列时仍更新其数据，并用提示核对隐藏列更新前后的值。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>更新没有显示出来的列</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="Button1"
                    title="将全部[入学年份]加一">将全部[入学年份]加一</strong>。<br />结果：浏览器遍历记录，把隐藏的<strong>入学年份</strong>逐行加 1；提示列出更新前后的年份，表头仍不出现这列。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <ul>
            <li>页面加载时[<strong>入学年份</strong>]列处于隐藏状态</li>
            <li>保持[<strong>入学年份</strong>]列的隐藏状态，点击第一个更新按钮，然后点击[保存数据]按钮</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>updateCellValue</code>（<strong>入学年份列</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（单击编辑）">表格（单击编辑）</strong>）：按列标识更新数据，与该列当前是否可见无关。</li>
            <li><code>Hidden</code>（<strong>入学年份列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（单击编辑）">表格（单击编辑）</strong>）：初始为 <code>true</code>，隐藏列头与单元格，不删除行中的年份字段。</li>
        </ul>
    </section>
}
