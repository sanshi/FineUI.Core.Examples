@page
@model FineUI.Core.Examples.Pages.GridEditor.DropDownListNoForceSelectionModel
@{
    ViewBag.Title = "GridEditor/DropDownListNoForceSelection";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（单击编辑）" DataIDField="Id" DataTextField="Name" AllowCellEditing="true"
        ClicksToEdit="1">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender">
                <Editor>
                    <f:DropDownList ID="ddlGender" Required="true">
                        <f:ListItem Text="男" Value="1"></f:ListItem>
                        <f:ListItem Text="女" Value="0"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学年份" ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int">
                <Editor>
                    <f:NumberBox ID="nbxEntranceYear" NoDecimal="true" NoNegative="true" MinValue="2000" MaxValue="2025"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd"
                Width="150">
                <Editor>
                    <f:DatePicker ID="dpEntranceDate" Required="true"></f:DatePicker>
                </Editor>
            </f:RenderField>
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool" DataField="AtSchool" />
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" ExpandUnusedSpace="true" MinWidth="150" RendererFunction="renderMajor">
                <Editor>
                    <f:DropDownList ID="ddlMajor" Required="true" EnableEdit="true" ForceSelection="false">
                        <f:ListItem Text="材料科学与工程系" Value="材料科学与工程系"></f:ListItem>
                        <f:ListItem Text="化学系" Value="化学系"></f:ListItem>
                        <f:ListItem Text="数学系" Value="数学系"></f:ListItem>
                        <f:ListItem Text="物理系" Value="物理系"></f:ListItem>
                        <f:ListItem Text="自动化系" Value="自动化系"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
        </Columns>
    </f:Grid>

    <br>
    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>

}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderMajor(value) {
            return F.ui.ddlMajor.getTextByValue(value);
        }

    </script>
}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>允许专业下拉编辑器接收列表以外的输入，不强制用户只能选择已有专业。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>输入不存在于列表中的专业</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（单击编辑）">表格（单击编辑）</strong>打开<strong>所学专业</strong>编辑器，直接输入<code>新的专业名称</code>并结束编辑。<br />结果：输入文字保留为该单元格的新值，不会因为没有同名选项而退回旧值；已有选项仍可直接选择。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ForceSelection</code>（<strong class="example-control-reference" data-example-control="ddlMajor"
                    title="所学专业列的下拉列表">所学专业列的下拉列表</strong>）：初始为 <code>false</code>，允许把用户输入的文字作为单元格值。</li>
        </ul>
    </section>
}
