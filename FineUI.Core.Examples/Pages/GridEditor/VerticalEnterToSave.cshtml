@page
@model FineUI.Core.Examples.Pages.GridEditor.VerticalEnterToSaveModel
@{
    ViewBag.Title = "GridEditor/VerticalEnterToSave";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（单击编辑）" DataIDField="Id" DataTextField="Name" AllowCellEditing="true" ClicksToEdit="1" TabVerticalNavigate="false" EnterSameAsTab="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender">
                <Editor>
                    <f:DropDownList ID="ddlGender" Required="true">
                        <f:ListItem Text="男" Value="1"></f:ListItem>
                        <f:ListItem Text="女" Value="0"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学年份" ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int">
                <Editor>
                    <f:NumberBox ID="nbxEntranceYear" NoDecimal="true" NoNegative="true" MinValue="2000" MaxValue="2025"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" Width="150">
                <Editor>
                    <f:DatePicker ID="dpEntranceDate" Required="true"></f:DatePicker>
                </Editor>
            </f:RenderField>
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool" DataField="AtSchool" />
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" ExpandUnusedSpace="true" MinWidth="150">
                <Editor>
                    <f:TextBox ID="tbxMajor" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
        </Columns>
        <Listeners>
            <f:Listener Event="beforetabedit" Handler="onGridBeforeTabEdit"></f:Listener>
        </Listeners>
    </f:Grid>

    <br>
    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>

    <br>
    快捷键说明：


}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onGridBeforeTabEdit(event, params) {
            // 如果当前列是[所学专业]列，并且 TAB键 要跳转到的单元格为空（也就是当前位于表格的最后一个单元格）
            if (params.columnId === 'Major' && !params.nextTd.length) {
                // 点击保存按钮
                F.ui.btnSubmit.click();

                // 阻止 TAB键 跳转
                return false;
            }
        }

    </script>
}


@section exampleDescription {
<section aria-label="页面描述">
    <p>通过 Enter 与 Tab 横向编辑导航，最后一格没有后续目标时自动点击保存。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>到达最后一格后自动保存</h3>
    <ol>
        <li>编辑<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>一条记录的<strong>姓名</strong>，按 Enter。<br />结果：结束当前编辑后移到同一行的下一列；按键采用当前表格的 Tab 导航方向。</li>
        <li>进入最后一行的<strong>所学专业</strong>，修改内容后按 Enter。<br />结果：导航回调检测到没有下一个单元格，主动点击<strong class="example-control-reference" data-example-control="btnSubmit" title="保存数据">保存数据</strong>；后台读取修改数据、保存到示例数据并重新绑定。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <p>非编辑状态可用方向键移动单元格；Enter 进入编辑，ESC 取消当前编辑。Shift 与导航键组合时按相反方向移动。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>TabVerticalNavigate</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>）：初始为 <code>false</code>，确定 Tab 导航方向，Enter 在本页沿用这个方向。</li>
        <li><code>EnterSameAsTab</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>）：初始为 <code>true</code>，使 Enter 采用与 Tab 相同的导航规则。</li>
        <li><code>beforetabedit</code>（<strong>页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>）：<strong>所学专业</strong>列没有下一个单元格时触发保存，并返回 false 取消继续导航；不是在按 ESC 取消编辑时保存。</li>
    </ul>
</section>
}
