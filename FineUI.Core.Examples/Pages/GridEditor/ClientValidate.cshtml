@page
@model FineUI.Core.Examples.Pages.GridEditor.ClientValidateModel
@{
    ViewBag.Title = "GridEditor/ClientValidate";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（双击编辑）" DataIDField="Id" DataTextField="Name" AllowCellEditing="true"
        ClicksToEdit="2" EnableCheckBoxSelect="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name">
                <Editor>
                    <f:TextBox ID="tbxName"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender">
                <Editor>
                    <f:DropDownList ID="ddlGender" Required="true">
                        <f:ListItem Text="男" Value="1"></f:ListItem>
                        <f:ListItem Text="女" Value="0"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学年份" ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int">
                <Editor>
                    <f:NumberBox ID="nbxEntranceYear" NoDecimal="true" NoNegative="true" MinValue="2000" MaxValue="2025"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd"
                Width="150">
                <Editor>
                    <f:DatePicker ID="dpEntranceDate" Required="true"></f:DatePicker>
                </Editor>
            </f:RenderField>
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool" DataField="AtSchool" />
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" ExpandUnusedSpace="true" MinWidth="150">
                <Editor>
                    <f:TextBox ID="tbxMajor" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField EnableHeaderMenu="false">
                <Commands>
                    <f:Command CommandName="Delete" Icon="Delete" ConfirmText="删除选中行？" ConfirmTarget="Top" />
                </Commands>
            </f:RenderField>
        </Columns>
        <Listeners>
            <f:Listener Event="rowcommand" Handler="onGrid1RowCommand"></f:Listener>
        </Listeners>
        <Toolbars>
            <f:Toolbar>
                <Items>
                    <f:Button ID="btnNew" Text="新增数据" Icon="Add" ClickHandler="onNewClick"></f:Button>
                    <f:Button ID="btnDelete" Text="删除选中行" Icon="Delete" ClickHandler="onDeleteClick"></f:Button>
                    <f:ToolbarFill></f:ToolbarFill>
                    <f:Button ID="btnReset" Text="重置表格数据" ClickHandler="onResetClick"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Grid>

    <br>
    <f:Button ID="btnSubmit" Text="保存数据" ClickHandler="onSubmitClick"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>

    <br>

}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function isValid() {
            var grid1 = F.ui.Grid1;
            var valid = true, modifiedData = grid1.getModifiedData();

            $.each(modifiedData, function (index, rowData) {

                // rowData.id: 行ID
                // rowData.status: 行状态（newadded, modified, deleted）
                // rowData.values: 行中修改单元格对象，比如 { "Name": "刘国2", "Gender": 0, "EntranceYear": 2003 }
                if (rowData.status === 'deleted') {
                    return true; // continue
                }

                var name = rowData.values['Name'];
                // 更改了姓名列，并且为空字符串
                if (typeof (name) != 'undefined' && $.trim(name) == '') {
                    F.alert({
                        message: '姓名不能为空！',
                        ok: function () {
                            grid1.startEdit(rowData.id, 'Name');
                        }
                    });

                    valid = false;

                    return false; // break
                }
            });


            return valid;
        }

        function onSubmitClick(event) {
            var grid1 = F.ui.Grid1;

            // 自定义验证是否通过
            if (!isValid()) {
                return;
            }

            // 触发后台事件
            F.customEvent('Submit_Click');
        }

        function onNewClick(event) {
            var grid1 = F.ui.Grid1;

            // 新增一行（返回新增行的ID）
            var addedRowId = grid1.addNewRecord({
                'Name': '',     // 默认设为空，保存之前会进行判断
                'Gender': '1',
                'EntranceYear': '2015',
                'EntranceDate': '2016-11-15',
                'AtSchool': false,
                'Major': '化学系'
            }, true);

        }

        function onResetClick(event) {
            F.confirm({
                message: '确定要重置表格数据？',
                ok: function () {
                    F.ui.Grid1.rejectChanges();
                }
            });
        }

        function onDeleteClick(event) {
            var grid1 = F.ui.Grid1;
            if (!grid1.hasSelection()) {
                F.alert('没有选中项！');
                return;
            }

            var selectedRows = grid1.getSelectedRows();
            F.confirm({
                message: F.rawHtml('你确定要删除选中的&nbsp;<b>' + selectedRows.length + '</b>&nbsp;行数据吗？'),
                target: '_top',
                ok: function () {
                    grid1.deleteRows(selectedRows);
                }
            });
        }


        // 行命令
        function onGrid1RowCommand(event, rowId, rowIndex, columnId, commandName) {
            if (commandName === 'Delete') {
                F.ui.Grid1.deleteRow(rowId);
            }
        }

        

    </script>
}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>提交前检查本轮新增与修改记录的姓名，空姓名时停止提交并重新进入该单元格。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>验证失败后回到问题单元格</h3>
        <ol>
            <li>点击<strong class="example-control-reference" data-example-control="btnNew"
                    title="新增数据">新增数据</strong>，将新行<strong>姓名</strong>清空并结束编辑。<br />结果：新行暂时保留空<strong>姓名</strong>，等待提交前的统一验证。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnSubmit"
                    title="保存数据">保存数据</strong>。<br />结果：浏览器提示<strong>姓名</strong>不能为空，停止本次保存；关闭提示后重新进入对应<strong>姓名</strong>编辑器。</li>
            <li>填写<strong>姓名</strong><code>新学生</code>并再次保存。<br />结果：验证通过后才提交，后台读取本轮变更并更新示例数据。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>getModifiedData / startEdit</code>（<strong>页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（双击编辑）">表格（双击编辑）</strong>）：检查待保存记录，跳过删除项；<strong>姓名</strong>为空时停止提交，并重新打开该行<strong>姓名</strong>编辑器。</li>
            <li><code>Required / 提交前验证</code>（<strong>姓名编辑器与保存处理</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（双击编辑）">表格（双击编辑）</strong>）：编辑器必填验证用于正在编辑的输入；新增记录尚未逐格编辑时仍可能有空<strong>姓名</strong>，因此提交前还要统一检查待保存数据。</li>
        </ul>
    </section>
}
