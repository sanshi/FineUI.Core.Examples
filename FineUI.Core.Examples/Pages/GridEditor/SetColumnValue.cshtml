@page
@model FineUI.Core.Examples.Pages.GridEditor.SetColumnValueModel
@{
    ViewBag.Title = "GridEditor/SetColumnValue";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（单击编辑）" DataIDField="Id" DataTextField="Name" AllowCellEditing="true" ClicksToEdit="1">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender">
                <Editor>
                    <f:DropDownList ID="ddlGender" Required="true">
                        <f:ListItem Text="男" Value="1"></f:ListItem>
                        <f:ListItem Text="女" Value="0"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学年份" ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int">
                <Editor>
                    <f:NumberBox ID="nbxEntranceYear" NoDecimal="true" NoNegative="true" MinValue="2000" MaxValue="2025"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" Width="150">
                <Editor>
                    <f:DatePicker ID="dpEntranceDate" Required="true"></f:DatePicker>
                </Editor>
            </f:RenderField>
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool" DataField="AtSchool" />
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" ExpandUnusedSpace="true" MinWidth="150">
                <Editor>
                    <f:TextBox ID="tbxMajor" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
        </Columns>
    </f:Grid>

    <br>
    <f:Button CssClass="marginr" ID="btnUpdateEntranceYear" Text="[入学年份]全部更新为2008" ClickHandler="onUpdateEntranceYearClick"></f:Button>

    <f:Button CssClass="marginr" ID="btnUpdateAtSchoolTrue" Text="[是否在校]全部更新为TRUE" ClickHandler="onUpdateAtSchoolTrueClick"></f:Button>

    <f:Button ID="btnUpdateAtSchoolFalse" Text="[是否在校]全部更新为FALSE" ClickHandler="onUpdateAtSchoolFalseClick"></f:Button>

    <br>
    <br>

    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>

}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function resolveRows(columnId, newValue) {
            var grid1 = F.ui.Grid1;
            grid1.getRowEls().each(function () {
                // 列名在运行时确定，用实际 ColumnID 作为对象的键更新对应单元格。
                // https://fineui.com/js/api/FineUI.Grid.html#updateCellValue
                grid1.updateCellValue(this, { [columnId]: newValue });
            });
        }

        function onUpdateEntranceYearClick(event) {
            resolveRows('EntranceYear', 2008);
        }

        function onUpdateAtSchoolTrueClick(event) {
            resolveRows('AtSchool', true);
        }

        function onUpdateAtSchoolFalseClick(event) {
            resolveRows('AtSchool', false);
        }

    </script>
}
@section exampleDescription {
<section aria-label="页面描述">
    <p>一次更新整列的年份或布尔值，让每条记录使用指定的新值。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>批量更新整列</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="btnUpdateEntranceYear" title="[入学年份]全部更新为2008">[入学年份]全部更新为2008</strong>。<br />结果：各行<strong>入学年份</strong>立即变为 2008，并作为本轮修改等待保存。</li>
        <li>分别点击<strong class="example-control-reference" data-example-control="btnUpdateAtSchoolTrue" title="[是否在校]全部更新为TRUE">[是否在校]全部更新为TRUE</strong>与<strong class="example-control-reference" data-example-control="btnUpdateAtSchoolFalse" title="[是否在校]全部更新为FALSE">[是否在校]全部更新为FALSE</strong>。<br />结果：<strong>是否在校</strong>整列依次全部勾选、全部取消，其他列的数据保留。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>getRowEls / updateCellValue</code>（<strong>页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>）：遍历当前记录，分别按 EntranceYear 与 AtSchool 列标识更新；操作在浏览器中完成。</li>
    </ul>
</section>
}
