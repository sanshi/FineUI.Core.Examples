@page
@model FineUI.Core.Examples.Pages.GridEditor.EditableServerModel
@{
    ViewBag.Title = "GridEditor/EditableServer";
    var F = Html.F();
}


@section head {

    <style>
        /* 除了序号列和可编辑列，其他列变灰 */
        .f-grid-cell-text {
            opacity: .5;
            filter: alpha(opacity=50);
        }

        .f-grid-cell-editable .f-grid-cell-text {
            opacity: 1;
            filter: alpha(opacity=100);
        }

        .f-grid-rownumberfield .f-grid-cell-text {
            opacity: 1;
            filter: alpha(opacity=100);
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（单击编辑）" DataIDField="Id" DataTextField="Name" AllowCellEditing="true"
        ClicksToEdit="1">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender">
                <Editor>
                    <f:DropDownList ID="ddlGender" Required="true">
                        <f:ListItem Text="男" Value="1"></f:ListItem>
                        <f:ListItem Text="女" Value="0"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学年份" ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int">
                <Editor>
                    <f:NumberBox ID="nbxEntranceYear" NoDecimal="true" NoNegative="true" MinValue="2000" MaxValue="2025"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd"
                Width="150">
                <Editor>
                    <f:DatePicker ID="dpEntranceDate" Required="true"></f:DatePicker>
                </Editor>
            </f:RenderField>
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool" DataField="AtSchool" />
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" ExpandUnusedSpace="true" MinWidth="150" EnableColumnEdit="false">
                <Editor>
                    <f:TextBox ID="tbxMajor" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
        </Columns>
    </f:Grid>

    <br>
    <f:Button ID="btnChangeEntranceDateEditable" Text="切换[入学日期]列的可编辑状态" CssClass="marginr" OnClick="btnChangeEntranceDateEditable_Click">
    </f:Button>
    <f:Button ID="btnChangeAtSchoolEditable" Text="切换[是否在校]列的可编辑状态" CssClass="marginr" OnClick="btnChangeAtSchoolEditable_Click">
    </f:Button>
    <f:Button ID="btnChangeMajorEditable" Text="切换[所学专业]列的可编辑状态" CssClass="marginr" OnClick="btnChangeMajorEditable_Click">
    </f:Button>

    <br>
    <br>
    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>

    <br>


}

@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>由后台切换指定列的可编辑状态，保留其他列的编辑能力。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>切换入学日期列</h3>
        <ul>
            <li>先尝试编辑<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>的<strong>入学日期</strong>，点击<strong
                    class="example-control-reference" data-example-control="btnChangeEntranceDateEditable"
                    title="切换[入学日期]列的可编辑状态">切换[入学日期]列的可编辑状态</strong>后再次尝试。<br />结果：按钮回发后由后台修改列配置，返回时该列在可编辑与禁止编辑之间切换；再点一次恢复先前状态。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>切换是否在校列</h3>
        <ul>
            <li>先尝试编辑<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>的<strong>是否在校</strong>，点击<strong
                    class="example-control-reference" data-example-control="btnChangeAtSchoolEditable"
                    title="切换[是否在校]列的可编辑状态">切换[是否在校]列的可编辑状态</strong>后再次尝试。<br />结果：按钮回发后由后台修改列配置，返回时该列在可编辑与禁止编辑之间切换；再点一次恢复先前状态。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>切换所学专业列</h3>
        <ul>
            <li>先尝试编辑<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>的<strong>所学专业</strong>，点击<strong
                    class="example-control-reference" data-example-control="btnChangeMajorEditable"
                    title="切换[所学专业]列的可编辑状态">切换[所学专业]列的可编辑状态</strong>后再次尝试。<br />结果：按钮回发后由后台修改列配置，返回时该列在可编辑与禁止编辑之间切换；再点一次恢复先前状态。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableColumnEdit</code>（<strong>所学专业</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（单击编辑）">表格（单击编辑）</strong>）：初始为 <code>false</code>，控制该列是否接受编辑；本页按钮切换这个状态。</li>
        </ul>
    </section>
}
