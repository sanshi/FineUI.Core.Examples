@page
@model FineUI.Core.Examples.Pages.GridEditor.DataChangeModel
@{
    ViewBag.Title = "GridEditor/DataChange";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（双击编辑）" DataIDField="Id" DataTextField="Name" AllowCellEditing="true"
        ClicksToEdit="2" EnableCheckBoxSelect="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="性别" ColumnID="Gender" DataField="Gender" FieldType="Int" RendererFunction="renderGender">
                <Editor>
                    <f:DropDownList ID="ddlGender" Required="true">
                        <f:ListItem Text="男" Value="1"></f:ListItem>
                        <f:ListItem Text="女" Value="0"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学年份" ColumnID="EntranceYear" DataField="EntranceYear" FieldType="Int">
                <Editor>
                    <f:NumberBox ID="nbxEntranceYear" NoDecimal="true" NoNegative="true" MinValue="2000" MaxValue="2025"></f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd"
                Width="150">
                <Editor>
                    <f:DatePicker ID="dpEntranceDate" Required="true"></f:DatePicker>
                </Editor>
            </f:RenderField>
            <f:RenderCheckField HeaderText="是否在校" ColumnID="AtSchool" DataField="AtSchool" />
            <f:RenderField HeaderText="所学专业" ColumnID="Major" DataField="Major" ExpandUnusedSpace="true" MinWidth="150">
                <Editor>
                    <f:TextBox ID="tbxMajor" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField EnableHeaderMenu="false">
                <Commands>
                    <f:Command CommandName="Delete" Icon="Delete" ConfirmText="删除选中行？" ConfirmTarget="Top" />
                </Commands>
            </f:RenderField>
        </Columns>
        <Listeners>
            <f:Listener Event="datachange" Handler="onGrid1DataChange"></f:Listener>
            <f:Listener Event="rowcommand" Handler="onGrid1RowCommand"></f:Listener>
        </Listeners>
        <Toolbars>
            <f:Toolbar>
                <Items>
                    <f:Button ID="btnNew" Text="新增数据" Icon="Add" ClickHandler="onNewClick"></f:Button>
                    <f:Button ID="btnDelete" Text="删除选中行" Icon="Delete" ClickHandler="onDeleteClick"></f:Button>
                    <f:ToolbarFill></f:ToolbarFill>
                    <f:Button ID="btnReset" Text="重置表格数据" ClickHandler="onResetClick"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Grid>

    <br>
    <f:Button CssClass="marginr" ID="btnSubmit" Text="保存数据" Enabled="false" OnClick="btnSubmit_Click"></f:Button>
    <f:Button CssClass="marginr" ID="btnRejectChanges" Text="服务端撤销编辑" ConfirmText="确定要撤销未保存的编辑？" OnClick="btnRejectChanges_Click"></f:Button>
    <f:Button CssClass="marginr" ID="btnReadChanges" Text="读取修改记录" OnClick="btnReadChanges_Click"></f:Button>
    <f:Button ID="btnCommitChanges" Text="仅确认客户端编辑" OnClick="btnCommitChanges_Click"></f:Button>
    <br>
    <f:Button CssClass="marginr" ID="btnUpdateCells" Text="服务端修改 101 行" OnClick="btnUpdateCells_Click"></f:Button>
    <f:Button CssClass="marginr" ID="btnAddRecord" Text="服务端插入第二行" OnClick="btnAddRecord_Click"></f:Button>
    <f:Button CssClass="marginr" ID="btnAppendRecord" Text="服务端追加末行" OnClick="btnAppendRecord_Click"></f:Button>
    <f:Button CssClass="marginr" ID="btnDeleteRow" Text="服务端删除 101 行" OnClick="btnDeleteRow_Click"></f:Button>
    <f:Button CssClass="marginr" ID="btnForceDeleteRow" Text="强制移除 102 行" OnClick="btnForceDeleteRow_Click"></f:Button>
    <f:Button ID="btnDeleteSelected" Text="服务端删除选中行" OnClick="btnDeleteSelected_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>
    <br>
    <br>

}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        // 服务端只发送动作名称和 JSON 参数；具体操作由本页预先定义的函数执行。
        function rejectGridChanges() {
            F.ui.Grid1.rejectChanges();
        }

        function commitGridChanges() {
            F.ui.Grid1.commitChanges();
        }

        function updateGridCells(rowId, values) {
            F.ui.Grid1.updateCellValue(rowId, values);
        }

        function addGridRecord(record, position, editColumn) {
            F.ui.Grid1.addNewRecord(record, position, editColumn);
        }

        function deleteGridRow(rowId, forceUpdate) {
            F.ui.Grid1.deleteRow(rowId, forceUpdate);
        }

        function deleteSelectedGridRows() {
            F.ui.Grid1.deleteSelectedRows();
        }

        function onGrid1DataChange(event) {
            var grid1 = F.ui.Grid1;
            var btnSubmit = F.ui.btnSubmit;

            // 如果没有删除行，没有新增行，没有修改的数据
            if (!grid1.getModifiedData().length) {
                btnSubmit.disable();
            } else {
                btnSubmit.enable();
            }
        }

        function onNewClick(event) {
            var grid1 = F.ui.Grid1;

            // 新增一行（返回新增行的ID）
            var addedRowId = grid1.addNewRecord({
                'Name': '新用户',
                'Gender': '1',
                'EntranceYear': '2015',
                'EntranceDate': '2016-11-15',
                'AtSchool': false,
                'Major': '化学系'
            }, true);

        }

        function onResetClick(event) {
            F.confirm({
                message: '确定要重置表格数据？',
                ok: function () {
                    F.ui.Grid1.rejectChanges();
                }
            });
        }

        function onDeleteClick(event) {
            var grid1 = F.ui.Grid1;
            if (!grid1.hasSelection()) {
                F.alert('没有选中项！');
                return;
            }

            var selectedRows = grid1.getSelectedRows();
            F.confirm({
                message: F.rawHtml('你确定要删除选中的&nbsp;<b>' + selectedRows.length + '</b>&nbsp;行数据吗？'),
                target: '_top',
                ok: function () {
                    grid1.deleteRows(selectedRows);
                }
            });
        }


        // 行命令
        function onGrid1RowCommand(event, rowId, rowIndex, columnId, commandName) {
            if (commandName === 'Delete') {
                F.ui.Grid1.deleteRow(rowId);
            }
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>监听表格数据变化，仅在存在未保存的增删改时启用保存按钮。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>让保存按钮跟随待提交修改</h3>
        <ol>
            <li>从初始状态修改<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（双击编辑）">表格（双击编辑）</strong>一个<strong>姓名</strong>并结束编辑。<br />结果：<strong class="example-control-reference"
                    data-example-control="btnSubmit" title="保存数据">保存数据</strong>从禁用变为可用；新增或删除记录也会使本轮修改非空。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnReset"
                    title="重置表格数据">重置表格数据</strong>并确认，或保存本轮修改。<br />结果：待提交的变化清除后，保存按钮重新禁用；只选择一行不算数据修改。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>核对撤销与确认的区别</h3>
        <ol>
            <li>修改一行后点击<strong class="example-control-reference" data-example-control="btnReadChanges" title="读取修改记录">读取修改记录</strong>，再点击<strong
                    class="example-control-reference" data-example-control="btnRejectChanges"
                    title="服务端撤销编辑">服务端撤销编辑</strong>并确认。<br />结果：后台先显示收到的修改记录数；撤销动作返回浏览器后恢复未编辑状态，下一次读取不再携带这些旧修改。</li>
            <li>重新修改一行，点击<strong class="example-control-reference" data-example-control="btnCommitChanges"
                    title="仅确认客户端编辑">仅确认客户端编辑</strong>，再改一次并撤销。<br />结果：确认动作只把当前浏览器值作为新的编辑基准，不写入后台数据；之后撤销回到这个新基准。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>由后台安排浏览器编辑动作</h3>
        <ul>
            <li>分别从初始状态点击<strong class="example-control-reference" data-example-control="btnUpdateCells" title="服务端修改 101 行">服务端修改 101 行</strong>、<strong
                    class="example-control-reference" data-example-control="btnAddRecord" title="服务端插入第二行">服务端插入第二行</strong>或<strong
                    class="example-control-reference" data-example-control="btnAppendRecord"
                    title="服务端追加末行">服务端追加末行</strong>，再读取修改记录。<br />结果：返回的客户端动作按稳定行标识修改指定行、插入第二行或追加末行；这些动作同样进入待保存变更。</li>
            <li>从初始状态分别尝试<strong class="example-control-reference" data-example-control="btnDeleteRow" title="服务端删除 101 行">服务端删除 101 行</strong>与<strong
                    class="example-control-reference" data-example-control="btnForceDeleteRow" title="强制移除 102 行">强制移除 102
                    行</strong>。<br />结果：普通删除登记待删除并可撤销；强制移除直接调整客户端显示，不产生同样的待删除记录，也不因此删除后台原始数据。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>datachange / getModifiedData</code>（<strong>页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（双击编辑）">表格（双击编辑）</strong>）：每次数据变化后检查变更集合；集合非空则启用保存，为空则禁用。</li>
            <li><code>Enabled</code>（<strong class="example-control-reference" data-example-control="btnSubmit" title="保存数据">保存数据</strong>）：初始为
                <code>false</code>，保存按钮只在有待提交记录时可用。
            </li>
        </ul>
    </section>
}
