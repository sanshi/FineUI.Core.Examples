@page
@model FineUI.Core.Examples.Pages.GridEditor.ShengShiModel
@{
    ViewBag.Title = "GridEditor/ShengShi";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（单击编辑）" DataIDField="Id" DataTextField="Name" AllowCellEditing="true"
        ClicksToEdit="1">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" ColumnID="Name" DataField="Name" ExpandUnusedSpace="true" MinWidth="150">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true"></f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="所在省" ColumnID="Sheng" DataField="Sheng" Width="150" RendererFunction="renderSheng">
                <Editor>
                    <f:DropDownList ID="ddlSheng" Required="true"></f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="所在市" ColumnID="Shi" DataField="Shi" Width="150" RendererFunction="renderShi">
                <Editor>
                    <f:DropDownList ID="ddlShi" Required="true"></f:DropDownList>
                </Editor>
            </f:RenderField>
        </Columns>
        <Listeners>
            <f:Listener Event="beforeedit" Handler="onGrid1BeforeEdit"></f:Listener>
            <f:Listener Event="afteredit" Handler="onGrid1AfterEdit"></f:Listener>
        </Listeners>
    </f:Grid>

    <br>
    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>
    <br>
    <br>



}

@section script {

    <script type="application/json" id="provinceCityData">@Html.Raw(Model.ProvinceCityDataJson)</script>

    <script src="~/res/js/grid.js"></script>

    <script>

        // 先读取纯 JSON，保证控件首次渲染时就能使用这些数据。
        var provinceCityData = JSON.parse(document.getElementById('provinceCityData').textContent);
        // 单元格保存固定编码，渲染时从统一数据查找名称。
        function findPlaceName(items, code) {
            if (!items) {
                return '';
            }
            for (var i = 0; i < items.length; i++) {
                if (items[i][0] === code) {
                    return items[i][1];
                }
            }
            return '';
        }

        function renderSheng(value) {
            return findPlaceName(provinceCityData.provinces, value);
        }

        function renderShi(value, params) {
            var provinceCode = params.rowValue['Sheng'];
            return findPlaceName(provinceCityData.cities[provinceCode], value);
        }


        function onGrid1BeforeEdit(event, value, params) {
            var grid1 = F.ui.Grid1;

            if (params.columnId === 'Shi') {
                var ddlShi = F.ui.ddlShi;

                var sheng = grid1.getCellValue(params.rowId, 'Sheng');

                var shidata = provinceCityData.cities[sheng];
                if (shidata) {
                    ddlShi.enable();
                    ddlShi.setEmptyText('');
                    ddlShi.loadData(shidata);
                } else {
                    ddlShi.setEmptyText('请先选择省！');
                    ddlShi.disable();
                }
            }
        }


        function onGrid1AfterEdit(event, value, params) {
            var grid1 = F.ui.Grid1;

            if (params.columnId === 'Sheng') {
                var shidata = provinceCityData.cities[value];
                if (shidata) {
                    var shi = grid1.getCellValue(params.rowId, 'Shi');
                    // 如果结束编辑时，市 不属于 当前 省，则清空 市
                    if ($.inArray(shi, shidata) < 0) {
                        // 用 ColumnID 到新值的对象更新单元格，单列和多列采用同一种写法。
                        // https://fineui.com/js/api/FineUI.Grid.html#updateCellValue
                        grid1.updateCellValue(params.rowId, { Shi: '' });
                    }
                }
            }
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在表格单元格中联动省与市，没有省份时限制城市编辑，换省后校验已有城市。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>按省份约束城市选择</h3>
        <ol>
            <li>找到尚未选择省份的行，单击<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（单击编辑）">表格（单击编辑）</strong>的<strong>所在市</strong>单元格。<br />结果：城市编辑器禁用，并显示先选择省份的提示，不提供无所属省的城市选项。</li>
            <li>先选择<strong><strong>所在省</strong></strong>，再打开<strong><strong>所在市</strong></strong>；随后把省份改为另一个省。<br />结果：城市选项按当前省重新加载；原城市不属于新省时被清空，需要重新选择合法城市。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <ul>
            <li>
                如果未设置省份，则<strong>所在市</strong>下拉列表禁用，并且显示提示信息 - 请先选择省！
            </li>
            <li>
                选择省份后，<strong>所在市</strong>下拉列表数据动态加载
            </li>
            <li>
                更改省份后，如果所在<strong>所在市</strong>不属于当前省份，则清空<strong>所在市</strong>
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>beforeedit / afteredit</code>（<strong>页面脚本</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（单击编辑）">表格（单击编辑）</strong>）：进入市编辑器前按当前省加载选项，省份结束编辑后检查并清空不再有效的城市。</li>
        </ul>
    </section>
}
