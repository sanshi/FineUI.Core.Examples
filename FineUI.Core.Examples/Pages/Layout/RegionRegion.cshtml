@page
@model FineUI.Core.Examples.Pages.Layout.RegionRegionModel
@{
    ViewBag.Title = "Layout/RegionRegion";


    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel1" Margin="24" ShowBorder="false" ShowHeader="false" Layout="Region" IsViewPort="true">
        <Items>
            <f:Panel ID="panelLeftRegion" RegionPosition="Left" RegionSplit="true" EnableCollapse="true"
                     Width="200" Title="左侧面板" ShowBorder="true" ShowHeader="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label2" Text="左侧面板的内容">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel RegionPosition="Center" ShowBorder="false" ShowHeader="false" Layout="Fit">
                <Items>
                    <f:Panel ID="Panel2" ShowBorder="false" ShowHeader="false" Layout="Region">
                        <Items>
                            <f:Panel ID="panel3" RegionPosition="Left" RegionSplit="true" EnableCollapse="true"
                                     Width="200" Title="左侧面板" ShowBorder="true" ShowHeader="true" BodyPadding="10">
                                <Items>
                                    <f:Label ID="Label1" Text="左侧面板的内容">
                                    </f:Label>
                                </Items>
                            </f:Panel>
                            <f:Panel ID="Panel4" RegionPosition="Center" ShowBorder="false" ShowHeader="false" Layout="Fit">
                                <Items>
                                    <f:Panel ID="Panel5" ShowBorder="false" ShowHeader="false" Layout="Region">
                                        <Items>
                                            <f:Panel ID="panel6" RegionPosition="Left" RegionSplit="true" EnableCollapse="true"
                                                     Width="200" Title="左侧面板" ShowBorder="true" ShowHeader="true" BodyPadding="10">
                                                <Items>
                                                    <f:Label ID="Label3" Text="左侧面板的内容">
                                                    </f:Label>
                                                </Items>
                                            </f:Panel>
                                            <f:Panel ID="panel7" RegionPosition="Center"
                                                     Title="中间面板" ShowBorder="true" ShowHeader="true" BodyPadding="10">
                                                <Items>
                                                    <f:Label ID="Label4" Text="中间面板的内容">
                                                    </f:Label>
                                                </Items>
                                            </f:Panel>
                                        </Items>
                                    </f:Panel>
                                </Items>
                            </f:Panel>
                        </Items>
                    </f:Panel>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>


}

