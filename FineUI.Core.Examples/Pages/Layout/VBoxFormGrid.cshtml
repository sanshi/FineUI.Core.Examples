@page
@model FineUI.Core.Examples.Pages.Layout.VBoxFormGridModel
@{
    ViewBag.Title = "Layout/VBoxFormGrid";


    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel7" IsFluid="true" Margin="24" BodyPadding="10" AutoScroll="true"
             Title="面板（Layout=VBox AutoScroll=true），高度变小时可能出现纵向滚动条" ShowBorder="true" ShowHeader="true" Layout="VBox" BoxConfigSpace="10" IsViewPort="true">
        <Toolbars>
            <f:Toolbar ID="Toolbar1">
                <Items>
                    <f:Button ID="Button1" Text="测试按钮"></f:Button>
                    <f:ToolbarSeparator ID="ToolbarSeparator2">
                    </f:ToolbarSeparator>
                    <f:Button ID="Button2" Text="测试按钮"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:Form ID="Form5" ShowBorder="true" ShowHeader="true" Title="表单" BodyPadding="10" RemoveLastFieldsMargin="true">
                <Rows>
                    <f:FormRow>
                        <Items>
                            <f:TextBox ID="TextBox1" Label="Label" Text=""></f:TextBox>
                            <f:TextBox ID="TextBox2" Label="Label" Text=""></f:TextBox>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:TextBox ID="TextBox3" Label="Label" Text=""></f:TextBox>
                            <f:TextBox ID="TextBox4" Label="Label" Text=""></f:TextBox>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:TextBox ID="TextBox5" Label="Label" Text=""></f:TextBox>
                            <f:TextBox ID="TextBox6" Label="Label" Text=""></f:TextBox>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:TextBox ID="TextBox7" Label="Label" Text=""></f:TextBox>
                            <f:TextBox ID="TextBox8" Label="Label" Text=""></f:TextBox>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:TextBox ID="TextBox9" Label="Label" Text=""></f:TextBox>
                            <f:TextBox ID="TextBox10" Label="Label" Text=""></f:TextBox>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:TextBox ID="TextBox11" Label="Label" Text=""></f:TextBox>
                            <f:TextBox ID="TextBox12" Label="Label" Text=""></f:TextBox>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:TextBox ID="TextBox13" Label="Label" Text=""></f:TextBox>
                            <f:TextBox ID="TextBox14" Label="Label" Text=""></f:TextBox>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:TextBox ID="TextBox15" Label="Label" Text=""></f:TextBox>
                            <f:TextBox ID="TextBox16" Label="Label" Text=""></f:TextBox>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:TextBox ID="TextBox17" Label="Label" Text=""></f:TextBox>
                            <f:TextBox ID="TextBox18" Label="Label" Text=""></f:TextBox>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:TextBox ID="TextBox19" Label="Label" Text=""></f:TextBox>
                            <f:TextBox ID="TextBox20" Label="Label" Text=""></f:TextBox>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:TextBox ID="TextBox21" Label="Label" Text=""></f:TextBox>
                            <f:TextBox ID="TextBox22" Label="Label" Text=""></f:TextBox>
                        </Items>
                    </f:FormRow>
                </Rows>
            </f:Form>
            <f:Grid ID="Grid2" Title="表格（BoxFlex=1 MinHeight=300）" PageSize="10" ShowBorder="true" AllowPaging="true" IsDatabasePaging="false" ShowHeader="true"
                    DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true" DataSource="@DataSourceUtil.GetDataTable()" BoxFlex="1" MinHeight="300">
                <Toolbars>
                    <f:Toolbar ID="Toolbar2">
                        <Items>
                            <f:Button ID="btnPopupWindow" Text="测试按钮"></f:Button>
                            <f:ToolbarSeparator ID="ToolbarSeparator1">
                            </f:ToolbarSeparator>
                            <f:Button ID="btnCheckSelection" Text="测试按钮"></f:Button>
                        </Items>
                    </f:Toolbar>
                </Toolbars>
                <Columns>
                    <f:RowNumberField />
                    <f:RenderField HeaderText="姓名" DataField="Name" />
                    <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
                    <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
                    <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
                    <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
                    <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
                </Columns>
            </f:Grid>
        </Items>
    </f:Panel>


}

@section script {

    <script src="~/res/js/grid.js"></script>

}