@page
@model FineUI.Core.Examples.Pages.Layout.RegionMultiRegionsModel
@{
    ViewBag.Title = "Layout/RegionMultiRegions";


    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel1" Margin="24" ShowBorder="false" ShowHeader="false" Layout="Region" IsViewPort="true">
        <Items>
            <f:Panel ID="PanelExample2" RegionPosition="Top" RegionSplit="true" EnableCollapse="true" Height="50" Title="顶部面板" ShowBorder="true"
                ShowHeader="false" BodyPadding="10">
                <Items>
                    <f:Label ID="Label1" Text="顶部面板的内容">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel RegionPosition="Top" RegionSplit="true" EnableCollapse="true" Height="50" Title="顶部面板" ShowBorder="true" ShowHeader="false"
                BodyPadding="10">
                <Items>
                    <f:Label ID="Label4" Text="顶部面板的内容">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="panelLeftRegion" RegionPosition="Left" RegionSplit="true" EnableCollapse="true" Width="200" Title="左侧面板" ShowBorder="true"
                ShowHeader="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label2" Text="左侧面板的内容">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="panel2" RegionPosition="Left" RegionSplit="true" EnableCollapse="true" Width="200" Title="左侧面板" ShowBorder="true" ShowHeader="true"
                BodyPadding="10">
                <Items>
                    <f:Label ID="Label6" Text="左侧面板的内容">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="panelCenterRegion" RegionPosition="Center" Title="中间面板" ShowBorder="true" ShowHeader="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label3" Text="中间面板的内容">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel RegionPosition="Right" RegionSplit="true" EnableCollapse="true" Width="200" Title="右侧面板" ShowBorder="true" ShowHeader="true"
                BodyPadding="10">
                <Items>
                    <f:Label ID="Label5" Text="右侧面板的内容">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel RegionPosition="Right" RegionSplit="true" EnableCollapse="true" Width="200" Title="右侧面板" ShowBorder="true" ShowHeader="true"
                BodyPadding="10">
                <Items>
                    <f:Label ID="Label7" Text="右侧面板的内容">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel RegionPosition="Bottom" RegionSplit="true" EnableCollapse="true" Height="50" Title="底部面板" ShowBorder="true" ShowHeader="false"
                BodyPadding="10">
                <Items>
                    <f:Label ID="Label8" Text="底部面板的内容">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel RegionPosition="Bottom" RegionSplit="true" EnableCollapse="true" Height="50" Title="底部面板" ShowBorder="true" ShowHeader="false"
                BodyPadding="10">
                <Items>
                    <f:Label ID="Label9" Text="底部面板的内容">
                    </f:Label>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>



}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示在多个方向放置侧边区域，并让中心区域使用剩余空间。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>调整区域空间</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Panel1" title="第 1 个面板">第 1
                    个面板</strong>拖动可用的分隔条，再点击侧边区域的折叠入口。<br />结果：被操作区域改变尺寸或折叠，中心区域随剩余空间重新布局；其它区域内容保留。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="Panel1" title="第 1 个面板">第 1
                    个面板</strong>）：初始为<code>Region</code>，外层使用 <code>Region</code> 布局组织各方向的子区域。</li>
            <li><code>RegionPosition</code>（本页各面板，如<strong class="example-control-reference" data-example-control="PanelExample2" title="第 2 个面板（顶部面板）">第 2
                    个面板（顶部面板）</strong>）：各组分别设为<code>Top</code>、<code>Left</code>、<code>Center</code>、<code>Right</code>、<code>Bottom</code>，指定每个子区域所在的方向，中心区域使用剩余空间。
            </li>
            <li><code>RegionSplit</code>（本页各面板，如<strong class="example-control-reference" data-example-control="PanelExample2" title="第 2 个面板（顶部面板）">第 2
                    个面板（顶部面板）</strong>）：初始为<code>true</code>，允许对应区域显示可拖动的分隔条。</li>
        </ul>
    </section>
}
