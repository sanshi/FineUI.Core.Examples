@page
@model FineUI.Core.Examples.Pages.Layout.InlineBlockModel
@{
    ViewBag.Title = "Layout/InlineBlock";


    var F = Html.F();
}


@section head {

    <style>
        .mypanel {
            display: inline-block !important;
            margin-right: 5px;
