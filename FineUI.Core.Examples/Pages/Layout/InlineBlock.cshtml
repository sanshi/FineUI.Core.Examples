@page
@model FineUI.Core.Examples.Pages.Layout.InlineBlockModel
@{
    ViewBag.Title = "Layout/InlineBlock";


    var F = Html.F();
}


@section head {

    <style>
        .mypanel {
            display: inline-block !important;
            margin-right: 5px;
        }
    </style>

}

@section body {

    <f:Panel ID="Panel1" IsFluid="true" ShowBorder="true" EnableCollapse="false"
             BodyPadding="10" ShowHeader="true" Title="面板" AutoScroll="true" Margin="20" IsViewPort="true">
        <Items>
            <f:Panel ID="Panel2" Title="面板1" CssClass="mypanel" Width="300" Height="200"
                     BodyPadding="10" ShowBorder="true">
            </f:Panel>
            <f:Panel ID="Panel3" Title="面板2" CssClass="mypanel" Width="300" Height="200"
                     BodyPadding="10" ShowBorder="true">
            </f:Panel>
            <f:Panel ID="Panel4" Title="面板3" CssClass="mypanel" Width="300" Height="200"
                     BodyPadding="10" ShowBorder="true">
            </f:Panel>
            <f:Panel ID="Panel5" Title="面板4" CssClass="mypanel" Width="300" Height="200"
                     BodyPadding="10" ShowBorder="true">
            </f:Panel>
            <f:Panel ID="Panel6" Title="面板5" CssClass="mypanel" Width="300" Height="200"
                     BodyPadding="10" ShowBorder="true">
            </f:Panel>
            <f:Panel ID="Panel7" Title="面板6" CssClass="mypanel" Width="300" Height="200"
                     BodyPadding="10" ShowBorder="true">
            </f:Panel>
            <f:Panel ID="Panel8" Title="面板7" CssClass="mypanel" Width="300" Height="200"
                     BodyPadding="10" ShowBorder="true">
            </f:Panel>
            <f:Panel ID="Panel9" Title="面板8" CssClass="mypanel" Width="300" Height="200"
                     BodyPadding="10" ShowBorder="true">
            </f:Panel>
            <f:Panel ID="Panel10" Title="面板9" CssClass="mypanel" Width="300" Height="200"
                     BodyPadding="10" ShowBorder="true">
            </f:Panel>
            <f:Panel ID="Panel11" Title="面板10" CssClass="mypanel" Width="300" Height="200"
                     BodyPadding="10" ShowBorder="true">
            </f:Panel>
        </Items>
    </f:Panel>



}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示让内容块在一行排列并在宽度不足时换行。</p>
    <h3><i class="f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照布局与尺寸变化</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Panel1" title="面板">面板</strong>中逐步缩小浏览器宽度。<br />结果：项目保留本页块尺寸；当前行放不下时，后面的项目移到下一行。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="Panel1" title="面板">面板</strong>）：父容器使用本页对应的布局方式，决定其直接子项的排列。</li>
        <li><code>Width</code>（本页各面板，如<strong class="example-control-reference" data-example-control="Panel2" title="面板1">面板1</strong>）：设为<code>300</code>，指定本页子项或外层容器的宽度。</li>
    </ul>
</section>
}
