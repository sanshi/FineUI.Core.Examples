@page
@model FineUI.Core.Examples.Pages.Layout.TableModel
@{
    ViewBag.Title = "Layout/Table";


    var F = Html.F();
}


@section head {

    <style>
        .mytable td.f-layout-table-cell {
            padding: 5px;
        }
    </style>

}

@section body {

    <f:Panel ID="Panel2" IsFluid="true" CssClass="mytable" Height="500" ShowBorder="true"
             Layout="Table" TableConfigColumns="3" ShowHeader="true" Title="面板（Height=450 Width=750 Layout=Table）">
        <Items>
            <f:Panel ID="Panel1" Title="Panel1" Width="300" Height="210"
                     TableRowspan="2" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label ID="Label1" Text="Width=300 Height=210 TableRowspan=2">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="Panel3" Title="Panel2" Width="430" Height="100"
                     TableColspan="2" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label ID="Label2" Text="Width=430 Height=100 TableColspan=2">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="Panel4" Title="Panel3" Width="200" Height="100"
                     BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label ID="Label3" Text="Width=200 Height=100">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="Panel5" Title="Panel4" Width="220" Height="100"
                     BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label ID="Label4" Text="Width=220 Height=100">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="Panel6" Title="Panel5" Width="300" Height="100"
                     BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label ID="Label5" Text="Width=300 Height=100">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="Panel7" Title="Panel6" Width="200" Height="100"
                     BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label ID="Label6" Text="Width=200 Height=100">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="Panel8" Title="Panel6" Width="220" Height="100"
                     BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label ID="Label7" Text="Width=220 Height=100">
                    </f:Label>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>


}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示按表格行列安排子面板，并组合跨行和跨列项目。</p>
    <h3><i class="f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照布局与尺寸变化</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Panel2" title="面板（Height=450 Width=750 Layout=Table）">面板（Height=450 Width=750 Layout=Table）</strong>中对照各面板的格位与占用行列数。<br />结果：普通项目依次填入表格，跨行或跨列项目占据对应多个格位。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="Panel2" title="面板（Height=450 Width=750 Layout=Table）">面板（Height=450 Width=750 Layout=Table）</strong>）：父容器使用本页对应的布局方式，决定其直接子项的排列。 本页使用<code>Table</code>。</li>
        <li><code>TableConfigColumns</code>（<strong class="example-control-reference" data-example-control="Panel2" title="面板（Height=450 Width=750 Layout=Table）">面板（Height=450 Width=750 Layout=Table）</strong>）：规定表格布局每行的列数。 本页使用<code>3</code>。</li>
        <li><code>RowSpan</code>（<strong class="example-control-reference" data-example-control="Panel2" title="面板（Height=450 Width=750 Layout=Table）">面板（Height=450 Width=750 Layout=Table）</strong>）：当前子项占用多行。</li>
        <li><code>ColSpan</code>（<strong class="example-control-reference" data-example-control="Panel2" title="面板（Height=450 Width=750 Layout=Table）">面板（Height=450 Width=750 Layout=Table）</strong>）：当前子项占用多列。</li>
    </ul>
</section>
}
