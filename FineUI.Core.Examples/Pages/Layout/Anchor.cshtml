@page
@model FineUI.Core.Examples.Pages.Layout.AnchorModel
@{
    ViewBag.Title = "Layout/Anchor";


    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel3" IsFluid="true" Title="面板一（Height=300px)" Height="300" EnableCollapse="false"
             BodyPadding="10" ShowBorder="true" ShowHeader="true">
        <Items>
            <f:Panel ID="Panel1" ShowBorder="true" Margin="0 0 5 0" BodyPadding="10" ShowHeader="false" Title="面板">
                <Items>
                    <f:Label ID="Label5" Text="Margin=0 0 5 0">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Form ID="Form3" ShowBorder="true" BodyPadding="10" ShowHeader="false" Title="表单">
                <Rows>
                    <f:FormRow>
                        <Items>
                            <f:Label ID="Label2" Label="文本" Text="文本内容">
                            </f:Label>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:TextBox ID="TextBox2" Label="输入框">
                            </f:TextBox>
                            <f:Button ID="Button2" Text="按钮"></f:Button>
                        </Items>
                    </f:FormRow>
                </Rows>
            </f:Form>
        </Items>
    </f:Panel>
    <br />
    <f:Panel ID="Panel2" IsFluid="true" Height="300" ShowBorder="true" EnableCollapse="false"
             BodyPadding="10" Layout="Anchor" ShowHeader="true" Title="面板二（Height=300px Width=750px Layout=Anchor）">
        <Items>
            <f:Panel ID="Panel4" AnchorValue="60% 30%" Margin="0 0 5 0" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label ID="Label3" Text="AnchorValue=60% 30% Margin=0 0 5 0">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Form ID="Form2" AnchorValue="100% 70%" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Rows>
                    <f:FormRow>
                        <Items>
                            <f:Label ID="Label1" Text="AnchorValue=100% 70%">
                            </f:Label>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:TextBox ID="TextBox1" Label="输入框">
                            </f:TextBox>
                            <f:Button ID="Button7" Text="按钮"></f:Button>
                        </Items>
                    </f:FormRow>
                </Rows>
            </f:Form>
        </Items>
    </f:Panel>
    <br />
    <f:Panel ID="Panel5" IsFluid="true" Title="面板三（Width=750px）" EnableCollapse="false" BodyPadding="10" ShowBorder="true" ShowHeader="true">
        <Items>
            <f:Form ID="Form4" ShowBorder="false" ShowHeader="false">
                <Rows>
                    <f:FormRow>
                        <Items>
                            <f:TextBox ID="TextBox3" Label="用户名">
                            </f:TextBox>
                            <f:Button ID="Button6" Text="搜索"></f:Button>
                        </Items>
                    </f:FormRow>
                </Rows>
            </f:Form>
            <f:Panel ID="Panel6" ShowBorder="true" ShowHeader="false">
                <Toolbars>
                    <f:Toolbar ID="Toolbar1">
                        <Items>
                            <f:Button ID="Button4" Text="按钮一"></f:Button>
                            <f:Button ID="Button5" Text="按钮二"></f:Button>
                        </Items>
                    </f:Toolbar>
                </Toolbars>
                <Items>
                    <f:Grid ID="Grid1" Title="表格" PageSize="3" ShowBorder="false" ShowHeader="false" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true" DataSource="@DataSourceUtil.GetDataTable()">
                        <Columns>
                            <f:RowNumberField />
                            <f:RenderField HeaderText="姓名" DataField="Name" />
                            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
                            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
                            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
                            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
                            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
                        </Columns>
                    </f:Grid>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>
    <br />
    <f:Panel ID="Panel7" IsFluid="true" BodyPadding="10" EnableCollapse="false"
             ShowBorder="true" ShowHeader="true" Height="350" Title="面板四（Width=750px Height=350px Layout=Anchor）" Layout="Anchor">
        <Items>
            <f:Form ID="Form5" ShowBorder="false" AnchorValue="100%" ShowHeader="false">
                <Rows>
                    <f:FormRow>
                        <Items>
                            <f:TextBox ID="TextBox5" Label="用户名">
                            </f:TextBox>
                            <f:TextBox ID="TextBox8" Label="所在班级">
                            </f:TextBox>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:TextBox ID="TextBox6" Label="所在年级">
                            </f:TextBox>
                            <f:Button ID="Button11" Text="搜索"></f:Button>
                        </Items>
                    </f:FormRow>
                </Rows>
            </f:Form>
            <f:Panel ID="Panel8" ShowBorder="true" ShowHeader="false" AnchorValue="100% -72" Layout="Fit">
                <Toolbars>
                    <f:Toolbar ID="Toolbar2">
                        <Items>
                            <f:Button ID="Button8" Text="按钮一"></f:Button>
                            <f:Button ID="Button9" Text="按钮二"></f:Button>
                        </Items>
                    </f:Toolbar>
                </Toolbars>
                <Items>
                    <f:Grid ID="Grid2" Title="Grid2" PageSize="3" ShowBorder="false" ShowHeader="false" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true" DataSource="@DataSourceUtil.GetDataTable()">
                        <Columns>
                            <f:RowNumberField />
                            <f:RenderField HeaderText="姓名" DataField="Name" />
                            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
                            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
                            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
                            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
                            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
                        </Columns>
                    </f:Grid>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>
    <br />
    <br />
    <br />
    <strong>【推荐】</strong>使用VBox布局实现与上例相同的界面：
    <br />
    <hr />
    <br />
    <f:Panel ID="Panel9" IsFluid="true" Layout="VBox" EnableCollapse="false"
             BodyPadding="10" BoxConfigChildMargin="0" ShowBorder="true" ShowHeader="true" Height="350" Title="面板五（Layout=VBox BoxConfigChildMargin=0）">
        <Items>
            <f:Form ID="Form6" ShowBorder="false" ShowHeader="false">
                <Rows>
                    <f:FormRow>
                        <Items>
                            <f:TextBox ID="TextBox4" Label="用户名">
                            </f:TextBox>
                            <f:TextBox ID="TextBox7" Label="所在班级">
                            </f:TextBox>
                        </Items>
                    </f:FormRow>
                    <f:FormRow>
                        <Items>
                            <f:TextBox ID="TextBox9" Label="所在年级">
                            </f:TextBox>
                            <f:Button ID="Button10" Text="搜索"></f:Button>
                        </Items>
                    </f:FormRow>
                </Rows>
            </f:Form>
            <f:Panel ID="Panel10" ShowBorder="true" ShowHeader="false" BoxFlex="1" Layout="Fit">
                <Toolbars>
                    <f:Toolbar ID="Toolbar3">
                        <Items>
                            <f:Button ID="Button12" Text="按钮一"></f:Button>
                            <f:Button ID="Button13" Text="按钮二"></f:Button>
                        </Items>
                    </f:Toolbar>
                </Toolbars>
                <Items>
                    <f:Grid ID="Grid3" Title="Grid3" PageSize="3" ShowBorder="false" ShowHeader="false" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true" DataSource="@DataSourceUtil.GetDataTable()">
                        <Columns>
                            <f:RowNumberField />
                            <f:RenderField HeaderText="姓名" DataField="Name" />
                            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
                            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
                            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
                            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
                            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
                        </Columns>
                    </f:Grid>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>


}

@section script {

    <script src="~/res/js/grid.js"></script>

}