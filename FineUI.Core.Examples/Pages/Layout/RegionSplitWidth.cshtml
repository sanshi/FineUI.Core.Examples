@page
@model FineUI.Core.Examples.Pages.Layout.RegionSplitWidthModel
@{
    ViewBag.Title = "Layout/RegionSplitWidth";


    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel1" Margin="24" ShowBorder="false" ShowHeader="false" Layout="Region" IsViewPort="true">
        <Items>
            <f:Panel ID="panelTopRegion" RegionPosition="Top" RegionSplit="true" RegionSplitWidth="3" EnableCollapse="true" Height="100"
                     Title="顶部面板" ShowBorder="true" ShowHeader="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label1" Text="顶部面板的内容">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="panelLeftRegion" RegionPosition="Left" RegionSplit="true" RegionSplitWidth="3" EnableCollapse="true"
                     Width="200" Title="左侧面板" ShowBorder="true" ShowHeader="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label2" Text="左侧面板的内容">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="panelCenterRegion" RegionPosition="Center"
                     Title="中间面板" ShowBorder="true" ShowHeader="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label3" Text="中间面板的内容">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="panelRightRegion" RegionPosition="Right" RegionSplit="true" RegionSplitWidth="3" EnableCollapse="true"
                     Width="200" Title="右侧面板" ShowBorder="true" ShowHeader="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label4" Text="右侧面板的内容">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="panelBottomRegion" RegionPosition="Bottom" RegionSplit="true" RegionSplitWidth="3" EnableCollapse="true" Height="100"
                     Title="底部面板" ShowBorder="true" ShowHeader="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label5" Text="底部面板的内容">
                    </f:Label>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>

}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示设置区域之间的分隔条宽度，同时保留拖动与折叠能力。</p>
    <h3><i class="f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照和拖动分隔条</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Panel1" title="第 1 个面板">第 1 个面板</strong>拖动可用的分隔条，再点击侧边区域的折叠入口。<br />结果：被操作区域改变尺寸或折叠，中心区域随剩余空间重新布局；其它区域内容保留。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="Panel1" title="第 1 个面板">第 1 个面板</strong>）：外层使用 <code>Region</code> 布局组织各方向的子区域。 本页使用<code>Region</code>。</li>
        <li><code>RegionPosition</code>（本页各面板，如<strong class="example-control-reference" data-example-control="panelTopRegion" title="顶部面板">顶部面板</strong>）：指定每个子区域所在的方向，中心区域使用剩余空间。 本页各组分别使用<code>Top</code>、<code>Left</code>、<code>Center</code>、<code>Right</code>、<code>Bottom</code>。</li>
        <li><code>RegionSplitWidth</code>（<strong class="example-control-reference" data-example-control="panelTopRegion" title="顶部面板">顶部面板</strong>、<strong class="example-control-reference" data-example-control="panelLeftRegion" title="左侧面板">左侧面板</strong>、<strong class="example-control-reference" data-example-control="panelRightRegion" title="右侧面板">右侧面板</strong>、<strong class="example-control-reference" data-example-control="panelBottomRegion" title="底部面板">底部面板</strong>）：本页为分隔条显式指定宽度。 本页使用<code>3</code>。</li>
    </ul>
</section>
}
