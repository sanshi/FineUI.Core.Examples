@page
@model FineUI.Core.Examples.Pages.Layout.VBoxAutoHeightModel
@{
    ViewBag.Title = "Layout/VBoxAutoHeight";


    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel5" IsFluid="true" ShowBorder="true" EnableCollapse="true" Layout="VBox" ShowHeader="true"
        Title="面板（Layout=VBox）（默认值：BoxConfigAlign=Stretch）" BoxConfigSpace="5" BodyPadding="5">
        <Items>
            <f:Panel ID="Panel1" Title="面板1" Height="100" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label ID="Label1" Text="Height=100">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="Panel2" Title="面板2" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label ID="Label3" EncodeText="false" Text="末项无额外间隔<br><br><br><br><br><br>bottom line">
                    </f:Label>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>


}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示让纵向盒布局按全部子项内容计算自然高度。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照布局与尺寸变化</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Panel5"
                    title="面板（Layout=VBox）（默认值：BoxConfigAlign=Stretch）">面板（Layout=VBox）（默认值：BoxConfigAlign=Stretch）</strong>中对照最下方子项与外层容器底边。<br />结果：外层包含纵向排列的完整子项，不按固定高度截断内容。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="Panel5"
                    title="面板（Layout=VBox）（默认值：BoxConfigAlign=Stretch）">面板（Layout=VBox）（默认值：BoxConfigAlign=Stretch）</strong>）：初始为<code>VBox</code>，父容器使用本页对应的布局方式，决定其直接子项的排列。
            </li>
            <li><code>Height</code>（<strong class="example-control-reference" data-example-control="Panel1"
                    title="面板1">面板1</strong>）：初始为<code>100</code>，显式高度限定可用区域；未设置固定高度的对照组按内容和父布局计算。</li>
        </ul>
    </section>
}
