@page
@model FineUI.Core.Examples.Pages.Layout.VBoxAutoHeightModel
@{
    ViewBag.Title = "Layout/VBoxAutoHeight";


    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel5" IsFluid="true" ShowBorder="true" EnableCollapse="true"
             Layout="VBox" ShowHeader="true" Title="面板（Layout=VBox）（默认值：BoxConfigAlign=Stretch）"
             BoxConfigSpace="5" BodyPadding="5">
        <Items>
            <f:Panel ID="Panel1" Title="面板1" Height="100"
                     BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label ID="Label1" Text="Height=100">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="Panel2" Title="面板2"
                     BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label ID="Label3" EncodeText="false" Text="末项无额外间隔<br><br><br><br><br><br>bottom line">
                    </f:Label>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>


}

