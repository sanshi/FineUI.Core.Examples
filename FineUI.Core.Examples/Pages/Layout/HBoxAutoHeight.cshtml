@page
@model FineUI.Core.Examples.Pages.Layout.HBoxAutoHeightModel
@{
    ViewBag.Title = "Layout/HBoxAutoHeight";


    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel5" IsFluid="true" ShowBorder="true" EnableCollapse="false" Layout="HBox" AutoScroll="true" ShowHeader="true"
        Title="面板（Layout=HBox AutoScroll=true）" BoxConfigSpace="5" BodyPadding="5">
        <Items>
            <f:Panel ID="Panel1" Title="面板1" Width="600" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label ID="Label1" Text="Width=600">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="Panel2" Title="面板2" BoxFlex="1" MinWidth="600" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label ID="Label3" EncodeText="false"
                        Text="BoxFlex=1<br>末项无额外间隔<br>MinWidth=600<br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br>bottom line">
                    </f:Label>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示让水平盒布局的高度随最高子项内容确定。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照布局与尺寸变化</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Panel5" title="面板（Layout=HBox AutoScroll=true）">面板（Layout=HBox
                    AutoScroll=true）</strong>中对照同排子面板的内容高度。<br />结果：外层高度按子项实际内容确定，不强制使用固定面板高度。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="Panel5"
                    title="面板（Layout=HBox AutoScroll=true）">面板（Layout=HBox AutoScroll=true）</strong>）：初始为<code>HBox</code>，父容器使用本页对应的布局方式，决定其直接子项的排列。</li>
            <li><code>Height</code>（<strong class="example-control-reference" data-example-control="Panel5"
                    title="面板（Layout=HBox AutoScroll=true）">面板（Layout=HBox AutoScroll=true）</strong>）：显式高度限定可用区域；未设置固定高度的对照组按内容和父布局计算。</li>
        </ul>
    </section>
}
