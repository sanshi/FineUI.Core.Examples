@page
@model FineUI.Core.Examples.Pages.Layout.TableFormModel
@{
    ViewBag.Title = "Layout/TableForm";


    var F = Html.F();
}


@section head {

    <style>
        .mytable td.f-layout-table-cell {
            padding: 5px;
        }
    </style>

}

@section body {

    <f:Form ID="Form2" IsFluid="true" CssClass="mytable" Height="500" ShowBorder="true"
            Layout="Table" TableConfigColumns="3" ShowHeader="true" Title="表单（Height=450 Width=750 Layout=Table）" LabelAlign="Right" LabelWidth="120">
        <Items>
            <f:Panel ID="Panel1" Title="Panel1" Width="300" Height="210" TableRowspan="2" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label ID="Label1" Label="标签（靠右）" Text="Width=300 Height=210 TableRowspan=2">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="Panel3" Title="Panel2" Width="430" Height="100" TableColspan="2" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label ID="Label2" Label="标签（靠左）" LabelAlign="LabelAlign.Left" Text="Width=430 Height=100 TableColspan=2">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="Panel4" Title="Panel3" Width="200" Height="100" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label ID="Label3" Text="Width=200 Height=100">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="Panel5" Title="Panel4" Width="220" Height="100" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label ID="Label4" Text="Width=220 Height=100">
                    </f:Label>
                </Items>
            </f:Panel>
        </Items>
    </f:Form>


}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示用 <code>Table</code> 布局把表单字段放入固定行列。</p>
    <h3><i class="f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照布局与尺寸变化</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Panel1" title="Panel1">Panel1</strong>中在字段中输入内容，并对照标签与输入区的行列位置。<br />结果：字段保留各自输入功能，位置由表格列数和跨列设置组织。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="Form2" title="表单（Height=450 Width=750 Layout=Table）">表单（Height=450 Width=750 Layout=Table）</strong>）：父容器使用本页对应的布局方式，决定其直接子项的排列。 本页使用<code>Table</code>。</li>
        <li><code>TableConfigColumns</code>（<strong class="example-control-reference" data-example-control="Form2" title="表单（Height=450 Width=750 Layout=Table）">表单（Height=450 Width=750 Layout=Table）</strong>）：规定表格布局每行的列数。 本页使用<code>3</code>。</li>
        <li><code>ColSpan</code>（<strong class="example-control-reference" data-example-control="Panel1" title="Panel1">Panel1</strong>）：当前子项占用多列。</li>
    </ul>
</section>
}
