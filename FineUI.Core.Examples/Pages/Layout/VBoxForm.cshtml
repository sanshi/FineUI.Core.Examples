@page
@model FineUI.Core.Examples.Pages.Layout.VBoxFormModel
@{
    ViewBag.Title = "Layout/VBoxForm";


    var F = Html.F();
}


@section body {

    <f:Form ID="Panel1" IsFluid="true" Title="表单（Layout=VBox）" Height="400" LabelAlign="Right"
            BodyPadding="10" ShowBorder="true" ShowHeader="true"
            Layout="VBox" BoxConfigSpace="5" RemoveFieldsMargin="true">
        <Items>
            <f:TextBox ID="TextBox1" Label="姓名" ShowRedStar="true" Required="true"></f:TextBox>
            <f:DropDownList ID="DropDownList1" Label="性别" ShowRedStar="true" Required="true">
                <f:ListItem Text="男" Value="男" Selected="true" />
                <f:ListItem Text="女" Value="女" />
            </f:DropDownList>
            <f:TextArea ID="TextArea1" Label="个人简介" BoxFlex="1"></f:TextArea>
        </Items>
    </f:Form>
    <br>
    <br>




}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示在纵向盒布局中组织多组表单。</p>
    <h3><i class="f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照布局与尺寸变化</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Panel1" title="表单（Layout=VBox）">表单（Layout=VBox）</strong>中填写本页表单字段并改变浏览器高度。<br />结果：各表单按顺序纵向排列，字段值不因布局调整而丢失。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <ul>
        <li>为表单设置 <code>RemoveFieldsMargin</code>="<code>true</code>" 来移除表单字段的底部外边距。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="Panel1" title="表单（Layout=VBox）">表单（Layout=VBox）</strong>）：设为<code>VBox</code>，父容器使用本页对应的布局方式，决定其直接子项的排列。</li>
        <li><code>Height</code>（<strong class="example-control-reference" data-example-control="Panel1" title="表单（Layout=VBox）">表单（Layout=VBox）</strong>）：设为<code>400</code>，显式高度限定可用区域；未设置固定高度的对照组按内容和父布局计算。</li>
    </ul>
</section>
}
