@page
@model FineUI.Core.Examples.Pages.Layout.HBoxScrollBarModel
@{
    ViewBag.Title = "Layout/HBoxScrollBar";


    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel5" Margin="24" ShowBorder="true" EnableCollapse="false" Layout="HBox" AutoScroll="true"
             ShowHeader="true" Title="面板（Layout=HBox AutoScroll=true），宽度变小时可能出现横向滚动条"
             BoxConfigSpace="5" BodyPadding="5" IsViewPort="true">
        <Items>
            <f:Panel ID="Panel1" Title="面板1" Width="600" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label ID="Label1" Text="Width=600">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="Panel2" Title="面板2" BoxFlex="1" MinWidth="600" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label ID="Label3" Text="BoxFlex=1 末项无额外间隔 MinWidth=600">
                    </f:Label>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>



}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示在水平子项总宽度超过容器时显示横向滚动条。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照布局与尺寸变化</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Panel5" title="面板（Layout=HBox AutoScroll=true），宽度变小时可能出现横向滚动条">面板（Layout=HBox AutoScroll=true），宽度变小时可能出现横向滚动条</strong>中缩小浏览器宽度，再拖动横向滚动条。<br />结果：各子项保留本页宽度，超出的右侧项目可通过横向滚动查看。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="Panel5" title="面板（Layout=HBox AutoScroll=true），宽度变小时可能出现横向滚动条">面板（Layout=HBox AutoScroll=true），宽度变小时可能出现横向滚动条</strong>）：初始为<code>HBox</code>，父容器使用本页对应的布局方式，决定其直接子项的排列。</li>
        <li><code>AutoScroll</code>（<strong class="example-control-reference" data-example-control="Panel5" title="面板（Layout=HBox AutoScroll=true），宽度变小时可能出现横向滚动条">面板（Layout=HBox AutoScroll=true），宽度变小时可能出现横向滚动条</strong>）：初始为<code>true</code>，内容超出该容器时允许滚动查看。</li>
        <li><code>Width</code>（<strong class="example-control-reference" data-example-control="Panel1" title="面板1">面板1</strong>）：初始为<code>600</code>，指定本页子项或外层容器的宽度。</li>
    </ul>
</section>
}
