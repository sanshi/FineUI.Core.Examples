@page
@model FineUI.Core.Examples.Pages.Layout.HBoxFormModel
@{
    ViewBag.Title = "Layout/HBoxForm";


    var F = Html.F();
}

@section head {

    <style>
        /*.mysimpleform .f-field {
                    margin-bottom: 0 !important;
                }*/
    </style>

}


@section body {

    <f:Panel ID="Panel1" IsFluid="true" Height="350" ShowBorder="true" EnableCollapse="false"
             Layout="VBox" BodyPadding="10" BoxConfigSpace="5" ShowHeader="true" Title="面板（SimpleForm - Layout=HBox）">
        <Items>
            <f:SimpleForm ID="SimpleForm1" ShowBorder="false" EnableCollapse="true" ShowHeader="false"
                          Layout="HBox" BoxConfigSpace="5" RemoveFieldsMargin="true">
                <Items>
                    <f:Label Text="销毁统计时间段："></f:Label>
                    <f:DatePicker Width="150" Required="true" DateFormatString="yyyy-MM-dd" EmptyText="请选择开始日期"
                                  ShowLabel="false" Label="销毁统计开始时间" ID="dpStartDate" EnableEdit="false">
                    </f:DatePicker>
                    <f:DatePicker ID="dpEndDate" Width="150" Required="true" Readonly="false"
                                  CompareControl="dpStartDate" DateFormatString="yyyy-MM-dd" CompareOperator="GreaterThan" CompareMessage="结束日期应该大于开始日期" EmptyText="请选择结束日期"
                                  ShowLabel="false" Label="销毁统计结束时间" EnableEdit="false">
                    </f:DatePicker>
                    <f:Button ID="btnClearDate" Text="重置起止时间" ClickHandler="onClearDateClick"></f:Button>
                    <f:Button ID="btnSearch" Text="查询" _ValidateForms="SimpleForm1"></f:Button>
                </Items>
            </f:SimpleForm>
            <f:Panel ID="Panel3" BoxFlex="1" ShowBorder="true" ShowHeader="false">
                <Items>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>

    <br />
    <br />
    <br />
    下面使用 Column 布局实现相同的效果：
    <br />
    <f:Panel ID="Panel2" IsFluid="true" Height="350" ShowBorder="true" EnableCollapse="false"
             Layout="VBox" BodyPadding="10" BoxConfigSpace="5" ShowHeader="true" Title="面板（SimpleForm - Layout=Column）">
        <Items>
            <f:SimpleForm ID="SimpleForm2" ShowBorder="false" EnableCollapse="true" ShowHeader="false"
                          Layout="Column" RemoveFieldsMargin="true">
                <Items>
                    <f:Label ID="Label1" Text="销毁统计时间段："></f:Label>
                    <f:DatePicker Width="150" CssClass="marginr" Required="true" DateFormatString="yyyy-MM-dd" EmptyText="请选择开始日期"
                                  ShowLabel="false" Label="销毁统计开始时间" ID="DatePicker1" EnableEdit="false">
                    </f:DatePicker>
                    <f:DatePicker ID="DatePicker2" Width="150" CssClass="marginr" Required="true" Readonly="false"
                                  CompareControl="DatePicker1" DateFormatString="yyyy-MM-dd" CompareOperator="GreaterThan" CompareMessage="结束日期应该大于开始日期" EmptyText="请选择结束日期"
                                  ShowLabel="false" Label="销毁统计结束时间" EnableEdit="false">
                    </f:DatePicker>
                    <f:Button ID="Button1" CssClass="marginr" Text="重置起止时间" ClickHandler="onClearDateClick"></f:Button>
                    <f:Button ID="Button2" Text="查询" _ValidateForms="SimpleForm2"></f:Button>
                </Items>
            </f:SimpleForm>
            <f:Panel ID="PanelExample4" BoxFlex="1" ShowBorder="true" ShowHeader="false">
                <Items>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>
    <br>
    <br>


}

@section script {

    <script>

        function onClearDateClick(event) {
            // this -> 按钮实例；获取按钮所在的表单ID
            var formId = this.el.parents('.f-form').attr('id');

            F(formId).reset();
        }

    </script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>演示在水平盒布局中并排组织表单区域。</p>
    <h3><i class="f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照布局与尺寸变化</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Panel1" title="面板（SimpleForm - Layout=HBox）">面板（SimpleForm - Layout=HBox）</strong>中在表单中输入内容，再改变浏览器宽度。<br />结果：各组表单按其固定宽度或伸展比例并排，已填写内容保留。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <ul>
        <li>为表单设置 <code>RemoveFieldsMargin</code>="<code>true</code>" 来移除表单字段的底部外边距。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="Panel1" title="面板（SimpleForm - Layout=HBox）">面板（SimpleForm - Layout=HBox）</strong>、<strong class="example-control-reference" data-example-control="SimpleForm1" title="第 1 个表单">第 1 个表单</strong>、<strong class="example-control-reference" data-example-control="Panel2" title="面板（SimpleForm - Layout=Column）">面板（SimpleForm - Layout=Column）</strong>、<strong class="example-control-reference" data-example-control="SimpleForm2" title="第 2 个表单">第 2 个表单</strong>）：父容器使用本页对应的布局方式，决定其直接子项的排列。 本页各组分别使用<code>VBox</code>、<code>HBox</code>、<code>Column</code>。</li>
        <li><code>BoxFlex</code>（<strong class="example-control-reference" data-example-control="Panel3" title="第 2 个面板">第 2 个面板</strong>、<strong class="example-control-reference" data-example-control="PanelExample4" title="第 4 个面板">第 4 个面板</strong>）：直接子项按此比例分配父容器剩余空间。 本页使用<code>1</code>。</li>
    </ul>
</section>
}
