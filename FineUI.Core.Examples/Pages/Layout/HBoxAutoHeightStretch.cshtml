@page
@model FineUI.Core.Examples.Pages.Layout.HBoxAutoHeightStretchModel
@{
    ViewBag.Title = "Layout/HBoxAutoHeightStretch";


    var F = Html.F();
}


@section body {

    <f:Panel ID="PanelExample1" IsFluid="true" ShowBorder="true" EnableCollapse="false"
             Layout="HBox" BodyPadding="10" BoxConfigSpace="5" ShowHeader="true"
             Title="面板（Layout=HBox）（默认值：BoxConfigAlign=Stretch）">
        <Items>   
            <f:Panel Title="面板1" Width="200" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items> 
                    <f:Label EncodeText="false" Text="Width=200">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel Title="面板2" Width="200" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label EncodeText="false" Text="Width=200<br><br><br><br><br><br><br><br>bottom line">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel Title="面板3" BoxFlex="1" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label EncodeText="false" Text="BoxFlex=1">
                    </f:Label>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>
    <br />
    <br />
    <f:Panel IsFluid="true" ShowBorder="true" EnableCollapse="false"
             Layout="HBox" BodyPadding="10" BoxConfigSpace="5" ShowHeader="true"
             Title="面板（Layout=HBox）（默认值：BoxConfigAlign=Stretch）">
        <Items>
            <f:Panel Title="面板1" Width="200" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label EncodeText="false" Text="Width=200">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="PanelExample7" Title="面板2" Width="200" Height="250" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label EncodeText="false" Text="Width=200 Height=250">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel Title="面板3" BoxFlex="1" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label EncodeText="false" Text="BoxFlex=1">
                    </f:Label>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>
    <br />
    <br />


    <f:Panel ID="PanelExample9" IsFluid="true" ShowBorder="true" EnableCollapse="false"
             Layout="HBox" BoxConfigAlign="Start" BodyPadding="10" BoxConfigSpace="5" ShowHeader="true"
             Title="面板（Layout=HBox BoxConfigAlign=Start）">
        <Items>
            <f:Panel Title="面板1" Width="200" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label EncodeText="false" Text="Width=200">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel Title="面板2" Width="200" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label EncodeText="false" Text="Width=200<br><br><br><br><br><br><br><br>bottom line">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel Title="面板3" BoxFlex="1" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label EncodeText="false" Text="BoxFlex=1">
                    </f:Label>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>
    <br />
    <br />
    <f:Panel ID="PanelExample13" IsFluid="true" ShowBorder="true" EnableCollapse="false"
             Layout="HBox" BoxConfigAlign="Start" BodyPadding="10" BoxConfigSpace="5" ShowHeader="true"
             Title="面板（Layout=HBox BoxConfigAlign=Start）">
        <Items>
            <f:Panel Title="面板1" Width="200" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label EncodeText="false" Text="Width=200">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="PanelExample15" Title="面板2" Width="200" Height="250" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label EncodeText="false" Text="Width=200 Height=250">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel Title="面板3" BoxFlex="1" BodyPadding="10" ShowBorder="true" ShowHeader="false">
                <Items>
                    <f:Label EncodeText="false" Text="BoxFlex=1">
                    </f:Label>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>
    <br />
    <br />
}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示对比自动高度下子项纵向拉伸的效果。</p>
    <h3><i class="f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照布局与尺寸变化</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="PanelExample1" title="第 1 个面板（面板（Layout=HBox）（默认值：BoxConfigAlign=Stretch））">第 1 个面板（面板（Layout=HBox）（默认值：BoxConfigAlign=Stretch））</strong>中对照同排子项的底边与不同内容长度。<br />结果：开启拉伸的一组按同排内容确定共同高度，其它组保留各自自然高度。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>BoxConfigAlign</code>（<strong class="example-control-reference" data-example-control="PanelExample9" title="第 9 个面板（面板（Layout=HBox BoxConfigAlign=Start））">第 9 个面板（面板（Layout=HBox BoxConfigAlign=Start））</strong>、<strong class="example-control-reference" data-example-control="PanelExample13" title="第 13 个面板（面板（Layout=HBox BoxConfigAlign=Start））">第 13 个面板（面板（Layout=HBox BoxConfigAlign=Start））</strong>）：指定盒布局中交叉方向的对齐或伸展方式。 本页使用<code>Start</code>。</li>
        <li><code>Height</code>（<strong class="example-control-reference" data-example-control="PanelExample7" title="第 5 个面板（面板（Layout=HBox）（默认值：BoxConfigAlign=Stretch））的面板2">第 5 个面板（面板（Layout=HBox）（默认值：BoxConfigAlign=Stretch））的面板2</strong>、<strong class="example-control-reference" data-example-control="PanelExample15" title="第 13 个面板（面板（Layout=HBox BoxConfigAlign=Start））的面板2">第 13 个面板（面板（Layout=HBox BoxConfigAlign=Start））的面板2</strong>）：显式高度限定可用区域；未设置固定高度的对照组按内容和父布局计算。 本页使用<code>250</code>。</li>
    </ul>
</section>
}
