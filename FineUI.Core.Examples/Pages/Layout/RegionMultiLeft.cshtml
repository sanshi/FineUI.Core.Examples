                    <f:Label ID="Label6" Text="左侧面板的内容">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="panel3" RegionPosition="Left" RegionSplit="true" EnableCollapse="true"
                     Width="200" Title="左侧面板" ShowBorder="true" ShowHeader="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label7" Text="左侧面板的内容">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="panelCenterRegion" RegionPosition="Center" Title="中间面板" ShowBorder="true" ShowHeader="true" BodyPadding="10">
