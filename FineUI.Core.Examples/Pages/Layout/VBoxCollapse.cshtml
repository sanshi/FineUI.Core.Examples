@page
@model FineUI.Core.Examples.Pages.Layout.VBoxCollapseModel
@{
    ViewBag.Title = "Layout/VBoxCollapse";


    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel2" IsFluid="true" Height="550" ShowBorder="true" EnableCollapse="true"
             Layout="VBox" BoxConfigChildMargin="0 0 5 0" BodyPadding="10"
             ShowHeader="true" Title="面板（Layout=VBox）">
        <Items>
            <f:Panel ID="Panel3" Title="面板1" Height="120"
                     BodyPadding="10" ShowBorder="true" ShowHeader="true" EnableCollapse="true">
                <Items>
                    <f:Label ID="Label2" Text="Height=120px">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="Panel1" Title="面板2" BoxFlex="1"
                     BodyPadding="10" ShowBorder="true" ShowHeader="true" EnableCollapse="true">
                <Items>
                    <f:Label ID="Label1" Text="BoxFlex=1">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="Panel4" Title="面板3" BoxFlex="2" Margin="0"
                     BodyPadding="10" ShowBorder="true" ShowHeader="true" EnableCollapse="true">
                <Items>
                    <f:Label ID="Label3" Text="BoxFlex=2 Margin=0">
                    </f:Label>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>


}

