@page
@model FineUI.Core.Examples.Pages.Layout.VBoxCollapseModel
@{
    ViewBag.Title = "Layout/VBoxCollapse";


    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel2" IsFluid="true" Height="550" ShowBorder="true" EnableCollapse="true"
             Layout="VBox" BoxConfigSpace="5" BodyPadding="10"
             ShowHeader="true" Title="面板（Layout=VBox）">
        <Items>
            <f:Panel ID="Panel3" Title="面板1" Height="120"
                     BodyPadding="10" ShowBorder="true" ShowHeader="true" EnableCollapse="true">
                <Items>
                    <f:Label ID="Label2" Text="Height=120px">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="Panel1" Title="面板2" BoxFlex="1"
                     BodyPadding="10" ShowBorder="true" ShowHeader="true" EnableCollapse="true">
                <Items>
                    <f:Label ID="Label1" Text="BoxFlex=1">
                    </f:Label>
                </Items>
            </f:Panel>
            <f:Panel ID="Panel4" Title="面板3" BoxFlex="2"
                     BodyPadding="10" ShowBorder="true" ShowHeader="true" EnableCollapse="true">
                <Items>
                    <f:Label ID="Label3" Text="BoxFlex=2 末项无额外间隔">
                    </f:Label>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>


}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示在纵向盒布局中折叠子面板后重新分配高度。</p>
    <h3><i class="f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照布局与尺寸变化</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Panel2" title="面板（Layout=VBox）">面板（Layout=VBox）</strong>中折叠一个有折叠入口的子面板，再重新展开。<br />结果：收起时释放内容区高度，其它可伸展面板重新分配空间；展开后恢复分配。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="Panel2" title="面板（Layout=VBox）">面板（Layout=VBox）</strong>）：设为<code>VBox</code>，父容器使用本页对应的布局方式，决定其直接子项的排列。</li>
        <li><code>EnableCollapse</code>（<strong class="example-control-reference" data-example-control="Panel2" title="面板（Layout=VBox）">面板（Layout=VBox）</strong>、<strong class="example-control-reference" data-example-control="Panel3" title="面板1">面板1</strong>、<strong class="example-control-reference" data-example-control="Panel1" title="面板2">面板2</strong>、<strong class="example-control-reference" data-example-control="Panel4" title="面板3">面板3</strong>）：设为<code>true</code>，允许子面板折叠，折叠后父布局重新分配空间。</li>
        <li><code>BoxFlex</code>（<strong class="example-control-reference" data-example-control="Panel1" title="面板2">面板2</strong>、<strong class="example-control-reference" data-example-control="Panel4" title="面板3">面板3</strong>）：各组分别设为<code>1</code>、<code>2</code>，直接子项按此比例分配父容器剩余空间。</li>
    </ul>
</section>
}
