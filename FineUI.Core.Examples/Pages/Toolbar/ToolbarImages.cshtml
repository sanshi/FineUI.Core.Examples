@page
@model FineUI.Core.Examples.Pages.Toolbar.ToolbarImagesModel
@{
    ViewBag.Title = "Toolbar/ToolbarImages";
    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel1" IsFluid="true" Title="面板" Height="250" EnableCollapse="false">
        <Toolbars>
            <f:Toolbar Position="Top">
                <Items>
                    <f:Image ID="Image1" ImageWidth="16" Icon="ArrowRight">
                    </f:Image>
                    <f:LinkButton ID="Button1" Text="按钮一" ClickHandler="onButton1Click">
                    </f:LinkButton>
                    <f:Image ID="Image2" ImageWidth="16" Icon="World">
                    </f:Image>
                    <f:LinkButton ID="Button2" Text="按钮二" ClickHandler="onButton2Click">
                    </f:LinkButton>
                    <f:Image ID="Image3" ImageWidth="16" Icon="Cake">
                    </f:Image>
                    <f:LinkButton ID="Button3" Text="按钮三" ClickHandler="onButton3Click">
                    </f:LinkButton>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Panel>
    <br>
    <br>


}


@section script {

    <script>

        // 布局时图片尚未加载，所以需要在图片完成加载后重新布局
        F.ready(function () {

            // 返回 Deferred 对象数组
            var imagdefs = $('.toobar-img img').map(function () {
                var imgEl = $(this);
                return $.Deferred(function (def) {
                    imgEl.on('load', function () {
                        //console.log('load img:' + imgEl.attr('src'));
                        def.resolve();
                    });
                }).promise();
            });

            // 等工具栏上的全部图片加载完毕后，再重新布局
            $.when.apply($, $.makeArray(imagdefs)).done(function () {
                F.ui.Panel1.doLayout();
                //console.log('OK');
            });

        });

        function onButton1Click(event) {
            alert('Button1');
        }

        function onButton2Click(event) {
            alert('Button2');
        }

        function onButton3Click(event) {
            alert('Button3');
        }

    </script>

}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示工具栏图片加载完成后重新布局，使图片与按钮按实际尺寸排列。</p>
    <h3><i class="f-iconfont f-iconfont-pic" aria-hidden="true"></i>核对图片加载后的排列</h3>
    <ul>
        <li>打开页面，对照<strong class="example-control-reference" data-example-control="Panel1" title="面板">面板</strong>内图片及相邻按钮的位置。<br />结果：本页脚本等待工具栏图片加载完成，再重新布局面板，避免使用未加载时的图片尺寸。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <ul>
        <li>由于页面布局时图片尚未加载，所以会造成布局错乱</li>
        <li>需要自己通过脚本在所有图片加载完毕后，重新对面板进行布局</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>load</code>（<strong>工具栏图片</strong>）：图片完成加载后才统计当前尺寸。</li>
        <li><code>doLayout()</code>（<strong class="example-control-reference" data-example-control="Panel1" title="面板">面板</strong>）：重新计算包含工具栏的面板布局。</li>
    </ul>
</section>
}
