@page
@model FineUI.Core.Examples.Pages.Toolbar.ToolbarCustomBgModel
@{
    ViewBag.Title = "Toolbar/ToolbarCustomBg";
    var F = Html.F();
}


@section body {

    <f:Panel ID="PanelExample1" IsFluid="true" ShowBorder="true" BodyPadding="10" Title="面板" EnableCollapse="false">
        <Content>
            <p>
                <a href="http://tech.163.com/special/jobsdead/" target="_blank"><b>乔布斯</b></a>
            </p>
            <p>
                乔布斯于1955年2月24日出生，苹果创始人之一。今年8月苹果超越埃克森美孚成为全球最大市值企业，截止上季度持有现金达到762亿美金，甚至超过了美国政府国库存款。
            </p>
            <p>
                遗憾的是，苹果的取得巨大成功还是无法给乔布斯一个健康的身体，乔布斯2003年被发现患有胰脏癌，随后又查出肝癌，危在旦夕的乔布斯在经历了8年的抗癌斗争、3次病休、若干次手术后，于2011年8月25日正式宣布从CEO位置辞职。2011年10月6日，乔布斯在苹果发布iPhone 4S后的第二天与世长辞。
            </p>
        </Content>
        <Toolbars>
            <f:Toolbar ToolbarAlign="Right" CssClass="f-state-default">
                <Items>
                    <f:Button ID="Button1" EnableDefaultState="false" Icon="Table" Text="按钮一"></f:Button>
                    <f:Button ID="Button2" Enabled="false" EnableDefaultState="false" Icon="New" Text="按钮二"></f:Button>
                    <f:ToolbarSeparator></f:ToolbarSeparator>
                    <f:Button ID="Button3" Enabled="false" EnableDefaultState="false" Icon="DatabaseSave" Text="按钮三"></f:Button>
                    <f:Button ID="Button4" EnableDefaultState="false" IconFont="_User" Text="按钮四"></f:Button>
                    <f:ToolbarSeparator></f:ToolbarSeparator>
                    <f:Button ID="Button5" EnableDefaultState="false" IconFont="_Phone" Text="按钮五"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Panel>


}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示用自定义背景显示工具栏，并让按钮使用与背景协调的简化外观。</p>
    <h3><i class="f-iconfont f-iconfont-pic" aria-hidden="true"></i>对照背景与按钮状态</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="PanelExample1" title="面板">面板</strong>对照普通按钮与禁用按钮。<br />结果：工具栏显示本页 CSS 背景，按钮不使用通常的块状默认底色；禁用按钮仍不可点击。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableDefaultState</code>（本页各按钮，如<strong class="example-control-reference" data-example-control="Button1" title="按钮一">按钮一</strong>）：设为<code>false</code>，本页按钮设为 <code>false</code>，简化默认外观。</li>
    </ul>
</section>
}
