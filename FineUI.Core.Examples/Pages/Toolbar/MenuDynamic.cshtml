@page
@model FineUI.Core.Examples.Pages.Toolbar.MenuDynamicModel
@{
    ViewBag.SourceFiles = "~/wwwroot/content/toolbar/menu.xml";
    ViewBag.Title = "Toolbar/MenuDynamic";
    var F = Html.F();
}


@section body {

    <f:Panel ID="PanelExample1" IsFluid="true" ShowBorder="true" BodyPadding="10" Height="300" Title="面板" EnableCollapse="false">
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Position="Top">
            </f:Toolbar>
        </Toolbars>
    </f:Panel>



}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示后台读取节点数据，动态创建工具栏按钮及它的多级菜单。</p>
    <h3><i class="f-iconfont f-iconfont-list" aria-hidden="true"></i>使用动态生成的菜单</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="PanelExample1" title="面板">面板</strong>中新生成的菜单按钮，再展开下一层菜单。<br />结果：菜单按数据层级出现；带链接的叶子菜单项按其配置打开页面。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Items</code>（<strong class="example-control-reference" data-example-control="PanelExample1" title="面板">面板</strong>）：后台把新建按钮加入工具栏集合。</li>
        <li><code>Menu.Items.Add()</code>（<strong class="example-control-reference" data-example-control="PanelExample1" title="面板">面板</strong>）：根据数据递归添加子菜单，叶子项另外配置链接。</li>
    </ul>
</section>
}
