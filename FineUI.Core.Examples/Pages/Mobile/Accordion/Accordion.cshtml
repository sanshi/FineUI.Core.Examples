@page
@model FineUI.Core.Examples.Pages.Mobile.Accordion.AccordionModel
@{
    ViewBag.Title = "MobileAccordion/Accordion";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section body {

    <f:Accordion ID="Accordion1" ShowHeader="false" ShowBorder="false" ActivePaneIndex="1" IsViewPort="true">
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Title="手风琴控件" HeaderStyle="true">
            </f:Toolbar>
        </Toolbars>
        <Panes>
            <f:AccordionPane ID="AccordionPane1" Title="面板一" IconUrl="@Url.Content("~/res/images/16/1.png")" BodyPadding="2px 5px">
                <Items>
                    <f:Label ID="Label1" Text="面板一中的文本">
                    </f:Label>
                </Items>
            </f:AccordionPane>
            <f:AccordionPane ID="AccordionPane2" Title="面板二（列表）" IconUrl="@Url.Content("~/res/images/16/4.png")" Layout="Fit">
                <Items>
                    <f:DataList ID="DataList1">
                        <f:DataListItem Value="item1" Text="列表项1" />
                        <f:DataListItem Value="item2" Text="列表项2" />
                        <f:DataListItem Value="item3" Text="列表项3" />
                        <f:DataListItem Value="item4" Text="列表项4" />
                        <f:DataListItem Value="item5" Text="列表项5" />
                    </f:DataList>
                </Items>
            </f:AccordionPane>
            <f:AccordionPane ID="AccordionPane3" Title="面板三（IFrame）" IconUrl="@Url.Content("~/res/images/16/7.png")"
                             EnableIFrame="true" IFrameUrl="@Url.Content("~/Mobile/Button/Button")">
            </f:AccordionPane>
        </Panes>
    </f:Accordion>
}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示移动手风琴面板的互斥展开和当前内容切换。</p>
    <h3><i class="f-iconfont f-iconfont-list" aria-hidden="true"></i>切换展开的面板</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Accordion1" title="手风琴">手风琴</strong>依次点击不同面板标题。<br />结果：新面板展开，之前展开的面板收起，内容仍属于各自面板。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>ActivePaneIndex</code>（<strong class="example-control-reference" data-example-control="Accordion1" title="手风琴">手风琴</strong>）：控制初始展开位置，索引从 <code>0</code> 开始。 本页使用<code>1</code>。</li>
        <li><code>EnableFill</code>（<strong class="example-control-reference" data-example-control="Accordion1" title="手风琴">手风琴</strong>）：当前展开面板使用手风琴剩余空间。</li>
    </ul>
</section>
}
