@page
@model FineUI.Core.Examples.Pages.Mobile.DataList.DataListImageTitleModel
@{
    ViewBag.Title = "MobileDataList/DataListImageTitle";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section head {

    <link href="~/res/css/datalist.css" rel="stylesheet" />
    <style>
        .item-desc {
            word-break: break-all;
            white-space: normal;
        }
    </style>

}


@section body {


    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" AutoScroll="true" IsViewPort="true">
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Title="列表" HeaderStyle="true">
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:DataList ID="DataList1">
            </f:DataList>
        </Items>
    </f:Panel>


}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示在移动列表项中同时显示图片、标题和描述文字。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-pic" aria-hidden="true"></i>对照图文项目</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="DataList1"
                    title="数据列表">数据列表</strong>对照中国、美国等项目的国旗、名称和介绍。<br />结果：每个项目保留独立的图片与文字区域，较长介绍在本页布局中显示。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Text</code>（<strong>列表项目</strong>，位于<strong class="example-control-reference" data-example-control="DataList1"
                    title="数据列表">数据列表</strong>）：由本页固定模板组合标题与介绍。</li>
            <li><code>Items</code>（<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：各项目使用对应的图片和业务文字。</li>
        </ul>
    </section>
}
