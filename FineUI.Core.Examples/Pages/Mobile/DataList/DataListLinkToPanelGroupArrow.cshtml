@page
@model FineUI.Core.Examples.Pages.Mobile.DataList.DataListLinkToPanelGroupArrowModel
@{
    ViewBag.Title = "MobileDataList/DataListLinkToPanelGroupArrow";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section head {

    <link href="~/res/css/datalist.css" rel="stylesheet" />
    <style>
        .item-desc.china {
            white-space: normal;
        }
    </style>
}

@section body {

    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" AutoScroll="true" IsViewPort="true">
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Title="列表" HeaderStyle="true">
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:DataList ID="DataList1" EnableGroup="true">
            </f:DataList>
        </Items>
    </f:Panel>
    <f:Panel ID="Panel2" ShowHeader="false" ShowBorder="false" Hidden="true"
             BodyPadding="10px" IsViewPort="true" Layout="Fit">
        <Toolbars>
            <f:Toolbar ID="Toolbar2" Title="Panel2" HeaderStyle="true">
                <Items>
                    <f:Button ID="Button4" Text="后退" ClickHandler="onBacktoPanel1Click"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:Label ID="Label2" EncodeText="false"></f:Label>
        </Items>
    </f:Panel>

}


@section script {

    <script>

        function onBacktoPanel1Click(event) {
            F.slideRight('Panel2', 'Panel1');
        }

        F.ready(function () {

            var dataList1 = F.ui.DataList1; if (!dataList1) return;
            dataList1.el.on('click', 'a.f-datalist-item-inner', function (event) {
                var innerEl = $(this);

                var text = innerEl.find('.item-text').text();
                var desc = innerEl.find('.item-desc').text();
                var imageUrl = innerEl.find('.item-img').attr('src');
                F.ui.Toolbar2.setTitle(text);
                F.ui.Label2.setValue('<div style="text-align:center;margin-bottom:15px;"><img style="width:60px;" src="' + imageUrl + '"/></div>' + desc);


                F.slideLeft('Panel1', 'Panel2');
            });

        });

    </script>

}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示按项目控制可点击状态与右侧箭头，并从可用项目进入详情。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>进入详情并返回列表</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>点击中国项，对照欧洲组的右侧箭头。<br />结果：中国项被本页配置为不可点击，不进入详情；只有指定组显示箭头。</li>
        <li>在<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>点击一个可用的国家项目。<br />结果：浏览器把该项目的标题、图片及介绍填入详情面板，再滑入对应详情；不会固定显示第一次点击的项目。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button4" title="后退">后退</strong>。<br />结果：滑回原列表，分组与列表项目继续保留，可以进入另一项。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>el.on(&quot;click&quot;, …)</code>（<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：本页把点击委托给列表中的实际链接或详情按钮，根据当前项内容更新详情面板。</li>
        <li><code>EnableGroup</code>（<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：初始为<code>true</code>，按本页地区分组显示组头。</li>
        <li><code>Group</code>（<strong>列表项目</strong>，位于<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：为项目指定亚洲、欧洲、美洲等分组。</li>
        <li><code>ShowArrow</code>（<strong>列表项目</strong>，位于<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：只为本页指定组的项目显示右侧箭头。</li>
        <li><code>NavigateUrl</code>（<strong>列表项目</strong>，位于<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：中国项未设置链接，脚本只响应其它项的链接点击。</li>
    </ul>
</section>
}
