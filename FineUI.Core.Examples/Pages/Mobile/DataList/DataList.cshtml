@page
@model FineUI.Core.Examples.Pages.Mobile.DataList.DataListModel
@{
    ViewBag.Title = "MobileDataList/DataList";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section body {


    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" AutoScroll="true" IsViewPort="true">
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Title="列表" HeaderStyle="true">
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:DataList ID="DataList1">
                <f:DataListItem Value="item1" Text="列表项1" />
                <f:DataListItem Value="item2" Text="列表项2" />
                <f:DataListItem Value="item3" Text="列表项3" />
                <f:DataListItem Value="item4" Text="列表项4" />
                <f:DataListItem Value="item5" Text="列表项5" />
                <f:DataListItem Value="item6" Text="列表项6" />
                <f:DataListItem Value="item7" Text="列表项7" />
                <f:DataListItem Value="item8" Text="列表项8" />
                <f:DataListItem Value="item9" Text="一个很长很长很长很长很长很长很长很长很长很长很长很长很长很的列表项" />
            </f:DataList>
        </Items>
    </f:Panel>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示移动数据列表的顺序项目，以及长文字项目的显示和滚动。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>阅读列表与长文字</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="DataList1"
                    title="数据列表">数据列表</strong>从第一项向下滚动到最后一项。<br />结果：项目按声明顺序显示，末尾的长文字项目保留本页内容；容器可滚动查看超出部分。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Items</code>（<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：声明列表的项目与顺序。</li>
            <li><code>AutoScroll</code>（<strong class="example-control-reference" data-example-control="Panel1"
                    title="面板">面板</strong>）：初始为<code>true</code>，外层移动面板允许滚动查看超出视口的项目。</li>
        </ul>
    </section>
}
