@page
@model FineUI.Core.Examples.Pages.Mobile.DataList.DataListLinkModel
@{
    ViewBag.Title = "MobileDataList/DataListLink";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}

@section head {

    <link href="~/res/css/datalist.css" rel="stylesheet" />

}

@section body {


    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" AutoScroll="true" IsViewPort="true">
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Title="列表" HeaderStyle="true">
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:DataList ID="DataList1">
            </f:DataList>
        </Items>
    </f:Panel>

}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示移动列表中的链接项目在新页面打开目标地址，并显示右侧导航箭头。</p>
    <h3><i class="f-iconfont f-iconfont-link" aria-hidden="true"></i>打开项目链接</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>点击一个国家项目。<br />结果：按该项目配置的链接在新页面打开对应介绍，本页列表继续保留。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>NavigateUrl</code>（<strong>列表项目</strong>，位于<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：根据项目名称生成本页对应的介绍链接。</li>
        <li><code>Target</code>（<strong>列表项目</strong>，位于<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：在新页面打开链接。</li>
        <li><code>ShowArrow</code>（<strong>列表项目</strong>，位于<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：为链接项目显示右侧箭头，提示可以继续导航。</li>
    </ul>
</section>
}
