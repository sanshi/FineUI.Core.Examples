@page
@model FineUI.Core.Examples.Pages.Mobile.DataList.DataListSelectedValueArrayModel
@{
    ViewBag.Title = "MobileDataList/DataListSelectedValueArray";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section head {

    <link href="~/res/css/datalist.css" rel="stylesheet" />

}


@section body {

    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" AutoScroll="true" IsViewPort="true">
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Title="列表" HeaderStyle="true">
                <Items>
                    <f:Button Text="获取选中项" ID="btnSubmit" OnClick="btnSubmit_Click"></f:Button>
                </Items>
            </f:Toolbar>
            <f:Toolbar ID="ToolbarActions">
                <Items>
                    <f:Button ID="btnSetSelection" Text="设置选择" OnClick="btnSetSelection_Click"></f:Button>
                    <f:Button ID="btnClearSelection" Text="清空选择" OnClick="btnClearSelection_Click"></f:Button>
                    <f:Button ID="btnRebindSelection" Text="重绑并选中" OnClick="btnRebindSelection_Click"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:DataList ID="DataList1" SelectedValueArray="@(new string[] { "cn", "us" })" EnableMultiSelect="true" EnableSelect="true" DataValueField="Id">
            </f:DataList>
        </Items>
    </f:Panel>

}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示移动列表的初始多选集合，并区分普通点击与后台明确设置多项。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>修改并读取选择</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>点击<code>中国</code>，再点击<code>法国</code>。<br />结果：普通点击把当前选择移到新项目；支持多选不代表默认普通点击就累加。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnSubmit" title="获取选中项">获取选中项</strong>。<br />结果：读取当前项目值或值数组，提示与列表现在的选择一致。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnClearSelection" title="清空选择">清空选择</strong>。<br />结果：移除当前选择高亮，列表项目仍然保留。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnSetSelection" title="设置选择">设置选择</strong>。<br />结果：按本页按钮指定的稳定项值设置选择。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnRebindSelection" title="重绑并选中">重绑并选中</strong>。<br />结果：先替换列表数据，再按新集合中的稳定项值恢复本页指定选择。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableSelect</code>（<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：初始为<code>true</code>，允许点击列表项目进行选择。</li>
        <li><code>SelectedValueArray</code>（<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：使用稳定的项目值记录当前选择，不依赖显示顺序。</li>
        <li><code>EnableMultiSelect</code>（<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：初始为<code>true</code>，允许选择集合包含多个项目。</li>
    </ul>
</section>
}
