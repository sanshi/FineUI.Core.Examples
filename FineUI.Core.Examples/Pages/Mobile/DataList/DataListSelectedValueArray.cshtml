@page
@model FineUI.Core.Examples.Pages.Mobile.DataList.DataListSelectedValueArrayModel
@{
    ViewBag.Title = "MobileDataList/DataListSelectedValueArray";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section head {

    <link href="~/res/css/datalist.css" rel="stylesheet" />

}


@section body {

    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" AutoScroll="true" IsViewPort="true">
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Title="列表" HeaderStyle="true">
                <Items>
                    <f:Button Text="获取选中项" ID="btnSubmit" OnClick="btnSubmit_Click"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:DataList ID="DataList1" SelectedValueArray="@(new string[] { "cn", "us" })" EnableMultiSelect="true" EnableSelect="true" DataValueField="Id">
            </f:DataList>
        </Items>
    </f:Panel>

}

