@page
@model FineUI.Core.Examples.Pages.Mobile.DataList.DataListDataBindModel
@{
    ViewBag.Title = "MobileDataList/DataListDataBind";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section head {

    <link href="~/res/css/datalist.css" rel="stylesheet" />
    <style>
        .item-desc {
            word-break: break-all;
            white-space: normal;
        }
    </style>

}


@section body {

    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" AutoScroll="true" IsViewPort="true">
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Title="列表" HeaderStyle="true">
                <Items>
                    <f:Button Text="重新绑定" ID="btnReDataBind" OnClick="btnReDataBind_Click"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:DataList ID="DataList1">
            </f:DataList>
        </Items>
    </f:Panel>


}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示把数据源绑定为移动列表，并重新绑定另一组数据。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>重新绑定替换项目</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="btnReDataBind"
                    title="重新绑定">重新绑定</strong>。<br />结果：重新读取本页下一组示例数据并替换列表，第一项内容随数据源变化；不是把两份数据叠加。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DataSource</code>（<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：提供本页待绑定的记录集合。
            </li>
            <li><code>DataBind()</code>（<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：根据当前数据源生成列表项目。
            </li>
        </ul>
    </section>
}
