@page
@model FineUI.Core.Examples.Pages.Mobile.Form.LoginValidateMessageBoxPlainModel
@{
    ViewBag.Title = "MobileForm/LoginValidateMessageBoxPlain";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section head {

    <style>
        .mypic {
            text-align: center;
        }

            .mypic img {
                border-radius: 50%;
                width: 100px;
                height: 100px;
            }

        .myhyperlinkcontainer {
            text-align: center;
            margin-top: 20px;
        }

        .myhyperlink {
            display: inline-block !important;
            margin-right: 5px;
        }

            .myhyperlink a {
                font-size: 0.8em;
            }
    </style>

}

@section body {

    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" Layout="Fit" BodyPadding="20px" IsViewPort="true">
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Title="系统登录" HeaderStyle="true">
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:SimpleForm ID="SimpleForm1" ShowBorder="false" ShowHeader="false" Layout="VBox" MessageTarget="None">
                <Items>
                    <f:Image CssClass="mypic" ImageUrl="@Url.Content("~/res/images/my-face-80.jpg")"></f:Image>
                    <f:TextBox ID="tbxUserName" Label="用户名" ShowLabel="false" EmptyText="请输入用户名" Required="true">
                    </f:TextBox>
                    <f:TextBox ID="tbxPassword" Label="密码" ShowLabel="false" TextMode="Password" EmptyText="请输入密码" Required="true">
                    </f:TextBox>
                    <f:Button ID="btnLogin" Text="登录" Type="Submit" _ValidateForms="SimpleForm1" ValidateMessageBoxPlain="true" OnClick="btnLogin_Click">
                    </f:Button>
                    <f:Panel CssClass="myhyperlinkcontainer" ShowBorder="false" ShowHeader="false">
                        <Items>
                            <f:HyperLink ID="HyperLink1" CssClass="myhyperlink" NavigateUrl="http://fineui.com/bbs/" Text="新用户注册"></f:HyperLink>
                            <f:HyperLink ID="HyperLink2" CssClass="myhyperlink" NavigateUrl="http://fineui.com/bbs/" Text="忘记密码？"></f:HyperLink>
                        </Items>
                    </f:Panel>
                </Items>
            </f:SimpleForm>
        </Items>
    </f:Panel>


}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示移动登录验证失败时使用简洁按钮样式的错误提示框。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>查看简洁错误提示</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="btnLogin"
                    title="登录">登录</strong>。<br />结果：空字段验证失败，浏览器显示本页简洁按钮样式的验证消息框，不发送账号处理请求。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ValidateMessageBoxPlain</code>（<strong class="example-control-reference" data-example-control="btnLogin"
                    title="登录">登录</strong>）：初始为<code>true</code>，登录按钮设为 <code>true</code>，验证消息框使用本页的简洁样式。</li>
            <li><code>MessageTarget</code>（<strong class="example-control-reference" data-example-control="SimpleForm1"
                    title="表单">表单</strong>）：初始为<code>None</code>，本页表单不在字段旁重复显示错误，集中交给消息框。</li>
        </ul>
    </section>
}
