@page
@model FineUI.Core.Examples.Pages.Mobile.Window.HideOnMaskClickModel
@{
    ViewBag.Title = "MobileWindow/HideOnMaskClick";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" Layout="VBox" BoxConfigSpace="5" BodyPadding="10px" IsViewPort="true">
        <Items>
            <f:Button ID="btnOpenWindow" Text="打开窗体一" ClickHandler="onOpenWindow1Click"></f:Button>
        </Items>
    </f:Panel>
    <f:Window ID="Window1" ShowHeader="false" Width="300" Hidden="true"
              IsModal="true" HideOnMaskClick="true" BodyPadding="10px" Layout="VBox">
        <Items>
            <f:ContentPanel ShowBorder="false" ShowHeader="false">
                <p>
                    <a href="http://baike.baidu.com/view/3645.htm" target="_blank"><b>比尔·盖茨</b></a>
                </p>
                <p>
                    比尔·盖茨（Bill Gates），全名威廉·亨利·盖茨三世，简称比尔或盖茨。1955年10月28日出生于美国华盛顿州西雅图，13岁开始计算机编程设计，18岁考入哈佛大学，一年后从哈佛退学，1975年与好友保罗·艾伦一起创办了微软公司，比尔盖茨担任微软公司董事长、CEO和首席软件设计师。
                </p>
            </f:ContentPanel>
            <f:Button ID="Button1" Text="打开窗体二" ClickHandler="onOpenWindow2Click"></f:Button>
        </Items>
    </f:Window>

    <f:Window ID="Window2" ShowHeader="false" Width="300" Hidden="true"
              IsModal="true" HideOnMaskClick="true" BodyPadding="10px">
        <Content>
            <p>
                <a href="http://tech.163.com/special/jobsdead/" target="_blank"><b>乔布斯</b></a>
            </p>
            <p>
                乔布斯于1955年2月24日出生，苹果创始人之一，近年来多次被评为全美最佳CEO，业界评论“苹果就是乔布斯，乔布斯就是苹果”。
            </p>
        </Content>
    </f:Window>
}


@section script {

    <script>

        function onOpenWindow1Click(event) {
            F.ui.Window1.show();
        }

        function onOpenWindow2Click(event) {
            F.ui.Window2.show();
        }

    </script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示点击遮罩隐藏当前模态窗体，并在第一层窗体中继续打开第二层。</p>
    <h3><i class="f-iconfont f-iconfont-window" aria-hidden="true"></i>按当前层级点击遮罩</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="btnOpenWindow" title="打开窗体一">打开窗体一</strong>。<br />结果：第一层窗体与遮罩显示。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button1" title="打开窗体二">打开窗体二</strong>。<br />结果：第二层成为当前活动窗体，第一层仍保留。</li>
        <li>点击当前窗体之外的遮罩区域。<br />结果：当前活动窗体隐藏，下层窗体按本页原有状态保留；再次点击对应遮罩可关闭下一层。</li>
    </ol>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>HideOnMaskClick</code>（<strong class="example-control-reference" data-example-control="Window1" title="第 1 个窗口">第 1 个窗口</strong>、<strong class="example-control-reference" data-example-control="Window2" title="第 2 个窗口">第 2 个窗口</strong>）：本页两个窗体都允许点击遮罩隐藏。 本页使用<code>true</code>。</li>
        <li><code>IsModal</code>（<strong class="example-control-reference" data-example-control="Window1" title="第 1 个窗口">第 1 个窗口</strong>、<strong class="example-control-reference" data-example-control="Window2" title="第 2 个窗口">第 2 个窗口</strong>）：为对应窗体显示模态遮罩。 本页使用<code>true</code>。</li>
    </ul>
</section>
}
