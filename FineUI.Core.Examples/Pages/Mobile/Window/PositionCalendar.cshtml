@page
@model FineUI.Core.Examples.Pages.Mobile.Window.PositionCalendarModel
@{
    ViewBag.Title = "MobileWindow/PositionCalendar";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section head {

    <style>
        .mybgpanel > .f-panel-bodyct > .f-panel-body {
            background-color: #FEF3D5;
            background-image: url(@Url.Content("~/res/images/bg/small/3.jpg"));
            background-position: right bottom;
            background-repeat: no-repeat;
        }

        .mywindow,
        .mywindow > .f-panel-bodyct > .f-panel-body {
            background-image: none;
            background-color: transparent;
            -moz-box-shadow: none;
            -webkit-box-shadow: none;
            box-shadow: none;
        }
    </style>

}

@section body {

    <f:Panel ID="Panel1" CssClass="mybgpanel" ShowBorder="false" ShowHeader="false" Layout="VBox" BoxConfigSpace="5" BodyPadding="10px" IsViewPort="true">
        <Items>
            <f:Button ID="btnOpenWindow" Text="选择日期" ClickHandler="onOpenWindow1Click"></f:Button>
        </Items>
    </f:Panel>
    <f:Window ID="Window1" CssClass="mywindow" ShowHeader="false" ShowBorder="false" Hidden="true" HideOnMaskClick="true"
              IsModal="true" BodyPadding="10px" Layout="VBox" BoxConfigSpace="5"
              PercentWidth="100%" EnableDefaultCorner="false" PositionY="Bottom">
        <Items>
            <f:Calendar ID="Calendar1" DateFormatString="yyyy-MM-dd" MarginBottom="10">
                <Listeners>
                    <f:Listener Event="select" Handler="onCalendar1Select" />
                </Listeners>
            </f:Calendar>
            <f:Button ID="Button3" Text="取消" ClickHandler="onCloseWindow1Click"></f:Button>
        </Items>
    </f:Window>


}


@section script {


    <script>

        function onOpenWindow1Click(event) {
            F.ui.Window1.show();
        }

        function onCloseWindow1Click(event) {
            F.ui.Window1.hide();
        }


        function onCalendar1Select(event) {
            F.ui.Window1.hide();
            showCenterNotify('你选择的日期是：' + F.ui.Calendar1.getText());
        }

    </script>

}



@section exampleDescription {
<section aria-label="页面描述">
    <p>演示从底部打开日历面板，选定日期后隐藏面板并显示选择结果。</p>
    <h3><i class="f-iconfont f-iconfont-list" aria-hidden="true"></i>在日历中选择日期</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="btnOpenWindow" title="选择日期">选择日期</strong>。<br />结果：底部动作面板显示本页日历。</li>
        <li>在<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>点击一个可选日期。<br />结果：客户端读取当前日期，隐藏动作面板，并按本页格式显示选择提示。</li>
    </ol>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>PositionY</code>（<strong class="example-control-reference" data-example-control="Window1" title="窗口">窗口</strong>）：设为<code>Bottom</code>，选择面板贴底显示。</li>
        <li><code>DateFormatString</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：设为<code>yyyy-MM-dd</code>，按本页 <code>yyyy</code>-<code>MM</code>-<code>dd</code> 格式显示选择结果。</li>
        <li><code>select</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：日历选择完成后执行本页结果处理。</li>
    </ul>
</section>
}
