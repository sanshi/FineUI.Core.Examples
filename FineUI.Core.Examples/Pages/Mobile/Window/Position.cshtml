@page
@model FineUI.Core.Examples.Pages.Mobile.Window.PositionModel
@{
    ViewBag.Title = "MobileWindow/Position";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" Layout="VBox" BoxConfigChildMargin="0 0 5px 0" BodyPadding="10px" IsViewPort="true">
        <Items>
            <f:Button ID="Button1" Text="左侧窗体" ClickHandler="onOpenWindow1Click"></f:Button>
            <f:Button ID="Button2" Text="右侧窗体" ClickHandler="onOpenWindow2Click"></f:Button>
            <f:Button ID="Button3" Text="顶部窗体" ClickHandler="onOpenWindow3Click"></f:Button>
            <f:Button ID="Button4" Text="底部窗体" ClickHandler="onOpenWindow4Click"></f:Button>
            <f:Button ID="Button5" Text="居中窗体" ClickHandler="onOpenWindow5Click"></f:Button>
        </Items>
    </f:Panel>
    <f:Window ID="Window1" ShowHeader="false" Hidden="true"
              IsModal="true" HideOnMaskClick="true" BodyPadding="10px"
              Width="150" EnableDefaultCorner="false" PositionX="Left">
        <Items>
            <f:ContentPanel ShowBorder="false" ShowHeader="false">
                <p>
                    <a href="http://baike.baidu.com/view/3645.htm" target="_blank"><b>比尔·盖茨</b></a>
                </p><p>
                    比尔·盖茨（Bill Gates），全名威廉·亨利·盖茨三世，简称比尔或盖茨。1975年与好友保罗·艾伦一起创办了微软公司，比尔盖茨担任微软公司董事长、CEO和首席软件设计师。
                </p>
            </f:ContentPanel>
        </Items>
    </f:Window>
