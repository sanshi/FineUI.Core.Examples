}


@section script {

    <script>

        function onOpenWindow1Click(event) {
            F.ui.Window1.show();
        }

        function onOpenWindow2Click(event) {
            F.ui.Window2.show();
        }

        function onOpenWindow3Click(event) {
            F.ui.Window3.show();
        }

        function onOpenWindow4Click(event) {
            F.ui.Window4.show();
        }

        function onOpenWindow5Click(event) {
