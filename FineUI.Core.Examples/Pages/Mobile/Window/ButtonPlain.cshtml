@page
@model FineUI.Core.Examples.Pages.Mobile.Window.ButtonPlainModel
@{
    ViewBag.Title = "MobileWindow/ButtonPlain";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" Layout="VBox" BoxConfigChildMargin="0 0 5px 0" BodyPadding="10px" IsViewPort="true">
        <Items>
            <f:Button ID="btnOpenWindow" Text="打开登陆窗体" ClickHandler="onOpenWindowClick"></f:Button>
        </Items>
    </f:Panel>
    <f:Window ID="Window1" Title="登陆窗体" TitleAlign="Center" Hidden="true" IsModal="true" EnableClose="false" Layout="Fit" BodyPadding="15px" Width="300">
        <Items>
            <f:SimpleForm ID="SimpleForm1" ShowBorder="false" ShowHeader="false" Layout="VBox" MessageTarget="None">
                <Items>
                    <f:TextBox ID="tbxUserName" Label="用户名" ShowLabel="false" EmptyText="请输入用户名" Required="true">
                    </f:TextBox>
                    <f:TextBox ID="tbxPassword" Label="密码" ShowLabel="false" TextMode="Password" EmptyText="请输入密码" Required="true">
                    </f:TextBox>
                </Items>
            </f:SimpleForm>
        </Items>
        <Toolbars>
            <f:Toolbar ID="Toolbar1" CssClass="f-toolbar-buttonplain" Position="Bottom" Layout="Fit">
                <Items>
                    <f:ButtonGroup ID="ButtonGroup1" Layout="HBox">
                        <Items>
                            <f:Button ID="btnCancel" Text="取消" BoxFlex="1" ClickHandler="onCancelClick"></f:Button>
                            <f:Button ID="btnLogin" Text="登录" Type="Submit" BoxFlex="1" _ValidateForms="Window1" ValidateMessageBoxPlain="true" OnClick="btnLogin_Click">
                            </f:Button>
                        </Items>
                    </f:ButtonGroup>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Window>

}


@section script {

    <script>

        function onCancelClick(event) {
            F.ui.Window1.hide();
        }

        function onOpenWindowClick(event) {
            F.ui.Window1.show();
        }

    </script>

}