@page
@model FineUI.Core.Examples.Pages.Mobile.Window.PositionShengShiXianModel
@{
    ViewBag.Title = "MobileWindow/PositionShengShiXian";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}

@section head {

    <style>
        .mybgpanel > .f-panel-bodyct > .f-panel-body {
            background-color: #FEF3D5;
            background-image: url(@Url.Content("~/res/images/bg/small/3.jpg"));
            background-position: right bottom;
            background-repeat: no-repeat;
        }

        .mywindow,
        .mywindow > .f-panel-bodyct > .f-panel-body {
            background-image: none;
            background-color: transparent;
            -moz-box-shadow: none;
            -webkit-box-shadow: none;
            box-shadow: none;
        }
    </style>

}


@section body {


    <f:Panel ID="Panel1" CssClass="mybgpanel" ShowBorder="false" ShowHeader="false" Layout="VBox" BoxConfigChildMargin="0 0 5px 0" BodyPadding="10px" IsViewPort="true">
        <Items>
            <f:Button ID="btnOpenWindow" Text="选择省市县" ClickHandler="onOpenWindow1Click"></f:Button>
        </Items>
    </f:Panel>
    <f:Window ID="Window1" CssClass="mywindow" ShowHeader="false" ShowBorder="false" Hidden="true" HideOnMaskClick="true"
              IsModal="true" BodyPadding="10px" Layout="VBox" BoxConfigChildMargin="0 0 5px 0"
              PercentWidth="100%" EnableDefaultCorner="false" PositionY="Bottom">
        <Items>
            <f:SimpleForm ID="SimpleForm1" ShowBorder="true" ShowHeader="false" BodyPadding="10px" CssClass="f-corner-all"
                          Layout="VBox" MessageTarget="None" LabelAlign="Right">
                <Items>
                    <f:DropDownList ID="ddlSheng" Label="省份" ShowRedStar="true" CompareType="String" CompareValue="-1" CompareOperator="NotEqual" CompareMessage="请选择省份！" OnSelectedIndexChanged="ddlSheng_SelectedIndexChanged">
                    </f:DropDownList>
                    <f:DropDownList ID="ddlShi" Label="地区市" ShowRedStar="true" CompareType="String" CompareValue="-1" CompareOperator="NotEqual" CompareMessage="请选择地区市！" Enabled="false" OnSelectedIndexChanged="ddlShi_SelectedIndexChanged">
                        <f:ListItem Text="选择地区市" Value="-1"></f:ListItem>
                    </f:DropDownList>
                    <f:DropDownList ID="ddlXian" ShowRedStar="true" CompareType="String" CompareValue="-1" CompareOperator="NotEqual" CompareMessage="请选择县区市！" Label="县区市" Enabled="false">
                        <f:ListItem Text="选择县区市" Value="-1"></f:ListItem>
                    </f:DropDownList>
                    <f:Panel ShowBorder="false" ShowHeader="false" Layout="HBox">
                        <Items>
                            <f:Button ID="Button3" Width="100" Text="取消" MarginRight="10" ClickHandler="onCloseWindow1Click"></f:Button>
                            <f:Button ID="Button1" BoxFlex="1" Text="选择" _ValidateForms="SimpleForm1" ValidateMessageBoxPlain="true"
                                      OnClick="Button1_Click">
                            </f:Button>
                        </Items>
                    </f:Panel>
                </Items>
            </f:SimpleForm>
        </Items>
    </f:Window>

}


@section script {

    <script>

        function onOpenWindow1Click(event) {
            F.ui.Window1.show();
        }

        function onCloseWindow1Click(event) {
            F.ui.Window1.hide();
        }

    </script>

}