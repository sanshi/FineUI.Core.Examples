@page
@model FineUI.Core.Examples.Pages.Mobile.Window.PositionActionSheetModel
@{
    ViewBag.Title = "MobileWindow/PositionActionSheet";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section head {

    <style>
        .mybgpanel > .f-panel-bodyct > .f-panel-body {
            background-color: #FEF3D5;
            background-image: url(@Url.Content("~/res/images/bg/small/3.jpg"));
            background-position: right bottom;
            background-repeat: no-repeat;
        }
    </style>

}

@section body {

    <f:Panel ID="Panel1" CssClass="mybgpanel" ShowBorder="false" ShowHeader="false" Layout="VBox" BoxConfigChildMargin="0 0 5px 0" BodyPadding="10px" IsViewPort="true">
        <Items>
            <f:Button ID="btnOpenWindow" Text="动作面板" ClickHandler="onOpenWindow1Click"></f:Button>
        </Items>
    </f:Panel>
    <f:Window ID="Window1" ShowHeader="false" Hidden="true" HideOnMaskClick="true"
              IsModal="true" BodyPadding="10px" Layout="VBox" BoxConfigChildMargin="0 0 5px 0"
              PercentWidth="100%" EnableDefaultCorner="false" PositionY="Bottom">
        <Items>
            <f:Button ID="Button1" Size="Large" Text="相册" ClickHandler="onOpenAlbumClick"></f:Button>
            <f:Button ID="Button2" Size="Large" Text="拍照" MarginBottom="15" ClickHandler="onTakeAPictureClick"></f:Button>
            <f:Button ID="Button3" Text="取消" Margin="0" ClickHandler="onCloseWindow1Click"></f:Button>
        </Items>
    </f:Window>

}


@section script {


    <script>

        function onOpenWindow1Click(event) {
            F.ui.Window1.show();
        }

        function onCloseWindow1Click(event) {
            F.ui.Window1.hide();
        }


        function onOpenAlbumClick(event) {
            F.ui.Window1.hide();
            showCenterNotify('你点击了 [相册] 按钮！');
        }

        function onTakeAPictureClick(event) {
            F.ui.Window1.hide();
            showCenterNotify('你点击了 [拍照] 按钮！');
        }

    </script>

}
