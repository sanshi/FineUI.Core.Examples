@page
@model FineUI.Core.Examples.Pages.Mobile.Window.PositionActionSheetModel
@{
    ViewBag.Title = "MobileWindow/PositionActionSheet";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section head {

    <style>
        .mybgpanel > .f-panel-bodyct > .f-panel-body {
            background-color: #FEF3D5;
            background-image: url(@Url.Content("~/res/images/bg/small/3.jpg"));
            background-position: right bottom;
            background-repeat: no-repeat;
        }
    </style>

}

@section body {

    <f:Panel ID="Panel1" CssClass="mybgpanel" ShowBorder="false" ShowHeader="false" Layout="VBox" BoxConfigSpace="5" BodyPadding="10px" IsViewPort="true">
        <Items>
            <f:Button ID="btnOpenWindow" Text="动作面板" ClickHandler="onOpenWindow1Click"></f:Button>
        </Items>
    </f:Panel>
    <f:Window ID="Window1" ShowHeader="false" Hidden="true" HideOnMaskClick="true"
              IsModal="true" BodyPadding="10px" Layout="VBox" BoxConfigSpace="5"
              PercentWidth="100%" EnableDefaultCorner="false" PositionY="Bottom">
        <Items>
            <f:Button ID="Button1" Size="Large" Text="相册" ClickHandler="onOpenAlbumClick"></f:Button>
            <f:Button ID="Button2" Size="Large" Text="拍照" MarginBottom="15" ClickHandler="onTakeAPictureClick"></f:Button>
            <f:Button ID="Button3" Text="取消" ClickHandler="onCloseWindow1Click"></f:Button>
        </Items>
    </f:Window>

}


@section script {


    <script>

        function onOpenWindow1Click(event) {
            F.ui.Window1.show();
        }

        function onCloseWindow1Click(event) {
            F.ui.Window1.hide();
        }


        function onOpenAlbumClick(event) {
            F.ui.Window1.hide();
            showCenterNotify('你点击了 [相册] 按钮！');
        }

        function onTakeAPictureClick(event) {
            F.ui.Window1.hide();
            showCenterNotify('你点击了 [拍照] 按钮！');
        }

    </script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示从底部显示动作面板，用独立按钮提供操作与取消入口。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-window" aria-hidden="true"></i>选择动作或取消</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="btnOpenWindow" title="动作面板">动作面板</strong>。<br />结果：面板贴底并使用当前视口宽度，背景出现遮罩。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button2" title="拍照">拍照</strong>。<br />结果：浏览器隐藏面板并显示本页动作提示；示例并未真的调用设备相机。</li>
        <li>再次打开<strong class="example-control-reference" data-example-control="btnOpenWindow" title="动作面板">动作面板</strong>，点击<strong class="example-control-reference" data-example-control="Button3" title="取消">取消</strong>。<br />结果：只隐藏动作面板，不执行相册或拍照动作。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>PositionY</code>（<strong class="example-control-reference" data-example-control="Window1" title="窗口">窗口</strong>）：初始为<code>Bottom</code>，窗体贴底显示。</li>
        <li><code>PercentWidth</code>（<strong class="example-control-reference" data-example-control="Window1" title="窗口">窗口</strong>）：初始为<code>100%</code>，窗体占当前视口全部宽度。</li>
        <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="Window1" title="窗口">窗口</strong>）：初始为<code>VBox</code>，用 <code>VBox</code> 顺序放置独立动作按钮与取消按钮。</li>
    </ul>
</section>
}
