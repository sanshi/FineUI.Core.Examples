@page
@model FineUI.Core.Examples.Pages.Mobile.Button.ButtonGroupVerticalModel
@{
    ViewBag.Title = "MobileButton/ButtonGroupVertical";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" Layout="VBox" BoxConfigChildMargin="0 0 10px 0" BodyPadding="10px" AutoScroll="true" IsViewPort="true">
