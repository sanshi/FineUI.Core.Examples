            <f:ButtonGroup ID="ButtonGroup2" Layout="VBox" BoxConfigAlign="StretchMax" EnablePressGroup="true" Vertical="true">
                <Items>
                    <f:Button ID="Button4" Text="按钮一" Icon="Cake" EnablePress="true" Pressed="true">
                    </f:Button>
                    <f:Button ID="Button5" Text="按钮二" IconFont="_Bank" EnablePress="true">
                    </f:Button>
                    <f:Button ID="Button6" Text="按钮三" IconFont="_Group" EnablePress="true">
                    </f:Button>
                </Items>
            </f:ButtonGroup>
            <f:ButtonGroup ID="ButtonGroup6" Layout="VBox" BoxConfigAlign="StretchMaxCenter" EnablePressGroup="true" Vertical="true">
                <Items>
                    <f:Button ID="Button16" Text="按钮一" Icon="Cake" EnablePress="true">
                    </f:Button>
                    <f:Button ID="Button17" Text="按钮二" IconFont="_Bank" EnablePress="true" Pressed="true">
                    </f:Button>
                    <f:Button ID="Button18" Text="按钮三" IconFont="_Group" EnablePress="true">
                    </f:Button>
                </Items>
            </f:ButtonGroup>
            <f:ButtonGroup ID="ButtonGroup7" Layout="VBox" BoxConfigAlign="StretchMaxEnd" EnablePressGroup="true" Vertical="true">
                <Items>
                    <f:Button ID="Button19" Text="按钮一" Icon="Cake" EnablePress="true">
                    </f:Button>
                    <f:Button ID="Button20" Text="按钮二" IconFont="_Bank" EnablePress="true">
                    </f:Button>
                    <f:Button ID="Button21" Text="按钮三" IconFont="_Group" EnablePress="true" Pressed="true">
                    </f:Button>
                </Items>
            </f:ButtonGroup>
            <f:ButtonGroup ID="ButtonGroup8" Layout="VBox" BoxConfigAlign="Stretch" EnablePressGroup="true" Vertical="true">
                <Items>
                    <f:Button ID="Button22" Text="按钮一" Icon="Cake" EnablePress="true">
                    </f:Button>
                    <f:Button ID="Button23" Text="按钮二" IconFont="_Bank" EnablePress="true" Pressed="true">
                    </f:Button>
                    <f:Button ID="Button24" Text="按钮三" IconFont="_Group" EnablePress="true">
                    </f:Button>
                </Items>
            </f:ButtonGroup>
        </Items>
    </f:Panel>


}

