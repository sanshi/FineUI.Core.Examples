@page
@model FineUI.Core.Examples.Pages.Mobile.Message.ConfirmModel
@{
    ViewBag.Title = "MobileMessage/Confirm";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section body {


    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" Layout="VBox" BoxConfigSpace="10" BodyPadding="10px" IsViewPort="true">
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Title="确认对话框" HeaderStyle="true">
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:Button Text="确认对话框" ID="Button1" OnClick="Button1_Click">
            </f:Button>
            <f:Button Text="确认对话框（ButtonFill）" ID="Button2" OnClick="Button2_Click">
            </f:Button>
            <f:Button Text="确认对话框（ButtonPlain）" ID="Button6" OnClick="Button6_Click">
            </f:Button>
            <f:Button Text="确认对话框（CancelButtonAhead）" ID="Button3" OnClick="Button3_Click">
            </f:Button>
            <f:Button Text="确认对话框（自定义按钮文本，回发）" ID="Button4" ClickHandler="onButton4Click"></f:Button>
            <f:Button Text="确认对话框（自定义按钮宽度，回发）" ID="Button5" ClickHandler="onButton5Click"></f:Button>
        </Items>
    </f:Panel>

}


@section script {

    <script>

        function onButton4Click(event) {

            F.create({
                type: 'MessageBox',
                title: '确认退出',
                message: '您即将直接退出，请先保存已修改数据！',
                titleAlign: 'center',
                closable: false,
                buttonPlain: true,
                messageIcon: '',
                buttons: [{
                    buttonId: 'cancel',
                    text: '不退出'
                }, {
                    buttonId: 'ok',
                    text: '直接退出'
                }],
                handler: function (event, buttonId) {
                    // 触发后台事件
                    F.customEvent('Button4_ConfirmResult', buttonId);
                }
            });

        }


        function onButton5Click(event) {

            F.create({
                type: 'MessageBox',
                title: '确认退出',
                message: '您即将直接退出，请先保存已修改数据！',
                titleAlign: 'center',
                closable: false,
                buttonPlain: true,
                messageIcon: '',
                buttons: [{
                    buttonId: 'cancel',
                    text: '取消',
                    flex: 1
                }, {
                    buttonId: 'ok',
                    text: '直接退出',
                    flex: 2
                }],
                autoFocusButtonId: 'ok',
                handler: function (event, buttonId) {
                    // 触发后台事件
                    F.customEvent('Button5_ConfirmResult', buttonId);
                }
            });

        }

    </script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示移动确认对话框的结果处理与按钮样式。</p>
    <h3><i class="f-iconfont f-iconfont-window" aria-hidden="true"></i>打开并处理当前对话框</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="Button1" title="第 1 个按钮（确认对话框）">第 1 个按钮（确认对话框）</strong>。<br />结果：本页显示确认对话框。</li>
        <li>点击<strong>取消</strong>，再重新打开并确定。<br />结果：取消和确定进入各自处理分支；本页演示确认动作，并没有真实删除数据。</li>
    </ol>
    <h3><i class="f-iconfont f-iconfont-layout" aria-hidden="true"></i>比较按钮样式</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="Button2" title="确认对话框（ButtonFill）">确认对话框（ButtonFill）</strong>。<br />结果：对话框底部按钮填充可用宽度。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button6" title="确认对话框（ButtonPlain）">确认对话框（ButtonPlain）</strong>。<br />结果：对话框使用本页简洁按钮样式。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button3" title="确认对话框（CancelButtonAhead）">确认对话框（CancelButtonAhead）</strong>。<br />结果：取消按钮排列在确定按钮之前。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-refresh" aria-hidden="true"></i>回传自定义按钮结果</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="Button4" title="确认对话框（自定义按钮文本，回发）">确认对话框（自定义按钮文本，回发）</strong>。<br />结果：显示本页自定义按钮文字的确认框；点击后把对应结果传给本页处理函数，不代表真的退出系统。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>ButtonFill</code>（<strong>对话框配置</strong>）：让对话框按钮填满底部工具栏。</li>
        <li><code>ButtonPlain</code>（<strong>对话框配置</strong>）：使用本页简洁按钮外观。</li>
        <li><code>CancelButtonAhead</code>（<strong>对话框配置</strong>）：把取消入口排到确定之前。</li>
    </ul>
</section>
}
