@page
@model FineUI.Core.Examples.Pages.Mobile.Message.PromptModel
@{
    ViewBag.Title = "MobileMessage/Prompt";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" Layout="VBox" BoxConfigChildMargin="0 0 10px 0" BodyPadding="10px" IsViewPort="true">
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Title="输入对话框" HeaderStyle="true">
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:Button Text="输入对话框" ID="Button1" OnClick="Button1_Click">
            </f:Button>
            <f:Button Text="输入对话框（ButtonFill）" ID="Button2" OnClick="Button2_Click">
            </f:Button>
            <f:Button Text="输入对话框（ButtonPlain）" ID="Button5" OnClick="Button5_Click">
            </f:Button>
            <f:Button Text="输入对话框（ButtonPlain，密码）" ID="Button4" OnClick="Button4_Click">
            </f:Button>
            <f:Button Text="输入对话框（CancelButtonAhead）" ID="Button3" OnClick="Button3_Click">
            </f:Button>
        </Items>
    </f:Panel>

}


@section script {

    <script>

        function notifyit(inputValue) {
            var message = '用户输入：' + inputValue;
            if (!inputValue) {
                message = '用户未输入值！';
            }

            F.notify({
                message: message,
                messageIcon: '',
                modal: true,
                hideOnMaskClick: true,
                header: false,
                displayMilliseconds: 3000,
                positionX: 'center',
                positionY: 'center',
                messageAlign: 'center',
                minWidth: 200
            });

        }

    </script>

}