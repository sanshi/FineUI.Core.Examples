@page
@model FineUI.Core.Examples.Pages.Mobile.Message.PromptModel
@{
    ViewBag.Title = "MobileMessage/Prompt";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" Layout="VBox" BoxConfigSpace="10" BodyPadding="10px" IsViewPort="true">
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Title="输入对话框" HeaderStyle="true">
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:Button Text="输入对话框" ID="Button1" OnClick="Button1_Click">
            </f:Button>
            <f:Button Text="输入对话框（ButtonFill）" ID="Button2" OnClick="Button2_Click">
            </f:Button>
            <f:Button Text="输入对话框（ButtonPlain）" ID="Button5" OnClick="Button5_Click">
            </f:Button>
            <f:Button Text="输入对话框（ButtonPlain，密码）" ID="Button4" OnClick="Button4_Click">
            </f:Button>
            <f:Button Text="输入对话框（CancelButtonAhead）" ID="Button3" OnClick="Button3_Click">
            </f:Button>
        </Items>
    </f:Panel>

}


@section script {

    <script>

        function notifyit(inputValue) {
            var message = '用户输入：' + inputValue;
            if (!inputValue) {
                message = '用户未输入值！';
            }

            F.notify({
                message: message,
                messageIcon: '',
                modal: true,
                hideOnMaskClick: true,
                header: false,
                displayMilliseconds: 3000,
                positionX: 'center',
                positionY: 'center',
                messageAlign: 'center',
                minWidth: 200
            });

        }

    </script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>演示移动输入对话框的输入结果处理和按钮布局。</p>
    <h3><i class="f-iconfont f-iconfont-window" aria-hidden="true"></i>打开并处理当前对话框</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="Button1" title="第 1 个按钮（输入对话框）">第 1 个按钮（输入对话框）</strong>。<br />结果：本页显示包含输入字段的对话框。</li>
        <li>输入<code>张三</code>并点击<strong>确定</strong>。<br />结果：确认处理读取本次输入并显示用户输入结果；取消时不提交该输入。</li>
    </ol>
    <h3><i class="f-iconfont f-iconfont-layout" aria-hidden="true"></i>比较按钮样式</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="Button2" title="输入对话框（ButtonFill）">输入对话框（ButtonFill）</strong>。<br />结果：对话框底部按钮填充可用宽度。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button5" title="输入对话框（ButtonPlain）">输入对话框（ButtonPlain）</strong>。<br />结果：对话框使用本页简洁按钮样式。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button3" title="输入对话框（CancelButtonAhead）">输入对话框（CancelButtonAhead）</strong>。<br />结果：取消按钮排列在确定按钮之前。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>ButtonFill</code>（<strong>对话框配置</strong>）：让对话框按钮填满底部工具栏。</li>
        <li><code>ButtonPlain</code>（<strong>对话框配置</strong>）：使用本页简洁按钮外观。</li>
        <li><code>TextMode</code>（<strong>对话框配置</strong>）：密码变体使用 <code>password</code>，普通变体读取文本。</li>
    </ul>
</section>
}
