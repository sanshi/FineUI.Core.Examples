@page
@model FineUI.Core.Examples.Pages.Mobile.Message.NotifyModel
@{
    ViewBag.Title = "MobileMessage/Notify";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section head {

    <style>
        .mynotify .f-messagebox-message {
            margin: 0;
        }

        .mynotify .f-loading {
            position: static;
            margin: 0;
            text-align: center;
        }

            .mynotify .f-loading .f-loading-img {
                display: inline-block;
                vertical-align: top;
            }

        .mynotify .f-loading-message {
            font-size: 14px;
            margin: 5px 10px 0;
        }
    </style>

}

@section body {

    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" Layout="VBox" BoxConfigSpace="10" BodyPadding="10px" IsViewPort="true">
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Title="通知对话框" HeaderStyle="true">
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:Button Text="通知对话框" ID="Button1" OnClick="Button1_Click">
            </f:Button>
            <f:Button Text="通知对话框（正在加载）" ID="Button2" OnClick="Button2_Click">
            </f:Button>
            <f:Button Text="通知对话框（正在加载，不显示文字）" ID="Button3" OnClick="Button3_Click">
            </f:Button>
            <f:Button Text="通知对话框（正在加载，自定义样式）" ID="Button4" OnClick="Button4_Click">
            </f:Button>
            <f:Label Text=""></f:Label>
            <f:Panel ShowBorder="false" ShowHeader="false" Layout="HBox" BoxConfigSpace="10">
                <Items>
                    <f:Button Text="显示通知对话框" ID="Button5" BoxFlex="1" ClickHandler="onShowNotifyWindowClick"></f:Button>
                    <f:Button Text="关闭通知对话框" ID="Button6" BoxFlex="1" ClickHandler="onHideNotifyWindowClick"></f:Button>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>

}


@section script {

    <script>

        function onShowNotifyWindowClick(event) {
            // 注意：id属性是通知对话框的标识符
            var mynotifywindow = F('mynotifywindow');
            if (!mynotifywindow) {
                F.notify({
                    id: 'mynotifywindow',
                    message: '正在加载...',
                    messageIcon: '',
                    header: false,
                    positionX: 'center',
                    positionY: 'top',
                    showLoading: true,
                    minWidth: 100,
                    displayMilliseconds: 60000  // 1分钟才关闭
                });
            }
        }

        function onHideNotifyWindowClick(event) {
            var mynotifywindow = F('mynotifywindow');
            if (mynotifywindow) {
                mynotifywindow.hide();
            }
        }

    </script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示移动通知对话框的加载状态、持续显示与显式关闭。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>对照自动通知与常驻通知</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="Button1" title="第 1 个按钮（通知对话框）">第 1 个按钮（通知对话框）</strong>。<br />结果：本页显示普通通知，按其持续时间结束。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button2" title="通知对话框（正在加载）">通知对话框（正在加载）</strong>。<br />结果：显示对应加载动画及本页文字样式。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button5" title="显示通知对话框">显示通知对话框</strong>。<br />结果：显示客户端管理的常驻通知。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button6" title="关闭通知对话框">关闭通知对话框</strong>。<br />结果：明确关闭前面显示的通知。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>DisplayMilliseconds</code>（<strong>对话框配置</strong>）：控制普通通知持续时间；需要常驻的本页入口由关闭按钮明确结束。</li>
        <li><code>MessageIcon</code>（<strong>对话框配置</strong>）：为普通通知或加载状态选择对应标识。</li>
        <li><code>F.notify()</code>（<strong>通知处理</strong>）：本页客户端入口显示或管理对应通知。</li>
    </ul>
</section>
}
