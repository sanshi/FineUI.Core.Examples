@page
@model FineUI.Core.Examples.Pages.Mobile.Message.AlertModel
@{
    ViewBag.Title = "MobileMessage/Alert";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" Layout="VBox" BoxConfigSpace="10" BodyPadding="10px" IsViewPort="true">
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Title="提示对话框" HeaderStyle="true">
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:Button Text="提示对话框" ID="Button1" OnClick="Button1_Click">
            </f:Button>
            <f:Button Text="提示对话框（ButtonFill）" ID="Button2" OnClick="Button2_Click">
            </f:Button>
            <f:Button Text="提示对话框（ButtonPlain）" ID="Button3" OnClick="Button3_Click">
            </f:Button>
        </Items>
    </f:Panel>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示移动提示对话框的结果处理与按钮样式。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-window" aria-hidden="true"></i>打开并处理当前对话框</h3>
        <ol>
            <li>点击<strong class="example-control-reference" data-example-control="Button1" title="第 1 个按钮（提示对话框）">第 1 个按钮（提示对话框）</strong>。<br />结果：本页显示提示对话框。
            </li>
            <li>点击<strong>确定</strong>，再重新打开并确定。<br />结果：提示框关闭，原页面继续保留。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>比较按钮样式</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="Button2"
                    title="提示对话框（ButtonFill）">提示对话框（ButtonFill）</strong>。<br />结果：对话框底部按钮填充可用宽度。</li>
            <li>点击<strong class="example-control-reference" data-example-control="Button3"
                    title="提示对话框（ButtonPlain）">提示对话框（ButtonPlain）</strong>。<br />结果：对话框使用本页简洁按钮样式。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ButtonFill</code>（<strong>对话框配置</strong>）：让对话框按钮填满底部工具栏。</li>
            <li><code>ButtonPlain</code>（<strong>对话框配置</strong>）：使用本页简洁按钮外观。</li>
        </ul>
    </section>
}
