@page
@model FineUI.Core.Examples.Pages.Mobile.Message.AlertModel
@{
    ViewBag.Title = "MobileMessage/Alert";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel1" ShowBorder="false" ShowHeader="false" Layout="VBox" BoxConfigChildMargin="0 0 10 0" BodyPadding="10px" IsViewPort="true">
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Title="提示对话框" HeaderStyle="true">
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:Button Text="提示对话框" ID="Button1" OnClick="Button1_Click">
            </f:Button>
            <f:Button Text="提示对话框（ButtonFill）" ID="Button2" OnClick="Button2_Click">
            </f:Button>
            <f:Button Text="提示对话框（ButtonPlain）" ID="Button3" OnClick="Button3_Click">
            </f:Button>
        </Items>
    </f:Panel>

}

