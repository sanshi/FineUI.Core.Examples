@page
@model FineUI.Core.Examples.Pages.Chart.Bar.SalesModel
@{
    ViewBag.SourceFiles = "~/Pages/Chart/Bar/SalesOrderData.cs";
    ViewBag.Title = "图表绑定与 Grid 联动";
}
@section body {
    <f:Panel Layout="Block" BlockConfigSpace="16" IsFluid="true" ShowHeader="false" ShowBorder="false">
        <Items>
            <f:Panel BlockLG="7" Height="550" Layout="Fit" ShowHeader="true" ShowBorder="true" Title="月度销售额（元）" BodyPadding="8">
                <Toolbars>
                    <f:Toolbar Position="Top">
                        <Items>
                            <f:Button ID="btnRecent" Text="最近两个月" CssClass="marginr" OnClick="btnRecent_Click" />
                            <f:Button ID="btnReset" Text="显示全部" OnClick="btnReset_Click" />
                        </Items>
                    </f:Toolbar>
                </Toolbars>
                <Items>
                    <f:Chart ID="ChartSales" DataCategoryField="Category"
                        DataIDField="Month" OnPointClick="ChartSales_PointClick">
                        <Series>
                            <f:ChartSeries Key="sales" Type="Bar" Name="销售额" DataValueField="Amount" />
                        </Series>
                    </f:Chart>
                </Items>
            </f:Panel>
            <f:Grid ID="GridOrders" BlockLG="5" Height="550" Title="订单明细" ShowHeader="true" ShowBorder="true">
                <Toolbars>
                    <f:Toolbar Position="Top">
                        <Items>
                            <f:ToolbarText ID="ToolbarTextOrderScope" />
                        </Items>
                    </f:Toolbar>
                </Toolbars>
                <Columns>
                    <f:RenderField ColumnID="Number" DataField="Number" HeaderText="订单号" Width="80" />
                    <f:RenderField ColumnID="Customer" DataField="Customer" HeaderText="客户" Width="78" ExpandUnusedSpace="true" />
                    <f:RenderField ColumnID="Month" DataField="Month" HeaderText="月份" Width="80" />
                    <f:RenderField ColumnID="Amount" DataField="Amount" HeaderText="金额" Width="84" TextAlign="Right" />
                </Columns>
            </f:Grid>
        </Items>
    </f:Panel>
    <p>点击月份柱可查看当月订单。「最近两个月」同时缩小图表和明细的范围，「显示全部」恢复六个月。页面使用演示订单数据。</p>
    <section aria-label="关键属性">
        <p><strong>关键属性</strong></p>
        <ul>
            <li>
                <code>DataIDField="Month"</code>
                点击月份柱时传递业务键，例如 2026-09。横轴上的「9 月」只用于显示。
            </li>
            <li>
                <code>OnPointClick="ChartSales_PointClick"</code>
                将点击交给后台处理，用月份业务键筛选订单并更新 Grid。
            </li>
        </ul>
    </section>
}
