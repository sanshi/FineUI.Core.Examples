@page
@model FineUI.Core.Examples.Pages.Chart.Bar.SalesModel
@{
    ViewBag.SourceFiles = "~/Pages/Chart/Bar/SalesOrderData.cs";
    ViewBag.Title = "图表绑定与 Grid 联动";
}
@section body {
    <f:Panel Layout="Block" BlockConfigSpace="16" IsFluid="true" ShowHeader="false" ShowBorder="false">
        <Items>
            <f:Panel BlockLG="7" Height="550" Layout="Fit" ShowHeader="true" ShowBorder="true" Title="月度销售额（元）" BodyPadding="8">
                <Toolbars>
                    <f:Toolbar Position="Top">
                        <Items>
                            <f:Button ID="btnRecent" Text="最近两个月" CssClass="marginr" OnClick="btnRecent_Click" />
                            <f:Button ID="btnReset" Text="显示全部" OnClick="btnReset_Click" />
                        </Items>
                    </f:Toolbar>
                </Toolbars>
                <Items>
                    <f:Chart ID="ChartSales" DataCategoryField="Category" DataIDField="Month" OnPointClick="ChartSales_PointClick">
                        <Series>
                            <f:ChartSeries Key="sales" Type="Bar" Name="销售额" DataValueField="Amount" />
                        </Series>
                    </f:Chart>
                </Items>
            </f:Panel>
            <f:Grid ID="GridOrders" BlockLG="5" Height="550" Title="订单明细" ShowHeader="true" ShowBorder="true">
                <Toolbars>
                    <f:Toolbar Position="Top">
                        <Items>
                            <f:ToolbarText ID="ToolbarTextOrderScope" />
                        </Items>
                    </f:Toolbar>
                </Toolbars>
                <Columns>
                    <f:RenderField ColumnID="Number" DataField="Number" HeaderText="订单号" Width="80" />
                    <f:RenderField ColumnID="Customer" DataField="Customer" HeaderText="客户" Width="78" ExpandUnusedSpace="true" />
                    <f:RenderField ColumnID="Month" DataField="Month" HeaderText="月份" Width="80" />
                    <f:RenderField ColumnID="Amount" DataField="Amount" HeaderText="金额" Width="84" TextAlign="Right" />
                </Columns>
            </f:Grid>
        </Items>
    </f:Panel>


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>点击月份柱可查看当月订单。「最近两个月」同时缩小图表和明细的范围，「显示全部」恢复六个月。页面使用演示订单数据。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>按月份查看订单</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="ChartSales" title="图表">图表</strong>中的一个月份柱。<br />结果：后台按月份读取订单并更新<strong
                    class="example-control-reference" data-example-control="GridOrders" title="订单明细">订单明细</strong>及范围提示。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnRecent" title="最近两个月">最近两个月</strong>。<br />结果：柱状图和明细同时缩小到<strong
                    class="example-control-reference" data-example-control="btnRecent" title="最近两个月">最近两个月</strong>。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnReset" title="显示全部">显示全部</strong>。<br />结果：恢复六个月的图表和订单范围。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DataIDField</code>（<strong class="example-control-reference" data-example-control="ChartSales" title="图表">图表</strong>）：初始为
                <code>Month</code>，点击月份柱时传递业务键，例如 2026-09。横轴上的「9 月」只用于显示。
            </li>
            <li><code>OnPointClick</code>（<strong class="example-control-reference" data-example-control="ChartSales" title="图表">图表</strong>）：初始为
                <code>ChartSales_PointClick</code>，将点击交给后台处理，用月份业务键筛选订单并更新 Grid。
            </li>
        </ul>
    </section>
}
