@page
@model FineUI.Core.Examples.Pages.Chart.Bar.BasicModel
@{
    ViewBag.Title = "基础柱状图";
}

@section body {
    <f:Chart ID="ChartBar" Height="550" CategoryField="Category" ShowTooltip="false">
        <Series>
            <f:ChartSeries Key="value" Type="Bar" Name="数值" ValueField="Value" />
        </Series>
    </f:Chart>
    <p>柱高表示各分类的数值，分类和数值沿用官网示例。<a href="https://echarts.apache.org/examples/zh/editor.html?c=bar-simple" target="_blank" rel="noopener">查看 Apache ECharts 原始示例</a>。</p>
    <section aria-label="关键属性">
        <p><strong>关键属性</strong></p>
        <ul>
            <li>
                <code>CategoryField="Category"</code>
                从每行的 Category 字段读取横轴分类，例如 Mon。
            </li>
            <li>
                <code>Type="Bar"</code>、<code>ValueField="Value"</code>
                柱状系列用数值字段决定每根柱子的高度。
            </li>
        </ul>
    </section>
}
