@page
@model FineUI.Core.Examples.Pages.Chart.Bar.SpacingModel
@{
    ViewBag.Title = "柱条间距";
}

@section body {
    <f:Chart ID="ChartBarSpacing" Height="550" DataCategoryField="Category"
        ShowTooltip="false">
        <Series>
            <f:ChartSeries Key="first" Type="Bar" Name="first" DataValueField="First"
                BarGap="20%" BarCategoryGap="40%" />
            <f:ChartSeries Key="second" Type="Bar" Name="second" DataValueField="Second" />
        </Series>
    </f:Chart>


}

@section exampleDescription {
<section aria-label="页面描述">
    <p>分别设置同一分类内的柱间距和相邻分类的组间距。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-pic" aria-hidden="true"></i>对照柱条间距</h3>
    <ul>
        <li>对照<strong class="example-control-reference" data-example-control="ChartBarSpacing" title="图表">图表</strong>中的分类、数值和形状。<br />结果：比较同一个分类里两根柱之间的间距，以及相邻分类的柱组之间的间距。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <a href="https://echarts.apache.org/handbook/zh/how-to/chart-types/bar/basic-bar/#柱条间距" target="_blank" rel="noopener">查看 Apache ECharts 原始示例</a>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>BarGap</code>（<strong>图表系列</strong>，位于<strong class="example-control-reference" data-example-control="ChartBarSpacing" title="图表">图表</strong>）：初始为 <code>20%</code>，同一分类内两根柱之间的空隙，设为柱宽的 20%。</li>
        <li><code>BarCategoryGap</code>（<strong>图表系列</strong>，位于<strong class="example-control-reference" data-example-control="ChartBarSpacing" title="图表">图表</strong>）：初始为 <code>40%</code>，从分类带中留出 40% 作为相邻柱组之间的空隙。同一分类轴上，最后一个显式设置该项的柱系列决定整组布局。</li>
    </ul>
</section>
}
