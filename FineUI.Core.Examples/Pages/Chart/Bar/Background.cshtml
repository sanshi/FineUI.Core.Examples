@page
@model FineUI.Core.Examples.Pages.Chart.Bar.BackgroundModel
@{
    ViewBag.Title = "带背景色的柱状图";
}

@section body {
    <f:Chart ID="ChartBarBackground" Height="550" DataCategoryField="Category"
        ShowTooltip="false">
        <Series>
            <f:ChartSeries Key="value" Type="Bar" Name="数值" DataValueField="Value" ShowBackground="true" />
        </Series>
    </f:Chart>
    <p>每根柱子后方显示浅色背景，用来对照柱高。<a href="https://echarts.apache.org/examples/zh/editor.html?c=bar-background" target="_blank" rel="noopener">查看 Apache ECharts 原始示例</a>。</p>
    <section aria-label="关键属性">
        <p><strong>关键属性</strong></p>
        <ul>
            <li>
                <code>ShowBackground="true"</code>
                在每根柱后绘制浅色背景，便于对照同一坐标轴上的柱高。
            </li>
        </ul>
    </section>
}
