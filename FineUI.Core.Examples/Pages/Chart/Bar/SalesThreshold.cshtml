@page
@model FineUI.Core.Examples.Pages.Chart.Bar.SalesThresholdModel
@{
    ViewBag.SourceFiles = "~/Pages/Chart/Data/ChartDataRows.cs";
    ViewBag.Title = "金额门槛筛选柱状图";
}

@section body {
    <f:Panel IsFluid="true" Title="区域销售额" ShowHeader="true" ShowBorder="true" BodyPadding="8">
        <Toolbars>
            <f:Toolbar Position="Top">
                <Items>
                    <f:ToolbarText ID="ToolbarTextChartScope" />
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:SimpleForm IsFluid="true" MaxWidth="240" ShowHeader="false" ShowBorder="false" LabelWidth="84">
                <Items>
                    <f:DropDownList ID="ddlMinimum" Label="最低金额" OnSelectedIndexChanged="ddlMinimum_SelectedIndexChanged">
                        <f:ListItem Text="全部区域" Value="0" Selected="true" />
                        <f:ListItem Text="4,500 元及以上" Value="4500" />
                        <f:ListItem Text="20,000 元及以上" Value="20000" />
                        <f:ListItem Text="40,000 元及以上" Value="40000" />
                        <f:ListItem Text="68,000 元及以上" Value="68000" />
                        <f:ListItem Text="70,000 元及以上" Value="70000" />
                    </f:DropDownList>
                </Items>
            </f:SimpleForm>
            <f:Chart ID="ChartSalesThreshold" Height="550" DataCategoryField="Category">
                <Series>
                    <f:ChartSeries Key="amount" Type="Bar" Name="销售额（元）" DataValueField="Amount" />
                </Series>
            </f:Chart>
        </Items>
    </f:Panel>



}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>选择最低销售额后立即筛选，只保留达到门槛的区域。选择「全部区域」可恢复全部柱子。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>改变最低金额</h3>
        <ol>
            <li>从<strong class="example-control-reference" data-example-control="ddlMinimum" title="全部区域">全部区域</strong>选择一个金额门槛。<br />结果：后台仅保留达到门槛的区域，柱数和汇总随之变化。
            </li>
            <li>重新选择<strong class="example-control-reference" data-example-control="ddlMinimum" title="全部区域">全部区域</strong>。<br />结果：恢复全部区域的柱状图和汇总。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Items</code>（<strong class="example-control-reference" data-example-control="ddlMinimum"
                    title="全部区域">全部区域</strong>）：预设金额作为下拉项的值。筛选包含等于门槛的区域，例如选择 68,000 元时保留华东。</li>
            <li><code>OnSelectedIndexChanged</code>（<strong class="example-control-reference" data-example-control="ddlMinimum"
                    title="全部区域">全部区域</strong>）：选项改变时更新柱图和命中数。选择 70,000 元可查看空结果。</li>
        </ul>
    </section>
}
