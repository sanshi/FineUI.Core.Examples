@page
@model FineUI.Core.Examples.Pages.Chart.Bar.GridToChartModel
@{
    ViewBag.SourceFiles = "~/Pages/Chart/Data/RegionSalesData.cs;~/Pages/Chart/Data/ChartDataRows.cs";
    ViewBag.Title = "Grid 选行联动柱状图";
}

@section body {
    <f:Panel Layout="Block" BlockConfigSpace="16" IsFluid="true" ShowHeader="false" ShowBorder="false">
        <Items>
            <f:Grid ID="GridRegions" BlockLG="4" Title="区域" ShowHeader="true" ShowBorder="true" Height="550" DataIDField="Id" OnRowClick="GridRegions_RowClick">
                <Columns>
                    <f:RenderField DataField="Category" HeaderText="区域" ExpandUnusedSpace="true" />
                    <f:RenderField DataField="Amount" HeaderText="累计销售额" Width="108" TextAlign="Right" />
                </Columns>
            </f:Grid>
            <f:Panel BlockLG="8" Height="550" Layout="Fit" Title="月度销售额（元）" ShowHeader="true" ShowBorder="true" BodyPadding="8">
                <Toolbars>
                    <f:Toolbar Position="Top">
                        <Items>
                            <f:ToolbarText ID="ToolbarTextChartScope" />
                        </Items>
                    </f:Toolbar>
                </Toolbars>
                <Items>
                    <f:Chart ID="ChartRegionMonths" DataCategoryField="Category">
                        <Series>
                            <f:ChartSeries Key="amount" Type="Bar" Name="销售额（元）" DataValueField="Amount" />
                        </Series>
                    </f:Chart>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>



}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>点击区域表格的一行，右侧柱状图显示该区域 4 至 9 月的销售额。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>从表格选择区域</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="GridRegions" title="区域">区域</strong>点击另一条区域记录。<br />结果：后台按区域重新绑定<strong
                    class="example-control-reference" data-example-control="ChartRegionMonths" title="图表">图表</strong>，显示该区域 4 至 9 月销售额，范围文字同步更新。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DataIDField</code>（<strong class="example-control-reference" data-example-control="GridRegions" title="区域">区域</strong>）：初始为
                <code>Id</code>，Grid 使用区域业务键识别当前行，例如 east 对应华东。
            </li>
            <li><code>OnRowClick</code>（<strong class="example-control-reference" data-example-control="GridRegions"
                    title="区域">区域</strong>）：后台通过行的业务键查询该区域的月度销售额，并更新柱状图。</li>
        </ul>
    </section>
}
