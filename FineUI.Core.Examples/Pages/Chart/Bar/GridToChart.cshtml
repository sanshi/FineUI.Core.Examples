@page
@model FineUI.Core.Examples.Pages.Chart.Bar.GridToChartModel
@{
    ViewBag.SourceFiles = "~/Pages/Chart/ChartInteractionData.cs";
    ViewBag.Title = "Grid 选行联动柱状图";
}

@section body {
    <f:Panel Layout="Block" BlockConfigSpace="16" IsFluid="true" ShowHeader="false" ShowBorder="false">
        <Items>
            <f:Grid ID="GridRegions" BlockLG="4" Title="区域" ShowHeader="true" ShowBorder="true" Height="550" DataIDField="Key" OnRowClick="GridRegions_RowClick">
                <Columns>
                    <f:RenderField DataField="Category" HeaderText="区域" ExpandUnusedSpace="true" />
                    <f:RenderField DataField="Amount" HeaderText="累计销售额" Width="108" TextAlign="Right" />
                </Columns>
            </f:Grid>
            <f:Panel BlockLG="8" Height="550" Layout="Fit" Title="月度销售额（元）" ShowHeader="true" ShowBorder="true" BodyPadding="8">
                <Toolbars>
                    <f:Toolbar Position="Top">
                        <Items>
                            <f:ToolbarText ID="ToolbarTextChartScope" />
                        </Items>
                    </f:Toolbar>
                </Toolbars>
                <Items>
                    <f:Chart ID="ChartRegionMonths" CategoryField="Category">
                        <Series>
                            <f:ChartSeries Key="amount" Type="Bar" Name="销售额（元）" ValueField="Amount" />
                        </Series>
                    </f:Chart>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>

    <p>点击区域表格的一行，右侧柱状图显示该区域 4 至 9 月的销售额。</p>
    <section aria-label="关键属性">
        <p><strong>关键属性</strong></p>
        <ul>
            <li><code>DataIDField="Key"</code> Grid 使用区域业务键识别当前行，例如 east 对应华东。</li>
            <li><code>OnRowClick</code> 后台通过行的业务键查询该区域的月度销售额，并更新柱状图。</li>
        </ul>
    </section>
}
