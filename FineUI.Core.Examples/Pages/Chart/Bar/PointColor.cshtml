@page
@model FineUI.Core.Examples.Pages.Chart.Bar.PointColorModel
@{
    ViewBag.Title = "单柱配色";
}

@section body {
    <f:Chart ID="ChartBarPointColor" Height="550" DataCategoryField="Category"
        ShowTooltip="false">
        <Series>
            <f:ChartSeries Key="value" Type="Bar" Name="数值" DataValueField="Value" DataColorField="PointColor" />
        </Series>
    </f:Chart>


}

@section exampleDescription {
<section aria-label="页面描述">
    <p>从数据行读取单柱颜色，只改变指定分类的配色。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-pic" aria-hidden="true"></i>对照单柱配色</h3>
    <ul>
        <li>对照<strong class="example-control-reference" data-example-control="ChartBarPointColor" title="图表">图表</strong>中的分类、数值和形状。<br />结果：为星期二的数据行指定颜色，其余柱子沿用系列配色。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <a href="https://echarts.apache.org/examples/zh/editor.html?c=bar-data-color" target="_blank" rel="noopener">查看 Apache ECharts 原始示例</a>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>DataColorField</code>（<strong>图表系列</strong>，位于<strong class="example-control-reference" data-example-control="ChartBarPointColor" title="图表">图表</strong>）：初始为 <code>PointColor</code>，从每行读取颜色。本例只有 Tue 提供 #505372，其他柱子继续使用系列配色。</li>
    </ul>
</section>
}
