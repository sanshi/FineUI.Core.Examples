@page
@model FineUI.Core.Examples.Pages.Chart.AreaModel
@{
    ViewBag.Title = "基础面积图";
}

@section body {
    <f:Chart ID="ChartArea" Height="550" CategoryField="Category" ShowTooltip="false" CategoryBoundaryGap="false">
        <Series>
            <f:ChartSeries Key="value" Type="Area" Name="数值" ValueField="Value" />
        </Series>
    </f:Chart>
    <p>面积图填充折线下方区域，分类和数值沿用官网示例。<a href="https://echarts.apache.org/examples/zh/editor.html?c=area-basic" target="_blank" rel="noopener">查看 Apache ECharts 原始示例</a>。</p>
    <section aria-label="关键属性">
        <p><strong>关键属性</strong></p>
        <ul>
            <li>
                <code>Type="Area"</code>
                在折线下方填充区域。
            </li>
            <li>
                <code>CategoryBoundaryGap="false"</code>
                首尾分类贴到绘图区边缘，使面积填充延伸到两侧。
            </li>
        </ul>
    </section>
}
