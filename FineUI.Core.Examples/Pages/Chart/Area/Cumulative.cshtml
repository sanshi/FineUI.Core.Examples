@page
@model FineUI.Core.Examples.Pages.Chart.Area.CumulativeModel
@{
    ViewBag.SourceFiles = "~/Pages/Chart/Data/RegionSalesData.cs;~/Pages/Chart/Data/ChartDataRows.cs";
    ViewBag.Title = "复选切换累计面积图";
}

@section body {
    <f:Panel IsFluid="true" Title="区域销售趋势" ShowHeader="true" ShowBorder="true" BodyPadding="8">
        <Toolbars>
            <f:Toolbar Position="Top">
                <Items>
                    <f:ToolbarText ID="ToolbarTextChartScope" />
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:SimpleForm IsFluid="true" ShowHeader="false" ShowBorder="false" LabelWidth="108">
                <Items>
                    <f:CheckBox ID="cbxCumulative" ShowLabel="false" Text="按月累计" OnCheckedChanged="cbxCumulative_CheckedChanged" />
                </Items>
            </f:SimpleForm>
            <f:Chart ID="ChartCumulativeSales" Height="550" CategoryField="Category">
                <Series>
                    <f:ChartSeries Key="amount" Type="Area" Name="销售额（元）" ValueField="Amount" />
                </Series>
            </f:Chart>
        </Items>
    </f:Panel>

    <p>勾选「按月累计」，面积图每个点显示从 4 月到该月的销售额合计。取消勾选恢复每月独立金额。</p>
    <section aria-label="关键属性">
        <p><strong>关键属性</strong></p>
        <ul>
            <li><code>OnCheckedChanged</code> 用当前复选状态选择本月值或截至当月累计值。</li>
            <li><code>DataBind</code> 累计由后台按月份顺序计算。例如 4 月与 5 月相加后才得到 5 月的累计值。</li>
        </ul>
    </section>
}
