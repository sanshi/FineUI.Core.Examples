@page
@model FineUI.Core.Examples.Pages.Chart.Pie.HalfDoughnutModel
@{
    ViewBag.Title = "半环形图";
}

@section body {
    <f:Chart ID="ChartPieHalfDoughnut" Height="550" CategoryField="Category"
        ShowLegend="true" LegendTop="5%" PieRadius="40%,70%"
        PieCenter="50%,70%" PieStartAngle="180" PieEndAngle="360">
        <Series>
            <f:ChartSeries Key="source" Type="Pie" Name="Access From" ValueField="Value" />
        </Series>
    </f:Chart>
    <p>将起止角度设为 180° 和 360°，在上半圆绘制各分类。<a href="https://echarts.apache.org/examples/zh/editor.html?c=pie-half-donut" target="_blank" rel="noopener">查看 Apache ECharts 原始示例</a>。</p>
    <section aria-label="关键属性">
        <p><strong>关键属性</strong></p>
        <ul>
            <li>
                <code>PieStartAngle="180"</code>、<code>PieEndAngle="360"</code>
                将全部扇区限制在 180° 至 360°，绘制成上半环。
            </li>
            <li>
                <code>PieCenter="50%,70%"</code>
                横向居中，并把圆心放到图表高度的 70% 处，给上半环留出空间。
            </li>
        </ul>
    </section>
}
