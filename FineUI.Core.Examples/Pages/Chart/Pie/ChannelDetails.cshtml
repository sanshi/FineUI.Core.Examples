@page
@model FineUI.Core.Examples.Pages.Chart.Pie.ChannelDetailsModel
@{
    ViewBag.SourceFiles = "~/Pages/Chart/Data/ChannelVisitData.cs;~/Pages/Chart/Data/ChartDataRows.cs";
    ViewBag.Title = "饼图扇区联动渠道明细表";
}

@section body {
    <f:Panel IsFluid="true" Layout="Block" BlockConfigSpace="16" ShowHeader="false" ShowBorder="false">
        <Items>
            <f:Panel BlockLG="6" Height="550" Layout="Fit" Title="访问渠道占比" ShowHeader="true" ShowBorder="true" BodyPadding="8">
                <Items>
                    <f:Chart ID="ChartChannelDetails" DataCategoryField="Category" DataIDField="Id" OnPointClick="ChartChannelDetails_PointClick">
                        <Series>
                            <f:ChartSeries Key="amount" Type="Pie" Name="访问量" DataValueField="Amount" />
                        </Series>
                    </f:Chart>
                </Items>
            </f:Panel>
            <f:Grid ID="GridChannelMonths" BlockLG="6" Title="月度访问明细" ShowHeader="true" ShowBorder="true" Height="550">
                <Toolbars>
                    <f:Toolbar Position="Top">
                        <Items>
                            <f:Button ID="btnClear" Text="清除选择" OnClick="btnClear_Click" CssClass="marginr" />
                            <f:ToolbarText ID="ToolbarTextChartScope" />
                        </Items>
                    </f:Toolbar>
                </Toolbars>
                <Columns>
                    <f:RenderField DataField="Category" HeaderText="月份" ExpandUnusedSpace="true" />
                    <f:RenderField DataField="Amount" HeaderText="访问量" Width="100" TextAlign="Right" />
                </Columns>
            </f:Grid>
        </Items>
    </f:Panel>



}

@section exampleDescription {
<section aria-label="页面描述">
    <p>点击渠道扇区，明细表显示该渠道六个月的访问量。点击「清除选择」恢复空明细，饼图继续展示全部渠道。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>从扇区查看月度明细</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="ChartChannelDetails" title="图表">图表</strong>中的一个渠道扇区。<br />结果：后台把该渠道六个月的访问量填入<strong class="example-control-reference" data-example-control="GridChannelMonths" title="月度访问明细">月度访问明细</strong>。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnClear" title="清除选择">清除选择</strong>。<br />结果：恢复空明细；饼图继续展示全部渠道。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>DataIDField</code>（<strong class="example-control-reference" data-example-control="ChartChannelDetails" title="图表">图表</strong>）：扇区提交渠道编号，例如 search 表示搜索。</li>
        <li><code>OnPointClick</code>（<strong class="example-control-reference" data-example-control="ChartChannelDetails" title="图表">图表</strong>）：按渠道查询月度记录，刷新 Grid 和当前选择说明。</li>
    </ul>
</section>
}
