@page
@model FineUI.Core.Examples.Pages.Chart.Pie.ScrollableLegendModel
@{
    ViewBag.Title = "可滚动的图例";
}

@section body {
    <f:Chart ID="ChartPieScrollableLegend" Height="550" DataCategoryField="Category" Title="同名数量统计" Subtitle="纯属虚构" ShowLegend="true" LegendPosition="Right"
        LegendType="scroll" LegendRight="10" LegendTop="20" LegendBottom="20" TooltipFormatter="@("{a} <br/>{b} : {c} ({d}%)")" PieCenter="40%,50%"
        PieEmphasisShadow="true">
        <Series>
            <f:ChartSeries Key="names" Type="Pie" Name="姓名" DataValueField="Value" />
        </Series>
    </f:Chart>



}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>为较多分类使用可翻页图例，保留完整的扇区数据。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-pic" aria-hidden="true"></i>对照可滚动的图例</h3>
        <ul>
            <li>使用<strong class="example-control-reference" data-example-control="ChartPieScrollableLegend"
                    title="同名数量统计">同名数量统计</strong>右侧图例的翻页按钮，再指向一个扇区。<br />结果：图例翻页展示更多姓名；提示显示对应姓名、数量与占比。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <a href="https://echarts.apache.org/examples/zh/editor.html?c=pie-legend" target="_blank" rel="noopener">查看 Apache ECharts 原始示例</a>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>LegendType</code>（<strong class="example-control-reference" data-example-control="ChartPieScrollableLegend"
                    title="同名数量统计">同名数量统计</strong>）：设为 scroll 时，放不下的图例可以用箭头翻页。</li>
            <li><code>LegendRight / LegendTop / LegendBottom</code>（<strong class="example-control-reference" data-example-control="ChartPieScrollableLegend"
                    title="同名数量统计">同名数量统计</strong>）：分别留出 10、20、20 像素，让图例有明确的可滚动区域。</li>
            <li><code>TooltipFormatter</code>（<strong class="example-control-reference" data-example-control="ChartPieScrollableLegend"
                    title="同名数量统计">同名数量统计</strong>）：用 {a} 显示系列名，{b} 显示姓名，{c} 显示数量，{d} 显示占比。</li>
        </ul>
    </section>
}
