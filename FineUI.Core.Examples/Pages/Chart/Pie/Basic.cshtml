@page
@model FineUI.Core.Examples.Pages.Chart.Pie.BasicModel
@{
    ViewBag.Title = "基础饼图";
}

@section body {
    <f:Chart ID="ChartPie" Height="550" CategoryField="Category"
            Title="Referer of a Website" Subtitle="Fake Data" TitleAlign="Center"
            ShowLegend="true" LegendPosition="Left" PieEmphasisShadow="true"
            PieRadius="50%" Palette="#5070dd,#b6d634,#505372,#ff994d,#0ca8df">
        <Series>
            <f:ChartSeries Key="value" Type="Pie" Name="Access From" ValueField="Value" />
        </Series>
    </f:Chart>
    <p>扇区表示各访问来源所占比例，来源和访问量沿用官网示例。<a href="https://echarts.apache.org/examples/zh/editor.html?c=pie-simple" target="_blank" rel="noopener">查看 Apache ECharts 原始示例</a>。</p>
    <section aria-label="关键属性">
        <p><strong>关键属性</strong></p>
        <ul>
            <li>
                <code>Type="Pie"</code>、<code>PieRadius="50%"</code>
                每块扇区的角度表示该来源的占比。半径取图表短边一半的 50%。
            </li>
            <li>
                <code>ShowLegend="true"</code>、<code>LegendPosition="Left"</code>
                启用左侧竖排图例。未设置图例的纵向位置，当前布局由 ECharts 放在左下方。
            </li>
            <li>
                <code>PieEmphasisShadow="true"</code>
                指向某块扇区时显示阴影。
            </li>
        </ul>
    </section>
}
