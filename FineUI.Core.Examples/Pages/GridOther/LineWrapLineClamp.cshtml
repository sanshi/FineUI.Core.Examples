@page
@model FineUI.Core.Examples.Pages.GridOther.LineWrapLineClampModel
@{
    ViewBag.Title = "GridOther/LineWrapLineClamp";
    var F = Html.F();
}


@section head {

    <style>
        .f-grid-row .f-grid-cell-text {
            white-space: normal;
            word-break: break-all;
            overflow: hidden;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            display: -webkit-box;
        }
    </style>

}


@section body {

    <f:Grid ID="Grid1" Height="400" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" Width="150" />
            <f:RenderField HeaderText="个人简介" DataField="Desc" Width="400" MinWidth="150" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>
}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>让长单元格文字自动换行，超过三行时省略。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>对照本页样式规则</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>查看专业或描述长文字，再缩窄对应列。<br />结果：文字按列宽折行，最多保留三行；继续缩窄不会无限增高该段文本。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>CSS</code>（<strong>本页列与样式</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：单元格文字启用换行，并将 <code>-webkit-line-clamp</code> 配为 <code>3</code>。</li>
        </ul>
    </section>
}
