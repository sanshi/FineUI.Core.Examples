@page
@model FineUI.Core.Examples.Pages.GridOther.MultiActionsColumnMenuButtonModel
@{
    ViewBag.Title = "GridOther/MultiActionsColumnMenuButton";
    var F = Html.F();
}


@section head {

    <style>
        .f-grid-cell-Actions .action {
            display: inline-block;
            vertical-align: middle;
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField ColumnID="Actions" RendererFunction="renderActions" Width="180" />
        </Columns>
        <Listeners>
            <f:Listener Event="dataload" Handler="onGridDataLoad"></f:Listener>
        </Listeners>
    </f:Grid>
    <br>
    <br>

    <f:Window ID="Window1" Title="审批" Hidden="true" EnableIFrame="true" EnableMaximize="true" EnableResize="true" Target="Top" OnClose="Window1_Close"
        IsModal="true" Width="850" Height="500">
    </f:Window>


    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderActions(value, params) {
            return '<a class="action editit" href="#">' +
                        '<img class="f-grid-imagefield" src="' + F.resolveUrl('/res/icon/pencil.png') + '">' +
                    '</a>' +
                    '&nbsp;&nbsp;' +
                    '<a class="action deleteit" href="#">' +
                        '<img class="f-grid-imagefield" src="' + F.resolveUrl('/res/icon/delete.png') + '">' +
                    '</a>' +
                    '&nbsp;&nbsp;&nbsp;&nbsp;' +
                    '<div class="action btncontainer"></div>';
        }


        function getRowDataViaMenuItem(menuItem) {
            // menu: menuItem.parent
            // button: menuItem.parent.target
            var button = menuItem.parent.target;
            var rowEl = button.el.parents('.f-grid-row');
            var rowData = F.ui.Grid1.getRowData(rowEl);
            return [rowEl.index(), rowData.id, rowData.text];
        }

        function doCustomEditPostBack(menuItem, actionName) {
            var data = getRowDataViaMenuItem(menuItem);
            // 触发后台事件
            F.customEvent('Grid1_CustomEdit', {
                actionName: actionName,
                rowIndex: data[0],
                rowId: data[1],
                rowText: data[2]
            });
        }

        // 公共菜单
        var menu1;
        function getMenu1() {
            if (!menu1) {
                menu1 = F.create({
                    type: 'Menu', id: 'menu1',
                    items: [{
                        type: 'MenuItem', text: '操作一', icon: F.resolveUrl('/res/icon/tag_green.png'),
                        handler: function () {
                            doCustomEditPostBack(this, 'Action1');
                        }
                    }, {
                        type: 'MenuItem', text: '操作二', icon: F.resolveUrl('/res/icon/tag_blue.png'),
                        handler: function () {
                            doCustomEditPostBack(this, 'Action2');
                        }
                    }, {
                        type: 'MenuItem', text: '操作三', icon: F.resolveUrl('/res/icon/tag_red.png'),
                        handler: function () {
                            doCustomEditPostBack(this, 'Action3');
                        }
                    }]
                });
            }
            return menu1;
        }

        // 表格数据加载完毕
        function onGridDataLoad(event) {
            var grid = this;

            grid.bodyEl.find('.f-grid-cell-Actions .btncontainer').each(function () {
                var btncontainer = $(this);
                F.create({
                    type: 'Button',
                    renderTo: btncontainer,
                    text: 'More',
                    menu: getMenu1()
                });
            });

            // 动态创建的按钮会导致表格内内容错位，需要重新布局
            grid.doLayout();
        }

        F.ready(function () {

            var grid = F.ui.Grid1;
            var wnd = F.ui.Window1;

            grid.el.on('click', '.f-grid-cell-Actions .action.editit', function (event) {
                event.preventDefault();
                var targetEl = $(this);
                var rowEl = targetEl.closest('.f-grid-row');
                var rowData = grid.getRowData(rowEl);
                var rowId = rowData.id;
                var rowText = rowData.text;

                // grid_iframe_window.aspx?id=104&name=刘国
                var iframeUrl = F.resolveUrl('/Grid/IFrameWindow?id=' + rowId + '&name=' + encodeURIComponent(rowText));
                // 显示窗体
                wnd.show(iframeUrl, '审批 - ' + rowText);
            });


            grid.el.on('click', '.f-grid-cell-Actions .action.deleteit', function (event) {
                event.preventDefault();
                var targetEl = $(this);
                var rowEl = targetEl.closest('.f-grid-row');
                var rowData = grid.getRowData(rowEl);

                F.confirm({
                    message: '删除选中行？',
                    messageIcon: 'warning',
                    target: '_top',
                    ok: function () {
                        // 触发后台事件
                        F.customEvent('Grid1_CustomDelete', {
                            rowIndex: rowEl.index(),
                            rowId: rowData.id,
                            rowText: rowData.text
                        });
                    }
                });

            });


        });

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在同一个操作列中组合编辑、删除与 More 菜单，菜单操作仍能识别所属行。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>从同一列进入不同操作</h3>
        <ol>
            <li>点击<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>操作列中的编辑图标。<br />结果：浏览器读取图标所在行的数据并打开审批窗口，窗口地址及标题对应当前记录。</li>
            <li>关闭窗口，再点击某行的删除图标并确认。<br />结果：本页提交该行标识，后台提示点击的删除命令及对应记录；示例用提示说明命令处理，不代表已经删除数据库记录。</li>
            <li>打开另一行的 More 菜单，选择操作一、操作二或操作三。<br />结果：公共菜单根据本次打开它的按钮确定所属行，后台提示所选操作及该行信息，不沿用上次打开菜单的记录。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>RendererFunction</code>（<strong>操作列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：在一个单元格中生成多个操作入口，事件委托按入口类型分别处理。</li>
            <li><code>menu.target</code>（<strong>页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：公共菜单从当前触发按钮找到所属行，不用全局变量记住上一次的行。</li>
        </ul>
    </section>
}
