@page
@model FineUI.Core.Examples.Pages.GridOther.GridPagingDatabaseBbarModel
@{
    ViewBag.Title = "GridOther/GridPagingDatabaseBbar";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
        AllowPaging="true" PageSize="5">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
        <Toolbars>
            <f:Toolbar Position="Bottom">
                <Items>
                    <f:Button ID="btnShowSelectedRows" Text="选中了哪些行" CssClass="marginr" ClickHandler="onNotifySelectedRowsClick"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Grid>




}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在分页栏以外另设底部工具栏，使业务按钮和常规分页入口同时存在。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>同时使用业务按钮和分页入口</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>选择一行，再点击底部工具栏中的<strong
                    class="example-control-reference" data-example-control="btnShowSelectedRows"
                    title="选中了哪些行">选中了哪些行</strong>。<br />结果：提示当前选择；独立分页栏仍可正常换页，不被业务工具栏替代。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Toolbars / Position</code>（<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：把业务工具栏放在底部；分页栏由表格独立创建。</li>
        </ul>
    </section>
}
