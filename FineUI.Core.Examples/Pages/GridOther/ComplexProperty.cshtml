@page
@model FineUI.Core.Examples.Pages.GridOther.ComplexPropertyModel
@{
    ViewBag.Title = "GridOther/ComplexProperty";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="MyText" EnableCheckBoxSelect="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="MyText" />
            <f:RenderField HeaderText="入学年份" DataField="Year" />
            <f:RenderCheckField HeaderText="是否在校" DataField="MyCheckBox" />
            <f:RenderField HeaderText="是否在校" DataField="MyCheckBox" RendererFunction="renderAtSchool" />
            <f:RenderField HeaderText="老师（二级属性）" DataField="Info.UserName" ExpandUnusedSpace="true" MinWidth="150" />
        </Columns>
    </f:Grid>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        // 文本 - 是否在校
        function renderAtSchool(value, params) {
            return value ? '是' : '否';
        }

    </script>
}
