@page
@model FineUI.Core.Examples.Pages.GridOther.ComplexPropertyModel
@{
    ViewBag.Title = "GridOther/ComplexProperty";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="MyText" EnableCheckBoxSelect="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="MyText" />
            <f:RenderField HeaderText="入学年份" DataField="Year" />
            <f:RenderCheckField HeaderText="是否在校" DataField="MyCheckBox" />
            <f:RenderField HeaderText="是否在校" DataField="MyCheckBox" RendererFunction="renderAtSchool" />
            <f:RenderField HeaderText="老师（二级属性）" DataField="Info.UserName" ExpandUnusedSpace="true" MinWidth="150" />
        </Columns>
    </f:Grid>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        // 文本 - 是否在校
        function renderAtSchool(value, params) {
            return value ? '是' : '否';
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>把对象的嵌套属性绑定为表格列，在同一行显示学生资料与关联对象的信息。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>读取关联对象的属性</h3>
        <ul>
            <li>查看<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>的老师等关联信息列。<br />结果：每行显示关联对象中的实际属性，例如首行显示张老师；不把整个关联对象显示为字符串。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DataField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：列通过属性路径读取数据，本页包含
                <code>Info.UserName</code>；列值来自同一行对象。
            </li>
        </ul>
    </section>
}
