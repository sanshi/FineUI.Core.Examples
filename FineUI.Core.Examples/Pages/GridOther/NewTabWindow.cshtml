@page
@model FineUI.Core.Examples.Pages.GridOther.NewTabModel
@{
    ViewBag.Title = "GridOther/NewTabWindow";
    var F = Html.F();
}


@section body {

    @{
        var defaultUserName = "三生石上";
        var requestUserName = HttpContext.Request.Query["name"];
        if (!String.IsNullOrEmpty(requestUserName))
        {
            defaultUserName = requestUserName;
        }
    }

    <f:Form ID="SimpleForm1" IsFluid="true" ShowBorder="true" ShowHeader="false" Margin="10" AutoScroll="true" BodyPadding="10" IsViewPort="true">
        <Toolbars>
            <f:Toolbar ID="Toolbar1">
                <Items>
                    <f:Button ID="btnClose" Text="关闭当前标签页" Icon="SystemClose" ClickHandler="onCloseTabClick"></f:Button>
                    <f:ToolbarFill>
                    </f:ToolbarFill>
                    <f:ToolbarText Text="提示一">
                    </f:ToolbarText>
                    <f:ToolbarSeparator>
                    </f:ToolbarSeparator>
                    <f:ToolbarText Text="提示二">
                    </f:ToolbarText>
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Rows>
            <f:FormRow>
                <Items>
                    <f:Label ID="labUserName" Label="申请人" Text="@defaultUserName" CssClass="highlight" />
                    <f:Label ID="Label3" Label="电话" Text="0551-1234567" />
                </Items>
            </f:FormRow>
            <f:FormRow>
                <Items>
                    <f:NumberBox ID="NumberBox1" NoDecimal="true" NoNegative="true" Label="数量" Required="true" ShowRedStar="true" />
                    <f:DatePicker ID="DatePicker1" Required="true" ShowRedStar="true" Label="申请日期" Text="2008-05-09">
                    </f:DatePicker>
                </Items>
            </f:FormRow>
            <f:FormRow>
                <Items>
                    <f:TextArea ID="TextArea2" Height="80" Label="描述" Required="true" ShowRedStar="true" />
                </Items>
            </f:FormRow>
            <f:FormRow>
                <Items>
                    <f:HtmlEditor ID="HtmlEditor1" Editor="UMEditor" BasePath="@Url.Content("~/res/third-party/umeditor/")" Label="详细描述" Height="200">
                    </f:HtmlEditor>
                </Items>
            </f:FormRow>
        </Rows>
    </f:Form>


}

@section script {

    <script type="text/javascript">

        function onCloseTabClick(event) {
            parent.removeActiveTab();
        }

    </script>
}
