@page
@model FineUI.Core.Examples.Pages.GridOther.TwoGridModel
@{
    ViewBag.Title = "GridOther/TwoGrid";
    var F = Html.F();
}


@section body {

<f:RegionPanel ID="RegionPanel1" IsFluid="true" ShowBorder="false" Margin="24" IsViewPort="true">
    <Regions>
        <f:Region ID="Region1" ShowBorder="false" ShowHeader="false" RegionPosition="Left" BodyPadding="0 5 0 0" Width="200" Layout="Fit">
            <Items>
                <f:Grid ID="Grid2" ShowBorder="true" ShowHeader="true" Title="表格（班级）" EnableMultiSelect="false" DataIDField="Id" DataTextField="Name"
                        OnRowSelect="Grid2_RowSelect" ShowGridHeader="false">
                    <Columns>
                        <f:RowNumberField></f:RowNumberField>
                        <f:RenderField ExpandUnusedSpace="true" MinWidth="150" DataField="Name" HeaderText="班级名"></f:RenderField>
                    </Columns>
                </f:Grid>
            </Items>
        </f:Region>
        <f:Region ID="Region2" ShowBorder="false" ShowHeader="false" RegionPosition="Center" Layout="VBox" BoxConfigAlign="Stretch">
            <Items>
                <f:Panel ShowHeader="false" BodyPadding="10px" ShowBorder="true" MarginBottom="5">
                    <Items>
                        <f:Label ID="labelClassDesc" Text="@ViewBag.SelectedClassDesc">
                        </f:Label>
                        <f:Label ID="Label4">
                        </f:Label>
                    </Items>
                </f:Panel>
                <f:Grid ID="Grid1" BoxFlex="1" ShowBorder="true" ShowHeader="true" Title="表格（学生）" DataIDField="Id" DataTextField="Name">
                    <Columns>
                        <f:RowNumberField />
                        <f:RenderField HeaderText="姓名" DataField="Name" />
                        <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
                        <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
                        <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
                        <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
                        <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
                        <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" />
                    </Columns>
                </f:Grid>
            </Items>
        </f:Region>
    </Regions>
</f:RegionPanel>


}


@section script {

<script src="~/res/js/grid.js"></script>

}