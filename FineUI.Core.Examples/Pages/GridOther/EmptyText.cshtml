@page
@model FineUI.Core.Examples.Pages.GridOther.EmptyTextModel
@{
    ViewBag.Title = "GridOther/EmptyText";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" Height="350" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name"
            _EmptyTextRawHtml="@("<img src=\"" + Url.Content("~/res/images/no_data_found.png") + "\" alt=\"No Data Found!\"/>")">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button ID="Button1" Text="重新绑定表格" CssClass="marginr" OnClick="Button1_Click"></f:Button>

    <br>
    <br>
    注：本表格各列宽度固定，所以会出现横向滚动条。

}


@section script {

    <script src="~/res/js/grid.js"></script>

}