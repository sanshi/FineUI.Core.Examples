@page
@model FineUI.Core.Examples.Pages.GridOther.NewTabSameTabModel
@{
    ViewBag.SourceFiles = "~/GridOther/NewTabWindow";
    ViewBag.Title = "GridOther/NewTabSameTab";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" BoxFlex="1" MinWidth="150" />
            <f:RenderField HeaderText="新标签页打开">
                <Commands>
                    <f:Command CommandName="Action1" Text="编辑" CssClass="opennewtab" />
                </Commands>
            </f:RenderField>
        </Columns>
        <Listeners>
            <f:Listener Event="rowcommand" Handler="onGrid1RowCommand"></f:Listener>
        </Listeners>
        <Toolbars>
            <f:Toolbar>
                <Items>
                    <f:Button ID="btnNew" Text="新增数据" Icon="Add" ClickHandler="onNewClick"></f:Button>
                    <f:Button ID="btnDelete" Text="删除选中行" Icon="Delete" ClickHandler="onDeleteClick"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Grid>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onNewClick(event) {
            // addExampleTab 函数定义在 /Home/Index
            var newTabUrl = '@Url.Content("~/GridOther/NewTabWindow")';
            parent.addExampleTab({
                id: 'grid_newsametab_addnew',
                title: '新增人员',
                iframeUrl: newTabUrl,
                refreshWhenExist: true,
                iconFont: 'plus'
            });
        }

        function onDeleteClick(event) {
            var grid1 = F.ui.Grid1;

            if (!grid1.hasSelection()) {
                F.alert('请至少选择一项！');
                return;
            }


            var selectedRows = grid1.getSelectedRows(true);

            var selectedRowTexts = $.map(selectedRows, function (item, index) {
                return item.text;
            }).join(',');

            F.alert('删除行：' + selectedRowTexts);
        }

        function openNewTab(rowId) {
            var rowData = F.ui.Grid1.getRowData(rowId);
            var id = rowData.id;
            var name = rowData.text;

            // addExampleTab 函数定义在 /Home/Index
            var newTabUrl = '@Url.Content("~/GridOther/NewTabWindow")';
            parent.addExampleTab({
                id: 'grid_newsametab_edit',
                title: '编辑 - ' + name,
                iframeUrl: F.formatString('{0}?id={1}&name={2}', newTabUrl, id, F.urlEncode(name)),
                refreshWhenExist: true,
                iconFont: 'pencil'
            });
        }

        function onGrid1RowCommand(event, rowId, rowIndex, columnId, commandName) {
            if (commandName === "Action1") {
                // 点击表格行中的编辑按钮
                openNewTab(rowId);
            }
        }

    </script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>用固定页签标识复用编辑页，切换记录时更新同一个页签。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>按页签标识打开记录</h3>
    <ol>
        <li>在框架主页面打开本例，点击<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>某行的编辑入口，再打开另一条记录。<br />结果：第二次使用同一个编辑页签，页签标题与网址参数随新记录更新，不持续创建重复页签。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>addExampleTab / id</code>（<strong>框架页签调用</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：通过框架页面提供的函数打开页签，id 决定复用哪一个标签；本例需要在框架中操作。</li>
        <li><code>refreshWhenExist</code>（<strong>编辑页签配置</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>true</code>，重复打开相同 id 会更新已有页签地址与标题。</li>
    </ul>
</section>
}
