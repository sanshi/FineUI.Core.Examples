@page
@model FineUI.Core.Examples.Pages.GridOther.ScrollbarSyncModel
@{
    ViewBag.Title = "GridOther/ScrollbarSync";
    var F = Html.F();
}



@section body {

    <f:Panel ID="Panel1" Layout="VBox" ShowBorder="false" ShowHeader="false" IsViewPort="true" Margin="10">
        <Items>
            <f:Grid ID="Grid1" BoxFlex="1" ShowBorder="true" ShowHeader="true" Title="表格一" DataIDField="Id" DataTextField="Name">
                <Columns>
                    <f:RowNumberField />
                    <f:RenderField HeaderText="姓名" DataField="Name" />
                    <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
                    <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
                    <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
                    <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" Width="150" />
                    <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
                    <f:RenderField HeaderText="GUID" DataField="GUID" Width="300" />
                    <f:RenderField HeaderText="爱好" DataField="Hobby" RendererFunction="renderHobby" Width="200" />
                    <f:RenderField HeaderText="入学时间" DataField="EntranceDate" />
                    <f:RenderField HeaderText="语文成绩" DataField="ChineseScore" />
                    <f:RenderField HeaderText="数学成绩" DataField="MathScore" />
                    <f:RenderField HeaderText="身高" DataField="ShenGao" />
                    <f:RenderField HeaderText="体重" DataField="TiZhong" />
                    <f:RenderField HeaderText="血压（低）" DataField="XueYaDi" />
                    <f:RenderField HeaderText="血压（高）" DataField="XueYaGao" />
                    <f:RenderField HeaderText="视力（左）" DataField="ShiLiZuo" />
                    <f:RenderField HeaderText="视力（右）" DataField="ShiLiYou" />
                    <f:RenderField HeaderText="矫正视力（左）" DataField="ShiLiZuoJiaoZhen" Width="150" />
                    <f:RenderField HeaderText="矫正视力（右）" DataField="ShiLiYouJiaoZhen" Width="150" />
                </Columns>
            </f:Grid>
            <f:Grid ID="Grid2" BoxFlex="1" ShowBorder="true" ShowHeader="true" Title="表格二" DataIDField="Id" DataTextField="Name">
                <Columns>
                    <f:RowNumberField />
                    <f:RenderField HeaderText="姓名" DataField="Name" />
                    <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
                    <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
                    <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
                    <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" Width="150" />
                    <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
                    <f:RenderField HeaderText="GUID" DataField="GUID" Width="300" />
                    <f:RenderField HeaderText="爱好" DataField="Hobby" RendererFunction="renderHobby" Width="200" />
                    <f:RenderField HeaderText="入学时间" DataField="EntranceDate" />
                    <f:RenderField HeaderText="语文成绩" DataField="ChineseScore" />
                    <f:RenderField HeaderText="数学成绩" DataField="MathScore" />
                    <f:RenderField HeaderText="身高" DataField="ShenGao" />
                    <f:RenderField HeaderText="体重" DataField="TiZhong" />
                    <f:RenderField HeaderText="血压（低）" DataField="XueYaDi" />
                    <f:RenderField HeaderText="血压（高）" DataField="XueYaGao" />
                    <f:RenderField HeaderText="视力（左）" DataField="ShiLiZuo" />
                    <f:RenderField HeaderText="视力（右）" DataField="ShiLiYou" />
                    <f:RenderField HeaderText="矫正视力（左）" DataField="ShiLiZuoJiaoZhen" Width="150" />
                    <f:RenderField HeaderText="矫正视力（右）" DataField="ShiLiYouJiaoZhen" Width="150" />
                </Columns>
            </f:Grid>
        </Items>
    </f:Panel>


}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderHobby(value, params) {
            var result = [];

            // Hobby：reading,basketball,travel,movie,music
            // 爱好：读书, 篮球, 旅游, 电影, 音乐
            var hobbies = value.split(',');

            $.each(hobbies, function (index, hobby) {
                if (hobby == "reading") {
                    result.push("读书");
                }
                else if (hobby == "basketball") {
                    result.push("篮球");
                }
                else if (hobby == "travel") {
                    result.push("旅游");
                }
                else if (hobby == "movie") {
                    result.push("电影");
                }
                else if (hobby == "music") {
                    result.push("音乐");
                }
            });

            return result.join(',');
        }


        function syncGridScrollbar(el1, el2) {
            el1.on('scroll', function () {
                el2.scrollLeft(el1.scrollLeft());
                el2.scrollTop(el1.scrollTop());
            });

            el2.on('scroll', function () {
                el1.scrollLeft(el2.scrollLeft());
                el1.scrollTop(el2.scrollTop());
            });
        }

        F.ready(function () {

            var grid1ScrollEl = F.ui.Grid1.getScrollEl();
            var grid2ScrollEl = F.ui.Grid2.getScrollEl();

            syncGridScrollbar(grid1ScrollEl, grid2ScrollEl);
            syncGridScrollbar(grid2ScrollEl, grid1ScrollEl);

        });

    </script>
}
