@page
@model FineUI.Core.Examples.Pages.GridOther.EmptyTextFewColumnsModel
@{
    ViewBag.Title = "GridOther/EmptyTextFewColumns";
    var F = Html.F();
}


@section head {

    <style>
        .grid-empty-text {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 500px;
            margin-left: -250px;
            margin-top: -15px;
            font-size: 24px;
            text-align: center;
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" Height="350" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name"
            _EmptyTextRawHtml="@("<div class=\"grid-empty-text\">Oops...一条数据也没有找到！</div>")">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" Hidden="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" Hidden="true" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" Hidden="true" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" Hidden="true" />
        </Columns>
        <Attributes>
            <f:Attribute Key="data-source-key" Value="source1"></f:Attribute>
        </Attributes>
    </f:Grid>
    <br />
    <f:Button ID="Button1" Text="重新绑定表格" CssClass="marginr" OnClick="Button1_Click"></f:Button>

    <br>
    <br>
    注：初始隐藏了很多列，使得表格的宽度不足以放得下空信息，所以将空信息绝对定位。

}


@section script {

    <script src="~/res/js/grid.js"></script>

}