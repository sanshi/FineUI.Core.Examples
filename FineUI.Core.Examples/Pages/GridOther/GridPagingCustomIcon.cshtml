@page
@model FineUI.Core.Examples.Pages.GridOther.GridPagingCustomIconModel
@{
    ViewBag.Title = "GridOther/GridPagingCustomIcon";
    var F = Html.F();
}


@section head {

    <style>
        .f-grid-pager .f-btn-icon.f-icon {
            font-family: FontAwesome;
        }

        .f-grid-pager.f-grid-pager-firstpage .f-icon:before {
            content: "\f048";
        }

        .f-grid-pager.f-grid-pager-prevpage .f-icon:before {
            content: "\f0d9";
        }

        .f-grid-pager.f-grid-pager-nextpage .f-icon:before {
            content: "\f0da";
        }

        .f-grid-pager.f-grid-pager-lastpage .f-icon:before {
            content: "\f051";
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
        AllowPaging="true" PageSize="5">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>


}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>替换分页栏四个方向按钮的图标，同时保留原有的翻页行为。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>使用替换后的分页图标</h3>
        <ul>
            <li>依次使用<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>分页栏的下一页、上一页、末页和首页图标。<br />结果：记录与当前页码按按钮含义变化；自定义图标只改变外观，不改变分页功能。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>CSS</code>（<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：本页通过分页按钮对应的样式选择器替换图标；图标位置与翻页功能保持对应。</li>
        </ul>
    </section>
}
