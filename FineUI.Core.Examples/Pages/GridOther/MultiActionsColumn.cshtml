@page
@model FineUI.Core.Examples.Pages.GridOther.MultiActionsColumnModel
@{
    ViewBag.Title = "GridOther/MultiActionsColumn";
    var F = Html.F();
}


@section head {

    <style>
        .f-grid-cell-Actions .action {
            display: inline-block;
            vertical-align: middle;
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataSource="@DataSourceUtil.GetDataTable()">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField ColumnID="Actions" RendererFunction="renderActions" Width="180" />
        </Columns>
        <Listeners>
            <f:Listener Event="dataload" Handler="onGridDataLoad"></f:Listener>
        </Listeners>
    </f:Grid>
    <br>
    <br>

    <f:Window ID="Window1" Title="审批" Hidden="true" EnableIFrame="true"
              EnableMaximize="true" EnableResize="true" Target="Top" OnClose="Window1_Close" IsModal="true" Width="850" Height="500">
    </f:Window>


    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderActions(value, params) {
            return '<a class="action editit" href="javascript:;">' +
                '<img class="f-grid-imagefield" src="' + F.resolveUrl('/res/icon/pencil.png') + '">' +
                '</a>' +
                '&nbsp;&nbsp;' +
                '<a class="action deleteit" href="javascript:;">' +
                '<img class="f-grid-imagefield" src="' + F.resolveUrl('/res/icon/delete.png') + '">' +
                '</a>' +
                '&nbsp;&nbsp;&nbsp;&nbsp;' +
                '<div class="action btncontainer"></div>';
        }



        // 表格数据加载完毕
        function onGridDataLoad(event) {
            var grid = this;

            grid.bodyEl.find('.f-grid-cell-Actions .btncontainer').each(function () {
                var btncontainer = $(this);
                F.create({
                    type: 'Button',
                    renderTo: btncontainer,
                    iconFont: 'user',
                    text: '动态按钮'
                });
            });

            // 动态创建的按钮会导致表格内内容错位，需要重新布局
            grid.doLayout();
        }

        F.ready(function () {

            var grid = F.ui.Grid1;
            var wnd = F.ui.Window1;

            grid.el.on('click', '.f-grid-cell-Actions .action.editit', function (event) {
                var targetEl = $(this);
                var rowEl = targetEl.closest('.f-grid-row');
                var rowData = grid.getRowData(rowEl);
                var rowId = rowData.id;
                var rowText = rowData.text;

                // grid_iframe_window.aspx?id=104&name=刘国
                var iframeUrl = F.resolveUrl('/Grid/IFrameWindow?id=' + rowId + '&name=' + encodeURIComponent(rowText));
                // 显示窗体
                wnd.show(iframeUrl, '审批 - ' + rowText);
            });


            grid.el.on('click', '.f-grid-cell-Actions .action.deleteit', function (event) {
                var targetEl = $(this);
                var rowEl = targetEl.closest('.f-grid-row');
                var rowData = grid.getRowData(rowEl);

                F.confirm({
                    message: '删除选中行？',
                    messageIcon: 'warning',
                    target: '_top',
                    ok: function () {
                        // 触发后台事件
                        F.customEvent('Grid1_CustomDelete', {
                            rowIndex: rowEl.index(),
                            rowId: rowData.id,
                            rowText: rowData.text
                        });
                    }
                });

            });


            grid.el.on('click', '.f-grid-cell-Actions .action.btncontainer', function (event) {
                var targetEl = $(this);
                var rowEl = targetEl.closest('.f-grid-row');
                var rowData = grid.getRowData(rowEl);

                // 触发后台事件
                F.customEvent('Grid1_CustomEdit', {
                    rowIndex: rowEl.index(),
                    rowId: rowData.id,
                    rowText: rowData.text
                });
            });

        });

    </script>
}
