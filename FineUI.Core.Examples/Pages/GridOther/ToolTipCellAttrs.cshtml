@page
@model FineUI.Core.Examples.Pages.GridOther.ToolTipCellAttrsModel
@{
    ViewBag.Title = "GridOther/ToolTipCellAttrs";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" Width="150" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajorLink" ExpandUnusedSpace="true" MinWidth="150" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderMajor(value, params) {
            params.cellAttrs = {
                'data-qtip': F.htmlEncode(value)
            };
            return value;
        }

        function renderMajorLink(value, params) {
            var encodedValue = F.htmlEncode(value);
            params.cellAttrs = {
                'data-qtip': encodedValue
            };
            //var url = 'http://gsa.ustc.edu.cn/search?q=' + F.urlEncode(value);
            //return F.formatString('<a href="{0}" target="_blank">{1}</a>', url, F.htmlEncode(value));
            return $('<a>', {
                'target': '_blank',
                'href': 'http://gsa.ustc.edu.cn/search?q=' + F.urlEncode(value),
                'html': encodedValue
            });
        }

    </script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>在渲染函数中给单元格本身设置提示属性，扩大提示触发范围。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>悬停查看单元格提示</h3>
    <ul>
        <li>把鼠标移到<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>的专业等提示单元格的文字与空白边缘。<br />结果：整个单元格都可触发提示，因为 data-qtip 写在单元格属性中，而不是只写在内部文字或链接上。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>params.cellAttrs / data-qtip</code>（<strong>列渲染函数</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：渲染时把提示属性写入当前单元格，空白部分也在触发范围内。</li>
    </ul>
</section>
}
