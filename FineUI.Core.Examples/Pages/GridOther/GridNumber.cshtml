@page
@model FineUI.Core.Examples.Pages.GridOther.GridNumberModel
@{
    ViewBag.SourceFiles = "~/wwwroot/res/js/grid.js";
    ViewBag.Title = "GridOther/GridNumber";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField Width="150" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" HeaderText="入学日期"></f:RenderField>
            <f:RenderField Width="150" DataField="Salary" HeaderText="工资（千分位）" FieldType="Double" Renderer="Number" RendererArgument="N2" />
            <f:RenderField Width="150" DataField="GPA" HeaderText="绩点（定点数）" FieldType="Double" Renderer="Number" RendererArgument="F2" />
            <f:RenderField Width="150" DataField="AttendanceRate" HeaderText="出勤率（百分比）" FieldType="Double" Renderer="Number" RendererArgument="P1" />
            <f:RenderField Width="150" DataField="ResearchFund" HeaderText="科研经费（科学计数法）" FieldType="Double" Renderer="Number" RendererArgument="E2" />
            <f:RenderField Width="150" DataField="StudentCode" HeaderText="学号（十进制整数）" FieldType="Int" Renderer="Number" RendererArgument="D10" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>为金额、小数、百分比及编号分别指定数字显示格式。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>比较不同数字列的输出</h3>
    <ul>
        <li>查看<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>中工资、绩点等数值列。<br />结果：各列分别显示千分位、小数位、百分比、科学记数或补零编号，具体形式由每列格式决定；同一数字类型不要求采用同一格式。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Renderer / RendererArgument</code>（<strong>数值列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：按列选择 Number 渲染及格式字符串，例如 <code>N2</code> 表示带分组分隔的两位小数。</li>
    </ul>
</section>
}
