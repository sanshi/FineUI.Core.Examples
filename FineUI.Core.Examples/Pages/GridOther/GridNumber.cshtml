@page
@model FineUI.Core.Examples.Pages.GridOther.GridNumberModel
@{
    ViewBag.SourceFiles = "~/wwwroot/res/js/grid.js";
    ViewBag.Title = "GridOther/GridNumber";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataSource="@Model.GetExtendedDataTable()">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField Width="150" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" HeaderText="入学日期"></f:RenderField>
            <f:RenderField Width="150" DataField="Salary" HeaderText="工资（千分位）" FieldType="Double" Renderer="Number" RendererArgument="N2" />
            <f:RenderField Width="150" DataField="GPA" HeaderText="绩点（定点数）" FieldType="Double" Renderer="Number" RendererArgument="F2" />
            <f:RenderField Width="150" DataField="AttendanceRate" HeaderText="出勤率（百分比）" FieldType="Double" Renderer="Number" RendererArgument="P1" />
            <f:RenderField Width="150" DataField="ResearchFund" HeaderText="科研经费（科学计数法）" FieldType="Double" Renderer="Number" RendererArgument="E2" />
            <f:RenderField Width="150" DataField="StudentCode" HeaderText="学号（十进制整数）" FieldType="Int" Renderer="Number" RendererArgument="D10" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}