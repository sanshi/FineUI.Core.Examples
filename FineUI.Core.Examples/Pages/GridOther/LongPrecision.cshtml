@page
@model FineUI.Core.Examples.Pages.GridOther.LongPrecisionModel
@{
    ViewBag.Title = "GridOther/LongPrecision";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="默认配置（全局配置项 GridConvertLongToString 为 true）：Id 完整" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField DataField="Id" Width="200" HeaderText="Id" />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
        </Columns>
    </f:Grid>

    <br />

    <f:Grid ID="Grid2" ConvertLongToString="false" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格属性 ConvertLongToString 设为 false（关闭转换）：Id 被 JavaScript 改写" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField DataField="Id" Width="200" HeaderText="Id" />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
        </Columns>
    </f:Grid>

    <br />
    <br />
    注：两个表格绑定的是同一份数据，Id 在数据库中的实际值是 21956392701267968（17 位，超过 JavaScript 能精确表示的整数范围）。请对比两个表格的 Id 列。

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
