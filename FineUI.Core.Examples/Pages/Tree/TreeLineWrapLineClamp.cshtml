@page
@model FineUI.Core.Examples.Pages.Tree.TreeLineWrapLineClampModel
@{
    ViewBag.Title = "Tree/TreeLineWrapLineClamp";
    var F = Html.F();
}


@section head {

    <style>
        .nodetitle {
            font-weight: bold;
        }

        /* 最多显示 2 行文字，超出则显示省略号 */
        .f-tree-node .f-tree-cell-text {
            white-space: normal;
            word-break: break-all;
            overflow: hidden;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            display: -webkit-box;
        }
    </style>

}



@section body {

    <f:Tree ID="Tree1" IsFluid="true" ShowHeader="true" Title="树控件" EnableCollapse="false" Width="350">
        <Nodes>
            <f:TreeNode Text="中国" Expanded="true" NodeID="china">
                <f:TreeNode Text="河南省" Expanded="true" NodeID="henan">
                    <f:TreeNode _TextRawHtml="<span class='nodetitle'>驻马店市</span>，位于河南省南部，地处淮河流域，历史悠久，文化底蕴深厚。因古时设驿站而得名，素有“豫州之腹地、天下之最中”之称。农业发达，是全国重要的粮食生产基地，被誉为“中原粮仓”。" NodeID="zhumadian">
                        <f:TreeNode Text="遂平县" Leaf="false" NodeID="suiping">
                            <f:TreeNode Text="槐树乡" Leaf="false" NodeID="huaishu">
                                <f:TreeNode Text="陈庄村" NodeID="chenzhuang">
                                </f:TreeNode>
                            </f:TreeNode>
                        </f:TreeNode>
                    </f:TreeNode>
                    <f:TreeNode Text="漯河市" NodeID="luohe" />
                </f:TreeNode>
                <f:TreeNode Text="安徽省" Expanded="true" NodeID="anhui">
                    <f:TreeNode Text="合肥市" Expanded="true" NodeID="hefei">
                        <f:TreeNode Text="金色池塘小区" NodeID="golden">
                        </f:TreeNode>
                        <f:TreeNode Text="中国科学技术大学" NodeID="ustc">
                        </f:TreeNode>
                    </f:TreeNode>
                </f:TreeNode>
            </f:TreeNode>
        </Nodes>
    </f:Tree>

}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示长节点文字最多显示指定行数，超出部分使用省略效果。</p>
    <h3><i class="f-iconfont f-iconfont-list" aria-hidden="true"></i>阅读长节点文字</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>对照长文字节点与较短节点。<br />结果：长节点文字按本页多行截断样式显示，节点不会无限增高。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Text</code>（<strong>树节点</strong>，位于<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>）：提供节点文字；本页需要显示的 HTML 由示例自身提供。</li>
        <li><code>line-clamp</code>（<strong>节点文字元素</strong>）：本页 CSS 限制节点文字的可见行数。</li>
    </ul>
</section>
}
