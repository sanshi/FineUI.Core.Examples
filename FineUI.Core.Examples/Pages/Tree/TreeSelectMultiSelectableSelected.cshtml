@page
@model FineUI.Core.Examples.Pages.Tree.TreeSelectMultiSelectableSelectedModel
@{
    ViewBag.Title = "Tree/TreeSelectMultiSelectableSelected";
    var F = Html.F();
}


@section head {

    <style>
        /* 设置不可选择节点的文本样式 */
        .f-tree-node-unselectable .f-tree-cell-icon.f-tree-folder,
        .f-tree-node-unselectable .f-tree-cell-text {
            opacity: 0.6;
        }
    </style>

}


@section body {

    <f:Tree ID="Tree1" IsFluid="true" ShowHeader="true" Title="树控件" EnableMultiSelect="true" EnableSingleClickExpand="true">
        <Nodes>
            <f:TreeNode Text="中国" Expanded="true" NodeID="china">
                <f:TreeNode Text="河南省" Expanded="true" NodeID="henan" Selectable="false">
                    <f:TreeNode Text="驻马店市" Expanded="true" NodeID="zhumadian">
                        <f:TreeNode Text="遂平县" NodeID="suiping">
                        </f:TreeNode>
                        <f:TreeNode Text="西平县" NodeID="xiping">
                        </f:TreeNode>
                    </f:TreeNode>
                    <f:TreeNode Text="漯河市" NodeID="luohe" />
                </f:TreeNode>
                <f:TreeNode Text="安徽省" Expanded="true" NodeID="anhui" Selectable="false">
                    <f:TreeNode Text="合肥市" NodeID="hefei">
                    </f:TreeNode>
                    <f:TreeNode Text="黄山市" NodeID="huangshan">
                    </f:TreeNode>
                </f:TreeNode>
            </f:TreeNode>
        </Nodes>
    </f:Tree>
    <br>
    <br>
            注：本示例默认禁用[河南省]和[安徽省]两个节点，默认选中[河南省]和[驻马店市]两个节点。
    <br>
    <br>

    <f:Button ID="btnGetSelectedValues" OnClick="btnGetSelectedValues_Click" CssClass="marginr" Text="获取选中的节点列表"></f:Button>

    <f:Button ID="btnSelectOthers" OnClick="btnSelectOthers_Click" Text="继续选中[合肥市]和[黄山市]"></f:Button>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>
    <br>
    <br>


}



@section script {



}