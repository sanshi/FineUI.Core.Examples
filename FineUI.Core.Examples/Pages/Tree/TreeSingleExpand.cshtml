@page
@model FineUI.Core.Examples.Pages.Tree.TreeSingleExpandModel
@{
    ViewBag.Title = "Tree/TreeSingleExpand";
    var F = Html.F();
}


@section body {

    <f:Tree ID="Tree1" IsFluid="true" ShowHeader="true" Title="树控件（EnableSingleExpand）" EnableCollapse="false" EnableSingleClickExpand="false" EnableSingleExpand="true">
        <Nodes>
            <f:TreeNode Text="中国" Expanded="true" NodeID="china">
                <f:TreeNode Text="河南省" NodeID="henan">
                    <f:TreeNode Text="驻马店市" NodeID="zhumadian">
                        <f:TreeNode Text="遂平县" Leaf="false" NodeID="suiping">
                            <f:TreeNode Text="槐树乡" Leaf="false" NodeID="huaishu">
                                <f:TreeNode Text="陈庄村" NodeID="chenzhuang">
                                </f:TreeNode>
                            </f:TreeNode>
                            <f:TreeNode Text="嵖岈山乡" NodeID="chayashanxiang">
                            </f:TreeNode>
                        </f:TreeNode>
                        <f:TreeNode Text="西平县" Leaf="false" NodeID="xiping">
                            <f:TreeNode Text="芦庙乡" NodeID="lumiaoxiang">
                            </f:TreeNode>
                            <f:TreeNode Text="杨庄乡" NodeID="yangzhuangxiang">
                            </f:TreeNode>
                        </f:TreeNode>
                    </f:TreeNode>
                    <f:TreeNode Text="漯河市" NodeID="luohe"></f:TreeNode>
                </f:TreeNode>
                <f:TreeNode Text="安徽省" Expanded="true" NodeID="anhui">
                    <f:TreeNode Text="合肥市" Expanded="true" NodeID="hefei">
                        <f:TreeNode Text="金色池塘小区" NodeID="golden">
                        </f:TreeNode>
                        <f:TreeNode Text="中国科学技术大学" NodeID="ustc">
                        </f:TreeNode>
                    </f:TreeNode>
                </f:TreeNode>
            </f:TreeNode>
        </Nodes>
    </f:Tree>

    <br />
    初始启用同级单节点展开；下方按钮可切换同级展开与双击展开规则，不改变已有展开状态。
    <br />
    <f:Button ID="btnToggleExpandOptions" Text="切换展开规则" OnClick="btnToggleExpandOptions_Click" />
    <f:Label ID="labExpandOptions" Text="同级单节点展开：开启；双击展开：开启" />

}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示同级目录互斥展开，并切换单节点展开与双击展开规则。</p>
    <h3><i class="f-iconfont f-iconfont-list" aria-hidden="true"></i>比较展开规则</h3>
    <ol>
        <li>先展开<strong class="example-control-reference" data-example-control="Tree1" title="树控件（EnableSingleExpand）">树控件（EnableSingleExpand）</strong>的<code>安徽省</code>，再展开同级的<code>河南省</code>。<br />结果：河南省展开时，安徽省自动折叠；互斥范围是同级节点，不会折叠整棵树。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnToggleExpandOptions" title="切换展开规则">切换展开规则</strong>。<br />结果：后台切换当前展开设置，并更新页面上的状态文字；再次展开同级目录时按新规则执行。</li>
    </ol>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableSingleExpand</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件（EnableSingleExpand）">树控件（EnableSingleExpand）</strong>）：初始为 <code>true</code>，同级目录最多保持一个展开。 本页使用<code>true</code>。</li>
        <li><code>EnableSingleClickExpand</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件（EnableSingleExpand）">树控件（EnableSingleExpand）</strong>）：本页关闭单击文字展开；可用展开图标或双击目录文字。 本页使用<code>false</code>。</li>
    </ul>
</section>
}
