@page
@model FineUI.Core.Examples.Pages.Tree.TreeNodeCssClassModel
@{
    ViewBag.Title = "Tree/TreeNodeCssClass";
    var F = Html.F();
}


@section head {

    <style>
        .important .f-tree-cell-text {
            color: red;
            font-weight: bold;
        }
    </style>


}

@section body {

    <f:Tree ID="Tree1" IsFluid="true" ShowHeader="true" Title="树控件" EnableCollapse="false" SelectedNodeID="zhumadian">
        <Nodes>
            <f:TreeNode Text="中国" Expanded="true" NodeID="china">
                <f:TreeNode Text="河南省" Expanded="true" NodeID="henan" CssClass="important">
                    <f:TreeNode Text="驻马店市" NodeID="zhumadian">
                        <f:TreeNode Text="遂平县" Leaf="false" NodeID="suiping">
                            <f:TreeNode Text="槐树乡" Leaf="false" NodeID="huaishu">
                                <f:TreeNode Text="陈庄村" NodeID="chenzhuang">
                                </f:TreeNode>
                            </f:TreeNode>
                        </f:TreeNode>
                    </f:TreeNode>
                    <f:TreeNode Text="漯河市" NodeID="luohe" />
                </f:TreeNode>
                <f:TreeNode Text="安徽省" Expanded="true" NodeID="anhui" CssClass="important">
                    <f:TreeNode Text="合肥市" Expanded="true" NodeID="hefei">
                        <f:TreeNode Text="金色池塘小区" NodeID="golden">
                        </f:TreeNode>
                        <f:TreeNode Text="中国科学技术大学" NodeID="ustc">
                        </f:TreeNode>
                    </f:TreeNode>
                </f:TreeNode>
            </f:TreeNode>
        </Nodes>
    </f:Tree>
    <br />
    <br />



}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示为指定树节点添加样式类，改变节点文字外观。</p>
    <h3><i class="f-iconfont f-iconfont-pic" aria-hidden="true"></i>对照特殊节点样式</h3>
    <ul>
        <li>展开<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>，对照加粗红色节点与其它节点。<br />结果：只有带本页特殊样式类的节点显示对应文字样式，节点层级和选择能力不受影响。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <ul>
        <li>本示例高亮显示[河南省]和[安徽省]两个节点。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>CssClass</code>（<strong>树节点</strong>，位于<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>）：把指定样式类附加到节点，本页用 CSS 设置红色与粗体。</li>
    </ul>
</section>
}
