@page
@model FineUI.Core.Examples.Pages.Tree.TreeNodeExpandModel
@{
    ViewBag.Title = "Tree/TreeNodeExpand";
    var F = Html.F();
}


@section body {

    <f:Tree ID="Tree1" IsFluid="true" ShowHeader="true" Title="树控件" OnNodeExpand="Tree1_NodeExpand" OnNodeCollapse="Tree1_NodeCollapse">
        <Nodes>
            <f:TreeNode Text="中国" Expanded="true" NodeID="china">
                <f:TreeNode Text="河南省" Expanded="true" NodeID="henan">
                    <f:TreeNode Text="驻马店市" Expanded="true" NodeID="zhumadian">
                        <f:TreeNode Text="遂平县" NodeID="suiping">
                        </f:TreeNode>
                        <f:TreeNode Text="西平县" NodeID="xiping">
                        </f:TreeNode>
                    </f:TreeNode>
                    <f:TreeNode Text="漯河市" NodeID="luohe" />
                </f:TreeNode>
                <f:TreeNode Text="安徽省" Expanded="true" NodeID="anhui">
                    <f:TreeNode Text="合肥市" NodeID="hefei">
                    </f:TreeNode>
                    <f:TreeNode Text="黄山市" NodeID="huangshan">
                    </f:TreeNode>
                </f:TreeNode>
            </f:TreeNode>
        </Nodes>
    </f:Tree>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>


}


@section script {


}
@section exampleDescription {
<section aria-label="页面描述">
    <p>演示分别处理树节点展开和折叠事件，读取对应节点信息。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>展开与折叠回发</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>折叠<code>驻马店市</code>，再重新展开。<br />结果：两次操作分别回发，后台在结果标签显示折叠或展开的节点名称及标识。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>OnNodeExpand</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>）：展开目录时处理当前节点。</li>
        <li><code>OnNodeCollapse</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>）：折叠目录时处理当前节点。</li>
    </ul>
</section>
}
