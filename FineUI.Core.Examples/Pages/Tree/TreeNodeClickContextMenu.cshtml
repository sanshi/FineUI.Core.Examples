@page
@model FineUI.Core.Examples.Pages.Tree.TreeNodeClickContextMenuModel
@{
    ViewBag.Title = "Tree/TreeNodeClickContextMenu";
    var F = Html.F();
}


@section body {

    <f:Tree ID="Tree1" IsFluid="true" ShowHeader="true" Title="树控件">
        <Nodes>
            <f:TreeNode Text="中国" Expanded="true" NodeID="china">
                <f:TreeNode Text="河南省" Expanded="true" NodeID="henan">
                    <f:TreeNode Text="驻马店市（点击回发）" Expanded="true" NodeID="zhumadian">
                        <f:TreeNode Text="遂平县（点击回发）" NodeID="suiping">
                        </f:TreeNode>
                        <f:TreeNode Text="西平县（点击回发，确认提示框）" NodeID="xiping">
                        </f:TreeNode>
                    </f:TreeNode>
                    <f:TreeNode Text="漯河市" NodeID="luohe" />
                </f:TreeNode>
                <f:TreeNode Text="安徽省" Expanded="true" NodeID="anhui">
                    <f:TreeNode Text="合肥市" NodeID="hefei">
                    </f:TreeNode>
                    <f:TreeNode Text="黄山市" NodeID="huangshan">
                    </f:TreeNode>
                </f:TreeNode>
            </f:TreeNode>
        </Nodes>
        <Listeners>
            <f:Listener Event="nodeclick" Handler="onTree1NodeClick"></f:Listener>
        </Listeners>
    </f:Tree>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>
    <br>
    <br>



}


@section script {

    <script>

        F.ready(function () {

            // 点击右键菜单时，触发 nodeclick 事件
            F.ui.Tree1.on('beforenodecontextmenu', function (event, nodeId) {
                this.trigger('nodeclick', [event, nodeId]);
            });

        });


        function onTree1NodeClick(event, nodeId) {
            var tree = this;

            // 节点为西平县时，先弹出确认提示框
            if (nodeId === 'xiping') {
                if (!confirm('确定回发？')) {
                    return;
                }
            }


            if ($.inArray(nodeId, ["zhumadian", "suiping", "xiping"]) >= 0) {
                var nodeData = tree.getNodeData(nodeId);

                // 触发后台事件
                F.customEvent('Tree1_NodeClick', nodeId);
            }
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示右键节点时也触发本页配置的节点点击处理。</p>
    <h3><i class="f-iconfont f-iconfont-edit" aria-hidden="true"></i>用右键触发节点事件</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>右键点击<code>遂平县</code>。<br />结果：右键会触发节点配置的点击事件并回发，结果标签显示当前节点标识与名称。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <ul>
        <li>在树节点上点击右键菜单时，会触发 <code>nodeclick</code> 事件。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>beforenodecontextmenu</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>）：本页在右键菜单事件前主动触发 <code>nodeclick</code>，使它沿用节点点击处理。</li>
    </ul>
</section>
}
