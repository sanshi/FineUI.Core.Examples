@page
@model FineUI.Core.Examples.Pages.Tree.CheckBoxCustomModel
@{
    ViewBag.Title = "Tree/CheckBoxCustom";
    var F = Html.F();
}


@section body {

    <f:Tree ID="Tree1" IsFluid="true" ShowHeader="true" Title="树控件" EnableCheckBox="true">
        <Nodes>
            <f:TreeNode Text="中国（不显示复选框）" EnableCheckBox="false" Expanded="true" NodeID="china">
                <f:TreeNode Text="河南省" Expanded="true" NodeID="henan">
                    <f:TreeNode Text="驻马店市" NodeID="zhumadian">
                        <f:TreeNode Text="遂平县" NodeID="suiping">
                        </f:TreeNode>
                        <f:TreeNode Text="西平县" NodeID="xiping">
                        </f:TreeNode>
                    </f:TreeNode>
                    <f:TreeNode Text="漯河市" NodeID="luohe" />
                </f:TreeNode>
                <f:TreeNode Text="安徽省" Expanded="true" NodeID="anhui">
                    <f:TreeNode Text="合肥市（不显示复选框）" EnableCheckBox="false" NodeID="hefei">
                    </f:TreeNode>
                    <f:TreeNode Text="黄山市（不显示复选框）" EnableCheckBox="false" NodeID="huangshan">
                    </f:TreeNode>
                </f:TreeNode>
            </f:TreeNode>
        </Nodes>
    </f:Tree>
    <br>

    <f:Button ID="btnGetCheckedValues" Text="获取选中的复选框" OnClick="btnGetCheckedValues_Click"></f:Button>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>


}


@section script {


}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示隐藏指定树节点的复选框，保留其它节点的正常展开与勾选。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-check-box" aria-hidden="true"></i>对照可勾选范围</h3>
    <ul>
        <li>展开<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>的目录，对照目录和叶子节点。<br />结果：中国及指定城市不显示复选框，其它可勾选节点仍正常显示。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableCheckBox</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>）：初始为<code>true</code>，树开启复选框，个别节点另外覆盖勾选能力。</li>
        <li><code>EnableCheckBox</code>（<strong>树节点</strong>，位于<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>）：指定节点设为 <code>false</code>，不为它生成复选框。</li>
    </ul>
</section>
}
