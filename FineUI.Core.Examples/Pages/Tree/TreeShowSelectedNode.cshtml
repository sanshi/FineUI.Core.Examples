@page
@model FineUI.Core.Examples.Pages.Tree.TreeShowSelectedNodeModel
@{
    ViewBag.Title = "Tree/TreeShowSelectedNode";
    var F = Html.F();
}


@section body {

    <f:Tree ID="Tree1" IsFluid="true" ShowHeader="true" Title="树控件" EnableCollapse="false" ShowSelectedNode="false" EnableNodeHoverState="false">
        <Nodes>
            <f:TreeNode Text="中国" Expanded="true" NodeID="china">
                <f:TreeNode Text="河南省" Expanded="true" NodeID="henan">
                    <f:TreeNode Text="驻马店市" NodeID="zhumadian">
                        <f:TreeNode Text="遂平县" Leaf="false" NodeID="suiping">
                            <f:TreeNode Text="槐树乡" Leaf="false" NodeID="huaishu">
                                <f:TreeNode Text="陈庄村" NodeID="chenzhuang">
                                </f:TreeNode>
                            </f:TreeNode>
                        </f:TreeNode>
                    </f:TreeNode>
                    <f:TreeNode Text="漯河市" NodeID="luohe" />
                </f:TreeNode>
                <f:TreeNode Text="安徽省" Expanded="true" NodeID="anhui">
                    <f:TreeNode Text="合肥市" Expanded="true" NodeID="hefei">
                        <f:TreeNode Text="金色池塘小区" NodeID="golden">
                        </f:TreeNode>
                        <f:TreeNode Text="中国科学技术大学" NodeID="ustc">
                        </f:TreeNode>
                    </f:TreeNode>
                </f:TreeNode>
            </f:TreeNode>
        </Nodes>
    </f:Tree>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示树节点仍可接收点击，但不显示选择高亮和鼠标悬停状态。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-pic" aria-hidden="true"></i>关闭交互外观</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Tree1"
                    title="树控件">树控件</strong>把鼠标移到节点上，再点击节点。<br />结果：不会出现通常的悬停或选中高亮；树的目录展开与节点数据继续保留。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ShowSelectedNode</code>（<strong class="example-control-reference" data-example-control="Tree1"
                    title="树控件">树控件</strong>）：初始为<code>false</code>，不显示选中节点外观。</li>
            <li><code>EnableNodeHoverState</code>（<strong class="example-control-reference" data-example-control="Tree1"
                    title="树控件">树控件</strong>）：初始为<code>false</code>，不显示鼠标悬停外观。</li>
        </ul>
    </section>
}
