@page
@model FineUI.Core.Examples.Pages.Tree.TreeContextMenuModel
@{
    ViewBag.Title = "Tree/TreeContextMenu";
    var F = Html.F();
}


@section body {

    <f:Tree ID="Tree1" IsFluid="true" ShowHeader="true" Title="树控件（右键菜单）" EnableCollapse="false" EnableSingleClickExpand="false">
        <Nodes>
            <f:TreeNode Text="中国" Expanded="true" NodeID="china">
                <f:TreeNode Text="河南省" NodeID="henan">
                    <f:TreeNode Text="驻马店市" NodeID="zhumadian">
                        <f:TreeNode Text="遂平县" Leaf="false" NodeID="suiping">
                            <f:TreeNode Text="槐树乡" Leaf="false" NodeID="huaishu">
                                <f:TreeNode Text="陈庄村" NodeID="chenzhuang">
                                </f:TreeNode>
                            </f:TreeNode>
                            <f:TreeNode Text="嵖岈山乡" NodeID="chayashanxiang">
                            </f:TreeNode>
                        </f:TreeNode>
                        <f:TreeNode Text="西平县" Leaf="false" NodeID="xiping">
                            <f:TreeNode Text="芦庙乡" NodeID="lumiaoxiang">
                            </f:TreeNode>
                            <f:TreeNode Text="杨庄乡" NodeID="yangzhuangxiang">
                            </f:TreeNode>
                        </f:TreeNode>
                    </f:TreeNode>
                    <f:TreeNode Text="漯河市" NodeID="luohe"></f:TreeNode>
                </f:TreeNode>
                <f:TreeNode Text="安徽省" Expanded="true" NodeID="anhui">
                    <f:TreeNode Text="合肥市" Expanded="true" NodeID="hefei">
                        <f:TreeNode Text="金色池塘小区" NodeID="golden">
                        </f:TreeNode>
                        <f:TreeNode Text="中国科学技术大学" NodeID="ustc">
                        </f:TreeNode>
                    </f:TreeNode>
                </f:TreeNode>
            </f:TreeNode>
        </Nodes>
        <Listeners>
            <f:Listener Event="beforenodecontextmenu" Handler="onTreeNodeContextMenu"></f:Listener>
        </Listeners>
    </f:Tree>

    <f:Menu ID="Menu1">
        <Items>
            <f:MenuButton ID="btnExpandNode" Text="展开全部" ClickHandler="onExpandNode"></f:MenuButton>
            <f:MenuButton ID="btnCollapseNode" Text="折叠全部" ClickHandler="onCollapseNode"></f:MenuButton>
        </Items>
        <Listeners>
            <f:Listener Event="show" Handler="onMenuShow" />
        </Listeners>
    </f:Menu>

    <br />

    <br />
    <f:Button ID="btnToggleContextSelection" Text="切换右键选中节点" OnClick="btnToggleContextSelection_Click" />
    <f:Label ID="labContextSelection" Text="右键选中节点：开启" />


}


@section script {


    <script>

        // 保存当前菜单对应的树节点ID
        var currentNodeId;

        // 返回false，来阻止浏览器右键菜单
        function onTreeNodeContextMenu(event, nodeId) {
            currentNodeId = nodeId;
            F.ui.Menu1.show();
            return false;
        }

        // 设置所有菜单项的禁用状态
        function setMenuItemsDisabled(disabled) {
            var menu = F.ui.Menu1;
            $.each(menu.items, function (index, item) {
                item.setDisabled(disabled);
            });
        }

        // 显示菜单后，检查是否禁用菜单项
        function onMenuShow(event) {
            if (currentNodeId) {
                var tree = F.ui.Tree1;
                var nodeData = tree.getNodeData(currentNodeId);
                if (nodeData.leaf) {
                    setMenuItemsDisabled(true);
                } else {
                    setMenuItemsDisabled(false);
                }
            }
        }

        function onExpandNode(event) {
            if (currentNodeId) {
                F.ui.Tree1.expandNode(currentNodeId, true);
            }
        }

        function onCollapseNode(event) {
            if (currentNodeId) {
                F.ui.Tree1.collapseNode(currentNodeId, true);
            }
        }

    </script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示按当前节点显示右键菜单，并展开或折叠该节点的整个子树。</p>
    <h3><i class="f-iconfont f-iconfont-list" aria-hidden="true"></i>对当前目录操作子树</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Tree1" title="树控件（右键菜单）">树控件（右键菜单）</strong>右键点击<code>河南省</code>，选择<strong class="example-control-reference" data-example-control="btnExpandNode" title="展开全部">展开全部</strong>。<br />结果：当前目录的子孙节点展开；右键叶子节点时，没有可展开的子树，相关菜单项禁用。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnToggleContextSelection" title="切换右键选中节点">切换右键选中节点</strong>。<br />结果：后台切换右键是否同时改变当前选择，页面状态文字同步更新。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <ul>
        <li>在叶子节点上点击右键，则弹出菜单的菜单项都是禁用状态。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>ClickOnContextMenu</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件（右键菜单）">树控件（右键菜单）</strong>）：控制右键节点时是否把该节点设为当前选择。</li>
        <li><code>nodecontextmenu</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件（右键菜单）">树控件（右键菜单）</strong>）：在当前节点位置显示菜单，并按是否有子节点启用菜单项。</li>
    </ul>
</section>
}
