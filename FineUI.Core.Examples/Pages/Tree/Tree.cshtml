@page
@model FineUI.Core.Examples.Pages.Tree.TreeModel
@{
    ViewBag.Title = "Tree/Tree";
    var F = Html.F();
}


@section body {

    <f:Tree ID="Tree1" IsFluid="true" ShowHeader="true" Title="树控件（内联）" EnableCollapse="false" SelectedNodeID="zhumadian">
        <Nodes>
            <f:TreeNode Text="中国" Expanded="true" NodeID="china">
                <f:TreeNode Text="河南省" Expanded="true" NodeID="henan">
                    <f:TreeNode Text="驻马店市" NodeID="zhumadian">
                        <f:TreeNode Text="遂平县" Leaf="false" NodeID="suiping">
                            <f:TreeNode Text="槐树乡" Leaf="false" NodeID="huaishu">
                                <f:TreeNode Text="陈庄村" NodeID="chenzhuang">
                                </f:TreeNode>
                            </f:TreeNode>
                        </f:TreeNode>
                    </f:TreeNode>
                    <f:TreeNode Text="漯河市" NodeID="luohe" />
                </f:TreeNode>
                <f:TreeNode Text="安徽省" Expanded="true" NodeID="anhui">
                    <f:TreeNode Text="合肥市" Expanded="true" NodeID="hefei">
                        <f:TreeNode Text="金色池塘小区" NodeID="golden">
                        </f:TreeNode>
                        <f:TreeNode Text="中国科学技术大学" NodeID="ustc">
                        </f:TreeNode>
                    </f:TreeNode>
                </f:TreeNode>
            </f:TreeNode>
        </Nodes>
    </f:Tree>

}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示树的层级展开、节点选择以及初始展开和选中状态。</p>
    <h3><i class="f-iconfont f-iconfont-list" aria-hidden="true"></i>展开与选择节点</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Tree1" title="树控件（内联）">树控件（内联）</strong>点击<code>河南省</code>前的展开图标，再点击<code>驻马店市</code>。<br />结果：浏览器展开当前目录并高亮选择的节点；点击其它节点时，单选高亮随之移动。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Nodes</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件（内联）">树控件（内联）</strong>）：声明节点及父子关系，节点顺序与层级决定页面上的排列。</li>
        <li><code>Expanded</code>（<strong>树节点</strong>，位于<strong class="example-control-reference" data-example-control="Tree1" title="树控件（内联）">树控件（内联）</strong>）：设为 <code>true</code> 的目录首次加载就展开；其子项可以直接点击。</li>
        <li><code>SelectedNodeID</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件（内联）">树控件（内联）</strong>）：初始设为<code>zhumadian</code>，指定首屏选中的节点；不设置时等待用户选择。</li>
    </ul>
</section>
}
