@page
@model FineUI.Core.Examples.Pages.Tree.TreeSelectMultiModel
@{
    ViewBag.Title = "Tree/TreeSelectMulti";
    var F = Html.F();
}


@section body {

    <f:Tree ID="Tree1" IsFluid="true" ShowHeader="true" Title="树控件" EnableMultiSelect="true" _SelectedNodeIDArray="zhumadian,luohe">
        <Nodes>
            <f:TreeNode Text="中国" Expanded="true" NodeID="china">
                <f:TreeNode Text="河南省" Expanded="true" NodeID="henan">
                    <f:TreeNode Text="驻马店市" Expanded="true" NodeID="zhumadian">
                        <f:TreeNode Text="遂平县" NodeID="suiping">
                        </f:TreeNode>
                        <f:TreeNode Text="西平县" NodeID="xiping">
                        </f:TreeNode>
                    </f:TreeNode>
                    <f:TreeNode Text="漯河市" NodeID="luohe" />
                </f:TreeNode>
                <f:TreeNode Text="安徽省" Expanded="true" NodeID="anhui">
                    <f:TreeNode Text="合肥市" NodeID="hefei">
                    </f:TreeNode>
                    <f:TreeNode Text="黄山市" NodeID="huangshan">
                    </f:TreeNode>
                </f:TreeNode>
            </f:TreeNode>
        </Nodes>
    </f:Tree>
    <br>
    <br>

    <br>
    <br>

    <f:Button ID="btnGetSelectedValues" OnClick="btnGetSelectedValues_Click" CssClass="marginr" Text="获取选中的节点列表"></f:Button>

    <f:Button ID="btnSelectOthers" OnClick="btnSelectOthers_Click" Text="继续选中[合肥市]和[黄山市]"></f:Button>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>
    <br>
    <br>


}



@section script {



}
@section exampleDescription {
<section aria-label="页面描述">
    <p>演示树的多选集合、后台追加选中节点和读取全部当前选择。</p>
    <h3><i class="f-iconfont f-iconfont-check" aria-hidden="true"></i>累加并读取选择</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>连续点击两个不同节点。<br />结果：当前树允许同时选择多个节点，选中集合按点击及按键规则更新。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnSelectOthers" title="继续选中[合肥市]和[黄山市]">继续选中[合肥市]和[黄山市]</strong>。<br />结果：后台保留当前集合，再加入按钮指定的合肥市、黄山市。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <ul>
        <li>这是一个可以多选的树，你可以按着 <code>Ctrl</code> 或 <code>Shift</code> 选择多项。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableMultiSelect</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>）：允许当前选择包含多个节点。 本页使用<code>true</code>。</li>
        <li><code>_SelectedNodeIDArray</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>）：保存并更新当前节点标识集合。 本页使用<code>zhumadian,luohe</code>。</li>
    </ul>
</section>
}
