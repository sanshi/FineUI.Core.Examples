@page
@model FineUI.Core.Examples.Pages.Tree.CheckBoxCascadeModel
@{
    ViewBag.Title = "Tree/CheckBoxCascade";
    var F = Html.F();
}


@section body {

    <f:Tree ID="Tree1" IsFluid="true" ShowHeader="true" Title="树控件" EnableCheckBox="true" CascadeCheck="true">
        <Nodes>
            <f:TreeNode Text="中国" Expanded="true" NodeID="china">
                <f:TreeNode Text="河南省" Expanded="true" NodeID="henan">
                    <f:TreeNode Text="驻马店市" NodeID="zhumadian">
                        <f:TreeNode Text="遂平县" NodeID="suiping">
                        </f:TreeNode>
                        <f:TreeNode Text="西平县" NodeID="xiping">
                        </f:TreeNode>
                    </f:TreeNode>
                    <f:TreeNode Text="漯河市" NodeID="luohe" />
                </f:TreeNode>
                <f:TreeNode Text="安徽省" Expanded="true" NodeID="anhui">
                    <f:TreeNode Text="合肥市" NodeID="hefei">
                    </f:TreeNode>
                    <f:TreeNode Text="黄山市" NodeID="huangshan">
                    </f:TreeNode>
                </f:TreeNode>
            </f:TreeNode>
        </Nodes>
    </f:Tree>
    <br>

    <f:Button ID="btnGetCheckedValues" CssClass="marginr" Text="获取选中的复选框" OnClick="btnGetCheckedValues_Click"></f:Button>
    <f:Button ID="btnToggleCascadeCheck" Text="切换父子级联勾选" OnClick="btnToggleCascadeCheck_Click" />
    <br>
    <f:Label ID="labCascadeCheck" Text="父子级联勾选：开启" />
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>


}


@section script {


}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示父子节点级联勾选，并切换为各节点独立勾选。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-check-box" aria-hidden="true"></i>核对级联勾选</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>勾选或取消<code>河南省</code>。<br />结果：启用级联时，可勾选子孙节点跟随父节点，父节点状态也随子节点变化。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnToggleCascadeCheck" title="切换父子级联勾选">切换父子级联勾选</strong>。<br />结果：后台更新级联开关及状态文字；关闭后，各节点可独立勾选。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>CascadeCheck</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>）：初始为<code>true</code>，启用父子级联勾选，不等同于节点的文字高亮选择。</li>
    </ul>
</section>
}
