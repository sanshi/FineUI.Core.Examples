@page
@model FineUI.Core.Examples.Pages.Tree.TreeTextSelectionModel
@{
    ViewBag.Title = "Tree/TreeTextSelection";
    var F = Html.F();
}


@section body {

    <f:Tree ID="Tree1" IsFluid="true" ShowHeader="true" Title="树控件（可以选择文字）" EnableCollapse="false" SelectedNodeID="zhumadian" EnableTextSelection="true">
        <Nodes>
            <f:TreeNode Text="中国" Expanded="true" NodeID="china">
                <f:TreeNode Text="河南省" Expanded="true" NodeID="henan">
                    <f:TreeNode Text="驻马店市" NodeID="zhumadian">
                        <f:TreeNode Text="遂平县" Leaf="false" NodeID="suiping">
                            <f:TreeNode Text="槐树乡" Leaf="false" NodeID="huaishu">
                                <f:TreeNode Text="陈庄村" NodeID="chenzhuang">
                                </f:TreeNode>
                            </f:TreeNode>
                        </f:TreeNode>
                    </f:TreeNode>
                    <f:TreeNode Text="漯河市" NodeID="luohe" />
                </f:TreeNode>
                <f:TreeNode Text="安徽省" Expanded="true" NodeID="anhui">
                    <f:TreeNode Text="合肥市" Expanded="true" NodeID="hefei">
                        <f:TreeNode Text="金色池塘小区" NodeID="golden">
                        </f:TreeNode>
                        <f:TreeNode Text="中国科学技术大学" NodeID="ustc">
                        </f:TreeNode>
                    </f:TreeNode>
                </f:TreeNode>
            </f:TreeNode>
        </Nodes>
    </f:Tree>


}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示允许鼠标拖选树节点文字，便于复制节点内容。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>选择节点文字</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Tree1" title="树控件（可以选择文字）">树控件（可以选择文字）</strong>的较长节点文字上拖动鼠标。<br />结果：文字可以像普通页面文本一样被选中、复制；目录展开入口仍保留。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableTextSelection</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件（可以选择文字）">树控件（可以选择文字）</strong>）：初始为<code>true</code>，允许节点文字的浏览器原生选择。</li>
    </ul>
</section>
}
