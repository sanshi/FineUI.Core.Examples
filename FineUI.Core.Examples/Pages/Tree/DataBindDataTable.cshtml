@page
@model FineUI.Core.Examples.Pages.Tree.DataBindDataTableModel
@{
    ViewBag.Title = "Tree/DataBindDataTable";
    var F = Html.F();
}


@section body {

    <f:Tree ID="Tree1" IsFluid="true" ShowHeader="true" Title="树控件（DataSet->Relations）">
    </f:Tree>


}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示把具有父子关系的数据记录转换为树节点层级。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>展开绑定的层级</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Tree1" title="树控件（DataSet-&gt;Relations）">树控件（DataSet-&gt;Relations）</strong>展开中国和省级目录。<br />结果：根、目录与叶子按数据关系显示，展开只影响当前分支。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Nodes</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件（DataSet-&gt;Relations）">树控件（DataSet-&gt;Relations）</strong>）：后台根据父子记录递归创建节点集合。</li>
    </ul>
</section>
}
