@page
@model FineUI.Core.Examples.Pages.Tree.TreeLazyLoadModel
@{
    ViewBag.Title = "Tree/TreeLazyLoad";
    var F = Html.F();
}


@section body {

    <f:Tree ID="Tree1" IsFluid="true" EnableCollapse="false" ShowHeader="true" Title="延迟加载的树控件" AutoLeafIdentification="false" OnNodeLazyLoad="Tree1_NodeLazyLoad">
        <Nodes>
            <f:TreeNode Text="中国" Expanded="true">
                <f:TreeNode Text="河南省" Expanded="true">
                    <f:TreeNode Text="驻马店市（延迟加载）" NodeID="zhumadian">
                    </f:TreeNode>
                    <f:TreeNode Text="漯河" NodeID="luohe" Leaf="true" />
                </f:TreeNode>
                <f:TreeNode Text="安徽省" Expanded="true" NodeID="anhui">
                    <f:TreeNode Text="合肥市" NodeID="hefei">
                        <f:TreeNode Text="金色池塘小区" NodeID="golden" Leaf="true">
                        </f:TreeNode>
                        <f:TreeNode Text="中国科学技术大学" NodeID="ustc" Leaf="true">
                        </f:TreeNode>
                    </f:TreeNode>
                </f:TreeNode>
            </f:TreeNode>
        </Nodes>
    </f:Tree>
    <br>


    <f:Button ID="btnGetSelectedNode" OnClick="btnGetSelectedNode_Click" CssClass="marginr" Text="获取选中的节点"></f:Button>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>


}


@section script {


}