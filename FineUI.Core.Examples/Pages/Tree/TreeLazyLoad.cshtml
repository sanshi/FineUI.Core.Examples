@page
@model FineUI.Core.Examples.Pages.Tree.TreeLazyLoadModel
@{
    ViewBag.Title = "Tree/TreeLazyLoad";
    var F = Html.F();
}


@section body {

    <f:Tree ID="Tree1" IsFluid="true" EnableCollapse="false" ShowHeader="true" Title="延迟加载的树控件" AutoLeafIdentification="false" OnNodeLazyLoad="Tree1_NodeLazyLoad">
        <Nodes>
            <f:TreeNode Text="中国" Expanded="true">
                <f:TreeNode Text="河南省" Expanded="true">
                    <f:TreeNode Text="驻马店市（延迟加载）" NodeID="zhumadian">
                    </f:TreeNode>
                    <f:TreeNode Text="漯河" NodeID="luohe" Leaf="true" />
                </f:TreeNode>
                <f:TreeNode Text="安徽省" Expanded="true" NodeID="anhui">
                    <f:TreeNode Text="合肥市" NodeID="hefei">
                        <f:TreeNode Text="金色池塘小区" NodeID="golden" Leaf="true">
                        </f:TreeNode>
                        <f:TreeNode Text="中国科学技术大学" NodeID="ustc" Leaf="true">
                        </f:TreeNode>
                    </f:TreeNode>
                </f:TreeNode>
            </f:TreeNode>
        </Nodes>
    </f:Tree>
    <br>


    <f:Button ID="btnGetSelectedNode" OnClick="btnGetSelectedNode_Click" CssClass="marginr" Text="获取选中的节点"></f:Button>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>


}


@section script {


}
@section exampleDescription {
<section aria-label="页面描述">
    <p>演示展开节点时才加载它的子节点，避免首次生成整棵树。</p>
    <h3><i class="f-iconfont f-iconfont-list" aria-hidden="true"></i>逐层加载子节点</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Tree1" title="延迟加载的树控件">延迟加载的树控件</strong>展开<code>驻马店市</code>，再展开新增的<code>遂平县</code>。<br />结果：每次展开尚未加载的目录都会回发，后台按节点 <code>ID</code> 添加县级或乡级子节点；已经加载的子树无需再次创建。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>AutoLeafIdentification</code>（<strong class="example-control-reference" data-example-control="Tree1" title="延迟加载的树控件">延迟加载的树控件</strong>）：设为 <code>false</code>，首次没有子节点的目录仍可以显示展开入口。 本页使用<code>false</code>。</li>
        <li><code>nodelazyload</code>（<strong class="example-control-reference" data-example-control="Tree1" title="延迟加载的树控件">延迟加载的树控件</strong>）：展开尚未加载的节点时取得其 <code>ID</code>，并加载对应的子节点。</li>
    </ul>
</section>
}
