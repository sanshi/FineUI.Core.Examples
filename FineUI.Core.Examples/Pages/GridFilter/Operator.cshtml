@page
@model FineUI.Core.Examples.Pages.GridFilter.OperatorModel
@{
    ViewBag.Title = "GridFilter/Operator";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" AllowFilters="true"
        OnFilterChanged="Grid1_FilterChanged">
        <Columns>
            <f:RowNumberField />
            <f:RenderField ColumnID="Name" HeaderText="姓名" DataField="Name" EnableFilter="true">
                <Filter>
                    <Operator>
                        <f:DropDownList>
                            <f:ListItem Text="等于" Value="equal" />
                            <f:ListItem Text="包含" Value="contain" Selected="true" />
                            <f:ListItem Text="开始于" Value="start" />
                            <f:ListItem Text="结束于" Value="end" />
                        </f:DropDownList>
                    </Operator>
                </Filter>
            </f:RenderField>
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br>
    <br>


    <f:Label ID="labResult" EncodeText="false"></f:Label>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>为姓名过滤提供等于、包含、开始于和结束于操作符。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>保持输入并改变比较方式</h3>
        <ol>
            <li>在<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>的<strong>姓名</strong>列表头过滤菜单输入<code>国</code>，选择包含并点击过滤面板的确定。<br />结果：保留<strong>姓名</strong>任意位置包含国的记录。</li>
            <li>保留输入国，将操作符改为开始于或结束于并应用。<br />结果：改按<strong>姓名</strong>开头或末尾匹配，过滤参数中的操作符随之变化；输入相同不代表过滤结果一定相同。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Filter.Operator</code>（<strong>姓名列过滤器</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：使用下拉选项提供 equal、contain、start、end，本页匹配函数分别解释各个操作符。</li>
        </ul>
    </section>
}
