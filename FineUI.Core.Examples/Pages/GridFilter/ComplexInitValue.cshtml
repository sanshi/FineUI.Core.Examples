@page
@model FineUI.Core.Examples.Pages.GridFilter.ComplexInitValueModel
@{
    ViewBag.Title = "GridFilter/ComplexInitValue";
    var F = Html.F();
}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" AllowFilters="true"
        OnFilterChanged="Grid1_FilterChanged">
        <Columns>
            <f:RowNumberField />
            <f:RenderField ColumnID="Name" HeaderText="姓名" DataField="Name" EnableFilter="true">
                <Filter EnableMultiConditions="true" MatcherDefault="any">
                    <Operator>
                        <f:DropDownList>
                            <f:ListItem Text="等于" Value="equal" />
                            <f:ListItem Text="包含" Value="contain" Selected="true" />
                            <f:ListItem Text="开始于" Value="start" />
                            <f:ListItem Text="结束于" Value="end" />
                        </f:DropDownList>
                    </Operator>
                </Filter>
            </f:RenderField>
            <f:RenderField ColumnID="Gender" HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" EnableFilter="true">
                <Filter>
                    <Field>
                        <f:RadioButtonList>
                            <f:RadioItem Text="男" Value="1" />
                            <f:RadioItem Text="女" Value="0" />
                        </f:RadioButtonList>
                    </Field>
                </Filter>
            </f:RenderField>
            <f:RenderField ColumnID="EntranceYear" HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" EnableFilter="true">
                <Filter EnableMultiConditions="true">
                    <Operator>
                        <f:DropDownList>
                            <f:ListItem Text="大于" Value="greater" Selected="true" />
                            <f:ListItem Text="小于" Value="less" />
                            <f:ListItem Text="等于" Value="equal" />
                        </f:DropDownList>
                    </Operator>
                    <Field>
                        <f:NumberBox NoDecimal="true" NoNegative="true"></f:NumberBox>
                    </Field>
                </Filter>
            </f:RenderField>
            <f:RenderCheckField ColumnID="AtSchool" HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" EnableFilter="true">
                <Filter>
                    <Field>
                        <f:RadioButtonList>
                            <f:RadioItem Text="在校" Value="true" />
                            <f:RadioItem Text="已离校" Value="false" />
                        </f:RadioButtonList>
                    </Field>
                </Filter>
            </f:RenderCheckField>
            <f:RenderField ColumnID="Major" HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150"
                EnableFilter="true">
                <Filter>
                    <Field>
                        <f:CheckBoxList ColumnNumber="1">
                            <f:CheckItem Text="材料科学与工程系" Value="材料科学与工程系" />
                            <f:CheckItem Text="化学系" Value="化学系" />
                            <f:CheckItem Text="物理系" Value="物理系" />
                            <f:CheckItem Text="数学系" Value="数学系" />
                            <f:CheckItem Text="自动化系" Value="自动化系" />
                        </f:CheckBoxList>
                    </Field>
                </Filter>
            </f:RenderField>
            <f:RenderField ColumnID="Group" HeaderText="分组" DataField="Group" RendererFunction="renderGroup" EnableFilter="true">
                <Filter>
                    <Field>
                        <f:DropDownList ID="groupList" EnableMultiSelect="true" AutoSelectFirstItem="false" MultiSelectMode="Tags">
                        </f:DropDownList>
                    </Field>
                </Filter>
            </f:RenderField>
            <f:RenderField ColumnID="LogTime" HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd"
                EnableFilter="true">
                <Filter EnableMultiConditions="true">
                    <Operator>
                        <f:DropDownList>
                            <f:ListItem Text="大于" Value="greater" Selected="true" />
                            <f:ListItem Text="小于" Value="less" />
                            <f:ListItem Text="等于" Value="equal" />
                        </f:DropDownList>
                    </Operator>
                    <Field>
                        <f:DatePicker DateFormatString="yyyy-MM-dd"></f:DatePicker>
                    </Field>
                </Filter>
            </f:RenderField>
        </Columns>
    </f:Grid>
    <br>
    <br>
    <f:Button ID="btnUpdateFilteredData" CssClass="marginr" Text="后台更新过滤数据" OnClick="btnUpdateFilteredData_Click">
    </f:Button>
    <br />
    <br />

    <br />
    <br />

    <f:Label ID="labResult" EncodeText="false"></f:Label>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>初次加载即应用表头过滤条件，并允许由后台按钮替换整组条件。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>核对初始过滤与后续替换</h3>
        <ol>
            <li>刚打开页面时查看<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>及对应过滤入口。<br />结果：<strong><strong>入学年份</strong></strong>、<strong>所学专业</strong>与<strong>分组</strong>已带有初始条件，记录已经按这些条件筛选；再次打开过滤区域可看到相同的当前条件。
            </li>
            <li>点击<strong class="example-control-reference" data-example-control="btnUpdateFilteredData"
                    title="后台更新过滤数据">后台更新过滤数据</strong>。<br />结果：后台先清除旧过滤，再设置新条件并重新绑定；原专业、<strong>分组</strong>等条件被替换，改用按钮指定的<strong>性别</strong>与年份条件。过滤入口、记录和下方参数同步更新。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：页面初始化时执行了服务器端过滤，因此需要为相关列定义 ColumnID 属性。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ColumnFilteredData / FilteredData</code>（<strong>列过滤状态与表格过滤集合</strong>，位于<strong class="example-control-reference"
                    data-example-control="Grid1" title="表格">表格</strong>）：初始条件在首次绑定前设置；替换时清除旧集合，避免新旧条件意外叠加。</li>
        </ul>
    </section>
}
