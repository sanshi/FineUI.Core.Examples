@page
@model FineUI.Core.Examples.Pages.GridFilter.NumberModel
@{
    ViewBag.Title = "GridFilter/Number";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name"
            AllowFilters="true" OnFilterChanged="Grid1_FilterChanged">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField ColumnID="EntranceYear" HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" EnableFilter="true">
                <Filter EnableMultiConditions="true">
                    <Operator>
                        <f:DropDownList>
                            <f:ListItem Text="大于" Value="greater" Selected="true" />
                            <f:ListItem Text="小于" Value="less" />
                            <f:ListItem Text="等于" Value="equal" />
                        </f:DropDownList>
                    </Operator>
                    <Field>
                        <f:NumberBox NoDecimal="true" NoNegative="true"></f:NumberBox>
                    </Field>
                </Filter>
            </f:RenderField>
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" EnableFilter="true">
                <Filter EnableMultiConditions="true">
                    <Operator>
                        <f:DropDownList>
                            <f:ListItem Text="大于" Value="greater" Selected="true" />
                            <f:ListItem Text="小于" Value="less" />
                            <f:ListItem Text="等于" Value="equal" />
                        </f:DropDownList>
                    </Operator>
                    <Field>
                        <f:DatePicker DateFormatString="yyyy/MM/dd"></f:DatePicker>
                    </Field>
                </Filter>
            </f:RenderField>
        </Columns>
    </f:Grid>
    <br>
    <br>


    <f:Label ID="labResult" EncodeText="false"></f:Label>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
