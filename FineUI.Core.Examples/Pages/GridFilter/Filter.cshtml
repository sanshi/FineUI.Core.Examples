@page
@model FineUI.Core.Examples.Pages.GridFilter.FilterModel
@{
    ViewBag.Title = "GridFilter/Filter";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" AllowFilters="true"
        OnFilterChanged="Grid1_FilterChanged">
        <Columns>
            <f:RowNumberField />
            <f:RenderField ColumnID="Name" HeaderText="姓名" DataField="Name" EnableFilter="true" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br>
    <br>


    <f:Label ID="labResult" EncodeText="false"></f:Label>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>使用姓名列表头过滤入口输入条件，提交后显示匹配学生与过滤参数。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>按姓名过滤并清除</h3>
        <ol>
            <li>在<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>的<strong>姓名</strong>列表头过滤菜单输入<code>张</code>，再点击过滤面板的确定。<br />结果：过滤条件回发，后台按本页匹配规则筛选示例数据并重新绑定，下方同步显示过滤参数。<strong>姓名</strong>包含张的记录保留。
            </li>
            <li>清除<strong>姓名</strong>过滤条件并应用。<br />结果：本列不再限制<strong>姓名</strong>；没有其他条件时重新显示全部学生，下方参数也清除对应条件。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>AllowFilters</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>true</code>，启用表格过滤入口与条件变化处理。
            </li>
            <li><code>EnableFilter</code>（<strong>姓名列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：为该列创建过滤字段；其他未启用过滤的列不额外创建入口。</li>
            <li><code>OnFilterChanged / FilteredData</code>（<strong>表格过滤处理</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：条件变化后取得完整过滤参数，再由本页代码筛选并重新绑定数据；控件不会自动生成数据库查询。</li>
        </ul>
    </section>
}
