@page
@model FineUI.Core.Examples.Pages.GridFilter.MultiMatcherModel
@{
    ViewBag.Title = "GridFilter/MultiMatcher";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name"
            AllowFilters="true" OnFilterChanged="Grid1_FilterChanged">
        <Columns>
            <f:RowNumberField />
            <f:RenderField ColumnID="Name" HeaderText="姓名" DataField="Name" EnableFilter="true">
                <Filter EnableMultiConditions="true" MaxConditions="5" MatcherDefault="any">
                    <Operator>
                        <f:DropDownList>
                            <f:ListItem Text="等于" Value="equal" />
                            <f:ListItem Text="包含" Value="contain" Selected="true" />
                            <f:ListItem Text="开始于" Value="start" />
                            <f:ListItem Text="结束于" Value="end" />
                        </f:DropDownList>
                    </Operator>
                </Filter>
            </f:RenderField>
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br />
    <br />

    <br>
    <br>


    <f:Label ID="labResult" EncodeText="false"></f:Label>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>把姓名过滤的最大条件数扩展为五条，结合任一或全部匹配规则筛选。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>增加更多同列条件</h3>
    <ol>
        <li>打开<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>的<strong>姓名</strong>列表头过滤菜单，设置包含<code>国</code>与包含<code>张</code>两个条件，使用任一匹配并确定。<br />结果：<strong>姓名</strong>包含国或张的记录保留；多个条件属于同一列，按当前匹配方式组合。</li>
        <li>继续添加第三条等条件，直到五条。<br />结果：本页最多提供五条条件，不能无限添加；修改后按当前任一或全部规则重新筛选。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <p>注：本例修改了姓名列对应过滤器的MaxConditions属性（最大条件数，默认为2）。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableMultiConditions / MatcherDefault</code>（<strong>姓名列过滤器</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：允许同列多个条件，初始匹配方式为 <code>any</code>；any 表示任一条件满足，all 表示全部满足。</li>
        <li><code>MaxConditions</code>（<strong>姓名列过滤器</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>5</code>，限制同列可配置条件的最大数量。</li>
    </ul>
</section>
}
