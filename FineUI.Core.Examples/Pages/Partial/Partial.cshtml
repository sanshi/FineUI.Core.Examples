@page
@model FineUI.Core.Examples.Pages.Partial.PartialModel
@{
    ViewBag.SourceFiles = "~/Pages/Partial/PartialView.cshtml";
    ViewBag.Title = "Partial/Partial";
    var F = Html.F();
}


@section body {

    @{
        var PartialViewIndex = 0;
    }

    <f:ContentPanel ID="Panel1" IsFluid="true" EnableCollapse="false" BodyPadding="10" Height="200" Title="面板一（Panel->PartialView）">
        @(await Html.PartialAsync("PartialView", new ViewDataDictionary(ViewData) { { "PartialViewIndex", PartialViewIndex++ }, { "UserName", "陈萍萍" }, { "UserAge", 20 }, { "UserCountry", "合肥" } }))
    </f:ContentPanel>

    <br />
    <f:Panel ID="Panel2" IsFluid="true" EnableCollapse="false" BodyPadding="10" Height="200" Title="面板二（Panel->PartialConnector->PartialView）">
        <Items>
            <f:PartialConnector Content="@(await Html.PartialAsync("PartialView", new ViewDataDictionary(ViewData) { { "PartialViewIndex", PartialViewIndex++ }, { "UserName", "陈萍萍" }, { "UserAge", 20 }, { "UserCountry", "合肥" } }))">
            </f:PartialConnector>
        </Items>
    </f:Panel>

    <br />
    <f:Panel ID="Panel3" IsFluid="true" EnableCollapse="false" BodyPadding="10" Height="200" Layout="Fit"
        Title="面板三（Layout=Fit, Panel->PartialConnector->PartialView）">
        <Items>
            <f:PartialConnector Content="@(await Html.PartialAsync("PartialView", new ViewDataDictionary(ViewData) { { "PartialViewIndex", PartialViewIndex++ }, { "UserName", "陈萍萍" }, { "UserAge", 20 }, { "UserCountry", "合肥" } }))">
            </f:PartialConnector>
        </Items>
    </f:Panel>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>对照直接嵌入分部视图与通过连接器嵌入控件布局的方式。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照重复使用的内容</h3>
        <ul>
            <li>对照<strong class="example-control-reference" data-example-control="Panel1"
                    title="面板一（Panel-&gt;PartialView）">面板一（Panel-&gt;PartialView）</strong>与其它面板中的用户资料。<br />结果：相同资料在不同容器中各渲染一次；填充布局的面板让分部内容使用可用区域。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="Panel3"
                    title="面板三（Layout=Fit, Panel-&gt;PartialConnector-&gt;PartialView）">面板三（Layout=Fit,
                    Panel-&gt;PartialConnector-&gt;PartialView）</strong>）：初始为 <code>Fit</code>，规定容器内子控件的排列和空间分配方式。</li>
            <li><code>Partial / PartialConnector</code>（<strong class="example-control-reference" data-example-control="Panel1"
                    title="面板一（Panel-&gt;PartialView）">面板一（Panel-&gt;PartialView）</strong>）：调用方传入内容数据和独立控件标识，避免重复使用同一片段时覆盖其它实例。</li>
        </ul>
    </section>
}
