@page
@model FineUI.Core.Examples.Pages.Partial.LayoutModel
@{
    ViewBag.SourceFiles = "~/Pages/Partial/LayoutPartialView.cshtml";
    ViewBag.Title = "Partial/Layout";
    var F = Html.F();
}


@section body {

    @{
        var PartialViewIndex = 0;
    }

    <f:Panel ID="Panel1" IsFluid="true" EnableCollapse="false" Height="300" Layout="VBox" BoxConfigAlign="Stretch" BoxConfigPosition="Start" BodyPadding="10"
        BoxConfigSpace="5" Title="面板一">
        <Items>
            <f:PartialConnector Content="@(await Html.PartialAsync("LayoutPartialView", new ViewDataDictionary(ViewData) { { "PartialViewIndex", PartialViewIndex++ }, { "UserName", "陈萍萍" }, { "UserAge", 20 }, { "UserCountry", "合肥" } }))"></f:PartialConnector>
            <f:Panel BodyPadding="10" BoxFlex="1" Title="面板二">
                <Items>
                    <f:Label Text="胡斐今年22岁，住在驻马店。"></f:Label>
                </Items>
            </f:Panel>
        </Items>
    </f:Panel>
    <br>

    <f:Panel ID="Panel2" IsFluid="true" EnableCollapse="false" Height="300" Layout="VBox" BodyPadding="10" BoxConfigSpace="5" Title="面板三">
        <Items>
            <f:PartialConnector Content="@(await Html.PartialAsync("LayoutPartialView", new ViewDataDictionary(ViewData) { { "PartialViewIndex", PartialViewIndex++ }, { "UserName", "陈萍萍" }, { "UserAge", 20 }, { "UserCountry", "合肥" }, { "BoxFlex", 1 } }))"></f:PartialConnector>
            <f:PartialConnector Content="@(await Html.PartialAsync("LayoutPartialView", new ViewDataDictionary(ViewData) { { "PartialViewIndex", PartialViewIndex++ }, { "UserName", "胡斐" }, { "UserAge", 22 }, { "UserCountry", "驻马店" }, { "BoxFlex", 1 }, { "Margin", 0 } }))"></f:PartialConnector>
        </Items>
    </f:Panel>
    <br>

    <f:Panel ID="Panel4" IsFluid="true" EnableCollapse="false" Height="300" Layout="HBox" BodyPadding="10" BoxConfigSpace="5" Title="面板四">
        <Items>
            <f:PartialConnector Content="@(await Html.PartialAsync("LayoutPartialView", new ViewDataDictionary(ViewData) { { "PartialViewIndex", PartialViewIndex++ }, { "UserName", "陈萍萍" }, { "UserAge", 20 }, { "UserCountry", "合肥" }, { "BoxFlex", 1 } }))"></f:PartialConnector>
            <f:PartialConnector Content="@(await Html.PartialAsync("LayoutPartialView", new ViewDataDictionary(ViewData) { { "PartialViewIndex", PartialViewIndex++ }, { "UserName", "陈萍萍" }, { "UserAge", 20 }, { "UserCountry", "合肥" }, { "BoxFlex", 1 }, { "Margin", 0 } }))"></f:PartialConnector>
        </Items>
    </f:Panel>


}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>把可重复使用的分部视图放入纵向与横向布局，分别传入用户资料和空间比例。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照重复使用的内容</h3>
        <ul>
            <li>对照<strong class="example-control-reference" data-example-control="Panel1"
                    title="面板一">面板一</strong>与其它面板中的用户资料，再调整浏览器宽度。<br />结果：各用户资料使用各自数据，纵向和横向布局按所传比例分配空间。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="Panel1" title="面板一">面板一</strong>、<strong
                    class="example-control-reference" data-example-control="Panel2" title="面板三">面板三</strong>、<strong class="example-control-reference"
                    data-example-control="Panel4" title="面板四">面板四</strong>）：初始为 <code>VBox</code>、<code>HBox</code>，规定容器内子控件的排列和空间分配方式。</li>
            <li><code>Partial / PartialConnector</code>（<strong class="example-control-reference" data-example-control="Panel1"
                    title="面板一">面板一</strong>）：调用方传入内容数据和独立控件标识，避免重复使用同一片段时覆盖其它实例。</li>
        </ul>
    </section>
}
