@page
@model FineUI.Core.Examples.Pages.DataList.DataListDataBindModel
@{
    ViewBag.Title = "数据列表：数据绑定";
}

@section body {
    <f:Panel ID="Panel1" IsFluid="true" MaxWidth="700" Title="数据绑定与追加" ShowBorder="true" BodyPadding="10">
        <Items>
            <f:DataList ID="DataList1" DataTextField="Name" DataValueField="Id" />
        </Items>
    </f:Panel>
    <br />
    <f:Button ID="btnReload" Text="重新加载" OnClick="btnReload_Click" CssClass="marginr" />
    <f:Button ID="btnAppend" Text="追加两个城市" OnClick="btnAppend_Click" />
    <br />
    <br />
    <f:Label ID="labResult" Text="数据数量：3" />
    <f:HiddenField ID="hfBatch" Text="0" />
    <p>首次加载绑定北京、上海和广州；重新加载会反序显示这三个城市，并清除已追加的数据。</p>
    <p>每次追加深圳和杭州，项值带上批次编号，例如 shenzhen-1、shenzhen-2，连续追加也不会重复。</p>
}
