@page
@model FineUI.Core.Examples.Pages.DataList.DataListSelectionModel
@{
    ViewBag.Title = "数据列表：选择与清空";
}

@section body {
    <f:Panel ID="PanelDataListSingle" IsFluid="true" MaxWidth="700" Title="单选" ShowBorder="true" BodyPadding="10" MarginBottom="20">
        <Items>
            <f:DataList ID="DataListSingle" EnableSelect="true" SelectedValue="beijing">
                <Items>
                    <f:DataListItem Value="beijing" Text="北京" />
                    <f:DataListItem Value="shanghai" Text="上海" />
                    <f:DataListItem Value="guangzhou" Text="广州" />
                </Items>
            </f:DataList>
        </Items>
    </f:Panel>
    <f:Panel ID="PanelDataListMulti" IsFluid="true" MaxWidth="700" Title="多选" ShowBorder="true" BodyPadding="10" MarginBottom="20">
        <Items>
            <f:DataList ID="DataListMulti" EnableSelect="true" EnableMultiSelect="true" _SelectedValueArray="beijing,shanghai">
                <Items>
                    <f:DataListItem Value="beijing" Text="北京" />
                    <f:DataListItem Value="shanghai" Text="上海" />
                    <f:DataListItem Value="guangzhou" Text="广州" />
                </Items>
            </f:DataList>
        </Items>
    </f:Panel>
    <f:Panel ID="PanelDataListKeep" IsFluid="true" MaxWidth="700" Title="多选并保持当前选择" ShowBorder="true" BodyPadding="10" MarginBottom="20">
        <Items>
            <f:DataList ID="DataListKeep" EnableSelect="true" EnableMultiSelect="true" KeepCurrentSelection="true" _SelectedValueArray="beijing,shanghai">
                <Items>
                    <f:DataListItem Value="beijing" Text="北京" />
                    <f:DataListItem Value="shanghai" Text="上海" />
                    <f:DataListItem Value="guangzhou" Text="广州" />
                </Items>
            </f:DataList>
        </Items>
    </f:Panel>
    <f:Button ID="btnRead" Text="读取当前选择" OnClick="btnRead_Click" CssClass="marginr" />
    <f:Button ID="btnAssign" Text="后台设置选择" OnClick="btnAssign_Click" CssClass="marginr" />
    <f:Button ID="btnClear" Text="清空全部选择" OnClick="btnClear_Click" />
    <br />
    <br />
    <f:Label ID="labResult" Text="请点击列表项，再读取后台选择。" />


}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示数据列表的单选、多选和保留选择，并由后台统一读取、赋值或清空选择。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>比较三种选择规则</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="DataListSingle" title="第 1 个数据列表">第 1 个数据列表</strong>依次点击两个城市，再在其它两组列表连续点击城市。<br />结果：单选只保留一个项目；多选按点击及按键规则更新，保持选择的一组可连续累加。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnRead" title="读取当前选择">读取当前选择</strong>。<br />结果：读取各组当前项值，结果文字分别显示单选和多选集合。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnAssign" title="后台设置选择">后台设置选择</strong>。<br />结果：把本页指定城市设为当前选择，各列表按自身单选或多选规则显示。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnClear" title="清空全部选择">清空全部选择</strong>。<br />结果：三个列表的选择都清空，项目数据继续保留。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <ul>
        <li>保持当前选择时，直接点击会累积或取消该项。清空后再次读取，后台结果仍为空。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableSelect</code>（<strong class="example-control-reference" data-example-control="DataListSingle" title="第 1 个数据列表">第 1 个数据列表</strong>、<strong class="example-control-reference" data-example-control="DataListMulti" title="第 2 个数据列表">第 2 个数据列表</strong>、<strong class="example-control-reference" data-example-control="DataListKeep" title="第 3 个数据列表">第 3 个数据列表</strong>）：初始为<code>true</code>，开启列表项目选择。</li>
        <li><code>EnableMultiSelect</code>（<strong class="example-control-reference" data-example-control="DataListMulti" title="第 2 个数据列表">第 2 个数据列表</strong>、<strong class="example-control-reference" data-example-control="DataListKeep" title="第 3 个数据列表">第 3 个数据列表</strong>）：初始为<code>true</code>，为本页对应列表开启多选。</li>
        <li><code>KeepCurrentSelection</code>（<strong class="example-control-reference" data-example-control="DataListKeep" title="第 3 个数据列表">第 3 个数据列表</strong>）：初始为<code>true</code>，保持选择的一组开启此属性，连续点击不清除之前的项目。</li>
        <li><code>_SelectedValueArray</code>（<strong class="example-control-reference" data-example-control="DataListMulti" title="第 2 个数据列表">第 2 个数据列表</strong>、<strong class="example-control-reference" data-example-control="DataListKeep" title="第 3 个数据列表">第 3 个数据列表</strong>）：初始为<code>beijing,shanghai</code>，保存多选列表的稳定项值集合。</li>
    </ul>
</section>
}
