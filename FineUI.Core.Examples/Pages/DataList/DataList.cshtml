@page
@model FineUI.Core.Examples.Pages.DataList.DataListModel
@{
    ViewBag.Title = "数据列表：基础列表";
    var beijingText = "<img src=\"" + Url.Content("~/res/icon/building.png") + "\" alt=\"\" /> 北京";
}

@section body {
    <f:Panel ID="Panel1" IsFluid="true" MaxWidth="700" Title="基础列表" ShowBorder="true" BodyPadding="10">
        <Items>
            <f:DataList ID="DataList1">
                <Items>
                    <f:DataListItem Value="beijing" _TextRawHtml="@beijingText" />
                    <f:DataListItem Value="shanghai" Text="上海" />
                    <f:DataListItem Value="guangzhou" Text="广州" />
                    <f:DataListItem Value="hefei" Text="合肥" NavigateUrl="https://fineui.com/" Target="_blank" />
                </Items>
            </f:DataList>
        </Items>
    </f:Panel>
    <br />

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示在基础数据列表中组合普通文字、固定 HTML 图片内容和超链接项目。</p>
    <h3><i class="f-iconfont f-iconfont-list" aria-hidden="true"></i>阅读并打开链接项</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>对照北京、上海、广州和合肥项目，再点击<code>合肥</code>。<br />结果：北京项目包含图片，其它项目按各自内容显示；合肥按链接配置在新页面打开官网。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <ul>
        <li>列表项使用稳定的城市编号，文字、图片和普通超链接可放在同一个列表中。点击合肥，在新页面打开官网。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Items</code>（<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：按声明顺序显示当前列表项。</li>
        <li><code>Value</code>（<strong>列表项目</strong>，位于<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：使用城市编号作为稳定的非空项值。</li>
        <li><code>NavigateUrl</code>（<strong>列表项目</strong>，位于<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：本页合肥项配置了超链接，其它项不因此自动变为链接。</li>
    </ul>
</section>
}
