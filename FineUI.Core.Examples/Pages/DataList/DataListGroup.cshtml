@page
@model FineUI.Core.Examples.Pages.DataList.DataListGroupModel
@{
    ViewBag.Title = "数据列表：分组与模板";
}

@section body {
    <f:Panel ID="Panel1" IsFluid="true" MaxWidth="700" Title="分组与模板" ShowBorder="true" BodyPadding="10">
        <Items>
            <f:DataList ID="DataList1" EnableGroup="true" EnableSelect="true">
                <Items>
                    <f:DataListItem Value="beijing" Group="华北" _TextRawHtml="<strong>北京</strong><br />客户服务中心"
                        NavigateUrl="#details" ShowArrow="true" />
                    <f:DataListItem Value="tianjin" Group="华北" _TextRawHtml="<strong>天津</strong><br />物流服务中心"
                        NavigateUrl="#details" ShowArrow="true" />
                    <f:DataListItem Value="shanghai" Group="华东" _TextRawHtml="<strong>上海</strong><br />技术支持中心"
                        NavigateUrl="#details" ShowArrow="true" />
                    <f:DataListItem Value="hangzhou" Group="华东" _TextRawHtml="<strong>杭州</strong><br />产品体验中心"
                        NavigateUrl="#details" ShowArrow="true" />
                </Items>
                <Listeners>
                    <f:Listener Event="itemclick" Handler="onDataListItemClick" />
                </Listeners>
            </f:DataList>
        </Items>
    </f:Panel>
    <br />
    <f:Label ID="labResult" Text="请点击一个城市。" />


}

@section script {
    <script>
        function onDataListItemClick(event, itemValue) {
            event.preventDefault();
            F.ui.labResult.setValue('当前项：' + itemValue);
        }
    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示数据列表按区域分组，使用固定 HTML 模板展示标题和说明，并处理项目点击。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>从分组项目读取编号</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>点击<code>北京</code>，再点击<code>上海</code>。<br />结果：列表保留华北、华东分组，结果标签显示当前项目的稳定编号；本页阻止链接默认跳转，不切换移动面板。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <ul>
        <li>列表按区域分组，每项通过可信 HTML 模板展示标题和业务说明，并显示右侧箭头。</li>
        <li>点击项时直接显示对应编号，不切换移动面板。模板中的 HTML 由应用固定提供，外部输入应先进行编码。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableGroup</code>（<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：初始为<code>true</code>，开启列表分组。</li>
        <li><code>Group</code>（<strong>列表项目</strong>，位于<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：指定项目所属的区域分组。</li>
        <li><code>Text</code>（<strong>列表项目</strong>，位于<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：使用固定可信 HTML 提供标题和业务说明；外部输入应先编码。</li>
        <li><code>itemclick</code>（<strong class="example-control-reference" data-example-control="DataList1" title="数据列表">数据列表</strong>）：读取当前项值并更新结果，同时阻止默认导航。</li>
    </ul>
</section>
}
