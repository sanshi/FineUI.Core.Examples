@page
@model FineUI.Core.Examples.Pages.TabStrip.AddTabModel
@{
    ViewBag.Title = "TabStrip/AddTab";
    var F = Html.F();
}


@section body {

    <f:TabStrip ID="TabStrip1" IsFluid="true" Height="500" ShowBorder="true" ActiveTabIndex="0">
        <Tabs>
            <f:Tab Title="FineUI官网" EnableIFrame="true" IFrameUrl="https://fineui.com/">
            </f:Tab>
        </Tabs>
    </f:TabStrip>
    <br>

    <f:Button CssClass="marginr" ID="btnAddTab1" Text="DeepSeek官网（客户端代码）" ClickHandler="onAddTab1Click"></f:Button>

    <f:Button CssClass="marginr" ID="btnAddTab2" Text="ASP.NET官网（客户端代码）" ClickHandler="onAddTab2Click"></f:Button>

    <f:Button CssClass="marginr" ID="btnRemoveTab1" Text="删除DeepSeek官网（客户端代码）" ClickHandler="onRemoveTab1Click"></f:Button>

    <f:Button ID="btnRemoveTab2" Text="删除ASP.NET官网（客户端代码）" ClickHandler="onRemoveTab2Click"></f:Button>
    <br>
    <br>

    <f:Button CssClass="marginr" ID="btnAddTab3" Text="DeepSeek官网（服务端代码）" OnClick="btnAddTab3_Click"></f:Button>

    <f:Button CssClass="marginr" ID="btnAddTab4" Text="ASP.NET官网（服务端代码）" OnClick="btnAddTab4_Click"></f:Button>

    <f:Button CssClass="marginr" ID="btnRemoveTab3" Text="删除DeepSeek官网（服务端代码）" OnClick="btnRemoveTab3_Click"></f:Button>

    <f:Button ID="btnRemoveTab4" Text="删除ASP.NET官网（服务端代码）" OnClick="btnRemoveTab4_Click"></f:Button>
    <br>
    <br>


}


@section script {

    <script>

        function onAddTab1Click(event) {
            F.ui.TabStrip1.addTab({
                id: 'dynamic_tab1',
                iframe: true,
                iframeUrl: 'https://deepseek.com/',
                title: 'DeepSeek官网',
                closable: true,
                icon: '@Url.Content("~/res/icon/application.png")'
            });
        }

        function onAddTab2Click(event) {
            F.ui.TabStrip1.addTab({
                id: 'dynamic_tab2',
                iframe: true,
                iframeUrl: 'https://asp.net/',
                title: 'ASP.NET官网',
                closable: true,
                icon: '@Url.Content("~/res/icon/application_add.png")'
            });

        }

        function onRemoveTab1Click(event) {
            F.ui.TabStrip1.closeTab('dynamic_tab1');
        }

        function onRemoveTab2Click(event) {
            F.ui.TabStrip1.closeTab('dynamic_tab2');
        }

    </script>
}
@section exampleDescription {
<section aria-label="页面描述">
    <p>演示在浏览器或后台动态添加 <code>iframe</code> 标签，并删除指定标签。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>添加、关闭与重新添加</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="btnAddTab1" title="DeepSeek官网（客户端代码）">DeepSeek官网（客户端代码）</strong>。<br />结果：浏览器添加并激活对应 <code>iframe</code> 标签；外部网站是否允许嵌入由网站自身策略决定。</li>
        <li>在<strong class="example-control-reference" data-example-control="TabStrip1" title="选项卡">选项卡</strong>关闭刚添加的标签，再点击同一个新增按钮。<br />结果：按本页按钮逻辑重新显示或创建指定标签，不会影响其它已有标签。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnAddTab3" title="DeepSeek官网（服务端代码）">DeepSeek官网（服务端代码）</strong>。<br />结果：按钮回发，由后台生成并下发新标签配置，再激活对应页面。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>addTab()</code>（<strong class="example-control-reference" data-example-control="TabStrip1" title="选项卡">选项卡</strong>）：按指定 <code>ID</code>、标题及 <code>iframe</code> 地址添加标签。</li>
        <li><code>RemoveTab()</code>（<strong class="example-control-reference" data-example-control="TabStrip1" title="选项卡">选项卡</strong>）：按指定 <code>ID</code> 移除标签。</li>
    </ul>
</section>
}
