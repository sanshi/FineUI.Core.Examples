@page
@model FineUI.Core.Examples.Pages.TabStrip.FillModel
@{
    ViewBag.Title = "TabStrip/Fill";
    var F = Html.F();
}


@section body {

    <f:TabStrip ID="TabStrip1" IsFluid="true" Height="150" TabFill="true" ShowBorder="true" ActiveTabIndex="0">
        <Tabs>
            <f:Tab Title="标签一" BodyPadding="10">
                <Items>
                    <f:Label Text="第一个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab Title="标签二" BodyPadding="10">
                <Items>
                    <f:Label Text="第二个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab Title="标签三" EnableClose="true" BodyPadding="10">
                <Items>
                    <f:Label Text="第三个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab7" Title="标签四" EnableClose="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label7" Text="第四个标签的内容" />
                </Items>
            </f:Tab>
        </Tabs>
    </f:TabStrip>
    <br />
    <br />
    <f:TabStrip ID="TabStrip2" IsFluid="true" Height="150" TabFill="true" TabSpace="0" ShowBorder="true" ActiveTabIndex="1">
        <Tabs>
            <f:Tab ID="Tab1" Title="标签一" BodyPadding="10">
                <Items>
                    <f:Label ID="Label1" Text="第一个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab2" Title="标签二" BodyPadding="10">
                <Items>
                    <f:Label ID="Label2" Text="第二个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab3" Title="标签三" EnableClose="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label3" Text="第三个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab8" Title="标签四" EnableClose="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label8" Text="第四个标签的内容" />
                </Items>
            </f:Tab>
        </Tabs>
    </f:TabStrip>
    <br />
    <br />
    <f:TabStrip ID="TabStrip3" IsFluid="true" Height="150" TabFill="true" TabSpace="-1" ShowBorder="true" ActiveTabIndex="2">
        <Tabs>
            <f:Tab ID="Tab4" Title="标签一" BodyPadding="10">
                <Items>
                    <f:Label ID="Label4" Text="第一个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab5" Title="标签二" BodyPadding="10">
                <Items>
                    <f:Label ID="Label5" Text="第二个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab6" Title="标签三" EnableClose="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label6" Text="第三个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab9" Title="标签四" EnableClose="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label9" Text="第四个标签的内容" />
                </Items>
            </f:Tab>
        </Tabs>
    </f:TabStrip>
    <br>
    <br>
    <br>


}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示让标签平分标题栏，并对比不同标签间距。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对比平分宽度与标签间距</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="TabStrip1" title="第 1 个选项卡">第 1
                    个选项卡</strong>依次点击不同标签，对照本页其它组的同类标题。<br />结果：三组标签均平分各自标题栏；相邻标题的间距依次为 2、0、-1，最后一组的相邻边框重合。点击标签仍正常切换内容。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>TabFill</code>（<strong class="example-control-reference" data-example-control="TabStrip1" title="第 1 个选项卡">第 1 个选项卡</strong>、<strong
                    class="example-control-reference" data-example-control="TabStrip2" title="第 2 个选项卡">第 2 个选项卡</strong>、<strong
                    class="example-control-reference" data-example-control="TabStrip3" title="第 3 个选项卡">第 3 个选项卡</strong>）：初始为<code>true</code>，让各标题分配可用宽度。</li>
            <li><code>TabSpace</code>（<strong class="example-control-reference" data-example-control="TabStrip1" title="第 1 个选项卡">第 1 个选项卡</strong>、<strong
                    class="example-control-reference" data-example-control="TabStrip2" title="第 2 个选项卡">第 2 个选项卡</strong>、<strong
                    class="example-control-reference" data-example-control="TabStrip3" title="第 3 个选项卡">第 3 个选项卡</strong>）：第一组初始为 <code>2</code>，第二组为
                <code>0</code>，第三组为 <code>-1</code>；依次对照正常间距、零间距与相邻边框重合的效果。
            </li>
        </ul>
    </section>
}
