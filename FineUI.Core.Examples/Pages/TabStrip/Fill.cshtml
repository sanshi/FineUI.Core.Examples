@page
@model FineUI.Core.Examples.Pages.TabStrip.FillModel
@{
    ViewBag.Title = "TabStrip/Fill";
    var F = Html.F();
}


@section body {

    <f:TabStrip ID="TabStrip1" IsFluid="true" Height="150" TabFill="true" ShowBorder="true" ActiveTabIndex="0">
        <Tabs>
            <f:Tab Title="标签一" BodyPadding="10">
                <Items>
                    <f:Label Text="第一个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab Title="标签二" BodyPadding="10">
                <Items>
                    <f:Label Text="第二个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab Title="标签三" EnableClose="true" BodyPadding="10">
                <Items>
                    <f:Label Text="第三个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab7" Title="标签四" EnableClose="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label7" Text="第四个标签的内容" />
                </Items>
            </f:Tab>
        </Tabs>
    </f:TabStrip>
    <br />
    <br />
    <f:TabStrip ID="TabStrip2" IsFluid="true" Height="150" TabFill="true" TabSpace="0" ShowBorder="true" ActiveTabIndex="1">
        <Tabs>
            <f:Tab ID="Tab1" Title="标签一" BodyPadding="10">
                <Items>
                    <f:Label ID="Label1" Text="第一个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab2" Title="标签二" BodyPadding="10">
                <Items>
                    <f:Label ID="Label2" Text="第二个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab3" Title="标签三" EnableClose="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label3" Text="第三个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab8" Title="标签四" EnableClose="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label8" Text="第四个标签的内容" />
                </Items>
            </f:Tab>
        </Tabs>
    </f:TabStrip>
    <br />
    <br />
    <f:TabStrip ID="TabStrip3" IsFluid="true" Height="150" TabFill="true" TabSpace="-1" ShowBorder="true" ActiveTabIndex="2">
        <Tabs>
            <f:Tab ID="Tab4" Title="标签一" BodyPadding="10">
                <Items>
                    <f:Label ID="Label4" Text="第一个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab5" Title="标签二" BodyPadding="10">
                <Items>
                    <f:Label ID="Label5" Text="第二个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab6" Title="标签三" EnableClose="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label6" Text="第三个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab9" Title="标签四" EnableClose="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label9" Text="第四个标签的内容" />
                </Items>
            </f:Tab>
        </Tabs>
    </f:TabStrip>
    <br>
    注意三个选项卡控件的区别：
    <ul>
        <li>第一次选项卡：TabFill="true" TabSpace="2"（默认值）</li>
        <li>第二次选项卡：TabFill="true" TabSpace="0"</li>
        <li>第三次选项卡：TabFill="true" TabSpace="-1"（选项卡标题栏之间的间隔完全不见了）</li>
    </ul>
    <br>
    <br>


}

