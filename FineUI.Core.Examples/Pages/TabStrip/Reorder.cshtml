@page
@model FineUI.Core.Examples.Pages.TabStrip.ReorderModel
@{
    ViewBag.Title = "选项卡拖动排序与滚轮浏览";
}

@section body {
    <f:TabStrip ID="TabStrip1" Width="360" Height="160" EnableTabMove="true">
        <Tabs>
            <f:Tab ID="tabHome" Title="工作首页" BodyPadding="12">
                <Items>
                    <f:TextBox ID="tbxDraft" Label="工作草稿" />
                </Items>
            </f:Tab>
            <f:Tab ID="tabOrders" Title="销售订单" BodyPadding="12">
                <Items>
                    <f:Label Text="销售订单页面" />
                </Items>
            </f:Tab>
            <f:Tab ID="tabCustomers" Title="客户档案" BodyPadding="12">
                <Items>
                    <f:Label Text="客户档案页面" />
                </Items>
            </f:Tab>
            <f:Tab ID="tabShipments" Title="发货记录" BodyPadding="12">
                <Items>
                    <f:Label Text="发货记录页面" />
                </Items>
            </f:Tab>
            <f:Tab ID="tabInvoices" Title="发票管理" BodyPadding="12">
                <Items>
                    <f:Label Text="发票管理页面" />
                </Items>
            </f:Tab>
            <f:Tab ID="tabReturns" Title="售后退货" BodyPadding="12">
                <Items>
                    <f:Label Text="售后退货页面" />
                </Items>
            </f:Tab>
            <f:Tab ID="tabReports" Title="经营报表" BodyPadding="12">
                <Items>
                    <f:Label Text="经营报表页面" />
                </Items>
            </f:Tab>
            <f:Tab ID="tabSettings" Title="业务设置" BodyPadding="12">
                <Items>
                    <f:Label Text="业务设置页面" />
                </Items>
            </f:Tab>
        </Tabs>
    </f:TabStrip>
    <br />
    <f:Button ID="btnFirst" Text="打开排序后的第一项" CssClass="marginr" OnClick="OpenFirst" />
    <f:Button ID="btnHome" Text="回到工作首页" OnClick="OpenHome" />
    <br />
    <f:Label ID="labResult" />

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示拖动标签调整顺序、用滚轮浏览溢出的标题，并区分按位置和固定 <code>ID</code> 切页。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-sort" aria-hidden="true"></i>排序后继续操作</h3>
        <ol>
            <li>在<strong class="example-control-reference" data-example-control="TabStrip1"
                    title="选项卡">选项卡</strong>的<code>工作草稿</code>输入文字，再把<code>客户档案</code>标题拖到最前面。<br />结果：只调整标签顺序，原标签中的草稿内容继续保留。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnFirst"
                    title="打开排序后的第一项">打开排序后的第一项</strong>。<br />结果：后台按新顺序激活第一项，结果文字显示客户档案。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnHome" title="回到工作首页">回到工作首页</strong>。<br />结果：仍按固定页签 <code>ID</code>
                回到工作首页，不受拖动后的序号影响。</li>
            <li>把鼠标移到标题栏后滚动滚轮。<br />结果：标题超出宽度时可以沿标题栏浏览，内容区域不被替换。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <ul>
            <li>在首页填写草稿，将“客户档案”拖到“工作首页”前，再点击“打开排序后的第一项”。点击“回到工作首页”可继续编辑草稿。把鼠标放在标题上滚动可浏览后面的页签，点击标题才会切页。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableTabMove</code>（<strong class="example-control-reference" data-example-control="TabStrip1"
                    title="选项卡">选项卡</strong>）：初始为<code>true</code>，允许拖动标题改变标签顺序。</li>
            <li><code>Tabs</code>（<strong class="example-control-reference" data-example-control="TabStrip1" title="选项卡">选项卡</strong>）：后台读取的集合顺序与浏览器调整后的顺序一致。
            </li>
            <li><code>ActiveTab()</code>（<strong class="example-control-reference" data-example-control="TabStrip1"
                    title="选项卡">选项卡</strong>）：按固定页签标识激活目标页，与按索引激活区分。</li>
        </ul>
    </section>
}
