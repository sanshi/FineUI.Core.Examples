@page
@model FineUI.Core.Examples.Pages.TabStrip.NoTitleModel
@{
    ViewBag.Title = "TabStrip/NoTitle";
    var F = Html.F();
}


@section body {

    <f:TabStrip ID="TabStrip1" IsFluid="true" Height="150" ShowBorder="true" TabPosition="Top" ActiveTabIndex="0">
        <Tabs>
            <f:Tab IconFont="_Windows" TitleToolTip="标签一的提示文本" BodyPadding="10">
                <Items>
                    <f:Label Text="第一个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab Icon="Accept" TitleToolTip="标签二的提示文本" BodyPadding="10">
                <Items>
                    <f:Label Text="第二个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab IconFont="_Apple" TitleToolTip="标签三的提示文本" EnableClose="true" BodyPadding="10">
                <Items>
                    <f:Label Text="第三个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab Icon="Clock" TitleToolTip="标签四的提示文本" EnableClose="true" BodyPadding="10">
                <Items>
                    <f:Label Text="第四个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab IconFont="_Android" TitleToolTip="标签五的提示文本" EnableClose="true" BodyPadding="10">
                <Items>
                    <f:Label Text="第五个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab Icon="Computer" TitleToolTip="标签六的提示文本" EnableClose="true" BodyPadding="10">
                <Items>
                    <f:Label Text="第六个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab IconFont="_Google" TitleToolTip="标签七的提示文本" EnableClose="true" BodyPadding="10">
                <Items>
                    <f:Label Text="第七个标签的内容" />
                </Items>
            </f:Tab>
        </Tabs>
    </f:TabStrip>
    <br />
    <br />
    <f:TabStrip ID="TabStrip2" IsFluid="true" Height="150" ShowBorder="true" TabPosition="Bottom" ActiveTabIndex="3">
        <Tabs>
            <f:Tab ID="Tab1" IconFont="_Windows" TitleToolTip="标签一的提示文本" BodyPadding="10">
                <Items>
                    <f:Label ID="Label1" Text="第一个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab2" Icon="Accept" TitleToolTip="标签二的提示文本" BodyPadding="10">
                <Items>
                    <f:Label ID="Label2" Text="第二个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab3" IconFont="_Apple" TitleToolTip="标签三的提示文本" EnableClose="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label3" Text="第三个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab4" Icon="Clock" TitleToolTip="标签四的提示文本" EnableClose="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label4" Text="第四个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab5" IconFont="_Android" TitleToolTip="标签五的提示文本" EnableClose="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label5" Text="第五个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab6" Icon="Computer" TitleToolTip="标签六的提示文本" EnableClose="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label6" Text="第六个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab7" IconFont="_Google" TitleToolTip="标签七的提示文本" EnableClose="true" BodyPadding="10">
                <Items>
                    <f:Label ID="Label7" Text="第七个标签的内容" />
                </Items>
            </f:Tab>
        </Tabs>
    </f:TabStrip>

    <br>
    <br>
    注：
    <ul>
        <li>选项卡的标题栏文本为空</li>
        <li>选项卡标题栏有提示信息</li>
    </ul>
    <br>


}

