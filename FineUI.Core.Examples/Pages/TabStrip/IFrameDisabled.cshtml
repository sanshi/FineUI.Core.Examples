@page
@model FineUI.Core.Examples.Pages.TabStrip.IFrameDisabledModel
@{
    ViewBag.SourceFiles = "~/TabStrip/IFrameDisabledTab1";
    ViewBag.Title = "TabStrip/IFrameDisabled";
    var F = Html.F();
}


@section body {

    <f:TabStrip ID="TabStrip1" IsFluid="true" Height="500" ShowBorder="true" ActiveTabIndex="0">
        <Tabs>
            <f:Tab ID="Tab1" Title="标签一" EnableIFrame="true" IFrameUrl="@Url.Content("~/TabStrip/IFrameDisabledTab1")">
            </f:Tab>
            <f:Tab ID="Tab2" EnableIFrame="true" BodyPadding="10" Enabled="false" IFrameUrl="@Url.Content("~/Panel/Group")" Title="标签二">
            </f:Tab>
            <f:Tab ID="Tab3" EnableIFrame="true" BodyPadding="10" Enabled="false" IFrameUrl="@Url.Content("~/Panel/Panel")" Title="标签三">
            </f:Tab>
        </Tabs>
    </f:TabStrip>

}


@section script {

    <script>

        function enableTabs() {
            F.ui.Tab2.enable();
            F.ui.Tab3.enable();
        }

        function disableTabs() {
            F.ui.Tab2.disable();
            F.ui.Tab3.disable();
        }

    </script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>演示先禁用外部标签，再由 <code>iframe</code> 内的页面启用指定标签。</p>
    <h3><i class="f-iconfont f-iconfont-window" aria-hidden="true"></i>从子页面启用标签</h3>
    <ol>
        <li>初次打开时尝试点击<strong class="example-control-reference" data-example-control="TabStrip1" title="选项卡">选项卡</strong>中的第二、第三个标签。<br />结果：禁用标签不会被激活，当前页面继续保留。</li>
        <li>在第一个标签的 <code>iframe</code> 内点击启用目标标签的按钮，再点击对应标题。<br />结果：子页面通过父页面中的控件实例启用目标标签，随后可以正常切页。</li>
    </ol>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Enabled</code>（<strong class="example-control-reference" data-example-control="Tab2" title="标签二">标签二</strong>、<strong class="example-control-reference" data-example-control="Tab3" title="标签三">标签三</strong>）：第二、第三个标签初始为 <code>false</code>；由子页面更新后可用。 本页使用<code>false</code>。</li>
        <li><code>EnableIFrame</code>（<strong class="example-control-reference" data-example-control="Tab1" title="标签一">标签一</strong>、<strong class="example-control-reference" data-example-control="Tab2" title="标签二">标签二</strong>、<strong class="example-control-reference" data-example-control="Tab3" title="标签三">标签三</strong>）：在标签中加载用于操作父页面的子页面。 本页使用<code>true</code>。</li>
    </ul>
</section>
}
