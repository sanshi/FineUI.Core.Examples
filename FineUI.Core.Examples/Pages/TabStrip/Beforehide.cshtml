@page
@model FineUI.Core.Examples.Pages.TabStrip.BeforehideModel
@{
    ViewBag.Title = "TabStrip/Beforehide";
    var F = Html.F();
}


@section body {

    <f:TabStrip ID="TabStrip1" IsFluid="true" Height="500" EnableTabCloseMenu="true" ShowBorder="true" ActiveTabIndex="2">
        <Tabs>
            <f:Tab ID="Tab1" Title="标签一" EnableClose="false" BodyPadding="10">
                <Items>
                    <f:Label ID="Label5" Text="标签一中的文本" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab2" Title="标签二" BodyPadding="10" EnableClose="true">
                <Items>
                    <f:Label ID="Label4" Text="标签二中的文本" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab3" Title="标签三（关闭前弹出确认框）" BodyPadding="10" EnableClose="true">
                <Items>
                    <f:Label ID="Label3" Text="标签三中的文本" />
                </Items>
                <Listeners>
                    <f:Listener Event="beforehide" Handler="onTab3Beforehide" />
                </Listeners>
            </f:Tab>
        </Tabs>
    </f:TabStrip>

}



@section script {

    <script>

        function onTab3Beforehide(event) {
            if (!window.confirm('关闭标签三？')) {
                // 需要显式的返回 false，来阻止执行返回的脚本
                return false;
            }
        }

    </script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>演示关闭标签前显示原生确认框，取消时保留原标签。</p>
    <h3><i class="f-iconfont f-iconfont-check" aria-hidden="true"></i>确认后再关闭</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="TabStrip1" title="选项卡">选项卡</strong>点击<code>标签三</code>的关闭图标，先取消确认。<br />结果：标签三及它的内容仍然保留。</li>
        <li>再次关闭并选择确定。<br />结果：只有确认后才关闭标签；确认本身不清空其它标签的数据。</li>
    </ol>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>beforehide</code>（<strong class="example-control-reference" data-example-control="TabStrip1" title="选项卡">选项卡</strong>）：先阻止默认隐藏流程，根据确认结果决定是否继续关闭。</li>
        <li><code>confirm()</code>（<strong>关闭确认处理</strong>）：同步返回是否确认，取消则中止隐藏。</li>
    </ul>
</section>
}
