@page
@model FineUI.Core.Examples.Pages.TabStrip.BeforehideModel
@{
    ViewBag.Title = "TabStrip/Beforehide";
    var F = Html.F();
}


@section body {

    <f:TabStrip ID="TabStrip1" IsFluid="true" Height="500" EnableTabCloseMenu="true" ShowBorder="true" ActiveTabIndex="2">
        <Tabs>
            <f:Tab ID="Tab1" Title="标签一" EnableClose="false" BodyPadding="10">
                <Items>
                    <f:Label ID="Label5" Text="标签一中的文本" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab2" Title="标签二" BodyPadding="10" EnableClose="true">
                <Items>
                    <f:Label ID="Label4" Text="标签二中的文本" />
                </Items>
            </f:Tab>
            <f:Tab ID="Tab3" Title="标签三（关闭前弹出确认框）" BodyPadding="10" EnableClose="true">
                <Items>
                    <f:Label ID="Label3" Text="标签三中的文本" />
                </Items>
                <Listeners>
                    <f:Listener Event="beforehide" Handler="onTab3Beforehide" />
                </Listeners>
            </f:Tab>
        </Tabs>
    </f:TabStrip>

}



@section script {

    <script>

        function onTab3Beforehide(event) {
            if (!window.confirm('关闭标签三？')) {
                // 需要显式的返回 false，来阻止执行返回的脚本
                return false;
            }
        }

    </script>

}