@page
@model FineUI.Core.Examples.Pages.TabStrip.TabWidthModel
@{
    ViewBag.Title = "TabStrip/TabWidth";
    var F = Html.F();
}

@section head {

    <style>
        .f-tab-header.tab-maxwidth {
            max-width: 150px;
        }
    </style>

}

@section body {

    <f:TabStrip ID="TabStrip1" IsFluid="true" Height="350" ShowBorder="true" TabPosition="Top" EnableTabCloseMenu="false" ActiveTabIndex="1">
        <Tabs>
            <f:Tab ID="TabExample1" CssClass="tab-maxwidth" Title="标签一（这个标签的标题文字超长，真的很长很长很长很长很长很长很长，非常非常长，够长了吧）"
                   TitleToolTip="标签一（这个标签的标题文字超长，真的很长很长很长很长很长很长很长，非常非常长，够长了吧）" BodyPadding="10">
                <Items>
                    <f:Label ID="Label1" Text="第一个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab Title="标签二，这个标题也很长，但是没有截断" BodyPadding="10">
                <Items>
                    <f:Label ID="Label2" Text="第二个标签的内容" />
                </Items>
            </f:Tab>
            <f:Tab Title="标签三" BodyPadding="10">
                <Items>
                    <f:Label ID="Label3" Text="第三个标签的内容" />
                </Items>
            </f:Tab>
        </Tabs>
    </f:TabStrip>


}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示限制长标签标题的宽度，并用悬停提示查看完整标题。</p>
    <h3><i class="f-iconfont f-iconfont-layout" aria-hidden="true"></i>对比标题与当前项</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="TabStrip1" title="选项卡">选项卡</strong>依次点击不同标签，对照本页其它组的同类标题。<br />结果：内容区随当前标签切换；标题方向、对齐、背景、边框或墨水条按本页配置显示。</li>
        <li>将鼠标停在被截断的长标题上。<br />结果：标题宽度保持受限，提示中显示完整文字。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>CssClass</code>（<strong class="example-control-reference" data-example-control="TabExample1" title="标签一（这个标签的标题文字超长，真的很长很长很长很长很长很长很长，非常非常长，够长了吧）">标签一（这个标签的标题文字超长，真的很长很长很长很长很长很长很长，非常非常长，够长了吧）</strong>）：设为<code>tab-maxwidth</code>，本页标签设置 <code>tab</code>-<code>maxwidth</code> 样式；该样式把标题最大宽度限制为 <code>150px</code>。</li>
        <li><code>TitleToolTip</code>（<strong class="example-control-reference" data-example-control="TabExample1" title="标签一（这个标签的标题文字超长，真的很长很长很长很长很长很长很长，非常非常长，够长了吧）">标签一（这个标签的标题文字超长，真的很长很长很长很长很长很长很长，非常非常长，够长了吧）</strong>）：设为<code>标签一（这个标签的标题文字超长，真的很长很长很长很长很长很长很长，非常非常长，够长了吧）</code>，悬停时显示完整标题文字。</li>
    </ul>
</section>
}
