@page
@model FineUI.Core.Examples.Pages.TabStrip.TabStripModel
@{
    ViewBag.Title = "TabStrip/TabStrip";
    var F = Html.F();
}


@section body {

    <f:TabStrip ID="TabStrip1" IsFluid="true" Height="350" ShowBorder="true" TabPosition="Top" EnableTabCloseMenu="false" ActiveTabIndex="1">
        <Tabs>
            <f:Tab Title="标签一" BodyPadding="10" Layout="Fit">
                <Items>
                    <f:SimpleForm ID="SimpleForm1" ShowBorder="false" ShowHeader="false" Title="SimpleForm1" LabelWidth="120">
                        <Items>
                            <f:Label ID="Label1" Label="文本" Text="三生石上" CssClass="highlight" />
                            <f:NumberBox ID="NumberBox1" Label="数字输入框" Required="true" ShowRedStar="true" />
                            <f:TextBox ID="TextBox1" Label="文本输入框" Required="true" ShowRedStar="true">
                            </f:TextBox>
                            <f:DatePicker ID="DatePicker1" Label="日期选择器" Required="true" ShowRedStar="true">
                            </f:DatePicker>
                            <f:TextArea ID="TextArea2" Label="多行文本输入框" Required="true" Height="100" ShowRedStar="true" />
                        </Items>
                    </f:SimpleForm>
                </Items>
            </f:Tab>
            <f:Tab _TitleRawHtml="<span class='highlight'>标签二（高亮）</span>" BodyPadding="10">
                <Items>
                    <f:Button ID="Button1" Text="点击显示提示对话框" OnClick="Button1_Click"></f:Button>
                </Items>
            </f:Tab>
            <f:Tab Title="标签三" BodyPadding="10">
                <Items>
                    <f:Label ID="Label3" CssClass="highlight" Text="第三个标签的内容（已经应用了高亮样式）" />
                </Items>
            </f:Tab>
        </Tabs>
    </f:TabStrip>
    <br />

    <f:Button ID="Button2" CssClass="marginr" _ValidateForms="SimpleForm1" Text="验证第一个标签中的表单"></f:Button>
    
    <f:Button ID="Button3" Text="打开下一个标签" OnClick="Button3_Click"></f:Button>

}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示切换选项卡、显示各自内容，以及通过按钮切页和验证标签内的表单。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>切换内容</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="TabStrip1" title="选项卡">选项卡</strong>点击<code>标签一</code>和<code>标签二</code>。<br />结果：浏览器切换内容区，各标签中的控件和已输入内容分别保留。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button3" title="打开下一个标签">打开下一个标签</strong>。<br />结果：激活下一个可用标签，并显示它的内容。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>验证标签内表单</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="Button2" title="验证第一个标签中的表单">验证第一个标签中的表单</strong>。<br />结果：先检查第一个标签内的必填字段；未填完整时显示验证错误，通过后才执行本页配置的处理。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>ActiveTabIndex</code>（<strong class="example-control-reference" data-example-control="TabStrip1" title="选项卡">选项卡</strong>）：初始为<code>1</code>，指定首次激活的标签，索引从 <code>0</code> 开始。</li>
        <li><code>TabPosition</code>（<strong class="example-control-reference" data-example-control="TabStrip1" title="选项卡">选项卡</strong>）：初始为<code>Top</code>，指定标签标题栏所在边缘，本页位于顶部。</li>
    </ul>
</section>
}
