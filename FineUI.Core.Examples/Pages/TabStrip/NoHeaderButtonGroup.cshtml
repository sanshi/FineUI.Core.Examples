@page
@model FineUI.Core.Examples.Pages.TabStrip.NoHeaderButtonGroupModel
@{
    ViewBag.Title = "TabStrip/NoHeaderButtonGroup";
    var F = Html.F();
}

@section head {

    <style>
        .mybuttongroup .f-btn {
            border-width: 0;
            border-radius: 0;
            margin-bottom: 5px;
            padding-top: 10px;
            padding-bottom: 10px;
        }

        .mytabstrip {
            border-left-width: 1px;
        }
    </style>

}

@section body {

    <f:Panel ID="Panel1" ShowHeader="false" ShowBorder="true" IsFluid="true" Height="500" Layout="HBox">
        <Items>
            <f:ButtonGroup ID="ButtonGroup1" CssClass="mybuttongroup f-state-default" EnablePressGroup="true" Layout="VBox" Vertical="true" Width="200">
                <Items>
                    <f:Button ID="Button1" Text="标签一" Icon="Cake" EnablePress="true">
                    </f:Button>
                    <f:Button ID="Button2" Text="标签二" IconFont="_Bank" EnablePress="true" Pressed="true">
                    </f:Button>
                    <f:Button ID="Button3" Text="标签三" IconFont="_Group" EnablePress="true">
                    </f:Button>
                </Items>
                <Listeners>
                    <f:Listener Event="presschange" Handler="onButtonGroupPressChange" />
                </Listeners>
            </f:ButtonGroup>
            <f:TabStrip ID="TabStrip1" CssClass="mytabstrip" EnableTabCloseMenu="true" BoxFlex="1" ShowBorder="false" ShowTabHeader="false" ActiveTabIndex="1" AnimationType="Fade">
                <Tabs>
                    <f:Tab ID="Tab1" Title="标签一" EnableClose="false" BodyPadding="10px">
                        <Items>
                            <f:Label ID="Label5" Text="标签一中的文本" />
                        </Items>
                    </f:Tab>
                    <f:Tab ID="Tab2" Title="标签二" BodyPadding="10px" EnableClose="true">
                        <Items>
                            <f:Label ID="Label4" Text="标签二中的文本" />
                        </Items>
                    </f:Tab>
                    <f:Tab ID="Tab3" Title="标签三" BodyPadding="10px" EnableClose="true" Layout="VBox">
                        <Items>
                            <f:Label ID="Label3" Text="标签三中的文本" />
                            <f:TabStrip ID="TabStrip2" BoxFlex="1" EnableTabCloseMenu="true" ShowBorder="true" ActiveTabIndex="1">
                                <Tabs>
                                    <f:Tab ID="Tab4" Title="标签四" EnableClose="false" BodyPadding="10px">
                                        <Items>
                                            <f:Label ID="Label1" Text="标签四中的文本" />
                                        </Items>
                                    </f:Tab>
                                    <f:Tab ID="Tab5" Title="标签五" EnableClose="false" BodyPadding="10px">
                                        <Items>
                                            <f:Label ID="Label2" Text="标签五中的文本" />
                                        </Items>
                                    </f:Tab>
                                </Tabs>
                            </f:TabStrip>
                        </Items>
                    </f:Tab>
                </Tabs>
            </f:TabStrip>
        </Items>
    </f:Panel>


}


@section script {

    <script>

        function onButtonGroupPressChange(event, btn) {
            var btnIndex = btn.el.index('.f-btn');

            // 激活相应的选项卡
            F.ui.TabStrip1.getItem(btnIndex).activate();
        }


    </script>
}
@section exampleDescription {
<section aria-label="页面描述">
    <p>演示隐藏标签标题栏，用按钮组作为切页入口。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>使用本页切换入口</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="Button1" title="第 1 个按钮（标签一）">第 1 个按钮（标签一）</strong>。<br />结果：按按钮配置显示、激活或切换指定标签，标题栏的隐藏规则保持不变。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button2" title="第 2 个按钮（标签二）">第 2 个按钮（标签二）</strong>。<br />结果：按按钮配置显示、激活或切换指定标签，标题栏的隐藏规则保持不变。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button3" title="第 3 个按钮（标签三）">第 3 个按钮（标签三）</strong>。<br />结果：按按钮配置显示、激活或切换指定标签，标题栏的隐藏规则保持不变。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>ShowTabHeader</code>（<strong class="example-control-reference" data-example-control="TabStrip1" title="第 1 个选项卡">第 1 个选项卡</strong>）：初始为<code>false</code>，隐藏标题栏，内容由本页按钮切换。</li>
    </ul>
</section>
}
