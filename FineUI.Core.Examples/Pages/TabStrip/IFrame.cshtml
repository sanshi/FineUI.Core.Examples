@page
@model FineUI.Core.Examples.Pages.TabStrip.IFrameModel
@{
    ViewBag.Title = "TabStrip/IFrame";
    var F = Html.F();
}


@section body {

    <f:TabStrip ID="TabStrip1" IsFluid="true" Height="500" ShowBorder="true" ActiveTabIndex="1">
        <Tabs>
            <f:Tab ID="Tab1" BodyPadding="10" Title="标签一">
                <Items>
                    <f:Label ID="Label1" Text="文本">
                    </f:Label>
                    <f:Panel ID="ContentPanel1" BodyPadding="10" ShowBorder="true" ShowHeader="true" Title="内容面板" Content="这是内容面板中的内容。">
                    </f:Panel>
                </Items>
            </f:Tab>
            <f:Tab ID="Tab2" EnableIFrame="true" IFrameUrl="@Url.Content("~/Panel/Group")" Title="标签二（IFrame）">
                <Listeners>
                    <f:Listener Event="iframeload" Handler="onTab2IFrameLoad" />
                </Listeners>
                <Attributes>
                    <f:Attribute Key="data-source-key" Value="source1"></f:Attribute>
                </Attributes>
            </f:Tab>
            <f:Tab ID="Tab3" EnableIFrame="true" IFrameUrl="@Url.Content("~/Panel/Panel")" Title="标签三（IFrame）">
                <Listeners>
                    <f:Listener Event="iframeload" Handler="onTab3IFrameLoad" />
                </Listeners>
            </f:Tab>
        </Tabs>
    </f:TabStrip>
    <br>
    <br>
    <f:Button ID="Button1" Text="修改标签二的内联网址" CssClass="marginr" OnClick="Button1_Click">
    </f:Button>
    <br>
    <br>

    <br>


}

@section script {

    <script>

        function onTab2IFrameLoad(event) {
            F.notify('标签二中的IFrame加载完毕！');
        }

        function onTab3IFrameLoad(event) {
            F.notify('标签三中的IFrame加载完毕！');
        }

    </script>
}
@section exampleDescription {
<section aria-label="页面描述">
    <p>演示在标签内容中加载 <code>iframe</code>，并在需要显示时加载对应页面。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-window" aria-hidden="true"></i>切换 iframe 内容</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="TabStrip1" title="选项卡">选项卡</strong>切到<code>标签三</code>。<br />结果：该标签的 <code>iframe</code> 加载对应页面；加载完成后执行本页配置的加载事件。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button1" title="修改标签二的内联网址">修改标签二的内联网址</strong>。<br />结果：后台修改标签二的 <code>iframe</code> 地址，下次显示或重新加载时打开新地址。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <ul>
        <li>标签二 和 标签三 中的<code>IFrame</code>加载完毕时，会在右下角显示提示框。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableIFrame</code>（<strong class="example-control-reference" data-example-control="Tab2" title="标签二（IFrame）">标签二（IFrame）</strong>、<strong class="example-control-reference" data-example-control="Tab3" title="标签三（IFrame）">标签三（IFrame）</strong>）：初始为<code>true</code>，为指定标签使用 <code>iframe</code> 内容。</li>
        <li><code>IFrameUrl</code>（<strong class="example-control-reference" data-example-control="Tab2" title="标签二（IFrame）">标签二（IFrame）</strong>、<strong class="example-control-reference" data-example-control="Tab3" title="标签三（IFrame）">标签三（IFrame）</strong>）：指定各 <code>iframe</code> 标签的初始页面地址。</li>
        <li><code>iframeload</code>（<strong class="example-control-reference" data-example-control="TabStrip1" title="选项卡">选项卡</strong>）：目标页面加载完成后执行本页客户端提示。</li>
    </ul>
</section>
}
