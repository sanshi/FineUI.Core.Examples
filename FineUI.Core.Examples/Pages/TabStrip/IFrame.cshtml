@page
@model FineUI.Core.Examples.Pages.TabStrip.IFrameModel
@{
    ViewBag.Title = "TabStrip/IFrame";
    var F = Html.F();
}


@section body {

    <f:TabStrip ID="TabStrip1" IsFluid="true" Height="500" ShowBorder="true" ActiveTabIndex="1">
        <Tabs>
            <f:Tab ID="Tab1" BodyPadding="10" Title="标签一">
                <Items>
                    <f:Label ID="Label1" Text="文本">
                    </f:Label>
                    <f:Panel ID="ContentPanel1" BodyPadding="10" ShowBorder="true" ShowHeader="true" Title="内容面板" Content="这是内容面板中的内容。">
                    </f:Panel>
                </Items>
            </f:Tab>
            <f:Tab ID="Tab2" EnableIFrame="true" IFrameUrl="@Url.Content("~/Panel/Group")" Title="标签二（IFrame）">
                <Listeners>
                    <f:Listener Event="iframeload" Handler="onTab2IFrameLoad" />
                </Listeners>
                <Attributes>
                    <f:Attribute Key="data-source-key" Value="source1"></f:Attribute>
                </Attributes>
            </f:Tab>
            <f:Tab ID="Tab3" EnableIFrame="true" IFrameUrl="@Url.Content("~/Panel/Panel")" Title="标签三（IFrame）">
                <Listeners>
                    <f:Listener Event="iframeload" Handler="onTab3IFrameLoad" />
                </Listeners>
            </f:Tab>
        </Tabs>
    </f:TabStrip>
    <br>
    <br>
    <f:Button ID="Button1" Text="修改标签二的内联网址" CssClass="marginr" OnClick="Button1_Click">
    </f:Button>
    <br>
    <br>
        注：标签二 和 标签三 中的IFrame加载完毕时，会在右下角显示提示框。
    <br>


}

@section script {

    <script>

        function onTab2IFrameLoad(event) {
            F.notify('标签二中的IFrame加载完毕！');
        }

        function onTab3IFrameLoad(event) {
            F.notify('标签三中的IFrame加载完毕！');
        }

    </script>
}