@page
@model FineUI.Core.Examples.Pages.GridInput.SelectRowUpDownModel
@{
    ViewBag.Title = "GridInput/SelectRowUpDown";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" ArrowKeySelection="false">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
        </Columns>
    </f:Grid>
    <br>
    <br>


    <f:Button Text="获取用户输入的分组值" ID="Button1" ClickHandler="onGetInputsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderGroup(value, params) {
            return F.formatString('<input class="myinput" value="{0}" style="width:80px;" type="text">', value);
        }

        var inputselector = 'input.myinput';

        function getUserInputs() {
            var result = [];

            var grid1 = F.ui.Grid1;
            grid1.getRowEls().each(function () {
                var rowEl = $(this);
                var rowData = grid1.getRowData(rowEl);

                result.push([rowData.id, rowData.text, rowEl.find(inputselector).val()]);
            });

            return F.toJSON(result);
        }

        function onGetInputsClick(event) {
            F.customEvent('GetInputs', getUserInputs());
        }

        function registerEnterEvent() {
            var grid = F.ui.Grid1;

            grid.el.on('keydown', inputselector, function (event) {
                var cnode = $(this), rowEl = cnode.closest('.f-grid-row');

                // 如果是 ENTER键 或者 TAB键 或者 向下箭头
                if (event.keyCode === F.KEY.ENTER || event.keyCode === F.KEY.TAB || event.keyCode === F.KEY.DOWN) {
                    var nextRow = rowEl.next();
                    if (nextRow.length) {
                        // 选中文本框中的文本
                        nextRow.find(inputselector).select();
                        // 选中下一行
                        grid.selectRow(nextRow);
                    }

                    // 阻止默认行为
                    event.preventDefault();
                } else if (event.keyCode === F.KEY.UP) {
                    // 当前选中的行数组
                    var prevRow = rowEl.prev();
                    if (prevRow.length) {
                        // 选中文本框中的文本
                        prevRow.find(inputselector).select();
                        // 选中上一行
                        grid.selectRow(prevRow);
                    }

                    // 阻止默认行为
                    event.preventDefault();
                }
            });

            grid.el.on('click', inputselector, function (event) {
                $(this).select();
            });
        }

        F.ready(function () {
            registerEnterEvent();
        });


    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>用自定义上下键移动分组输入框，并同步选中对应行。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>按当前页面规则移动输入位置</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>靠前记录的<strong>分组</strong>输入框，按向下、向上方向键。<br />结果：目标输入框原文字被选中，表格行选择同时移动到该行，不把输入位置留在旧行。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>keydown / preventDefault</code>（<strong>行内输入与页面脚本</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：页面自行确定目标输入框并阻止相应按键的默认行为，不以浏览器默认 Tab 顺序代替本页导航。</li>
            <li><code>ArrowKeySelection</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>false</code>，关闭表格原有的方向键选行，交由本页输入框回调安排输入与行选择。
            </li>
            <li><code>selectRow</code>（<strong>行内输入与页面脚本</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：导航时选中目标行，使输入框所在行与表格选择一致。</li>
        </ul>
    </section>
}
