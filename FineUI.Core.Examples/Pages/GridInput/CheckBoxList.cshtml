@page
@model FineUI.Core.Examples.Pages.GridInput.CheckBoxListModel
@{
    ViewBag.Title = "GridInput/CheckBoxList";
    var F = Html.F();
}


@section head {

    <style>
        .myradiolist input {
            vertical-align: text-bottom;
        }

        .myradiolist label {
            margin-right: 3px;
        }
    </style>



}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="爱好" DataField="Hobby" RendererFunction="renderHobby" Width="300" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="获取用户输入的爱好" ID="Button1" ClickHandler="onGetInputsClick"></f:Button>


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderHobby(value, params) {
            var hobbies = value.split(',');
            var checkedHtml = ' checked="checked" ';
            var readingHtml = F.formatString('<label><input {0}value="reading" type="checkbox">读书</label>', $.inArray('reading', hobbies) >= 0 ? checkedHtml : '');
            var basketballHtml = F.formatString('<label><input {0}value="basketball" type="checkbox">篮球</label>', $.inArray('basketball', hobbies) >= 0 ? checkedHtml : '');
            var travelHtml = F.formatString('<label><input {0}value="travel" type="checkbox">旅游</label>', $.inArray('travel', hobbies) >= 0 ? checkedHtml : '');
            var movieHtml = F.formatString('<label><input {0}value="movie" type="checkbox">电影</label>', $.inArray('movie', hobbies) >= 0 ? checkedHtml : '');
            var musicHtml = F.formatString('<label><input {0}value="music" type="checkbox">音乐</label>', $.inArray('music', hobbies) >= 0 ? checkedHtml : '');
            return F.formatString('<div class="mycheckboxlist">{0}</div>', readingHtml + basketballHtml + travelHtml + movieHtml + musicHtml);
        }

        var inputselector = '.mycheckboxlist input[type=checkbox]';

        function getUserInputs() {
            var result = [];

            var grid1 = F.ui.Grid1;
            grid1.getRowEls().each(function () {
                var rowEl = $(this);
                var rowData = grid1.getRowData(rowEl);

                var checkedValues = [];
                rowEl.find(inputselector).filter(':checked').each(function () {
                    checkedValues.push($(this).val());
                });

                result.push([rowData.id, rowData.text, checkedValues]);
            });

            return F.toJSON(result);
        }

        function onGetInputsClick(event) {
            F.customEvent('GetInputs', getUserInputs());
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>在表格各行直接显示爱好多选项，提交时按行读取当前选择。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>修改行内选择并读取</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>首行切换<strong>爱好</strong>复选框，可同时保留多个选项。<br />结果：每行允许选择多个<strong>爱好</strong>，不影响其他行。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button1" title="获取用户输入的爱好">获取用户输入的爱好</strong>。<br />结果：客户端按行标识、<strong>姓名</strong>及当前输入收集数据并提交，后台显示各行读取结果；没有保存数据源的处理。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>RendererFunction</code>（<strong>行内输入与页面脚本</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：按每行数据生成常驻输入或选择元素，页面脚本从实际行元素读取用户输入。</li>
        <li><code>F.customEvent</code>（<strong>行内输入与页面脚本</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：将各行输入交给后台读取；输入不会因为仅修改 DOM 就自动写回源数据。</li>
    </ul>
</section>
}
