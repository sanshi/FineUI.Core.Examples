@page
@model FineUI.Core.Examples.Pages.GridInput.ArrowKeyModel
@{
    ViewBag.Title = "GridInput/ArrowKey";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataSource="@DataSourceUtil.GetDataTable()">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="语文" DataField="ChineseScore" RendererFunction="renderChineseScore" />
            <f:RenderField HeaderText="数学" DataField="MathScore" RendererFunction="renderMathScore" />
        </Columns>
    </f:Grid>
    <br>
    <br>
    注：
    <ul>
        <li>上下左右键遍历文本框</li>
    </ul>

    <f:Button Text="获取用户输入的分组值" ID="Button1" ClickHandler="onGetInputsClick"></f:Button>


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderChineseScore(value, params) {
            return F.formatString('<input class="myinput group1" value="{0}" style="width:80px;" type="text">', value);
        }

        function renderMathScore(value, params) {
            return F.formatString('<input class="myinput group2" value="{0}" style="width:80px;" type="text">', value);
        }

        var inputselector = 'input.myinput';

        function getUserInputs() {
            var result = [];

            var grid1 = F.ui.Grid1;
            grid1.getRowEls().each(function () {
                var rowEl = $(this);
                var rowData = grid1.getRowData(rowEl);

                var inputValues = [];
                rowEl.find(inputselector).each(function () {
                    inputValues.push($(this).val());
                });

                result.push([rowData.id, rowData.text, inputValues]);
            });

            return F.toJSON(result);
        }

        function onGetInputsClick(event) {
            F.customEvent('GetInputs', getUserInputs());
        }

        function registerEnterEvent() {
            var grid = F.ui.Grid1;

            grid.el.on('keydown', inputselector, function (event) {
                var inputEl = $(this);

                // 约定优于配置：group1, group2, group3
                var inputRegex = /group(\d+)/.exec(inputEl.attr('class'));
                if (!inputRegex || !inputRegex.length) {
                    return;
                }
                var inputCls = inputRegex[0];
                var inputNum = parseInt(inputRegex[1], 10);


                var row = $(this).closest('.f-grid-row');
                switch (event.keyCode) {
                    case F.KEY.UP:
                        var prevRow = row.prev();
                        if (prevRow.length) {
                            prevRow.find('.' + inputCls).select();
                        }
                        event.preventDefault();
                        break;
                    case F.KEY.DOWN:
                        var nextRow = row.next();
                        if (nextRow.length) {
                            nextRow.find('.' + inputCls).select();
                        }
                        event.preventDefault();
                        break;
                    case F.KEY.LEFT:
                        inputNum--;
                        if (inputNum >= 1) {
                            row.find('.group' + inputNum).select();
                        }
                        event.preventDefault();
                        break;
                    case F.KEY.RIGHT:
                        inputNum++;
                        if (inputNum <= 2) {
                            row.find('.group' + inputNum).select();
                        }
                        event.preventDefault();
                        break;
                }
                
            });

            grid.el.on('click', inputselector, function (event) {
                $(this).select();
            });
        }


        F.ready(function () {
            registerEnterEvent();
        });


    </script>
}
