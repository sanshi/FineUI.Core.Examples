@page
@model FineUI.Core.Examples.Pages.GridInput.RadioButtonListModel
@{
    ViewBag.Title = "GridInput/RadioButtonList";
    var F = Html.F();
}

@section head {

    <style>
        .myradiolist input {
            vertical-align: text-bottom;
        }

        .myradiolist label {
            margin-right: 3px;
        }
    </style>



}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
        </Columns>
    </f:Grid>
    <br>
    <br>

    <f:Button Text="获取用户输入的分组值" ID="Button1" ClickHandler="onGetInputsClick"></f:Button>


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderGender(value, params) {
            var radioName = 'radio_' + params.rowData.id;
            var checkedHtml = ' checked="checked" ';
            var manHtml = F.formatString('<label><input {0}name="{1}" value="男" type="radio">男</label>', value === 1 ? checkedHtml : '', radioName);
            var womanHtml = F.formatString('<label><input {0}name="{1}" value="女" type="radio">女</label>', value !== 1 ? checkedHtml : '', radioName);
            return F.formatString('<div class="myradiolist">{0}{1}</div>', manHtml, womanHtml);
        }

        var inputselector = '.myradiolist input[type=radio]';

        function getUserInputs() {
            var result = [];

            var grid1 = F.ui.Grid1;
            grid1.getRowEls().each(function () {
                var rowEl = $(this);
                var rowData = grid1.getRowData(rowEl);

                result.push([rowData.id, rowData.text, rowEl.find(inputselector).filter(':checked').val()]);
            });

            return F.toJSON(result);
        }

        function onGetInputsClick(event) {
            F.customEvent('GetInputs', getUserInputs());
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在表格各行直接显示性别单选项，提交时按行读取当前选择。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>修改行内选择并读取</h3>
        <ol>
            <li>在<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>首行把<strong>性别</strong>改为男。<br />结果：这一行显示新<strong>性别</strong>，同行选项保持单选，其他行的选择保留。</li>
            <li>点击<strong class="example-control-reference" data-example-control="Button1"
                    title="获取用户输入的分组值">获取用户输入的分组值</strong>。<br />结果：客户端按行标识、<strong>姓名</strong>及当前输入收集数据并提交，后台显示各行读取结果；没有保存数据源的处理。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>RendererFunction</code>（<strong>行内输入与页面脚本</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：按每行数据生成常驻输入或选择元素，页面脚本从实际行元素读取用户输入。</li>
            <li><code>F.customEvent</code>（<strong>行内输入与页面脚本</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：将各行输入交给后台读取；输入不会因为仅修改 DOM 就自动写回源数据。</li>
        </ul>
    </section>
}
