@page
@model FineUI.Core.Examples.Pages.GridInput.InputModel
@{
    ViewBag.Title = "GridInput/Input";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
        </Columns>
    </f:Grid>
    <br>
    <br>



    <f:Button Text="获取用户输入的分组值" ID="Button1" ClickHandler="onGetInputsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderGroup(value, params) {
            return F.formatString('<input class="myinput" value="{0}" style="width:80px;" type="text">', value);
        }

        var inputselector = 'input.myinput';

        function getUserInputs() {
            var result = [];

            var grid1 = F.ui.Grid1;
            grid1.getRowEls().each(function () {
                var rowEl = $(this);
                var rowData = grid1.getRowData(rowEl);

                result.push([rowData.id, rowData.text, rowEl.find(inputselector).val()]);
            });

            return F.toJSON(result);
        }

        function onGetInputsClick(event) {
            F.customEvent('GetInputs', getUserInputs());
        }

        function registerEnterEvent() {
            var grid = F.ui.Grid1;

            grid.el.on('keydown', inputselector, function (event) {
                if (event.keyCode === F.KEY.ENTER || event.keyCode === F.KEY.TAB) {
                    var nextRow = $(this).closest('.f-grid-row').next();
                    if (nextRow.length) {
                        nextRow.find(inputselector).select();
                    }

                    // 阻止 Enter 或者 Tab 的默认行为
                    event.preventDefault();
                }
            });

            grid.el.on('click', inputselector, function (event) {
                $(this).select();
            });
        }

        F.ready(function () {
            registerEnterEvent();
        });


    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>在表格分组列直接放置文本输入框，批量读取各行当前输入。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>输入多行分组值</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>前两行<strong>分组</strong>输入框分别填写<code>999</code>和<code>888</code>。<br />结果：每行保留自己的文字；这是常驻的行内输入，不必先进入单元格编辑。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button1" title="获取用户输入的分组值">获取用户输入的分组值</strong>。<br />结果：客户端按行标识、<strong>姓名</strong>及当前输入收集数据并提交，后台显示各行读取结果；没有保存数据源的处理。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>逐行移动输入框</h3>
    <ul>
        <li>点击一个<strong>分组</strong>输入框后按 Enter 或 Tab。<br />结果：输入位置移到下一行，原文字自动选中；基础页只移动输入框，不同步改变选中行。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>RendererFunction</code>（<strong>行内输入与页面脚本</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：按每行数据生成常驻输入或选择元素，页面脚本从实际行元素读取用户输入。</li>
        <li><code>F.customEvent</code>（<strong>行内输入与页面脚本</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：将各行输入交给后台读取；输入不会因为仅修改 DOM 就自动写回源数据。</li>
    </ul>
</section>
}
