@page
@model FineUI.Core.Examples.Pages.ThirdParty.AutoCompleteCustomDisplayModel
@{
    ViewBag.Title = "ThirdParty/AutoCompleteCustomDisplay";
    var F = Html.F();
}



@section head {

    <link rel="stylesheet" href="~/res/third-party/jqueryuiautocomplete/jquery-ui.css" />
}

@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" LabelWidth="60" BodyPadding="10" EnableCollapse="false" Title="简单表单">
        <Items>
            <f:TextBox ID="TextBox1" Label="标题" EmptyText="输入字母 j 试试">
            </f:TextBox>
            <f:TextBox ID="TextBox2" Label="值">
            </f:TextBox>
            <f:TextBox ID="TextBox3" Label="描述">
            </f:TextBox>
        </Items>
    </f:SimpleForm>
    <br>
    参考：http://jqueryui.com/autocomplete/#custom-data



}


@section script {

    <script src="~/res/third-party/jqueryuiautocomplete/jquery-ui.js" type="text/javascript"></script>
    <script>

        F.ready(function () {

            var projects = [
                {
                    value: "jquery",
                    label: "jQuery",
                    desc: "the write less, do more, JavaScript library"
                },
                {
                    value: "jquery-ui",
                    label: "jQuery UI",
                    desc: "the official user interface library for jQuery"
                },
                {
                    value: "sizzlejs",
                    label: "Sizzle JS",
                    desc: "a pure-JavaScript CSS selector engine"
                }
            ];

            $('#TextBox1 input').autocomplete({
                minLength: 0,
                source: projects,
                select: function (event, ui) {
                    var $this = $(this);
                    $this.val(ui.item.label);
                    $('#TextBox2 input').val(ui.item.value);
                    $('#TextBox3 input').val(ui.item.desc);
                    return false;
                }
            }).autocomplete('instance')._renderItem = function (ul, item) {
                return $("<li>").append("<a><span class='autocomplete-item-title'>" + item.label + "</span><br/>" + item.desc + "</a>").appendTo(ul);
            };

        });


    </script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>自定义自动补全候选项的多行显示，并把选中项的标题、值和描述分别回填。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>输入并选择候选项</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="TextBox1" title="标题">标题</strong>输入 <code>j</code> 并选择 jQuery。<br />结果：标题字段显示
                jQuery，值字段显示 jquery，描述字段显示该项目说明。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>autocomplete.source</code>（<strong class="example-control-reference" data-example-control="TextBox1"
                    title="标题">标题</strong>）：提供本页本地候选数据或筛选函数。</li>
            <li><code>select / _renderItem</code>（<strong class="example-control-reference" data-example-control="TextBox1"
                    title="标题">标题</strong>）：候选渲染负责多行外观，选择回调分别回填三个字段。</li>
        </ul>
    </section>
}
