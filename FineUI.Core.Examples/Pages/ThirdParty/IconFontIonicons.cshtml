@page
@model FineUI.Core.Examples.Pages.ThirdParty.IconFontIoniconsModel
@{
    ViewBag.Title = "ThirdParty/IconFontIonicons";
    var F = Html.F();
}


@section head {

    <link rel="stylesheet" href="~/res/third-party/ionicons/fonts.css" />
}

@section body {

    <f:Button ID="btnIcon1" Text="图标在左侧" IconFontClass="ion ion-md-pricetags" CssClass="marginr" />
    <f:Button ID="btnIcon2" Text="图标在右侧" IconAlign="Right" IconFontClass="ion ion-md-star" />
    <br />
    <br />
    <f:Button ID="btnIcon3" Text="图标在上面" IconAlign="Top" IconFontClass="ion ion-md-cart" CssClass="marginr" />
    <f:Button ID="btnIcon4" Text="图标在下面" IconAlign="Bottom" IconFontClass="ion ion-md-cloud" />
    <br />
    <br />
    只有图片的按钮：
    <br />
    <br />
    <f:Button ID="Button1" IconFontClass="ion ion-md-share" CssClass="marginr" />
    <f:Button ID="Button2" IconFontClass="ion ion-md-key" CssClass="marginr" />
    <f:Button ID="Button7" IconFontClass="ion ion-md-lock" CssClass="marginr" />
    <f:Button ID="Button8" IconFontClass="ion ion-md-trash" CssClass="marginr" />
    <br />
    <br />
    <f:Panel ID="Panel1" Width="500" Title="面板" Height="250" BodyPadding="10" EnableCollapse="true" IconFontClass="ion ion-md-list">
        <Items>
            <f:Label Text="面板内容"></f:Label>
        </Items>
        <Tools>
            <f:Tool IconFontClass="ion ion-md-cog" ToolTip="设置" ClickHandler="onToolIconClick"></f:Tool>
            <f:Tool IconFontClass="ion ion-md-cloud-download" ToolTip="下载" ClickHandler="onToolIconClick"></f:Tool>
        </Tools>
        <Toolbars>
            <f:Toolbar Position="Bottom" ToolbarAlign="Right">
                <Items>
                    <f:Button ID="btnMenu" Text="操作" IconFontClass="ion ion-md-create">
                        <Menu>
                            <f:MenuButton IconFontClass="ion ion-md-trash" Text="删除选中项">
                            </f:MenuButton>
                            <f:MenuButton IconFontClass="ion ion-md-hand" Text="禁用选中项">
                            </f:MenuButton>
                        </Menu>
                    </f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Panel>
    <br />
    <f:Tree ID="Tree1" Width="500" ShowHeader="true" Title="树控件" EnableCollapse="false">
        <Nodes>
            <f:TreeNode Text="中国" Expanded="true">
                <f:TreeNode Text="河南省" Expanded="true">
                    <f:TreeNode Text="驻马店市" Expanded="true" IconFontClass="ion ion-md-flag" NodeID="Zhumadian">
                        <f:TreeNode Text="遂平县" IconFontClass="ion ion-md-pricetag" NodeID="Suiping">
                        </f:TreeNode>
                        <f:TreeNode Text="西平县" IconFontClass="ion ion-md-book" NodeID="Xiping">
                        </f:TreeNode>
                    </f:TreeNode>
                    <f:TreeNode Text="漯河市" NodeID="Luohe" IconFontClass="ion ion-md-bookmark" />
                </f:TreeNode>
                <f:TreeNode Text="安徽省" NodeID="Anhui">
                </f:TreeNode>
            </f:TreeNode>
        </Nodes>
    </f:Tree>

    <br />
    <br />
    <a href="https://ionicons.com/" target="_blank">https://ionicons.com/</a>

}


@section script {

    <script>
        function onToolIconClick(event) {
            // 当前点击的图标字体
            var iconFontCls = this.iconFontCls;

            F.notify({
                message: '你点击了标题栏工具图标：' + iconFontCls,
                messageIconFontCls: iconFontCls,
                displayMilliseconds: 300000,
                positionX: 'center',
                positionY: 'center'
            });
        }
    </script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>接入 Ionicons 图标字体，在按钮、工具、菜单和树节点中使用同一图标库。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-pic" aria-hidden="true"></i>对照图标位置与来源</h3>
        <ul>
            <li>对照<strong class="example-control-reference" data-example-control="btnIcon1"
                    title="图标在左侧">图标在左侧</strong>等按钮中的图标方向，再打开操作菜单。<br />结果：按钮按左右上下配置排列图标；面板标题、工具和菜单复用本页图标库。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>IconFontClass</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>）：填写该字体库的 CSS
                类名，类名需与已经加载的样式一致。</li>
            <li><code>IconAlign</code>（<strong class="example-control-reference" data-example-control="btnIcon1" title="图标在左侧">图标在左侧</strong>）：为不同按钮指定
                Left、Right、Top、Bottom，对照图标与文字的相对位置。</li>
        </ul>
    </section>
}
