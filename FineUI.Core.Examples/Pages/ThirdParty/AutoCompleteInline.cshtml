@page
@model FineUI.Core.Examples.Pages.ThirdParty.AutoCompleteInlineModel
@{
    ViewBag.Title = "ThirdParty/AutoCompleteInline";
    var F = Html.F();
}


@section head {

    <link rel="stylesheet" href="~/res/third-party/jqueryuiautocomplete/jquery-ui.css" />
}

@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" Title="简单表单">
        <Items>
            <f:TextBox ID="TextBox1" ShowLabel="false" EmptyText="输入字母 a 试试">
            </f:TextBox>
        </Items>
    </f:SimpleForm>


}


@section script {

    <script src="~/res/third-party/jqueryuiautocomplete/jquery-ui.js" type="text/javascript"></script>
    <script>

        F.ready(function () {

            var availableTags = [
                "ActionScript",
                "AppleScript",
                "Asp",
                "BASIC",
                "C",
                "C++",
                "Clojure",
                "COBOL",
                "ColdFusion",
                "Erlang",
                "Fortran",
                "Groovy",
                "Haskell",
                "Java",
                "JavaScript",
                "Lisp",
                "Perl",
                "PHP",
                "Python",
                "Ruby",
                "Scala",
                "Scheme"];

            $('#TextBox1 input').autocomplete({
                source: availableTags
            });

        });

    </script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>把本地字符串数组接入 jQuery UI 自动补全，根据输入即时筛选候选。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>输入并选择候选项</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="TextBox1" title="输入字母 a 试试">输入字母 a 试试</strong>输入 <code>ja</code>，从候选项中选择 Java。<br />结果：输入框显示 Java，候选菜单关闭。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>autocomplete.source</code>（<strong class="example-control-reference" data-example-control="TextBox1" title="输入字母 a 试试">输入字母 a 试试</strong>）：提供本页本地候选数据或筛选函数。</li>
        <li><code>select</code>（<strong class="example-control-reference" data-example-control="TextBox1" title="输入字母 a 试试">输入字母 a 试试</strong>）：选择候选后把其显示值写回当前输入框。</li>
    </ul>
</section>
}
