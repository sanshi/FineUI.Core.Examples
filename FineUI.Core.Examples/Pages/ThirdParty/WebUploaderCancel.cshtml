@page
@model FineUI.Core.Examples.Pages.ThirdParty.WebUploaderCancelModel
@{
    ViewBag.SourceFiles = "~/ThirdParty/Upload;~/Home/Download";
    ViewBag.Title = "ThirdParty/WebUploaderCancel";
    var F = Html.F();
}


@section head {

    <style>
        .webuploader-element-invisible {
            position: absolute !important;
            clip: rect(1px,1px,1px,1px);
        }

        .webuploader-pick-disable {
            opacity: 0.6;
            pointer-events: none;
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowHeader="true" ShowBorder="true" Title="文件上传" Height="350"
            EnableCollapse="false" EnableCheckBoxSelect="false" EmptyText="尚未上传文件" DataIDField="id">
        <Toolbars>
            <f:Toolbar>
                <Items>
                    <f:Button ID="btnSelectFiles" Text="选择文件上传" IconFont="_Plus">
                    </f:Button>
                    <f:ToolbarSeparator></f:ToolbarSeparator>
                    <f:Button ID="btnDelete" Text="删除选中文件" IconFont="_Close" ClickHandler="onDeleteSelectedClick"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Columns>
            <f:RenderField ColumnID="FileName" DataField="name" HeaderText="文件名" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField ColumnID="FileType" DataField="type" HeaderText="类型" />
            <f:RenderField ColumnID="FileSize" DataField="size" HeaderText="大小" Renderer="FileSize" />
            <f:RenderField ColumnID='FileStatus' DataField="status" HeaderText="状态" RendererFunction="renderFileStatus" />
            <f:RenderField ColumnID="FileDelete" RendererFunction="renderDelete" />
        </Columns>
    </f:Grid>
    <br>
    <br>
    注：由于第三方组件WebUploader限制，本示例支持的浏览器版本为：Chrome、Firefox、Safari、IE10+ 。



}


@section script {

    <script src="~/res/third-party/webuploader/webuploader.nolog.js" type="text/javascript"></script>
    <script type="text/javascript">

        function renderFileStatus(value, params) {
            if (!value) {
                value = '已完成';
            }
            return value;
        }

        function renderDelete(value, params) {
            var deleteImageUrl = '@Url.Content("~/res/icon/delete.png")';
            if (value === 'cancel') {
                return '<a href="javascript:;" class="thecanceluploadbutton">取消上传</a>';
            } else {
                return '<a class="action-btn delete" href="javascript:;"><img class="f-grid-cell-icon" src="' + deleteImageUrl + '"></a>';
            }
        }

        function onDeleteSelectedClick(event) {
            var grid1 = F.ui.Grid1;

            if (!grid1.hasSelection()) {
                F.alert('请至少选择一项！');
                return;
            }

            var selectedRows = grid1.getSelectedRows();
            F.confirm({
                message: F.rawHtml('你确定要删除选中的&nbsp;<b>' + selectedRows.length + '</b>&nbsp;个文件吗？'),
                target: '_top',
                ok: function () {
                    // 触发后台事件
                    F.customEvent('DeleteRows', selectedRows);
                }
            });
        }

        F.ready(function () {
            var grid1 = F.ui.Grid1;

            grid1.el.on('click', 'a.action-btn.delete', function (event) {
                var cnode = $(this);

                F.confirm({
                    message: '你确定要删除这个文件吗？',
                    target: '_top',
                    ok: function () {
                        var rowData = grid1.getRowData(cnode.closest('.f-grid-row'));

                        // 触发后台事件
                        F.customEvent('DeleteRow', rowData.id);

                    }
                });
            });

            var uploader = WebUploader.create({

                // swf文件路径
                runtimeOrder: 'html5',

                // 文件接收服务端。
                server: '@Url.Page("/ThirdParty/Upload", "Process")',

                // 选择文件的按钮。可选。
                // 内部根据当前运行是创建，可能是input元素，也可能是flash.
                pick: '#btnSelectFiles',

                // 不压缩image, 默认如果是jpeg，文件上传前会压缩一把再上传！
                resize: false,

                // 自动上传
                auto: true,

                // 文件上传参数表，用来标记文件的所有者（如果是一篇文章的附件，就是文章的ID）
                formData: {
                    owner: 'webuploader.webuploader_cancel',
                    __RequestVerificationToken: $('[name=__RequestVerificationToken]').val()
                },

                // 单个文件大小限制（单位：byte）
                fileSingleSizeLimit: 100 * 1024 * 1024

            });

            // 当一批文件添加进队列以后触发
            uploader.on('filesQueued', function (files) {
                var records = [];
                $.each(files, function (index, file) {
                    records.push({
                        id: file.id,
                        values: {
                            'FileName': file.name,
                            'FileType': file.ext,
                            'FileSize': file.size,
                            'FileStatus': '等待上传',
                            'FileDelete': 'cancel'
                        }
                    });
                });
                grid1.addNewRecords(records, true);
            });


            uploader.on('uploadProgress', function (file, percentage) {
                var cellEl = grid1.getCellEl(file.id, 'FileStatus').find('.f-grid-cell-text');

                var barEl = cellEl.find('.f-progressbar-value');

                // 避免重复创建
                if (!barEl.length) {
                    cellEl.html('<div class="f-progressbar f-widget-content" style="height:12px;">' +
                      '<div class="f-progressbar-value f-widget-header" style="width:0%">' +
                      '</div></div>');
                    barEl = cellEl.find('.f-progressbar-value');
                }

                barEl.css('width', percentage * 100 + '%');
            });

            uploader.on('uploadSuccess', function (file) {
                var cellEl = grid1.getCellEl(file.id, 'FileStatus').find('.f-grid-cell-text');
                cellEl.text('上传成功');
            });

            uploader.on('uploadError', function (file) {
                var cellEl = grid1.getCellEl(file.id, 'FileStatus').find('.f-grid-cell-text');
                cellEl.text('上传出错');
            });

            // 不管上传成功还是失败，都会触发 uploadComplete 事件
            uploader.on('uploadComplete', function (file) {
                uploader.removeFile(file, true);

                // 上传结束，删除 [取消上传] 按钮
                var cellEl = grid1.getCellEl(file.id, 'FileDelete').find('.f-grid-cell-text');
                cellEl.text('');
            });


            // 当开始上传流程时触发
            uploader.on('startUpload', function () {
                // 禁用删除按钮
                F.ui.btnDelete.disable();
            });

            // 当所有文件上传结束时触发
            uploader.on('uploadFinished', function () {
                // 启用删除按钮
                F.ui.btnDelete.enable();

                // 回发页面，重新绑定表格数据
                F.customEvent('RebindGrid');
            });

            // 动态更新 formData 的值
            uploader.on('uploadBeforeSend', function (obj, data, headers) {
                data.param1 = new Date().getTime();
            });


            uploader.on('error', function (type, arg, file) {
                if (type === 'F_EXCEED_SIZE') {
                    F.alert('文件[' + file.name + ']大小超出限制值（' + F.format.fileSize(arg) + '）');
                } else if (type === 'Q_TYPE_DENIED') {
                    // 这个类型有两种成因：空文件、扩展名不在 accept 白名单里。
                    // 注意它派发时第二个参数就是 file 本身（不是大小上限），别照上面那条的签名去取。
                    F.alert(arg.size
                        ? '文件[' + arg.name + ']的类型不允许上传。'
                        : '文件[' + arg.name + ']是空文件，无法上传。');
                }
            });



            // 表格中的 取消上传 按钮
            grid1.el.on('click', 'a.thecanceluploadbutton', function (event) {
                var targetEl = $(this);
                var rowEl = targetEl.parents('.f-grid-row');
                var rowData = grid1.getRowData(rowEl);

                // 表格的 rowId 就是上传文件对象的id，取消上传并删除当前行
                uploader.cancelFile(rowData.id);
                grid1.deleteRow(rowData.id);
            });

        });
    </script>
}
