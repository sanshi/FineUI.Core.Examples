@page
@model FineUI.Core.Examples.Pages.CSP.LinkButtonModel
@{
    ViewBag.Title = "CSP/LinkButton";
    var F = Html.F();

    // 每轮从可信模板取得策略，第三方兼容页的放宽仅限本页。
    var pm = PageManager.Instance;
    pm.CspScripts = true;
    pm.CspScriptsAllowNonce = true;
}

@section body {


    @* 点击函数按名称从页面脚本中取得；回发命令是 JSON，链接无需内联事件属性。 *@

    <f:LinkButton ID="lbServer" Text="链接按钮 - 服务器端事件" OnClick="lbServer_Click" />
    <br />
    <br />
    <f:LinkButton ID="lbConfirm" Text="链接按钮 - 确认后回发" OnClick="lbConfirm_Click" ConfirmText="确定要继续吗？" />
    <br />
    <br />
    <f:LinkButton ID="lbClient" Text="链接按钮 - 客户端脚本" ClickHandler="onShowClientMsgClick" />
    <br />
    <br />
    <f:HyperLink ID="hlNav" Text="超链接 - 新窗口导航" NavigateUrl="https://www.fineui.com/" Target="_blank" />

}

@section script {

    <script type="text/javascript">

        function onShowClientMsgClick(event) {
            top.F.alert('链接控件客户端脚本已执行');
        }

    </script>

}
