@page
@model FineUI.Core.Examples.Pages.CSP.HtmlEditorModel
@{
    ViewBag.Title = "CSP/HtmlEditor";
    var F = Html.F();

    // 每轮从可信模板取得策略，第三方兼容页的放宽仅限本页。
    var pm = PageManager.Instance;
    pm.CspScripts = true;
    pm.CspScriptsAllowNonce = false;
    pm.CspScriptsAllowUnsafeInline = true;
    // UEditor 自身会动态编译脚本；本第三方兼容页单独放宽，不能将此设置推广到普通业务页。
    pm.CspScriptsAllowUnsafeEval = true;
}


@section body {


    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" LabelAlign="Top" Title="表单">
        <Items>
            <f:HtmlEditor Label="文本编辑器" ID="HtmlEditor1" Editor="UEditor" BasePath="~/res/third-party/ueditor/" Height="250">
            </f:HtmlEditor>
            <f:TextArea ID="TextArea1" Label="多行文本框" Height="150" Text="FineUI的使命是创建 No JavaScript，No CSS，No UpdatePanel，No ViewState 的网站应用程序">
            </f:TextArea>
            <f:Button ID="Button1" Text="获取 HTML 编辑器的内容" CssClass="marginr" OnClick="Button1_Click"></f:Button>
            <f:Button ID="Button2" Text="设置 HTML 编辑器的内容" OnClick="Button2_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    
    <br />
    <br />
    注：
    <ul>
        <li>第三方类库（UEditor）会使用内联脚本和动态编译脚本，本兼容页显式启用 CspScriptsAllowUnsafeInline 和 CspScriptsAllowUnsafeEval。</li>
        <li>一般情况下推荐启用CspScriptsAllowNonce属性，这样更加安全。</li>
        <li>文章：<a target="_blank" href="https://fineui.com/docs/#/Questions/5000_CSP_unsafe_inline">https://fineui.com/docs/#/Questions/5000_CSP_unsafe_inline</a></li>
    </ul>
    

}


@section script {

    <script type="text/javascript">

        console.log('Hello world!');

    </script>

}
