@page
@model FineUI.Core.Examples.Pages.IFrame.IFrameAutoHeightModel
@{
    ViewBag.Title = "IFrame/IFrameAutoHeight";
    var F = Html.F();
}


@section body {

    <f:Button ID="Button1" CssClass="marginr" AttributeDataTag="@Url.Content("~/Button/Button")" Text="按钮页面" ClickHandler="onButtonClick"></f:Button>
    <f:Button ID="Button2" CssClass="marginr" AttributeDataTag="@Url.Content("~/Button/ButtonGroup")" Text="分组按钮页面" ClickHandler="onButtonClick"></f:Button>
    <f:Button ID="Button6" CssClass="marginr" AttributeDataTag="@Url.Content("~/Button/ButtonGroupVertical")" Text="垂直分组按钮页面" ClickHandler="onButtonClick"></f:Button>
    <br />
    <br />
    <f:Panel ID="Panel1" IsFluid="true" ShowBorder="true" EnableIFrame="true" IFrameUrl="@Url.Content("~/Button/Button")" ShowHeader="true"
        Title="面板一（面板高度随IFrame的高度自适应）">
        <Listeners>
            <f:Listener Event="iframeload" Handler="onIFrameLoad" />
        </Listeners>
    </f:Panel>

    <br>
    <br>




}


@section script {

    <script>

        function onButtonClick(event) {
            var me = this;

            var panel1 = F.ui.Panel1;

            // 重置面板一的高度
            panel1.setHeight('auto');

            // 设置面板一的IFrameUrl
            panel1.setIFrameUrl(me.getAttr('data-tag'));
        }


        function onIFrameLoad(event) {
            var me = this;

            // 面板一的标题栏高度
            var panelHeaderHeight = me.el.outerHeight() - me.bodyEl.outerHeight();

            // IFrame页面的实际高度
            var iframeDoc = $(me.getIFrameWindow().document);
            var iframePageHeight = iframeDoc.height();

            // 如果页面控件高度自适应（IsViewPort=true）
            if (iframeDoc.find('body.f-viewport').length) {
                var panelBodyEl = iframeDoc.find('.f-panel-viewport .f-panel-body');
                iframePageHeight += panelBodyEl[0].scrollHeight - panelBodyEl.outerHeight();
            }

            // 设置面板一的新高度
            me.setHeight(iframePageHeight + panelHeaderHeight);
        }

    </script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示外层面板读取 <code>iframe</code> 内容高度，并在切换子页面后重新调整高度。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-window" aria-hidden="true"></i>切换不同高度的子页面</h3>
        <ol>
            <li>点击<strong class="example-control-reference" data-example-control="Button2" title="分组按钮页面">分组按钮页面</strong>。<br />结果：<code>iframe</code>
                切换到对应子页面，外层面板重新按本次内容计算高度。</li>
            <li>点击<strong class="example-control-reference" data-example-control="Button6"
                    title="垂直分组按钮页面">垂直分组按钮页面</strong>。<br />结果：更高的子页面使外层面板相应增高，不沿用上一页的旧高度。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <ul>
            <li>本示例不适合加载外部页面！

                由于存在<a href="https://en.wikipedia.org/wiki/Same_origin_policy">跨域限制（Same-origin
                    policy）</a>，在<code>IFrame</code>中加载外部页面时，无法访问到<code>IFrame</code>页面的<code>document</code>属性！</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableIFrame</code>（<strong class="example-control-reference" data-example-control="Panel1"
                    title="面板一（面板高度随IFrame的高度自适应）">面板一（面板高度随IFrame的高度自适应）</strong>）：初始为<code>true</code>，外层面板用 <code>iframe</code> 加载当前子页。</li>
            <li><code>iframeload</code>（<strong class="example-control-reference" data-example-control="Panel1"
                    title="面板一（面板高度随IFrame的高度自适应）">面板一（面板高度随IFrame的高度自适应）</strong>）：子页加载后执行本页高度同步逻辑。</li>
            <li><code>setHeight()</code>（<strong class="example-control-reference" data-example-control="Panel1"
                    title="面板一（面板高度随IFrame的高度自适应）">面板一（面板高度随IFrame的高度自适应）</strong>）：更新承载面板的高度，不重新创建子页内容。</li>
        </ul>
    </section>
}
