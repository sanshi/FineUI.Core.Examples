@page
@model FineUI.Core.Examples.Pages.IFrame.PassValue.IFrameWindowModel
@{
    ViewData["Title"] = "IFrameWindow";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" LabelAlign="Top" ShowBorder="false" ShowHeader="false" CssClass="f-widget-content" Title="SimpleForm" BodyPadding="10" EnableCollapse="false" AutoScroll="true" IsViewPort="true">
        <Items>
            <f:RadioButtonList ID="ddlSheng" Label="请选择省份" ColumnNumber="4" ShowRedStar="true" DataSource="@DataSourceUtil.SHENG_JSON" SelectedValue="@HttpContext.Request.Query["selected"]"
                               OnSelectedIndexChanged="ddlSheng_SelectedIndexChanged">
            </f:RadioButtonList>
        </Items>
    </f:SimpleForm>

}
