@page
@model FineUI.Core.Examples.Pages.IFrame.SelectProvinceModel
@{
    ViewBag.SourceFiles = "~/IFrame/SelectProvince/IFrameWindow";
    ViewBag.Title = "IFrame/SelectProvince";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" Title="表单" BodyPadding="10" EnableCollapse="false">
        <Items>
            <f:DropDownList Label="你所在的省份" ID="ddlProvince" DataSource="@DataSourceUtil.SHENG_JSON" SelectedValue="安徽">
            </f:DropDownList>
            <f:Button ID="Button1" Text="从列表中选择" ClickHandler="onButton1Click"></f:Button>
        </Items>
    </f:SimpleForm>

    <f:Window ID="Window1" Title="编辑" Hidden="true" EnableIFrame="true"
              EnableMaximize="true" EnableResize="true" Target="Parent" OnClose="Window1_Close"
              IsModal="true" Width="562" Height="470">
    </f:Window>


}

@section script {

    <script>

        function onButton1Click(event) {
            var url = '@Url.Content("~/IFrame/SelectProvince/IFrameWindow")';
            var openUrl = F.formatString("{0}?selected={1}", url, F.urlEncode(F.ui.ddlProvince.getValue()));

            F.ui.Window1.show(openUrl);
        }

        function updateProvince(val) {
            F.ui.ddlProvince.setValue(val);
        }

    </script>
}