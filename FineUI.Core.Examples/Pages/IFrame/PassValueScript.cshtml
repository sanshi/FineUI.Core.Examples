@page
@model FineUI.Core.Examples.Pages.IFrame.PassValueScriptModel
@{
    ViewBag.SourceFiles = "~/IFrame/PassValueScript/IFrameWindow";
    ViewBag.Title = "IFrame/PassValueScript";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" Title="表单" BodyPadding="10" EnableCollapse="false">
        <Items>
            <f:TextBox ID="tbxProvince" Label="你所在的省份" Text="安徽">
            </f:TextBox>
            <f:Button ID="Button1" Text="从列表中选择" ClickHandler="onButton1Click"></f:Button>
        </Items>
    </f:SimpleForm>

    <f:Window ID="Window1" Title="编辑" Hidden="true" EnableIFrame="true"
              EnableMaximize="true" EnableResize="true" Target="Parent" IsModal="true"
              Width="562" Height="470" OnClose="Window1_Close">
    </f:Window>



}

@section script {

    <script>

        function onButton1Click(event) {
            var url = '@Url.Content("~/IFrame/PassValueScript/IFrameWindow")';
            var openUrl = F.formatString("{0}?selected={1}", url, F.urlEncode(F.ui.tbxProvince.getValue()));

            F.ui.Window1.show(openUrl);
        }

        function updateProvince(val) {
            F.ui.tbxProvince.setValue(val);
        }

    </script>
}
@section exampleDescription {
<section aria-label="页面描述">
    <p>演示子页面直接通过 JavaScript 回填父页面字段，无需后台回发。</p>
    <h3><i class="f-iconfont f-iconfont-window" aria-hidden="true"></i>选择后回填父页面</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="Button1" title="从列表中选择">从列表中选择</strong>。<br />结果：打开本页配置的 <code>iframe</code> 选择窗体。</li>
        <li>在子页面选择北京并按该页面的确定入口提交。<br />结果：浏览器把父页面省份字段改为北京，并隐藏选择窗体；回填过程不需要保存数据库。</li>
    </ol>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableIFrame</code>（<strong class="example-control-reference" data-example-control="Window1" title="编辑">编辑</strong>）：在窗体内加载省份选择页。 本页使用<code>true</code>。</li>
        <li><code>Target</code>（<strong class="example-control-reference" data-example-control="Window1" title="编辑">编辑</strong>）：指定选择窗体在哪一层页面显示。 本页使用<code>Parent</code>。</li>
        <li><code>F.getActiveWindow()</code>（<strong>省份选择子页面</strong>）：子页面找到当前选择窗体及其调用页面，向本页目标字段回填选择。</li>
    </ul>
</section>
}
