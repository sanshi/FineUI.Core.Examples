@page
@model FineUI.Core.Examples.Pages.IFrame.IFrameCloseAll.IFrameWindow2Model
@{
    ViewData["Title"] = "IFrameWindow2";
    var F = Html.F();
}


@section body {

    <f:Panel ID="formPanel" ShowBorder="false" ShowHeader="false" CssClass="f-widget-content" Layout="Fit" IsViewPort="true">
        <Toolbars>
            <f:Toolbar>
                <Items>
                    <f:Button ID="btnClose" Text="全部关闭" ClickHandler="onCloseActiveWindowPostBackClick"></f:Button>
                    <f:Button ID="btnCloseServer" Text="全部关闭（后台注册脚本）" OnClick="btnCloseServer_Click"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:SimpleForm ID="SimpleForm1" ShowBorder="false" ShowHeader="false" AutoScroll="true" BodyPadding="10" EnableCollapse="false">
                <Items>
                    <f:Label ID="Label2" Label="文本" Text="三生石上" CssClass="highlight" />
                    <f:NumberBox ID="NumberBox1" Label="数字输入框" Required="true" ShowRedStar="true" />
                    <f:CheckBox ID="CheckBox1" Label="复选框">
                    </f:CheckBox>
                    <f:TextBox ID="TextBox1" Label="文本输入框" ShowRedStar="true" Required="true">
                    </f:TextBox>
                    <f:DatePicker ID="DatePicker1" Label="日期选择器" Text="2008-05-09">
                    </f:DatePicker>
                </Items>
            </f:SimpleForm>
        </Items>
    </f:Panel>


}

@section script {

    <script type="text/javascript">

        function onCloseActiveWindowPostBackClick(event) {
            F.activeWindow.hidePostBack();
        }

    </script>
}
