@page
@model FineUI.Core.Examples.Pages.IFrame.ButtonIFrameModel
@{
    ViewBag.SourceFiles = "~/Grid/IFrameWindow";
    ViewBag.Title = "IFrame/ButtonIFrame";
    var F = Html.F();
}


@section body {

    <f:Button ID="Button1" Text="在本页面弹出IFrame窗体" ClickHandler="onOpenWindow1Click"></f:Button>
    <br />
    <br />
    <f:Button ID="Button2" Text="在父页面弹出IFrame窗体" ClickHandler="onOpenWindow2Click"></f:Button>
    <br />
    <br />
    <f:Label ID="labResult" EncodeText="false" CssStyle="font-weight:bold;">
    </f:Label>
    <br />

    <br>
    <br>
    注：
    <ul>
        <li>
            点击窗体一的右上角关闭图标时，只是简单的隐藏窗体；
        </li>
        <li>
            点击窗体二的右上角关闭图标时，会触发 OnClose 事件（CloseAction=HidePostBack）。
        </li>
    </ul>

    <f:Window ID="Window1" IconUrl="@Url.Content("~/res/images/16/10.png")" Hidden="true"
              WindowPosition="Center" IsModal="true" Title="窗体一" EnableMaximize="true"
              EnableResize="true" Target="Self" EnableIFrame="true"
              Height="550" Width="850" OnClose="Window1_Close">
    </f:Window>
    <f:Window ID="Window2" IconUrl="@Url.Content("~/res/images/16/11.png")" Hidden="true"
              IsModal="true" Target="Parent" EnableMaximize="true" EnableResize="true" OnClose="Window2_Close"
              Title="窗体二" CloseAction="HidePostBack"
              EnableIFrame="true" Height="550" Width="850">
    </f:Window>


}

@section script {

    <script type="text/javascript">

        function onOpenWindow1Click(event) {
            F.ui.Window1.show('@Url.Content("~/Grid/IFrameWindow")', '弹出窗口一');
        }

        function onOpenWindow2Click(event) {
            F.ui.Window2.show('@Url.Content("~/Grid/IFrameWindow")', '弹出窗口二');
        }

    </script>
}
