@page
@model FineUI.Core.Examples.Pages.IFrame.IFrameIFrameModel
@{
    ViewBag.SourceFiles = "~/IFrame/IFrameIFrame/IFrameWindow;~/IFrame/IFrameIFrame/IFrameWindow2";
    ViewBag.Title = "IFrame/IFrameIFrame";
    var F = Html.F();
}


@section body {

    <f:Button ID="Button1" Text="在本页面弹出窗体" ClickHandler="onOpenWindow1Click"></f:Button>
    <f:Window ID="Window1" Hidden="true" EnableIFrame="true" IFrameUrl="@Url.Content("~/IFrame/IFrameIFrame/IFrameWindow")"
              EnableMaximize="true" EnableResize="true" Height="500" Width="900" Title="窗体一" OnClose="Window1_Close">
    </f:Window>
    <br />
    <f:Button ID="Button2" Text="在父页面弹出窗体" ClickHandler="onOpenWindow2Click"></f:Button>
    <f:Window ID="Window2" Hidden="true" EnableIFrame="true" EnableMaximize="true" IFrameUrl="@Url.Content("~/IFrame/IFrameIFrame/IFrameWindow")"
              EnableResize="true" Target="Parent" Height="500" Width="900" Title="窗体二" OnClose="Window2_Close">
    </f:Window>
    <br />
    <br />
    <f:Label ID="labResult" EncodeText="false" CssStyle="font-weight:bold;" Text="@("页面加载时间：" + DateTime.Now.ToLongTimeString())">
    </f:Label>


}

@section script {

    <script type="text/javascript">

        function onOpenWindow1Click(event) {
            F.ui.Window1.show();
        }

        function onOpenWindow2Click(event) {
            F.ui.Window2.show();
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示在 <code>iframe</code> 窗体内再打开子窗体，并沿正确层级处理关闭通知。</p>
    <h3><i class="f-iconfont f-iconfont-window" aria-hidden="true"></i>逐层打开并关闭窗体</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="Button1" title="在本页面弹出窗体">在本页面弹出窗体</strong>。<br />结果：先打开包含子页面的第一层窗体。</li>
        <li>在子页面继续打开内层 <code>iframe</code> 窗体。<br />结果：第二层窗体在本页指定的承载位置显示，原有外层页面继续保留。</li>
        <li>点击内层窗体中用于关闭并通知父页面的入口。<br />结果：对应窗体按本页调用顺序关闭，最外层结果标签显示关闭信息或时间。</li>
    </ol>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Target</code>（<strong class="example-control-reference" data-example-control="Window2" title="窗体二">窗体二</strong>）：分别控制每一层窗体的显示位置。 本页使用<code>Parent</code>。</li>
        <li><code>EnableIFrame</code>（<strong class="example-control-reference" data-example-control="Window1" title="窗体一">窗体一</strong>、<strong class="example-control-reference" data-example-control="Window2" title="窗体二">窗体二</strong>）：各层使用独立子页面。 本页使用<code>true</code>。</li>
        <li><code>F.getActiveWindow()</code>（<strong>嵌套子页面</strong>）：从子页面取得对应活动窗体，避免关闭错误的父层。</li>
    </ul>
</section>
}
