@page
@model FineUI.Core.Examples.Pages.IFrame.IFrameCloseAllModel
@{
    ViewBag.SourceFiles = "~/IFrame/IFrameCloseAll/IFrameWindow;~/IFrame/IFrameCloseAll/IFrameWindow2";
    ViewBag.Title = "IFrame/IFrameIFrame";
    var F = Html.F();
}


@section body {

    <f:Button ID="Button1" Text="在本页面弹出窗体" ClickHandler="onOpenWindow1Click"></f:Button>
    <f:Window ID="Window1" Hidden="true" EnableIFrame="true" IFrameUrl="@Url.Content("~/IFrame/IFrameCloseAll/IFrameWindow")"
              EnableMaximize="true" EnableResize="true" Height="500" Width="900" Title="窗体一" OnClose="Window1_Close">
    </f:Window>
    <br />
    <f:Button ID="Button2" Text="在父页面弹出窗体" ClickHandler="onOpenWindow2Click"></f:Button>
    <f:Window ID="Window2" Hidden="true" EnableIFrame="true" EnableMaximize="true" IFrameUrl="@Url.Content("~/IFrame/IFrameCloseAll/IFrameWindow")"
              EnableResize="true" Target="Parent" Height="500" Width="900" Title="窗体二" OnClose="Window2_Close">
    </f:Window>
    <br />
    <br />
    <f:Label ID="labResult" EncodeText="false" CssStyle="font-weight:bold;" Text="@("页面加载时间：" + DateTime.Now.ToLongTimeString())">
    </f:Label>

}

@section script {

    <script type="text/javascript">

        function onOpenWindow1Click(event) {
            F.ui.Window1.show();
        }

        function onOpenWindow2Click(event) {
            F.ui.Window2.show();
        }

    </script>
}
