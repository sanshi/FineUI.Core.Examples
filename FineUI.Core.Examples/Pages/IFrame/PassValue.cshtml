@page
@model FineUI.Core.Examples.Pages.IFrame.PassValueModel
@{
    ViewBag.SourceFiles = "~/IFrame/PassValue/IFrameWindow";
    ViewBag.Title = "IFrame/PassValue";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" Title="表单" BodyPadding="10" EnableCollapse="false">
        <Items>
            <f:TextBox Label="你所在的省份" ID="tbxProvince" Text="安徽">
            </f:TextBox>
            <f:Button ID="Button1" OnClick="Button1_Click" Text="从列表中选择"></f:Button>
        </Items>
    </f:SimpleForm>

    <f:Window ID="Window1" Title="编辑" Hidden="true" EnableIFrame="true"
              EnableMaximize="true" EnableResize="true" Target="Parent"
              IsModal="true" Width="550" Height="350">
    </f:Window>

}

@section script {

    <script>
        function showProvinceWindow(url) {
            // 先登记回写目标再打开窗体，子页选省份后会把值写回 tbxProvince。
            F.ui.Window1.setSaveStateControlIds(['tbxProvince']);
            F.ui.Window1.show(url);
        }
    </script>

}
