@page
@model FineUI.Core.Examples.Pages.IFrame.PassValueScript.IFrameWindowModel
@{
    ViewData["Title"] = "IFrameWindow";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" LabelAlign="Top" ShowBorder="false" ShowHeader="false" CssClass="f-widget-content" Title="SimpleForm" BodyPadding="10" EnableCollapse="false" AutoScroll="true" IsViewPort="true">
        <Items>
            <f:RadioButtonList ID="ddlSheng" Label="请选择省份" ColumnNumber="4" ShowRedStar="true" DataSource="@DataSourceUtil.SHENG_JSON" SelectedValue="@HttpContext.Request.Query["selected"]">
                <Listeners>
                    <f:Listener Event="change" Handler="onDdlShengChange"></f:Listener>
                </Listeners>
            </f:RadioButtonList>
        </Items>
    </f:SimpleForm>

}

@section script {

    <script>

        function onDdlShengChange(event) {
            // 返回当前活动Window对象（浏览器窗口对象通过F.getActiveWindow().window获取）
            var activeWindow = F.getActiveWindow();
            activeWindow.window.updateProvince(this.getValue());
            activeWindow.hide();
        }

    </script>
}
