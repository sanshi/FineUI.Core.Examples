@page
@model FineUI.Core.Examples.Pages.IFrame.ParentWindowCloseModel
@{
    ViewBag.SourceFiles = "~/IFrame/ParentWindowClose/IFrameWindow1;~/IFrame/ParentWindowClose/IFrameWindow2";
    ViewBag.Title = "IFrame/ParentWindowClose";
    var F = Html.F();
}


@section body {

    页面一：IFrame/ParentWindowClose/Index
    <br>

    <f:Label ID="labResult" EncodeText="false" Text="@DateTime.Now.ToLongTimeString()">
    </f:Label>
    <br />
    <f:Button CssClass="marginr" ID="btnServerRefresh" Text="服务端刷新面板 IFrame" OnClick="btnServerRefresh_Click"></f:Button>
    <f:Button ID="Button2" Text="刷新面板一中的IFrame" ClickHandler="onRefreshIFrameClick"></f:Button>
    <br />
    <br />
    <f:Panel ID="Panel1" IsFluid="true" ShowBorder="true" EnableCollapse="false"
             Height="500" EnableIFrame="true" IFrameUrl="@Url.Content("~/IFrame/ParentWindowClose/IFrameWindow1")"
             ShowHeader="true" Title="面板一">
    </f:Panel>


}


@section script {

    <script>

        function updateLabelResult() {

            F.ui.labResult.setValue(F.formatDate('HH:mm:ss', new Date));

        }

        function onRefreshIFrameClick(event) {
            F.ui.Panel1.refreshIFrame();
        }

    </script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示孙页面关闭父窗体，并把关闭通知传回更外层页面。</p>
    <h3><i class="f-iconfont f-iconfont-window" aria-hidden="true"></i>沿父级传递关闭通知</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Panel1" title="面板一">面板一</strong>的子页面中打开窗体，再点击其中的关闭父窗体入口。<br />结果：关闭动作沿本页配置的父级传递，最外层结果标签更新；不能把当前 <code>iframe</code> 的 <code>parent</code> 一概当成最终业务页面。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableIFrame</code>（<strong class="example-control-reference" data-example-control="Panel1" title="面板一">面板一</strong>）：面板中加载会继续打开窗体的子页面。 本页使用<code>true</code>。</li>
        <li><code>F.getActiveWindow()</code>（<strong>子页面关闭处理</strong>）：在子页面确定实际活动窗体及其所属层级。</li>
    </ul>
</section>
}
