@page
@model FineUI.Core.Examples.Pages.GridTree.GridTreeRowExpanderModel
@{
    ViewBag.Title = "GridTree/GridTreeRowExpander";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="树表格" DataIDField="Id" DataTextField="Name" EnableTree="true" TreeColumn="Name" DataParentIDField="ParentId">
        <Columns>
            <f:RowNumberField />
            <f:RenderField ColumnID="Name" HeaderText="名称" DataField="Name" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="类型" DataField="Type" Width="150" />
            <f:RenderField HeaderText="大小" DataField="Size" Width="150" />
            <f:RenderField HeaderText="修改日期" DataField="ModifyDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" Width="150" />
            <f:RenderField RenderAsRowExpander="true" RendererFunction="renderExpander"></f:RenderField>
        </Columns>
    </f:Grid>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <br />

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderExpander(value, params) {
            var rowData = params.rowData;
            return $('<div>').addClass('expander')
                .append($('<p>').html(`<strong>名称：</strong>${rowData.values['Name']}（${rowData.values['Type']}）`))
                .append($('<p>').html(`<strong>日期：</strong>${rowData.values['ModifyDate']}`));
        }

    </script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>在树节点行之外显示独立的行详情，区分目录展开与明细展开两个入口。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>分别展开后代与当前行明细</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong><strong>名称</strong>旁的树展开箭头，再点击行扩展列的图标。<br />结果：树箭头显示或隐藏后代行；行扩展图标只在当前行下显示附加资料，两种展开互不代替。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <p>注：行扩展列和树表格同时存在时，需要禁用行扩展列的ExpandOnDblClick属性，以避免与树表格的双击展开节点功能冲突。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>RowExpanderField / TreeColumn</code>（<strong>行扩展列与名称树列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>）：树列管理父子节点，行扩展列承载这一行的额外展示内容。</li>
    </ul>
</section>
}
