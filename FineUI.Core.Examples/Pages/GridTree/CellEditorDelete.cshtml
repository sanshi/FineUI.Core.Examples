@page
@model FineUI.Core.Examples.Pages.GridTree.CellEditorDeleteModel
@{
    ViewBag.Title = "GridTree/CellEditorDelete";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="树表格" DataIDField="Id" DataTextField="Name"
            EnableTree="true" TreeColumn="Name" DataParentIDField="ParentId" RowDataBoundFunction="onGrid1RowDataBound"
            AllowCellEditing="true" ClicksToEdit="1">
        <Columns>
            <f:RowNumberField />
            <f:RenderField ColumnID="Name" HeaderText="姓名" DataField="Name" ExpandUnusedSpace="true" MinWidth="150">
                <Editor>
                    <f:TextBox ID="tbxName" Required="true">
                    </f:TextBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="类型" ColumnID="Type" DataField="Type" RendererFunction="renderType">
                <Editor>
                    <f:DropDownList ID="ddlType" Required="true">
                        <f:ListItem Text="文件夹" Value="文件夹"></f:ListItem>
                        <f:ListItem Text="CS文件" Value="CS文件"></f:ListItem>
                        <f:ListItem Text="CONFIG文件" Value="CONFIG文件"></f:ListItem>
                        <f:ListItem Text="ASPX文件" Value="ASPX文件"></f:ListItem>
                        <f:ListItem Text="CSS文件" Value="CSS文件"></f:ListItem>
                        <f:ListItem Text="PNG文件" Value="PNG文件"></f:ListItem>
                        <f:ListItem Text="ICO文件" Value="ICO文件"></f:ListItem>
                        <f:ListItem Text="GIF文件" Value="GIF文件"></f:ListItem>
                        <f:ListItem Text="XML文件" Value="XML文件"></f:ListItem>
                        <f:ListItem Text="ASHX文件" Value="ASHX文件"></f:ListItem>
                    </f:DropDownList>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="大小" ColumnID="Size" DataField="Size" FieldType="Int">
                <Editor>
                    <f:NumberBox ID="tbxSize" NoDecimal="true" NoNegative="true" MinValue="0">
                    </f:NumberBox>
                </Editor>
            </f:RenderField>
            <f:RenderField HeaderText="修改日期" ColumnID="ModifyDate" DataField="ModifyDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" Width="150">
                <Editor>
                    <f:DatePicker ID="DatePicker1" Required="true">
                    </f:DatePicker>
                </Editor>
            </f:RenderField>
            <f:RenderField EnableHeaderMenu="false">
                <Commands>
                    <f:Command CommandName="Delete" Icon="Delete" ConfirmText="删除选中行？" ConfirmTarget="Top" />
                </Commands>
            </f:RenderField>
        </Columns>
        <Listeners>
            <f:Listener Event="rowcommand" Handler="onGrid1RowCommand"></f:Listener>
        </Listeners>
        <Toolbars>
            <f:Toolbar ID="Toolbar1">
                <Items>
                    <f:Button ID="btnDelete" Text="删除选中行" Icon="Delete" ClickHandler="onDeleteClick"></f:Button>
                    <f:ToolbarFill>
                    </f:ToolbarFill>
                    <f:Button ID="btnReset" Text="重置表格数据" ClickHandler="onResetClick"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Grid>
    <br>

    <f:Button ID="btnSubmit" Text="保存数据" OnClick="btnSubmit_Click"></f:Button>

    <br>
    <f:Label ID="labResult" EncodeText="false"></f:Label>

    <br />
    <br />

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onGrid1RowDataBound(rowData) {
            var rowId = rowData.id;

            // 默认展开的节点
            if (rowId === '50' || rowId === '60') {
                rowData.expanded = true;
            }
        }


        function renderType(value) {
            return F.ui.ddlType.getTextByValue(value);
        }


        function onResetClick(event) {
            F.confirm({
                message: '确定要重置表格数据？',
                ok: function () {
                    F.ui.Grid1.rejectChanges();
                }
            });
        }

        function onDeleteClick(event) {
            var grid1 = F.ui.Grid1;
            if (!grid1.hasSelection()) {
                F.alert('没有选中项！');
                return;
            }

            var selectedRows = grid1.getSelectedRows();
            F.confirm({
                message: F.rawHtml('你确定要删除选中的&nbsp;<b>' + selectedRows.length + '</b>&nbsp;行数据吗？'),
                target: '_top',
                ok: function () {
                    grid1.deleteRows(selectedRows);
                }
            });
        }

        // 行命令
        function onGrid1RowCommand(event, rowId, rowIndex, columnId, commandName) {
            if(commandName === 'Delete') {
                F.ui.Grid1.deleteRow(rowId);
            }
        }


    </script>
}
@section exampleDescription {
<section aria-label="页面描述">
    <p>在可编辑树表格中删除节点及其后代，与本轮编辑一起处理。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>按树分支删除记录</h3>
    <ol>
        <li>选择<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>一个带子节点的目录，点击<strong class="example-control-reference" data-example-control="btnDelete" title="删除选中行">删除选中行</strong>并确认。<br />结果：浏览器登记该分支删除；删除父节点不能留下失去父级的后代显示在原位置。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnSubmit" title="保存数据">保存数据</strong>。<br />结果：后台按父子关系递归删除选中节点及后代，重新绑定后分支不再出现。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>AllowCellEditing</code>（<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>）：初始为 <code>true</code>，让节点数据列采用对应编辑器，树形展示与数据编辑共同保留。</li>
        <li><code>DataParentIDField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>）：初始为 <code>ParentId</code>，通过父节点标识维护层级；删除父节点时本页处理同时移除后代。</li>
    </ul>
</section>
}
