@page
@model FineUI.Core.Examples.Pages.GridTree.CustomClassModel
@{
    ViewBag.Title = "GridTree/CustomClass";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="树表格" DataIDField="Id" DataTextField="Name"
            EnableTree="true" TreeColumn="Name" DataParentIDField="Parent.Id">
        <Columns>
            <f:RowNumberField />
            <f:RenderField ColumnID="Name" HeaderText="名称" DataField="Name" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="类型" DataField="Type" Width="150" />
            <f:RenderField HeaderText="大小" DataField="Size" Width="150" />
            <f:RenderField HeaderText="修改日期" DataField="ModifyDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" Width="150" />
        </Columns>
    </f:Grid>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>从对象列表的嵌套父对象属性读取父节点标识，组成树表格。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>按父对象属性恢复层级</h3>
    <ul>
        <li>展开<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>一个目录并查看其子项。<br />结果：绑定代码读取 Parent.Id 关联父行，而不是把整个 Parent 对象当成主键；后代显示在对应父目录下。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>DataParentIDField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>）：初始为 <code>Parent.Id</code>，采用嵌套属性路径 Parent.Id，与当前行的唯一标识配合建立父子关系。</li>
    </ul>
</section>
}
