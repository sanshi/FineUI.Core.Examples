@page
@model FineUI.Core.Examples.Pages.GridTree.ExpandRowsModel
@{
    ViewBag.Title = "GridTree/ExpandRows";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="树表格" DataIDField="Id" DataTextField="Name" DataSource="@DataSourceUtil.GetTreeDataTable()" EnableTree="true" TreeColumn="Name" DataParentIDField="ParentId" RowDataBoundFunction="onGrid1RowDataBound">
        <Columns>
            <f:RowNumberField EnableTreeNumber="true" />
            <f:RenderField ColumnID="Name" HeaderText="名称" DataField="Name" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="类型" DataField="Type" Width="150" />
            <f:RenderField HeaderText="大小" DataField="Size" Width="150" />
            <f:RenderField HeaderText="修改日期" DataField="ModifyDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" Width="150" />
        </Columns>
    </f:Grid>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <br />
    <br />
    注：本树表格默认展开 [basic] 和 [res] 两个目录。

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onGrid1RowDataBound(rowData) {
            var rowId = rowData.id;

            // 默认展开的节点
            if (rowId === '50' || rowId === '60') {
                rowData.expanded = true;
            }
        }

    </script>
}