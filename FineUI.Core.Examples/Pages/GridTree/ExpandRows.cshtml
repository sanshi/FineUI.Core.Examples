@page
@model FineUI.Core.Examples.Pages.GridTree.ExpandRowsModel
@{
    ViewBag.Title = "GridTree/ExpandRows";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="树表格" DataIDField="Id" DataTextField="Name" EnableTree="true" TreeColumn="Name" DataParentIDField="ParentId" RowDataBoundFunction="onGrid1RowDataBound">
        <Columns>
            <f:RowNumberField EnableTreeNumber="true" />
            <f:RenderField ColumnID="Name" HeaderText="名称" DataField="Name" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="类型" DataField="Type" Width="150" />
            <f:RenderField HeaderText="大小" DataField="Size" Width="150" />
            <f:RenderField HeaderText="修改日期" DataField="ModifyDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" Width="150" />
        </Columns>
    </f:Grid>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <br />
    <br />


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onGrid1RowDataBound(rowData) {
            var rowId = rowData.id;

            // 默认展开的节点
            if (rowId === '50' || rowId === '60') {
                rowData.expanded = true;
            }
        }

    </script>
}
@section exampleDescription {
<section aria-label="页面描述">
    <p>只让指定目录在首次加载时展开，其他分支保留折叠状态。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>核对初始展开范围</h3>
    <ul>
        <li>刚打开页面查看<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>目录与后代，再折叠、重新展开一个目录。<br />结果：basic、res 等指定目录初始展开；用户之后可自行改变某一分支状态。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <p>注：本树表格默认展开 [basic] 和 [res] 两个目录。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>rowData.expanded</code>（<strong>行绑定处理</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>）：行绑定时按节点标识设置 true，只设置本页指定的目录。</li>
    </ul>
</section>
}
