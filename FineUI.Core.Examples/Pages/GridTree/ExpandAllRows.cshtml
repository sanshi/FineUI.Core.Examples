@page
@model FineUI.Core.Examples.Pages.GridTree.ExpandAllRowsModel
@{
    ViewBag.Title = "GridTree/ExpandAllRows";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="树表格" DataIDField="Id" DataTextField="Name" EnableTree="true" TreeColumn="Name"
        DataParentIDField="ParentId" ExpandAllTreeNodes="true">
        <Columns>
            <f:RowNumberField EnableTreeNumber="true" />
            <f:RenderField ColumnID="Name" HeaderText="名称" DataField="Name" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="类型" DataField="Type" Width="150" />
            <f:RenderField HeaderText="大小" DataField="Size" Width="150" />
            <f:RenderField HeaderText="修改日期" DataField="ModifyDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" Width="150" />
        </Columns>
    </f:Grid>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <br />
    <br />


}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>首次加载展开全部树节点，后续仍可单独折叠一个分支。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>核对初始展开范围</h3>
        <ul>
            <li>刚打开页面查看<strong class="example-control-reference" data-example-control="Grid1"
                    title="树表格">树表格</strong>目录与后代，再折叠、重新展开一个目录。<br />结果：全部后代初始可见；只折叠当前分支，不影响其他目录。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：通过设置ExpandAllTreeNodes属性，来展开树表格的全部节点。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ExpandAllTreeNodes</code>（<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>）：初始为
                <code>true</code>，首次绑定时展开全部节点。
            </li>
        </ul>
    </section>
}
