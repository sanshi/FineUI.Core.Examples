@page
@model FineUI.Core.Examples.Pages.GridTree.IconsModel
@{
    ViewBag.Title = "GridTree/Icons";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="树表格" DataIDField="Id" DataTextField="Name" EnableTree="true" TreeColumn="Name" DataParentIDField="ParentId" RowDataBoundFunction="onGrid1RowDataBound">
        <Columns>
            <f:RowNumberField />
            <f:RenderField ColumnID="Name" HeaderText="名称" DataField="Name" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="类型" DataField="Type" Width="150" />
            <f:RenderField HeaderText="大小" DataField="Size" Width="150" />
            <f:RenderField HeaderText="修改日期" DataField="ModifyDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" Width="150" />
        </Columns>
    </f:Grid>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <br />
    <br />

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onGrid1RowDataBound(rowData) {
            var rowId = rowData.id;

            // 默认展开的节点
            if (rowId === '50' || rowId === '60' || rowId === '63' || rowId === '64') {
                rowData.expanded = true;
            }

            var name = rowData.values.Name;
            var lastDotIndex = name.lastIndexOf('.');
            if (lastDotIndex >= 0)
            {
                var fileType = name.substr(lastDotIndex + 1).toLowerCase();

                if (fileType === 'png' || fileType === 'ico' || fileType === 'gif')
                {
                    rowData.iconFont = 'f-iconfont-pic';
                }
                else
                {
                    rowData.icon = F.formatString('@Url.Content("~/res/images/filetype/vs-{0}.png")', fileType);
                }
            }
        }

    </script>
}
@section exampleDescription {
<section aria-label="页面描述">
    <p>按文件类型为树节点指定自定义图标，目录与文件保持各自层级。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>查看不同类型节点的图标</h3>
    <ul>
        <li>展开<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>一个目录并查看下方文件。<br />结果：文件按<strong>类型</strong>使用相应图标，展开或折叠只改变后代显示，不替换节点业务值。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>rowData.icon</code>（<strong>行绑定处理</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>）：按<strong>类型</strong>在行绑定阶段指定节点图标。</li>
    </ul>
</section>
}
