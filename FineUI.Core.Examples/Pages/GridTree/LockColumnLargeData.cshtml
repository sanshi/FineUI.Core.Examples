@page
@model FineUI.Core.Examples.Pages.GridTree.LockColumnLargeDataModel
@{
    ViewBag.Title = "GridTree/LockColumnLargeData";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="树表格（3500个节点）" DataIDField="Id" DataTextField="Name"
            EnableTree="true" TreeColumn="Name" DataParentIDField="ParentId"
            AllowColumnLocking="true">
        <Columns>
            <f:RowNumberField EnableTreeNumber="false" Width="80" />
            <f:RenderField ColumnID="Name" HeaderText="名称" DataField="Name" ExpandUnusedSpace="true" MinWidth="150" EnableLock="true" Locked="true" Width="300" />
            <f:RenderField HeaderText="类型" DataField="Type" Width="150" EnableLock="true" />
            <f:RenderField HeaderText="大小" DataField="Size" Width="150" EnableLock="true" />
            <f:RenderField HeaderText="修改日期" DataField="ModifyDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" Width="150" />
        </Columns>
    </f:Grid>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    @* <div style="position:absolute;top:10px;left:50%; margin-left:-80px; 
        width:160px; background-color: #fff; text-align:center;
	    border: 1px solid #eee;
	    box-shadow: 0 2px 4px rgba(0,0,0,.3);z-index:10000;padding:10px;
	    color: #674595;">
        FineUI.Core v11.8
    </div> *@
}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>在大量节点的树表格中固定指定列，横向滚动时仍可看到层级定位信息。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>滚动时保留锁定列</h3>
    <ul>
        <li>展开<strong class="example-control-reference" data-example-control="Grid1" title="树表格（3500个节点）">树表格（3500个节点）</strong>目录，再横向滚动。<br />结果：左侧锁定区域保持可见，普通列随滚动移动，节点的父子关系与当前展开状态保留。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>AllowColumnLocking</code>（<strong class="example-control-reference" data-example-control="Grid1" title="树表格（3500个节点）">树表格（3500个节点）</strong>）：初始为 <code>true</code>，为树表格启用列锁定。</li>
        <li><code>Locked</code>（<strong>已锁定列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="树表格（3500个节点）">树表格（3500个节点）</strong>）：本页指定列初始进入锁定区域，不影响其树节点数据。</li>
    </ul>
</section>
}
