@page
@model FineUI.Core.Examples.Pages.GridTree.GridTreeLargeDataModel
@{
    ViewBag.Title = "GridTree/GridTreeLargeData";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="树表格（3500个节点）" DataIDField="Id" DataTextField="Name" DataSource="@DataSourceUtil.GetLargeTreeDataTable()"
            EnableTree="true" TreeColumn="Name" DataParentIDField="ParentId">
        <Columns>
            <f:RowNumberField EnableTreeNumber="true" Width="80" />
            <f:RenderField ColumnID="Name" HeaderText="名称" DataField="Name" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="类型" DataField="Type" Width="150" />
            <f:RenderField HeaderText="大小" DataField="Size" Width="150" />
            <f:RenderField HeaderText="修改日期" DataField="ModifyDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" Width="150" />
        </Columns>
    </f:Grid>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <br />
    <br />
    注：用于测试展开折叠节点时的性能。
}


@section script {

    <script src="~/res/js/grid.js"></script>

}