@page
@model FineUI.Core.Examples.Pages.GridTree.NoIconsModel
@{
    ViewBag.Title = "GridTree/NoIcons";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="树表格" DataIDField="Id" DataTextField="Name" EnableTree="true" TreeColumn="Name" DataParentIDField="ParentId" EnableTreeIcons="false" RowDataBoundFunction="onGrid1RowDataBound">
        <Columns>
            <f:RowNumberField />
            <f:RenderField ColumnID="Name" HeaderText="名称" DataField="Name" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="类型" DataField="Type" Width="150" />
            <f:RenderField HeaderText="大小" DataField="Size" Width="150" />
            <f:RenderField HeaderText="修改日期" DataField="ModifyDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" Width="150" />
        </Columns>
    </f:Grid>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <br />
    <br />

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onGrid1RowDataBound(rowData) {
            var rowId = rowData.id;

            // 默认展开的节点
            if (rowId === '50' || rowId === '60') {
                rowData.expanded = true;
            }
        }

    </script>
}
@section exampleDescription {
<section aria-label="页面描述">
    <p>隐藏树节点的文件夹与文件图标，保留缩进和展开入口。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>去掉图标后仍可展开</h3>
    <ul>
        <li>展开<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>一个目录并查看下方文件。<br />结果：<strong>名称</strong>前不再显示节点图标，展开箭头仍可使用，子节点缩进不变。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableTreeIcons</code>（<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>）：初始为 <code>false</code>，关闭树节点图标，保留树结构交互。</li>
    </ul>
</section>
}
