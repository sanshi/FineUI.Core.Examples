@page
@model FineUI.Core.Examples.Pages.GridTree.LazyLoadModel
@{
    ViewBag.Title = "GridTree/LazyLoad";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="树表格" DataIDField="Id" DataTextField="Name" EnableTree="true" TreeColumn="Name"
        DataParentIDField="ParentId" RowDataBoundFunction="onGrid1RowDataBound" OnRowLazyLoad="Grid1_RowLazyLoad">
        <Columns>
            <f:RowNumberField />
            <f:RenderField ColumnID="Name" HeaderText="名称" DataField="Name" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="类型" DataField="Type" Width="150" />
            <f:RenderField HeaderText="大小" DataField="Size" Width="150" />
            <f:RenderField HeaderText="修改日期" DataField="ModifyDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" Width="150" />
        </Columns>
    </f:Grid>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

<script src="~/res/js/grid.js"></script>

<script>

    function onGrid1RowDataBound(rowData) {

        // 显式设置类型[文件夹]为非叶子节点（展开时延迟加载）
        // 如果不如此设置，则没有子节点的节点都被默认作为叶子节点
        var rowType = rowData.values.Type;
        if (rowType === '文件夹') {
            rowData.leaf = false;
        }
    }

</script>
}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>首次展开待加载目录时才请求子节点，不在首屏传输全部后代。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>展开时取得当前分支</h3>
        <ol>
            <li>点击<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>标记为待加载目录的展开图标。<br />结果：节点展开触发回发，后台根据当前 RowID
                返回这个目录的子节点，加载结果归入原父行。</li>
            <li>收起该目录后再展开。<br />结果：已经取得的子节点继续可见，不重复追加相同记录；尚未加载的其他目录仍各自按需读取。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>OnRowLazyLoad / LoadData</code>（<strong>延迟加载处理</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="树表格">树表格</strong>）：给待加载节点标记 lazy 状态，收到父行标识后只提供相应分支数据。</li>
        </ul>
    </section>
}
