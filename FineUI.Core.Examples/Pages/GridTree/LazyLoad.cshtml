@page
@model FineUI.Core.Examples.Pages.GridTree.LazyLoadModel
@{
    ViewBag.Title = "GridTree/LazyLoad";
    var F = Html.F();
}


@section body {

<f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="树表格" DataIDField="Id" DataTextField="Name"
        EnableTree="true" TreeColumn="Name" DataParentIDField="ParentId" RowDataBoundFunction="onGrid1RowDataBound"
        OnRowLazyLoad="Grid1_RowLazyLoad">
    <Columns>
        <f:RowNumberField />
        <f:RenderField ColumnID="Name" HeaderText="名称" DataField="Name" ExpandUnusedSpace="true" MinWidth="150" />
        <f:RenderField HeaderText="类型" DataField="Type" Width="150" />
        <f:RenderField HeaderText="大小" DataField="Size" Width="150" />
        <f:RenderField HeaderText="修改日期" DataField="ModifyDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" Width="150" />
    </Columns>
</f:Grid>
<br>

<f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

<script src="~/res/js/grid.js"></script>

<script>

    function onGrid1RowDataBound(rowData) {

        // 显式设置类型[文件夹]为非叶子节点（展开时延迟加载）
        // 如果不如此设置，则没有子节点的节点都被默认作为叶子节点
        var rowType = rowData.values.Type;
        if (rowType === '文件夹') {
            rowData.leaf = false;
        }
    }

</script>
}