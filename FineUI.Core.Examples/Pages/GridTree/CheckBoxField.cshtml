@page
@model FineUI.Core.Examples.Pages.GridTree.CheckBoxFieldModel
@{
    ViewBag.Title = "GridTree/CheckBoxField";
    var F = Html.F();
}


@section head {

    <style>
        .f-grid-cell.hidethis .f-grid-checkbox {
            display: none;
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="树表格" DataIDField="Id" DataTextField="Name" EnableTree="true" TreeColumn="Name" DataParentIDField="ParentId">
        <Columns>
            <f:RowNumberField EnableTreeNumber="true" />
            <f:RenderField ColumnID="Name" HeaderText="名称" DataField="Name" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="类型" DataField="Type" Width="150" />
            <f:RenderField HeaderText="大小" DataField="Size" Width="150" />
            <f:RenderCheckField ColumnID="FollowFolder" HeaderText="关注目录" RenderAsStaticField="false" RendererFunction="renderFollowFolder" />
            <f:RenderField HeaderText="修改日期" DataField="ModifyDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" Width="150" />
        </Columns>
    </f:Grid>
    <br>

    <f:Button CssClass="marginr" Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <f:Button ID="Button2" Text="关注的目录列表" ClickHandler="onNotifyCheckedFollowFolderClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderFollowFolder(value, params) {
            var rowData = params.rowData;

            // 类型
            var type = rowData.values.Type;
            if (type !== '文件夹') {
                params.cellCls = 'hidethis';
            }

            return value;
        }

        function onNotifyCheckedFollowFolderClick(event) {
            var grid1 = F.ui.Grid1;

            var rowEls = grid1.getRowEls();

            var result = ['<table class="result">'];
            result.push('<tr>');
            result.push('<th>行号</th>');
            result.push('<th>ID</th>');
            result.push('<th>名称</th>');
            result.push('</tr>');
            rowEls.each(function () {
                var cnode = $(this);
                var rowData = grid1.getRowData(cnode);
                var isChecked = rowData.values['FollowFolder'];

                if (isChecked) {
                    result.push('<tr>');
                    result.push('<td>' + (rowData.index + 1) + '</td>');
                    result.push('<td>' + rowData.id + '</td>');
                    result.push('<td>' + rowData.text + '</td>');
                    result.push('</tr>');
                }
            });
            result.push('</table>');

            F.notify({
                message: F.rawHtml(result.join('')),
                target: '_top',
                header: false,
                messageIcon: '',
                positionX: 'center',
                positionY: 'top'
            });
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>只为目录显示关注复选框，读取已关注目录，文件行不提供这个操作。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>关注目录并读取名单</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong><strong>关注目录</strong>列勾选一个目录，再查看文件行。<br />结果：目录可切换关注状态，文件行的关注复选框隐藏；树展开与关注状态分别处理。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button2" title="关注的目录列表">关注的目录列表</strong>。<br />结果：提示列出正文关注复选框已勾选的目录标识和<strong>名称</strong>，不把整行选择当作关注状态。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>RendererFunction / cellCls</code>（<strong>关注目录列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>）：按<strong>类型</strong>为非文件夹单元格添加隐藏样式，保留树列本身。</li>
    </ul>
</section>
}
