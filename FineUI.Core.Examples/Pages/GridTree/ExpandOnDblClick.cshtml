@page
@model FineUI.Core.Examples.Pages.GridTree.ExpandOnDblClickModel
@{
    ViewBag.Title = "GridTree/ExpandOnDblClick";
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="树表格" DataIDField="Id" DataTextField="Name" DataSource="@DataSourceUtil.GetTreeDataTable()"
            EnableTree="true" TreeColumn="Name" DataParentIDField="ParentId"
            OnRowDoubleClick="Grid1_RowDoubleClick" _DataKeyNames="Id,Name"
            TreeExpandOnDblClick="false">
        <Columns>
            <f:RowNumberField />
            <f:RenderField ColumnID="Name" HeaderText="名称" DataField="Name" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="类型" DataField="Type" Width="150" />
            <f:RenderField HeaderText="大小" DataField="Size" Width="150" />
            <f:RenderField HeaderText="修改日期" DataField="ModifyDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" Width="150" />
        </Columns>
    </f:Grid>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <br>
    <br>
    注：本示例启用了行双击事件（EnableRowDoubleClickEvent），禁用了双击展开树节点（TreeExpandOnDblClick）。

}


@section script {

    <script src="~/res/js/grid.js"></script>

}