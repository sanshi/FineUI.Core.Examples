@page
@model FineUI.Core.Examples.Pages.GridTree.PagingSummaryDataLockColumnModel
@{
    ViewBag.Title = "GridTree/PagingSummaryDataLockColumn";
    var F = Html.F();
}


@section head {

    <style>
        .f-grid-row-summary .f-grid-cell-text {
            font-weight: bold;
            color: red;
        }
    </style>

}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="树表格" DataIDField="Id" DataTextField="Name"
            EnableTree="true" TreeColumn="Name" DataParentIDField="ParentId"
            Height="400"
            AllowPaging="true" IsDatabasePaging="true" PageSize="2" OnPageIndexChanged="Grid1_PageIndexChanged"
            EnableSummary="true" SummaryPosition="Bottom"
            AllowColumnLocking="true" EnableCheckBoxSelect="true">
        <Columns>
            <f:RowNumberField EnableTreeNumber="true" />
            <f:RenderField ColumnID="Name" HeaderText="姓名" DataField="Name" ExpandUnusedSpace="true" MinWidth="150" EnableLock="true" />
            <f:RenderField HeaderText="类型" DataField="Type" Width="150" EnableLock="true" />
            <f:RenderField HeaderText="大小" DataField="Size" Width="150" EnableLock="true" />
            <f:RenderField HeaderText="修改日期" DataField="ModifyDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" Width="150" EnableLock="true" />
        </Columns>
        <PageItems>
            <f:Button ID="btnExpandAll" Text="展开全部" ClickHandler="onExpandAllClick"></f:Button>
            <f:Button ID="btnCollapseAll" Text="折叠全部" ClickHandler="onCollapseAllClick"></f:Button>
        </PageItems>
    </f:Grid>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onExpandAllClick(event) {
            F.ui.Grid1.expandRows();
        }


        function onCollapseAllClick(event) {
            F.ui.Grid1.collapseRows();
        }

    </script>
}