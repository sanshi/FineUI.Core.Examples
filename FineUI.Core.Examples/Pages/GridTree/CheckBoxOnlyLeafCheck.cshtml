@page
@model FineUI.Core.Examples.Pages.GridTree.CheckBoxOnlyLeafCheckModel
@{
    ViewBag.Title = "GridTree/CheckBoxOnlyLeafCheck";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="树表格" DataIDField="Id" DataTextField="Name" EnableTree="true" TreeColumn="Name"
        DataParentIDField="ParentId" TreeCheckBox="true" TreeOnlyLeafCheck="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField ColumnID="Name" HeaderText="名称" DataField="Name" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="类型" DataField="Type" Width="150" />
            <f:RenderField HeaderText="大小" DataField="Size" Width="150" />
            <f:RenderField HeaderText="修改日期" DataField="ModifyDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" Width="150" />
        </Columns>
    </f:Grid>
    <br>

    <f:Button CssClass="marginr" Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>


    <f:Button ID="btnGetCheckedValues" Text="获取选中的复选框" ClickHandler="onGetCheckedRowsClick"></f:Button>
    <br>
    <br>

    <f:Label ID="labResult" EncodeText="false"></f:Label>
}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>
        // 读取勾选行、经自定义事件回发服务端
        function onGetCheckedRowsClick(event) {
            var result = [];

            var checkedRows = F.ui.Grid1.getCheckedRows(true);
            if (checkedRows.length) {
                $.each(checkedRows, function (index, row) {
                    result.push({
                        id: row.id,
                        text: row.text
                    });
                });
            }

            F.customEvent('GetCheckedRows', result);
        }
    </script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>只在叶子文件节点显示树复选框，目录仍可展开。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>限制可勾选节点类型</h3>
        <ol>
            <li>展开<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>的 basic、res
                等目录，尝试切换<strong>名称</strong>旁的树复选框。<br />结果：文件节点有复选框，目录不显示复选框，展开图标仍可使用。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnGetCheckedValues"
                    title="获取选中的复选框">获取选中的复选框</strong>。<br />结果：客户端读取已勾选树节点并交给后台，在结果区域显示标识与<strong>名称</strong>；没有勾选时显示对应提示。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>TreeOnlyLeafCheck</code>（<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>）：初始为
                <code>true</code>，只给叶子节点创建树复选框。
            </li>
            <li><code>getCheckedRows</code>（<strong>读取勾选的页面脚本</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="树表格">树表格</strong>）：读取树复选框结果，不使用 getSelectedRows 代替节点勾选。</li>
        </ul>
    </section>
}
