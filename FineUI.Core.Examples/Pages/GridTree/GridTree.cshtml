@page
@model FineUI.Core.Examples.Pages.GridTree.GridTreeModel
@{
    ViewBag.Title = "GridTree/GridTree";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="树表格" DataIDField="Id" DataTextField="Name" DataSource="@DataSourceUtil.GetTreeDataTable()" EnableTree="true" TreeColumn="Name" DataParentIDField="ParentId">
        <Columns>
            <f:RowNumberField />
            <f:RenderField ColumnID="Name" HeaderText="名称" DataField="Name" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="类型" DataField="Type" Width="150" />
            <f:RenderField HeaderText="大小" DataField="Size" Width="150" />
            <f:RenderField HeaderText="修改日期" DataField="ModifyDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" Width="150" />
        </Columns>
    </f:Grid>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    

}