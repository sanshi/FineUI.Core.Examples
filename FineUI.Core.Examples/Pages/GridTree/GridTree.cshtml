@page
@model FineUI.Core.Examples.Pages.GridTree.GridTreeModel
@{
    ViewBag.Title = "GridTree/GridTree";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="树表格" DataIDField="Id" DataTextField="Name" EnableTree="true" TreeColumn="Name"
        DataParentIDField="ParentId">
        <Columns>
            <f:RowNumberField />
            <f:RenderField ColumnID="Name" HeaderText="名称" DataField="Name" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="类型" DataField="Type" Width="150" />
            <f:RenderField HeaderText="大小" DataField="Size" Width="150" />
            <f:RenderField HeaderText="修改日期" DataField="ModifyDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" Width="150" />
        </Columns>
    </f:Grid>
    <br>

    <f:Button ID="btnShowSelectedRows" Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>



}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>根据节点主键与父节点主键组成树表格，在名称列展开层级并查看节点资料。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>展开层级并读取当前节点</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>basic
                等目录前的展开箭头，再点击一次。<br />结果：对应后代按层级缩进显示，再次点击收起这一分支；其他目录保留原状态。</li>
            <li>选择一个节点行，点击<strong class="example-control-reference" data-example-control="btnShowSelectedRows"
                    title="选中了哪些行">选中了哪些行</strong>。<br />结果：提示当前选择的节点资料；行选择不自动代表选择全部后代。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableTree</code>（<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>）：初始为
                <code>true</code>，使用树节点方式呈现行。
            </li>
            <li><code>TreeColumn</code>（<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>）：初始为
                <code>Name</code>，在指定<strong>名称</strong>列中显示层级与展开入口。
            </li>
            <li><code>DataIDField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>）：初始为
                <code>Id</code>，提供每个节点稳定、唯一的标识。
            </li>
            <li><code>DataParentIDField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>）：初始为
                <code>ParentId</code>，读取父节点标识，把子行关联到对应父行。
            </li>
        </ul>
    </section>
}
