@page
@model FineUI.Core.Examples.Pages.FormLayout.LayoutCheckOutModel
@{
    ViewBag.Title = "FormLayout/LayoutCheckOut";
    var F = Html.F();
}


@section body {

    <f:Window ID="Window1" Title="账单信息" IsModal="false" EnableClose="false" EnableResize="true" Width="650" BodyPadding="10" AutoScroll="true">
        <Items>
            <f:Form ID="Form1" LabelAlign="Right" MessageTarget="Qtip" ShowBorder="false" ShowHeader="false">
                <Items>
                    <f:GroupPanel ID="GroupPanel1" Layout="Anchor" Title="联系人信息">
                        <Items>
                            <f:Panel ID="Panel2" Layout="HBox" ShowHeader="false" ShowBorder="false">
                                <Items>
                                    <f:Label ID="Label1" ShowRedStar="true" Label="姓名"></f:Label>
                                    <f:TextBox ID="TextBox2" ShowLabel="false" CssClass="marginr" Required="true" ShowRedStar="true" BoxFlex="2">
                                    </f:TextBox>
                                    <f:TextBox ID="TextBox4" ShowLabel="false" Required="true" ShowRedStar="true" BoxFlex="3">
                                    </f:TextBox>
                                </Items>
                            </f:Panel>
                            <f:Panel ID="Panel1" Layout="HBox" BoxConfigAlign="Stretch" ShowHeader="false" ShowBorder="false">
                                <Items>
                                    <f:TextBox ID="TextBox1" Required="true" ShowRedStar="true" Label="电子邮箱" RegexPattern="EMAIL" RegexMessage="请输入有效的邮箱地址"
                                        BoxFlex="1">
                                    </f:TextBox>
                                    <f:TextBox ID="TextBox6" Label="电话号码" Width="200" Required="true" ShowRedStar="true">
                                    </f:TextBox>
                                </Items>
                            </f:Panel>
                        </Items>
                    </f:GroupPanel>
                    <f:GroupPanel ID="GroupPanel2" Layout="Anchor" Title="联系人地址">
                        <Items>
                            <f:TextBox ID="TextBox7" Label="详细地址" Required="true" ShowRedStar="true">
                            </f:TextBox>
                            <f:Panel ID="Panel4" Layout="HBox" BoxConfigAlign="Stretch" ShowHeader="false" ShowBorder="false">
                                <Items>
                                    <f:TextBox ID="TextBox9" Label="省" BoxFlex="1" Required="true" ShowRedStar="true">
                                    </f:TextBox>
                                    <f:TextBox ID="TextBox5" Label="市" BoxFlex="1" LabelWidth="50" Required="true" ShowRedStar="true">
                                    </f:TextBox>
                                    <f:TextBox ID="TextBox8" Label="邮政编码" Width="200" Required="true" ShowRedStar="true">
                                    </f:TextBox>
                                </Items>
                            </f:Panel>
                        </Items>
                    </f:GroupPanel>
                    <f:GroupPanel ID="GroupPanel3" Layout="Anchor" Title="账单地址">
                        <Items>
                            <f:CheckBox Checked="true" ID="cbxSameAsContactAddress" Text="和联系人地址相同" OnCheckedChanged="cbxSameAsContactAddress_CheckedChanged">
                            </f:CheckBox>
                            <f:TextBox ID="tbxBillingAddress" Enabled="false" Label="详细地址" Required="true" ShowRedStar="true">
                            </f:TextBox>
                            <f:Panel ID="Panel3" Layout="HBox" BoxConfigAlign="Stretch" ShowHeader="false" ShowBorder="false">
                                <Items>
                                    <f:TextBox ID="tbxBillingProvince" Enabled="false" Label="省" BoxFlex="1" Required="true" ShowRedStar="true">
                                    </f:TextBox>
                                    <f:TextBox ID="tbxBillingCity" Enabled="false" Label="市" BoxFlex="1" LabelWidth="50" Required="true" ShowRedStar="true">
                                    </f:TextBox>
                                    <f:TextBox ID="tbxBillingPostCode" Enabled="false" Label="邮政编码" Width="200" Required="true" ShowRedStar="true">
                                    </f:TextBox>
                                </Items>
                            </f:Panel>
                        </Items>
                    </f:GroupPanel>
                    <f:GroupPanel ID="GroupPanel4" Layout="Anchor" Title="付款方式">
                        <Items>
                            <f:RadioButtonList ID="RadioButtonList1" ColumnNumber="5" ShowLabel="false">
                                <f:RadioItem Text="银联" Value="yinlian" Selected="true" />
                                <f:RadioItem Text="VISA" Value="visa" />
                                <f:RadioItem Text="MasteCard" Value="mastercard" />
                            </f:RadioButtonList>
                            <f:TextBox ID="TextBox3" Label="卡上的名字" Required="true" ShowRedStar="true">
                            </f:TextBox>
                            <f:Panel ID="Panel5" Layout="HBox" BoxConfigAlign="Stretch" ShowHeader="false" ShowBorder="false">
                                <Items>
                                    <f:TextBox ID="TextBox14" Label="卡号" BoxFlex="1" Required="true" ShowRedStar="true">
                                    </f:TextBox>
                                    <f:DropDownList ID="DropDownList1" Label="过期时间" Width="180" CssClass="marginr" Required="true" ShowRedStar="true">
                                        <f:ListItem Text="一月" Value="1" />
                                        <f:ListItem Text="二月" Value="2" />
                                        <f:ListItem Text="三月" Value="3" />
                                        <f:ListItem Text="四月" Value="4" />
                                        <f:ListItem Text="五月" Value="5" />
                                        <f:ListItem Text="六月" Value="6" />
                                        <f:ListItem Text="七月" Value="7" />
                                        <f:ListItem Text="八月" Value="8" />
                                        <f:ListItem Text="九月" Value="9" />
                                        <f:ListItem Text="十月" Value="10" />
                                        <f:ListItem Text="十一月" Value="11" />
                                        <f:ListItem Text="十二月" Value="12" />
                                    </f:DropDownList>
                                    <f:NumberBox ID="TextBox16" ShowLabel="false" NoDecimal="true" NoNegative="true" Text="2014" Width="100" Required="true"
                                        ShowRedStar="true">
                                    </f:NumberBox>
                                </Items>
                            </f:Panel>
                        </Items>
                    </f:GroupPanel>
                </Items>
            </f:Form>
        </Items>
        <Toolbars>
            <f:Toolbar ID="Toolbar1" ToolbarAlign="Right" Position="Bottom">
                <Items>
                    <f:Button ID="Button1" IconFont="_Save" Text="提交账单" _ValidateForms="Form1" ValidateMessageBox="false"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Window>


}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示将联系人、地址和付款字段分组，并通过<strong class="example-control-reference" data-example-control="cbxSameAsContactAddress" title="和联系人地址相同">复选框</strong>切换<strong
                class="example-control-reference" data-example-control="GroupPanel3" title="账单地址">账单地址</strong>的可编辑状态。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>切换账单地址</h3>
        <ol>
            <li>
                取消<strong class="example-control-reference" data-example-control="cbxSameAsContactAddress" title="和联系人地址相同">和联系人地址相同</strong>的勾选。<br />
                结果：回发后，后台启用<strong class="example-control-reference" data-example-control="GroupPanel3" title="账单地址">账单地址</strong>的详细地址、省、市和邮政编码字段。
            </li>
            <li>
                再次勾选。<br />
                结果：回发后，后台禁用这四个字段；本例切换的是可用状态，没有自动复制<strong class="example-control-reference" data-example-control="GroupPanel2" title="联系人地址">联系人地址</strong>的值。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>填写分组字段</h3>
        <ul>
            <li>
                对照<strong class="example-control-reference" data-example-control="GroupPanel1" title="联系人信息">联系人信息</strong>、<strong
                    class="example-control-reference" data-example-control="GroupPanel2" title="联系人地址">联系人地址</strong>、<strong class="example-control-reference"
                    data-example-control="GroupPanel3" title="账单地址">账单地址</strong>和<strong class="example-control-reference" data-example-control="GroupPanel4"
                    title="付款方式">付款方式</strong>四组内容。<br />
                结果：组内用横向伸展和固定宽度组合字段，姓名两项、邮箱与电话、卡号与<strong class="example-control-reference" data-example-control="DropDownList1"
                    title="过期时间">过期时间</strong>均可并排显示。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="GroupPanel1" title="联系人信息">联系人信息</strong>、<strong
                    class="example-control-reference" data-example-control="Panel2" title="第 1 个面板">第 1 个面板</strong>、<strong class="example-control-reference"
                    data-example-control="Panel1" title="第 2 个面板">第 2 个面板</strong>、<strong class="example-control-reference" data-example-control="GroupPanel2"
                    title="联系人地址">联系人地址</strong>、<strong class="example-control-reference" data-example-control="Panel4" title="第 3 个面板">第 3
                    个面板</strong>、<strong class="example-control-reference" data-example-control="GroupPanel3" title="账单地址">账单地址</strong>、<strong
                    class="example-control-reference" data-example-control="Panel3" title="第 4 个面板">第 4 个面板</strong>、<strong class="example-control-reference"
                    data-example-control="GroupPanel4" title="付款方式">付款方式</strong>、<strong class="example-control-reference" data-example-control="Panel5"
                    title="第 5 个面板">第 5 个面板</strong>）：组面板纵向排列，部分行采用 <code>HBox</code> 组合字段。</li>
            <li><code>BoxFlex</code>（<strong class="example-control-reference" data-example-control="TextBox2" title="第 1 个文本框">第 1 个文本框</strong>、<strong
                    class="example-control-reference" data-example-control="TextBox4" title="第 2 个文本框">第 2 个文本框</strong>、<strong
                    class="example-control-reference" data-example-control="TextBox1" title="电子邮箱">电子邮箱</strong>、<strong class="example-control-reference"
                    data-example-control="TextBox9" title="第 6 个文本框（省）">第 6 个文本框（省）</strong>、<strong class="example-control-reference"
                    data-example-control="TextBox5" title="第 7 个文本框（市）">第 7 个文本框（市）</strong>、<strong class="example-control-reference"
                    data-example-control="tbxBillingProvince" title="第 10 个文本框（省）">第 10 个文本框（省）</strong>、<strong class="example-control-reference"
                    data-example-control="tbxBillingCity" title="第 11 个文本框（市）">第 11 个文本框（市）</strong>、<strong class="example-control-reference"
                    data-example-control="TextBox14" title="卡号">卡号</strong>）：让姓名、邮箱或地址占用剩余宽度。</li>
            <li><code>Checked</code>（<strong class="example-control-reference" data-example-control="cbxSameAsContactAddress"
                    title="和联系人地址相同">和联系人地址相同</strong>）：<strong class="example-control-reference" data-example-control="cbxSameAsContactAddress"
                    title="和联系人地址相同">复选框</strong>初始选中，<strong class="example-control-reference" data-example-control="GroupPanel3"
                    title="账单地址">账单地址</strong>初始禁用。</li>
            <li><code>Enabled</code>（<strong class="example-control-reference" data-example-control="tbxBillingAddress" title="第 9 个文本框（详细地址）">第 9
                    个文本框（详细地址）</strong>、<strong class="example-control-reference" data-example-control="tbxBillingProvince" title="第 10 个文本框（省）">第 10
                    个文本框（省）</strong>、<strong class="example-control-reference" data-example-control="tbxBillingCity" title="第 11 个文本框（市）">第 11
                    个文本框（市）</strong>、<strong class="example-control-reference" data-example-control="tbxBillingPostCode" title="第 12 个文本框（邮政编码）">第 12
                    个文本框（邮政编码）</strong>）：<strong class="example-control-reference" data-example-control="cbxSameAsContactAddress"
                    title="和联系人地址相同">复选框</strong>变化事件回发后更新<strong class="example-control-reference" data-example-control="GroupPanel3"
                    title="账单地址">账单地址</strong>字段的可用状态。</li>
            <li><code>_ValidateForms</code>（<strong class="example-control-reference" data-example-control="Button1" title="提交账单">提交账单</strong>）：<strong
                    class="example-control-reference" data-example-control="Button1" title="提交账单">提交账单</strong>按钮先验证本页表单，不包含真实支付流程。</li>
        </ul>
    </section>
}
