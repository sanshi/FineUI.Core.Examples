@page
@model FineUI.Core.Examples.Pages.GridRowGroup.SummaryHideSomeModel
@{
    ViewBag.Title = "GridRowGroup/SummaryHideSome";
    var F = Html.F();
}

@section head {

    <style>
        .f-grid-rowgroup-summary .f-grid-cell-Major .f-grid-cell-text {
            text-align: right;
        }

        .f-grid-rowgroup-summary .f-grid-cell-text {
            font-style: italic;
        }
    </style>

}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" DataSource="@DataSourceUtil.GetDataTable()"
            EnableRowGroup="true" DataRowGroupField="EntranceYear" RowGroupSummary="true" RowRendererFunction="grid1RowRenderer">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" ColumnID="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" RowGroupSummaryText="平均（分组）：" />
            <f:RenderField HeaderText="语文成绩" DataField="ChineseScore" ColumnID="ChineseScore" FieldType="Int" RowGroupSummaryType="Avg" />
            <f:RenderField HeaderText="数学成绩" DataField="MathScore" ColumnID="MathScore" FieldType="Int" RowGroupSummaryType="Avg" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <br />
    <br />
    注：如果分组中只有一行数据，则隐藏分组合计。
}


@section script {

    <script src="~/res/js/grid.js"></script>


    <script>

        // 计算分组中的行数（排除分组合计）
        function linesInRowGroup(rowGroup) {
            var lines = 0;
            $.each(F.ui.Grid1.data, function (index, rowData) {
                if (rowData.isRowGroup && rowData.rowGroup === rowGroup) {
                    // 最后一行是分组合计
                    lines = rowData.children.length - 1;
                    return false; // break
                }
            });
            return lines;
        }

        // 在 RowRenderer 中改变行CSS类
        function grid1RowRenderer(params) {
            // 当前行是否分组合计
            var isRowGroupSummary = params.rowData.isRowGroupSummary;
            if (isRowGroupSummary) {
                var rowGroup = params.rowData.rowGroup;

                // 如果分组中只有一行数组，则隐藏分组合计
                if (linesInRowGroup(rowGroup) === 1) {
                    params.rowCls = 'f-hidden';
                }
            }
        }

    </script>
}