@page
@model FineUI.Core.Examples.Pages.GridRowGroup.SummaryModel
@{
    ViewBag.Title = "GridRowGroup/Summary";
    var F = Html.F();
}

@section head {

    <style>
        .f-grid-rowgroup-summary .f-grid-cell-Major .f-grid-cell-text {
            text-align: right;
        }

        .f-grid-rowgroup-summary .f-grid-cell-text {
            font-style: italic;
        }
    </style>

}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableRowGroup="true"
        DataRowGroupField="EntranceYear" RowGroupSummary="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" ColumnID="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150"
                RowGroupSummaryText="平均（分组）：" />
            <f:RenderField HeaderText="语文成绩" DataField="ChineseScore" ColumnID="ChineseScore" FieldType="Int" RowGroupSummaryType="Avg" />
            <f:RenderField HeaderText="数学成绩" DataField="MathScore" ColumnID="MathScore" FieldType="Int" RowGroupSummaryType="Avg" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>在每个年份分组后显示该组语文与数学成绩平均值。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>对照分组明细与统计值</h3>
        <ul>
            <li>查看<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>一个年份分组的明细及其后统计区域。<br />结果：各组平均（分组）按这一组的成绩计算，不把其他年份成绩混入。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>RowGroupSummary</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>true</code>，为分组创建专用统计行。
            </li>
            <li><code>RowGroupSummaryType</code>（<strong>语文与数学成绩列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：成绩列使用 Avg，只读取当前组的数值。</li>
        </ul>
    </section>
}
