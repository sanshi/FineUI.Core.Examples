@page
@model FineUI.Core.Examples.Pages.GridRowGroup.RowGroupAjaxModel
@{
    ViewBag.Title = "行分组（后台切换）";
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" Height="500" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name"
            EnableRowGroup="true" DataRowGroupField="EntranceYear">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>
    <br />
    <br />
    <f:Button ID="btnGroupYear" Text="后台按入学年份分组" OnClick="btnGroupYear_Click" CssClass="marginr" />
    <f:Button ID="btnGroupMajor" Text="后台按专业分组" OnClick="btnGroupMajor_Click" CssClass="marginr" />
    <f:Button ID="btnGroupOff" Text="后台关闭分组" OnClick="btnGroupOff_Click" CssClass="marginr" />
    <f:Button ID="btnReadGroup" Text="后台读取分组设置" OnClick="btnReadGroup_Click" />
    <br />
    <f:Label ID="labGroup" />
    <br />
    后台切换分组开关或字段时，须在同一次回发中先修改属性，再重新绑定数据。本页沿用原学生模拟数据源。
    <br />
    注：表格启用行分组后不支持行扩展列、树表格、列锁定和内存分页。
}


@section script {

    <script src="~/res/js/grid.js"></script>

}