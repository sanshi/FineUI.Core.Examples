@page
@model FineUI.Core.Examples.Pages.GridRowGroup.DatabaseSortingModel
@{
    ViewBag.Title = "GridRowGroup/DatabaseSorting";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" Height="500" ShowBorder="true" ShowHeader="true" Title="表格" EnableCheckBoxSelect="false" DataIDField="Id" DataTextField="Name"
            AllowPaging="true" PageSize="10" IsDatabasePaging="true" OnPageIndexChanged="Grid1_PageIndexChanged" 
            AllowSorting="true" SortField="Name" SortDirection="ASC" OnSort="Grid1_Sort"
            EnableRowGroup="true" DataRowGroupField="EntranceYear">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" SortField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" SortField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" SortField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" SortField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>在行分组中按页加载并排序记录，保留年份分组标题。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>排序与换页后重新分组</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong><strong>姓名</strong>等可排序列表头切换排序。<br />结果：排序回发后，后台按字段及升降序重新读取并绑定记录；显示记录继续按<strong>入学年份</strong><strong>分组</strong>。</li>
        <li>切换下一页，再返回原页。<br />结果：当前页记录重新取数和<strong>分组</strong>；同一业务年份可能出现在多个页，每组只包含当前页实际加载成员。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>AllowSorting</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>true</code>，允许列头发起排序，采用当前字段与方向读取记录。</li>
        <li><code>DataRowGroupField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>EntranceYear</code>，按 EntranceYear 生成<strong>分组</strong>标题，不把组标题当作普通数据行。</li>
        <li><code>IsDatabasePaging</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>true</code>，每次仅提供当前页记录，<strong>分组</strong>基于该批记录。</li>
    </ul>
</section>
}
