@page
@model FineUI.Core.Examples.Pages.GridRowGroup.RowGroupModel
@{
    ViewBag.Title = "GridRowGroup/RowGroup";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" Height="500" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name"
            EnableRowGroup="true" DataRowGroupField="EntranceYear">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>
    <br />
    <br />

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>按入学年份把学生组织成行分组，可逐组展开折叠查看成员。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>按年份查看成员</h3>
    <ul>
        <li>查看<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>年份<strong>分组</strong>标题，点击其中一组的折叠入口，再展开。<br />结果：同年份记录位于相应组标题下；折叠只收起该组明细，组标题本身不是可选学生行。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <p>注：表格启用行分组后不支持行扩展列、树表格、列锁定和内存分页。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableRowGroup</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>true</code>，启用行<strong>分组</strong>显示。</li>
        <li><code>DataRowGroupField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>EntranceYear</code>，从 EntranceYear 读取<strong>分组</strong>键，相同年份归入同一组。</li>
    </ul>
</section>
}
