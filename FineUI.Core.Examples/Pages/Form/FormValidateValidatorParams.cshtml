@page
@model FineUI.Core.Examples.Pages.Form.FormValidateValidatorParamsModel
@{
    ViewBag.Title = "Form/FormValidateValidatorParams";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" Title="用户注册表单">
        <Items>
            <f:TextBox ID="TextBox1" Label="输入框一" Required="true" ShowRedStar="true" ValidatorFunction="inputValidator">
                <Attributes>
                    <f:Attribute Key="data-maxlength" Value="3"></f:Attribute>
                </Attributes>
            </f:TextBox>
            <f:TextBox ID="TextBox2" Label="输入框二" Required="true" ShowRedStar="true" ValidatorFunction="inputValidator">
                <Attributes>
                    <f:Attribute Key="data-maxlength" Value="6"></f:Attribute>
                </Attributes>
            </f:TextBox>
            <f:Button ID="btnRegister" Text="注册" _ValidateForms="SimpleForm1" OnClick="btnRegister_Click"></f:Button>
        </Items>
    </f:SimpleForm>




}

@section script {

    <script>
        function inputValidator() {
            var inputCmp = this;
            var value = $.trim(inputCmp.getValue());
            var maxLength = parseInt(inputCmp.getAttr('data-maxlength'), 10);

            if (value.length <= maxLength) {
                return true;
            } else {
                return '最多只能输入 ' + maxLength + ' 个字符！';
            }
        }
    </script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示两个文本框共用同一个验证函数，通过各自参数设置不同的最大长度。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>使用字段自己的长度上限</h3>
        <ol>
            <li>
                <strong class="example-control-reference" data-example-control="TextBox1" title="输入框一">输入框一</strong>填写 <code>abcd</code>，<strong class="example-control-reference" data-example-control="TextBox2" title="输入框二">输入框二</strong>填写 <code>abc</code>，点击<strong class="example-control-reference" data-example-control="btnRegister" title="注册">注册</strong>。<br />
                结果：<strong class="example-control-reference" data-example-control="TextBox1" title="输入框一">输入框一</strong>提示最多 <code>3</code> 个字符，浏览器阻止后续提交。
            </li>
            <li>
                关闭提示，将<strong class="example-control-reference" data-example-control="TextBox1" title="输入框一">输入框一</strong>改为 <code>abc</code>，再点击<strong class="example-control-reference" data-example-control="btnRegister" title="注册">注册</strong>。<br />
                结果：两个长度规则通过后回发，后台显示当前表单值。
            </li>
            <li>
                再将<strong class="example-control-reference" data-example-control="TextBox2" title="输入框二">输入框二</strong>改为 <code>abcdefg</code> 并提交。<br />
                结果：它按自己的上限提示最多 <code>6</code> 个字符，不会沿用<strong class="example-control-reference" data-example-control="TextBox1" title="输入框一">第一个字段</strong>的 <code>3</code>。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：</p>
        <ul>
            <li> [<strong class="example-control-reference" data-example-control="TextBox1" title="输入框一">输入框一</strong>]的最大长度为 <code>3</code> 个字符。 </li>
            <li> [<strong class="example-control-reference" data-example-control="TextBox2" title="输入框二">输入框二</strong>]的最大长度为 <code>6</code> 个字符。 </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ValidatorFunction</code>（<strong class="example-control-reference" data-example-control="TextBox1" title="输入框一">输入框一</strong>、<strong class="example-control-reference" data-example-control="TextBox2" title="输入框二">输入框二</strong>）：两个输入框都使用 <code>inputValidator</code>，符合规则返回 <code>true</code>，失败返回错误文字。</li>
            <li><code>data-maxlength</code>（<strong class="example-control-reference" data-example-control="TextBox1" title="输入框一">输入框一</strong>、<strong class="example-control-reference" data-example-control="TextBox2" title="输入框二">输入框二</strong>）：本页在字段属性中分别设置为 <code>3</code>、<code>6</code>，函数读取各自的值。</li>
        </ul>
    </section>
}
