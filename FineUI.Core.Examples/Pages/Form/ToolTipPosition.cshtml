@page
@model FineUI.Core.Examples.Pages.Form.ToolTipPositionModel
@{
    ViewBag.Title = "Form/ToolTipPosition";
    var F = Html.F();
}


@section body {

    <div style="padding: 50px 150px; width: 900px;">
        <table style="width: 100%; border-spacing: 20px;">
            <tr>
                <td></td>
                <td style="text-align: center;">
                    <f:Button CssClass="marginr" Text="TopStart" ToolTip="这是提示信息" ToolTipType="Qtip" ToolTipPosition="TopStart" Width="100"></f:Button>
                    <f:Button CssClass="marginr" Text="Top" ToolTip="这是提示信息" ToolTipType="Qtip" ToolTipPosition="Top" Width="100"></f:Button>
                    <f:Button Text="TopEnd" ToolTip="这是提示信息" ToolTipType="Qtip" ToolTipPosition="TopEnd" Width="100"></f:Button>
                </td>
                <td></td>
            </tr>
            <tr>
                <td style="text-align: right;">
                    <f:Button Text="LeftStart" _ToolTipRawHtml="这是提示信息<br>这是第二行提示信息" ToolTipType="Qtip" ToolTipPosition="LeftStart" Width="100"></f:Button>
                </td>
                <td></td>
                <td style="text-align: left;">
                    <f:Button Text="RightStart" _ToolTipRawHtml="这是提示信息<br>这是第二行提示信息" ToolTipType="Qtip" ToolTipPosition="RightStart" Width="100"></f:Button>
                </td>
            </tr>
            <tr>
                <td style="text-align: right;">
                    <f:Button Text="Left" _ToolTipRawHtml="这是提示信息<br>这是第二行提示信息" ToolTipType="Qtip" ToolTipPosition="Left" Width="100"></f:Button>
                </td>
                <td></td>
                <td style="text-align: left;">
                    <f:Button Text="Right" _ToolTipRawHtml="这是提示信息<br>这是第二行提示信息" ToolTipType="Qtip" ToolTipPosition="Right" Width="100"></f:Button>
                </td>
            </tr>
            <tr>
                <td style="text-align: right;">
                    <f:Button Text="LeftEnd" _ToolTipRawHtml="这是提示信息<br>这是第二行提示信息" ToolTipType="Qtip" ToolTipPosition="LeftEnd" Width="100"></f:Button>
                </td>
                <td></td>
                <td style="text-align: left;">
                    <f:Button Text="RightEnd" _ToolTipRawHtml="这是提示信息<br>这是第二行提示信息" ToolTipType="Qtip" ToolTipPosition="RightEnd" Width="100"></f:Button>
                </td>
            </tr>
            <tr>
                <td></td>
                <td style="text-align: center;">
                    <f:Button CssClass="marginr" Text="BottomStart" ToolTip="这是提示信息" ToolTipType="Qtip" ToolTipPosition="BottomStart" Width="100"></f:Button>
                    <f:Button CssClass="marginr" Text="Bottom" ToolTip="这是提示信息" ToolTipType="Qtip" ToolTipPosition="Bottom" Width="100"></f:Button>
                    <f:Button Text="BottomEnd" ToolTip="这是提示信息" ToolTipType="Qtip" ToolTipPosition="BottomEnd" Width="100"></f:Button>
                </td>
                <td></td>
            </tr>
        </table>
    </div>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示提示框在控件上、下、左、右及各方向起止位置的排列。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对比提示位置和多行内容</h3>
        <ul>
            <li>
                分别悬停 Top、Bottom、Left、Right 等按钮。<br />
                结果：提示出现在按钮文字指定的相对方向，Start、End 控制沿该方向的对齐位置。
            </li>
            <li>
                悬停左右方向的按钮。<br />
                结果：提示中显示两行文字，换行由本页固定 HTML 内容提供。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ToolTipPosition</code>：使用 TopStart、Top、TopEnd、Bottom 及左右方向的对应位置。</li>
        </ul>
    </section>
}
