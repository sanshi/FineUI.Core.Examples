@page
@model FineUI.Core.Examples.Pages.Form.FormValidateValidatorModel
@{
    ViewBag.Title = "Form/FormValidateValidator";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" Title="用户注册表单">
        <Items>
            <f:TextBox ID="tbxUserName" Label="用户名" Required="true" NextFocusControl="tbxPassword" ShowRedStar="true" Text="admin">
            </f:TextBox>
            <f:TextBox ID="tbxPassword" Label="密码" Required="true" ShowRedStar="true" NextFocusControl="btnRegister" TextMode="Password" ValidatorFunction="passwordValidator">
            </f:TextBox>
            <f:Button ID="btnRegister" Text="注册" _ValidateForms="SimpleForm1" ValidateTarget="Top" OnClick="btnRegister_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br>
    <br>
    注：
    <ul>
        <li>
            提交表单时客户端验证[密码]必须为 6 个字符，否则标记为无效。
        </li>
    </ul>


}

@section script {

    <script>
        function passwordValidator() {
            var value = this.getValue();
            if (value.length === 6) {
                return true;
            } else {
                return '密码必须为 6 个字符！';
            }
        }
    </script>

}