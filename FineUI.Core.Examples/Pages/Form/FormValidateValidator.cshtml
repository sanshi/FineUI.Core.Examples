@page
@model FineUI.Core.Examples.Pages.Form.FormValidateValidatorModel
@{
    ViewBag.Title = "Form/FormValidateValidator";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" Title="用户注册表单">
        <Items>
            <f:TextBox ID="tbxUserName" Label="用户名" Required="true" NextFocusControl="tbxPassword" ShowRedStar="true" Text="admin">
            </f:TextBox>
            <f:TextBox ID="tbxPassword" Label="密码" Required="true" ShowRedStar="true" NextClickControl="btnRegister" TextMode="Password" ValidatorFunction="passwordValidator">
            </f:TextBox>
            <f:Button ID="btnRegister" Text="注册" _ValidateForms="SimpleForm1" ValidateTarget="Top" OnClick="btnRegister_Click"></f:Button>
        </Items>
    </f:SimpleForm>



}

@section script {

    <script>
        function passwordValidator() {
            var value = this.getValue();
            if (value.length === 6) {
                return true;
            } else {
                return '密码必须为 6 个字符！';
            }
        }
    </script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示用客户端自定义验证函数检查密码长度，要求恰好输入 6 个字符。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>执行自定义验证</h3>
        <ol>
            <li>
                用户名保持有值，密码输入“123”，点击“注册”。<br />
                结果：密码框显示“密码必须为 6 个字符！”，浏览器阻止回发。
            </li>
            <li>
                关闭验证提示，将密码改为“123456”，再次点击“注册”。<br />
                结果：长度检查通过后才回发，后台显示当前用户名和密码。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ValidatorFunction</code>：指定 passwordValidator；函数读取当前密码，符合条件返回 true，否则返回错误文字。</li>
            <li><code>Required</code>：密码框设为 true，空值仍按必填规则检查。</li>
            <li><code>_ValidateForms</code>：注册按钮指定 SimpleForm1，包含必填和自定义验证，通过后才回发。</li>
        </ul>
    </section>
}
