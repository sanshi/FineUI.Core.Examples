@page
@model FineUI.Core.Examples.Pages.Form.FileUploadLoadingModel
@{
    ViewBag.Title = "Form/FileUploadLoading";
    var F = Html.F();
}

@section head {

    <style type="text/css">
        .result img {
            border: 1px solid #CCCCCC;
            max-width: 550px;
            padding: 3px;
        }
    </style>

}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="表单" ShowHeader="true">
        <Items>
            <f:TextBox Label="用户名" ID="tbxUserName" EmptyText="请输入用户名" Required="true" ShowRedStar="true">
            </f:TextBox>
            <f:FileUpload ID="filePhoto" EmptyText="请选择一张照片" Label="个人头像" Required="true" ButtonIcon="Add" ShowRedStar="true">
            </f:FileUpload>
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交" OnClickDelegate="@(e =>
                        {
                            e.Action = "btnSubmit_Click";
                            e.AjaxLoadingType = AjaxLoadingType.Mask;
                            e.ShowAjaxLoadingMaskText = true;
                            e.AjaxLoadingMaskText = "正在导入数据，请稍后...";
                        })"></f:Button>
        </Items>
    </f:SimpleForm>
    <f:Label ID="labResult" EncodeText="false" CssClass="result">
    </f:Label>
    <br>
    <br>
    <br />
    注：为了观察Ajax提示信息，提交按钮动作在后台都会睡眠 1 秒钟。

}

