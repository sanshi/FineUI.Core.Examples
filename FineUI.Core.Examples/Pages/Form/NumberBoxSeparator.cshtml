@page
@model FineUI.Core.Examples.Pages.Form.NumberBoxSeparatorModel
@{
    ViewBag.Title = "Form/NumberBoxSeparator";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" LabelAlign="Top" EnableCollapse="false" Title="简单表单" LabelWidth="120">
        <Items>
            <f:NumberBox Label="小数" ID="NumberBox1" Text="-123456789.2345" EnableCommas="true"
                         Required="true" ShowRedStar="true" DecimalPrecision="2" CommaSeparator="'" />
            <f:NumberBox Label="正整数" ID="NumberBox2" NoDecimal="true" NoNegative="true" Text="987654321" 
                         EnableCommas="true" ShowTrigger="false" CommaSeparator=" " />
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false"></f:Label>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示用单引号或空格代替默认逗号，分隔较长数字的千分位。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>修改后重新分组</h3>
        <ul>
            <li>
                在“小数”中输入 -123456.890，然后移开焦点。<br />
                结果：显示为 -123'456.89，按两位精度处理。
            </li>
            <li>
                在“正整数”中输入 98765432，然后移开焦点。<br />
                结果：显示为 98 765 432，使用空格分隔千分位。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableCommas</code>：设为 true，启用千分位格式。</li>
            <li><code>CommaSeparator</code>：小数字段设为单引号，整数字段设为空格。</li>
        </ul>
    </section>
}
