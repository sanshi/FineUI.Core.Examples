@page
@model FineUI.Core.Examples.Pages.Form.NumberBoxDecimalPrecisionModel
@{
    ViewBag.Title = "Form/NumberBoxDecimalPrecision";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" LabelAlign="Top" EnableCollapse="false" Title="简单表单" LabelWidth="120">
        <Items>
            <f:NumberBox ID="NumberBox1" EmptyText="精度为 2，比如 0.35" Label="0 到 1 之间的小数" Text="0.356"
                         MaxValue="1" MinValue="0" NoDecimal="false" NoNegative="true" DecimalPrecision="2" Required="true" ShowRedStar="true" Increment="0.01"
                         TrimEndZero="false">
            </f:NumberBox>
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
        </Items>
        <Toolbars>
            <f:Toolbar Position="Top">
                <Items>
                    <f:Button ID="Button1" Text="修改精度为 1" OnClick="Button1_Click"></f:Button>
                    <f:Button ID="Button2" Text="修改精度为 2" OnClick="Button2_Click"></f:Button>
                    <f:Button ID="Button3" Text="修改精度为 3" OnClick="Button3_Click"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:SimpleForm>
    <br />
    注：为数字输入框设置了TrimEndZero=false，所以不会去掉末尾的零（比如精度为3时，会显示0.360，而不是0.36）。
}

