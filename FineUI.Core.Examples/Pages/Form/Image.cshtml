@page
@model FineUI.Core.Examples.Pages.Form.ImageModel
@{
    ViewBag.Title = "Form/Image";
    var F = Html.F();
}


@section body {

    Icon="World"：
    <br />
    <f:Image ID="Image1" Icon="World">
    </f:Image>
    <br />
    ImageUrl="~/res/icon/world.png"：
    <br />
    <f:Image ID="Image2" ImageUrl="~/res/icon/world.png">
    </f:Image>
    <br />
    ImageUrl="~/res/images/logo/favicon.ico" ImageCssStyle="border:solid 1px #ccc;padding:5px;"：
    <br />
    <f:Image ID="Image3" ImageWidth="32" ImageHeight="32" ImageCssStyle="border:solid 1px #ccc;padding:5px;"
             ImageUrl="~/res/images/logo/favicon.ico">
    </f:Image>
    <br />
    <f:Button Text="改变图片的大小" ID="Button1" OnClick="Button1_Click"></f:Button>
}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示图片地址、边框样式和固定尺寸，以及点击按钮切换图片大小。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-pic" aria-hidden="true"></i>切换图片大小</h3>
        <ul>
            <li>
                对照地球图片和带边框的标志图片。<br />
                结果：图片来自内置资源或自定义地址，标志图片初始宽高为 <code>32</code> 像素。
            </li>
            <li>
                连续点击<strong class="example-control-reference" data-example-control="Button1" title="改变图片的大小">改变图片的大小</strong>。<br />
                结果：回发后，后台在 <code>32</code>×<code>32</code> 与 <code>64</code>×<code>64</code> 之间切换标志图片尺寸，图片地址保持不变。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ImageUrl</code>（<strong class="example-control-reference" data-example-control="Image2" title="第 2 个图片">第 2 个图片</strong>、<strong class="example-control-reference" data-example-control="Image3" title="第 3 个图片">第 3 个图片</strong>）：设置图片文件地址。</li>
            <li><code>ImageWidth</code>（<strong class="example-control-reference" data-example-control="Image3" title="第 3 个图片">第 3 个图片</strong>）：控制图片宽度，按钮在 <code>32</code> 和 <code>64</code> 之间切换。</li>
            <li><code>ImageHeight</code>（<strong class="example-control-reference" data-example-control="Image3" title="第 3 个图片">第 3 个图片</strong>）：与宽度同步改变，保持正方形。</li>
            <li><code>ImageCssStyle</code>（<strong class="example-control-reference" data-example-control="Image3" title="第 3 个图片">第 3 个图片</strong>）：为图片添加边框和内边距。</li>
        </ul>
    </section>
}
