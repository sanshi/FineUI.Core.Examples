@page
@model FineUI.Core.Examples.Pages.Form.CheckBoxListAutoColumnWidthModel
@{
    ViewBag.Title = "Form/CheckBoxListAutoColumnWidth";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" LabelWidth="160" BodyPadding="10" ShowBorder="true" ShowHeader="true" Title="简单表单">
        <Items>
            <f:CheckBoxList ID="CheckBoxList1" Label="列表一" AutoColumnWidth="true">
                <f:CheckItem Text="可选项 1" Value="value1" />
                <f:CheckItem Text="可选项 2" Value="value2" Selected="true" />
                <f:CheckItem Text="可选项 3" Value="value3" Selected="true" />
            </f:CheckBoxList>
            <f:Panel CssClass="f-field" ShowBorder="false" ShowHeader="false">
                <Items>
                    <f:Button ID="btnServerSetSelectedValue" CssClass="marginr" Text="选中上面列表中的第一项和第三项" OnClick="btnServerSetSelectedValue_Click"></f:Button>
                    <f:Button ID="btnServerGetSelectedValue" CssClass="marginr" Text="获取上面列表的选中项" OnClick="btnServerGetSelectedValue_Click"></f:Button>
                    <f:Button ID="btnClientGetSelectedValue" Text="获取上面列表的选中项（JavaScript 脚本）" ClickHandler="onAlertSelectedValueClick"></f:Button>
                </Items>
            </f:Panel>
            <f:Label></f:Label>
            <f:CheckBoxList ID="CheckBoxList2" Label="列表二（三列）" ColumnNumber="3" AutoColumnWidth="true">
            </f:CheckBoxList>
            <f:Label></f:Label>
            <f:CheckBoxList ID="CheckBoxList3" Label="列表三（选中项改变事件）" AutoColumnWidth="true" ColumnNumber="3" ShowRedStar="true" Required="true" OnSelectedIndexChanged="CheckBoxList3_SelectedIndexChanged">
                <f:CheckItem Text="可选项 1（很长的可选项）" Value="value1" />
                <f:CheckItem Text="可选项 2" Value="value2" />
                <f:CheckItem Text="可选项 3" Value="value3" />
                <f:CheckItem Text="可选项 4" Value="value4" />
                <f:CheckItem Text="可选项 5" Value="value5" />
                <f:CheckItem Text="可选项 6" Value="value6" />
                <f:CheckItem Text="可选项 7" Value="value7" />
                <f:CheckItem Text="可选项 8" Value="value8" />
            </f:CheckBoxList>
            <f:Label></f:Label>
            <f:CheckBoxList ID="CheckBoxList4" Label="列表四（竖排）" AutoColumnWidth="true" ColumnNumber="3" ColumnVertical="true" ShowRedStar="true" Required="true">
                <Items>
                    <f:CheckItem Text="可选项 1" Value="value1" />
                    <f:CheckItem Text="可选项 2" Value="value2" />
                    <f:CheckItem Text="可选项 3" Value="value3" />
                    <f:CheckItem Text="可选项 4" Value="value4" />
                    <f:CheckItem Text="可选项 5" Value="value5" />
                    <f:CheckItem Text="可选项 6" Value="value6" />
                    <f:CheckItem Text="可选项 7" Value="value7" />
                    <f:CheckItem Text="可选项 8" Value="value8" />
                </Items>

            </f:CheckBoxList>
        </Items>
        <Toolbars>
            <f:Toolbar Position="Bottom" ToolbarAlign="Right">
                <Items>
                    <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:SimpleForm>




}


@section script {
    <script type="text/javascript">

        function onAlertSelectedValueClick(event) {
            var list1 = F.ui.CheckBoxList1;

            var selectedValues = list1.getValue();
            if (selectedValues.length) {
                top.F.alert("列表一的选中项：" + selectedValues.join(','));
            } else {
                top.F.alert("列表一没有选中项！");
            }
        }


    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示按选项文字的实际长度自动分配列表列宽，避免长短选项按等宽排列。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>比较长短选项</h3>
        <ol>
            <li>
                对照列表中较长的第一项与较短的“可选项 2”。<br />
                结果：各项按自身文字宽度排布，长文字项比短文字项占用更大宽度。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：注意复选框列表中每一项的宽度不相同。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ColumnNumber</code>：决定列表分为几列。 本页“列表二（三列）”声明值为 3。</li>
            <li><code>AutoColumnWidth</code>：选项宽度按各项文字内容调整。 本页“列表一”声明值为 true。</li>
        </ul>
    </section>
}
