@page
@model FineUI.Core.Examples.Pages.Form.RadioButtonListAutoColumnWidthModel
@{
    ViewBag.Title = "Form/RadioButtonListAutoColumnWidth";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" LabelWidth="160" EnableCollapse="false" BodyPadding="10" ShowBorder="true" ShowHeader="true" Title="简单表单">
        <Items>
            <f:RadioButtonList ID="RadioButtonList1" Label="列表一" AutoColumnWidth="true">
                <f:RadioItem Text="可选项 1" Value="value1" />
                <f:RadioItem Text="可选项 2" Value="value2" />
                <f:RadioItem Text="可选项 3" Value="value3" />
            </f:RadioButtonList>
            <f:Button ID="btnServerSetSelectedValue" CssClass="marginr" Text="选中上面列表中的第一项" OnClick="btnServerSetSelectedValue_Click"></f:Button>
            <f:Button ID="btnServerGetSelectedValue" CssClass="marginr" Text="获取上面列表的选中项" OnClick="btnServerGetSelectedValue_Click"></f:Button>
            <f:Button ID="btnClientGetSelectedValue" Text="获取上面列表的选中项（JavaScript 脚本）" ClickHandler="onAlertSelectedValueClick"></f:Button>
            <f:Label>
            </f:Label>
            <f:RadioButtonList ID="RadioButtonList2" Label="列表二（三列）" ColumnNumber="3" AutoColumnWidth="true">
            </f:RadioButtonList>
            <f:Label>
            </f:Label>
            <f:RadioButtonList ID="rblAutoPostBack" Label="列表三（选中改变事件）" ColumnNumber="3" ShowRedStar="true" Required="true" AutoColumnWidth="true" OnSelectedIndexChanged="rblAutoPostBack_SelectedIndexChanged">
                <f:RadioItem Text="可选项 1（很长的可选项）" Value="value1" />
                <f:RadioItem Text="可选项 2" Value="value2" />
                <f:RadioItem Text="可选项 3" Value="value3" />
                <f:RadioItem Text="可选项 4" Value="value4" />
                <f:RadioItem Text="可选项 5" Value="value5" />
                <f:RadioItem Text="可选项 6" Value="value6" />
                <f:RadioItem Text="可选项 7" Value="value7" />
                <f:RadioItem Text="可选项 8" Value="value8" />
            </f:RadioButtonList>
            <f:Label>
            </f:Label>
            <f:RadioButtonList ID="CheckBoxList4" Label="列表四（竖排）" ColumnNumber="3" ColumnVertical="true" ShowRedStar="true" Required="true" AutoColumnWidth="true">
                <f:RadioItem Text="可选项 1" Value="value1" />
                <f:RadioItem Text="可选项 2" Value="value2" />
                <f:RadioItem Text="可选项 3" Value="value3" />
                <f:RadioItem Text="可选项 4" Value="value4" />
                <f:RadioItem Text="可选项 5" Value="value5" />
                <f:RadioItem Text="可选项 6" Value="value6" />
                <f:RadioItem Text="可选项 7" Value="value7" />
                <f:RadioItem Text="可选项 8" Value="value8" />
            </f:RadioButtonList>
        </Items>
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Position="Bottom" ToolbarAlign="Right">
                <Items>
                    <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:SimpleForm>

}


@section script {
    <script type="text/javascript">

        function onAlertSelectedValueClick(event) {
            var list1 = F.ui.RadioButtonList1;

            var checkedValue = list1.getValue();
            if (checkedValue) {
                top.F.alert("列表一的选中项：" + checkedValue);
            } else {
                top.F.alert("列表一没有选中项！");
            }
        }


    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示按选项文字的实际长度自动分配列表列宽，避免长短选项按等宽排列。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>比较长短选项</h3>
        <ol>
            <li>
                对照列表中较长的第一项与较短的“可选项 <code>2</code>”。<br />
                结果：各项按自身文字宽度排布，长文字项比短文字项占用更大宽度。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ColumnNumber</code>（<strong class="example-control-reference" data-example-control="RadioButtonList2" title="列表二（三列）">列表二（三列）</strong>）：决定列表分为几列。 本页<strong class="example-control-reference" data-example-control="RadioButtonList2" title="列表二（三列）">列表二（三列）</strong>声明值为 <code>3</code>。</li>
            <li><code>AutoColumnWidth</code>（<strong class="example-control-reference" data-example-control="RadioButtonList1" title="列表一">列表一</strong>）：选项宽度按各项文字内容调整。 本页<strong class="example-control-reference" data-example-control="RadioButtonList1" title="列表一">列表一</strong>声明值为 <code>true</code>。</li>
        </ul>
    </section>
}
