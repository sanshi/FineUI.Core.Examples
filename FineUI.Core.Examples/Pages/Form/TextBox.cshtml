@page
@model FineUI.Core.Examples.Pages.Form.TextBoxModel
@{
    ViewBag.Title = "Form/TextBox";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" Title="登录表单" ShowHeader="true">
        <Items>
            <f:TextBox Label="用户名" EmptyText="请输入用户名" ID="tbxUserName" Required="true" ShowRedStar="true">
            </f:TextBox>
            <f:TextBox ID="tbxPassword" Label="密码" EmptyText="请输入密码" TextMode="Password" Required="true" ShowRedStar="true">
            </f:TextBox>
            <f:Button ID="btnSubmit" CssClass="marginr" _ValidateForms="SimpleForm1" Text="登录" OnClick="btnSubmit_Click"></f:Button>
            <f:Button ID="btnReset" ClickHandler="onResetClick" Text="重置"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false" ShowLabel="false">
    </f:Label>
}

@section script {

    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }

    </script>
}
