@page
@model FineUI.Core.Examples.Pages.Form.DynamicEventRevocationModel
@{
    ViewBag.Title = "动态事件的条件撤回";
}

@section body {
    <f:CheckBox ID="cbxRevoke" Text="本轮撤回动态按钮事件" ShowLabel="false" />
    <br />
    <br />
    <f:Panel ID="Panel1" Title="首次加载时创建的动态按钮" ShowHeader="true" BodyPadding="10" />
    <br />
    <f:Button ID="btnReadCount" Text="读取服务器处理次数" OnClick="btnReadCount_Click" />
    <br />
    <br />
    <f:Label ID="labCount" Text="服务器处理次数：0" />
    <br />
    <br />
    <f:Label ID="labResult" Text="请先点击动态按钮，观察处理次数" />


}

@section script {
    <script>
        F.beforeAjaxError(function (data, textStatus, xhr) {
            // 勾选撤回时的 HTTP 400 是本例的预期结果，直接显示在页面；其他错误仍走默认提示。
            if (xhr.status === 400 && F.ui.cbxRevoke.getValue()) {
                F.ui.labResult.setText('事件已撤回，服务器拒绝本次请求（HTTP 400）；请读取服务器处理次数核对');
                return false;
            }
        });
    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示首次创建的动态按钮事件在条件满足时撤回，服务器拒绝请求且不执行按钮业务。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>撤回前后核对处理次数</h3>
        <ol>
            <li>
                点击“触发动态按钮事件”。<br />
                结果：下方显示事件已执行，服务器处理次数从0变为1。
            </li>
            <li>
                勾选“本轮撤回动态按钮事件”，再次点击动态按钮。<br />
                结果：服务器拒绝本次请求，页面显示 HTTP 400 的撤回提示。
            </li>
            <li>
                点击“读取服务器处理次数”。<br />
                结果：次数仍为1，证明拒绝请求没有执行动态按钮业务。
            </li>
            <li>
                取消勾选，再点击动态按钮。<br />
                结果：事件恢复可用，次数增加为2；复选框仅模拟条件，实际权限必须由服务器校验。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <ul>
            <li>动态按钮仅首次绑定事件，回发无需重复登记。</li>
            <li>勾选后每轮明确撤回事件，点击返回 HTTP 400；取消勾选后恢复。</li>
            <li>读取服务器处理次数，确认拒绝时次数不增加。计数保存在 Session 中，刷新本页重置。</li>
            <li>复选框仅模拟撤回条件，实际业务权限须由服务器判断并校验。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Events.Add()</code>：创建动态按钮时登记本页的后台事件。</li>
            <li><code>Events.Remove()</code>：本轮条件要求撤回时明确移除事件，不能仅省略重复登记。</li>
            <li><code>F.beforeAjaxError()</code>：识别本例预期的 HTTP 400，显示可读提示；处理次数另从服务器读取核对。</li>
        </ul>
    </section>
}
