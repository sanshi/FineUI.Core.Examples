@page
@model FineUI.Core.Examples.Pages.Form.FileUploadFileSelectedModel
@{
    ViewBag.Title = "Form/FileUploadFileSelected";
    var F = Html.F();
}

@section head {

    <style>
        .photo {
            height: 150px;
            line-height: 150px;
            overflow: hidden;
        }

            .photo img {
                height: 150px;
                vertical-align: middle;
            }
    </style>

}

@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="表单" ShowHeader="true">
        <Items>
            <f:Image ID="imgPhoto" CssClass="photo" ImageUrl="~/res/images/blank.png" ShowEmptyLabel="true">
            </f:Image>
            <f:FileUpload ID="filePhoto" ShowRedStar="false" ShowEmptyLabel="true" ButtonText="上传个人头像" ButtonOnly="true" Required="false" ButtonIcon="ImageAdd"
                OnFileSelected="filePhoto_FileSelected">
            </f:FileUpload>
            <f:TextBox Label="用户名" ID="tbxUserName" Required="true" ShowRedStar="true">
            </f:TextBox>
            <f:TextBox Label="邮箱" ID="tbxEmail" Required="true" RegexPattern="EMAIL" RegexMessage="请输入有效的邮箱地址" ShowRedStar="true">
            </f:TextBox>
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>
}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示选定文件后立即上传，无需等待整个表单提交。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-upload" aria-hidden="true"></i>先上传头像</h3>
        <ol>
            <li>
                点击<strong>上传个人头像</strong>，选择一张合格图片。<br />
                结果：文件选中事件立即回发；后台校验并保存图片，头像区域由空白图变为新头像，同时清空文件选择。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>OnFileSelected</code>（<strong class="example-control-reference" data-example-control="filePhoto"
                    title="上传控件">上传控件</strong>）：选定文件后立即请求后台处理。 本页声明值为 <code>filePhoto</code><code>_FileSelected</code>。</li>
        </ul>
    </section>
}
