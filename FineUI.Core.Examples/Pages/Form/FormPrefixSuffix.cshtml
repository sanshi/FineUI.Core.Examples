@page
@model FineUI.Core.Examples.Pages.Form.FormPrefixSuffixModel
@{
    ViewBag.Title = "Form/FormPrefixSuffix";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" LabelAlign="Right" Title="简单表单">
        <Items>
            <f:NumberBox Label="人民币金额" ID="NumberBox2" NoDecimal="true" NoNegative="true" Required="true" EnableSuffix="true" Suffix="万元" />
            <f:NumberBox Label="美元金额" ID="NumberBox6" NoDecimal="true" NoNegative="true" Required="true" EnablePrefix="true" Prefix="$" />
            <f:TextBox Label="文本输入框" ID="TextBox1" Required="true" EnablePrefix="true" Prefix="前缀" EnableSuffix="true" Suffix="后缀" />
            <f:DropDownList ID="DropDownList1" Label="下拉列表" EnablePrefix="true" Prefix="前缀" EnableSuffix="true" Suffix="后缀" AutoSelectFirstItem="false" Required="true">
                <f:ListItem Text="可选项1" Value="Value1" />
                <f:ListItem Text="可选项2" Value="Value2" />
                <f:ListItem Text="可选项3" Value="Value3" />
            </f:DropDownList>
            <f:FileUpload ID="filePhoto" EmptyText="请选择一张照片" Label="个人头像" Required="true" ButtonIcon="Add" ShowRedStar="true" EnableSuffix="true" Suffix="后缀">
            </f:FileUpload>
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
        </Items>
    </f:SimpleForm>

}

