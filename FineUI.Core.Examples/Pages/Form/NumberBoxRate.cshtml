@page
@model FineUI.Core.Examples.Pages.Form.NumberBoxRateModel
@{
    ViewBag.Title = "Form/NumberBoxRate";
    var F = Html.F();
}


@section body {

    <f:NumberBox ID="NumberBox1" DisplayType="Rate" Text="3">
    </f:NumberBox>
    <br />
    <br />
    半星评分：
    <br />
    <f:NumberBox ID="NumberBox2" DisplayType="Rate" Text="3.5" RateAllowHalf="true">
    </f:NumberBox>
    <br />
    <br />
    只读：
    <br />
    <f:NumberBox ID="NumberBox3" DisplayType="Rate" Text="2" Readonly="true">
    </f:NumberBox>
    <br />
    <br />
    禁用点击清除：
    <br />
    <f:NumberBox ID="NumberBox4" DisplayType="Rate" Text="3" RateAllowClear="false">
    </f:NumberBox>
    <br />
    <br />
    自定义字符、图标、个数：
    <br />
    <f:NumberBox ID="NumberBox5" DisplayType="Rate" Text="3" RateCharacter="A">
    </f:NumberBox>
    <br />
    <f:NumberBox ID="NumberBox6" DisplayType="Rate" Text="4" RateCharacter="好">
    </f:NumberBox>
    <br />
    <f:NumberBox ID="NumberBox7" DisplayType="Rate" Text="5" RateIconFont="_SmileO" RateCount="10">
    </f:NumberBox>
    <br />
    <f:NumberBox ID="NumberBox8" DisplayType="Rate" Text="6" RateIconFont="_ThumbsUp" RateCount="10">
    </f:NumberBox>
    <br />
    <f:NumberBox ID="NumberBox9" DisplayType="Rate" Text="7" RateIconFont="_Heart" RateCount="10">
    </f:NumberBox>
    <br />
    <br />
    评分文本：
    <br />
    <f:NumberBox ID="NumberBox10" DisplayType="Rate" Text="3" RateTextVisible="true" RateTextRendererFunction="renderNumberBox10">
    </f:NumberBox>
    <br />
    <f:NumberBox ID="NumberBox11" DisplayType="Rate" Text="3.5" RateAllowHalf="true" RateTextVisible="true">
    </f:NumberBox>
    <br />
    <br />
    后台更新：
    <br />
    <f:NumberBox ID="NumberBox12" DisplayType="Rate" Text="3">
    </f:NumberBox>
    <br />
    <f:Button ID="Button1" Text="更新" OnClick="Button1_Click"></f:Button>
    <br />

}


@section script {

    <script>
        var desc = ['terrible', 'bad', 'normal', 'good', 'wonderful'];

        function renderNumberBox10(val) {
            var rateText = 'not yet rated';
            if (val > 0) {
                rateText = desc[val - 1];
            }
            return rateText;
        }
    </script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示星级评分、半星、只读、自定义字符和评分文字，并更新当前分值。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-star" aria-hidden="true"></i>选择评分与只读对照</h3>
        <ul>
            <li>
                在<strong class="example-control-reference" data-example-control="NumberBox1" title="第 1 组评分">第一组评分</strong>点击第 <code>5</code> 颗星。<br />
                结果：评分改为 <code>5</code>，五颗星都点亮。
            </li>
            <li>
                对照<strong class="example-control-reference" data-example-control="NumberBox2" title="第 2 组评分">第二组半星评分</strong>，并尝试点击<strong class="example-control-reference" data-example-control="NumberBox3" title="第 3 组评分">第三组只读评分</strong>。<br />
                结果：第二组显示 <code>3.5</code> 的半星；第三组仍保持 <code>2</code>，不接受点击修改。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>更新评分并显示文字</h3>
        <ul>
            <li>
                点击最下方<strong class="example-control-reference" data-example-control="Button1" title="更新">更新</strong>。<br />
                结果：回发后，后台将最后一组评分加 <code>1</code>，超过 <code>5</code> 后回到 <code>0</code>。
            </li>
            <li>
                对照字母、汉字、笑脸等评分与带文字评分。<br />
                结果：评分可使用自定义字符或图标，带文字评分显示数值或自定义描述，例如初始 <code>3</code> 分显示 <code>normal</code>。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DisplayType</code>（本页全部评分控件，如<strong class="example-control-reference" data-example-control="NumberBox1" title="第 1 组评分">第 1 组评分</strong>）：设为 <code>Rate</code>，显示评分。</li>
            <li><code>RateAllowHalf</code>（<strong class="example-control-reference" data-example-control="NumberBox2" title="第 2 组评分">第 2 组评分</strong>、<strong class="example-control-reference" data-example-control="NumberBox11" title="第 11 组评分">第 11 组评分</strong>）：设为 <code>true</code> 时支持半分。</li>
            <li><code>Readonly</code>（<strong class="example-control-reference" data-example-control="NumberBox3" title="第 3 组评分">第 3 组评分</strong>）：为 <code>true</code> 时保持显示但不能点击修改。</li>
            <li><code>RateCount</code>（<strong class="example-control-reference" data-example-control="NumberBox7" title="第 7 组评分">第 7 组评分</strong>、<strong class="example-control-reference" data-example-control="NumberBox8" title="第 8 组评分">第 8 组评分</strong>、<strong class="example-control-reference" data-example-control="NumberBox9" title="第 9 组评分">第 9 组评分</strong>）：控制评分项数，本页包含 <code>10</code> 项图标评分。</li>
            <li><code>RateAllowClear</code>（<strong class="example-control-reference" data-example-control="NumberBox4" title="第 4 组评分">第 4 组评分</strong>）：为 <code>false</code> 时再次点击当前值不能清空。</li>
            <li><code>RateTextRendererFunction</code>（<strong class="example-control-reference" data-example-control="NumberBox10" title="第 10 组评分">第 10 组评分</strong>）：把评分值转换为 <code>normal</code> 等说明文字。</li>
        </ul>
    </section>
}
