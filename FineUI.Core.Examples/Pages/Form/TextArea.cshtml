@page
@model FineUI.Core.Examples.Pages.Form.TextAreaModel
@{
    ViewBag.Title = "Form/TextArea";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" Title="简单表单" LabelAlign="Top" ShowHeader="true">
        <Items>
            <f:TextArea ID="TextArea1" EmptyText="文本框的高度会自动扩展" Label="自动扩展高度的文本输入框" AutoGrowHeight="true" AutoGrowHeightMin="100" AutoGrowHeightMax="600">
            </f:TextArea>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示<strong class="example-control-reference" data-example-control="TextArea1" title="自动扩展高度的文本输入框">多行文本框</strong>随内容增减自动调整高度，并将高度限制在 <code>100</code>
            到 <code>600</code> 像素之间。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>随内容调整高度</h3>
        <ol>
            <li>
                选中并删除文本框中的全部内容。<br />
                结果：输入框缩小到最小高度 <code>100</code> 像素。
            </li>
            <li>
                连续输入或粘贴多行文字。<br />
                结果：输入框逐渐增高，达到 <code>600</code> 像素后不再增高，更多内容可在框内滚动阅读。
            </li>
            <li>
                再次删除部分文字。<br />
                结果：输入框随内容减少而降低；所有高度调整都在浏览器完成，无需回发。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>AutoGrowHeight</code>（<strong class="example-control-reference" data-example-control="TextArea1"
                    title="自动扩展高度的文本输入框">自动扩展高度的文本输入框</strong>）：初始为 <code>true</code>，按内容自动调整高度。</li>
            <li><code>AutoGrowHeightMin</code>（<strong class="example-control-reference" data-example-control="TextArea1"
                    title="自动扩展高度的文本输入框">自动扩展高度的文本输入框</strong>）：初始为 <code>100</code>，内容很少时也保留此高度。</li>
            <li><code>AutoGrowHeightMax</code>（<strong class="example-control-reference" data-example-control="TextArea1"
                    title="自动扩展高度的文本输入框">自动扩展高度的文本输入框</strong>）：初始为 <code>600</code>，内容较多时不再继续增高。</li>
        </ul>
    </section>
}
