@page
@model FineUI.Core.Examples.Pages.Form.TriggerBoxIconUrlModel
@{
    ViewBag.Title = "Form/TriggerBoxIconUrl";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" Title="表单" ShowHeader="true" LabelWidth="150">
        <Items>
            <f:TriggerBox ID="TriggerBox1" Label="TriggerBox" TriggerIconUrl="~/res/icon/application_edit.png" EmptyText="打开弹出窗口">
                <Listeners>
                    <f:Listener Event="triggerclick" Handler="onTriggerBox1TriggerClick"></f:Listener>
                </Listeners>
            </f:TriggerBox>
            <f:TwinTriggerBox ID="TwinTriggerBox1" Label="TwinTriggerBox" OnTrigger1Click="TwinTriggerBox1_Trigger1Click" OnTrigger2Click="TwinTriggerBox1_Trigger2Click" 
                ShowTrigger1="false" EmptyText="搜索用户名" Trigger1IconUrl="~/res/icon/bullet_cross.png" Trigger2IconUrl="~/res/icon/zoom.png">
            </f:TwinTriggerBox>
        </Items>
    </f:SimpleForm>

    <f:Window ID="Window1" Title="弹出窗口" BodyPadding="10" IsModal="true" Hidden="true" Target="Top" Width="450" Height="300">
        <Items>
            <f:Button ID="btnCloseWindow" Text="关闭当前窗口" OnClick="btnCloseWindow_Click"></f:Button>
        </Items>
    </f:Window>

}

@section script {
    <script>

        function onTriggerBox1TriggerClick(event) {
            F.ui.Window1.show();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示给单触发器和双触发器指定自定义图片图标。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照自定义图标</h3>
        <ol>
            <li>
                对照单触发器图片；在第二个输入框输入关键词并点击搜索，查看显示的取消图标。<br />
                结果：单触发器、搜索和取消使用本页指定的图片，原有触发动作继续可用。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>TriggerIconUrl</code>：单触发器使用 application_edit.png。</li>
            <li><code>Trigger1IconUrl</code>：第一个图标使用 bullet_cross.png。</li>
            <li><code>Trigger2IconUrl</code>：第二个图标使用 zoom.png。</li>
        </ul>
    </section>
}
