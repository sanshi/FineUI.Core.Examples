@page
@model FineUI.Core.Examples.Pages.Form.FileUploadDragDropModel
@{
    ViewBag.Title = "Form/FileUploadDragDrop";
}

@section body {
    <f:SimpleForm ID="SimpleForm1" IsFluid="true" MaxWidth="620" BodyPadding="10" LabelAlign="Top" Title="拖放上传图片">
        <Items>
            <f:FileUpload ID="filePhoto" Label="单张图片" EmptyText="尚未选择图片" ButtonText="选择图片"
                AnchorValue="100%" EnableDragDrop="true" AcceptFileTypes=".jpg,.jpeg,.png,.gif"></f:FileUpload>
            <f:FileUpload ID="filePhotos" Label="多张图片" EmptyText="尚未选择图片" ButtonText="选择图片"
                AnchorValue="100%" EnableDragDrop="true" Multiple="true" AcceptFileTypes=".jpg,.jpeg,.png,.gif"></f:FileUpload>
            <f:Button ID="btnSubmit" Text="提交文件" OnClick="btnSubmit_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <f:Label ID="labResult"></f:Label>
    <p>从电脑拖入 JPG、JPEG、PNG 或 GIF 图片，也可以点击「选择图片」。每次选择会替换该区域中上一次选择的图片。</p>
    <p>点击「提交文件」后，服务器校验文件并回显文件名。</p>
}
