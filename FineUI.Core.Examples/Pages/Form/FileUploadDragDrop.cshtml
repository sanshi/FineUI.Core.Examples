@page
@model FineUI.Core.Examples.Pages.Form.FileUploadDragDropModel
@{
    ViewBag.Title = "Form/FileUploadDragDrop";
}

@section body {
    <f:SimpleForm ID="SimpleForm1" IsFluid="true" MaxWidth="620" BodyPadding="10" LabelAlign="Top" Title="拖放上传图片">
        <Items>
            <f:FileUpload ID="filePhoto" Label="单张图片"
                EnableDragDrop="true" AcceptFileTypes=".jpg,.jpeg,.png,.gif"></f:FileUpload>
            <f:FileUpload ID="filePhotos" Label="多张图片"
                EnableDragDrop="true" Multiple="true" AcceptFileTypes=".jpg,.jpeg,.png,.gif"></f:FileUpload>
            <f:Button ID="btnSubmit" Text="提交文件" OnClick="btnSubmit_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <f:Label ID="labPhotoResult"></f:Label>
    <f:Label ID="labPhotosResult"></f:Label>
    <p>拖入 JPG、JPEG、PNG 或 GIF 图片，也可以点击拖放区选择。每次选择会替换该区域中上一次选择的图片，提交前可逐项移除。</p>
    <p>点击「提交文件」后，服务器按字段分别校验并回显文件名。</p>
}
