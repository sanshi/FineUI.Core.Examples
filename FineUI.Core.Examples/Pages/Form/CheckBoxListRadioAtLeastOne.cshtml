@page
@model FineUI.Core.Examples.Pages.Form.CheckBoxListRadioAtLeastOneModel
@{
    ViewBag.Title = "Form/CheckBoxListRadioAtLeastOne";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true"  BodyPadding="10" ShowBorder="true" ShowHeader="true" Title="复选框列表（至少选中一项）">
        <Items>
            <f:CheckBoxList ID="CheckBoxList1" ColumnNumber="2" Label="列表一" >
                <Items>
                    <f:CheckItem Text="可选项 1" Value="value1" />
                    <f:CheckItem Text="可选项 2" Value="value2" Selected="true" />
                    <f:CheckItem Text="可选项 3" Value="value3" />
                    <f:CheckItem Text="可选项 4" Value="value4" />
                    <f:CheckItem Text="可选项 5" Value="value5" />
                    <f:CheckItem Text="可选项 6" Value="value6" />
                </Items>
                <Listeners>
                    <f:Listener Event="change" Handler="onCheckBoxListChange" />
                </Listeners>
            </f:CheckBoxList>
        </Items>
    </f:SimpleForm>

}


@section script {

    <script>

        // 同时只能选中一项
        function onCheckBoxListChange(event, checkbox, isChecked) {
            var me = this;

            // 当前操作是：取消选中
            if (!isChecked) {
                // 如果一项都没选中，则本次取消操作无效
                if (!me.getValue().length) {
                    // 重新选中本项
                    me.setValue(checkbox.getInputValue());
                }
            }

            // 触发后台事件
            F.customEvent('CheckBoxList1_Change');
        }


    </script>

}
