@page
@model FineUI.Core.Examples.Pages.Form.TriggerBoxClearIconModel
@{
    ViewBag.Title = "Form/TriggerBoxClearIcon";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="表单" ShowHeader="true">
        <Items>
            <f:TriggerBox ID="TriggerBox1" ShowLabel="false" Text="默认值" TriggerIcon="Clear" AutoShowClearIcon="true">
            </f:TriggerBox>
            <f:TwinTriggerBox ID="TwinTriggerBox1" ShowLabel="false" Text="默认值" Trigger1Icon="Clear" Trigger2Icon="Search"
                             AutoShowClearIcon="true" OnTrigger2Click="TwinTriggerBox1_Trigger2Click"></f:TwinTriggerBox>
            <f:CheckBox ID="cbxAutoClear" ShowLabel="false" Text="根据文字自动显示清除图标" Checked="true"></f:CheckBox>
            <f:CheckBox ID="cbxShowTrigger" ShowLabel="false" Text="手动显示两个输入框的第一个按钮" Checked="true" Enabled="false"></f:CheckBox>
            <f:CheckBox ID="cbxShowTrigger1" ShowLabel="false" Text="双触发器的第一个按钮手动开关" Checked="true" Enabled="false"></f:CheckBox>
            <f:CheckBox ID="cbxShowTrigger2" ShowLabel="false" Text="显示双触发器的第二个按钮" Checked="true"></f:CheckBox>
            <f:Panel ShowBorder="false" ShowHeader="false" Layout="HBox">
                <Items>
                    <f:Button ID="btnApplyVisibility" Text="应用显隐设置" CssClass="marginr" OnClick="btnApplyVisibility_Click"></f:Button>
                    <f:Button ID="btnReadVisibility" Text="读取当前状态" CssClass="marginr" OnClick="btnReadVisibility_Click"></f:Button>
                    <f:Button ID="btnFillText" Text="填入文字" CssClass="marginr" OnClick="btnFillText_Click"></f:Button>
                    <f:Button ID="btnClearText" Text="清空文字" OnClick="btnClearText_Click"></f:Button>
                </Items>
            </f:Panel>
            <f:Label ID="labVisibility" ShowLabel="false"></f:Label>
            <f:Label ID="labTriggerResult" ShowLabel="false"></f:Label>
            <f:Button ID="btnSubmit" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <p>开启自动清除时，有文字显示第一个清除图标，空文本隐藏；无需同时设置ShowTrigger或ShowTrigger1。</p>
    <p>取消自动清除并点击“应用显隐设置”后，可使用手动开关。自动模式保留这些手动值，关闭后恢复；第二个按钮始终独立。</p>
    <p>“读取当前状态”只读取上一轮保留的属性和文字；“填入文字”和“清空文字”演示后台改变文本后立即更新图标。</p>

}

