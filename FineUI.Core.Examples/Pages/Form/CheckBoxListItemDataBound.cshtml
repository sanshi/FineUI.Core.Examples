@page
@model FineUI.Core.Examples.Pages.Form.CheckBoxListItemDataBoundModel
@{
    ViewBag.Title = "Form/CheckBoxListItemDataBound";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" LabelWidth="160" BodyPadding="10" ShowBorder="true" ShowHeader="true" Title="简单表单">
        <Items>
            <f:CheckBoxList ID="CheckBoxList1" Label="列表一">
                <f:CheckItem Text="可选项 1" Value="value1" />
                <f:CheckItem Text="可选项 2" Value="value2" Selected="true" />
                <f:CheckItem Text="可选项 3" Value="value3" Selected="true" />
            </f:CheckBoxList>
            <f:CheckBoxList ID="CheckBoxList2" Label="列表二（一列）" ColumnNumber="1" OnItemDataBound="CheckBoxList2_ItemDataBound">
            </f:CheckBoxList>
        </Items>
        <Toolbars>
            <f:Toolbar Position="Bottom" ToolbarAlign="Right">
                <Items>
                    <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:SimpleForm>


}



@section exampleDescription {
    <section aria-label="页面描述">
        <p>为声明的列表项和数据绑定产生的列表项分别设置悬停提示。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>查看每个选项的提示</h3>
        <ol>
            <li>
                将鼠标移到<strong class="example-control-reference" data-example-control="CheckBoxList1" title="列表一">列表一</strong>的“可选项 <code>1</code>”。<br />
                结果：显示“这是第一个选项的提示信息”。
            </li>
            <li>
                将鼠标移到<strong class="example-control-reference" data-example-control="CheckBoxList2" title="列表二（一列）">列表二</strong>的“数据绑定值 <code>1</code>”。<br />
                结果：该数据项的提示显示“数据绑定值 <code>1</code>（值：<code>item1</code>）”；本页在数据绑定事件中为每项补充提示。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：通过列表项绑定事件，可以动态设置每一项的属性（本例为每个列表项增加提示信息）。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Attributes[&quot;data-qtip&quot;]</code>（<strong class="example-control-reference" data-example-control="CheckBoxList1"
                    title="列表一">列表一</strong>、<strong class="example-control-reference" data-example-control="CheckBoxList2"
                    title="列表二（一列）">列表二（一列）</strong>）：给选项写入悬停提示文字；按选项索引设置固定提示，数据项提示按当前项的文字和值生成。</li>
            <li><code>OnItemDataBound</code>（<strong class="example-control-reference" data-example-control="CheckBoxList2"
                    title="列表二（一列）">列表二（一列）</strong>）：每个数据项绑定时补充对应选项的提示。 本页<strong class="example-control-reference" data-example-control="CheckBoxList2"
                    title="列表二（一列）">列表二（一列）</strong>声明值为 <code>CheckBoxList2</code><code>_ItemDataBound</code>。</li>
        </ul>
    </section>
}
