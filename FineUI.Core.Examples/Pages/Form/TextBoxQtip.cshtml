@page
@model FineUI.Core.Examples.Pages.Form.TextBoxQtipModel
@{
    ViewBag.Title = "Form/TextBoxQtip";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" Title="登录表单" ShowHeader="true" LabelAlign="Right">
        <Items>
            <f:TextBox Label="用户名" EmptyText="请输入用户名" ID="tbxUserName" Required="true" ShowRedStar="true">
                <Attributes>
                    <f:Attribute Key="data-qtitle" Value="用户名"></f:Attribute>
                    <f:Attribute Key="data-qtip" Value="通过Attributes属性设置的提示信息，鼠标移动到标签和输入框都会提示"></f:Attribute>
                </Attributes>
            </f:TextBox>
            <f:TextBox ID="tbxPassword" Label="密码" EmptyText="请输入密码" TextMode="Password" Required="true" ShowRedStar="true">
            </f:TextBox>
            <f:Button ID="btnSubmit" CssClass="marginr" OnClick="btnSubmit_Click" _ValidateForms="SimpleForm1" Text="登录"></f:Button>
            <f:Button ID="btnReset" ClickHandler="onResetClick" Text="重置"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false" ShowLabel="false">
    </f:Label>




}


@section script {

    <script>

        F.ready(function () {

            F.ui.tbxPassword.el.find('.f-field-fieldlabel').attr({
                'data-qtitle': '密码',
                'data-qtip': '通过 JavaScript 设置的提示信息，鼠标移动到标签时才会提示'
            });

        });

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }

    </script>
}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示给整个输入字段和仅给字段标签添加提示信息，两种提示范围不同。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>比较提示触发范围</h3>
        <ul>
            <li>
                分别悬停到<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>的标签和输入区域。<br />
                结果：两个位置都会显示通过 <code>Attributes</code> 配置的<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>提示。
            </li>
            <li>
                分别悬停到<strong class="example-control-reference" data-example-control="tbxPassword" title="密码">密码</strong>的标签和输入区域。<br />
                结果：只有标签显示通过 JavaScript 设置的密码提示，输入区域不触发该提示。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <ul>
            <li>【<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>】的提示信息，在鼠标移动到标签和输入框时都会显示</li>
            <li>【密码】的提示信息，仅在鼠标移动到标签时才会显示</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Attributes</code>（<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>、<strong class="example-control-reference" data-example-control="tbxPassword" title="密码">密码</strong>）：在<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>字段容器设置 <code>data</code>-<code>qtitle</code> 和 <code>data</code>-<code>qtip</code>。</li>
            <li><code>data-qtitle</code>（<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>、<strong class="example-control-reference" data-example-control="tbxPassword" title="密码">密码</strong>）：提示标题，本页分别为<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>、密码。</li>
            <li><code>data-qtip</code>（<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>、<strong class="example-control-reference" data-example-control="tbxPassword" title="密码">密码</strong>）：提示正文；给密码仅设置到标签元素上。</li>
        </ul>
    </section>
}
