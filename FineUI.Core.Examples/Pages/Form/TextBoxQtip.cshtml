@page
@model FineUI.Core.Examples.Pages.Form.TextBoxQtipModel
@{
    ViewBag.Title = "Form/TextBoxQtip";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" Title="登录表单" ShowHeader="true" LabelAlign="Right">
        <Items>
            <f:TextBox Label="用户名" EmptyText="请输入用户名" ID="tbxUserName" Required="true" ShowRedStar="true">
                <Attributes>
                    <f:Attribute Key="data-qtitle" Value="用户名"></f:Attribute>
                    <f:Attribute Key="data-qtip" Value="通过Attributes属性设置的提示信息，鼠标移动到标签和输入框都会提示"></f:Attribute>
                </Attributes>
            </f:TextBox>
            <f:TextBox ID="tbxPassword" Label="密码" EmptyText="请输入密码" TextMode="Password" Required="true" ShowRedStar="true">
            </f:TextBox>
            <f:Button ID="btnSubmit" CssClass="marginr" OnClick="btnSubmit_Click" _ValidateForms="SimpleForm1" Text="登录"></f:Button>
            <f:Button ID="btnReset" ClickHandler="onResetClick" Text="重置"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false" ShowLabel="false">
    </f:Label>
    <br>
    <ul>
        <li>【用户名】的提示信息，在鼠标移动到标签和输入框时都会显示</li>
        <li>【密码】的提示信息，仅在鼠标移动到标签时才会显示</li>
    </ul>


}


@section script {

    <script>

        F.ready(function () {

            F.ui.tbxPassword.el.find('.f-field-fieldlabel').attr({
                'data-qtitle': '密码',
                'data-qtip': '通过 JavaScript 设置的提示信息，鼠标移动到标签时才会提示'
            });

        });

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }

    </script>
}