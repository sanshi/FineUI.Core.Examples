@page
@model FineUI.Core.Examples.Pages.Form.FileUploadToolModel
@{
    ViewBag.Title = "Form/FileUploadTool";
    var F = Html.F();
}

@section head {

    <style>
        .photo {
            height: 150px;
            line-height: 150px;
            overflow: hidden;
        }

            .photo img {
                height: 150px;
                vertical-align: middle;
            }
    </style>

}

@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" ShowBorder="true" Title="表单" ShowHeader="true">
        <Items>
            <f:Image ID="imgPhoto" CssClass="photo" ImageUrl="~/res/images/blank.png" ShowEmptyLabel="true">
            </f:Image>
            <f:TextBox Label="用户名" ID="tbxUserName" Required="true" ShowRedStar="true">
            </f:TextBox>
            <f:TextBox Label="邮箱" ID="tbxEmail" Required="true" RegexPattern="EMAIL" RegexMessage="请输入有效的邮箱地址" ShowRedStar="true">
            </f:TextBox>
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
        </Items>
        <Tools>
            <f:Tool IconFont="_Upload" Text="上传头像" ClickHandler="onUploadClick"></f:Tool>
        </Tools>
    </f:SimpleForm>
    <br />
    <f:Label ID="labResult" EncodeText="false">
    </f:Label>
    <f:FileUpload ID="filePhoto" Hidden="true" OnFileSelected="filePhoto_FileSelected">
    </f:FileUpload>
}


@section script {

    <script>

        function onUploadClick(event) {
            F.ui.filePhoto.el.find('.f-field-fileupload-fileinput').click();
        }

    </script>

}

