@page
@model FineUI.Core.Examples.Pages.Form.HtmlEditorModel
@{
    ViewBag.Title = "Form/HtmlEditor";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" LabelAlign="Top" Title="表单">
        <Items>
            <f:HtmlEditor Label="文本编辑器" ID="HtmlEditor1" Editor="UMEditor" BasePath="~/res/third-party/umeditor/" Height="250">
            </f:HtmlEditor>
            <f:TextArea ID="TextArea1" Label="多行文本框" Height="150" Text="FineUI的使命是创建 No JavaScript，No CSS，No UpdatePanel，No ViewState 的网站应用程序">
            </f:TextArea>
            <f:Button ID="Button1" Text="获取 HTML 编辑器的内容" CssClass="marginr" OnClick="Button1_Click"></f:Button>
            <f:Button ID="Button2" Text="设置 HTML 编辑器的内容" OnClick="Button2_Click"></f:Button>
        </Items>
    </f:SimpleForm>



}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示接入旧版 <code>UMEditor</code>，并提供与编辑器配套的脚本、样式和资源路径。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>加载旧版编辑器</h3>
        <ol>
            <li>
                打开页面，等待正文区域加载完成。<br />
                结果：正文区域使用 <code>UMEditor</code> 的工具栏与编辑界面，资源由本页指定的旧编辑器目录提供。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：<code>FineUI</code>中使用的<strong class="example-control-reference" data-example-control="HtmlEditor1"
                title="文本编辑器">富文本编辑器</strong>可以在<code>UMEditor</code>、<code>UEditor</code>、<code>CKEditor</code>、<code>TinyMCE</code>中间选择，通过控件属性就能简单切换。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Editor</code>（<strong class="example-control-reference" data-example-control="HtmlEditor1"
                    title="文本编辑器">文本编辑器</strong>）：初始为<code>UMEditor</code>，使用本页引入资源的 UMEditor 编辑器。</li>
            <li><code>BasePath</code>（<strong class="example-control-reference" data-example-control="HtmlEditor1" title="文本编辑器">文本编辑器</strong>）：指定第三方
                <code>UMEditor</code> 的资源目录，页面必须提供与编辑器版本配套的脚本和样式。
            </li>
        </ul>
    </section>
}
