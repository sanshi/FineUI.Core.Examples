@page
@model FineUI.Core.Examples.Pages.Form.TextBoxTextChangedModel
@{
    ViewBag.Title = "Form/TextBoxTextChanged";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" LabelAlign="Top" Title="简单表单" ShowHeader="true">
        <Items>
            <f:TextBox ID="TextBox1" Label="文本框一（文本改变事件）" EmptyText="输入字符会立即触发TextChanged事件" OnTextChanged="TextBox1_TextChanged">
            </f:TextBox>
            <f:TextBox ID="TextBox2" Label="文本框二（失去焦点事件）" EmptyText="输入字符后失去焦点，会触发Blur事件" OnBlur="TextBox2_Blur">
            </f:TextBox>
        </Items>
    </f:SimpleForm>

    <f:Label ID="labResult1"></f:Label>
    <br>
    <f:Label ID="labResult2"></f:Label>

}

