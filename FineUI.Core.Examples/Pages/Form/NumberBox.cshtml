@page
@model FineUI.Core.Examples.Pages.Form.NumberBoxModel
@{
    ViewBag.Title = "Form/NumberBox";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" LabelAlign="Top" EnableCollapse="false"
                  Title="简单表单" LabelWidth="120">
        <Items>
            <f:NumberBox Label="0 到 9 的整数" ID="NumberBox1" MaxValue="9" MinValue="0"
                         NoDecimal="true" NoNegative="true" Required="true" EmptyText="比如 8" ShowRedStar="true" />
            <f:NumberBox Label="非负整数" ID="NumberBox3" EmptyText="比如 99"
                         NoDecimal="true" NoNegative="true" Required="true" ShowRedStar="true" />
            <f:NumberBox ID="NumberBox4" EmptyText="精度为 2，比如 0.35" Label="0 到 1 之间的小数（Increment=0.01）"
                         MaxValue="1" MinValue="0" NoDecimal="false" NoNegative="true" DecimalPrecision="2" Required="true" ShowRedStar="true" Increment="0.01">
            </f:NumberBox>
            <f:NumberBox Label="任意整数（ShowTrigger=false）" ID="NumberBox5" NoDecimal="true" ShowTrigger="false" />
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
        </Items>
    </f:SimpleForm>

}

