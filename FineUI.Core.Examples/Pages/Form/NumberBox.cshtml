@page
@model FineUI.Core.Examples.Pages.Form.NumberBoxModel
@{
    ViewBag.Title = "Form/NumberBox";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" LabelAlign="Top" EnableCollapse="false"
                  Title="简单表单" LabelWidth="120">
        <Items>
            <f:NumberBox Label="0 到 9 的整数" ID="NumberBox1" MaxValue="9" MinValue="0"
                         NoDecimal="true" NoNegative="true" Required="true" EmptyText="比如 8" ShowRedStar="true" />
            <f:NumberBox Label="非负整数" ID="NumberBox3" EmptyText="比如 99"
                         NoDecimal="true" NoNegative="true" Required="true" ShowRedStar="true" />
            <f:NumberBox ID="NumberBox4" EmptyText="精度为 2，比如 0.35" Label="0 到 1 之间的小数（Increment=0.01）"
                         MaxValue="1" MinValue="0" NoDecimal="false" NoNegative="true" DecimalPrecision="2" Required="true" ShowRedStar="true" Increment="0.01">
            </f:NumberBox>
            <f:NumberBox Label="任意整数（ShowTrigger=false）" ID="NumberBox5" NoDecimal="true" ShowTrigger="false" />
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
        </Items>
    </f:SimpleForm>


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示整数和小数输入的范围限制、增减步长，以及隐藏增减图标后的输入方式。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>检查数值范围</h3>
        <ol>
            <li>
                在<strong class="example-control-reference" data-example-control="NumberBox1" title="0 到 9 的整数">0 到 9 的整数</strong>中输入<code>10</code>，然后移开焦点。<br />
                结果：该字段提示不能大于 <code>9</code>；此时即使点击<strong class="example-control-reference" data-example-control="btnSubmit" title="提交表单">提交表单</strong>也无法通过验证。
            </li>
            <li>
                将该字段改为<code>8</code>。<br />
                结果：该值符合 <strong class="example-control-reference" data-example-control="NumberBox1" title="0 到 9 的整数">0 到 9 的整数</strong>规则，范围错误消失；其余必填字段仍需填写。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-sort" aria-hidden="true"></i>使用增减操作</h3>
        <ul>
            <li>
                在<strong class="example-control-reference" data-example-control="NumberBox1" title="0 到 9 的整数">0 到 9 的整数</strong>中输入<code>8</code>，点击向下的增减图标。<br />
                结果：数值变为 <code>7</code>；点击向上的图标可变回 <code>8</code>，也可使用键盘上下方向键。
            </li>
            <li>
                在<strong class="example-control-reference" data-example-control="NumberBox4" title="0 到 1 之间的小数（Increment=0.01）">0 到 1 之间的小数</strong>中输入<code>0.35</code>，点击向上的增减图标。<br />
                结果：数值按 <code>0.01</code> 的步长变为 <code>0.36</code>。
            </li>
            <li>
                在<strong class="example-control-reference" data-example-control="NumberBox5" title="任意整数（ShowTrigger=false）">任意整数（ShowTrigger=false）</strong>中输入<code>-8</code>。<br />
                结果：可以输入负整数，输入框不显示增减图标。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-send" aria-hidden="true"></i>验证后提交</h3>
        <ul>
            <li>
                前三个字段依次输入<code>8</code><code>99</code><code>0.35</code>，点击<strong class="example-control-reference" data-example-control="btnSubmit" title="提交表单">提交表单</strong>。<br />
                结果：必填、整数和范围检查均通过，才回发到后台，显示读取到的表单字段值。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>MinValue</code>（<strong class="example-control-reference" data-example-control="NumberBox1" title="0 到 9 的整数">0 到 9 的整数</strong>）：设置下限；<strong class="example-control-reference" data-example-control="NumberBox1" title="0 到 9 的整数">第一个字段</strong>和小数字段均为 <code>0</code>。</li>
            <li><code>MaxValue</code>（<strong class="example-control-reference" data-example-control="NumberBox1" title="0 到 9 的整数">0 到 9 的整数</strong>）：设置上限；<strong class="example-control-reference" data-example-control="NumberBox1" title="0 到 9 的整数">第一个字段</strong>为 <code>9</code>，小数字段为 <code>1</code>。</li>
            <li><code>NoDecimal</code>（本页全部数字输入框，如<strong class="example-control-reference" data-example-control="NumberBox1" title="0 到 9 的整数">0 到 9 的整数</strong>）：整数输入框设为 <code>true</code>，不接受小数。</li>
            <li><code>NoNegative</code>（<strong class="example-control-reference" data-example-control="NumberBox1" title="0 到 9 的整数">0 到 9 的整数</strong>、<strong class="example-control-reference" data-example-control="NumberBox3" title="非负整数">非负整数</strong>、<strong class="example-control-reference" data-example-control="NumberBox4" title="0 到 1 之间的小数（Increment=0.01）">0 到 1 之间的小数（Increment=0.01）</strong>）：前三个字段设为 <code>true</code>，不接受负数；最后一个整数框允许负数。</li>
            <li><code>DecimalPrecision</code>（<strong class="example-control-reference" data-example-control="NumberBox4" title="0 到 1 之间的小数（Increment=0.01）">0 到 1 之间的小数（Increment=0.01）</strong>）：小数字段使用 <code>2</code> 位小数。</li>
            <li><code>Increment</code>（<strong class="example-control-reference" data-example-control="NumberBox4" title="0 到 1 之间的小数（Increment=0.01）">0 到 1 之间的小数（Increment=0.01）</strong>）：小数字段设为 <code>0.01</code>，每次增减百分之一。</li>
            <li><code>ShowTrigger</code>（<strong class="example-control-reference" data-example-control="NumberBox5" title="任意整数（ShowTrigger=false）">任意整数（ShowTrigger=false）</strong>）：最后一个整数框设为 <code>false</code>，隐藏增减图标。</li>
            <li><code>Required</code>（<strong class="example-control-reference" data-example-control="NumberBox1" title="0 到 9 的整数">0 到 9 的整数</strong>、<strong class="example-control-reference" data-example-control="NumberBox3" title="非负整数">非负整数</strong>、<strong class="example-control-reference" data-example-control="NumberBox4" title="0 到 1 之间的小数（Increment=0.01）">0 到 1 之间的小数（Increment=0.01）</strong>）：前三个字段设为 <code>true</code>，提交前必须填写。</li>
            <li><code>_ValidateForms</code>（<strong class="example-control-reference" data-example-control="btnSubmit" title="提交表单">提交表单</strong>）：指定 <code>SimpleForm1</code>，验证通过后才回发。</li>
        </ul>
    </section>
}
