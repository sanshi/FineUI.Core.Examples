@page
@model FineUI.Core.Examples.Pages.Form.RadioButtonModel
@{
    ViewBag.Title = "Form/RadioButton";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" LabelWidth="150" Title="简单表单" EnableCollapse="false" BodyPadding="10" ShowBorder="true" ShowHeader="true">
        <Items>
            <f:RadioButton ID="rbtnSingleRadio" Label="单选框" Text="可选项">
                <Attributes>
                    <f:Attribute Key="data-qtip" Value="通过Attributes属性设置的提示信息"></f:Attribute>
                </Attributes>
            </f:RadioButton>
            <f:Button ID="btnSelectSingleRadio" CssClass="marginr" Text="选择/反选单选框" OnClick="btnSelectSingleRadio_Click"></f:Button>
            <f:Button ID="btnChangeCheckStatus" CssClass="marginr" Text="选择/反选单选框（客户端脚本）" ClickHandler="onChangeCheckStatusClick"></f:Button>
            <f:Label>
            </f:Label>
            <f:RadioButton ID="rbtnFirst" Label="单选框（分组）" Checked="true" GroupName="MyRadioGroup1" Text="可选项 1">
            </f:RadioButton>
            <f:RadioButton ID="rbtnSecond" GroupName="MyRadioGroup1" ShowEmptyLabel="true" Text="可选项 2">
            </f:RadioButton>
            <f:RadioButton ID="rbtnThird" GroupName="MyRadioGroup1" ShowEmptyLabel="true" Text="可选项 3">
            </f:RadioButton>
            <f:Button ID="btnSelectSecondRadio" Text="选中分组单选框中的下一个" OnClick="btnSelectSecondRadio_Click"></f:Button>
            <f:Label>
            </f:Label>
            <f:RadioButton ID="rbtnFirstAuto" Label="单选框（选中改变事件）" Checked="true" GroupName="MyRadioGroup2" Text="可选项 1"
                OnCheckedChanged="rbtnAuto_CheckedChanged">
            </f:RadioButton>
            <f:RadioButton ID="rbtnSecondAuto" GroupName="MyRadioGroup2" ShowEmptyLabel="true" Text="可选项 2" OnCheckedChanged="rbtnAuto_CheckedChanged">
            </f:RadioButton>
            <f:RadioButton ID="rbtnThirdAuto" GroupName="MyRadioGroup2" ShowEmptyLabel="true" Text="可选项 3" OnCheckedChanged="rbtnAuto_CheckedChanged">
            </f:RadioButton>
        </Items>
    </f:SimpleForm>

}

@section script {

    <script>

        function onChangeCheckStatusClick(event) {
            var radio = F.ui.rbtnSingleRadio;
            radio.setValue(!radio.getValue());
        }


    </script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>对比独立<strong class="example-control-reference" data-example-control="rbtnSingleRadio" title="可选项">单选框</strong>的状态切换、分组互斥和变化事件。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-radio-button-checked" aria-hidden="true"></i>同组只选一项</h3>
        <ol>
            <li>
                在<strong class="example-control-reference" data-example-control="rbtnFirst" title="第 2 个单选框（可选项 1）">单选框（分组）</strong>中选择<strong
                    class="example-control-reference" data-example-control="rbtnSecond" title="第 3 个单选框（可选项 2）">第 3 个单选框（可选项 2）</strong>、<strong
                    class="example-control-reference" data-example-control="rbtnSecondAuto" title="第 6 个单选框（可选项 2）">第 6 个单选框（可选项 2）</strong>。<br />
                结果：第二项选中，第一项取消。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>通过按钮切换</h3>
        <ol>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnSelectSecondRadio" title="选中分组单选框中的下一个">选中分组单选框中的下一个</strong>。<br />
                结果：回发后由后台选中分组中的下一项，并取消原来选中项。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>GroupName</code>（<strong class="example-control-reference" data-example-control="rbtnFirst" title="第 2 个单选框（可选项 1）">第 2 个单选框（可选项
                    1）</strong>）：名称相同的<strong class="example-control-reference" data-example-control="rbtnSingleRadio" title="可选项">单选框</strong>互斥，不同分组相互独立。
                本页<strong class="example-control-reference" data-example-control="rbtnFirst" title="第 2 个单选框（可选项 1）">单选框（分组）</strong>声明值为
                <code>MyRadioGroup1</code>。
            </li>
            <li><code>Checked</code>（<strong class="example-control-reference" data-example-control="rbtnFirst" title="第 2 个单选框（可选项 1）">第 2 个单选框（可选项
                    1）</strong>）：指定<strong class="example-control-reference" data-example-control="rbtnSingleRadio" title="可选项">单选框</strong>的初始选中状态。 本页<strong
                    class="example-control-reference" data-example-control="rbtnFirst" title="第 2 个单选框（可选项 1）">单选框（分组）</strong>声明值为 <code>true</code>。</li>
            <li><code>OnCheckedChanged</code>（<strong class="example-control-reference" data-example-control="rbtnFirstAuto" title="第 5 个单选框（可选项 1）">第 5
                    个单选框（可选项 1）</strong>）：用户改变当前分组选择后回发并显示结果。 本页<strong class="example-control-reference" data-example-control="rbtnFirstAuto"
                    title="第 5 个单选框（可选项 1）">单选框（选中改变事件）</strong>声明值为 <code>rbtnAuto_CheckedChanged</code>。</li>
        </ul>
    </section>
}
