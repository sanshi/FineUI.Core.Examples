@page
@model FineUI.Core.Examples.Pages.Form.RadioButtonCustomTextStyleModel
@{
    ViewBag.Title = "Form/RadioButtonCustomTextStyle";
    var F = Html.F();
}


@section head {

    <style>

        /* :checked 伪类选择器：https://developer.mozilla.org/en-US/docs/Web/CSS/:checked */
        /* :has() 关系伪类选择器：https://developer.mozilla.org/en-US/docs/Web/CSS/:has */
        /* 选中的单选框/复选框，其所在字段单元格内的文字标签变红 */
        /* 说明：FineUI 渲染的 DOM 中 <input> 与文字 label 并非兄弟节点（label 嵌在 .f-field-checkboxct 内部），因此无法使用兄弟选择器（~ / +）；改用 :has() 从"包含选中 input"的字段单元格
           向内匹配文字标签 */
        .f-field-body-cell:has(input.f-field-checkbox:checked) .f-field-body-checkboxlabel {
            color: red;
        }

    </style>

}



@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" LabelWidth="150" Title="简单表单" EnableCollapse="false" BodyPadding="10" ShowBorder="true" ShowHeader="true">
        <Items>
            <f:RadioButton ID="rbtnSingleRadio" Label="单选框" Text="可选项">
            </f:RadioButton>
            <f:Button ID="btnSelectSingleRadio" CssClass="marginr" Text="选择/反选单选框" OnClick="btnSelectSingleRadio_Click"></f:Button>
            <f:Button ID="btnChangeCheckStatus" CssClass="marginr" Text="选择/反选单选框（客户端脚本）" ClickHandler="onChangeCheckStatusClick"></f:Button>
            <f:Label>
            </f:Label>
            <f:RadioButton ID="rbtnFirst" Label="单选框（分组）" Checked="true" GroupName="MyRadioGroup1" Text="可选项 1">
            </f:RadioButton>
            <f:RadioButton ID="rbtnSecond" GroupName="MyRadioGroup1" ShowEmptyLabel="true" Text="可选项 2">
            </f:RadioButton>
            <f:RadioButton ID="rbtnThird" GroupName="MyRadioGroup1" ShowEmptyLabel="true" Text="可选项 3">
            </f:RadioButton>
            <f:Button ID="btnSelectSecondRadio" Text="选中分组单选框中的下一个" OnClick="btnSelectSecondRadio_Click"></f:Button>
            <f:Label>
            </f:Label>
            <f:RadioButton ID="rbtnFirstAuto" Label="单选框（选中改变事件）" Checked="true" GroupName="MyRadioGroup2" Text="可选项 1" OnCheckedChanged="rbtnAuto_CheckedChanged">
            </f:RadioButton>
            <f:RadioButton ID="rbtnSecondAuto" GroupName="MyRadioGroup2" ShowEmptyLabel="true" Text="可选项 2" OnCheckedChanged="rbtnAuto_CheckedChanged">
            </f:RadioButton>
            <f:RadioButton ID="rbtnThirdAuto" GroupName="MyRadioGroup2" ShowEmptyLabel="true" Text="可选项 3" OnCheckedChanged="rbtnAuto_CheckedChanged">
            </f:RadioButton>
        </Items>
    </f:SimpleForm>




}

@section script {

    <script>

        function onChangeCheckStatusClick(event) {
            var radio = F.ui.rbtnSingleRadio;
            radio.setValue(!radio.getValue());
        }


    </script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示用 CSS 根据<strong class="example-control-reference" data-example-control="rbtnSingleRadio" title="可选项">单选框</strong>的选中状态改变对应文字颜色。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>选中后改变文字样式</h3>
        <ol>
            <li>
                选中另一个单选项，再切换回原选项。<br />
                结果：选中的选项文字变红，取消选中的文字恢复普通样式。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：本示例使用 CSS 关系伪类 <code>:has()</code> 让"选中"的<strong class="example-control-reference" data-example-control="rbtnSingleRadio" title="可选项">单选框</strong>文字变红。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>:has()</code>（本页全部<strong class="example-control-reference" data-example-control="rbtnSingleRadio" title="可选项">单选框</strong>，如<strong class="example-control-reference" data-example-control="rbtnSingleRadio" title="可选项">可选项</strong>）：从包含已选中 <code>input</code> 的字段单元格匹配文字标签。</li>
            <li><code>:checked</code>（本页全部<strong class="example-control-reference" data-example-control="rbtnSingleRadio" title="可选项">单选框</strong>，如<strong class="example-control-reference" data-example-control="rbtnSingleRadio" title="可选项">可选项</strong>）：仅匹配当前选中的输入元素，使文字样式随选中状态变化。</li>
        </ul>
    </section>
}
