@page
@model FineUI.Core.Examples.Pages.Form.LabelModel
@{
    ViewBag.Title = "Form/Label";
    var F = Html.F();
}

@section head {

    <style>
        .customlabel span {
            color: red;
            font-weight: bold;
        }
    </style>

}

@section body {

    <f:Label ID="Label1" Text="普通的 Label 标签，会自动编码字符串（比如：<strong></strong>）">
    </f:Label>
    <br />
    <f:Label ID="Label4" EncodeText="false" Text="<a href='http://www.ustc.edu.cn/' target='_blank'>中国科学技术大学（Label 标签生成的链接）</a>">
    </f:Label>
    <br />
    <f:Label ID="Label2" EncodeText="false" CssClass="customlabel" Text="修改文本的样式（CssClass）">
    </f:Label>
    <br />
    <f:Label ID="Label3" Enabled="false" EncodeText="false" Text="<span style='color:red;font-weight:bold;'>修改文本的样式（内嵌HTML）</span>">
    </f:Label>
    <br />
    <f:Button ID="btnChangeEnable" Text="启用/禁用最后一个标签" OnClick="btnChangeEnable_Click" />

}

