@page
@model FineUI.Core.Examples.Pages.Form.RadioButtonListModel
@{
    ViewBag.Title = "Form/RadioButtonList";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" LabelWidth="160" EnableCollapse="false" BodyPadding="10" ShowBorder="true" ShowHeader="true" Title="简单表单">
        <Items>
            <f:RadioButtonList ID="RadioButtonList1" Label="列表一">
                <f:RadioItem Text="可选项 1" Value="value1" />
                <f:RadioItem Text="可选项 2" Value="value2" />
                <f:RadioItem Text="可选项 3" Value="value3" />
            </f:RadioButtonList>
            <f:Button ID="btnServerSetSelectedValue" CssClass="marginr" Text="选中上面列表中的第一项" OnClick="btnServerSetSelectedValue_Click"></f:Button>
            <f:Button ID="btnServerGetSelectedValue" CssClass="marginr" Text="获取上面列表的选中项" OnClick="btnServerGetSelectedValue_Click"></f:Button>
            <f:Button ID="btnClientGetSelectedValue" Text="获取上面列表的选中项（JavaScript 脚本）" ClickHandler="onAlertSelectedValueClick"></f:Button>
            <f:Label>
            </f:Label>
            <f:RadioButtonList ID="RadioButtonList2" Label="列表二（一列）" ColumnNumber="1">
            </f:RadioButtonList>
            <f:Label>
            </f:Label>
            <f:RadioButtonList ID="rblAutoPostBack" Label="列表三（选中改变事件）" ColumnNumber="3" ShowRedStar="true" Required="true"
                OnSelectedIndexChanged="rblAutoPostBack_SelectedIndexChanged">
                <f:RadioItem Text="可选项 1（很长很长很长很长很长很长的可选项）" Value="value1" />
                <f:RadioItem Text="可选项 2" Value="value2" />
                <f:RadioItem Text="可选项 3" Value="value3" />
                <f:RadioItem Text="可选项 4" Value="value4" />
                <f:RadioItem Text="可选项 5" Value="value5" />
                <f:RadioItem Text="可选项 6" Value="value6" />
                <f:RadioItem Text="可选项 7" Value="value7" />
                <f:RadioItem Text="可选项 8" Value="value8" />
            </f:RadioButtonList>
            <f:Label>
            </f:Label>
            <f:RadioButtonList ID="CheckBoxList4" Label="列表四（竖排）" ColumnNumber="3" ColumnVertical="true" ShowRedStar="true" Required="true">
                <f:RadioItem Text="可选项 1" Value="value1" />
                <f:RadioItem Text="可选项 2" Value="value2" />
                <f:RadioItem Text="可选项 3" Value="value3" />
                <f:RadioItem Text="可选项 4" Value="value4" />
                <f:RadioItem Text="可选项 5" Value="value5" />
                <f:RadioItem Text="可选项 6" Value="value6" />
                <f:RadioItem Text="可选项 7" Value="value7" />
                <f:RadioItem Text="可选项 8" Value="value8" />
            </f:RadioButtonList>
        </Items>
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Position="Bottom" ToolbarAlign="Right">
                <Items>
                    <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:SimpleForm>


}


@section script {
    <script type="text/javascript">

        function onAlertSelectedValueClick(event) {
            var list1 = F.ui.RadioButtonList1;

            var checkedValue = list1.getValue();
            if (checkedValue) {
                top.F.alert("列表一的选中项：" + checkedValue);
            } else {
                top.F.alert("列表一没有选中项！");
            }
        }


    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示单选列表的互斥选择、设置和读取当前值，以及选择变化事件和多列排列。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-radio-button-checked" aria-hidden="true"></i>设置并读取单选值</h3>
        <ol>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnServerSetSelectedValue" title="选中上面列表中的第一项">选中上面列表中的第一项</strong>。<br />
                结果：回发后由后台选中<strong class="example-control-reference" data-example-control="RadioButtonList1" title="列表一">列表一</strong>的第一项。
            </li>
            <li>
                在<strong class="example-control-reference" data-example-control="RadioButtonList1" title="列表一">列表一</strong>改选第三项，再点击<strong
                    class="example-control-reference" data-example-control="btnServerGetSelectedValue" title="获取上面列表的选中项">获取上面列表的选中项</strong>。<br />
                结果：回发后由后台显示 <code>value3</code>，第一项会自动取消选中。
            </li>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnClientGetSelectedValue"
                    title="获取上面列表的选中项（JavaScript 脚本）">获取上面列表的选中项（JavaScript 脚本）</strong>。<br />
                结果：浏览器直接读取并显示同一个当前值，无需回发。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>变化事件和排列方式</h3>
        <ul>
            <li>
                在<strong class="example-control-reference" data-example-control="rblAutoPostBack" title="列表三（选中改变事件）">列表三（选中改变事件）</strong>中切换选项。<br />
                结果：选择变化后回发，后台显示当前选项值，每次仅保留一项选中。
            </li>
            <li>
                对照<strong class="example-control-reference" data-example-control="RadioButtonList2" title="列表二（一列）">列表二（一列）</strong>和<strong
                    class="example-control-reference" data-example-control="CheckBoxList4" title="列表四（竖排）">列表四（竖排）</strong>。<br />
                结果：同样是单选列表，前者只有一列，后者分为三列并按列向下排列。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>SelectedValue</code>（<strong class="example-control-reference" data-example-control="RadioButtonList1" title="列表一">列表一</strong>、<strong
                    class="example-control-reference" data-example-control="RadioButtonList2" title="列表二（一列）">列表二（一列）</strong>、<strong
                    class="example-control-reference" data-example-control="rblAutoPostBack" title="列表三（选中改变事件）">列表三（选中改变事件）</strong>）：读取或设置单个选项值，例如
                <code>value1</code>。
            </li>
            <li><code>ColumnNumber</code>（<strong class="example-control-reference" data-example-control="RadioButtonList2"
                    title="列表二（一列）">列表二（一列）</strong>、<strong class="example-control-reference" data-example-control="rblAutoPostBack"
                    title="列表三（选中改变事件）">列表三（选中改变事件）</strong>、<strong class="example-control-reference" data-example-control="CheckBoxList4"
                    title="列表四（竖排）">列表四（竖排）</strong>）：控制列数，本页对比一列和三列。</li>
            <li><code>ColumnVertical</code>（<strong class="example-control-reference" data-example-control="CheckBoxList4"
                    title="列表四（竖排）">列表四（竖排）</strong>）：<strong class="example-control-reference" data-example-control="CheckBoxList4"
                    title="列表四（竖排）">列表四</strong>设为 <code>true</code>，优先按列向下排列。</li>
            <li><code>OnSelectedIndexChanged</code>（<strong class="example-control-reference" data-example-control="rblAutoPostBack"
                    title="列表三（选中改变事件）">列表三（选中改变事件）</strong>）：<strong class="example-control-reference" data-example-control="rblAutoPostBack"
                    title="列表三（选中改变事件）">列表三</strong>选择变化时回发，后台显示当前值。</li>
        </ul>
    </section>
}
