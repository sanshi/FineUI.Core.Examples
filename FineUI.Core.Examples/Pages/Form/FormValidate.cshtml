@page
@model FineUI.Core.Examples.Pages.Form.FormValidateModel
@{
    ViewBag.Title = "Form/FormValidate";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" Title="用户注册表单">
        <Items>
            <f:TextBox ID="tbxUserName" Label="用户名" Required="true" NextFocusControl="tbxPassword" ShowRedStar="true" Text="admin">
            </f:TextBox>
            <f:TextBox ID="tbxPassword" Label="密码" Required="true" ShowRedStar="true" NextClickControl="btnRegister" TextMode="Password">
            </f:TextBox>
            <f:Button ID="btnRegister" Text="注册" _ValidateForms="SimpleForm1" ValidateTarget="Top" OnClick="btnRegister_Click"></f:Button>
        </Items>
    </f:SimpleForm>



}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示注册表单的必填检查、后台业务校验，以及将错误标记到具体字段。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>检查必填与保留字</h3>
        <ol>
            <li>
                保留<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong><code>admin</code>，密码为空，点击<strong
                    class="example-control-reference" data-example-control="btnRegister" title="注册">注册</strong>。<br />
                结果：密码提示必填，后续业务校验不执行。
            </li>
            <li>
                关闭必填提示，密码输入<code>123456</code>，再次点击<strong class="example-control-reference" data-example-control="btnRegister" title="注册">注册</strong>。<br />
                结果：必填检查通过后回发，由后台检查<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>，<strong
                    class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>被标记为无效，提示“<code>admin</code> 是保留字，请另外选择！”。
            </li>
            <li>
                将<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>改为<code>demo</code>，再次点击<strong
                    class="example-control-reference" data-example-control="btnRegister" title="注册">注册</strong>。<br />
                结果：后台显示当前<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>和密码；本页用读取结果演示校验通过后的处理，没有实际创建账号。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-keyboard" aria-hidden="true"></i>使用 Enter 操作</h3>
        <ol>
            <li>
                在<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>框按 <code>Enter</code>。<br />
                结果：焦点转到密码框。
            </li>
            <li>
                在密码框按 <code>Enter</code>。<br />
                结果：触发<strong class="example-control-reference" data-example-control="btnRegister" title="注册">注册</strong>按钮，执行相同的必填检查和业务校验。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Required</code>（<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>、<strong
                    class="example-control-reference" data-example-control="tbxPassword" title="密码">密码</strong>）：<strong class="example-control-reference"
                    data-example-control="tbxUserName" title="用户名">用户名</strong>和密码都设为 <code>true</code>，不能为空。</li>
            <li><code>_ValidateForms</code>（<strong class="example-control-reference" data-example-control="btnRegister" title="注册">注册</strong>）：注册按钮指定
                <code>SimpleForm1</code>，浏览器验证通过后才回发。
            </li>
            <li><code>MarkInvalid()</code>（<strong class="example-control-reference" data-example-control="tbxUserName"
                    title="用户名">用户名</strong>）：后台将保留字错误显示到<strong class="example-control-reference" data-example-control="tbxUserName"
                    title="用户名">用户名</strong>字段。</li>
            <li><code>NextFocusControl</code>（<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>）：<strong
                    class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>框指定 <code>tbxPassword</code>，按
                <code>Enter</code> 聚焦密码框。
            </li>
            <li><code>NextClickControl</code>（<strong class="example-control-reference" data-example-control="tbxPassword" title="密码">密码</strong>）：密码框指定
                <code>btnRegister</code>，按 <code>Enter</code> 触发注册按钮。
            </li>
        </ul>
    </section>
}
