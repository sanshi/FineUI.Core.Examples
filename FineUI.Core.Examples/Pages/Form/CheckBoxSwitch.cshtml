@page
@model FineUI.Core.Examples.Pages.Form.CheckBoxSwitchModel
@{
    ViewBag.Title = "Form/CheckBoxSwitch";
    var F = Html.F();
}

@section head {
    <style>
        .mycheckbox .f-field-checkbox-switch .f-field-checkbox-switch-text {
            min-width: 40px;
        }
    </style>
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" EnableCollapse="false" Title="简单表单" LabelWidth="200">
        <Items>
            <f:CheckBox ID="CheckBox1" ShowLabel="false" Text="复选框" Checked="true" DisplayType="Switch">
            </f:CheckBox>
            <f:Button ID="btnSelectCheckBox" CssClass="marginr" Text="选择/反选复选框" OnClick="btnSelectCheckBox_Click"></f:Button>
            <f:Button ID="btnChangeCheckStatus" CssClass="marginr" Text="选择/反选复选框（客户端脚本）" ClickHandler="onChangeCheckStatusClick"></f:Button>
            <f:Button ID="btnChangeEnabled" CssClass="marginr" Text="禁用/启用复选框（客户端脚本）" ClickHandler="onChangeEnabledClick"></f:Button>
            <f:Button ID="btnDisable" CssClass="marginr" Text="启用/禁用复选框" OnClick="btnDisableCheckBox_Click"></f:Button>
            <f:Label>
            </f:Label>
            <f:CheckBox ID="CheckBox2" ShowLabel="false" Checked="true" DisplayType="Switch" Text="复选框（OnCheckedChanged）" OnCheckedChanged="CheckBox2_CheckedChanged">
            </f:CheckBox>
            <f:Label>
            </f:Label>
            <f:CheckBox ID="CheckBox3" Label="开关文本" Checked="true" DisplayType="Switch" SwitchTextVisible="true">
            </f:CheckBox>
            <f:CheckBox ID="CheckBox4" Label="开关文本（自定义）" DisplayType="Switch" SwitchTextVisible="true" SwitchOnText="1" SwitchOffText="0">
            </f:CheckBox>
            <f:CheckBox ID="CheckBox5" Label="开关文本（图标字体）" DisplayType="Switch" SwitchTextVisible="true">
            </f:CheckBox>
            <f:CheckBox ID="CheckBox6" CssClass="mycheckbox" Label="开关文本（自定义）" DisplayType="Switch" SwitchTextVisible="true" SwitchOnText="开启" SwitchOffText="关闭">
            </f:CheckBox>
        </Items>
    </f:SimpleForm>


}


@section script {
    <script>

        function onChangeCheckStatusClick(event) {
            var checkbox = F.ui.CheckBox1;
            checkbox.setValue(!checkbox.getValue());
        }

        function onChangeEnabledClick(event) {
            var checkbox = F.ui.CheckBox1;
            checkbox.setDisabled(!checkbox.isDisabled());
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示将复选框显示为开关，并自定义开关文字、图标及可用状态。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-power-off" aria-hidden="true"></i>切换开关状态</h3>
        <ul>
            <li>
                点击“选择/反选复选框”。<br />
                结果：回发后由后台切换第一个开关的开关状态。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对比开关内容</h3>
        <ul>
            <li>
                依次切换下方的“开关文本”“开关文本（自定义）”和“开关文本（图标字体）”。<br />
                结果：分别看到默认文字、1 / 0、勾 / 叉图标，以及开启 / 关闭文字随状态改变；这些外观切换在浏览器完成。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DisplayType</code>：设为 Switch，使用开关外观，当前状态仍由 Checked 表示。</li>
            <li><code>SwitchTextVisible</code>：设为 true，显示开关内的文字或图标。</li>
            <li><code>SwitchOnText</code>：开启状态文字，本例使用 1 或“开启”。</li>
            <li><code>SwitchOffText</code>：关闭状态文字，本例使用 0 或“关闭”。</li>
            <li><code>SwitchOnTextRawHtml</code>：设置开启状态的可信 HTML，本例使用固定勾图标。</li>
            <li><code>SwitchOffTextRawHtml</code>：设置关闭状态的可信 HTML，本例使用固定叉图标。</li>
        </ul>
    </section>
}
