@page
@model FineUI.Core.Examples.Pages.Form.OrderDeliveryModel
@{
    ViewBag.Title = "订单配送";
}

@section body {
    <f:SimpleForm ID="Form1" Title="订单配送" IsFluid="true" MaxWidth="450" BodyPadding="16" LabelWidth="104"
        ShowHeader="true" ShowBorder="true">
        <Items>
            <f:DropDownList ID="ddlDelivery" Label="配送方式"
                OnSelectedIndexChanged="ddlDelivery_SelectedIndexChanged">
                <Items>
                    <f:ListItem Text="门店自提" Value="pickup" Selected="true" />
                    <f:ListItem Text="快递配送" Value="courier" />
                </Items>
            </f:DropDownList>
            <f:TextBox ID="tbxAddress" Label="收货地址" />
            <f:Button ID="btnSubmit" Text="提交订单" ButtonColor="Primary" _ValidateForms="Form1"
                OnClick="btnSubmit_Click" />
            <f:Label ID="labResult" ShowLabel="false" Hidden="true" />
        </Items>
    </f:SimpleForm>

    <p>选择快递配送时，后台把收货地址设为必填。<code>ShowRedStar</code> 让标签立即显示星号，<code>Required</code> 在提交订单时校验空地址。切回门店自提，留空地址也可提交。</p>
}
