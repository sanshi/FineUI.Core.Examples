@page
@model FineUI.Core.Examples.Pages.Form.FormCompareNumberBoxModel
@{
    ViewBag.Title = "Form/FormCompareNumberBox";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" LabelWidth="200" EnableCollapse="false" ShowBorder="true" ShowHeader="true" Title="简单表单" LabelAlign="Top">
        <Items>
            <f:NumberBox ID="NumberBox1" Required="true" Label="数字框 1（必填项）">
            </f:NumberBox>
            <f:NumberBox ID="NumberBox2" Required="true" Label="数字框 2（必填项，大于等于数字框 1）" CompareControl="NumberBox1"
                         CompareOperator="GreaterThanEqual" CompareMessage="数字框 2 应该大于等于数字框 1!">
            </f:NumberBox>
            <f:NumberBox ID="NumberBox3" Label="数字框 3（可为空）">
            </f:NumberBox>
            <f:NumberBox ID="NumberBox4" Label="数字框 4（可为空，大于等于数字框 3）" CompareControl="NumberBox3"
                         CompareOperator="GreaterThanEqual" CompareMessage="数字框 4 应该大于等于数字框 3!">
            </f:NumberBox>
            <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" CssClass="marginr" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
            <f:Button ID="btnReset" Text="重置表单" ClickHandler="onResetClick"></f:Button>
        </Items>
    </f:SimpleForm>

}

@section script {

    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示必填与可空两组数字的关联比较，后一个值必须大于等于前一个。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-sort" aria-hidden="true"></i>可空组也按关系验证</h3>
        <ul>
            <li>
                <strong class="example-control-reference" data-example-control="NumberBox3" title="数字框 3（可为空）">数字框 3</strong> 输入 <code>30</code>，<strong class="example-control-reference" data-example-control="NumberBox4" title="数字框 4（可为空，大于等于数字框 3）">数字框 4</strong> 输入 <code>29</code>，提交。<br />
                结果：<strong class="example-control-reference" data-example-control="NumberBox4" title="数字框 4（可为空，大于等于数字框 3）">数字框 4</strong> 提示应大于等于<strong class="example-control-reference" data-example-control="NumberBox3" title="数字框 3（可为空）">数字框 3</strong>；可空不表示填写后免于比较。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Required</code>（<strong class="example-control-reference" data-example-control="NumberBox1" title="数字框 1（必填项）">数字框 1（必填项）</strong>、<strong class="example-control-reference" data-example-control="NumberBox2" title="数字框 2（必填项，大于等于数字框 1）">数字框 2（必填项，大于等于数字框 1）</strong>）：前两个字段必填，后两个允许为空。</li>
        </ul>
    </section>
}
