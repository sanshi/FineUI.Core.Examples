@page
@model FineUI.Core.Examples.Pages.Form.ValidateForValueModel
@{
    ViewBag.Title = "Form/ValidateForValue";
    var F = Html.F();
}


@section body {

    <f:SimpleForm IsFluid="true" BodyPadding="10" ID="SimpleForm1" Title="表单">
        <Items>
            <f:DropDownList ID="DropDownList1" Label="List1" ShowRedStar="true" Required="true" MinLength="3">
                <f:ListItem Text="甲" Value="301"></f:ListItem>
                <f:ListItem Text="老大乙" Value="201"></f:ListItem>
                <f:ListItem Text="老大丙" Value="101"></f:ListItem>
            </f:DropDownList>
            <f:DropDownList ID="DropDownList3" Label="List2" ShowRedStar="true" Required="true" MinLength="3" ValidateForValue="true">
                <f:ListItem Text="老大甲（Value=0）" Value="0"></f:ListItem>
                <f:ListItem Text="老大乙（Value=201）" Value="201"></f:ListItem>
                <f:ListItem Text="老大丙（Value=101）" Value="101"></f:ListItem>
            </f:DropDownList>
            <f:Button ID="btnSubmit" Text="验证此表单并提交" CssClass="marginr" _ValidateForms="SimpleForm1" OnClick="btnSubmitForm_Click"></f:Button>
        </Items>
    </f:SimpleForm>

}

