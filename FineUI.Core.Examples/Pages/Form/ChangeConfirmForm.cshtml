@page
@model FineUI.Core.Examples.Pages.Form.ChangeConfirmFormModel
@{
    ViewBag.Title = "Form/ChangeConfirmForm";
    var F = Html.F();
}


@section body {




    <f:SimpleForm ID="SimpleForm1" IsFluid="true" ShowBorder="true" EnableCollapse="false" Title="表单" ShowHeader="true" AutoScroll="true" BodyPadding="10">
        <Items>

            <f:NumberBox ID="NumberBox1" Label="数字输入框" Required="true" ShowRedStar="true" />
            <f:CheckBox ID="CheckBox1" Label="复选框">
            </f:CheckBox>
            <f:TextBox ID="TextBox1" Label="文本输入框" ShowRedStar="true" Required="true">
            </f:TextBox>
            <f:DatePicker ID="DatePicker1" Label="日期选择器" Text="2008-05-09">
            </f:DatePicker>
            <f:TextBox ID="TextBox2" Label="默认隐藏的字段" Hidden="true">
            </f:TextBox>
            <f:DropDownList Label="下拉列表" ID="DropDownList1">
                <f:ListItem Text="可选项1" Value="Value1" Selected="true" />
                <f:ListItem Text="可选项2（不可选择）" Value="Value2" EnableSelect="false" />
                <f:ListItem Text="可选项3（不可选择）" Value="Value3" EnableSelect="false" />
                <f:ListItem Text="可选项4" Value="Value4" />
                <f:ListItem Text="可选项5" Value="Value5" />
                <f:ListItem Text="可选项6" Value="Value6" />
                <f:ListItem Text="可选择项7" Value="Value7" />
                <f:ListItem Text="可选择项8" Value="Value8" />
                <f:ListItem Text="普通型1 < L > 1.5" Value="普通型1 < L > 1.5" />
                <f:ListItem Text="可选择项9" Value="Value9" />
                <f:ListItem Text="可选择项10" Value="Value10" />
                <f:ListItem Text="可选择项11" Value="Value11" />
                <f:ListItem Text="可选择项12" Value="Value12" />
                <f:ListItem Text="可选择项13" Value="Value13" />
                <f:ListItem Text="可选择项14" Value="Value14" />
                <f:ListItem Text="可选择项15" Value="Value15" />
                <f:ListItem Text="可选择项16" Value="Value16" />
            </f:DropDownList>
        </Items>
        <Toolbars>
            <f:Toolbar Position="Bottom" ToolbarAlign="Right">
                <Items>
                    <f:Button Text="刷新本页面" ID="btnClose" Icon="SystemClose" ClickHandler="onCloseClick"></f:Button>
                    <f:Button ID="btnClosePostBack" Text="保存数据" _ValidateForms="SimpleForm1" OnClick="btnClosePostBack_Click" Icon="SystemSave"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:SimpleForm>

}


@section script {

    <script>

        function onCloseClick(event) {
            window.location.reload();
        }

        F.beforeUnload(function () {
            var form = F.ui.SimpleForm1;
            // 表单数据改变了
            if (form.isDirty()) {
                return '当前表单数据已经被修改，确认放弃修改？';
            }
        });


    </script>
}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示表单有未保存修改时，在离开页面前提示确认，保存后清除修改标记。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>有修改时确认离开</h3>
        <ol>
            <li>
                勾选<strong class="example-control-reference" data-example-control="CheckBox1" title="复选框">复选框</strong>或修改日期；若本页有可编辑表格，也可单击姓名单元格修改姓名。<br />
                结果：表单或表格产生未保存的修改标记。
            </li>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnClose" title="刷新本页面">刷新本页面</strong>，在浏览器确认框中选择留在页面。<br />
                结果：取消离开后仍留在原页，刚才的输入保留；确认框的样式和文字由浏览器决定。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-send" aria-hidden="true"></i>保存后清除修改标记</h3>
        <ol>
            <li>
                给<strong class="example-control-reference" data-example-control="NumberBox1" title="数字输入框">数字输入框</strong>填写<code>1</code>，给<strong class="example-control-reference" data-example-control="TextBox1" title="文本输入框">文本输入框</strong>填写<code>demo</code>，点击<strong class="example-control-reference" data-example-control="btnClosePostBack" title="保存数据">保存数据</strong>。<br />
                结果：客户端验证通过后回发，后台清除表单修改标记。
            </li>
            <li>
                再次刷新；保存后不要再改字段。<br />
                结果：当前已无待保存修改时，不再因为该表单或表格弹出放弃修改提示；继续修改后会重新提示。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
<p>修改后从示例窗口或选项卡离开时，可对照<a href='@Url.Content("~/res/images/formchangeconfirm.png")' target="_blank" rel="noopener">确认关闭图示</a>；刷新或关闭浏览器时，提示样式与文字由浏览器决定。</p>
<h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>F.beforeUnload()</code>（<strong>页面客户端配置</strong>）：离开页面前执行检查；返回提示文字表示有未保存修改。</li>
            <li><code>isDirty()</code>（<strong class="example-control-reference" data-example-control="SimpleForm1" title="表单">表单</strong>）：判断表单当前字段值相对已接受状态是否改变。</li>
            <li><code>ClearDirty()</code>（<strong class="example-control-reference" data-example-control="SimpleForm1" title="表单">表单</strong>）：保存成功后接受当前表单值作为新基准，不清空输入。</li>
        </ul>
    </section>
}
