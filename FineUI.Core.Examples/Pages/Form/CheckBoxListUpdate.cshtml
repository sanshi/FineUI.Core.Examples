@page
@model FineUI.Core.Examples.Pages.Form.CheckBoxListUpdateModel
@{
    ViewBag.Title = "Form/CheckBoxListUpdate";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" LabelWidth="120" EnableCollapse="false" BodyPadding="10" ShowBorder="true" ShowHeader="true" Title="简单表单">
        <Items>
            <f:CheckBoxList ID="CheckBoxList1" Label="列表一">
                <f:CheckItem Text="可选项 1" Value="value1" />
                <f:CheckItem Text="可选项 2" Value="value2" Selected="true" />
                <f:CheckItem Text="可选项 3" Value="value3" Selected="true" />
            </f:CheckBoxList>
            <f:Button ID="btnUpdateList1" CssClass="marginr" Text="更新列表一" OnClick="btnUpdateList1_Click"></f:Button>
            <f:Button ID="btnCheckedItemsList1" Text="获取列表一的选中项" OnClick="btnCheckedItemsList1_Click"></f:Button>
            <f:Label>
            </f:Label>
            <f:CheckBoxList ID="CheckBoxList2" Label="列表二（竖排）" ColumnNumber="3" ColumnVertical="true">
            </f:CheckBoxList>
            <f:Button ID="btnUpdateList2" CssClass="marginr" Text="更新列表二" OnClick="btnUpdateList2_Click"></f:Button>
            <f:Button ID="btnCheckedItemsList2" Text="获取列表二的选中项" OnClick="btnCheckedItemsList2_Click"></f:Button>
            <f:Label ID="Label1">
            </f:Label>
            <f:CheckBoxList ID="CheckBoxList4" Label="列表四" ColumnNumber="3" ColumnVertical="false">
            </f:CheckBoxList>
            <f:Button ID="btnUpdateList4" CssClass="marginr" Text="更新列表四（可反复操作）" OnClick="btnUpdateList4_Click"></f:Button>
            <f:Button ID="btnCheckedItemsList4" Text="获取列表四的选中项" OnClick="btnCheckedItemsList4_Click"></f:Button>
        </Items>
    </f:SimpleForm>
    <br />
    <br />
    <f:CheckBoxList ID="CheckBoxList3" Width="700" Label="列表三" ColumnNumber="3" ColumnVertical="false">
        <f:CheckItem Text="可选项 1" Value="value1" />
        <f:CheckItem Text="可选项 2" Value="value2" />
        <f:CheckItem Text="可选项 3" Value="value3" />
        <f:CheckItem Text="可选项 4" Value="value4" />
        <f:CheckItem Text="可选项 5" Value="value5" Selected="true" />
        <f:CheckItem Text="可选项 6" Value="value6" Selected="true" />
        <f:CheckItem Text="可选项 7" Value="value7" Selected="true" />
        <f:CheckItem Text="可选项 8" Value="value8" />
    </f:CheckBoxList>
    <br />
    <f:Button ID="btnUpdateList3" CssClass="marginr" Text="更新列表三" OnClick="btnUpdateList3_Click"></f:Button>
    <f:Button ID="btnCheckedItemsList3" Text="获取列表三的选中项" OnClick="btnCheckedItemsList3_Click"></f:Button>
    <br />


}

@section script {
    

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示替换复选框列表的选项、同步指定选中项，以及反复填充和清空列表。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>更新后读取选择</h3>
        <ol>
            <li>
                点击“更新列表一”。<br />
                结果：回发后由后台将原来的 3 项替换为 4 项“数据绑定值”，并选中第一项和第三项。
            </li>
            <li>
                点击“获取列表一的选中项”。<br />
                结果：回发后由后台显示 value1、value3，读取的是更新后的选择。
            </li>
            <li>
                分别点击“更新列表二”和“更新列表三”。<br />
                结果：列表二变为 6 项并选中第 1、3、6 项；列表三变为 9 项并选中第 1、2、6、7 项。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>反复填充和清空</h3>
        <ol>
            <li>
                在列表四为空时，点击“更新列表四（可反复操作）”。<br />
                结果：回发后由后台填充 6 个选项，并选中前两项。
            </li>
            <li>
                再次点击同一个按钮。<br />
                结果：列表四的选项全部清空；继续点击又可填充，无需重新打开页面。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DataTextField</code>：指定显示文字字段，本例为 Name。</li>
            <li><code>DataValueField</code>：指定选项值字段，本例为 Id。</li>
            <li><code>DataSource</code>：提供新数据，绑定后替换原来的选项。</li>
            <li><code>Items.Clear()</code>：列表四已有内容时清空全部选项。</li>
        </ul>
    </section>
}
