@page
@model FineUI.Core.Examples.Pages.Form.FormUpdateLabelModel
@{
    ViewBag.Title = "Form/FormUpdateLabel";
    var F = Html.F();
}


@section body {

    <f:Form LabelWidth="100" BodyPadding="10" EnableCollapse="false" ID="Form1" IsFluid="true" Title="表单">
        <Rows>
            <f:FormRow>
                <Items>
                    <f:Label ID="labTitle" Label="标题" HideMode="Display" Text="申请单" />
                    <f:Label ID="labLiuShuiHao" Label="流水号" Text="123456789" />
                </Items>
            </f:FormRow>
            <f:FormRow>
                <Items>
                    <f:Label ID="labPhone" Label="固定电话" Text="0551-1234567" />
                    <f:Label ID="Label16" Label="申请人" Text="admin">
                    </f:Label>
                </Items>
            </f:FormRow>
            <f:FormRow>
                <Items>
                    <f:Label ID="Label4" Label="编号" Text="200804170006" />
                    <f:TextBox ID="tbxEmail" Required="true" ShowRedStar="true" Label="电子邮箱" EmptyText="请输入常用电子邮箱" RegexPattern="EMAIL" RegexMessage="请输入有效的邮箱地址！">
                    </f:TextBox>
                </Items>
            </f:FormRow>
            <f:FormRow>
                <Items>
                    <f:DropDownList ID="DropDownList3" Label="审批人" Required="true" EmptyText="请选择审批人" ShowRedStar="true" AutoSelectFirstItem="false">
                        <f:ListItem Text="老大甲" Value="0"></f:ListItem>
                        <f:ListItem Text="老大乙" Value="1"></f:ListItem>
                        <f:ListItem Text="老大丙" Value="2"></f:ListItem>
                    </f:DropDownList>
                    <f:DatePicker Required="true" Label="审批时间" EmptyText="请输入审批时间" ID="dpApplyTime" ShowRedStar="true" DateFormatString="yyyy/MM/dd">
                    </f:DatePicker>
                </Items>
            </f:FormRow>
            <f:FormRow>
                <Items>
                    <f:NumberBox ID="nbxApplyNumber" Label="申请数量" NoDecimal="true" NoNegative="true" EmptyText="请输入申请数量" MaxValue="100" Required="true" ShowRedStar="true" />
                </Items>
            </f:FormRow>
            <f:FormRow>
                <Items>
                    <f:TextArea ID="taDescription" Label="描述" ShowRedStar="true" Required="true" MinLength="5">
                    </f:TextArea>
                </Items>
            </f:FormRow>
            <f:FormRow>
                <Items>
                    <f:Panel ID="Panel2" ShowBorder="false" ShowHeader="false">
                        <Items>
                            <f:Button ID="btnSubmitForm1" Text="验证表单并提交" CssClass="marginr" OnClick="btnSubmit_Click" _ValidateForms="Form1"></f:Button>
                        </Items>
                    </f:Panel>
                </Items>
            </f:FormRow>
        </Rows>
    </f:Form>
    <br />
    <f:Button ID="btnUpdateLabel" Text="更新[固定电话]标签" CssClass="marginr" ClickHandler="onUpdateLabelClick"></f:Button>
    <br />
    <br />
    <f:Button ID="btnRemoveRequired" Text="去除[电子邮箱]必填项" CssClass="marginr" ClickHandler="onRemoveRequiredClick"></f:Button>
    <f:Button ID="btnRemoveRegex" Text="去除[电子邮箱]的正则表达式验证" CssClass="marginr" ClickHandler="onRemoveRegexClick"></f:Button>
    <br />
    <br />
    <f:Button ID="btnRemoveMinLength" Text="去除[描述]的最少5个字符限制" CssClass="marginr" ClickHandler="onRemoveMinLengthClick"></f:Button>
    <br />
    <br />
    <f:Button ID="btnRemoveValue" Text="将[申请数量]的最大值100改为10" CssClass="marginr" ClickHandler="onChangeMaxValueClick"></f:Button>
    <br />
    <br />
    <f:Button ID="btnModifyMinDate" Text="限制[审批时间]的最大时间为今天" CssClass="marginr" ClickHandler="onModifyMaxValueClick"></f:Button>

}

@section script {

    <script>

        function onUpdateLabelClick(event) {
            var labPhone = F.ui.labPhone;

            var labPhoneFieldLabel = labPhone.getFieldLabel();
            if (labPhoneFieldLabel == "移动电话") {
                labPhone.setFieldLabel("固定电话");
            } else {
                labPhone.setFieldLabel("移动电话");
            }
        }

        function onRemoveRequiredClick(event) {
            F.ui.tbxEmail.setRequired(false);
            F.ui.tbxEmail.setRedStar(false);
        }

        function onRemoveRegexClick(event) {
            F.ui.tbxEmail.setRegex('');
        }

        function onRemoveMinLengthClick(event) {
            F.ui.taDescription.setMinLength(undefined);
        }

        function onChangeMaxValueClick(event) {
            F.ui.nbxApplyNumber.setMaxValue(10);
        }

        function onModifyMaxValueClick(event) {
            var datestr = F.formatDate('yyyy/MM/dd', new Date());
            F.ui.dpApplyTime.setMaxValue('2016-11-22');
        }

    </script>
}
