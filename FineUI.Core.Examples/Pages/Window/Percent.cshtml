@page
@model FineUI.Core.Examples.Pages.Window.PercentModel
@{
    ViewBag.Title = "Window/Percent";
    var F = Html.F();
}


@section body {

    <f:Button ID="btnShowWindow" Text="显示窗体" ClickHandler="onOpenWindow1Click"></f:Button>
    <br />
    <br />
    <f:Button ID="btnCloseWindow" Text="关闭窗体" ClickHandler="onCloseWindow1Click"></f:Button>
    <br />
    <br />

    <f:Window ID="Window1" Icon="TagBlue" Title="窗体（PercentWidth=50% PercentHeight=50%）"
              IsModal="false" AutoScroll="true" BodyPadding="10" PercentWidth="50%" PercentHeight="50%">
        <Content>
            <p>
                <a href="http://tech.163.com/special/jobsdead/" target="_blank"><b>乔布斯</b></a>
            </p>
            <p>
                乔布斯于1955年2月24日出生，苹果创始人之一。今年8月苹果超越埃克森美孚成为全球最大市值企业，截止上季度持有现金达到762亿美金，甚至超过了美国政府国库存款。
            </p>
        </Content>
    </f:Window>


}

@section script {

    <script type="text/javascript">

        function onOpenWindow1Click(event) {
            F.ui.Window1.show();
        }

        function onCloseWindow1Click(event) {
            F.ui.Window1.hide();
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>让窗体宽高分别占当前视口的一半。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-window" aria-hidden="true"></i>对照本页窗体效果</h3>
    <ul>
        <li>查看<strong class="example-control-reference" data-example-control="Window1" title="窗体（PercentWidth=50% PercentHeight=50%）">窗体（PercentWidth=50% PercentHeight=50%）</strong>。<strong class="example-control-reference" data-example-control="btnShowWindow" title="显示窗体">显示窗体</strong>后调整浏览器窗口大小，关闭后再次打开。<br />结果：宽高按当前视口的 50% 计算，重新打开仍使用该比例。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>PercentWidth</code>（<strong class="example-control-reference" data-example-control="Window1" title="窗体（PercentWidth=50% PercentHeight=50%）">窗体（PercentWidth=50% PercentHeight=50%）</strong>）：初始为 <code>50%</code>，按可用视口宽度的百分比计算窗体宽度。</li>
        <li><code>PercentHeight</code>（<strong class="example-control-reference" data-example-control="Window1" title="窗体（PercentWidth=50% PercentHeight=50%）">窗体（PercentWidth=50% PercentHeight=50%）</strong>）：初始为 <code>50%</code>，按可用视口高度的百分比计算窗体高度。</li>
    </ul>
</section>
}
