@page
@model FineUI.Core.Examples.Pages.Window.ToolbarModel
@{
    ViewBag.Title = "Window/Toolbar";
    var F = Html.F();
}


@section body {

    <f:Window ID="Window1" Width="650" Height="300" Icon="TagBlue" Title="窗体" EnableMaximize="true"
              EnableCollapse="false" EnableResize="true" BodyPadding="10" AutoScroll="true" IsModal="false" Content="@("<div id=\"mylabel\">这是初始值！</div>")">
        <Toolbars>
            <f:Toolbar ID="Toolbar3" Position="Top">
                <Items>
                    <f:ToolbarText Text="工具条文本一" ID="ToolbarText3">
                    </f:ToolbarText>
                    <f:ToolbarSeparator ID="ToolbarSeparator2">
                    </f:ToolbarSeparator>
                    <f:ToolbarText Text="工具条文本二" ID="ToolbarText4">
                    </f:ToolbarText>
                    <f:ToolbarSeparator ID="ToolbarSeparator1">
                    </f:ToolbarSeparator>
                    <f:Button ID="Button1" Text="工具栏按钮"></f:Button>
                </Items>
            </f:Toolbar>
            <f:Toolbar Position="Bottom" ToolbarAlign="Right">
                <Items>
                    <f:Button ID="btnChangeText" OnClick="btnChangeText_Click" Text="修改窗体内的文本值"></f:Button>
                    <f:Button ID="btnClose" OnClick="btnClose_Click" Text="关闭窗体"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Window>

}

