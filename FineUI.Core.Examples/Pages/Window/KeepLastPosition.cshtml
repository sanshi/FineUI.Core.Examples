@page
@model FineUI.Core.Examples.Pages.Window.KeepLastPositionModel
@{
    ViewBag.Title = "Window/KeepLastPosition";
    var F = Html.F();
}


@section body {

    <f:Button ID="btnShowWindowMax" Text="显示窗体（设置最大化）" ClickHandler="onOpenWindowMaximizedClick"></f:Button>
    <br />
    <br />
    <f:Button ID="btnShowWindow900" Text="显示窗体（设置大小为 900px * 450px）" ClickHandler="onOpenWindow900Click"></f:Button>
    <br />
    <br />
    <f:Button ID="btnShowWindowLargeHeight" Text="显示窗体（高度占满整个页面）" ClickHandler="onOpenWindowLargeHeightClick"></f:Button>
    <br />
    <br />
    <f:Button ID="btnShowWindow" Text="显示窗体（保持关闭时的位置和大小）" ClickHandler="onOpenWindow1Click"></f:Button>
    <br />
    <br />
    <f:Button ID="btnCloseWindow" Text="关闭窗体" ClickHandler="onCloseWindow1Click"></f:Button>
    <br />
    <br />
    <br />
    <f:Window ID="Window1" Width="650" Height="300" IconFont="_Tag" Title="窗体" Hidden="true" KeepLastPosition="true" KeepLastSize="true"
              EnableCollapse="false" EnableResize="true" IsModal="false" AutoScroll="true" BodyPadding="10" EnableMaximize="true">
        <Content>
            <p>
                <a href="http://tech.163.com/special/jobsdead/" target="_blank"><b>乔布斯</b></a>
            </p>
            <p>
                乔布斯于1955年2月24日出生，苹果创始人之一。今年8月苹果超越埃克森美孚成为全球最大市值企业，截止上季度持有现金达到762亿美金，甚至超过了美国政府国库存款。
            </p>
            <p>
                遗憾的是，苹果的取得巨大成功还是无法给乔布斯一个健康的身体，乔布斯2003年被发现患有胰脏癌，随后又查出肝癌，危在旦夕的乔布斯在经历了8年的抗癌斗争、3次病休、若干次手术后，于2011年8月25日正式宣布从CEO位置辞职。2011年10月6日，乔布斯在苹果发布iPhone 4S后的第二天与世长辞。
            </p>
        </Content>
    </f:Window>
    <br>
    <br>
    注：本示例设置了窗体的KeepLastPosition="true"和KeepLastSize="true"，关闭窗体再打开时，窗体的位置和大小保持关闭时的状态。


}

@section script {

    <script type="text/javascript">

        function onOpenWindowMaximizedClick(event) {
            F.ui.Window1.show();F.ui.Window1.maximize();
        }

        function onOpenWindow900Click(event) {
            F.ui.Window1.show(900,450);
        }

        function onOpenWindowLargeHeightClick(event) {
            F.ui.Window1.show(900,10000);
        }

        function onOpenWindow1Click(event) {
            F.ui.Window1.show();
        }

        function onCloseWindow1Click(event) {
            F.ui.Window1.hide();
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>重新打开窗体时保留上次关闭前的位置与尺寸。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-window" aria-hidden="true"></i>对照本页窗体效果</h3>
    <ul>
        <li>查看<strong class="example-control-reference" data-example-control="Window1" title="窗体">窗体</strong>。显示窗体，拖动标题栏并调整边缘大小，关闭后再点击保持关闭时位置和大小的显示按钮。<br />结果：窗体沿用关闭前的位置和尺寸；显式指定最大化或新尺寸的按钮仍按指定参数显示。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>KeepLastPosition</code>（<strong class="example-control-reference" data-example-control="Window1" title="窗体">窗体</strong>）：初始为 <code>true</code>，关闭后再次打开时，沿用关闭前的位置。</li>
        <li><code>KeepLastSize</code>（<strong class="example-control-reference" data-example-control="Window1" title="窗体">窗体</strong>）：初始为 <code>true</code>，关闭后再次打开时，沿用关闭前的尺寸。</li>
        <li><code>EnableResize</code>（<strong class="example-control-reference" data-example-control="Window1" title="窗体">窗体</strong>）：初始为 <code>true</code>，控制是否允许拖动窗体边缘调整大小。</li>
    </ul>
</section>
}
