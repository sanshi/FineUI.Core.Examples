@page
@model FineUI.Core.Examples.Pages.Window.PositionModel
@{
    ViewBag.Title = "Window/Position";
    var F = Html.F();
}


@section head {

    <style>
    body {
        background: url(@Url.Content("~/res/images/bg/small/3.jpg")) !important;
    }
    </style>


}

@section body {


    <div style="height: 1200px;">
    </div>

    <f:Window ID="Window1" Width="200" Height="80" PositionX="Left" PositionY="Top" DependsViewPortSize="false"
              IsModal="false" AutoScroll="true" BodyPadding="10" ShowHeader="false" Content="DependsViewPortSize=false PositionX=Left PositionY=Top">
    </f:Window>

    <f:Window ID="Window2" Width="200" Height="80" PositionX="Left" PositionY="Center" DependsViewPortSize="false"
              IsModal="false" AutoScroll="true" BodyPadding="10" ShowHeader="false" Content="DependsViewPortSize=false PositionX=Left PositionY=Center">
    </f:Window>

    <f:Window ID="Window3" Width="200" Height="80" PositionX="Left" PositionY="Bottom" DependsViewPortSize="false"
              IsModal="false" AutoScroll="true" BodyPadding="10" ShowHeader="false" Content="DependsViewPortSize=false PositionX=Left PositionY=Bottom">
    </f:Window>


    <f:Window ID="Window4" Width="200" Height="80" PositionX="Center" PositionY="Top" DependsViewPortSize="false"
              IsModal="false" AutoScroll="true" BodyPadding="10" ShowHeader="false" Content="DependsViewPortSize=false PositionX=Center PositionY=Top">
    </f:Window>

    <f:Window ID="Window5" Width="200" Height="80" PositionX="Center" PositionY="Center" DependsViewPortSize="false"
              IsModal="false" AutoScroll="true" BodyPadding="10" ShowHeader="false" Content="DependsViewPortSize=false PositionX=Center PositionY=Center">
    </f:Window>

    <f:Window ID="Window6" Width="200" Height="80" PositionX="Center" PositionY="Bottom" DependsViewPortSize="false"
              IsModal="false" AutoScroll="true" BodyPadding="10" ShowHeader="false" Content="DependsViewPortSize=false PositionX=Center PositionY=Bottom">
    </f:Window>

    <f:Window ID="Window7" Width="200" Height="80" PositionX="Right" PositionY="Top" DependsViewPortSize="false"
              IsModal="false" AutoScroll="true" BodyPadding="10" ShowHeader="false" Content="DependsViewPortSize=false PositionX=Right PositionY=Top">
    </f:Window>

    <f:Window ID="Window8" Width="200" Height="80" PositionX="Right" PositionY="Center" DependsViewPortSize="false"
              IsModal="false" AutoScroll="true" BodyPadding="10" ShowHeader="false" Content="DependsViewPortSize=false PositionX=Right PositionY=Center">
    </f:Window>

    <f:Window ID="Window9" Width="200" Height="80" PositionX="Right" PositionY="Bottom" DependsViewPortSize="false"
              IsModal="false" AutoScroll="true" BodyPadding="10" ShowHeader="false" Content="DependsViewPortSize=false PositionX=Right PositionY=Bottom">
    </f:Window>


}


@section exampleDescription {
<section aria-label="页面描述">
    <p>对照九宫格定位，并用较长页面区分页面区域和视口。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-window" aria-hidden="true"></i>对照本页窗体效果</h3>
    <ul>
        <li>查看<strong class="example-control-reference" data-example-control="Window1" title="第 1 个窗口">第 1 个窗口</strong>。对照各窗体正文中的 Left、Center、Right 和 Top、Center、Bottom，再滚动页面。<br />结果：各窗体按指定横纵方向定位；本页关闭视口尺寸依赖，定位范围以页面规则为准。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>PositionX</code>（<strong class="example-control-reference" data-example-control="Window1" title="第 1 个窗口">第 1 个窗口</strong>、<strong class="example-control-reference" data-example-control="Window2" title="第 2 个窗口">第 2 个窗口</strong>、<strong class="example-control-reference" data-example-control="Window3" title="第 3 个窗口">第 3 个窗口</strong>）：初始为 <code>Left</code>、<code>Center</code>、<code>Right</code>，指定窗体在水平方向的对齐位置。</li>
        <li><code>PositionY</code>（<strong class="example-control-reference" data-example-control="Window1" title="第 1 个窗口">第 1 个窗口</strong>、<strong class="example-control-reference" data-example-control="Window2" title="第 2 个窗口">第 2 个窗口</strong>、<strong class="example-control-reference" data-example-control="Window3" title="第 3 个窗口">第 3 个窗口</strong>）：初始为 <code>Top</code>、<code>Center</code>、<code>Bottom</code>，指定窗体在垂直方向的对齐位置。</li>
        <li><code>DependsViewPortSize</code>（<strong class="example-control-reference" data-example-control="Window1" title="第 1 个窗口">第 1 个窗口</strong>、<strong class="example-control-reference" data-example-control="Window2" title="第 2 个窗口">第 2 个窗口</strong>、<strong class="example-control-reference" data-example-control="Window3" title="第 3 个窗口">第 3 个窗口</strong>）：初始为 <code>false</code>，控制定位时是否以当前视口大小为依据。</li>
    </ul>
</section>
}
