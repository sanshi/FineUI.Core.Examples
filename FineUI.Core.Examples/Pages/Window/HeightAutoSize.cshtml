@page
@model FineUI.Core.Examples.Pages.Window.HeightAutoSizeModel
@{
    ViewBag.Title = "Window/HeightAutoSize";
    var F = Html.F();
}


@section body {

    <f:Button ID="btnShowWindow" Text="显示窗体" ClickHandler="onOpenWindow1Click"></f:Button>
    <br />
    <br />
    <f:Button ID="btnCloseWindow" Text="关闭窗体" ClickHandler="onCloseWindow1Click"></f:Button>
    <br>
    <br>
    注：改变页面大小，观察窗体的高度变化。

    <br>
    <br>
    <f:Window ID="Window1" Width="650" Icon="TagBlue" Title="窗体" EnableMaximize="false" EnableCollapse="false" EnableResize="false" IsModal="false"
        AutoScroll="true" BodyPadding="10" Hidden="true" KeepLastSize="true" FixedPosition="true">
        <Content>
            <p>
                <a href="http://tech.163.com/special/jobsdead/" target="_blank"><b>乔布斯</b></a>
            </p>
            <p>
                乔布斯于1955年2月24日出生，苹果创始人之一。今年8月苹果超越埃克森美孚成为全球最大市值企业，截止上季度持有现金达到762亿美金，甚至超过了美国政府国库存款。
            </p>
            <p>
                遗憾的是，苹果的取得巨大成功还是无法给乔布斯一个健康的身体，乔布斯2003年被发现患有胰脏癌，随后又查出肝癌，危在旦夕的乔布斯在经历了8年的抗癌斗争、3次病休、若干次手术后，于2011年8月25日正式宣布从CEO位置辞职。2011年10月6日，乔布斯在苹果发布iPhone
                4S后的第二天与世长辞。
            </p>
        </Content>
    </f:Window>



}


@section script {

    <script>

        F.ready(function () {

            var window1 = F.ui.Window1; if (!window1) return;

            function resetWindow1Height() {

                // 清空左上角定位
                window1.top = undefined;
                window1.left = undefined;

                // 改变高度
                window1.setHeight($(window).height() - 50);

            }

            // 页面加载完毕后，首先对窗体进行高度设置
            resetWindow1Height();

            // 页面大小改变事件
            F.windowResize(function () {

                resetWindow1Height();

            });

        });

        function onOpenWindow1Click(event) {
            F.ui.Window1.show();
        }

        function onCloseWindow1Click(event) {
            F.ui.Window1.hide();
        }

    </script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>显示窗体时按页面可用高度计算尺寸，让较长内容在窗体内滚动。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-window" aria-hidden="true"></i>对照本页窗体效果</h3>
        <ul>
            <li>查看<strong class="example-control-reference" data-example-control="Window1" title="窗体">窗体</strong>。<strong class="example-control-reference"
                    data-example-control="btnShowWindow" title="显示窗体">显示窗体</strong>，再调整浏览器窗口高度。<br />结果：窗体按本页脚本计算的可用高度显示，内容超出时在窗体内滚动。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <ul>
            <li>窗体设置KeepLastSize=true，以便在窗体处于隐藏状态时，改变其高度有效</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>KeepLastSize</code>（<strong class="example-control-reference" data-example-control="Window1" title="窗体">窗体</strong>）：初始为
                <code>true</code>，关闭后再次打开时，沿用关闭前的尺寸。
            </li>
            <li><code>FixedPosition</code>（<strong class="example-control-reference" data-example-control="Window1" title="窗体">窗体</strong>）：初始为
                <code>true</code>，采用固定定位，页面滚动时保持相对视口的位置。
            </li>
            <li><code>AutoScroll</code>（<strong class="example-control-reference" data-example-control="Window1" title="窗体">窗体</strong>）：初始为
                <code>true</code>，内容超出可用区域时允许在控件内滚动。
            </li>
            <li><code>show()</code>（<strong class="example-control-reference" data-example-control="Window1" title="窗体">窗体</strong>）：显示前由客户端脚本根据页面高度传入窗体尺寸。</li>
        </ul>
    </section>
}
