@page
@model FineUI.Core.Examples.Pages.Window.MaximizedFixedModel
@{
    ViewBag.Title = "Window/MaximizedFixed";
    var F = Html.F();
}


@section body {

    <f:Button ID="btnShowWindowMax" Text="显示窗体（设置最大化）" ClickHandler="onOpenWindowMaximizedClick"></f:Button>
    <br />
    <br />
    <f:Button ID="btnShowWindow900" Text="显示窗体（设置大小为 900px * 450px）" ClickHandler="onOpenWindow900Click"></f:Button>
    <br />
    <br />
    <f:Button ID="btnShowWindowLargeHeight" Text="显示窗体（高度占满整个页面）" ClickHandler="onOpenWindowLargeHeightClick"></f:Button>
    <br />
    <br />
    <f:Button ID="btnShowWindow" Text="显示窗体（使用初始值）" ClickHandler="onOpenWindow1Click"></f:Button>
    <br />
    <br />
    <f:Button ID="btnCloseWindow" Text="关闭窗体" ClickHandler="onCloseWindow1Click"></f:Button>
    <br />
    <br />
    <br />
    <f:Window ID="Window1" Width="650" Height="300" IconFont="_Tag" Title="窗体" EnableCollapse="false" EnableResize="true" IsModal="false" AutoScroll="true"
        BodyPadding="10" EnableMaximize="false" Maximized="true">
        <Content>
            <p>
                <a href="http://tech.163.com/special/jobsdead/" target="_blank"><b>乔布斯</b></a>
            </p>
            <p>
                乔布斯于1955年2月24日出生，苹果创始人之一。今年8月苹果超越埃克森美孚成为全球最大市值企业，截止上季度持有现金达到762亿美金，甚至超过了美国政府国库存款。
            </p>
            <p>
                遗憾的是，苹果的取得巨大成功还是无法给乔布斯一个健康的身体，乔布斯2003年被发现患有胰脏癌，随后又查出肝癌，危在旦夕的乔布斯在经历了8年的抗癌斗争、3次病休、若干次手术后，于2011年8月25日正式宣布从CEO位置辞职。2011年10月6日，乔布斯在苹果发布iPhone
                4S后的第二天与世长辞。
            </p>
        </Content>
    </f:Window>



}

@section script {

    <script type="text/javascript">

        function onOpenWindowMaximizedClick(event) {
            F.ui.Window1.show();F.ui.Window1.maximize();
        }

        function onOpenWindow900Click(event) {
            F.ui.Window1.show(900,450);
        }

        function onOpenWindowLargeHeightClick(event) {
            F.ui.Window1.show(900,10000);
        }

        function onOpenWindow1Click(event) {
            F.ui.Window1.show();
        }

        function onCloseWindow1Click(event) {
            F.ui.Window1.hide();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>让窗体保持初始最大化，隐藏标题栏的最大化切换入口。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-window" aria-hidden="true"></i>对照本页窗体效果</h3>
        <ul>
            <li>查看<strong class="example-control-reference" data-example-control="Window1"
                    title="窗体">窗体</strong>。查看窗体标题栏，并尝试与可还原的最大化示例对照。<br />结果：窗体初次占满可用区域，标题栏不提供还原图标。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Maximized</code>（<strong class="example-control-reference" data-example-control="Window1" title="窗体">窗体</strong>）：初始为
                <code>true</code>，控制窗体初次显示时是否最大化。
            </li>
            <li><code>EnableMaximize</code>（<strong class="example-control-reference" data-example-control="Window1" title="窗体">窗体</strong>）：初始为
                <code>false</code>，控制标题栏是否显示最大化与还原入口。
            </li>
        </ul>
    </section>
}
