@page
@model FineUI.Core.Examples.Pages.Window.FixedPositionModel
@{
    ViewBag.Title = "Window/FixedPosition";
    var F = Html.F();
}

@section head {

    <style>
    body {
        background: url(@Url.Content("~/res/images/bg/small/3.jpg")) !important;
    }
    </style>


}

@section body {


    <div style="height: 1200px;">
    </div>


    <f:Window ID="Window1" Width="200" Height="80" PositionX="Left" PositionY="Top" FixedPosition="true" IsModal="false" AutoScroll="true" BodyPadding="10"
        ShowHeader="false" Content="FixedPosition=true PositionX=Left PositionY=Top">
    </f:Window>

    <f:Window ID="Window2" Width="200" Height="80" PositionX="Left" PositionY="Center" FixedPosition="true" IsModal="false" AutoScroll="true" BodyPadding="10"
        ShowHeader="false" Content="FixedPosition=true PositionX=Left PositionY=Center">
    </f:Window>

    <f:Window ID="Window3" Width="200" Height="80" PositionX="Left" PositionY="Bottom" FixedPosition="true" IsModal="false" AutoScroll="true" BodyPadding="10"
        ShowHeader="false" Content="FixedPosition=true PositionX=Left PositionY=Bottom">
    </f:Window>


    <f:Window ID="Window4" Width="200" Height="80" PositionX="Center" PositionY="Top" FixedPosition="true" IsModal="false" AutoScroll="true" BodyPadding="10"
        ShowHeader="false" Content="FixedPosition=true PositionX=Center PositionY=Top">
    </f:Window>

    <f:Window ID="Window5" Width="200" Height="80" PositionX="Center" PositionY="Center" FixedPosition="true" IsModal="false" AutoScroll="true" BodyPadding="10"
        ShowHeader="false" Content="FixedPosition=true PositionX=Center PositionY=Center">
    </f:Window>

    <f:Window ID="Window6" Width="200" Height="80" PositionX="Center" PositionY="Bottom" FixedPosition="true" IsModal="false" AutoScroll="true" BodyPadding="10"
        ShowHeader="false" Content="FixedPosition=true PositionX=Center PositionY=Bottom">
    </f:Window>

    <f:Window ID="Window7" Width="200" Height="80" PositionX="Right" PositionY="Top" FixedPosition="true" IsModal="false" AutoScroll="true" BodyPadding="10"
        ShowHeader="false" Content="FixedPosition=true PositionX=Right PositionY=Top">
    </f:Window>

    <f:Window ID="Window8" Width="200" Height="80" PositionX="Right" PositionY="Center" FixedPosition="true" IsModal="false" AutoScroll="true" BodyPadding="10"
        ShowHeader="false" Content="FixedPosition=true PositionX=Right PositionY=Center">
    </f:Window>

    <f:Window ID="Window9" Width="200" Height="80" PositionX="Right" PositionY="Bottom" FixedPosition="true" IsModal="false" AutoScroll="true" BodyPadding="10"
        ShowHeader="false" Content="FixedPosition=true PositionX=Right PositionY=Bottom">
    </f:Window>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>对照固定定位的九种横纵组合，滚动时保持相对视口的位置。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-window" aria-hidden="true"></i>对照本页窗体效果</h3>
        <ul>
            <li>查看<strong class="example-control-reference" data-example-control="Window1" title="第 1 个窗口">第 1
                    个窗口</strong>。滚动页面，比较各窗体相对浏览器边缘的位置。<br />结果：各窗体不随页面内容滚走，仍保持本页指定的左中右与上中下组合。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>PositionX</code>（<strong class="example-control-reference" data-example-control="Window1" title="第 1 个窗口">第 1 个窗口</strong>、<strong
                    class="example-control-reference" data-example-control="Window2" title="第 2 个窗口">第 2 个窗口</strong>、<strong class="example-control-reference"
                    data-example-control="Window3" title="第 3 个窗口">第 3 个窗口</strong>）：初始为
                <code>Left</code>、<code>Center</code>、<code>Right</code>，指定窗体在水平方向的对齐位置。
            </li>
            <li><code>PositionY</code>（<strong class="example-control-reference" data-example-control="Window1" title="第 1 个窗口">第 1 个窗口</strong>、<strong
                    class="example-control-reference" data-example-control="Window2" title="第 2 个窗口">第 2 个窗口</strong>、<strong class="example-control-reference"
                    data-example-control="Window3" title="第 3 个窗口">第 3 个窗口</strong>）：初始为
                <code>Top</code>、<code>Center</code>、<code>Bottom</code>，指定窗体在垂直方向的对齐位置。
            </li>
            <li><code>FixedPosition</code>（<strong class="example-control-reference" data-example-control="Window1" title="第 1 个窗口">第 1 个窗口</strong>、<strong
                    class="example-control-reference" data-example-control="Window2" title="第 2 个窗口">第 2 个窗口</strong>、<strong class="example-control-reference"
                    data-example-control="Window3" title="第 3 个窗口">第 3 个窗口</strong>）：初始为 <code>true</code>，采用固定定位，页面滚动时保持相对视口的位置。</li>
        </ul>
    </section>
}
