@page
@model FineUI.Core.Examples.Pages.FormTable.TableStyleFormCompareModel
@{
    ViewBag.Title = "FormTable/TableStyleFormCompare";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" LabelWidth="200" EnableCollapse="false" ShowBorder="true" ShowHeader="true" MessageTarget="Qtip" Title="简单表单">
        <Items>
            <f:SimpleForm ID="SimpleForm3" ShowBorder="false" ShowHeader="false" EnableTableStyle="true" MarginBottom="10">
                <Items>
                    <f:DatePicker ID="DatePicker1" Label="开始日期" Required="true">
                    </f:DatePicker>
                    <f:DatePicker ID="DatePicker2" Label="结束日期（大于开始日期）" Required="true" CompareControl="DatePicker1" CompareOperator="GreaterThan" CompareMessage="结束日期应该大于开始日期！">
                    </f:DatePicker>
                </Items>
            </f:SimpleForm>
            <f:SimpleForm ID="SimpleForm2" ShowBorder="false" ShowHeader="false" EnableTableStyle="true" MarginBottom="10">
                <Items>
                    <f:TextBox ID="TextBox1" Required="true" Label="文本框 1" Text="FineUI.Core">
                    </f:TextBox>
                    <f:TextBox ID="TextBox2" Required="true" Label="文本框 2（等于文本框 1）" CompareControl="TextBox1" CompareOperator="Equal" CompareMessage="文本框 2 应该等于文本框 1！">
                    </f:TextBox>
                </Items>
            </f:SimpleForm>
            <f:SimpleForm ID="SimpleForm4" ShowBorder="false" ShowHeader="false" EnableTableStyle="true" MarginBottom="10">
                <Items>
                    <f:NumberBox ID="NumberBox1" Required="true" Label="数字框 1" Text="30">
                    </f:NumberBox>
                    <f:NumberBox ID="NumberBox2" Required="true" Label="数字框 2（大于等于数字框 1）" CompareControl="NumberBox1" CompareOperator="GreaterThanEqual" CompareMessage="数字框 2 应该大于等于数字框 1!">
                    </f:NumberBox>
                </Items>
            </f:SimpleForm>
            <f:SimpleForm ID="SimpleForm5" ShowBorder="false" ShowHeader="false" EnableTableStyle="true">
                <Items>
                    <f:Label ID="Label1" Label="标签 1" Text="88">
                    </f:Label>
                    <f:NumberBox ID="NumberBox3" Required="true" Label="文本框 3（大于等于标签 1）" CompareControl="Label1" CompareOperator="GreaterThanEqual" CompareType="Int" CompareMessage="文本框 3 应该大于等于标签 1！">
                    </f:NumberBox>
                </Items>
            </f:SimpleForm>
        </Items>
        <Toolbars>
            <f:Toolbar Position="Bottom">
                <Items>
                    <f:Button ID="btnSubmit" OnClick="btnSubmit_Click" _ValidateForms="SimpleForm1" CssClass="marginr" Text="提交表单"></f:Button>
                    <f:Button ID="btnReset" Text="重置表单" ClickHandler="onResetClick"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:SimpleForm>

}

@section script {

    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示表格风格中标签、输入区域和单元格边线的对齐。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照表格风格的字段排列</h3>
        <ol>
            <li>
                对照本页各组字段的标签区域、输入区域与单元格边线。<br />
                结果：不同字段放在各自单元格中，标签与输入区按表格布局对齐；操作按钮保留在原来的位置。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableTableStyle</code>：各组比较字段放在独立的表格风格表单中。</li>
        </ul>
    </section>
}
