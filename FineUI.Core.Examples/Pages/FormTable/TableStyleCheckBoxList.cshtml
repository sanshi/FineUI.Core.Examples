@page
@model FineUI.Core.Examples.Pages.FormTable.TableStyleCheckBoxListModel
@{
    ViewBag.Title = "FormTable/TableStyleCheckBoxList";
    var F = Html.F();
}


@section body {

    <f:SimpleForm ID="SimpleForm1" IsFluid="true" LabelWidth="160" EnableCollapse="false" BodyPadding="10" ShowBorder="true" ShowHeader="true"
        MessageTarget="Qtip" Title="简单表单">
        <Items>
            <f:SimpleForm ID="SimpleForm3" ShowBorder="false" ShowHeader="false" EnableTableStyle="true">
                <Items>
                    <f:CheckBoxList ID="CheckBoxList1" Label="列表一">
                        <f:CheckItem Text="可选项 1" Value="value1" />
                        <f:CheckItem Text="可选项 2" Value="value2" Selected="true" />
                        <f:CheckItem Text="可选项 3" Value="value3" Selected="true" />
                    </f:CheckBoxList>
                </Items>
            </f:SimpleForm>
            <f:Panel ShowBorder="false" ShowHeader="false" MarginTop="5" MarginBottom="5">
                <Items>
                    <f:Button ID="btnServerSetSelectedValue" CssClass="marginr" Text="选中上面列表中的第一项和第三项" OnClick="btnServerSetSelectedValue_Click"></f:Button>
                    <f:Button ID="btnServerGetSelectedValue" CssClass="marginr" Text="获取上面列表的选中项" OnClick="btnServerGetSelectedValue_Click"></f:Button>
                    <f:Button ID="btnClientGetSelectedValue" Text="获取上面列表的选中项（JavaScript 脚本）" ClickHandler="onAlertSelectedValueClick"></f:Button>
                </Items>
            </f:Panel>

            <f:SimpleForm ID="SimpleForm2" ShowBorder="false" ShowHeader="false" EnableTableStyle="true">
                <Items>
                    <f:CheckBoxList ID="CheckBoxList2" Label="列表二（一列）" ColumnNumber="1">
                    </f:CheckBoxList>
                    <f:CheckBoxList ID="RadioButtonList3" Label="列表二（三列）" ColumnNumber="3">
                        <f:CheckItem Text="可选项 1" Value="value1" />
                        <f:CheckItem Text="可选项 2" Value="value2" />
                    </f:CheckBoxList>
                    <f:CheckBoxList ID="CheckBoxList3" OnSelectedIndexChanged="CheckBoxList3_SelectedIndexChanged" Label="列表三（选中改变事件）" ColumnNumber="3"
                        ShowRedStar="true" Required="true">
                        <f:CheckItem Text="可选项 1（很长很长很长很长很长很长的可选项）" Value="value1" />
                        <f:CheckItem Text="可选项 2" Value="value2" />
                        <f:CheckItem Text="可选项 3" Value="value3" />
                        <f:CheckItem Text="可选项 4" Value="value4" />
                        <f:CheckItem Text="可选项 5" Value="value5" />
                        <f:CheckItem Text="可选项 6" Value="value6" />
                        <f:CheckItem Text="可选项 7" Value="value7" />
                        <f:CheckItem Text="可选项 8" Value="value8" />
                    </f:CheckBoxList>
                    <f:CheckBoxList ID="CheckBoxList4" Label="列表四（竖排）" ColumnNumber="3" ColumnVertical="true" ShowRedStar="true" Required="true">
                        <f:CheckItem Text="可选项 1" Value="value1" />
                        <f:CheckItem Text="可选项 2" Value="value2" />
                        <f:CheckItem Text="可选项 3" Value="value3" />
                        <f:CheckItem Text="可选项 4" Value="value4" />
                        <f:CheckItem Text="可选项 5" Value="value5" />
                        <f:CheckItem Text="可选项 6" Value="value6" />
                        <f:CheckItem Text="可选项 7" Value="value7" />
                        <f:CheckItem Text="可选项 8" Value="value8" />
                    </f:CheckBoxList>
                </Items>
            </f:SimpleForm>
        </Items>
        <Toolbars>
            <f:Toolbar Position="Bottom" ToolbarAlign="Right">
                <Items>
                    <f:Button ID="btnSubmit" _ValidateForms="SimpleForm1" Text="提交表单" OnClick="btnSubmit_Click"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:SimpleForm>

}



@section script {
    <script type="text/javascript">

        function onAlertSelectedValueClick(event) {
            var list1 = F.ui.CheckBoxList1;

            var selectedValues = list1.getValue();
            if (selectedValues.length) {
                top.F.alert("列表一的选中项：" + selectedValues.join(','));
            } else {
                top.F.alert("列表一没有选中项！");
            }
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示表格风格中标签、输入区域和单元格边线的对齐。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照表格风格的字段排列</h3>
        <ol>
            <li>
                对照本页各组字段的标签区域、输入区域与单元格边线。<br />
                结果：不同字段放在各自单元格中，标签与输入区按表格布局对齐；操作按钮保留在原来的位置。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableTableStyle</code>（<strong class="example-control-reference" data-example-control="SimpleForm3" title="第 2 个表单">第 2
                    个表单</strong>、<strong class="example-control-reference" data-example-control="SimpleForm2" title="第 3 个表单">第 3
                    个表单</strong>）：嵌套的表单启用表格风格，列表仍可独立设置。</li>
        </ul>
    </section>
}
