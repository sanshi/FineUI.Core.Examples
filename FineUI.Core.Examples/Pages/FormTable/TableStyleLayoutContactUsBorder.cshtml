@page
@model FineUI.Core.Examples.Pages.FormTable.TableStyleLayoutContactUsBorderModel
@{
    ViewBag.Title = "FormTable/TableStyleLayoutContactUsBorder";
    var F = Html.F();
}

@section head {

    <link href="~/res/css/tablestyle-noborder.css" rel="stylesheet" />

}

@section body {

    <f:Window ID="Window1" Title="联系我们" IsModal="false" EnableClose="false" EnableResize="true" Width="550" AutoScroll="true" BodyPadding="0">
        <Items>
            <f:Form ID="Form1" ShowBorder="false" ShowHeader="false" EnableTableStyle="true" MessageTarget="Qtip">
                <Items>
                    <f:Panel ID="Panel2" Layout="Column" ShowHeader="false" ShowBorder="false">
                        <Items>
                            <f:TextBox ID="TextBox2" Label="姓" Margin="0 5 0 0" Required="true" ShowRedStar="true" ColumnWidth="50%">
                            </f:TextBox>
                            <f:TextBox ID="TextBox4" Label="名" Required="true" ShowRedStar="true" ColumnWidth="50%">
                            </f:TextBox>
                        </Items>
                    </f:Panel>
                    <f:TextBox ID="TextBox1" Required="true" ShowRedStar="true" Label="电子邮箱" RegexPattern="EMAIL" RegexMessage="请输入有效的邮箱地址">
                    </f:TextBox>
                    <f:TextBox ID="TextBox3" Required="true" ShowRedStar="true" Label="主题">
                    </f:TextBox>
                    <f:TextArea ID="TextArea1" Height="120" Required="true" ShowRedStar="true" Label="消息正文">
                    </f:TextArea>
                </Items>
            </f:Form>
        </Items>
        <Toolbars>
            <f:Toolbar ID="Toolbar1" ToolbarAlign="Right" Position="Bottom">
                <Items>
                    <f:Button ID="btnSubmit" Text="发送" IconFont="_Send" OnClick="btnSubmit_Click"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
    </f:Window>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示把联系表单的字段组织成表格风格的标签与输入区域。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>对照字段排列</h3>
        <ol>
            <li>
                在<strong class="example-control-reference" data-example-control="TextBox2" title="姓">姓</strong>、<strong class="example-control-reference" data-example-control="TextBox4" title="名">名</strong>填写联系人，邮箱输入 <code>reader</code>&#64;<code>example.com</code>，填写主题和<strong class="example-control-reference" data-example-control="TextArea1" title="消息正文">消息正文</strong>。<br />
                结果：姓名字段并排，其余字段纵向排列；本页通过样式去掉单元格边框。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ColumnWidth</code>（<strong class="example-control-reference" data-example-control="TextBox2" title="姓">姓</strong>、<strong class="example-control-reference" data-example-control="TextBox4" title="名">名</strong>）：姓与名各占一半宽度。</li>
            <li><code>EnableTableStyle</code>（<strong class="example-control-reference" data-example-control="Form1" title="表单">表单</strong>）：启用表格风格；去边框页另外通过本页 CSS 修改单元格边线。</li>
            <li><code>border-width</code>（<strong class="example-control-reference" data-example-control="Form1" title="表单">表单</strong>）：本页的表格风格补充样式去掉字段边线，保留原来的布局结构。</li>
        </ul>
    </section>
}
