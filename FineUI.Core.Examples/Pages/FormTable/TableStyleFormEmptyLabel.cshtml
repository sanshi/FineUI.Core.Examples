@page
@model FineUI.Core.Examples.Pages.FormTable.TableStyleFormEmptyLabelModel
@{
    ViewBag.Title = "FormTable/TableStyleFormEmptyLabel";
    var F = Html.F();
}


@section body {

    <f:Form ID="Form1" IsFluid="true" ShowBorder="false" ShowHeader="false" EnableTableStyle="true" MessageTarget="Qtip">
        <Rows>
            <f:FormRow>
                <Items>
                    <f:Label ID="Label3" Label="电话" Text="0551-1234567" />
                    <f:Label ID="Label16" Label="申请人" Text="admin">
                    </f:Label>
                </Items>
            </f:FormRow>
            <f:FormRow>
                <Items>
                    <f:Label ID="Label4" Label="编号" Text="200804170006" />
                    <f:Label></f:Label>
                </Items>
            </f:FormRow>
            <f:FormRow>
                <Items>
                    <f:DropDownList ID="DropDownList3" Label="审批人" ForceSelection="false" Required="true" ShowRedStar="true" EmptyText="请选择审批人" AutoSelectFirstItem="false">
                        <f:ListItem Text="老大甲" Value="0"></f:ListItem>
                        <f:ListItem Text="老大乙" Value="1"></f:ListItem>
                        <f:ListItem Text="老大丙" Value="2"></f:ListItem>
                    </f:DropDownList>
                </Items>
            </f:FormRow>
            <f:FormRow>
                <Items>
                    <f:NumberBox ID="NumberBox1" Label="申请数量" NoDecimal="true" NoNegative="true" MaxValue="1000" Required="true" ShowRedStar="true" />
                </Items>
            </f:FormRow>
            <f:FormRow>
                <Items>
                    <f:TextArea ID="TextArea1" Label="描述" ShowRedStar="true" Required="true">
                    </f:TextArea>
                </Items>
            </f:FormRow>
        </Rows>
    </f:Form>
    <f:Button ID="btnSubmitForm1" Text="验证此表单并提交" CssClass="marginr" OnClick="btnSubmitForm1_Click" _ValidateForms="Form1" MarginTop="5"></f:Button>
    <br />
    <br />
    <f:Form ID="Form2" IsFluid="true" ShowBorder="false" ShowHeader="false" Layout="HBox" EnableTableStyle="true" MessageTarget="Qtip">
        <Items>
            <f:Panel ShowBorder="false" ShowHeader="false" BoxFlex="1" Layout="VBox">
                <Items>
                    <f:TextBox Required="true" Label="国家"></f:TextBox>
                    <f:TextBox Required="true" Label="邮编"></f:TextBox>
                </Items>
            </f:Panel>
            <f:Panel ShowBorder="false" ShowHeader="false" BoxFlex="1" Layout="VBox">
                <Items>
                    <f:TextBox Required="true" Label="省份"></f:TextBox>
                    <f:TextBox Required="true" Label="城市"></f:TextBox>
                </Items>
            </f:Panel>
            <f:Panel ShowBorder="false" ShowHeader="false" BoxFlex="1" Layout="VBox">
                <Items>
                    <f:TextBox Required="true" Label="地址"></f:TextBox>
                    <f:Label></f:Label>
                </Items>
            </f:Panel>
        </Items>
    </f:Form>
    <f:Button ID="btnSubmitForm2" Text="验证此表单并提交" CssClass="marginr" OnClick="btnSubmitForm2_Click" _ValidateForms="Form2" MarginTop="5"></f:Button>

}

