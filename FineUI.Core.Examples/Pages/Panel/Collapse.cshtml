@page
@model FineUI.Core.Examples.Pages.Panel.CollapseModel
@{
    ViewBag.Title = "Panel/Collapse";
    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel1" IsFluid="true" Title="面板一" BodyPadding="10" EnableCollapse="true" IconUrl="@Url.Content("~/res/images/16/8.png")"
             OnCollapse="Panel1_CollapseExpand" OnExpand="Panel1_CollapseExpand">
        <Items>
            <f:Panel ID="Panel2" Title="面板二" ShowBorder="true" Height="200" BodyPadding="10" EnableCollapse="true" ShowHeader="true" Content="展开折叠这两个面板。"
                     OnCollapse="Panel2_CollapseExpand" OnExpand="Panel2_CollapseExpand">
            </f:Panel>
        </Items>
    </f:Panel>

}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示分别监听嵌套面板的展开和折叠事件，并读取事件发生后的状态。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>核对两个面板的状态</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Panel1" title="面板一">面板一</strong>及其内部面板中点击折叠图标，再分别展开。<br />结果：每次状态变化触发对应面板事件并回发，后台提示面板名称与展开或折叠状态。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>OnCollapse</code>（<strong class="example-control-reference" data-example-control="Panel1" title="面板一">面板一</strong>、<strong class="example-control-reference" data-example-control="Panel2" title="面板二">面板二</strong>）：对应面板折叠后处理当前状态。</li>
        <li><code>OnExpand</code>（<strong class="example-control-reference" data-example-control="Panel1" title="面板一">面板一</strong>、<strong class="example-control-reference" data-example-control="Panel2" title="面板二">面板二</strong>）：对应面板展开后处理当前状态。</li>
    </ul>
</section>
}
