@page
@model FineUI.Core.Examples.Pages.Panel.DisabledModel
@{
    ViewBag.Title = "Panel/Disabled";
    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel1" IsFluid="true" Title="面板" Enabled="false" BodyPadding="10" EnableCollapse="false" IconFont="_VolumeUp">
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Position="Bottom">
                <Items>
                    <f:ToolbarText Text="工具条文本一" ID="ToolbarText1">
                    </f:ToolbarText>
                    <f:ToolbarSeparator ID="ToolbarSeparator1">
                    </f:ToolbarSeparator>
                    <f:ToolbarText Text="工具条文本二" ID="ToolbarText2">
                    </f:ToolbarText>
                    <f:ToolbarSeparator ID="ToolbarSeparator2">
                    </f:ToolbarSeparator>
                    <f:Button ID="btnToolbarButton" Text="工具条按钮"></f:Button>
                    <f:ToolbarFill ID="ToolbarFill1">
                    </f:ToolbarFill>
                    <f:ToolbarText Text="工具条文本四" ID="ToolbarText4">
                    </f:ToolbarText>
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:Panel ID="Panel2" Title="内容面板" ShowBorder="true" Height="200" BodyPadding="10" EnableCollapse="false" ShowHeader="true">
            </f:Panel>
        </Items>
    </f:Panel>
    <br />

    <f:Button ID="Button2" CssClass="marginr" Text="启用/禁用面板" OnClick="Button2_Click"></f:Button>



}


@section script {

    <script>

        function onToolbarButtonClick(event) {
            F.alert("你点击了工具栏按钮");
        }

    </script>
}
