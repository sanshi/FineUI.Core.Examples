@page
@model FineUI.Core.Examples.Pages.Panel.DisabledModel
@{
    ViewBag.Title = "Panel/Disabled";
    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel1" IsFluid="true" Title="面板" Enabled="false" BodyPadding="10" EnableCollapse="false" IconFont="_VolumeUp">
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Position="Bottom">
                <Items>
                    <f:ToolbarText Text="工具条文本一" ID="ToolbarText1">
                    </f:ToolbarText>
                    <f:ToolbarSeparator ID="ToolbarSeparator1">
                    </f:ToolbarSeparator>
                    <f:ToolbarText Text="工具条文本二" ID="ToolbarText2">
                    </f:ToolbarText>
                    <f:ToolbarSeparator ID="ToolbarSeparator2">
                    </f:ToolbarSeparator>
                    <f:Button ID="btnToolbarButton" Text="工具条按钮"></f:Button>
                    <f:ToolbarFill ID="ToolbarFill1">
                    </f:ToolbarFill>
                    <f:ToolbarText Text="工具条文本四" ID="ToolbarText4">
                    </f:ToolbarText>
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:Panel ID="Panel2" Title="内容面板" ShowBorder="true" Height="200" BodyPadding="10" EnableCollapse="false" ShowHeader="true">
            </f:Panel>
        </Items>
    </f:Panel>
    <br />

    <f:Button ID="Button2" CssClass="marginr" Text="启用/禁用面板" OnClick="Button2_Click"></f:Button>



}


@section script {

    <script>

        function onToolbarButtonClick(event) {
            F.alert("你点击了工具栏按钮");
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示初始禁用整个面板，并由面板外的按钮恢复或再次禁用。</p>
    <h3><i class="f-iconfont f-iconfont-check" aria-hidden="true"></i>切换整个面板的可用状态</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="Button2" title="启用/禁用面板">启用/禁用面板</strong>。<br />结果：后台启用原先禁用的面板，内部工具栏和内容恢复可操作。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button2" title="启用/禁用面板">启用/禁用面板</strong>。<br />结果：整个面板再次禁用，内部控件不再接受普通用户操作，内容仍保留。</li>
    </ol>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Enabled</code>（<strong class="example-control-reference" data-example-control="Panel1" title="面板">面板</strong>）：外层面板初始设为 <code>false</code>，影响它内部的交互区域。 本页使用<code>false</code>。</li>
    </ul>
</section>
}
