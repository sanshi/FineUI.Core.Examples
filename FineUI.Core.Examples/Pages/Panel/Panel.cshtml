@page
@model FineUI.Core.Examples.Pages.Panel.PanelModel
@{
    ViewBag.Title = "Panel/Panel";
    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel1" IsFluid="true" Title="面板" BodyPadding="10" EnableCollapse="true" IconFont="_VolumeUp">
        <Toolbars>
            <f:Toolbar ID="Toolbar1" Position="Top">
                <Items>
                    <f:ToolbarText Text="工具条文本一" ID="ToolbarText1">
                    </f:ToolbarText>
                    <f:ToolbarSeparator ID="ToolbarSeparator1">
                    </f:ToolbarSeparator>
                    <f:ToolbarText Text="工具条文本二" ID="ToolbarText2">
                    </f:ToolbarText>
                    <f:ToolbarSeparator ID="ToolbarSeparator2">
                    </f:ToolbarSeparator>
                    <f:Button ID="btnToolbarButton" Text="工具条按钮" ClickHandler="onToolbarButtonClick"></f:Button>
                    <f:ToolbarFill ID="ToolbarFill1">
                    </f:ToolbarFill>
                    <f:ToolbarText Text="工具条文本四" ID="ToolbarText4">
                    </f:ToolbarText>
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Items>
            <f:Panel ID="Panel2" Title="内容面板" ShowBorder="true" Height="200" Icon="TagBlue"
                     BodyPadding="10" EnableCollapse="true" ShowHeader="true" AutoScroll="true">
            </f:Panel>
        </Items>
    </f:Panel>
    <br>

    <f:Button ID="Button2" CssClass="marginr" Text="检查面板的折叠状态" OnClick="Button2_Click"></f:Button>
    <f:Button ID="Button4" Text="更新面板的标题" OnClick="Button4_Click"></f:Button>
    <br />
    <br />
    <f:Button ID="Button3" Text="展开/折叠内容面板" OnClick="Button3_Click"></f:Button>
    <br />
    <br />
    <f:Button ID="Button5" CssClass="marginr" Text="更新工具条文本一的值" OnClick="Button5_Click"></f:Button>
    <f:Button ID="Button6" Text="显示/隐藏工具条文本一" OnClick="Button6_Click"></f:Button>
    <br />
    <br />


    <f:Button ID="Button7" Text="隐藏工具栏" CssClass="marginr" OnClick="Button7_Click"></f:Button>
    <f:Button ID="Button8" Text="显示工具栏" OnClick="Button8_Click"></f:Button>
    <br />
    <br />
    <f:Button ID="Button9" Text="点击修改面板图标（在三个图标之前切换）" CssClass="marginr" OnClick="Button9_Click"></f:Button>
    <f:Button ID="Button10" Text="清空面板图标" CssClass="marginr" OnClick="Button10_Click"></f:Button>
    <br />
    <br />
    <f:Button CssClass="marginr" ID="btnRichToolbarText" Text="显示工具条HTML状态" OnClick="btnRichToolbarText_Click"></f:Button>
    <f:Button CssClass="marginr" ID="btnPlainToolbarText" Text="改为普通文本" OnClick="btnPlainToolbarText_Click"></f:Button>
    <f:Button CssClass="marginr" ID="btnClearToolbarText" Text="清空工具条文字" OnClick="btnClearToolbarText_Click"></f:Button>
    <f:Button ID="btnReadToolbarText" Text="读取工具条文字" OnClick="btnReadToolbarText_Click"></f:Button>
    <br />
    <br />
    <f:Label ID="labToolbarText" EncodeText="true" ShowLabel="false"></f:Label>



}


@section script {

    <script>

        function onToolbarButtonClick(event) {
            F.alert('你点击了工具栏按钮');
        }

    </script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>演示面板的折叠、标题与图标更新，以及工具栏项目的显示和文字更新。</p>
    <h3><i class="f-iconfont f-iconfont-layout" aria-hidden="true"></i>折叠和更新面板</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="Button3" title="展开/折叠内容面板">展开/折叠内容面板</strong>。<br />结果：后台切换内容面板的展开状态，外层面板与其它工具栏项目继续保留。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button2" title="检查面板的折叠状态">检查面板的折叠状态</strong>。<br />结果：读取目标面板当前状态并显示提示。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button4" title="更新面板的标题">更新面板的标题</strong>。<br />结果：后台替换面板标题文字，面板内容继续保留。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-refresh" aria-hidden="true"></i>更新工具栏项目</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="Button5" title="更新工具条文本一的值">更新工具条文本一的值</strong>。<br />结果：后台把新的时间文字写入原工具栏文本项。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button6" title="显示/隐藏工具条文本一">显示/隐藏工具条文本一</strong>。<br />结果：切换文本项显示状态，其余项目重新分配空间。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button7" title="隐藏工具栏">隐藏工具栏</strong>。<br />结果：隐藏整个工具栏；点击显示工具栏可恢复。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-pic" aria-hidden="true"></i>切换图标与可信文字</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="Button9" title="点击修改面板图标（在三个图标之前切换）">点击修改面板图标（在三个图标之前切换）</strong>。<br />结果：在本页准备的三个图标之间切换；清空图标按钮可移除当前图标。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnRichToolbarText" title="显示工具条HTML状态">显示工具条HTML状态</strong>。<br />结果：把固定可信 HTML 写入工具栏文本项；切回普通文本或清空时沿用同一项目。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnReadToolbarText" title="读取工具条文字">读取工具条文字</strong>。<br />结果：显示当前文本及是否使用可信 HTML 的状态。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableCollapse</code>（<strong class="example-control-reference" data-example-control="Panel1" title="面板">面板</strong>）：开启标题栏的折叠入口。 本页使用<code>true</code>。</li>
        <li><code>Collapsed</code>（<strong class="example-control-reference" data-example-control="Panel1" title="面板">面板</strong>）：表示当前是否折叠，与整个面板是否隐藏不同。</li>
        <li><code>Title</code>（<strong class="example-control-reference" data-example-control="Panel1" title="面板">面板</strong>）：后台更新面板标题。 本页使用<code>面板</code>。</li>
        <li><code>Text</code>（<strong class="example-control-reference" data-example-control="ToolbarText1" title="第 1 个ToolbarText">第 1 个ToolbarText</strong>）：更新对应工具栏文本项的内容。 本页使用<code>工具条文本一</code>。</li>
        <li><code>TextRaw</code>（<strong class="example-control-reference" data-example-control="ToolbarText1" title="第 1 个ToolbarText">第 1 个ToolbarText</strong>）：本页可信 HTML 内容由应用固定提供，普通文本按文本方式显示。</li>
    </ul>
</section>
}
