@page
@model FineUI.Core.Examples.Pages.Panel.ToolsCustomToolAheadModel
@{
    ViewBag.Title = "Panel/ToolsCustomToolAhead";
    var F = Html.F();
}


@section body {

    <f:Panel ID="Panel1" IsFluid="true" Title="面板" Height="350" BodyPadding="10" EnableCollapse="true" IconUrl="@Url.Content("~/res/images/16/8.png")" CustomToolAhead="true">
        <Items>
            <f:Label Text="面板内容"></f:Label>
        </Items>
        <Tools>
            <f:Tool ID="Tool4" IconFont="_Save" ClickHandler="onToolIconClick"></f:Tool>
            <f:Tool ID="Tool18" IconFont="_Plus" ClickHandler="onToolIconClick"></f:Tool>
            <f:Tool ID="Tool10" IconFont="_Edit" ClickHandler="onToolIconClick"></f:Tool>
            <f:Tool ID="Tool5" IconFont="_Minus" ClickHandler="onToolIconClick"></f:Tool>
        </Tools>
    </f:Panel>
    <br>

    <f:Button ID="Button2" CssClass="marginr" Text="检查面板的折叠状态" OnClick="Button2_Click"></f:Button>


}


@section script {

    <script>

        function onToolIconClick(event) {
            // 当前点击的图标字体
            var iconFont = this.iconFont;

            F.notify({
                message: '你点击了标题栏工具图标：' + iconFont,
                messageIconFont: iconFont,
                displayMilliseconds: 3000,
                positionX: 'center',
                positionY: 'center'
            });
        }

    </script>

}
