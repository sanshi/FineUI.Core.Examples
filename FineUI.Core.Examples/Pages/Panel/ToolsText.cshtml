@page
@model FineUI.Core.Examples.Pages.Panel.ToolsTextModel
@{
    ViewBag.Title = "Panel/ToolsText";
    var F = Html.F();
}

@section body {

    <f:Panel ID="Panel1" IsFluid="true" Title="面板" Height="350" BodyPadding="10" EnableCollapse="true" IconUrl="@Url.Content("~/res/images/16/8.png")">
        <Items>
            <f:Label Text="面板内容"></f:Label>
        </Items>
        <Tools>
            <f:Tool ID="Tool4" IconFont="_Save" Text="保存" ToolTip="保存" ClickHandler="onToolIconClick"></f:Tool>
            <f:Tool ID="Tool18" IconFont="_Plus" Text="新增" ToolTip="新增" ClickHandler="onToolIconClick"></f:Tool>
            <f:Tool ID="Tool10" IconFont="_Edit" Text="编辑" ToolTip="编辑" ClickHandler="onToolIconClick"></f:Tool>
            <f:Tool ID="Tool5" IconFont="_Minus" Text="删除" ToolTip="删除" ClickHandler="onToolIconClick"></f:Tool>
        </Tools>
    </f:Panel>
    <br>


    <f:Button ID="Button2" CssClass="marginr" Text="检查面板的折叠状态" OnClick="Button2_Click"></f:Button>


}


@section script {

    <script>

        function onToolIconClick(event) {
            // 当前点击的图标字体
            var iconFont = this.iconFont;

            F.notify({
                message: '你点击了标题栏工具图标：' + iconFont,
                messageIconFont: iconFont,
                displayMilliseconds: 3000,
                positionX: 'center',
                positionY: 'center'
            });
        }

    </script>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示在面板工具图标旁显示文字，帮助区分各项操作。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>点击与对照工具排列</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Panel1"
                    title="面板">面板</strong>标题栏点击<strong>保存</strong>工具。<br />结果：执行本页客户端提示，提示内容包含当前工具标识；工具位置或文字按本页配置显示。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Tools</code>（<strong class="example-control-reference" data-example-control="Panel1" title="面板">面板</strong>）：声明当前面板的自定义标题工具。</li>
            <li><code>Text</code>（<strong class="example-control-reference" data-example-control="Tool4" title="第 1 个标题工具">第 1 个标题工具</strong>、<strong
                    class="example-control-reference" data-example-control="Tool18" title="第 2 个标题工具">第 2 个标题工具</strong>、<strong
                    class="example-control-reference" data-example-control="Tool10" title="第 3 个标题工具">第 3 个标题工具</strong>、<strong
                    class="example-control-reference" data-example-control="Tool5" title="第 4 个标题工具">第 4
                    个标题工具</strong>）：各组分别设为<code>保存</code>、<code>新增</code>、<code>编辑</code>、<code>删除</code>，提供工具图标旁显示的说明文字。</li>
        </ul>
    </section>
}
