@page
@model FineUI.Core.Examples.Pages.GridCard.CardMultiSelectModel
@{
    ViewBag.SourceFiles = "~/wwwroot/res/js/gridcard.js";
    ViewBag.Title = "GridCard/CardMultiSelect";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" _DataKeyNames="Id,Name,Gender,Major"
        Height="500" DisplayType="Card" CardRendererFunction="renderCard">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd"
                Width="150" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br />

    <f:Button ID="btnShowSelectedRowsClient" Text="选中了哪些行（客户端）" CssClass="marginr" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <f:Button Text="选中第 2, 6, 8 行（客户端）" CssClass="marginr" ClickHandler="onSelectRowsClick"></f:Button>
    <br>
    <br>
    <f:Button Text="选中了哪些行" CssClass="marginr" ID="Button1" OnClick="Button1_Click"></f:Button>

    <f:Button Text="选中第 2, 6, 8 行" CssClass="marginr" ID="Button2" OnClick="Button2_Click"></f:Button>
    <br>
    <br>
    <f:Button Text="选中了哪些行（自定义回发）" CssClass="marginr" ID="Button3" ClickHandler="onCheckSelectionClick" OnClick="Button1_Click">
    </f:Button>
    <br>
    <br>

    <br>
}


@section script {

    <script src="~/res/js/grid.js"></script>
    <script src="~/res/js/gridcard.js"></script>
    <script type="text/javascript">

        function onSelectRowsClick(event) {
            F.ui.Grid1.selectRows([1,5,7]);
        }
        function onCheckSelectionClick(event) {
            if (!F.ui.Grid1.hasSelection()) {
                F.alert({ message: '没有选中项！', target: '_top' });
                return false;
            }
        }

    </script>



}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在卡片模式中用 Ctrl 累积多选，再读取当前选择。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>按本页规则选择卡片</h3>
        <ol>
            <li>依次点击<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>前两张卡片正文，第二次按住
                Ctrl。<br />结果：两张卡片同时保留选择；再操作一张卡片可取消对应项，不改变卡片资料。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnShowSelectedRowsClient"
                    title="选中了哪些行（客户端）">选中了哪些行（客户端）</strong>。<br />结果：提示当前选中卡片对应的记录，不把卡片位置当作业务主键。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：表格默认选中了第 5， 10 行。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableMultiSelect</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：开启多选，普通正文点击配合 Ctrl
                累积选择。</li>
        </ul>
    </section>
}
