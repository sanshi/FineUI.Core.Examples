@page
@model FineUI.Core.Examples.Pages.GridCard.CardSwitchDefaultModel
@{
    ViewBag.SourceFiles = "~/wwwroot/res/js/gridcard.js";
    ViewBag.Title = "GridCard/CardSwitchDefault";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name"
            Height="500" DisplayType="Default" CardRendererFunction="renderCard">
        <Toolbars>
            <f:Toolbar Position="Top">
                <Items>
                    <f:ToolbarFill></f:ToolbarFill>
                    <f:Button IconFont="_Table" ID="btnDisplayDefault" EnablePress="true" Pressed="true" ClickHandler="onDisplayDefaultClick"></f:Button>
                    <f:Button IconFont="_Gallery" ID="btnDisplayCard" EnablePress="true" Pressed="false" ClickHandler="onDisplayCardClick"></f:Button>
                </Items>
            </f:Toolbar>
        </Toolbars>
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" Width="150" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br />

}


@section script {

    <script src="~/res/js/grid.js"></script>
    <script src="~/res/js/gridcard.js"></script>

    <script>

        function onDisplayDefaultClick(event) {
            F.ui.btnDisplayDefault.setPressed(true);
            F.ui.btnDisplayCard.setPressed(false);

            F.ui.Grid1.setDisplayType('default');
        }
        function onDisplayCardClick(event) {
            F.ui.btnDisplayDefault.setPressed(false);
            F.ui.btnDisplayCard.setPressed(true);

            F.ui.Grid1.setDisplayType('card');
        }

    </script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>在初始表格显示基础上切换表格与卡片，复用同一份记录。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>切换显示形式</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="btnDisplayCard" title="卡片模式（卡片图标）">卡片模式（卡片图标）</strong>，再点击<strong class="example-control-reference" data-example-control="btnDisplayDefault" title="表格模式（表格图标）">表格模式（表格图标）</strong>。<br />结果：记录在行列形式与卡片形式之间转换，名称、<strong>性别</strong>等数据保留；模式按钮按下状态与实际显示一致，不发起业务保存。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>DisplayType</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>Default</code>，初次采用本页声明的模式，按钮在 Default 与 Card 之间切换。</li>
        <li><code>CardRendererFunction</code>（<strong>页面展示配置</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：卡片模式调用对应内容函数；表格模式仍使用原列定义。</li>
    </ul>
</section>
}
