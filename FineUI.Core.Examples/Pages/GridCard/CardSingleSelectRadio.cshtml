@page
@model FineUI.Core.Examples.Pages.GridCard.CardSingleSelectRadioModel
@{
    ViewBag.SourceFiles = "~/wwwroot/res/js/gridcard.js";
    ViewBag.Title = "GridCard/CardSingleSelectRadio";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name"
            _DataKeyNames="Id,Name,Gender,Major"
            Height="500" DisplayType="Card" CardRendererFunction="renderCard" EnableCheckBoxSelect="true" EnableMultiSelect="false" CheckBoxSelectDisplayType="Radio">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderField HeaderText="入学日期" ColumnID="EntranceDate" DataField="EntranceDate" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" Width="150" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" />
        </Columns>
    </f:Grid>
    <br />

    <f:Button Text="选中了哪些行（客户端）" CssClass="marginr" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <f:Button Text="选中第 6 行（客户端）" CssClass="marginr" ClickHandler="onSelectRowsClick"></f:Button>
    <br>
    <br>
    <f:Button Text="选中了哪些行" CssClass="marginr" ID="Button1" OnClick="Button1_Click"></f:Button>

    <f:Button Text="选中第 6 行" CssClass="marginr" ID="Button2" OnClick="Button2_Click"></f:Button>
    <br>
    <br>
    <f:Button Text="选中了哪些行（自定义回发）" CssClass="marginr" ID="Button3" ClickHandler="onCheckSelectionClick" OnClick="Button1_Click">
    </f:Button>
    <br>
    <br>

}


@section script {

    <script src="~/res/js/grid.js"></script>
    <script src="~/res/js/gridcard.js"></script>
    <script type="text/javascript">

        function onSelectRowsClick(event) {
            F.ui.Grid1.selectRows([5]);
        }
        function onCheckSelectionClick(event) {
            if (!F.ui.Grid1.hasSelection()) {
                F.alert({ message: '没有选中项！', target: '_top' });
                return false;
            }
        }

    </script>


}
