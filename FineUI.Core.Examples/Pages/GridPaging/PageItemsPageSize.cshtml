@page
@model FineUI.Core.Examples.Pages.GridPaging.PageItemsPageSizeModel
@{
    ViewBag.Title = "GridPaging/PageItemsPageSize";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（内存分页）" Height="350" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true" 
        AllowPaging="true" AllowSorting="true" PageSize="5" DataSource="@DataSourceUtil.GetDataTable2()">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" ColumnID="Year" SortField="EntranceYear" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" />
        </Columns>
        <PageItems>
            <f:ToolbarText Text="每页记录数：">
            </f:ToolbarText>
            <f:DropDownList ID="ddlPageSize" Width="100">
                <Items>
                    <f:ListItem Text="5" Value="5" />
                    <f:ListItem Text="10" Value="10" />
                    <f:ListItem Text="15" Value="15" />
                    <f:ListItem Text="20" Value="20" />
                </Items>
                <Listeners>
                    <f:Listener Event="change" Handler="onDdlPageSizeChange"></f:Listener>
                </Listeners>
            </f:DropDownList>
        </PageItems>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>
        <f:Button ID="btnServerPage" Text="服务端切到第二页" OnClick="btnServerPage_Click"></f:Button>
        <f:Button ID="btnServerSort" Text="服务端按入学年份降序并回首页" OnClick="btnServerSort_Click"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onDdlPageSizeChange(event) {
            var grid1 = F.ui.Grid1;


            var pageSize = parseInt(F.ui.ddlPageSize.getValue(), 10);

            // 设置每页显示记录数
            grid1.setPageSize(pageSize);

            // 加载当前分页数据
            grid1.loadPageData();
        }

    </script>
}
