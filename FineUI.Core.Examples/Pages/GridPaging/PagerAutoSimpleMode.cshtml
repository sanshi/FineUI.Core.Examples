@page
@model FineUI.Core.Examples.Pages.GridPaging.PagerAutoSimpleModeModel
@{
    ViewBag.Title = "GridPaging/PagerAutoSimpleMode";
    var F = Html.F();
}


@section body {


    <f:Grid ID="Grid1" IsFluid="true" Title="表格" EnableCollapse="false" ShowBorder="true" ShowHeader="true" AllowPaging="true" IsDatabasePaging="true"
        PageSize="10" ShowPageSizeSelector="true" DataIDField="Id" OnPageIndexChanged="Grid1_PageIndexChanged">
        <Columns>
            <f:RowNumberField EnablePagingNumber="true" Width="60" />
            <f:RenderField DataField="Id" HeaderText="ID" Width="150" />
            <f:RenderField ExpandUnusedSpace="true" MinWidth="150" DataField="EntranceTime" HeaderText="时间" />
        </Columns>
    </f:Grid>
    <br />


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>表格变窄时自动把完整分页栏收为简洁页码，重新拉宽后恢复完整入口。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>对照宽窄分页栏</h3>
        <ol>
            <li>缩小浏览器宽度或示例可用宽度。<br />结果：分页栏显示当前页与总页数等简洁入口，避免完整分页工具挤在同一行。</li>
            <li>在窄屏下点击下一页，然后拉宽页面。<br />结果：新页数据与简洁页码一起更新；宽度恢复后重新显示完整分页栏。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <div class="f-help-block" style="line-height: 1.8;">
            本页已在 PageManager 级别开启 GridPagerAutoSimpleMode。请缩小浏览器宽度（或在移动端/窄屏查看）：当分页栏放不下时，完整分页器会自动降级为简洁形态（上一页 + 当前/总页 + 下一页）；拉宽后自动还原。
        </div>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>PagerAutoSimpleMode</code>（<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：按分页栏可用宽度自动切换简洁模式；本页不依赖手工切换按钮。</li>
            <li><code>ShowPageSizeSelector</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>true</code>，在完整分页栏中提供每页记录数选择入口。
            </li>
        </ul>
    </section>
}
