@page
@model FineUI.Core.Examples.Pages.GridPaging.PageSizeOptionsDatabaseModel
@{
    ViewBag.Title = "GridPaging/PageSizeOptionsDatabase";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（数据库分页 + 页大小选择器）" DataIDField="Id" DataTextField="Name"
        EnableCheckBoxSelect="true" AllowPaging="true" PageSize="5" IsDatabasePaging="true" ShowPageSizeSelector="true" _PageSizeOptions="5,10,15,20"
        OnPageIndexChanged="Grid1_PageIndexChanged" OnPageSizeChanged="Grid1_PageSizeChanged" Height="350">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>使用分页栏自带的页大小选择器，对照后台按新页大小取数的结果。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>修改每页记录数</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>分页栏的<strong>每页记录数</strong>中选择另一项，例如从 5 改为 10 或从 10
                改为 20。<br />结果：触发页大小更新，后台按新的每页记录数重新查询；表格行数和总页数随之变化。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>PageSize</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>5</code>，指定每页最多显示的记录数。
            </li>
            <li><code>ShowPageSizeSelector</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>true</code>，在分页栏中显示内置页大小选择器。
            </li>
            <li><code>PageSizeOptions</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>5,10,15,20</code>，指定可选择的每页记录数组合。
            </li>
        </ul>
    </section>
}
