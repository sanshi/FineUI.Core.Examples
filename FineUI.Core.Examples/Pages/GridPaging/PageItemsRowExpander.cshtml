@page
@model FineUI.Core.Examples.Pages.GridPaging.PageItemsRowExpanderModel
@{
    ViewBag.Title = "GridPaging/PageItemsRowExpander";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（内存分页）" Height="350" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
            AllowPaging="true" PageSize="5" ExpandAllRowExpanders="true">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField DataField="Desc" RendererFunction="renderExpander" RenderAsRowExpander="true" />
        </Columns>
        <PageItems>
            <f:Button Text="显示隐藏描述信息" EnablePress="true" Pressed="true" ID="btnShowRowExpanders" OnClick="btnShowRowExpanders_Click"></f:Button>
        </PageItems>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>在分页工具栏放置一个按钮，统一展开或折叠表格每行的描述信息。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>切换每行描述</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="btnShowRowExpanders" title="显示隐藏描述信息">显示隐藏描述信息</strong>。<br />结果：按钮切换展开状态，各行描述区域一起收起；再次点击恢复展开。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>ExpandAllRowExpanders</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格（内存分页）">表格（内存分页）</strong>）：初始为 <code>true</code>，控制所有行扩展区域是否展开。</li>
        <li><code>PageItems</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格（内存分页）">表格（内存分页）</strong>）：把切换按钮放进分页工具栏，与分页入口共同布局。</li>
    </ul>
</section>
}
