@page
@model FineUI.Core.Examples.Pages.GridPaging.PageItemsToolbarFillModel
@{
    ViewBag.Title = "GridPaging/PageItemsToolbarFill";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（内存分页）" Height="350" DataIDField="Id" DataTextField="Name"
        EnableCheckBoxSelect="true" AllowPaging="true" PageSize="5">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
        <PageItems>
            <f:Button Text="清空数据" ID="btnClearData" OnClick="btnClearData_Click"></f:Button>
            <f:ToolbarFill></f:ToolbarFill>
            <f:Button Text="重新绑定数据" ID="btnRebind" Icon="Reload" OnClick="btnRebindData_Click"></f:Button>
            <f:ToolbarFill></f:ToolbarFill>
            <f:Button Text="选中所有行" ID="btnSelectAll" OnClick="btnSelectAll_Click"></f:Button>
        </PageItems>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>用弹性占位项把分页工具栏中的自定义按钮与分页控件分布在左、中、右侧。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>使用分页栏中的自定义操作</h3>
        <ol>
            <li>点击<strong class="example-control-reference" data-example-control="btnClearData" title="清空数据">清空数据</strong>。<br />结果：后台清空表格数据，分页栏更新为空数据状态。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnRebind" title="重新绑定数据">重新绑定数据</strong>。<br />结果：后台重新绑定示例记录，表格重新显示数据。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnSelectAll" title="选中所有行">选中所有行</strong>。<br />结果：后台选中表格记录；可通过本页读取选择的入口核对。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>PageItems</code>（<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（内存分页）">表格（内存分页）</strong>）：把自定义按钮插入分页栏；按钮处理与普通按钮一致。</li>
            <li><code>ToolbarFill</code>（<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（内存分页）">表格（内存分页）</strong>）：在工具栏中占用剩余空间，使相邻内容分布到不同侧。</li>
        </ul>
    </section>
}
