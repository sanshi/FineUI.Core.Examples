@page
@model FineUI.Core.Examples.Pages.GridPaging.PageItemsModel
@{
    ViewBag.Title = "GridPaging/PageItems";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（内存分页）" Height="350" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
            AllowPaging="true" PageSize="5" DataSource="@DataSourceUtil.GetDataTable2()" ShowPagingMessage="false">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy/MM/dd" />
        </Columns>
        <PageItems>
            <f:Button Text="清空数据" ID="btnClearData" OnClick="btnClearData_Click"></f:Button>
            <f:Button Text="重新绑定数据" ID="btnRebind" Icon="Reload" OnClick="btnRebindData_Click"></f:Button>
            <f:ToolbarSeparator></f:ToolbarSeparator>
            <f:Button Text="选中所有行" ID="btnSelectAll" OnClick="btnSelectAll_Click"></f:Button>
            <f:Button Text="清空选中行" ID="btnClearSelect" OnClick="btnClearSelect_Click"></f:Button>
        </PageItems>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}