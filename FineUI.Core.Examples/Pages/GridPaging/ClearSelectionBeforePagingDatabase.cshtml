@page
@model FineUI.Core.Examples.Pages.GridPaging.ClearSelectionBeforePagingDatabaseModel
@{
    ViewBag.Title = "GridPaging/ClearSelectionBeforePagingDatabase";
    var F = Html.F();
}

@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格（跨页选中行）" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
        AllowPaging="true" PageSize="5" IsDatabasePaging="true" OnPageIndexChanged="Grid1_PageIndexChanged" KeepCurrentSelection="true"
        KeepPagedSelection="true" ClearSelectionBeforePaging="false" ClearSelectionBeforeBinding="false">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
    </f:Grid>
    <br />
    <f:Button ID="btnShowSelectedRows" Text="选中了哪些行" ClickHandler="onShowSelectedRowIdsClick"></f:Button>
    <br>
    <br>


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onShowSelectedRowIdsClick(event) {
            F.alert('选中行的ID列表为：' + F.ui.Grid1.getSelectedRows().join(', '));
        }

    </script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>数据库分页时保留其他页面的选中行，避免换页后丢失选择。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>保留其他页面的选择</h3>
        <ol>
            <li>勾选<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（跨页选中行）">表格（跨页选中行）</strong>第一页的一行，再点击下一页。<br />结果：翻页后原来选中的行仍保留在选择集合中；后台只加载新页记录。</li>
            <li>再勾选第二页的一行。<br />结果：选择集合包含来自两页的记录。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnShowSelectedRows"
                    title="选中了哪些行">选中了哪些行</strong>。<br />结果：提示列出两页选中的行标识；返回第一页可看到对应记录仍被勾选。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DataIDField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格（跨页选中行）">表格（跨页选中行）</strong>）：初始为
                <code>Id</code>，跨页选择缓存按业务主键区分记录，避免把不同页面中的相同行位置混为同一条数据。
            </li>
            <li><code>ClearSelectionBeforePaging</code>（<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（跨页选中行）">表格（跨页选中行）</strong>）：初始为 <code>false</code>，翻页时不清空已有选择。</li>
            <li><code>KeepCurrentSelection</code>（<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（跨页选中行）">表格（跨页选中行）</strong>）：初始为 <code>true</code>，增加选择时保留原先已选中的记录。</li>
            <li><code>KeepPagedSelection</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格（跨页选中行）">表格（跨页选中行）</strong>）：初始为
                <code>true</code>，保留不在当前页中的选中记录。
            </li>
            <li><code>ClearSelectionBeforeBinding</code>（<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（跨页选中行）">表格（跨页选中行）</strong>）：初始为 <code>false</code>，重新绑定当前页时不清空跨页选择。</li>
        </ul>
    </section>
}
