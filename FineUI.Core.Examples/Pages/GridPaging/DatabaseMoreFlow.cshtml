@page
@model FineUI.Core.Examples.Pages.GridPaging.DatabaseMoreFlowModel
@{
    ViewBag.Title = "GridPaging/DatabaseMoreFlow";
    var F = Html.F();
}

@section head  {

    <style>
        .morebutton {
            text-align: center;
            margin: 10px 0;
        }

            .morebutton a[disabled] {
                cursor: not-allowed !important;
                text-decoration: none;
                opacity: .5;
                filter: alpha(opacity=50);
            }
    </style>

}


@section body {
    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
        Height="350">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
        <Attributes>
            <f:Attribute Key="data-index" Value="0"></f:Attribute>
        </Attributes>
    </f:Grid>

    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>
    <br>
    <br>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        var morebuttonSelector = '.f-grid-bodyct >.morebutton a';

        function disableMoreButton() {
            var grid1 = F.ui.Grid1;

            // 禁用链接
            var morebuttonEl = grid1.el.find(morebuttonSelector);
            morebuttonEl.attr('disabled', true).removeAttr('href').text('全部加载完毕');
        }

        F.ready(function () {
            var grid1 = F.ui.Grid1;

            var tableEl = grid1.el.find('.f-grid-bodyct .f-grid-table');
            tableEl.after('<div class="morebutton"><a href="#">加载更多...</a></div>');


            grid1.el.on('click', morebuttonSelector, function (event) {
                event.preventDefault();
                var morebuttonEl = $(this);
                if (morebuttonEl.attr('disabled')) {
                    return;
                }

                // 自定义回发
                F.customEvent('MoreClick');
            });

        });

    </script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>在固定高度的表格内部追加记录，滚动查看数据时保留表头。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>逐批追加记录</h3>
        <ol>
            <li>滚动<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>到末尾，点击<strong>加载更多...</strong>。<br />结果：触发本页加载处理，后台读取下一批记录并追加，已显示的记录仍保留。</li>
            <li>继续加载，直到没有剩余记录。<br />结果：加载入口变为不可继续加载的状态；不会重复追加最后一批记录。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>AppendData</code>（<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：把新一批数据追加到表格；区别于重新绑定时替换现有记录。</li>
            <li><code>Height</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>350</code>，限制表格高度，使数据在表格内部滚动，表头保持可见。
            </li>
        </ul>
    </section>
}
