@page
@model FineUI.Core.Examples.Pages.GridPaging.DatabaseModel
@{
    ViewBag.Title = "GridPaging/Database";
    var F = Html.F();
}


@section body {

    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格" DataIDField="Id" DataTextField="Name" EnableCheckBoxSelect="true"
        AllowPaging="true" PageSize="5" IsDatabasePaging="true" OnPageIndexChanged="Grid1_PageIndexChanged" ShowPagingMessage="false">
        <Columns>
            <f:RowNumberField />
            <f:RenderField HeaderText="姓名" DataField="Name" />
            <f:RenderField HeaderText="性别" DataField="Gender" FieldType="Int" RendererFunction="renderGender" />
            <f:RenderField HeaderText="入学年份" DataField="EntranceYear" FieldType="Int" />
            <f:RenderCheckField HeaderText="是否在校" DataField="AtSchool" RenderAsStaticField="true" />
            <f:RenderField HeaderText="所学专业" DataField="Major" RendererFunction="renderMajor" ExpandUnusedSpace="true" MinWidth="150" />
            <f:RenderField HeaderText="分组" DataField="Group" RendererFunction="renderGroup" />
            <f:RenderField HeaderText="注册日期" DataField="LogTime" FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd" />
        </Columns>
        <Listeners>
            <f:Listener Event="paging" Handler="test1"></f:Listener>
        </Listeners>
    </f:Grid>
    <br />
    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>
    <br>
    <br>


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function test1(event) {

        }
    </script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>只为当前页读取记录，并用总记录数计算数据库分页栏。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>查看下一页并返回</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>下方的下一页入口，再回到第一页。<br />结果：翻页回发到后台；后台读取当前页码和页大小，绑定该页记录并提供总记录数，返回首页后恢复首批记录。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：表格设置了 ShowPagingMessage=false，没有显示分页信息。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>AllowPaging</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>true</code>，启用分页显示。
            </li>
            <li><code>PageSize</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>5</code>，决定每页最多显示的记录数。
            </li>
            <li><code>IsDatabasePaging</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>true</code>，表格每次只接收当前页数据；分页栏依赖总记录数而不是本页行数。
            </li>
            <li><code>RecordCount</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：提供全部记录的总数，用于计算总页数。</li>
        </ul>
    </section>
}
