@page
@model FineUI.Core.Examples.Pages.GridDynamic.ColumnsCollectionModel
@{
    ViewBag.Title = "增删列与多表头";
}

@section body {
    <f:Grid ID="Grid1" Title="增删列与多表头" ShowHeader="true" ShowBorder="true" IsFluid="true" Height="400"
            DataIDField="Id" DataTextField="Name" AllowPaging="false" IsDatabasePaging="false"
            IsDatabaseSorting="false" EnableMultiSelect="false" PagingToolbarVisible="true"
            >
        <Columns>
            <f:RenderField ColumnID="Name" HeaderText="姓名" DataField="Name" SortField="Name" Width="220" />
            <f:RenderField ColumnID="EntranceYear" HeaderText="入学年份" DataField="EntranceYear" FieldType="Int"
                    SortField="EntranceYear" Width="240" />
        </Columns>
        <PageItems>
            <f:Button ID="BusinessButton" Text="业务按钮" OnClick="BusinessButton_Click" />
        </PageItems>
    </f:Grid>
    <br>
    <f:Button ID="Button1" Text="应用配置" OnClick="Button1_Click" CssClass="marginr" />
    <f:Button ID="Button2" Text="恢复配置" OnClick="Button2_Click" CssClass="marginr" />
    <f:Button ID="Button3" Text="读取当前配置" OnClick="Button3_Click" CssClass="marginr" />
    <f:Button ID="Button4" Text="清空列" OnClick="Button4_Click" />
    <f:Button ID="Button5" Text="仅修改列宽和对齐" OnClick="Button5_Click" />
    <br><br>
    <f:Label ID="LabelResult" Text="修改后再次回发，核对后台取得的当前配置。" />

    <p>用列集合直接替换为多表头，也可清空后恢复。这里使用已有字段，不重新查询数据；增加新的业务字段时应重新绑定。</p>
}
