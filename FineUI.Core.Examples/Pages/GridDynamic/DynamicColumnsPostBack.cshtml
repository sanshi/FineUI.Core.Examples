@page
@model FineUI.Core.Examples.Pages.GridDynamic.DynamicColumnsPostBackModel
@{
    ViewBag.SourceFiles = "~/Code/DynamicColumnsData.cs";
    ViewBag.Title = "GridDynamic/DynamicColumnsPostBack";
    var F = Html.F();
}

@section body {

    <f:DropDownList ID="DropDownList1" Label="切换表格" Width="500" OnSelectedIndexChanged="DropDownList1_SelectedIndexChanged">
        <Items>
            <f:ListItem Text="表格一（单选，行扩展列）" Value="table1" Selected="true"></f:ListItem>
            <f:ListItem Text="表格二（多选，多表头，全选列）" Value="table2"></f:ListItem>
        </Items>
    </f:DropDownList>
    <br>
    <br>
    <f:Grid ID="Grid1" IsFluid="true" ShowBorder="true" ShowHeader="true" Title="表格一（单选，行扩展列）"
            DataIDField="Id" DataTextField="Name">
    </f:Grid>
    <br>
    <br>

    <f:Button Text="选中了哪些行" ClickHandler="onNotifySelectedRowsClick"></f:Button>

    <br>
    <br>
    注：普通表格可直接修改列和表格属性；单元格编辑、表头过滤及单元格内创建业务控件的复杂表格暂不支持此方式。
    
}


@section script {

    <script src="~/res/js/grid.js"></script>

}
