@page
@model FineUI.Core.Examples.Pages.HtmlEditor.FullToolbarModel
@{
    ViewBag.Title = "HtmlEditor/FullToolbar";
    const string initialHtml = "<p>FineUI 富文本编辑器</p><p>选择文字，试试<strong>加粗</strong>、<em>斜体</em>和列表。</p>";
}

@section body {
    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" LabelAlign="Top" Title="完整工具栏">
        <Items>
            <f:HtmlEditor ID="HtmlEditor1" Label="正文" Height="320" Text="@initialHtml" Readonly="false" ToolbarSet="Full"></f:HtmlEditor>

            <f:TextArea ID="TextArea1" Label="HTML 内容" Height="120" Text="@initialHtml" />
            <f:Button ID="Button1" Text="获取编辑器内容" CssClass="marginr" OnClick="Button1_Click" />
            <f:Button ID="Button2" Text="设置编辑器内容" OnClick="Button2_Click" />

        </Items>
    </f:SimpleForm>


}
@section script {
    <script>
function toggleHtmlEditorReadonly() {
    var editor = F.ui.HtmlEditor1;
    editor.setReadonly(!editor.readonly);
}
function getHtmlEditorContent() {
    return F.ui.HtmlEditor1.getValue();
}
function getSourceContent() {
    return F.ui.TextArea1.getValue();
}

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示<strong class="example-control-reference" data-example-control="SimpleForm1" title="完整工具栏">完整工具栏</strong>提供的字体、颜色、对齐和源码视图等扩展编辑功能。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>使用完整工具栏</h3>
        <ul>
            <li>
                在正文选择文字，打开文字颜色或背景颜色面板，选一个色块。<br />
                结果：所选文字颜色或背景改变，色块面板收起；默认颜色恢复主题文字色，无高亮清除背景。
            </li>
            <li>
                点击工具栏末尾的 HTML 源码按钮，再点击一次。<br />
                结果：源码在原正文区域等高显示；返回后恢复富文本，不另开窗口。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>本例通过 <code>ToolbarSet</code>="<code>Full</code>" 启用<strong class="example-control-reference" data-example-control="SimpleForm1"
                title="完整工具栏">完整工具栏</strong>，在基础编辑功能上增加字体、字号、文字颜色、背景色、对齐、引用和分隔线；HTML
            源码按钮始终位于最后。点击颜色按钮展开色块面板，选择颜色后自动收起；<strong>默认颜色</strong>恢复主题文字色，<strong>无高亮</strong>移除文字背景。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ToolbarSet</code>（<strong class="example-control-reference" data-example-control="HtmlEditor1" title="正文">正文</strong>）：本页预设为
                <code>Full</code>；<code>Full</code> 额外提供字体、字号、颜色、对齐等命令。
            </li>
        </ul>
    </section>
}
