@page
@model FineUI.Core.Examples.Pages.HtmlEditor.ReadonlyModel
@{
    ViewBag.Title = "HtmlEditor/Readonly";
    const string initialHtml = "<p>FineUI 富文本编辑器</p><p>选择文字，试试<strong>加粗</strong>、<em>斜体</em>和列表。</p>";
}

@section body {
    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" LabelAlign="Top" Title="只读与恢复编辑">
        <Items>
            <f:HtmlEditor ID="HtmlEditor1" Label="正文" Height="320" Text="@initialHtml" Readonly="true" ToolbarSet="Basic"></f:HtmlEditor>
            
            <f:TextArea ID="TextArea1" Label="HTML 内容" Height="120" Text="@initialHtml" />
            <f:Button ID="Button1" Text="获取编辑器内容" CssClass="marginr" OnClick="Button1_Click" />
            <f:Button ID="Button2" Text="设置编辑器内容" CssClass="marginr" OnClick="Button2_Click" />
            <f:Button ID="btnToggle" Text="切换只读" ClickHandler="toggleHtmlEditorReadonly" />
        </Items>
    </f:SimpleForm>
}
@section script {
    <script>
function toggleHtmlEditorReadonly() {
    var editor = F.ui.HtmlEditor1;
    editor.setReadonly(!editor.readonly);
}
function getHtmlEditorContent() {
    return F.ui.HtmlEditor1.getValue();
}
function getSourceContent() {
    return F.ui.TextArea1.getValue();
}
    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示内置<strong class="example-control-reference" data-example-control="HtmlEditor1" title="正文">富文本编辑器</strong>只读时的选择、复制和源码查看，以及恢复编辑。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>只读与恢复编辑</h3>
        <ol>
            <li>
                在<strong class="example-control-reference" data-example-control="HtmlEditor1" title="正文">正文</strong>尝试输入或点击加粗等编辑命令，再查看源码。<br />
                结果：初始为只读，正文及源码不能修改；仍可选择、复制和查看 HTML。
            </li>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnToggle" title="切换只读">切换只读</strong>，在正文输入<code>补充说明</code>。<br />
                结果：浏览器取消只读，正文和编辑命令恢复可用；再次点击恢复只读，保留当前内容。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>只读时允许选择、复制和查看源码；正文和源码均不可修改。可使用下方按钮切换。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Readonly</code>（<strong class="example-control-reference" data-example-control="HtmlEditor1" title="正文">正文</strong>）：本页初始为 <code>true</code>；客户端 <code>setReadonly()</code>切换是否可编辑，保留正文。</li>
        </ul>
    </section>
}
