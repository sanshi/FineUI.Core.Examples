@page
@model FineUI.Core.Examples.Pages.HtmlEditor.ReadonlyModel
@{
    ViewBag.Title = "HtmlEditor/Readonly";
    const string initialHtml = "<p>FineUI 富文本编辑器</p><p>选择文字，试试<strong>加粗</strong>、<em>斜体</em>和列表。</p>";
}

@section body {
    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" LabelAlign="Top" Title="只读与恢复编辑">
        <Items>
            <f:HtmlEditor ID="HtmlEditor1" Label="正文" Height="320" Text="@initialHtml" Readonly="true" ToolbarSet="Basic"></f:HtmlEditor>
            
            <f:TextArea ID="TextArea1" Label="HTML 内容" Height="120" Text="@initialHtml" />
            <f:Button ID="Button1" Text="获取编辑器内容" CssClass="marginr" OnClick="Button1_Click" />
            <f:Button ID="Button2" Text="设置编辑器内容" CssClass="marginr" OnClick="Button2_Click" />
            <f:Button ID="btnToggle" Text="切换只读" ClickHandler="toggleHtmlEditorReadonly" />
        </Items>
    </f:SimpleForm>
    <p>只读时允许选择、复制和查看源码；正文和源码均不可修改。可使用下方按钮切换。</p>
}
@section script {
    <script>
function toggleHtmlEditorReadonly() {
    var editor = F.ui.HtmlEditor1;
    editor.setReadonly(!editor.readonly);
}
function getHtmlEditorContent() {
    return F.ui.HtmlEditor1.getValue();
}
function getSourceContent() {
    return F.ui.TextArea1.getValue();
}
    </script>
}
