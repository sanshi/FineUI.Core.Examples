@page
@model FineUI.Core.Examples.Pages.HtmlEditor.LayoutModel
@{
    ViewBag.Title = "HtmlEditor/Layout";
    const string initialHtml = "<p>FineUI 富文本编辑器</p><p>选择文字，试试<strong>加粗</strong>、<em>斜体</em>和列表。</p>";
    const string windowHtml = "<p>窗口中的第一份文档</p>";
    const string hiddenTabHtml = "<p>切换选项卡后继续编辑</p>";
}

@section head {
    <style>
        /* 窗口已有外框，嵌入的编辑器去掉自身外框、圆角和聚焦光晕，避免出现重复边界。 */
        .htmleditor-in-tab .f-field-htmleditor-fineui,
        .htmleditor-in-tab .f-field-htmleditor-fineui:focus-within {
            border: 0;
            border-radius: 0;
            box-shadow: none;
        }
    </style>
}

@section body {
    <f:SimpleForm ID="SimpleForm1" IsFluid="true" BodyPadding="10" LabelAlign="Top" Title="多实例与容器布局">
        <Items>
            <f:HtmlEditor ID="HtmlEditor1" Label="正文" Height="320" Text="@initialHtml" Readonly="false" ToolbarSet="Basic"></f:HtmlEditor>
            <f:HtmlEditor ID="HtmlEditor2" Label="第二个编辑器" Height="320" Text="@initialHtml" Readonly="false" ToolbarSet="Basic"></f:HtmlEditor>
            <f:TextArea ID="TextArea1" Label="HTML 内容" Height="120" Text="@initialHtml" />
            <f:Button ID="Button1" Text="获取编辑器内容" CssClass="marginr" OnClick="Button1_Click" />
            <f:Button ID="Button2" Text="设置编辑器内容" OnClick="Button2_Click" />
            
        </Items>
    </f:SimpleForm>
    <br />
    <f:Button ID="btnOpenEditor" Text="打开编辑窗口" ClickHandler="onOpenEditorClick" />
    <f:Window ID="Window1" Title="窗口与隐藏选项卡" Hidden="true" Width="760" Height="460"
              Layout="Fit" EnableResize="true" BodyPadding="0">
        <Items>
            <f:TabStrip ID="TabStrip1" ShowBorder="false">
                <Tabs>
                    <f:Tab ID="Tab1" Title="第一份文档" Layout="Fit" BodyPadding="0">
                        <Items>
                            <f:HtmlEditor ID="HtmlEditor3" CssClass="htmleditor-in-tab" ShowLabel="false" Margin="0" Text="@windowHtml" />
                        </Items>
                    </f:Tab>
                    <f:Tab ID="Tab2" Title="隐藏选项卡" Layout="Fit" BodyPadding="0">
                        <Items>
                            <f:HtmlEditor ID="HtmlEditor4" CssClass="htmleditor-in-tab" ShowLabel="false" Margin="0" Text="@hiddenTabHtml" />
                        </Items>
                    </f:Tab>
                </Tabs>
            </f:TabStrip>
        </Items>
    </f:Window>
    <p>两个编辑器拥有独立的内容、选区和撤销记录；改变浏览器宽度可观察工具栏换行。</p>
}
@section script {
    <script>
        function getHtmlEditorContent() {
            return F.ui.HtmlEditor1.getValue();
        }

        function getSourceContent() {
            return F.ui.TextArea1.getValue();
        }

        function onOpenEditorClick() {
            F.ui.Window1.show();
        }
    </script>
}
